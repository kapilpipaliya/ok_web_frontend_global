{
  "manifest_version": 3,
  "name": "YSaar - YouTube Organizer",
  "version": "1.0.0",
  "description": "Save and manage YouTube channels and playlists with YSaar",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://ysaar.com/*",
    "http://localhost:3000/*",
    "https://ytorganizer.localhost.com:3001/*",
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["config.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
