{
  vertexes: [
    {
      id: "flt_root",
      L: "Component",
      P: {
        key: "FormLocalizedText",
        description: "Multi-language text input with language tabs. Languages passed via props only.",
        dynamicComponent: "TextInput, TextArea",
        fns: '''
const DEFAULT_SITE_LANGUAGES = [
  { code: "en", label: "English", isDefault: true },
  { code: "hi", label: "Hindi", isDefault: false },
  { code: "gu", label: "Gujarati", isDefault: false }
];

const getProps = () => c.props || {};

const getLanguages = () => {
  const languages = getProps().languages;
  if (Array.isArray(languages) && languages.length > 0) return languages;
  return DEFAULT_SITE_LANGUAGES;
};

const normalizeValue = (value, languages) => {
  const normalized = {};
  const defaultCode = (() => {
    const explicit = languages.find((lang) => lang?.isDefault === true);
    if (explicit?.code) return explicit.code;
    return languages[0]?.code || "en";
  })();
  for (let i = 0; i < languages.length; i++) {
    normalized[languages[i].code] = "";
  }
  if (value != null && typeof value === "object" && !Array.isArray(value)) {
    for (const key of Object.keys(value)) {
      if (Object.prototype.hasOwnProperty.call(normalized, key)) {
        normalized[key] = value[key] == null ? "" : String(value[key]);
      }
    }
    return normalized;
  }
  if (typeof value === "string" && value !== "") {
    normalized[defaultCode] = value;
  }
  return normalized;
};

const getValue = () => normalizeValue(getProps().value, getLanguages());

const getDefaultTabCode = () => {
  const languages = getLanguages();
  const explicit = languages.find((lang) => lang.isDefault === true);
  if (explicit?.code) return explicit.code;
  return languages[0]?.code || "";
};

const [activeTab, setActiveTab] = _.createSignal(getDefaultTabCode());

_.createEffect(() => {
  const languages = getLanguages();
  const current = activeTab();
  if (!languages.some((lang) => lang.code === current)) {
    setActiveTab(getDefaultTabCode());
  }
});

const updateLanguageValue = (code, nextText) => {
  const languages = getLanguages();
  const current = getValue();
  const next = { ...current, [code]: nextText };
  getProps().onChange?.(next);
};

const getLanguageValue = (code) => getValue()[code] || "";

const isMultiline = () => getProps().multiline === true;
const isDisabled = () => getProps().disabled === true;
const isRequired = () => getProps().required === true;

const getLanguageIndices = () => {
  const languages = getLanguages();
  const indices = [];
  for (let i = 0; i < languages.length; i++) indices.push(i);
  return indices;
};

const getLanguageAt = (index) => getLanguages()[index] || null;

return {
  getLanguages,
  getLanguageIndices,
  getLanguageAt,
  activeTab,
  setActiveTab,
  updateLanguageValue,
  getLanguageValue,
  isMultiline,
  isDisabled,
  isRequired,
  hasLanguages: () => getLanguages().length > 0
};
'''
      }
    },
    {
      id: "flt_empty",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "p",
  hide: f.hasLanguages?.(),
  text: "Configure site languages in Global Settings first.",
  class: "flt-empty"
};
''',
        css: '''
return `._id.flt-empty {
  margin: 0;
  font-size: 0.8125rem;
  color: ${t.var.color.text_light_500};
}`;
'''
      }
    },
    {
      id: "flt_shell",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: !f.hasLanguages?.(),
  class: "flt-shell"
};
''',
        css: '''
return `._id.flt-shell {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  width: 100%;
}`;
'''
      }
    },
    {
      id: "flt_tabs",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "fltLangIndex",
        loop: true,
        props: '''
return {
  as: "div",
  class: "flt-tabs",
  data: f.getLanguageIndices?.()
};
''',
        css: '''
return `._id.flt-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
}`;
'''
      }
    },
    {
      id: "flt_tab_btn",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const lang = f.getLanguageAt?.(c.fltLangIndex);
const active = f.activeTab?.() === lang?.code;
return {
  as: "button",
  type: "button",
  text: lang?.label || lang?.code || "Language",
  class: active ? "flt-tab flt-tab-active" : "flt-tab",
  disabled: f.isDisabled?.(),
  onClick: () => lang?.code && f.setActiveTab?.(lang.code)
};
''',
        css: '''
const lang = f.getLanguageAt?.(c.fltLangIndex);
const active = f.activeTab?.() === lang?.code;
return `._id.flt-tab {
  padding: 0.25rem 0.625rem;
  border: 1px solid ${active ? t.var.color.primary : t.var.color.border};
  border-radius: 0.375rem;
  background: ${active ? t.var.color.primary_light_100 : t.var.color.background};
  color: ${active ? t.var.color.primary_text : t.var.color.text};
  font-size: 0.75rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s ease;

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
}`;
'''
      }
    },
    {
      id: "flt_input_area",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return { as: "div", class: "flt-input-area" };
''',
        css: '''
return `._id.flt-input-area {
  width: 100%;
}`;
'''
      }
    },
    {
      id: "flt_textarea",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "TextArea",
        props: '''
const code = f.activeTab?.();
const hide = !code || !f.isMultiline?.();
return {
  hide,
  value: code ? f.getLanguageValue?.(code) : "",
  onChange: (e) => code && f.updateLanguageValue?.(code, e.target.value),
  placeholder: "",
  required: f.isRequired?.(),
  disabled: f.isDisabled?.(),
  rows: 4
};
'''
      }
    },
    {
      id: "flt_textinput",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "TextInput",
        props: '''
const code = f.activeTab?.();
const hide = !code || f.isMultiline?.() === true;
return {
  hide,
  type: "text",
  value: code ? f.getLanguageValue?.(code) : "",
  onChange: (e) => code && f.updateLanguageValue?.(code, e.target.value),
  placeholder: "",
  required: f.isRequired?.(),
  disabled: f.isDisabled?.()
};
'''
      }
    }
  ],
  edges: [
    { id: "flt_e1", T: "Attr", S: "flt_root", E: "flt_empty" },
    { id: "flt_e2", T: "Attr", S: "flt_root", E: "flt_shell" },
    { id: "flt_e3", T: "Attr", S: "flt_shell", E: "flt_tabs" },
    { id: "flt_e4", T: "Attr", S: "flt_shell", E: "flt_input_area" },
    { id: "flt_e5", T: "Attr", S: "flt_tabs", E: "flt_tab_btn" },
    { id: "flt_e6", T: "Attr", S: "flt_input_area", E: "flt_textarea" },
    { id: "flt_e7", T: "Attr", S: "flt_input_area", E: "flt_textinput" }
  ]
}
