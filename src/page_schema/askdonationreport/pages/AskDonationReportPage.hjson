{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        signinRequired: false
        fns:
          '''const BUILTIN_ROBOTO_FONT_BASE =
  "https://cdn.jsdelivr.net/npm/roboto-font@0.1.0/fonts/Roboto/";

const sanitizeFontKey = (raw) => {
  const s = raw.replace(/[^a-zA-Z0-9_-]+/g, "_").replace(/^_+|_+$/g, "");
  return s || "CustomFont";
};

const getDefaultBuiltinFonts = () => {
  const b = BUILTIN_ROBOTO_FONT_BASE;
  return {
    Roboto: { data: b + "roboto-regular-webfont.ttf", fallback: true },
    RobotoBold: { data: b + "roboto-bold-webfont.ttf" },
    RobotoMedium: { data: b + "roboto-medium-webfont.ttf" },
    RobotoItalic: { data: b + "roboto-italic-webfont.ttf" },
  };
};

const buildPdfmeFontOption = (custom) => {
  const out = { ...getDefaultBuiltinFonts() };
  for (const { key, data } of custom) {
    const k = sanitizeFontKey(key);
    out[k] = { data };
  }
  return out;
};

const readSchemaFieldNames = (template) => {
  const page = template?.schemas?.[0];
  if (!Array.isArray(page)) return [];
  const names = [];
  for (const sch of page) {
    const n = sch?.name != null ? String(sch.name).trim() : "";
    if (n) names.push(n);
  }
  return names;
};

const readOriginalFontNames = (template) => {
  const page = template?.schemas?.[0];
  const out = {};
  if (!Array.isArray(page)) return out;
  for (const sch of page) {
    if (sch?.name) {
      out[sch.name] = sch.fontName || "Roboto";
    }
  }
  return out;
};

const cloneWithFieldStyles = (template, patches) => {
  const next =
    typeof structuredClone === "function"
      ? structuredClone(template)
      : JSON.parse(JSON.stringify(template));
  const page = next?.schemas?.[0];
  if (!Array.isArray(page)) return next;
  for (const sch of page) {
    const name = sch?.name;
    if (!name) continue;
    const p = patches[name];
    if (!p) continue;
    if (p.fontName !== undefined && String(p.fontName).trim() !== "") {
      sch.fontName = String(p.fontName).trim();
    }
    if (p.fontSize !== undefined && String(p.fontSize).trim() !== "") {
      const n = Number(p.fontSize);
      if (!Number.isNaN(n)) {
        sch.fontSize = n;
      }
    }
    if (typeof p.underline === "boolean") {
      sch.underline = p.underline;
    }
    if (typeof p.strikethrough === "boolean") {
      sch.strikethrough = p.strikethrough;
    }
  }
  return next;
};

const emptyRow = () => {
  const o = {};
  for (const k of schemaFieldNames()) {
    o[k] = "";
  }
  return o;
};

const [rows, setRows] = _.createSignal([{}]);
const [busy, setBusy] = _.createSignal(false);
const [pdfTemplate, setPdfTemplate] = _.createSignal(null);
const [templateFileLabel, setTemplateFileLabel] = _.createSignal("");

const [fieldPatches, setFieldPatches] = _.createSignal({});
const [origFonts, setOrigFonts] = _.createSignal({});
const [fontRegKey, setFontRegKey] = _.createSignal("");
const [pendingFontBytes, setPendingFontBytes] = _.createSignal(null);
const [customFonts, setCustomFonts] = _.createSignal([]);

const schemaFieldNames = () => {
  const t = pdfTemplate();
  if (!t) return [];
  return readSchemaFieldNames(t);
};

const reshapeRowsToTemplateKeys = (parsedTemplate, prevRows) => {
  const keys = readSchemaFieldNames(parsedTemplate);
  const reshape = (r) => {
    const out = {};
    for (const k of keys) {
      out[k] = r[k] == null ? "" : String(r[k]);
    }
    return out;
  };
  if (!keys.length) {
    return prevRows.length ? prevRows.map(() => ({})) : [{}];
  }
  if (!prevRows.length) {
    return [reshape({})];
  }
  return prevRows.map(reshape);
};

const styleRows = () => schemaFieldNames().map((name) => ({ name }));

const getFieldPatch = (name) => {
  const p = fieldPatches();
  return p[name] || {};
};

const patchFieldPatch = (name, key, val) => {
  setFieldPatches((prev) => {
    const cur = prev[name] || {};
    return { ...prev, [name]: { ...cur, [key]: val } };
  });
};

const onPendingFontFile = async (e) => {
  const f = e.target.files?.[0];
  if (!f) return;
  try {
    const buf = await f.arrayBuffer();
    setPendingFontBytes(new Uint8Array(buf));
    _.showSuccessToast("Font file ready: " + f.name);
  } catch (err) {
    _.showErrorToast(err?.message || "Could not read font file");
    setPendingFontBytes(null);
  }
  e.target.value = "";
};

const fetchGoogleFontBytes = async (familyName) => {
  const url =
    "/api/askdonationreport/google-font?family=" +
    encodeURIComponent(familyName);
  const res = await fetch(url);
  if (!res.ok) {
    let msg = "Font lookup failed (" + res.status + ")";
    try {
      const j = await res.json();
      if (j?.error) {
        msg = j.error;
      }
    } catch {}
    throw new Error(msg);
  }
  const fontBuf = await res.arrayBuffer();
  const bytes = new Uint8Array(fontBuf);
  if (!bytes.length) {
    throw new Error("Downloaded font file is empty");
  }
  return bytes;
};

const registerCustomFont = async () => {
  const key = fontRegKey().trim();
  if (!key) {
    _.showWarningToast("Enter a font key / family name first");
    return;
  }
  let data = pendingFontBytes();
  if (!data || !data.length) {
    try {
      const familyName = key.replace(/[_-]+/g, " ");
      _.showWarningToast(
        "No file selected. Downloading from Google Fonts: " + familyName,
      );
      data = await fetchGoogleFontBytes(familyName);
    } catch (err) {
      _.showErrorToast(
        err?.message || "Could not download font from Google Fonts",
      );
      return;
    }
  }
  const clean = sanitizeFontKey(key);
  setCustomFonts((prev) => {
    const rest = prev.filter((x) => x.key !== clean);
    return [...rest, { key: clean, data }];
  });
  setFontRegKey("");
  setPendingFontBytes(null);
  _.showSuccessToast("Registered font: " + clean);
};

const removeCustomFont = (fontKey) => {
  setCustomFonts((prev) => prev.filter((x) => x.key !== fontKey));
};

const clearFieldPatches = () => {
  setFieldPatches({});
  _.showSuccessToast("Typography overrides cleared");
};

const [statusMsg, setStatusMsg] = _.createSignal(
  "Choose a pdfme template JSON file (.json). Table columns match the template’s field names after you load it — add/remove rows or import CSV, then download ZIP.",
);

const onTemplateSelected = async (e) => {
  const f = e.target.files?.[0];
  if (!f) return;
  try {
    const text = await f.text();
    const parsed = JSON.parse(text);
    if (
      !parsed ||
      typeof parsed !== "object" ||
      !parsed.schemas ||
      parsed.basePdf === undefined
    ) {
      _.showErrorToast("Invalid pdfme template: need schemas and basePdf");
      setPdfTemplate(null);
      setTemplateFileLabel("");
      return;
    }
    setPdfTemplate(parsed);
    setTemplateFileLabel(f.name);
    setOrigFonts(readOriginalFontNames(parsed));
    setFieldPatches({});
    setRows((prev) => reshapeRowsToTemplateKeys(parsed, prev));
    _.showSuccessToast("Template loaded: " + f.name);
  } catch (err) {
    _.showErrorToast(err?.message || "Could not read template JSON");
    setPdfTemplate(null);
    setTemplateFileLabel("");
  }
  e.target.value = "";
};

const addRow = () => {
  setRows((prev) => [...prev, emptyRow()]);
};

const deleteRow = (i) => {
  setRows((prev) => prev.filter((_, j) => j !== i));
};

const updateCell = (i, key, val) => {
  setRows((prev) => {
    const next = [...prev];
    const cur = { ...(next[i] || {}) };
    for (const k of schemaFieldNames()) {
      if (cur[k] === undefined) {
        cur[k] = "";
      }
    }
    cur[key] = val;
    next[i] = cur;
    return next;
  });
};

const onCsvSelected = async (e) => {
  const f = e.target.files?.[0];
  if (!f) return;
  const keys = schemaFieldNames();
  if (!keys.length) {
    _.showWarningToast("Load a pdfme template first so CSV headers can be matched to field names");
    e.target.value = "";
    return;
  }
  setStatusMsg("Parsing…");
  try {
    const text = await f.text();
    const response = await s({
      functionName: "askDonationReportParseAndNormalizeCsv",
      contextData: { csvText: text, fieldNames: keys },
    });
    if (response?.error) {
      _.showErrorToast(response.error);
      setStatusMsg("");
      return;
    }
    const r = response?.result;
    if (!r?.success) {
      _.showErrorToast(r?.message || "Parse failed");
      setStatusMsg("");
      return;
    }
    const normalized = normalizeRowsLocally(r.data.rows);
    if (!normalized.ok) {
      _.showErrorToast(normalized.message);
      setStatusMsg("");
      return;
    }
    setRows(normalized.rows);
    const warn =
      r.data.missingColumns?.length > 0
        ? " (missing columns filled empty: " + r.data.missingColumns.join(", ") + ")"
        : "";
    setStatusMsg(r.data.rowCount + " row(s) loaded." + warn + " Edit if needed, then download ZIP.");
    _.showSuccessToast("CSV loaded");
  } catch (err) {
    _.showErrorToast(err?.message || "Failed to read file");
    setStatusMsg("");
  }
  e.target.value = "";
};

const MAX_ROWS = 2000;

const normalizeRowsLocally = (raw) => {
  const keys = schemaFieldNames();
  if (!keys.length) {
    return {
      ok: false,
      message: "Load a template with named fields first",
      rows: [],
    };
  }
  const rowSchema = _.z
    .record(_.z.string(), _.z.any())
    .transform((obj) => {
      const out = {};
      for (const k of keys) {
        const v = obj[k];
        out[k] = v == null ? "" : String(v).trim();
      }
      return out;
    });
  const arrSchema = _.z.array(rowSchema).max(MAX_ROWS);
  const parsed = arrSchema.safeParse(raw);
  if (!parsed.success) {
    const issues = parsed.error?.issues ?? parsed.error?.errors ?? [];
    const msg = issues
      .map((e) => ((e.path && e.path.join) ? e.path.join(".") : "") + ": " + e.message)
      .join("; ");
    return { ok: false, message: msg || "Validation failed", rows: [] };
  }
  return { ok: true, message: "", rows: parsed.data };
};

const downloadZip = async () => {
  const template = pdfTemplate();
  if (!template) {
    _.showWarningToast("Select a pdfme template JSON file first");
    return;
  }
  if (!rows().length) {
    _.showWarningToast("No rows");
    return;
  }
  const norm = normalizeRowsLocally(rows());
  if (!norm.ok) {
    _.showErrorToast(norm.message);
    return;
  }
  setRows(norm.rows);
  setBusy(true);
  setStatusMsg("Loading PDF engine from CDN…");
  try {
    // Always use latest pdfme — ignore template.pdfmeVersion (old pins break esm.sh deps).
    const ver = "6.1.11";
    const pdfmeUrl =
      "https://esm.sh/@pdfme/generator@" +
      ver +
      "?deps=@pdfme/common@" +
      ver +
      ",@pdfme/schemas@" +
      ver;
    const schemasUrl = "https://esm.sh/@pdfme/schemas@" + ver + "?deps=@pdfme/common@" + ver;
    const jszipUrl = "https://esm.sh/jszip@3.10.1";
    const [{ generate }, schemasMod, JSZipMod] = await Promise.all([
      import(pdfmeUrl),
      import(schemasUrl),
      import(jszipUrl),
    ]);
    const JSZip = JSZipMod.default;
    const {
      text,
      multiVariableText,
      list: listSchema,
      image,
      signature,
      svg,
      line,
      rectangle,
      ellipse,
      dateTime,
      date,
      time,
      select,
      checkbox,
      radioGroup,
      circleMark,
      barcodes,
      table,
    } = schemasMod;
    const plugins = {
      text,
      multiVariableText,
      list: listSchema,
      image,
      signature,
      svg,
      line,
      rectangle,
      ellipse,
      dateTime,
      date,
      time,
      select,
      checkbox,
      radioGroup,
      circleMark,
      table,
      qrcode: barcodes?.qrcode,
      japanpost: barcodes?.japanpost,
      ean13: barcodes?.ean13,
      ean8: barcodes?.ean8,
      code39: barcodes?.code39,
      code128: barcodes?.code128,
      nw7: barcodes?.nw7,
      itf14: barcodes?.itf14,
      upca: barcodes?.upca,
      upce: barcodes?.upce,
      gs1datamatrix: barcodes?.gs1datamatrix,
      pdf417: barcodes?.pdf417,
    };
    setStatusMsg("Generating PDFs…");
    const zip = new JSZip();
    const list = norm.rows;
    const keys = schemaFieldNames();
    for (let i = 0; i < list.length; i++) {
      setStatusMsg("Generating PDF " + (i + 1) + "/" + list.length + "…");
      const raw = list[i];
      const one = {};
      for (const k of keys) {
        one[k] = String(raw[k] ?? "");
      }
      const inputs = [one];
      const tplStyled = cloneWithFieldStyles(template, fieldPatches());
      const fontOpt = buildPdfmeFontOption(customFonts());
      const pdf = await generate({
        template: tplStyled,
        inputs,
        plugins,
        options: { font: fontOpt },
      });
      let buf;
      if (pdf instanceof Uint8Array) {
        buf = pdf;
      } else if (pdf && pdf.buffer) {
        buf = new Uint8Array(pdf.buffer);
      } else {
        buf = new Uint8Array(pdf);
      }
      const noPart = String(raw.No ?? "").trim() || String(i + 1);
      const namePart = String(raw.Name ?? "").trim();
      let fileBase =
        "ASK UMARALA DONATION RECEIPT - " + noPart + (namePart ? " " + namePart : "");
      fileBase = fileBase.replace(/[\\\\/:*?\"<>|]+/g, "_").replace(/\\s+/g, " ").trim();
      fileBase = fileBase.replace("MR. ", "").replace("M. ", "").replace("MRS. ", "");
      if (fileBase.length > 200) {
        fileBase = fileBase.slice(0, 200).trim();
      }
      let zipName = fileBase + ".pdf";
      if (zip.files[zipName]) {
        zipName = fileBase + "_" + String(i + 1) + ".pdf";
      }
      zip.file(zipName, buf);
    }
    setStatusMsg("Building ZIP…");
    const blob = await zip.generateAsync({ type: "blob" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "donation-reports-" + Date.now() + ".zip";
    a.click();
    URL.revokeObjectURL(url);
    _.showSuccessToast("ZIP download started");
    setStatusMsg("Done. " + list.length + " PDF(s) in ZIP.");
  } catch (err) {
    console.error(err);
    _.showErrorToast(err?.message || "ZIP generation failed");
    setStatusMsg("");
  } finally {
    setBusy(false);
  }
};

return {
  enabled: true,
  schemaFieldNames,
  rows,
  busy,
  statusMsg,
  templateFileLabel,
  origFonts,
  fontRegKey,
  setFontRegKey,
  customFonts,
  styleRows,
  getFieldPatch,
  patchFieldPatch,
  onPendingFontFile,
  registerCustomFont,
  removeCustomFont,
  clearFieldPatches,
  updateCell,
  addRow,
  deleteRow,
  onTemplateSelected,
  onCsvSelected,
  downloadZip,
};
