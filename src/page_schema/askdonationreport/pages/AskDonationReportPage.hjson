{
  vertexes: [
    {
      id: "adr1"
      L: Page
      P: {
        signinRequired: true
        url: /ask-donation-report
        key: AskDonationReportPage
        fns:
          '''const CANONICAL = ["Date", "Name", "Address", "Amount", "AmountInWords", "No", "PAN", "Phone"];

const emptyRow = () => {
  const o = {};
  for (const k of CANONICAL) {
    o[k] = "";
  }
  return o;
};

const [rows, setRows] = args.createSignal([emptyRow()]);
const [busy, setBusy] = args.createSignal(false);
const [statusMsg, setStatusMsg] = args.createSignal(
  "The table starts with one empty row. Add or remove rows, import a CSV, edit cells, then download ZIP.",
);

const addRow = () => {
  setRows((prev) => [...prev, emptyRow()]);
};

const deleteRow = (i) => {
  setRows((prev) => prev.filter((_, j) => j !== i));
};

const updateCell = (i, key, val) => {
  setRows((prev) => {
    const next = [...prev];
    const cur = { ...(next[i] || {}) };
    for (const k of CANONICAL) {
      if (cur[k] === undefined) {
        cur[k] = "";
      }
    }
    cur[key] = val;
    next[i] = cur;
    return next;
  });
};

const onCsvSelected = async (e) => {
  const f = e.target.files?.[0];
  if (!f) return;
  setStatusMsg("Parsing…");
  try {
    const text = await f.text();
    const response = await args.executeNamedServerFunction({
      functionName: "askDonationReportParseAndNormalizeCsv",
      contextData: { csvText: text },
    });
    if (response?.error) {
      args.showErrorToast(response.error);
      setStatusMsg("");
      return;
    }
    const r = response?.result;
    if (!r?.success) {
      args.showErrorToast(r?.message || "Parse failed");
      setStatusMsg("");
      return;
    }
    setRows(r.data.rows);
    const warn =
      r.data.missingColumns?.length > 0
        ? " (missing columns filled empty: " + r.data.missingColumns.join(", ") + ")"
        : "";
    setStatusMsg(r.data.rowCount + " row(s) loaded." + warn + " Edit if needed, then download ZIP.");
    args.showSuccessToast("CSV loaded");
  } catch (err) {
    args.showErrorToast(err?.message || "Failed to read file");
    setStatusMsg("");
  }
  e.target.value = "";
};

const validateRows = async () => {
  if (!rows().length) {
    args.showWarningToast("No rows to validate — add a row or import CSV");
    return;
  }
  const response = await args.executeNamedServerFunction({
    functionName: "askDonationReportValidateRows",
    contextData: { rows: rows() },
  });
  if (response?.error) {
    args.showErrorToast(response.error);
    return;
  }
  const r = response?.result;
  if (!r?.success) {
    args.showErrorToast(r?.message || "Validation failed");
    return;
  }
  setRows(r.data.rows);
  args.showSuccessToast("Rows validated");
};

const downloadZip = async () => {
  if (!rows().length) {
    args.showWarningToast("No rows");
    return;
  }
  setBusy(true);
  setStatusMsg("Loading PDF engine from CDN…");
  try {
    const pdfmeUrl =
      "https://esm.sh/@pdfme/generator@6.0.6?deps=@pdfme/common@6.0.6";
    const jszipUrl = "https://esm.sh/jszip@3.10.1";
    const [{ generate }, JSZipMod, templateRes] = await Promise.all([
      import(pdfmeUrl),
      import(jszipUrl),
      fetch("/api/askdonationreport/template"),
    ]);
    const JSZip = JSZipMod.default;
    if (!templateRes.ok) {
      throw new Error("Could not load template (HTTP " + templateRes.status + ")");
    }
    const template = await templateRes.json();
    setStatusMsg("Generating PDFs…");
    const zip = new JSZip();
    const list = rows();
    for (let i = 0; i < list.length; i++) {
      setStatusMsg("Generating PDF " + (i + 1) + "/" + list.length + "…");
      const raw = list[i];
      const one = {};
      for (const k of CANONICAL) {
        one[k] = String(raw[k] ?? "");
      }
      const inputs = [one];
      const pdf = await generate({ template, inputs });
      let buf;
      if (pdf instanceof Uint8Array) {
        buf = pdf;
      } else if (pdf && pdf.buffer) {
        buf = new Uint8Array(pdf.buffer);
      } else {
        buf = new Uint8Array(pdf);
      }
      const base = String(raw.No ?? i + 1).replace(/[^a-zA-Z0-9._-]+/g, "_") || "row_" + (i + 1);
      zip.file("donation-" + base + ".pdf", buf);
    }
    setStatusMsg("Building ZIP…");
    const blob = await zip.generateAsync({ type: "blob" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "donation-reports-" + Date.now() + ".zip";
    a.click();
    URL.revokeObjectURL(url);
    args.showSuccessToast("ZIP download started");
    setStatusMsg("Done. " + list.length + " PDF(s) in ZIP.");
  } catch (err) {
    console.error(err);
    args.showErrorToast(err?.message || "ZIP generation failed");
    setStatusMsg("");
  } finally {
    setBusy(false);
  }
};

return {
  enabled: true,
  CANONICAL,
  rows,
  busy,
  statusMsg,
  updateCell,
  addRow,
  deleteRow,
  onCsvSelected,
  validateRows,
  downloadZip,
};
'''
        props:
          '''return { isNoPermissionCheck: true };'''
      }
