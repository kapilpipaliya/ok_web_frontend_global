{
  vertexes: [
    {
      id: adr_val_root
      L: Function
      P: {
        key: askDonationReportValidateRows
        description: Validate and normalize edited donation report rows for pdfme template fields
        body:
          '''const CANONICAL = ["Date", "Name", "Address", "Amount", "AmountInWords", "No", "PAN", "Phone"];
const MAX_ROWS = 2000;

const raw = args.contextData?.rows;
if (!Array.isArray(raw)) {
  return { success: false, message: "rows must be an array", data: null };
}
if (raw.length === 0) {
  return { success: false, message: "rows is empty", data: null };
}
if (raw.length > MAX_ROWS) {
  return { success: false, message: `At most ${MAX_ROWS} rows allowed`, data: null };
}

const rowSchema = args.z.record(args.z.string(), args.z.any()).transform((obj) => {
  const out = {};
  for (const k of CANONICAL) {
    const v = obj[k];
    out[k] = v == null ? "" : String(v).trim();
  }
  return out;
});

const arrSchema = args.z.array(rowSchema);
const parsed = arrSchema.safeParse(raw);
if (!parsed.success) {
  const issues = parsed.error.issues || parsed.error.errors || [];
  const msg = issues.map((e) => `${(e.path || []).join(".")}: ${e.message}`).join("; ");
  return { success: false, message: msg || "Validation failed", data: null };
}

const rows = parsed.data;

return {
  success: true,
  message: `Validated ${rows.length} row(s)`,
  data: { rows, rowCount: rows.length },
};
'''
      }
    }
  ]
  edges: []
}
