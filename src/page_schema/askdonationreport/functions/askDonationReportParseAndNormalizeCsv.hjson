{
  vertexes: [
    {
      id: adr_parse_root
      L: Function
      P: {
        key: askDonationReportParseAndNormalizeCsv
        description: Parse CSV; map headers to template field names from contextData.fieldNames (case-insensitive). Synonyms for a column whose name is "Mode" still apply.
        body:
          '''const MAX_ROWS = 2000;

const { csvText, fieldNames } = args.contextData || {};

if (!csvText || typeof csvText !== "string") {
  return { success: false, message: "csvText is required", data: null };
}

if (!Array.isArray(fieldNames) || fieldNames.length === 0) {
  return {
    success: false,
    message: "fieldNames is required (array of template schema field names from the client)",
    data: null,
  };
}

const FIELD_NAMES = fieldNames.map((x) => String(x));

function parseCSVLine(line, delimiter) {
  const result = [];
  let current = "";
  let inQuotes = false;

  for (let i = 0; i < line.length; i++) {
    const char = line[i];

    if (char === '"') {
      if (inQuotes && line[i + 1] === '"') {
        current += '"';
        i++;
      } else {
        inQuotes = !inQuotes;
      }
    } else if (char === delimiter && !inQuotes) {
      result.push(current.trim());
      current = "";
    } else {
      current += char;
    }
  }
  result.push(current.trim());
  return result;
}

const cleaned = csvText.replace(/^\uFEFF/, "").trim();
if (!cleaned) {
  return { success: false, message: "CSV is empty", data: null };
}

const lines = cleaned.split(/\r?\n/).filter((l) => l.length > 0);
if (lines.length < 2) {
  return { success: false, message: "CSV must include a header row and at least one data row", data: null };
}

const firstLine = lines[0];
const delimiter = firstLine.includes("\t") ? "\t" : ",";
const rawHeaders = parseCSVLine(lines[0], delimiter);

const headerToCanonical = new Map();
const modeField = FIELD_NAMES.find((f) => f.toLowerCase() === "mode");

for (let i = 0; i < rawHeaders.length; i++) {
  const h = rawHeaders[i].replace(/^\uFEFF/, "").trim();
  if (!h) continue;
  const lower = h.toLowerCase();
  let matched = false;
  for (const c of FIELD_NAMES) {
    if (c.toLowerCase() === lower) {
      headerToCanonical.set(i, c);
      matched = true;
      break;
    }
  }
  if (
    !matched &&
    modeField &&
    (lower === "payment mode" || lower === "payment_mode" || lower === "mode of payment")
  ) {
    headerToCanonical.set(i, modeField);
  }
}

const missing = FIELD_NAMES.filter((c) => ![...headerToCanonical.values()].includes(c));
if (missing.length === FIELD_NAMES.length) {
  return {
    success: false,
    message: `No recognized columns. Expected headers matching: ${FIELD_NAMES.join(", ")}`,
    data: null,
  };
}

const rows = [];
for (let r = 1; r < lines.length; r++) {
  const line = lines[r].trim();
  if (!line) continue;

  const values = parseCSVLine(line, delimiter);
  const row = {};
  for (const c of FIELD_NAMES) {
    row[c] = "";
  }
  for (let ci = 0; ci < values.length; ci++) {
    const canon = headerToCanonical.get(ci);
    if (!canon) continue;
    let v = values[ci] ?? "";
    if (v.startsWith('"') && v.endsWith('"') && v.length >= 2) {
      v = v.slice(1, -1).replace(/""/g, '"');
    }
    row[canon] = String(v).trim();
  }
  rows.push(row);

  if (rows.length > MAX_ROWS) {
    return {
      success: false,
      message: `Too many rows (max ${MAX_ROWS})`,
      data: null,
    };
  }
}

if (rows.length === 0) {
  return { success: false, message: "No data rows found", data: null };
}

return {
  success: true,
  message: `Parsed ${rows.length} row(s)`,
  data: { rows, rowCount: rows.length, missingColumns: missing },
};
'''
      }
    }
  ]
  edges: []
}
