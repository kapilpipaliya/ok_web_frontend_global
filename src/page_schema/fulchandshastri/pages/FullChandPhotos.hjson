    { id: "e19", T: "Attr", S: "photosGrid", E: "photoItem" },
    { id: "e20", T: "Attr", S: "photoItem", E: "photoImage" },
    { id: "e21", T: "Attr", S: "photoItem", E: "photoCaption" },
    { id: "e22", T: "Attr", S: "photoCaption", E: "captionText" },
    { id: "e23", T: "Attr", S: "photosSection", E: "viewAllButton" },
    { id: "e24", T: "Attr", S: "viewAllButton", E: "viewAllLink" },
    { id: "e25", T: "Attr", S: "viewAllLink", E: "viewAllText" },
