{
  vertexes: [
    {
      id: "page",
      L: "Page",
      P: {
        public: true
        key: "FullChandBooks",
        fns: "return { enabled: () => true }",
        isNoPermissionCheck: true,
        url: "/books"
        contextName: "booksSettings"
        settingsPageId: "books"
        serverFunction: '''
try {
  const result = await args.executeNamedServerFunction({
    functionName: "loadFulchandPublicPageSettings",
    contextData: { pageId: "books", allowPublicRead: true }
  });
  if (!result?.result?.success) return {};
  return result.result.data?.sections || {};
} catch (error) {
  console.error("Error loading page settings:", error);
  return {};
}
'''
      }
    },
    {
      id: "pageHeader",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  background: linear-gradient(135deg, ${args.theme.var.color.primary_light_100} 0%, ${args.theme.var.color.primary_light_50} 100%);
  padding: 3rem 1rem;
  text-align: center;
}`;
'''
      }
    },
    {
      id: "pageTitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const content = args.contextData.booksSettings?.content;
return {
  as: "h1",
  text: content?.pageTitle
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text};
  font-size: 3rem;
  font-weight: 700;
  margin: 0;
  
  @media (max-width: 768px) {
    font-size: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "pageSubtitle",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const content = args.contextData.booksSettings?.content;
return {
  as: "p",
  text: content?.pageSubtitle
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text_light_200};
  font-size: 1.25rem;
  margin-top: 1rem;
}`;
'''
      }
    },
    {
      id: "mainContent",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "main"
};
''',
        css: '''
return `._id {
  padding: 3rem 1rem;
}`;
'''
      }
    },
    {
      id: "container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1200px;
  margin: 0 auto;
}`;
'''
      }
    },
    {
      id: "booksData",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "books",
        loop: true,
        props: '''
const items = args.contextData.booksSettings?.books?.books ?? [];
return {
  as: "fragment",
  data: items
};
'''
      }
    },
    {
      id: "booksList",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}`;
'''
      }
    },
    {
      id: "bookCard",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "FullChandBookCard",
        props: '''
const book = args.contextData.books;
return book;
'''
      }
    },
    {
      id: "layout",
      L: "PageLayout",
      P: {
        displayOrder: 1,
        componentName: "FullChandLayout"
      }
    }
  ],
  edges: [
    { id: "e0", T: "Attr", S: "page", E: "pageHeader" },
    { id: "e3", T: "Attr", S: "pageHeader", E: "pageTitle" },
    { id: "e4", T: "Attr", S: "pageHeader", E: "pageSubtitle" },
    { id: "e5", T: "Attr", S: "page", E: "mainContent" },
    { id: "e6", T: "Attr", S: "mainContent", E: "container" },
    { id: "e7", T: "Attr", S: "container", E: "booksData" },
    { id: "e8", T: "Attr", S: "booksData", E: "booksList" },
    { id: "e9", T: "Attr", S: "booksList", E: "bookCard" },
    { id: "e_layout", T: "PageLayout", S: "page", E: "layout" }
  ]
}