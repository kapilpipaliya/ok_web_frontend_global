{
  vertexes: [
    {
      id: "page",
      L: "Page",
      P: {
        public: true
        key: "FullChandBooks",
        fns: "return { enabled: () => true }",
        isNoPermissionCheck: true,
        url: "/books"
        settingsPageId: "books"
        props: '''
const locale = args.params?.lang ? String(args.params.lang).toLowerCase() : undefined;
return {
  contextName: "booksSettings",
  serverFunction: `
try {
  const pageResult = await args.executeNamedServerFunction({
    functionName: "loadFulchandPublicPageSettings",
    contextData: { pageId: "books", allowPublicRead: true, locale: ${JSON.stringify(locale ?? null)} }
  });
  const tableResult = await args.executeNamedServerFunction({
    functionName: "loadPublicTableContent",
    contextData: { tableKey: "books", tableVertexLabel: "Book", locale: ${JSON.stringify(locale ?? null)} }
  });

  const sections = pageResult?.result?.success ? (pageResult.result.data?.sections || {}) : {};
  const tableData = tableResult?.result?.success ? (tableResult.result.data || {}) : {};
  return {
    content: sections.content || {},
    table: {
      rowIds: tableData.rowIds || [],
      partVertexIds: tableData.partVertexIds || {},
      ids: tableData.ids || null,
      graph: tableData.graph || null
    }
  };
} catch (error) {
  console.error("Error loading books page:", error);
  return { content: {}, table: { rowIds: [], partVertexIds: {}, ids: null, graph: null } };
}
`
};
'''
      }
    },
    {
      id: "pageHeader",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  background: linear-gradient(135deg, ${args.theme.var.color.primary_light_100} 0%, ${args.theme.var.color.primary_light_50} 100%);
  padding: 3rem 1rem;
  text-align: center;
}`;
'''
      }
    },
    {
      id: "pageTitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const content = args.contextData.booksSettings?.content;
return {
  as: "h1",
  text: content?.pageTitle
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text};
  font-size: 3rem;
  font-weight: 700;
  margin: 0;
  
  @media (max-width: 768px) {
    font-size: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "pageSubtitle",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const content = args.contextData.booksSettings?.content;
return {
  as: "p",
  text: content?.pageSubtitle
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text_light_200};
  font-size: 1.25rem;
  margin-top: 1rem;
}`;
'''
      }
    },
    {
      id: "mainContent",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "main"
};
''',
        css: '''
return `._id {
  padding: 3rem 1rem;
}`;
'''
      }
    },
    {
      id: "container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1200px;
  margin: 0 auto;
}`;
'''
      }
    },
    {
      id: "booksTable",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "FullChandPublicTable",
        props: '''
const table = args.contextData.booksSettings?.table || {};
return {
  tableKey: "books",
  tableVertexLabel: "Book",
  rowIds: table.rowIds || [],
  partVertexIds: table.partVertexIds || {},
  ids: table.ids || null,
  graph: table.graph
};
'''
      }
    },
    {
      id: "layout",
      L: "PageLayout",
      P: {
        displayOrder: 1,
        componentName: "FullChandLayout"
      }
    }
  ],
  edges: [
    { id: "e0", T: "Attr", S: "page", E: "pageHeader" },
    { id: "e3", T: "Attr", S: "pageHeader", E: "pageTitle" },
    { id: "e4", T: "Attr", S: "pageHeader", E: "pageSubtitle" },
    { id: "e5", T: "Attr", S: "page", E: "mainContent" },
    { id: "e6", T: "Attr", S: "mainContent", E: "container" },
    { id: "e7", T: "Attr", S: "container", E: "booksTable" },
    { id: "e_layout", T: "PageLayout", S: "page", E: "layout" }
  ]
}
