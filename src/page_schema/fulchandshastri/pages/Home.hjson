        displayOrder: 1
        componentName: Html
        key: unique_6
        props:
          '''
const banner = args.contextData.banner;
const rawPath = banner?.P?.description != null ? String(banner.P.description).trim() : "";

const localizeHref = (path) => {
  if (!path) return null;
  if (/^https?:\/\//i.test(path) || path.startsWith("mailto:") || path === "#") {
    return path;
  }
  const normalized = path.startsWith("/") ? path : `/${path}`;
  const lang = args.params?.lang ? String(args.params.lang).toLowerCase() : "";
  // Match [lang]/[...page].tsx: only prefix when first segment is a language code
  if (lang && /^[a-z]{2,3}$/i.test(lang)) {
    if (normalized === "/") return `/${lang}`;
    return `/${lang}${normalized}`;
  }
  return normalized;
};

const href = localizeHref(rawPath);

return {
  as: href ? "a" : "div",
  ...(href ? { href } : {})
};
'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''
const isFirst = (args.contextData.index ?? 0) === 0;
return [
  `@keyframes homeBannerFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}`,
  `._id {
  display: block;
  width: 100%;
  height: auto;
  min-height: 12rem;
  object-fit: cover;
  object-position: center;
  ${isFirst ? `
  opacity: 0;
  animation: homeBannerFadeIn 0.55s ease forwards;
  ` : ""}
}`
];'''
        displayOrder: 1
