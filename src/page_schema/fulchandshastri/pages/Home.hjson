{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        settingsPageId: home
        description: Home
        isNoPermissionCheck: true
        fns: return { enabled: () => true }
        url: /
        key: Home
        updatedAt: 2026-07-16T18:35:22.667Z
        props:
          '''
const locale = args.params?.lang ? String(args.params.lang).toLowerCase() : undefined;
return {
  contextName: "homeSettings",
  serverFunction: `
try {
  const result = await args.executeNamedServerFunction({
    functionName: "loadPublicPageSettings",
    contextData: { pageId: "home", allowPublicRead: true, locale: ${JSON.stringify(locale ?? null)} }
  });
  const sections = result?.result?.success ? (result.result.data?.sections || {}) : {};

  let banners = [];
  try {
    const bannerResult = await args.executeNamedServerFunction({
      functionName: "loadPublicCategoryContent",
      contextData: {
        tableKey: "files",
        tableVertexLabel: "File",
        categoryKey: "HomeBanner",
        locale: ${JSON.stringify(locale ?? null)}
      }
    });
    const rows = bannerResult?.result?.success
      ? (bannerResult.result.data?.rows || [])
      : [];
    banners = rows.filter((file) => {
      const mime = String(file?.P?.mimeType || file?.P?.fileType || "");
      if (mime.startsWith("image/")) return true;
      const name = String(file?.P?.fileName || "").toLowerCase();
      return (
        name.endsWith(".png") ||
        name.endsWith(".jpg") ||
        name.endsWith(".jpeg") ||
        name.endsWith(".gif") ||
        name.endsWith(".webp") ||
        name.endsWith(".svg") ||
        name.endsWith(".avif")
      );
    });
  } catch (bannerError) {
    console.error("Error loading HomeBanner images:", bannerError);
  }

  return {
    ...sections,
    banners
  };
} catch (error) {
  console.error("Error loading page settings:", error);
  return { banners: [] };
}
`
};
'''
