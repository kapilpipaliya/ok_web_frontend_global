{
  vertexes: [
    {
      id: "page",
      L: "Page",
      P: {
        public: true
        key: "FullChandDonation",
        fns: "return { enabled: () => true }",
        isNoPermissionCheck: true,
        url: "/donation"
      }
    },
    {
      id: "rootAttr",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${args.theme.var.color.background};
}`;
'''
      }
    },
    {
      id: "header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "FullChandHeader",
        props: '''
return {};
'''
      }
    },
    {
      id: "pageHeader",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
