        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "Your generous contributions help us continue our mission of spreading divine knowledge and supporting spiritual seekers worldwide. Every donation, regardless of size, makes a meaningful impact in our efforts to share the teachings of enlightenment."
};
''',
        css: '''
return `._id {
  font-size: 1.125rem;
