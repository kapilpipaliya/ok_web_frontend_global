{
  vertexes: [
    {
      id: "page",
      L: "Page",
      P: {
        key: "PortalTable",
        url: "/portal/table",
        title: "Table Admin",
        signinRequired: true,
        fns: '''
const checkAdminRole = () => {
  const userRoles = args.user?.OUT?.UserRole || [];
  return userRoles.some((edgeId) => {
    const edge = args.graph.edges[edgeId];
    const role = args.graph.vertexes[edge?.E];
    return role?.P?.key === "Admin";
  });
};

const TABLE_KEY_BY_LABEL = {
  Book: "books",
  RecommendedBook: "recommended_books",
  GalleryItem: "gallery",
  ScheduleEvent: "schedule",
  File: "files",
  Page: "pages",
  Component: "components",
  Function: "functions",
  EmailTemplate: "email_templates"
};

const TABLE_TITLE_BY_LABEL = {
  Book: "Books By Fulchand",
  RecommendedBook: "Books Recommended by Fulchand",
  GalleryItem: "Gallery",
  ScheduleEvent: "Schedule",
  File: "Files",
  Page: "Pages",
  Component: "Components",
  Function: "Functions",
  EmailTemplate: "Email templates"
};

const PAGE_DESIGNER_ENTITIES = new Set(["Page", "Component", "Function", "EmailTemplate"]);
const PAGE_DESIGNER_KEY_ENTITIES = new Set(["Page", "Component"]);

const getTableVertexLabel = () => {
  const table = args.searchParams?.table;
  if (table) {
    const value = String(table).trim();
    if (TABLE_KEY_BY_LABEL[value]) return value;
    return value;
  }
  return "Book";
};

const getTableKey = () => {
  const fromQuery = args.searchParams?.key;
  if (fromQuery != null && String(fromQuery).trim() !== "") return String(fromQuery).trim();
  const label = getTableVertexLabel();
  return TABLE_KEY_BY_LABEL[label] || "books";
};

const getPageDesignerEntity = () => {
  const label = getTableVertexLabel();
  return PAGE_DESIGNER_ENTITIES.has(label) ? label : null;
};

const getPageDesignerPath = (entity, row) => {
  if (!entity || !row) return null;
  const useKey = PAGE_DESIGNER_KEY_ENTITIES.has(entity);
  const segment = useKey ? row?.P?.key : row?.id;
  if (segment == null || String(segment).trim() === "") return null;
  return `/admin/${entity}/${encodeURIComponent(String(segment).trim())}`;
};

const openInPageDesigner = (row) => {
  const entity = getPageDesignerEntity();
  if (!entity) return;
  const path = getPageDesignerPath(entity, row);
  if (path) args.navigate(path);
};

const deleteDesignerEntity = async (row) => {
  const entity = getPageDesignerEntity();
  if (!entity) return;
  const id = row?.id;
  if (!id) return;
  const result = await args.postAPI("/api/page/delete", { id }, "DELETE");
  if (result?.success) {
    if (result.graph) {
      args.setGraphData(0, result.graph, {});
    }
    args.showSuccessToast?.(`${getTableTitle()} entry deleted successfully`);
    const table = getTableVertexLabel();
    const key = getTableKey();
    if (isSchemaMode()) {
      args.setSearchParams({ table, key, mode: "schema" }, { replace: true });
    } else {
      args.setSearchParams({ table, key, mode: null }, { replace: true });
    }
    return;
  }
  args.showErrorToast?.(result?.error || `Failed to delete ${entity}`);
  throw new Error(result?.error || "Delete failed");
};

const getTableActionHandlers = () => {
  if (!getPageDesignerEntity()) return undefined;
  return {
    edit: openInPageDesigner,
    delete: deleteDesignerEntity
  };
};

const makeDeleteConfirm = (entityLabel) => ({
  title: `Delete ${entityLabel.toLowerCase()}?`,
  message: "This cannot be undone.",
  confirmText: "Delete",
  cancelText: "Cancel",
  variant: "danger"
});

const getDesignerTableActions = () => [
  {
    key: "edit",
    type: "edit",
    icon: "ph:pen",
    title: "Open in page designer",
    ariaLabel: "Open in page designer"
  },
  {
    key: "delete",
    type: "delete",
    icon: "ph:trash",
    confirm: makeDeleteConfirm(getTableTitle().replace(/s$/, "") || "item")
  }
];

const getTableActions = () => {
  if (getPageDesignerEntity()) return getDesignerTableActions();
  if (getTableVertexLabel() === "Book") {
    return [
      { key: "edit", type: "edit" },
      { key: "delete", type: "delete", confirm: makeDeleteConfirm("book") }
    ];
  }
  if (getTableVertexLabel() === "RecommendedBook") {
    return [
      { key: "edit", type: "edit" },
      { key: "delete", type: "delete", confirm: makeDeleteConfirm("recommended book") }
    ];
  }
  if (getTableVertexLabel() === "GalleryItem") {
    return [
      { key: "edit", type: "edit" },
      { key: "delete", type: "delete", confirm: makeDeleteConfirm("gallery item") }
    ];
  }
  if (getTableVertexLabel() === "ScheduleEvent") {
    return [
      { key: "edit", type: "edit" },
      { key: "delete", type: "delete", confirm: makeDeleteConfirm("event") }
    ];
  }
  if (getTableVertexLabel() === "File") {
    return [
      { key: "edit", type: "edit" },
      { key: "delete", type: "delete", confirm: makeDeleteConfirm("file") }
    ];
  }
  return undefined;
};

const getTableTitle = () => {
  const label = getTableVertexLabel();
  return TABLE_TITLE_BY_LABEL[label] || `${label} table`;
};

const isSchemaMode = () => args.searchParams?.mode === "schema";

const setEditorMode = (mode) => {
  const table = getTableVertexLabel();
  const key = getTableKey();
  if (mode === "schema") {
    args.setSearchParams({ table, key, mode: "schema" }, { replace: true });
  } else {
    args.setSearchParams({ table, key, mode: null }, { replace: true });
  }
};

const onSchemaSaved = () => {
  const tableKey = args.fns.getTableKey?.();
  if (!tableKey || String(tableKey).trim() === "") {
    args.showErrorToast?.("Table key missing. Unable to process schema save.");
    return;
  }
  if (typeof window !== "undefined") {
    window.dispatchEvent(new CustomEvent("fulchand-table-schema-saved", { detail: { tableKey } }));
  }
  args.showSuccessToast?.("Table schema saved");
};

return {
  checkAdminRole,
  getTableVertexLabel,
  getTableKey,
  getTableTitle,
  getTableActionHandlers,
  getTableActions,
  openInPageDesigner,
  isSchemaMode,
  setEditorMode,
  onSchemaSaved
};
''',
        props: '''
return {
  isNoPermissionCheck: true,
  onMount: () => {
    if (!args.user) {
      args.navigate("/auth/signin", { replace: true });
      return;
    }
    if (!args.fns.checkAdminRole?.()) {
      args.showErrorToast?.("Admin access required");
      args.navigate("/", { replace: true });
    }
  }
};
'''
      }
    },
    {
      id: "shell",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "section",
  hide: !args.fns.checkAdminRole?.()
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  height: 100%;
  overflow: hidden;
}`;
'''
      }
    },
    {
      id: "header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return { as: "header" };
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.75rem 1rem;
  border-bottom: 1px solid ${args.theme.var.color.border_light_300};
  background: ${args.theme.var.color.background};
  flex-shrink: 0;
}`;
'''
      }
    },
    {
      id: "headerTitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: args.fns.getTableTitle?.()
};
''',
        css: '''
return `._id {
  margin: 0;
  font-size: 1.25rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "modeTabs",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return { as: "div" };
''',
        css: '''
return `._id {
  display: flex;
  gap: 0.5rem;
}`;
'''
      }
    },
    {
      id: "contentTab",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Button",
        props: '''
const active = args.fns.isSchemaMode?.() !== true;
return {
  text: "Content",
  variant: active ? "primary" : "secondary",
  onClick: () => args.fns.setEditorMode?.("content")
};
'''
      }
    },
    {
      id: "schemaTab",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Button",
        props: '''
const active = args.fns.isSchemaMode?.() === true;
return {
  text: "Schema",
  variant: active ? "primary" : "secondary",
  onClick: () => args.fns.setEditorMode?.("schema")
};
'''
      }
    },
    {
      id: "contentPane",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: args.fns.isSchemaMode?.() === true
};
''',
        css: '''
return `._id {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}`;
'''
      }
    },
    {
      id: "dynamicPage",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "DynamicPage",
        props: '''
const tableKey = args.fns.getTableKey?.() || "books";
const tableVertexLabel = args.fns.getTableVertexLabel?.() || "Book";
const actionHandlers = args.fns.getTableActionHandlers?.();
const actions = args.fns.getTableActions?.();
return {
  tableKey,
  tableVertexLabel,
  loadFromSetting: true,
  usePolarisUI: true,
  ...(actions ? { actions } : {}),
  ...(actionHandlers ? { actionHandlers } : {}),
  ...(actionHandlers ? { onRowClick: (row) => args.fns.openInPageDesigner?.(row) } : {})
};
'''
      }
    },
    {
      id: "schemaPane",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: args.fns.isSchemaMode?.() !== true
};
''',
        css: '''
return `._id {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}`;
'''
      }
    },
    {
      id: "schemaEditor",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "TableSchemaEditorShell",
        props: '''
const tableKey = args.fns.getTableKey?.();
return {
  tableKey,
  embeddedMode: true,
  onSaved: () => args.fns.onSchemaSaved?.()
};
'''
      }
    },
    {
      id: "layout",
      L: "PageLayout",
      P: {
        displayOrder: 1,
        componentName: "PortalLayout"
      }
    }
  ],
  edges: [
    { id: "e1", T: "Attr", S: "page", E: "shell" },
    { id: "e2", T: "Attr", S: "shell", E: "header" },
    { id: "e3", T: "Attr", S: "header", E: "headerTitle" },
    { id: "e4", T: "Attr", S: "header", E: "modeTabs" },
    { id: "e5", T: "Attr", S: "modeTabs", E: "contentTab" },
    { id: "e6", T: "Attr", S: "modeTabs", E: "schemaTab" },
    { id: "e7", T: "Attr", S: "shell", E: "contentPane" },
    { id: "e8", T: "Attr", S: "contentPane", E: "dynamicPage" },
    { id: "e9", T: "Attr", S: "shell", E: "schemaPane" },
    { id: "e10", T: "Attr", S: "schemaPane", E: "schemaEditor" },
    { id: "e_layout", T: "PageLayout", S: "page", E: "layout" }
  ]
}
