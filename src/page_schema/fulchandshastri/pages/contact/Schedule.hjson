{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        settingsPageId: schedule
        isNoPermissionCheck: true
        fns: return { enabled: () => true }
        url: /schedule
        key: Schedule
        updatedAt: 2026-07-14T15:36:49.029Z
        props:
          '''
const locale = args.params?.lang ? String(args.params.lang).toLowerCase() : undefined;
return {
  contextName: "scheduleSettings",
  serverFunction: `
try {
  const pageResult = await args.executeNamedServerFunction({
    functionName: "loadPublicPageSettings",
    contextData: { pageId: "schedule", allowPublicRead: true, locale: ${JSON.stringify(locale ?? null)} }
  });
  const tableResult = await args.executeNamedServerFunction({
    functionName: "loadPublicTableContent",
    contextData: { tableKey: "schedule", tableVertexLabel: "ScheduleEvent", locale: ${JSON.stringify(locale ?? null)} }
  });

  const sections = pageResult?.result?.success ? (pageResult.result.data?.sections || {}) : {};
  const tableData = tableResult?.result?.success ? (tableResult.result.data || {}) : {};
  const graph = tableData.graph || { vertexes: {}, edges: {} };
  const rowIds = Array.isArray(tableData.rowIds) ? tableData.rowIds : [];

  const parseDate = (value) => {
    if (value == null || value === "") return null;
    const d = new Date(value);
    return Number.isNaN(d.getTime()) ? null : d;
  };

  const formatDate = (value) => {
    const d = parseDate(value);
    if (!d) return value != null ? String(value) : "";
    return d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
  };

  const today = new Date();
  today.setHours(0, 0, 0, 0);

  const events = rowIds.map((id) => {
    const event = graph.vertexes?.[id];
    const edgeIds = event?.OUT?.ScheduleEventBannerFile || [];
    let banner = "";
    if (Array.isArray(edgeIds) && edgeIds.length > 0) {
      const edge = graph.edges?.[edgeIds[0]];
      const file = edge?.E != null ? graph.vertexes?.[edge.E] : null;
      const fileName = file?.P?.fileName != null ? String(file.P.fileName).trim() : "";
      if (fileName) banner = "/api/file/download/" + encodeURIComponent(fileName);
    }
    return {
      id,
      startDateRaw: event?.P?.startDate ?? "",
      endDateRaw: event?.P?.endDate ?? "",
      startDate: formatDate(event?.P?.startDate),
      endDate: formatDate(event?.P?.endDate),
      place: event?.P?.place || "",
      programme: event?.P?.programme || "",
      details: event?.P?.details || "",
      banner
    };
  });

  const upcomingByYear = {};
  const previousByYear = {};

  for (const event of events) {
    const start = parseDate(event.startDateRaw);
    const end = parseDate(event.endDateRaw) || start;
    const year = (start || end)?.getFullYear();
    if (year == null) continue;
    const isPrevious = end && end < today;
    const bucket = isPrevious ? previousByYear : upcomingByYear;
    if (!bucket[year]) bucket[year] = [];
    bucket[year].push(event);
  }

  const sortByStart = (a, b) => {
    const da = parseDate(a.startDateRaw)?.getTime() ?? 0;
    const db = parseDate(b.startDateRaw)?.getTime() ?? 0;
    return da - db;
  };

  const yearSections = [];
  const upcomingYears = Object.keys(upcomingByYear).map(Number).sort((a, b) => a - b);
  for (const year of upcomingYears) {
    yearSections.push({
      id: "upcoming-" + year,
      title: "Upcoming events in " + year,
      rows: upcomingByYear[year].slice().sort(sortByStart)
    });
  }
  const previousYears = Object.keys(previousByYear).map(Number).sort((a, b) => b - a);
  for (const year of previousYears) {
    yearSections.push({
      id: "previous-" + year,
      title: "Previous events in " + year,
      rows: previousByYear[year].slice().sort((a, b) => -sortByStart(a, b))
    });
  }

  return {
    content: sections.content || {},
    yearSections
  };
} catch (error) {
  console.error("Error loading schedule page:", error);
  return { content: {}, yearSections: [] };
}
`
};
'''
      }
    }
