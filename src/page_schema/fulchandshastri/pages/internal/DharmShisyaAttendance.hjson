{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns: return { enabled: () => true }
        key: DharmShisyaAttendance
        url: /dharm-shisya-attendance
        props:
          '''return {
  isNoPermissionCheck: true
};'''
        updatedAt: 2026-10-15T08:00:00.000Z
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        fns:
          '''const STORAGE_KEY = "dharm-shisya-roster";
const YETI_CSS_HREF = "/yeti/yeti.css";
const YETI_THEME_HREF = "/yeti/soft.css";

const FORM_DEFAULTS = {
  sessionDate: "",
  roster: "",
  present: ""
};

const [formManagementFns, setFormManagementFns] = _.createSignal(null);
const [formValues, setFormValues] = _.createSignal({ ...FORM_DEFAULTS });
const [result, setResult] = _.createSignal(null);
const [yetiReady, setYetiReady] = _.createSignal(false);

const normalizeIdKey = (id) => {
  const digits = String(id ?? "").replace(/\D/g, "");
  if (!digits) return "";
  return String(parseInt(digits, 10));
};

const formatId = (id) => {
  const key = normalizeIdKey(id);
  if (!key) return "";
  return key.padStart(3, "0");
};

// Parses "001 Atmarthi" and multi-entry rows like
// "001 Atmarthi 002 Swarupanandi" into id+name pairs.
const parseEntries = (text) => {
  const map = new Map();
  const lines = String(text ?? "").split(/\r?\n/);

  for (const rawLine of lines) {
    const line = rawLine.trim();
    if (!line) continue;

    const re = /(\d+)\s+([^\d]+?)(?=\s+\d+\s+\S|$)/g;
    let match;
    let found = false;

    while ((match = re.exec(line)) !== null) {
      found = true;
      const rawId = match[1];
      const name = String(match[2] || "").trim().replace(/\s+/g, " ");
      const key = normalizeIdKey(rawId);
      if (!key || !name) continue;
      const id = formatId(rawId);
      map.set(key, {
        key,
        id,
        name,
        display: `${id} ${name}`
      });
    }

    if (!found) {
      const simple = line.match(/^(\d+)\s+(.+)$/);
      if (simple) {
        const rawId = simple[1];
        const name = String(simple[2] || "").trim().replace(/\s+/g, " ");
        const key = normalizeIdKey(rawId);
        if (key && name) {
          const id = formatId(rawId);
          map.set(key, {
            key,
            id,
            name,
            display: `${id} ${name}`
          });
        }
      }
    }
  }

  return map;
};

const entriesToText = (entries) => {
  return [...entries.values()]
    .sort((a, b) => Number(a.key) - Number(b.key))
    .map((e) => e.display)
    .join("\n");
};

const readValuesFromForm = (formFns) => {
  if (!formFns?.getFieldValue) return { ...formValues() };
  const next = { ...FORM_DEFAULTS };
  for (const key of Object.keys(FORM_DEFAULTS)) {
    const value = formFns.getFieldValue(key);
    if (value !== undefined && value !== null) {
      next[key] = value;
    }
  }
  return next;
};

const loadRosterFromStorage = () => {
  try {
    const saved = localStorage.getItem(STORAGE_KEY);
    return typeof saved === "string" ? saved : "";
  } catch (error) {
    console.warn("Could not read roster storage", error);
    return "";
  }
};

const saveRosterToStorage = (rosterText) => {
  try {
    localStorage.setItem(STORAGE_KEY, String(rosterText ?? ""));
    return true;
  } catch (error) {
    console.error("Could not save roster", error);
    return false;
  }
};

const ensureYetiStyles = () => {
  const ensureLink = (id, href) => {
    let link = document.getElementById(id);
    if (!link) {
      link = document.createElement("link");
      link.id = id;
      link.rel = "stylesheet";
      link.href = href;
      document.head.appendChild(link);
    } else if (link.getAttribute("href") !== href) {
      link.href = href;
    }
  };
  ensureLink("yeti-css", YETI_CSS_HREF);
  ensureLink("yeti-theme-soft", YETI_THEME_HREF);
  setYetiReady(true);
};

const registerFormManagementFns = (formFns) => {
  setFormManagementFns(formFns);
  if (!formFns?.setFieldValue) return;

  const savedRoster = loadRosterFromStorage();
  if (savedRoster && !String(formFns.getFieldValue?.("roster") ?? "").trim()) {
    formFns.setFieldValue("roster", savedRoster);
  }

  if (!String(formFns.getFieldValue?.("sessionDate") ?? "").trim()) {
    const today = new Date();
    const yyyy = today.getFullYear();
    const mm = String(today.getMonth() + 1).padStart(2, "0");
    const dd = String(today.getDate()).padStart(2, "0");
    formFns.setFieldValue("sessionDate", `${yyyy}-${mm}-${dd}`);
  }

  setFormValues(readValuesFromForm(formFns));
};

const handleFieldChange = (fieldKey, value) => {
  setFormValues((prev) => ({ ...prev, [fieldKey]: value }));
};

const computeAttendance = (values) => {
  const rosterMap = parseEntries(values?.roster);
  const presentMap = parseEntries(values?.present);

  const presentMatched = [];
  const newShisyas = [];
  const absent = [];

  for (const [key, entry] of presentMap.entries()) {
    if (rosterMap.has(key)) {
      presentMatched.push(rosterMap.get(key));
    } else {
      newShisyas.push(entry);
    }
  }

  for (const [key, entry] of rosterMap.entries()) {
    if (!presentMap.has(key)) {
      absent.push(entry);
    }
  }

  presentMatched.sort((a, b) => Number(a.key) - Number(b.key));
  newShisyas.sort((a, b) => Number(a.key) - Number(b.key));
  absent.sort((a, b) => Number(a.key) - Number(b.key));

  return {
    sessionDate: String(values?.sessionDate || "").trim(),
    rosterCount: rosterMap.size,
    presentCount: presentMap.size,
    presentMatchedCount: presentMatched.length,
    absentCount: absent.length,
    newCount: newShisyas.length,
    presentMatched,
    newShisyas,
    absent,
    rosterMap,
    presentMap
  };
};

const runCompare = () => {
  const values = readValuesFromForm(formManagementFns());
  setFormValues(values);

  if (!String(values.roster || "").trim()) {
    _.showWarningToast?.("Paste the Dharm Shisya roster first");
    setResult(null);
    return;
  }
  if (!String(values.present || "").trim()) {
    _.showWarningToast?.("Paste today's present list from Zoom");
    setResult(null);
    return;
  }

  const next = computeAttendance(values);
  setResult(next);
  _.showSuccessToast?.(
    `Absent: ${next.absentCount} · New: ${next.newCount} · Present: ${next.presentCount}`
  );
};

const saveRoster = () => {
  const values = readValuesFromForm(formManagementFns());
  const rosterMap = parseEntries(values.roster);
  const normalized = entriesToText(rosterMap);
  formManagementFns()?.setFieldValue?.("roster", normalized);
  setFormValues((prev) => ({ ...prev, roster: normalized }));

  if (saveRosterToStorage(normalized)) {
    _.showSuccessToast?.(`Roster saved (${rosterMap.size} Dharm Shisya)`);
  } else {
    _.showErrorToast?.("Could not save roster to this browser");
  }
};

const addNewToRoster = () => {
  const current = result();
  if (!current?.newShisyas?.length) {
    _.showWarningToast?.("No new Dharm Shisya to add");
    return;
  }

  const values = readValuesFromForm(formManagementFns());
  const rosterMap = parseEntries(values.roster);
  for (const entry of current.newShisyas) {
    rosterMap.set(entry.key, entry);
  }
  const normalized = entriesToText(rosterMap);
  formManagementFns()?.setFieldValue?.("roster", normalized);
  setFormValues((prev) => ({ ...prev, roster: normalized }));
  saveRosterToStorage(normalized);

  const refreshed = computeAttendance({
    ...values,
    roster: normalized
  });
  setResult(refreshed);
  _.showSuccessToast?.(`Added ${current.newShisyas.length} new Dharm Shisya to roster`);
};

const copyList = async (kind) => {
  const current = result();
  if (!current) {
    _.showWarningToast?.("Compare attendance first");
    return;
  }
  const list =
    kind === "new"
      ? current.newShisyas
      : kind === "present"
        ? current.presentMatched
        : current.absent;
  const text = list.map((e) => e.display).join("\n");
  if (!text) {
    _.showWarningToast?.("Nothing to copy");
    return;
  }
  try {
    await navigator.clipboard.writeText(text);
    _.showSuccessToast?.("Copied to clipboard");
  } catch (error) {
    console.error("Clipboard copy failed:", error);
    _.showErrorToast?.("Could not copy");
  }
};

const formatListText = (entries) => {
  if (!entries?.length) return "—";
  return entries.map((e) => e.display).join("\n");
};

const summaryLine = () => {
  const current = result();
  if (!current) return "Paste roster + today's Zoom present list, then compare.";
  const datePart = current.sessionDate ? ` · ${current.sessionDate}` : "";
  return `Roster ${current.rosterCount} · Present ${current.presentCount} · Absent ${current.absentCount} · New ${current.newCount}${datePart}`;
};

return {
  formManagementFns,
  registerFormManagementFns,
  handleFieldChange,
  formValues,
  result,
  yetiReady,
  ensureYetiStyles,
  runCompare,
  saveRoster,
  addNewToRoster,
  copyList,
  formatListText,
  summaryLine,
  parseEntries,
  computeAttendance
};'''
