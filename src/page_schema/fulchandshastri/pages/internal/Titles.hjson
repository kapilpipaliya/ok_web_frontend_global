{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns: return { enabled: () => true }
        url: /titles
        key: Titles
        updatedAt: 2026-08-07T03:50:00.000Z
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  max-width: 56rem;
  margin: 0 auto;
  padding: 1.5rem 1rem 3rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}`;'''
        displayOrder: 1
        fns:
          '''const YOUTUBE_DEFAULTS = {
  from: "1",
  to: "705",
  startDate: "2026-06-25",
  seriesName: "द्रव्यदृष्टि प्रकाश",
  episodeMarker: "#",
  episodePad: "3",
  speaker: "निहालचंद्रजी सोगानी",
  brand: "Fulchand",
  topicPlaceholder: "<TITLE>",
  topics: "",
  separator: " | ",
  dateFormat: "yyyy-MM-dd",
  titleTemplate: "{topic}{separator}{series} {episodeMarker} {episode}{separator}{speaker}{separator}{brand}{separator}{date}",
  episodeHeadingTemplate: "{series} {episodeMarker} {episode}",
  imageFilePattern: "DDP # {episode}.jpg"
};

const DAVINCI_DEFAULTS = {
  from: "1",
  to: "705",
  startDate: "2026-06-25",
  seriesName: "द्रव्यदृष्टि प्रकाश",
  episodeMarker: "#",
  episodePad: "3",
  speaker: "",
  brand: "DDP",
  topicPlaceholder: "",
  topics: "",
  separator: "-",
  dateFormat: "yyyy-MM-dd",
  titleTemplate: "DDP{episodeMarker}{episode}-{date}",
  episodeHeadingTemplate: "DDP{episodeMarker}{episode}-{date}",
  imageFilePattern: "DDP # {episode}.jpg"
};

const [youtubeConfig, setYoutubeConfig] = _.createSignal({ ...YOUTUBE_DEFAULTS });
const [davinciConfig, setDavinciConfig] = _.createSignal({ ...DAVINCI_DEFAULTS });
const [youtubeFormFns, setYoutubeFormFns] = _.createSignal(null);
const [davinciFormFns, setDavinciFormFns] = _.createSignal(null);

const activeMode = _.atom("youtube");
const selectedDate = _.atom(_.dateFns.format(_.dateFns.startOfToday(), "yyyy-MM-dd"));
const activeFormat = _.atom("today");
const copiedTitle = _.atom("");

const config = () => (activeMode() === "davinci" ? davinciConfig() : youtubeConfig());

const readConfigFromForm = (formFns, defaults) => {
  if (!formFns?.getFieldValue) return { ...defaults };
  const next = { ...defaults };
  for (const key of Object.keys(defaults)) {
    const value = formFns.getFieldValue(key);
    if (value !== undefined && value !== null && value !== "") {
      next[key] = value;
    }
  }
  return next;
};

const registerYoutubeFormFns = (formFns) => {
  setYoutubeFormFns(formFns);
  setYoutubeConfig(readConfigFromForm(formFns, YOUTUBE_DEFAULTS));
};

const registerDavinciFormFns = (formFns) => {
  setDavinciFormFns(formFns);
  setDavinciConfig(readConfigFromForm(formFns, DAVINCI_DEFAULTS));
};

const handleYoutubeFieldChange = (fieldKey, value) => {
  setYoutubeConfig((prev) => ({ ...prev, [fieldKey]: value }));
};

const handleDavinciFieldChange = (fieldKey, value) => {
  setDavinciConfig((prev) => ({ ...prev, [fieldKey]: value }));
};

function parseYmd(value) {
  if (!value) return null;
  if (value instanceof Date) {
    return _.dateFns.isValid(value) ? _.dateFns.startOfDay(value) : null;
  }
  const text = String(value).trim();
  if (!text) return null;
  const ymd = text.slice(0, 10);
  const parsed = _.dateFns.parse(ymd, "yyyy-MM-dd", _.dateFns.startOfToday());
  if (_.dateFns.isValid(parsed)) return _.dateFns.startOfDay(parsed);
  const asDate = new Date(text);
  return _.dateFns.isValid(asDate) ? _.dateFns.startOfDay(asDate) : null;
}

function parseTopicList(value) {
  return String(value ?? "")
    .split(/\n/)
    .map((line) => line.trim())
    .filter(Boolean);
}

function padEpisode(episode, padWidth) {
  const width = Number(padWidth);
  const size = Number.isFinite(width) && width > 0 ? width : 3;
  return String(episode).padStart(size, "0");
}

function applyTemplate(template, vars) {
  return String(template ?? "").replace(/\{(\w+)\}/g, (match, key) => {
    if (Object.prototype.hasOwnProperty.call(vars, key)) {
      return String(vars[key] ?? "");
    }
    return match;
  });
}

function buildTitleVars(cfg, episodeNumber, dateObj, topic) {
  const episode = padEpisode(episodeNumber, cfg.episodePad);
  const dateFormat = String(cfg.dateFormat || "yyyy-MM-dd").trim() || "yyyy-MM-dd";
  return {
    topic: topic || cfg.topicPlaceholder || "<TITLE>",
    series: cfg.seriesName || "",
    episodeMarker: cfg.episodeMarker || "#",
    episode,
    speaker: cfg.speaker || "",
    brand: cfg.brand || "",
    date: dateObj ? _.dateFns.format(dateObj, dateFormat) : "",
    separator: cfg.separator || " | "
  };
}

function generateTitles(cfg, fallbackTemplate) {
  const startNumber = Number(cfg.from);
  const count = Number(cfg.to);
  const date = parseYmd(cfg.startDate);
  if (!date || !Number.isFinite(startNumber) || !Number.isFinite(count) || count < 1) {
    return [];
  }

  const topics = parseTopicList(cfg.topics);
  const template = String(cfg.titleTemplate || "").trim() || fallbackTemplate;

  return Array.from({ length: count }, (v, i) => {
    const currentDate = _.dateFns.addDays(date, i);
    const episodeNumber = startNumber + i;
    const topic = topics[i] ?? cfg.topicPlaceholder ?? "<TITLE>";
    const vars = buildTitleVars(cfg, episodeNumber, currentDate, topic);
    return applyTemplate(template, vars).replace(/\s+/g, " ").trim();
  });
}

const titles = () => {
  const mode = activeMode();
  const cfg = config();
  const fallback =
    mode === "davinci"
      ? "DDP{episodeMarker}{episode}-{date}"
      : "{topic}{separator}{series} {episodeMarker} {episode}{separator}{speaker}{separator}{brand}{separator}{date}";
  return generateTitles(cfg, fallback);
};

const rangeStart = () => parseYmd(config().startDate);

const rangeEnd = () => {
  const start = rangeStart();
  if (!start) return null;
  const count = Number(config().to);
  if (!Number.isFinite(count) || count < 1) return start;
  return _.dateFns.addDays(start, count - 1);
};

const todayEpisode = () => {
  const start = rangeStart();
  const selected = parseYmd(selectedDate());
  if (!start || !selected) return null;
  const days = _.dateFns.differenceInCalendarDays(selected, start);
  if (Number.isNaN(days) || days < 0) return null;
  const from = Number(config().from);
  const count = Number(config().to);
  if (!Number.isFinite(from) || !Number.isFinite(count)) return null;
  const episode = from + days;
  const maxEpisode = from + count - 1;
  if (episode > maxEpisode) return null;
  return episode;
};

const todayEpisodePadded = () => {
  const episode = todayEpisode();
  if (episode == null) return "";
  return padEpisode(episode, config().episodePad);
};

const todayImageUrl = () => {
  const episode = todayEpisode();
  if (episode == null) return "";
  const cfg = config();
  const vars = buildTitleVars(cfg, episode, parseYmd(selectedDate()), "");
  const fileName = applyTemplate(cfg.imageFilePattern || "DDP # {episode}.jpg", vars);
  if (!fileName) return "";
  return `/api/file/download/${encodeURIComponent(fileName)}`;
};

const todayHeading = () => {
  const episode = todayEpisode();
  if (episode == null) return "";
  const cfg = config();
  const vars = buildTitleVars(cfg, episode, parseYmd(selectedDate()), "");
  const fallback =
    activeMode() === "davinci"
      ? "DDP{episodeMarker}{episode}-{date}"
      : "{series} {episodeMarker} {episode}";
  const template = String(cfg.episodeHeadingTemplate || "").trim() || fallback;
  return applyTemplate(template, vars).replace(/\s+/g, " ").trim();
};

const todayTitle = () => {
  const episode = todayEpisode();
  if (episode == null) return "";
  const from = Number(config().from);
  return titles()[episode - from] ?? "";
};

const canGoPrev = () => {
  const selected = parseYmd(selectedDate());
  const start = rangeStart();
  if (!selected || !start) return false;
  return _.dateFns.isAfter(selected, start);
};

const canGoNext = () => {
  const selected = parseYmd(selectedDate());
  const end = rangeEnd();
  if (!selected || !end) return false;
  return _.dateFns.isBefore(selected, end);
};

const goPrev = () => {
  const selected = parseYmd(selectedDate());
  const start = rangeStart();
  if (!selected || !start || !canGoPrev()) return;
  selectedDate(_.dateFns.format(_.dateFns.subDays(selected, 1), "yyyy-MM-dd"));
};

const goNext = () => {
  const selected = parseYmd(selectedDate());
  const end = rangeEnd();
  if (!selected || !end || !canGoNext()) return;
  selectedDate(_.dateFns.format(_.dateFns.addDays(selected, 1), "yyyy-MM-dd"));
};

const copyTitle = async (text) => {
  try {
    await navigator.clipboard.writeText(text);
    copiedTitle(text);
    _.showSuccessToast?.("Copied to clipboard");
    setTimeout(() => {
      if (copiedTitle() === text) copiedTitle("");
    }, 1500);
  } catch (error) {
    console.error("Clipboard copy failed:", error);
    _.showErrorToast?.("Could not copy to clipboard");
  }
};

const copyAllTitles = async () => {
  const text = titles().join("\n");
  if (!text) {
    _.showWarningToast?.("No titles to copy");
    return;
  }
  await copyTitle(text);
};

return {
  enabled: () => true,
  activeMode,
  youtubeConfig,
  davinciConfig,
  registerYoutubeFormFns,
  registerDavinciFormFns,
  handleYoutubeFieldChange,
  handleDavinciFieldChange,
  selectedDate,
  activeFormat,
  copiedTitle,
  titles,
  todayEpisode,
  todayEpisodePadded,
  todayImageUrl,
  todayHeading,
  todayTitle,
  canGoPrev,
  canGoNext,
  goPrev,
  goNext,
  copyTitle,
  copyAllTitles
};'''
        componentName: Html
        props:
          '''return {
  as: "div"
};'''
      }
    }
