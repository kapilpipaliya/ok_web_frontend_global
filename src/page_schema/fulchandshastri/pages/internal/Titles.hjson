        fns:
          '''const from = _.atom("1");
const to = _.atom("705");
const startDate = _.atom("2026-06-25");
const activeFormat = _.atom("list");
const copiedTitle = _.atom("");

function generateTitles(startNumber, startDateValue, count, titles) {
  if (!startDateValue) return [];
  const date = _.dateFns.parse(
    startDateValue,
    "yyyy-MM-dd",
    _.dateFns.startOfToday(),
  );

  return Array.from({ length: count }, (_, i) => {
    const currentDate = _.dateFns.addDays(date, i);
    const episode = String(startNumber + i).padStart(3, "0");
    const title = titles[i] ?? "<TITLE>";
    return `${title} | द्रव्यदृष्टि प्रकाश # ${episode} | निहालचंद्रजी सोगानी | Fulchand | ${_.dateFns.format(currentDate, "yyyy-MM-dd")}`;
  });
}

const titles = () =>
  generateTitles(Number(from()), startDate(), Number(to()), []);

const copyTitle = async (text) => {
  try {
    await navigator.clipboard.writeText(text);
    copiedTitle(text);
    _.showSuccessToast?.("Copied to clipboard");
    setTimeout(() => {
      if (copiedTitle() === text) copiedTitle("");
    }, 1500);
  } catch (error) {
    console.error("Clipboard copy failed:", error);
    _.showErrorToast?.("Could not copy to clipboard");
  }
};

return {
  enabled: () => true,
  from,
  to,
  startDate,
  activeFormat,
  copiedTitle,
  titles,
  copyTitle
};
'''
