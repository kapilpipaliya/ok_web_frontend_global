        css:
          '''const active = f.activeMode() === "bgVideos";
return `._id {
  padding: 0.625rem 1.125rem;
  border: 1px solid ${active ? t.var.color.primary : t.var.color.border};
  border-radius: 0.375rem;
  background: ${active ? t.var.color.primary : t.var.color.background};
