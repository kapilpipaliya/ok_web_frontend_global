    {
      id: "15"
      L: Attr
      P: {
        css:
          '''const over = f.isTitleOverLimit(c.title);
return `._id {
  flex: 1;
  min-width: 0;
  word-break: break-word;
  font-size: 0.875rem;
  color: ${over ? t.var.color.error : t.var.color.text};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const over = f.isTitleOverLimit(c.title);
const length = f.titleLengthFor(c.title);
return {
  as: "div",
  text: over ? `${c.title}  (${length})` : c.title
};'''
      }
    }
    {
      id: "16"
      L: Attr
      P: {
        css:
          '''const copied = f.copiedTitle() === c.title;
return `._id {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 2.25rem;
  height: 2.25rem;
  padding: 0;
  border: 1px solid ${copied ? t.var.color.success : t.var.color.border};
  border-radius: 0.375rem;
  background: ${copied ? t.var.color.success : t.var.color.background};
  color: ${copied ? t.var.color.success_text : t.var.color.text};
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;

  &:hover {
    border-color: ${copied ? t.var.color.success : t.var.color.primary};
    transform: translateY(-1px);
  }
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const text = c.title;
const copied = f.copiedTitle() === text;
return {
  as: "button",
  type: "button",
  title: copied ? "Copied!" : "Copy title",
  "aria-label": copied ? "Copied!" : "Copy title",
  onClick: () => f.copyTitle(text)
};'''
      }
    }
    {
      id: "17"
      L: Attr
      P: {
        css:
          '''const copied = f.copiedTitle() === c.title;
return `._id {
  animation: ${copied ? "title-copy-pop 0.35s ease" : "none"};
}

@keyframes title-copy-pop {
  0% { transform: scale(0.5) rotate(-20deg); opacity: 0; }
  60% { transform: scale(1.2) rotate(5deg); opacity: 1; }
  100% { transform: scale(1) rotate(0); opacity: 1; }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const copied = f.copiedTitle() === c.title;
return {
  as: "icon",
  icon: copied ? "ph:check-bold" : "ph:copy",
  width: 18,
  height: 18
};'''
      }
    }
    {
      id: "18"
      L: Attr
      P: {
        css:
          '''return `._id {
  width: 100%;
  padding: 0.75rem;
  border: 1px solid ${t.var.color.border};
  border-radius: 0.375rem;
  background: ${t.var.color.background};
  color: ${t.var.color.text};
  font-family: monospace;
  line-height: 1.5;
  resize: vertical;
}`;'''
        displayOrder: 5
        componentName: Html
        props:
          '''return {
  as: "textarea",
  value: f.titles().join("\n"),
  rows: 30,
  readOnly: true,
  hide: f.activeFormat() !== "text"
};'''
      }
    }
