{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns: return { enabled: () => true }
        url: /titles
        key: Titles
        updatedAt: 2026-08-09T11:05:00.000Z
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  max-width: 56rem;
  margin: 0 auto;
  padding: 1.5rem 1rem 3rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}`;'''
        displayOrder: 1
        fns:
          '''const CONFIG_STORAGE_KEY = "ddp-titles-config";
const NOTES_STORAGE_KEY = "ddp-titles-episode-notes";
const TAB_NOTES_STORAGE_KEY = "ddp-titles-tab-notes";
const YOUTUBE_TITLE_SOFT_LIMIT = 100;

const YOUTUBE_DEFAULTS = {
  from: "1",
  to: "705",
  startDate: "2026-06-25",
  seriesName: "द्रव्यदृष्टि प्रकाश",
  episodeMarker: "#",
  episodePad: "3",
  speaker: "निहालचंद्रजी सोगानी",
  brand: "Fulchand",
  topicPlaceholder: "<TITLE>",
  topics: "",
  separator: " | ",
  dateFormat: "yyyy-MM-dd",
  titleTemplate: "{topic}{separator}{series} {episodeMarker} {episode}{separator}{speaker}{separator}{brand}{separator}{date}",
  episodeHeadingTemplate: "{series} {episodeMarker} {episode}",
  imageFilePattern: "DDP # {episode}.jpg"
};

const BG_VIDEOS_DEFAULTS = {
  from: "1",
  to: "705",
  startDate: "2026-06-25",
  seriesName: "द्रव्यदृष्टि प्रकाश",
  episodeMarker: "#",
  episodePad: "3",
  speaker: "",
  brand: "DDP",
  topicPlaceholder: "",
  topics: "",
  separator: "-",
  dateFormat: "yyyy-MM-dd",
  titleTemplate: "DDP{episodeMarker}{episode}-{date}",
  episodeHeadingTemplate: "DDP{episodeMarker}{episode}-{date}",
  imageFilePattern: "DDP # {episode}.jpg"
};

const mergeConfig = (defaults, stored) => {
  if (!stored || typeof stored !== "object") return { ...defaults };
  const next = { ...defaults };
  for (const key of Object.keys(defaults)) {
    if (stored[key] !== undefined && stored[key] !== null) {
      next[key] = stored[key];
    }
  }
  return next;
};

const [youtubeConfig, setYoutubeConfig] = _.createSignal({ ...YOUTUBE_DEFAULTS });
const [bgVideosConfig, setBgVideosConfig] = _.createSignal({ ...BG_VIDEOS_DEFAULTS });
const [youtubeFormFns, setYoutubeFormFns] = _.createSignal(null);
const [bgVideosFormFns, setBgVideosFormFns] = _.createSignal(null);
const [episodeNotes, setEpisodeNotes] = _.createSignal({ youtube: {}, bgVideos: {} });
const [tabNotes, setTabNotes] = _.createSignal({ youtube: "", bgVideos: "" });

const activeMode = _.atom("youtube");
const selectedDate = _.atom(_.dateFns.format(_.dateFns.startOfToday(), "yyyy-MM-dd"));
const activeFormat = _.atom("today");
const copiedTitle = _.atom("");
const jumpEpisode = _.atom("");

const config = () => (activeMode() === "bgVideos" ? bgVideosConfig() : youtubeConfig());

const persistConfigs = (youtube, bgVideos) => {
  try {
    localStorage.setItem(
      CONFIG_STORAGE_KEY,
      JSON.stringify({ youtube, bgVideos })
    );
  } catch (error) {
    console.error("Failed to save title config:", error);
  }
};

const applyConfigToForm = (formFns, cfg) => {
  if (!formFns?.setFieldValue || !cfg) return;
  for (const key of Object.keys(cfg)) {
    formFns.setFieldValue(key, cfg[key]);
  }
};

const readStoredConfigs = () => {
  try {
    const raw = localStorage.getItem(CONFIG_STORAGE_KEY);
    if (!raw) return null;
    const parsed = JSON.parse(raw);
    return {
      youtube: mergeConfig(YOUTUBE_DEFAULTS, parsed?.youtube),
      bgVideos: mergeConfig(BG_VIDEOS_DEFAULTS, parsed?.bgVideos)
    };
  } catch (error) {
    console.error("Failed to load title config:", error);
    return null;
  }
};

const loadStoredState = () => {
  const stored = readStoredConfigs();
  if (stored) {
    setYoutubeConfig(stored.youtube);
    setBgVideosConfig(stored.bgVideos);
    applyConfigToForm(youtubeFormFns(), stored.youtube);
    applyConfigToForm(bgVideosFormFns(), stored.bgVideos);
  }

  try {
    const rawNotes = localStorage.getItem(NOTES_STORAGE_KEY);
    if (rawNotes) {
      const parsed = JSON.parse(rawNotes);
      setEpisodeNotes({
        youtube: parsed?.youtube && typeof parsed.youtube === "object" ? parsed.youtube : {},
        bgVideos: parsed?.bgVideos && typeof parsed.bgVideos === "object" ? parsed.bgVideos : {}
      });
    }
  } catch (error) {
    console.error("Failed to load episode notes:", error);
  }

  try {
    const rawTabNotes = localStorage.getItem(TAB_NOTES_STORAGE_KEY);
    if (rawTabNotes) {
      const parsed = JSON.parse(rawTabNotes);
      setTabNotes({
        youtube: parsed?.youtube != null ? String(parsed.youtube) : "",
        bgVideos: parsed?.bgVideos != null ? String(parsed.bgVideos) : ""
      });
    }
  } catch (error) {
    console.error("Failed to load tab notes:", error);
  }
};

const persistNotes = (nextNotes) => {
  try {
    localStorage.setItem(NOTES_STORAGE_KEY, JSON.stringify(nextNotes));
  } catch (error) {
    console.error("Failed to save episode notes:", error);
  }
};

const persistTabNotes = (nextNotes) => {
  try {
    localStorage.setItem(TAB_NOTES_STORAGE_KEY, JSON.stringify(nextNotes));
  } catch (error) {
    console.error("Failed to save tab notes:", error);
  }
};

const youtubeTabNote = () => String(tabNotes()?.youtube ?? "");
const bgVideosTabNote = () => String(tabNotes()?.bgVideos ?? "");

const handleYoutubeTabNoteInput = (event) => {
  const value = event.currentTarget?.value ?? "";
  setTabNotes((prev) => {
    const next = { youtube: value, bgVideos: String(prev?.bgVideos ?? "") };
    persistTabNotes(next);
    return next;
  });
};

const handleBgVideosTabNoteInput = (event) => {
  const value = event.currentTarget?.value ?? "";
  setTabNotes((prev) => {
    const next = { youtube: String(prev?.youtube ?? ""), bgVideos: value };
    persistTabNotes(next);
    return next;
  });
};

const noteKeyForEpisode = (episode) => String(episode);

const registerYoutubeFormFns = (formFns) => {
  setYoutubeFormFns(formFns);
  const stored = readStoredConfigs();
  const cfg = stored?.youtube || youtubeConfig();
  setYoutubeConfig(cfg);
  applyConfigToForm(formFns, cfg);
};

const registerBgVideosFormFns = (formFns) => {
  setBgVideosFormFns(formFns);
  const stored = readStoredConfigs();
  const cfg = stored?.bgVideos || bgVideosConfig();
  setBgVideosConfig(cfg);
  applyConfigToForm(formFns, cfg);
};

const handleYoutubeFieldChange = (fieldKey, value) => {
  setYoutubeConfig((prev) => {
    const next = { ...prev, [fieldKey]: value };
    persistConfigs(next, bgVideosConfig());
    return next;
  });
};

const handleBgVideosFieldChange = (fieldKey, value) => {
  setBgVideosConfig((prev) => {
    const next = { ...prev, [fieldKey]: value };
    persistConfigs(youtubeConfig(), next);
    return next;
  });
};

const resetYoutubeConfig = () => {
  const next = { ...YOUTUBE_DEFAULTS };
  setYoutubeConfig(next);
  applyConfigToForm(youtubeFormFns(), next);
  persistConfigs(next, bgVideosConfig());
  _.showSuccessToast?.("YouTube form reset to defaults");
};

const resetBgVideosConfig = () => {
  const next = { ...BG_VIDEOS_DEFAULTS };
  setBgVideosConfig(next);
  applyConfigToForm(bgVideosFormFns(), next);
  persistConfigs(youtubeConfig(), next);
  _.showSuccessToast?.("BG Videos form reset to defaults");
};

function parseYmd(value) {
  if (!value) return null;
  if (value instanceof Date) {
    return _.dateFns.isValid(value) ? _.dateFns.startOfDay(value) : null;
  }
  const text = String(value).trim();
  if (!text) return null;
  const ymd = text.slice(0, 10);
  const parsed = _.dateFns.parse(ymd, "yyyy-MM-dd", _.dateFns.startOfToday());
  if (_.dateFns.isValid(parsed)) return _.dateFns.startOfDay(parsed);
  const asDate = new Date(text);
  return _.dateFns.isValid(asDate) ? _.dateFns.startOfDay(asDate) : null;
}

function parseTopicList(value) {
  return String(value ?? "")
    .split(/\n/)
    .map((line) => line.trim())
    .filter(Boolean);
}

function padEpisode(episode, padWidth) {
  const width = Number(padWidth);
  const size = Number.isFinite(width) && width > 0 ? width : 3;
  return String(episode).padStart(size, "0");
}

function applyTemplate(template, vars) {
  return String(template ?? "").replace(/\{(\w+)\}/g, (match, key) => {
    if (Object.prototype.hasOwnProperty.call(vars, key)) {
      return String(vars[key] ?? "");
    }
    return match;
  });
}

function buildTitleVars(cfg, episodeNumber, dateObj, topic) {
  const episode = padEpisode(episodeNumber, cfg.episodePad);
  const dateFormat = String(cfg.dateFormat || "yyyy-MM-dd").trim() || "yyyy-MM-dd";
  return {
    topic: topic || cfg.topicPlaceholder || "<TITLE>",
    series: cfg.seriesName || "",
    episodeMarker: cfg.episodeMarker || "#",
    episode,
    speaker: cfg.speaker || "",
    brand: cfg.brand || "",
    date: dateObj ? _.dateFns.format(dateObj, dateFormat) : "",
    separator: cfg.separator || " | "
  };
}

function generateTitles(cfg, fallbackTemplate) {
  const startNumber = Number(cfg.from);
  const count = Number(cfg.to);
  const date = parseYmd(cfg.startDate);
  if (!date || !Number.isFinite(startNumber) || !Number.isFinite(count) || count < 1) {
    return [];
  }

  const topics = parseTopicList(cfg.topics);
  const template = String(cfg.titleTemplate || "").trim() || fallbackTemplate;

  return Array.from({ length: count }, (v, i) => {
    const currentDate = _.dateFns.addDays(date, i);
    const episodeNumber = startNumber + i;
    const topic = topics[i] ?? cfg.topicPlaceholder ?? "<TITLE>";
    const vars = buildTitleVars(cfg, episodeNumber, currentDate, topic);
    return applyTemplate(template, vars).replace(/\s+/g, " ").trim();
  });
}

const titles = () => {
  const mode = activeMode();
  const cfg = config();
  const fallback =
    mode === "bgVideos"
      ? "DDP{episodeMarker}{episode}-{date}"
      : "{topic}{separator}{series} {episodeMarker} {episode}{separator}{speaker}{separator}{brand}{separator}{date}";
  return generateTitles(cfg, fallback);
};

const rangeStart = () => parseYmd(config().startDate);

const rangeEnd = () => {
  const start = rangeStart();
  if (!start) return null;
  const count = Number(config().to);
  if (!Number.isFinite(count) || count < 1) return start;
  return _.dateFns.addDays(start, count - 1);
};

const todayEpisode = () => {
  const start = rangeStart();
  const selected = parseYmd(selectedDate());
  if (!start || !selected) return null;
  const days = _.dateFns.differenceInCalendarDays(selected, start);
  if (Number.isNaN(days) || days < 0) return null;
  const from = Number(config().from);
  const count = Number(config().to);
  if (!Number.isFinite(from) || !Number.isFinite(count)) return null;
  const episode = from + days;
  const maxEpisode = from + count - 1;
  if (episode > maxEpisode) return null;
  return episode;
};

const todayEpisodePadded = () => {
  const episode = todayEpisode();
  if (episode == null) return "";
  return padEpisode(episode, config().episodePad);
};

const todayImageUrl = () => {
  const episode = todayEpisode();
  if (episode == null) return "";
  const cfg = config();
  const vars = buildTitleVars(cfg, episode, parseYmd(selectedDate()), "");
  const fileName = applyTemplate(cfg.imageFilePattern || "DDP # {episode}.jpg", vars);
  if (!fileName) return "";
  return `/api/file/download/${encodeURIComponent(fileName)}`;
};

const todayHeading = () => {
  const episode = todayEpisode();
  if (episode == null) return "";
  const cfg = config();
  const vars = buildTitleVars(cfg, episode, parseYmd(selectedDate()), "");
  const fallback =
    activeMode() === "bgVideos"
      ? "DDP{episodeMarker}{episode}-{date}"
      : "{series} {episodeMarker} {episode}";
  const template = String(cfg.episodeHeadingTemplate || "").trim() || fallback;
  return applyTemplate(template, vars).replace(/\s+/g, " ").trim();
};

const todayTitle = () => {
  const episode = todayEpisode();
  if (episode == null) return "";
  const from = Number(config().from);
  return titles()[episode - from] ?? "";
};

const todayTitleLength = () => todayTitle().length;

const todayTitleOverLimit = () =>
  activeMode() === "youtube" && todayTitleLength() > YOUTUBE_TITLE_SOFT_LIMIT;

const todayTitleLengthLabel = () => {
  const length = todayTitleLength();
  if (!length) return "";
  if (activeMode() !== "youtube") return `${length} chars`;
  return todayTitleOverLimit()
    ? `${length} / ${YOUTUBE_TITLE_SOFT_LIMIT} chars — over YouTube soft limit`
    : `${length} / ${YOUTUBE_TITLE_SOFT_LIMIT} chars`;
};

const todayNote = () => {
  const episode = todayEpisode();
  if (episode == null) return "";
  const mode = activeMode();
  return String(episodeNotes()?.[mode]?.[noteKeyForEpisode(episode)] ?? "");
};

const handleTodayNoteInput = (event) => {
  const episode = todayEpisode();
  if (episode == null) return;
  const mode = activeMode();
  const key = noteKeyForEpisode(episode);
  const value = event.currentTarget?.value ?? "";
  setEpisodeNotes((prev) => {
    const next = {
      youtube: { ...(prev?.youtube || {}) },
      bgVideos: { ...(prev?.bgVideos || {}) }
    };
    if (value) {
      next[mode] = { ...next[mode], [key]: value };
    } else {
      const modeNotes = { ...next[mode] };
      delete modeNotes[key];
      next[mode] = modeNotes;
    }
    persistNotes(next);
    return next;
  });
};

const dateForEpisode = (episode) => {
  const start = rangeStart();
  const from = Number(config().from);
  const count = Number(config().to);
  if (!start || !Number.isFinite(from) || !Number.isFinite(count) || !Number.isFinite(episode)) {
    return null;
  }
  if (episode < from || episode > from + count - 1) return null;
  return _.dateFns.addDays(start, episode - from);
};

const jumpToEpisode = (raw) => {
  const episode = Number(String(raw ?? jumpEpisode()).trim());
  if (!Number.isFinite(episode)) {
    _.showWarningToast?.("Enter a valid episode number");
    return;
  }
  const date = dateForEpisode(episode);
  if (!date) {
    _.showWarningToast?.("Episode is outside the configured range");
    return;
  }
  selectedDate(_.dateFns.format(date, "yyyy-MM-dd"));
  jumpEpisode(String(episode));
  activeFormat("today");
};

const jumpToDate = (raw) => {
  const date = parseYmd(raw);
  if (!date) {
    _.showWarningToast?.("Enter a valid date");
    return;
  }
  const start = rangeStart();
  const end = rangeEnd();
  if (!start || !end || _.dateFns.isBefore(date, start) || _.dateFns.isAfter(date, end)) {
    _.showWarningToast?.("Date is outside the configured range");
    return;
  }
  selectedDate(_.dateFns.format(date, "yyyy-MM-dd"));
  const episode = todayEpisode();
  if (episode != null) jumpEpisode(String(episode));
  activeFormat("today");
};

const handleJumpDateChange = (event) => {
  const value = event.currentTarget?.value ?? "";
  if (!value) return;
  jumpToDate(value);
};

const handleJumpEpisodeInput = (event) => {
  jumpEpisode(event.currentTarget?.value ?? "");
};

const handleJumpEpisodeKeyDown = (event) => {
  if (event.key === "Enter") {
    event.preventDefault();
    jumpToEpisode(event.currentTarget?.value);
  }
};

const copyTodayTitle = async () => {
  const text = todayTitle();
  if (!text) {
    _.showWarningToast?.("No title for this date");
    return;
  }
  await copyTitle(text);
};

const buildExportRows = () => {
  const cfg = config();
  const start = rangeStart();
  const from = Number(cfg.from);
  const list = titles();
  const mode = activeMode();
  const notes = episodeNotes()?.[mode] || {};
  const dateFormat = String(cfg.dateFormat || "yyyy-MM-dd").trim() || "yyyy-MM-dd";
  return list.map((title, i) => {
    const episode = from + i;
    const dateObj = start ? _.dateFns.addDays(start, i) : null;
    return {
      episode: padEpisode(episode, cfg.episodePad),
      episodeNumber: episode,
      date: dateObj ? _.dateFns.format(dateObj, dateFormat) : "",
      title,
      note: String(notes[noteKeyForEpisode(episode)] ?? "")
    };
  });
};

const csvEscape = (value) => {
  const text = String(value ?? "");
  if (/[",\n\r]/.test(text)) {
    return `"${text.replace(/"/g, '""')}"`;
  }
  return text;
};

const downloadFile = (filename, content, mime) => {
  const blob = new Blob([content], { type: mime });
  const url = URL.createObjectURL(blob);
  const anchor = document.createElement("a");
  anchor.href = url;
  anchor.download = filename;
  document.body.appendChild(anchor);
  anchor.click();
  anchor.remove();
  URL.revokeObjectURL(url);
};

const modeFilePrefix = () => (activeMode() === "bgVideos" ? "ddp-bg-videos" : "ddp-youtube");

const downloadTitlesTxt = () => {
  const rows = buildExportRows();
  if (!rows.length) {
    _.showWarningToast?.("No titles to download");
    return;
  }
  const content = rows.map((row) => row.title).join("\n");
  downloadFile(`${modeFilePrefix()}-titles.txt`, content, "text/plain;charset=utf-8");
  _.showSuccessToast?.("Downloaded .txt");
};

const downloadTitlesCsv = () => {
  const rows = buildExportRows();
  if (!rows.length) {
    _.showWarningToast?.("No titles to download");
    return;
  }
  const header = ["episode", "date", "title", "note"];
  const lines = [
    header.join(","),
    ...rows.map((row) =>
      [row.episode, row.date, row.title, row.note].map(csvEscape).join(",")
    )
  ];
  downloadFile(
    `${modeFilePrefix()}-titles.csv`,
    lines.join("\n"),
    "text/csv;charset=utf-8"
  );
  _.showSuccessToast?.("Downloaded .csv");
};

const titleLengthFor = (title) => String(title ?? "").length;

const isTitleOverLimit = (title) =>
  activeMode() === "youtube" && titleLengthFor(title) > YOUTUBE_TITLE_SOFT_LIMIT;

const canGoPrev = () => {
  const selected = parseYmd(selectedDate());
  const start = rangeStart();
  if (!selected || !start) return false;
  return _.dateFns.isAfter(selected, start);
};

const canGoNext = () => {
  const selected = parseYmd(selectedDate());
  const end = rangeEnd();
  if (!selected || !end) return false;
  return _.dateFns.isBefore(selected, end);
};

const goPrev = () => {
  const selected = parseYmd(selectedDate());
  const start = rangeStart();
  if (!selected || !start || !canGoPrev()) return;
  selectedDate(_.dateFns.format(_.dateFns.subDays(selected, 1), "yyyy-MM-dd"));
  const episode = todayEpisode();
  if (episode != null) jumpEpisode(String(episode));
};

const goNext = () => {
  const selected = parseYmd(selectedDate());
  const end = rangeEnd();
  if (!selected || !end || !canGoNext()) return;
  selectedDate(_.dateFns.format(_.dateFns.addDays(selected, 1), "yyyy-MM-dd"));
  const episode = todayEpisode();
  if (episode != null) jumpEpisode(String(episode));
};

const copyTitle = async (text) => {
  try {
    await navigator.clipboard.writeText(text);
    copiedTitle(text);
    _.showSuccessToast?.("Copied to clipboard");
    setTimeout(() => {
      if (copiedTitle() === text) copiedTitle("");
    }, 1500);
  } catch (error) {
    console.error("Clipboard copy failed:", error);
    _.showErrorToast?.("Could not copy to clipboard");
  }
};

const copyAllTitles = async () => {
  const text = titles().join("\n");
  if (!text) {
    _.showWarningToast?.("No titles to copy");
    return;
  }
  await copyTitle(text);
};

return {
  enabled: () => true,
  activeMode,
  youtubeConfig,
  bgVideosConfig,
  registerYoutubeFormFns,
  registerBgVideosFormFns,
  handleYoutubeFieldChange,
  handleBgVideosFieldChange,
  resetYoutubeConfig,
  resetBgVideosConfig,
  loadStoredState,
  youtubeTabNote,
  bgVideosTabNote,
  handleYoutubeTabNoteInput,
  handleBgVideosTabNoteInput,
  todayNote,
  handleTodayNoteInput,
  selectedDate,
  activeFormat,
  copiedTitle,
  jumpEpisode,
  handleJumpEpisodeInput,
  handleJumpEpisodeKeyDown,
  jumpToEpisode,
  handleJumpDateChange,
  titles,
  todayEpisode,
  todayEpisodePadded,
  todayImageUrl,
  todayHeading,
  todayTitle,
  todayTitleLength,
  todayTitleOverLimit,
  todayTitleLengthLabel,
  titleLengthFor,
  isTitleOverLimit,
  youtubeTitleSoftLimit: YOUTUBE_TITLE_SOFT_LIMIT,
  canGoPrev,
  canGoNext,
  goPrev,
  goNext,
  copyTitle,
  copyTodayTitle,
  copyAllTitles,
  downloadTitlesTxt,
  downloadTitlesCsv
};'''
        componentName: Html
        props:
