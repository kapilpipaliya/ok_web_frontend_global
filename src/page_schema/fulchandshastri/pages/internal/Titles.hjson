            colSpan: 2,
            defaultValue: cfg.imageFilePattern,
            placeholder: "DDP # {episode}.jpg",
            tooltip: "Used for Today tab image URL via /api/file/download/..."
          }
        ]
      }
    ]
  }
};'''
