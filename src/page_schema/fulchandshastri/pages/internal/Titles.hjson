      L: Attr
      P: {
        css:
          '''const copied = f.copiedTitle() === c.title;
return `._id {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 2.25rem;
  height: 2.25rem;
  padding: 0;
  border: 1px solid ${copied ? t.var.color.success : t.var.color.border};
  border-radius: 0.375rem;
  background: ${copied ? t.var.color.success : t.var.color.background};
  color: ${copied ? t.var.color.success_text : t.var.color.text};
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;

  &:hover {
    border-color: ${copied ? t.var.color.success : t.var.color.primary};
    transform: translateY(-1px);
  }
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const text = c.title;
const copied = f.copiedTitle() === text;
return {
  as: "button",
  type: "button",
  title: copied ? "Copied!" : "Copy title",
  "aria-label": copied ? "Copied!" : "Copy title",
  onClick: () => f.copyTitle(text)
};'''
      }
    }
