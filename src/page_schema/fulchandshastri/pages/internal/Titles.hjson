            dataType: "text",
            renderer: "text",
            required: false,
            colSpan: 1,
            defaultValue: "<TITLE>",
            placeholder: "<TITLE>"
          },
          {
            key: "topics",
            label: "Topics (one per line)",
            dataType: "text",
            renderer: "textArea",
            required: false,
            colSpan: 2,
            defaultValue: "",
            placeholder: "Topic for episode 1\nTopic for episode 2",
            tooltip: "Optional. Line N maps to episode from+N-1. Missing lines use topic placeholder."
          }
        ]
      },
      {
        key: "format",
