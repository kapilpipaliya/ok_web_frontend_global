  color: ${active ? t.var.color.primary_text : t.var.color.text};
  font-weight: 600;
  cursor: pointer;
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const active = f.activeMode() === "davinci";
return {
  as: "button",
