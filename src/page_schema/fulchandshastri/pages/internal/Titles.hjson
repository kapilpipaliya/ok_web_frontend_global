        displayOrder: 1
        textType: markdown
        componentName: Html
        text:
          '''Configure YouTube title parts in the form. Output updates live.

Default format:

`<TITLE> | द्रव्यदृष्टि प्रकाश # 001 | निहालचंद्रजी सोगानी | Fulchand | 2026-06-25`

Placeholders: `{topic}`, `{series}`, `{episodeMarker}`, `{episode}`, `{speaker}`, `{brand}`, `{date}`, `{separator}`
'''
        props:
          '''return {
  as: "div"
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id {
  border: 1px solid ${t.var.color.border};
  border-radius: 0.5rem;
  background: ${t.var.color.background_light_50};
  overflow: hidden;
}`;'''
        displayOrder: 2
        componentName: FormManagement
        props:
          '''const cfg = f.youtubeConfig();
return {
  mode: "add",
  vertexLabel: "DdpYoutubeTitleConfig",
  hideActionsBar: true,
  onFnsReady: f.registerYoutubeFormFns,
  onFieldChange: f.handleYoutubeFieldChange,
  formConfig: {
    gridColumns: 2,
    groups: [
      {
        key: "range",
        title: "Episode range",
        gridColumns: 2,
        fields: [
          {
            key: "from",
            label: "From episode",
            dataType: "text",
            renderer: "text",
            required: true,
            colSpan: 1,
            defaultValue: cfg.from,
            placeholder: "1"
          },
          {
            key: "to",
            label: "Count",
            dataType: "text",
            renderer: "text",
            required: true,
            colSpan: 1,
            defaultValue: cfg.to,
            placeholder: "705",
            tooltip: "Number of titles to generate from the start episode"
          },
          {
            key: "startDate",
            label: "Start date",
            dataType: "date",
            renderer: "date",
            required: true,
            colSpan: 1,
            defaultValue: cfg.startDate
          },
          {
            key: "episodePad",
            label: "Episode pad",
            dataType: "text",
            renderer: "text",
            required: true,
            colSpan: 1,
            defaultValue: cfg.episodePad,
            placeholder: "3",
            tooltip: "Zero-pad width for episode numbers (e.g. 3 → 001)"
          }
        ]
      },
      {
        key: "parts",
        title: "Title parts",
        gridColumns: 2,
        fields: [
          {
            key: "seriesName",
            label: "Series name",
            dataType: "text",
            renderer: "text",
            required: false,
            colSpan: 2,
            defaultValue: cfg.seriesName,
            placeholder: "द्रव्यदृष्टि प्रकाश"
          },
          {
            key: "episodeMarker",
            label: "Episode marker",
            dataType: "text",
            renderer: "text",
            required: false,
            colSpan: 1,
            defaultValue: cfg.episodeMarker,
            placeholder: "#"
          },
          {
            key: "separator",
            label: "Separator",
            dataType: "text",
            renderer: "text",
            required: false,
            colSpan: 1,
            defaultValue: cfg.separator,
            placeholder: " | "
          },
          {
            key: "speaker",
            label: "Speaker",
            dataType: "text",
            renderer: "text",
            required: false,
            colSpan: 1,
            defaultValue: cfg.speaker
          },
          {
            key: "brand",
            label: "Brand",
            dataType: "text",
            renderer: "text",
            required: false,
            colSpan: 1,
            defaultValue: cfg.brand
          },
          {
            key: "dateFormat",
            label: "Date format",
            dataType: "text",
            renderer: "text",
            required: false,
            colSpan: 1,
            defaultValue: cfg.dateFormat,
            placeholder: "yyyy-MM-dd"
          },
          {
            key: "topicPlaceholder",
            label: "Topic placeholder",
            dataType: "text",
            renderer: "text",
            required: false,
            colSpan: 1,
            defaultValue: cfg.topicPlaceholder,
            placeholder: "<TITLE>"
          },
          {
            key: "topics",
            label: "Topics (one per line)",
            dataType: "text",
            renderer: "textArea",
            required: false,
            colSpan: 2,
            defaultValue: cfg.topics,
            placeholder: "Topic for episode 1\nTopic for episode 2",
            tooltip: "Optional. Line N maps to episode from+N-1. Missing lines use topic placeholder."
          }
        ]
      },
      {
        key: "format",
        title: "Templates",
        gridColumns: 2,
        fields: [
          {
            key: "titleTemplate",
            label: "Title template",
            dataType: "text",
            renderer: "textArea",
            required: true,
            colSpan: 2,
            defaultValue: cfg.titleTemplate,
            placeholder: "{topic}{separator}{series} {episodeMarker} {episode}{separator}{speaker}{separator}{brand}{separator}{date}",
            tooltip: "YouTube title. Placeholders: {topic} {series} {episodeMarker} {episode} {speaker} {brand} {date} {separator}"
          },
          {
            key: "episodeHeadingTemplate",
            label: "Today heading template",
            dataType: "text",
            renderer: "text",
            required: false,
            colSpan: 2,
            defaultValue: cfg.episodeHeadingTemplate,
            placeholder: "{series} {episodeMarker} {episode}"
          },
          {
