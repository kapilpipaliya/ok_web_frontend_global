  color: ${over ? t.var.color.error : t.var.color.text};
  opacity: ${over ? 1 : 0.75};
  word-break: break-word;
  width: 100%;
}`;'''
        displayOrder: 3
        componentName: Html
        props:
          '''return {
  as: "div",
