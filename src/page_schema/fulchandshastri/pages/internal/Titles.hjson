          },
          {
            key: "episodeMarker",
            label: "Episode marker",
            dataType: "text",
            renderer: "text",
            required: false,
            colSpan: 1,
            defaultValue: "#",
            placeholder: "#"
          },
          {
            key: "separator",
            label: "Separator",
            dataType: "text",
