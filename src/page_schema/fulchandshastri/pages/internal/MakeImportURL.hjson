{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns: return { enabled: () => true }
        key: MakeImportURL
        url: /make-import-url
        props:
          '''return {
  isNoPermissionCheck: true,
};
'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        fns:
          '''
const [generatedImportUrl, setGeneratedImportUrl] = args.createSignal("");
const [generatedExportUrl, setGeneratedExportUrl] = args.createSignal("");
const [formManagementFns, setFormManagementFns] = args.createSignal(null);
const [previewModalOpen, setPreviewModalOpen] = args.createSignal(false);
const [previewUrl, setPreviewUrl] = args.createSignal("");
const [previewTitle, setPreviewTitle] = args.createSignal("");

const parseKeyList = (value) => {
  return String(value ?? "")
    .split(/[,\n]+/)
    .map((part) => part.trim())
    .filter(Boolean);
};

const normalizeBaseUrl = (value) => {
  return String(value ?? "").trim().replace(/\/+$/, "");
};

const buildQueryString = (values) => {
  const params = new URLSearchParams();
  const components = parseKeyList(values?.components);
  const pages = parseKeyList(values?.pages);
  const functions = parseKeyList(values?.functions);
  const shop = String(values?.shop || "").trim();
  const jobId = String(values?.jobId || "").trim();

  if (components.length) params.set("components", components.join(","));
  if (pages.length) params.set("pages", pages.join(","));
  if (functions.length) params.set("functions", functions.join(","));
  if (shop) params.set("shop", shop);
  if (jobId) params.set("jobId", jobId);

  const query = params.toString();
  return query ? `?${query}` : "";
};

const buildUrls = (values) => {
  const baseUrl = normalizeBaseUrl(values?.baseUrl);
  const query = buildQueryString(values);
  return {
    importUrl: `${baseUrl}/admin/SchemaImport${query}`,
    exportUrl: `${baseUrl}/admin/SchemaExport${query}`
  };
};

const getUrlByKind = (kind) => {
  return kind === "export" ? generatedExportUrl() : generatedImportUrl();
};

const handleGenerate = async ({ vertex }) => {
  const values = vertex?.P || {};
  const baseUrl = normalizeBaseUrl(values?.baseUrl);
  if (!baseUrl) {
    args.showErrorToast?.("Base URL is required");
    return false;
  }

  const { importUrl, exportUrl } = buildUrls(values);
  setGeneratedImportUrl(importUrl);
  setGeneratedExportUrl(exportUrl);

  try {
    await navigator.clipboard.writeText(importUrl);
    args.showSuccessToast?.("URLs generated. Import URL copied to clipboard");
  } catch (error) {
    console.error("Clipboard copy failed:", error);
    args.showSuccessToast?.("URLs generated");
  }

  // Return false so FormManagement does not reinitialize / clear the form.
  return false;
};

const registerFormManagementFns = (formFns) => {
  setFormManagementFns(formFns);
  if (!formFns?.setFieldValue) return;
  const current = String(formFns.getFieldValue?.("baseUrl") ?? "").trim();
  if (current) return;
  formFns.setFieldValue("baseUrl", window.location.origin);
};

const runGenerate = () => {
  const formFns = formManagementFns();
  if (!formFns?.handleSave) {
    args.showErrorToast?.("Form is not ready yet");
    return;
  }
  formFns.handleSave();
};

const copyUrl = async (kind) => {
  const url = getUrlByKind(kind);
  if (!url) {
    args.showWarningToast?.("Generate URLs first");
    return;
  }
  try {
    await navigator.clipboard.writeText(url);
    args.showSuccessToast?.("Copied to clipboard");
  } catch (error) {
    console.error("Clipboard copy failed:", error);
    args.showErrorToast?.("Could not copy to clipboard");
  }
};

const openUrlInNewTab = (kind) => {
  const url = getUrlByKind(kind);
  if (!url) {
    args.showWarningToast?.("Generate URLs first");
    return;
  }
  window.open(url, "_blank", "noopener,noreferrer");
};

const openUrlInModal = (kind) => {
  const url = getUrlByKind(kind);
  if (!url) {
    args.showWarningToast?.("Generate URLs first");
    return;
  }
  setPreviewTitle(kind === "export" ? "Export URL preview" : "Import URL preview");
  setPreviewUrl(url);
  setPreviewModalOpen(true);
};

const closePreviewModal = () => {
  setPreviewModalOpen(false);
  setPreviewUrl("");
  setPreviewTitle("");
};

const copyImportUrl = () => copyUrl("import");
const copyExportUrl = () => copyUrl("export");
const openImportInNewTab = () => openUrlInNewTab("import");
const openExportInNewTab = () => openUrlInNewTab("export");
const openImportInModal = () => openUrlInModal("import");
const openExportInModal = () => openUrlInModal("export");

return {
  generatedImportUrl,
  generatedExportUrl,
  formManagementFns,
  registerFormManagementFns,
  handleGenerate,
  runGenerate,
  copyImportUrl,
  copyExportUrl,
  openImportInNewTab,
  openExportInNewTab,
  openImportInModal,
  openExportInModal,
  previewModalOpen,
  previewUrl,
  previewTitle,
  closePreviewModal,
  buildUrls
};
'''
