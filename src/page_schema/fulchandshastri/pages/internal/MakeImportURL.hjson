      P: {
        displayOrder: 2
        componentName: Html
        textType: markdown
        text:
          '''Fill the form to build Schema Import and Export URLs.

- Leave filters empty for a **full** import/export (components, pages, themes, functions, email templates).
- Fill any of `components` / `pages` / `functions` to filter those keys only.
- Keys can be comma-separated or one per line.
- `jobId` is optional (useful when sharing a running job poll URL).
- `shop` is optional and applies to import.
'''
        css:
          '''
return `._id {
  color: ${args.theme.var.color.text_light_400};
  line-height: 1.5;
  font-size: 0.95rem;

  p {
    margin: 0 0 0.5rem;
  }

  ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  code {
    font-size: 0.875em;
  }
}`;
'''
        props:
          '''
return {
  as: "div"
};
'''
