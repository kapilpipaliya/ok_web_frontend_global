return {
  mode: "add",
  vertexLabel: "SchemaImportUrl",
  hideActionsBar: true,
  onSave: args.fns.handleGenerate,
  onFnsReady: args.fns.registerFormManagementFns,
  formConfig: {
    gridColumns: 2,
    groups: [
      {
        key: "urlParts",
        title: "URL parts",
        gridColumns: 2,
        fields: [
          {
            key: "baseUrl",
            label: "Base URL",
            dataType: "text",
            renderer: "text",
            required: true,
            colSpan: 2,
            placeholder: "https://example.com",
            tooltip: "Origin only, no trailing slash required"
          },
          {
            key: "components",
            label: "Components",
            dataType: "text",
            renderer: "textArea",
            required: false,
            colSpan: 2,
            placeholder: "ComponentA, ComponentB",
            tooltip: "Comma or newline separated component keys. Leave empty to skip filter."
          },
          {
            key: "pages",
            label: "Pages",
            dataType: "text",
            renderer: "textArea",
            required: false,
            colSpan: 2,
            placeholder: "PageA, PageB",
            tooltip: "Comma or newline separated page keys. Leave empty to skip filter."
          },
          {
            key: "functions",
            label: "Functions",
            dataType: "text",
            renderer: "textArea",
            required: false,
            colSpan: 2,
            placeholder: "functionA, functionB",
            tooltip: "Comma or newline separated function keys. Leave empty to skip filter."
          },
          {
            key: "shop",
            label: "Shop (import only)",
            dataType: "text",
            renderer: "text",
            required: false,
            colSpan: 1,
            placeholder: "optional shop id",
            tooltip: "Optional. Passed as shop= on the import URL."
          },
          {
            key: "jobId",
            label: "Job ID (optional)",
            dataType: "text",
            renderer: "text",
            required: false,
            colSpan: 1,
            placeholder: "run-schema-job-...",
            tooltip: "Optional. Include when sharing an already-running job poll URL."
          }
        ]
      }
    ]
  }
};
