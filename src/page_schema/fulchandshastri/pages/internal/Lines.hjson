{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns: return { enabled: () => true }
        url: /lines
        key: Lines
        updatedAt: 2026-08-20T13:50:00.000Z
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  max-width: 56rem;
  margin: 0 auto;
  padding: 1.5rem 1rem 3rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}`;'''
        displayOrder: 1
        fns:
          '''const TEXT_STORAGE_KEY = "lines-checklist-text";
const DONE_STORAGE_KEY = "lines-checklist-done";

const [rawText, setRawText] = _.createSignal("");
const [doneMap, setDoneMap] = _.createSignal({});
const copiedLine = _.atom("");

const parseLines = (value) =>
  String(value ?? "")
    .split(/\n/)
    .filter((line) => line.trim().length > 0);

const lines = () =>
  parseLines(rawText()).map((text, index) => ({
    text,
    trimmed: text.trim(),
    index
  }));

const isWebLink = (value) => {
  const text = String(value ?? "").trim();
  return /^https?:\/\//i.test(text) || /^www\./i.test(text);
};

const toHref = (value) => {
  const text = String(value ?? "").trim();
  if (/^https?:\/\//i.test(text)) return text;
  if (/^www\./i.test(text)) return `https://${text}`;
  return text;
};

const persistText = (value) => {
  try {
    localStorage.setItem(TEXT_STORAGE_KEY, value);
  } catch (error) {
    console.error("Failed to save lines text:", error);
  }
};

const persistDone = (next) => {
  try {
    localStorage.setItem(DONE_STORAGE_KEY, JSON.stringify(next));
  } catch (error) {
    console.error("Failed to save done lines:", error);
  }
};

const loadStoredState = () => {
  try {
    const storedText = localStorage.getItem(TEXT_STORAGE_KEY);
    if (storedText != null) setRawText(storedText);
  } catch (error) {
    console.error("Failed to load lines text:", error);
  }

  try {
    const rawDone = localStorage.getItem(DONE_STORAGE_KEY);
    if (rawDone) {
      const parsed = JSON.parse(rawDone);
      if (parsed && typeof parsed === "object") setDoneMap(parsed);
    }
  } catch (error) {
    console.error("Failed to load done lines:", error);
  }
};

const handleTextInput = (event) => {
  const value = event.currentTarget?.value ?? "";
  setRawText(value);
  persistText(value);
};

const isDone = (line) => {
  const key = String(line?.trimmed ?? line?.text ?? "").trim();
  return !!doneMap()?.[key];
};

const markDone = (line) => {
  const key = String(line?.trimmed ?? line?.text ?? "").trim();
  if (!key) return;
  setDoneMap((prev) => {
    const next = { ...(prev || {}) };
    if (next[key]) {
      delete next[key];
    } else {
      next[key] = true;
    }
    persistDone(next);
    return next;
  });
};

const clearDone = () => {
  setDoneMap({});
  persistDone({});
  _.showSuccessToast?.("Cleared done marks");
};

const copyLine = async (line) => {
  const text = String(line?.text ?? "").trim();
  if (!text) {
    _.showWarningToast?.("Nothing to copy");
    return;
  }
  try {
    await navigator.clipboard.writeText(text);
    copiedLine(text);
    _.showSuccessToast?.("Copied to clipboard");
    setTimeout(() => {
      if (copiedLine() === text) copiedLine("");
    }, 1500);
  } catch (error) {
    console.error("Clipboard copy failed:", error);
    _.showErrorToast?.("Could not copy to clipboard");
  }
};

const openLink = (line) => {
  const href = toHref(line?.text);
  if (!href || !isWebLink(line?.text)) return;
  window.open(href, "_blank", "noopener,noreferrer");
};

const lineCount = () => lines().length;
const doneCount = () => lines().filter((line) => isDone(line)).length;

return {
  enabled: () => true,
  rawText,
  lines,
  handleTextInput,
  loadStoredState,
  isWebLink,
  isDone,
  markDone,
  clearDone,
  copyLine,
  openLink,
  copiedLine,
  lineCount,
  doneCount
};'''
        componentName: Html
        props:
          '''return {
  as: "div",
  onMount: () => {
    f.loadStoredState();
  }
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  margin: 0;
