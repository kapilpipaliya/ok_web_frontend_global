      L: Attr
      P: {
        css:
          '''const done = f.isDone(c.line);
return `._id {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 0.75rem;
  border: 1px solid ${done ? t.var.color.success : t.var.color.border};
  border-radius: 0.375rem;
  background: ${done ? t.var.color.success_light_900 : t.var.color.background};
  opacity: ${done ? 0.75 : 1};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div"
};'''
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        css:
          '''const done = f.isDone(c.line);
return `._id {
  flex: 1;
  min-width: 0;
  word-break: break-word;
  white-space: pre-wrap;
  font-size: 0.875rem;
  color: ${t.var.color.text};
  text-decoration: ${done ? "line-through" : "none"};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  text: c.line?.text ?? ""
};'''
      }
    }
    {
      id: "12"
      L: Attr
      P: {
        css:
          '''const copied = f.copiedLine() === String(c.line?.text ?? "").trim();
return `._id {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 2.25rem;
  height: 2.25rem;
  padding: 0;
  border: 1px solid ${copied ? t.var.color.success : t.var.color.border};
  border-radius: 0.375rem;
  background: ${copied ? t.var.color.success : t.var.color.background};
  color: ${copied ? t.var.color.success_text : t.var.color.text};
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;

  &:hover {
    border-color: ${copied ? t.var.color.success : t.var.color.primary};
    transform: translateY(-1px);
  }
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const text = String(c.line?.text ?? "").trim();
const copied = f.copiedLine() === text;
return {
  as: "button",
  type: "button",
  title: copied ? "Copied!" : "Copy line",
  "aria-label": copied ? "Copied!" : "Copy line",
  onClick: () => f.copyLine(c.line)
};'''
      }
    }
    {
      id: "13"
      L: Attr
      P: {
        css:
          '''const copied = f.copiedLine() === String(c.line?.text ?? "").trim();
return `._id {
  animation: ${copied ? "lines-copy-pop 0.35s ease" : "none"};
}

@keyframes lines-copy-pop {
  0% { transform: scale(0.5) rotate(-20deg); opacity: 0; }
  60% { transform: scale(1.2) rotate(5deg); opacity: 1; }
  100% { transform: scale(1) rotate(0); opacity: 1; }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const copied = f.copiedLine() === String(c.line?.text ?? "").trim();
return {
  as: "icon",
  icon: copied ? "ph:check-bold" : "ph:copy",
  width: 18,
  height: 18
};'''
      }
    }
