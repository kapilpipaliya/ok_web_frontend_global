    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        fns:
          '''
const [generatedCommand, setGeneratedCommand] = args.createSignal("");
const [formManagementFns, setFormManagementFns] = args.createSignal(null);

const quoteShellArg = (value) => {
  const text = String(value ?? "").trim();
  if (!text) return "''";
  if (/^[A-Za-z0-9._/-]+$/.test(text)) return text;
  return `'${text.replace(/'/g, `'\\''`)}'`;
};

const deriveOutputFileName = (inputFile) => {
  const text = String(inputFile ?? "").trim() || "input.mp4";
  const slash = Math.max(text.lastIndexOf("/"), text.lastIndexOf("\\"));
  const dir = slash >= 0 ? text.slice(0, slash + 1) : "";
  const base = slash >= 0 ? text.slice(slash + 1) : text;
  const lastDot = base.lastIndexOf(".");
  if (lastDot > 0) {
    return `${dir}${base.slice(0, lastDot)}_trimmed${base.slice(lastDot)}`;
  }
  return `${dir}${base}_trimmed`;
};

const buildFfmpegCommand = (values) => {
  const inputFile = String(values?.inputFile || "").trim() || "input.mp4";
  const startTime = String(values?.startTime || "").trim() || "00:00:00";
  const endMode = String(values?.endMode || "").trim();
  const outputFile = String(values?.outputFile || "").trim() || deriveOutputFileName(inputFile);
  const copyStreams = values?.copyStreams === true || values?.copyStreams === "true";

  const parts = ["ffmpeg", "-ss", startTime];

  if (endMode === "duration") {
    const duration = String(values?.duration || "").trim();
    if (duration) parts.push("-t", duration);
  } else if (endMode === "to") {
    const endTime = String(values?.endTime || "").trim();
    if (endTime) parts.push("-to", endTime);
  }

  parts.push("-i", quoteShellArg(inputFile));
  if (copyStreams) parts.push("-c", "copy");
  parts.push(quoteShellArg(outputFile));

  return parts.join(" ");
};

const handleGenerate = async ({ vertex }) => {
  const values = vertex?.P || {};
  const command = buildFfmpegCommand(values);
  setGeneratedCommand(command);

  try {
    await navigator.clipboard.writeText(command);
    args.showSuccessToast?.("Command generated and copied to clipboard");
  } catch (error) {
    console.error("Clipboard copy failed:", error);
    args.showSuccessToast?.("Command generated");
  }

  return true;
};

const registerFormManagementFns = (formFns) => {
  setFormManagementFns(formFns);
};

const handleFieldChange = (fieldKey, value) => {
  if (fieldKey !== "inputFile") return;
  const formFns = formManagementFns();
  if (!formFns?.setFieldValue) return;
  formFns.setFieldValue("outputFile", deriveOutputFileName(value));
};

const runGenerate = () => {
  const formFns = formManagementFns();
  if (!formFns?.handleSave) {
    args.showErrorToast?.("Form is not ready yet");
    return;
  }
  formFns.handleSave();
};

const copyGeneratedCommand = async () => {
  const command = generatedCommand();
  if (!command) {
    args.showWarningToast?.("Generate a command first");
    return;
  }
  try {
    await navigator.clipboard.writeText(command);
    args.showSuccessToast?.("Copied to clipboard");
  } catch (error) {
    console.error("Clipboard copy failed:", error);
    args.showErrorToast?.("Could not copy to clipboard");
  }
};

return {
  generatedCommand,
  setGeneratedCommand,
  formManagementFns,
  registerFormManagementFns,
  handleFieldChange,
  handleGenerate,
  runGenerate,
  copyGeneratedCommand,
  deriveOutputFileName,
  buildFfmpegCommand
};
'''
