return {
  as: "h1",
  text: content?.heroTitle
};
''',
        css: '''
return `._id {
  font-size: 3rem;
  font-weight: 800;
  margin-bottom: 1rem;
  position: relative;
  z-index: 1;
  text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
  
  @media (max-width: 768px) {
    font-size: 2rem;
  }
}`;
'''
      }
    },
