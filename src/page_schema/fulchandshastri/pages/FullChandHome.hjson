    {
      id: "welcomeTitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: "Welcome to Fulchand Shastri's Spiritual Haven"
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text};
  font-size: 2.5rem;
  font-weight: 700;
  margin-bottom: 1.5rem;
  line-height: 1.3;
  
  @media (max-width: 768px) {
    font-size: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "welcomeDesc",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "Fulchand is an enlightened master who has devoted his life to spreading the teachings of his spiritual guru, Shrimad Rajchandra, in more than 220 countries around the world. Though he is strongly rooted in the Jainism theory of Samyak Darshan (Enlightenment) and Moksha (Nirvana), he aims to share this divine knowledge with every soul in the world that is ready to acquire it."
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text_light_200};
  font-size: 1.125rem;
  line-height: 1.8;
  max-width: 800px;
  margin: 0 auto;
}`;
'''
      }
    },
    {
      id: "featuresGrid",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
  margin-bottom: 4rem;
}`;
'''
      }
    },
