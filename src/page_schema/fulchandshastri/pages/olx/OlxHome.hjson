return {
  as: "h2",
  text: () =>
    f.locLabel()
      ? `Fresh recommendations in ${f.locLabel()}`
      : "Fresh recommendations"
};
'''
        css:
          '''
return `._id {
  margin: 0;
  font-size: 1.25rem;
  font-weight: 700;
}`;
'''
      }
