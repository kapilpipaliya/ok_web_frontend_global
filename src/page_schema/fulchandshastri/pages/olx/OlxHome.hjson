  text: "Select your city (India) from the header to see local ads. Use current location or pick state & city.",
  show: () => f.needsLocation() === true
};
'''
        css:
          '''
return `._id {
  padding: 1rem;
  background: #fff8e1;
  border: 1px solid #ffce32;
  border-radius: 4px;
}`;
'''
      }
    }
    {
      id: "loading"
      L: Attr
      P: {
        displayOrder: 5
        componentName: Html
        props:
          '''
return {
