{
  vertexes: [
    {
      id: "page"
      L: Page
      P: {
        public: true
        key: OlxHome
        url: /olx
        title: OLX — Buy & Sell Near You
        isNoPermissionCheck: true
        fns: return { enabled: () => true }
        props:
          '''
return {
  isNoPermissionCheck: true
};
'''
      }
    }
    {
      id: "seo_title"
      L: Attr
      P: {
        displayOrder: 0.1
        componentName: Html
        props:
          '''
return {
  as: "title",
  text: "OLX — Buy & Sell Used Items Near You"
};
'''
      }
    }
    {
      id: "root"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        fns:
          '''
const CATEGORIES = [
  { key: "cars", label: "Cars", icon: "ui-icon-car" },
  { key: "properties", label: "Properties", icon: "ui-icon-home" },
  { key: "mobiles", label: "Mobiles", icon: "ui-icon-smartphone" },
  { key: "jobs", label: "Jobs", icon: "ui-icon-briefcase" },
  { key: "bikes", label: "Bikes", icon: "ui-icon-bike" },
  { key: "electronics", label: "Electronics", icon: "ui-icon-monitor" },
  { key: "furniture", label: "Furniture", icon: "ui-icon-package" },
  { key: "fashion", label: "Fashion", icon: "ui-icon-shopping-bag" },
  { key: "books", label: "Books & Sports", icon: "ui-icon-book" },
  { key: "pets", label: "Pets", icon: "ui-icon-paw-print" },
  { key: "services", label: "Services", icon: "ui-icon-wrench" }
];

const LOC_KEY = "olx_location_in";
const [listings, setListings] = _.createSignal([]);
const [loading, setLoading] = _.createSignal(true);
const [error, setError] = _.createSignal("");
const [needsLocation, setNeedsLocation] = _.createSignal(false);
const [locLabel, setLocLabel] = _.createSignal("");

const readLoc = () => {
  try {
    const raw = localStorage.getItem(LOC_KEY);
    if (!raw) return null;
    const parsed = JSON.parse(raw);
    if (parsed?.state && parsed?.city) return parsed;
  } catch (e) {}
  return null;
};

const loadListings = async () => {
  const loc = readLoc();
  setLocLabel(loc ? `${loc.city}, ${loc.state}` : "");
  if (!loc) {
    setNeedsLocation(true);
    setListings([]);
    setLoading(false);
    setError("");
    return;
  }
  setNeedsLocation(false);
  setLoading(true);
  setError("");
  try {
    const response = await s({
      functionName: "getOlxListings",
      contextData: { limit: 24, state: loc.state, city: loc.city }
    });
    const result = response?.result;
    if (result?.success) {
      if (response.graph) {
        _.setGraphData?.(0, response.graph, { replace: false });
      }
      setNeedsLocation(!!result.data?.needsLocation);
      setListings(result.data?.listings || []);
    } else {
      setError(result?.error || "Could not load ads");
      setListings([]);
    }
  } catch (e) {
    console.error(e);
    setError("Could not load ads");
    setListings([]);
  } finally {
    setLoading(false);
  }
};

const onLocChanged = () => f.loadListings();

return {
  CATEGORIES,
  listings,
  loading,
  error,
  needsLocation,
  locLabel,
  loadListings,
  onLocChanged
};
'''
        props:
          '''
return {
  as: "div",
  class: "olx-container",
  onMount: () => {
    f.loadListings();
    window.addEventListener("olx-location-changed", f.onLocChanged);
  },
  onCleanup: () => {
    window.removeEventListener("olx-location-changed", f.onLocChanged);
  }
};
'''
        css:
          '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: 1.75rem;
}`;
'''
      }
    }
    {
      id: "hero"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "section",
  class: "olx-hero"
};
'''
        css:
          '''
return `._id {
  background:
    linear-gradient(135deg, color-mix(in oklch, #002f34 88%, transparent), color-mix(in oklch, #002f34 70%, #23e5db)),
    url("https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=1600&q=60") center / cover;
  color: #ffffff;
  border-radius: 4px;
  padding: clamp(1.75rem, 4vw, 3rem);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  min-height: 12rem;
  justify-content: flex-end;
}`;
'''
      }
    }
    {
      id: "hero_brand"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
