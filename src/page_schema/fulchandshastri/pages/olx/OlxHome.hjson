};
'''
      }
    }
    {
      id: "empty"
      L: Attr
      P: {
        displayOrder: 7
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "ui-empty",
  text: () =>
    f.locLabel()
      ? `No ads in ${f.locLabel()} yet — be the first to sell something!`
      : "No ads yet — be the first to sell something!",
  show: () =>
    !f.loading() &&
    !f.error() &&
    !f.needsLocation() &&
    (f.listings()?.length || 0) === 0
};
'''
        css:
          '''
return `._id {
  padding: 2rem;
  text-align: center;
  background: #ffffff;
  border: 1px dashed #d8dee2;
  border-radius: 4px;
  color: #406367;
}`;
'''
      }
