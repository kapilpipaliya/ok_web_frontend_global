  text: "Start selling",
  onClick: () => _.navigate("/olx/sell")
};
'''
        css:
          '''
return `._id {
  align-self: flex-start;
  margin-top: 0.5rem;
  background: #ffce32 !important;
  color: #002f34 !important;
  border: none !important;
  font-weight: 800;
}`;
'''
      }
    }
    {
      id: "cat_heading"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
