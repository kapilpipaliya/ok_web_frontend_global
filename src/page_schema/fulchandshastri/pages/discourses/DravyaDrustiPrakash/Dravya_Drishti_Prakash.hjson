{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        isNoPermissionCheck: true
        fns:
          '''
const [selectedVideoIds, setSelectedVideoIds] = args.createSignal(new Set());

const getYouTubeId = (video) => {
  const rawValue = video?.P?.youtubeId || video?.P?.youtubeUrl || "";
  const value = String(rawValue).trim();
  if (/^[A-Za-z0-9_-]{11}$/.test(value)) return value;

  try {
    const parsedUrl = new URL(value);
    const host = parsedUrl.hostname.replace(/^www\./, "").toLowerCase();
    if (host === "youtu.be") {
      return parsedUrl.pathname.split("/").filter(Boolean)[0] || "";
    }
    if (host === "youtube.com" || host === "m.youtube.com") {
      const queryId = parsedUrl.searchParams.get("v");
      if (queryId) return queryId;
      const pathParts = parsedUrl.pathname.split("/").filter(Boolean);
      if (["embed", "shorts", "live"].includes(pathParts[0])) {
        return pathParts[1] || "";
      }
    }
  } catch (error) {
    return "";
  }

  return "";
};

const prepareVideo = (video) => {
  const youtubeId = getYouTubeId(video);
  if (!youtubeId) return null;
  return {
    ...video,
    P: {
      ...(video?.P || {}),
      youtubeId,
      title: video?.P?.subject || "Dravya Drishti Prakash",
      thumbnail: video?.P?.thumbnail || `https://img.youtube.com/vi/${youtubeId}/mqdefault.jpg`
    }
  };
};

const isVideoSelected = (video) =>
  video?.id != null && selectedVideoIds().has(String(video.id));

const setVideoSelected = (video, selected) => {
  if (video?.id == null) return;
  const videoId = String(video.id);
  setSelectedVideoIds((current) => {
    const next = new Set(current);
    if (selected) next.add(videoId);
    else next.delete(videoId);
    return next;
  });
};

const areAllVideosSelected = (videos) => {
  const list = Array.isArray(videos) ? videos : [];
  return list.length > 0 && list.every((video) => isVideoSelected(video));
};

const setAllVideosSelected = (videos, selected) => {
  const list = Array.isArray(videos) ? videos : [];
  setSelectedVideoIds((current) => {
    const next = new Set(current);
    for (const video of list) {
      if (video?.id == null) continue;
      const videoId = String(video.id);
      if (selected) next.add(videoId);
      else next.delete(videoId);
    }
    return next;
  });
};

const playVideos = async (videos) => {
  const playlist = (Array.isArray(videos) ? videos : [])
    .map(prepareVideo)
    .filter(Boolean);
  if (playlist.length === 0) {
    args.showWarningToast("Select at least one video with a valid YouTube link.");
    return;
  }
  args.fns.setVideoQueue?.(playlist.slice(1));
  await args.fns.openPlayer?.(playlist[0]);
};

const playSingleVideo = async (video) => {
  args.fns.setVideoQueue?.([]);
  await playVideos([video]);
};

const playSelectedVideos = async (videos) => {
  const selected = (Array.isArray(videos) ? videos : []).filter(isVideoSelected);
  await playVideos(selected);
};

const formatDate = (value) => {
  if (value == null || value === "") return "";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return String(value);
  return date.toLocaleDateString();
};

return {
  selectedVideoIds,
  getYouTubeId,
  isVideoSelected,
  setVideoSelected,
  areAllVideosSelected,
  setAllVideosSelected,
  playSingleVideo,
  playSelectedVideos,
  formatDate
};
'''
        url: /dravya-drishti-prakash
