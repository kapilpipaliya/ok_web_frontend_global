        props:
          '''
return {
  contextName: "dravyaDrishtiPrakashData",
  serverFunction: `
try {
  const tableResult = await args.executeNamedServerFunction({
    functionName: "loadPublicTableContent",
    contextData: {
      tableKey: "dravya_drishti_prakash_videos",
      tableVertexLabel: "DravyaDrishtiPrakashVideo"
    }
  });

  const tableData = tableResult?.result?.success ? (tableResult.result.data || {}) : {};
  const graph = tableData.graph || { vertexes: {}, edges: {} };
  const rowIds = Array.isArray(tableData.rowIds) ? tableData.rowIds : [];
  const videos = rowIds
    .map((rowId) => graph.vertexes?.[rowId])
    .filter(Boolean);

  return { videos };
} catch (error) {
  console.error("Error loading Dravya Drishti Prakash videos:", error);
  return { videos: [] };
}
`
};
