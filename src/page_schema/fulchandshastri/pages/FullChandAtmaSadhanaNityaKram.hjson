return {
  as: "section"
};
''',
        css: '''
return `._id {
  background: linear-gradient(135deg, #4a148c 0%, #7b1fa2 100%);
  color: white;
  padding: 4rem 1rem;
  text-align: center;
  position: relative;
  overflow: hidden;
  
  &::before {
    content: '🕉️';
    position: absolute;
    font-size: 300px;
    opacity: 0.05;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
}`;
'''
      }
    },
    {
