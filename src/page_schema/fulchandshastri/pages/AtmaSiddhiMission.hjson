{
  vertexes: [
    {
      id: "page",
      L: "Page",
      P: {
        public: true
        key: "AtmaSiddhiMission",
        fns: "return { enabled: () => true }",
        isNoPermissionCheck: true,
        url: "/atma-siddhi-shastra-mission"
        settingsPageId: "atma-siddhi-mission"
        props: '''
const locale = args.params?.lang ? String(args.params.lang).toLowerCase() : undefined;
return {
  contextName: "atmaSiddhiMissionSettings",
  serverFunction: `
try {
  const result = await args.executeNamedServerFunction({
    functionName: "loadPublicPageSettings",
    contextData: { pageId: "atma-siddhi-mission", allowPublicRead: true, locale: ${JSON.stringify(locale ?? null)} }
  });
  if (!result?.result?.success) return {};
  return result.result.data?.sections || {};
} catch (error) {
  console.error("Error loading page settings:", error);
  return {};
}
`
};
'''
      }
    },
    {
      id: "hero",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  background: linear-gradient(135deg, #2c5f2d 0%, #97bc62 100%);
  color: white;
  padding: 4rem 1rem;
  text-align: center;
  position: relative;
  overflow: hidden;
  
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.1) 0%, transparent 50%);
  }
}`;
'''
      }
    },
    {
      id: "heroTitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const content = args.contextData.atmaSiddhiMissionSettings?.content;
return {
  as: "h1",
  text: content?.heroTitle
};
''',
        css: '''
return `._id {
  font-size: 3rem;
  font-weight: 800;
  margin-bottom: 1rem;
  position: relative;
  z-index: 1;
  text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
  
  @media (max-width: 768px) {
    font-size: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "heroSubtitle",
