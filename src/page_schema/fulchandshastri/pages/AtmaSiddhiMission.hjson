};
''',
        css: '''
return `._id {
  font-size: 1.5rem;
  opacity: 0.9;
  position: relative;
  z-index: 1;
  
  @media (max-width: 768px) {
    font-size: 1.2rem;
  }
}`;
'''
      }
    },
