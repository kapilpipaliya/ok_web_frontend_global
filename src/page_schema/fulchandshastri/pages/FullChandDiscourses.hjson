    {
      id: "playButton",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const discourse = args.contextData.discourses;
const hasVideo = discourse.videoUrl ? true : false;
return {
  as: hasVideo ? "a" : "fragment",
  href: discourse.videoUrl || "#",
  target: "_blank",
  rel: "noopener noreferrer",
  title: "Watch Video"
};
''',
        css: '''
return `._id {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  background: ${args.theme.var.color.success_light_100};
  color: ${args.theme.var.color.success};
  border-radius: 50%;
  transition: all 0.2s ease;
  
  &:hover {
    background: ${args.theme.var.color.success};
    color: ${args.theme.var.color.success_text};
    transform: scale(1.1);
  }
}`;
'''
