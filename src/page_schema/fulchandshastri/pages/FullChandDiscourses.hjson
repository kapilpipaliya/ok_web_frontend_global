const isVideo = discourse.type === "Video";
return `._id {
  display: inline-block;
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 500;
  background: ${isVideo ? args.theme.var.color.success_light_100 : args.theme.var.color.primary_light_100};
  color: ${isVideo ? args.theme.var.color.success : args.theme.var.color.primary};
}`;
