};
''',
        css: '''
return `._id {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}`;
'''
      }
    },
    {
      id: "schemaEditor",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "TableSchemaEditorShell",
        props: '''
const tableKey = args.fns.getTableKey?.() || "books";
return {
  tableKey,
  embeddedMode: true,
  onSaved: () => args.fns.onSchemaSaved?.()
};
'''
      }
    },
    {
      id: "layout",
      L: "PageLayout",
      P: {
        displayOrder: 1,
        componentName: "FullChandPortalLayout"
      }
    }
  ],
  edges: [
    { id: "e1", T: "Attr", S: "page", E: "shell" },
    { id: "e2", T: "Attr", S: "shell", E: "header" },
    { id: "e3", T: "Attr", S: "header", E: "headerTitle" },
    { id: "e4", T: "Attr", S: "header", E: "modeTabs" },
    { id: "e5", T: "Attr", S: "modeTabs", E: "contentTab" },
    { id: "e6", T: "Attr", S: "modeTabs", E: "schemaTab" },
    { id: "e7", T: "Attr", S: "shell", E: "contentPane" },
    { id: "e8", T: "Attr", S: "contentPane", E: "dynamicPage" },
    { id: "e9", T: "Attr", S: "shell", E: "schemaPane" },
    { id: "e10", T: "Attr", S: "schemaPane", E: "schemaEditor" },
    { id: "e_layout", T: "PageLayout", S: "page", E: "layout" }
  ]
}
