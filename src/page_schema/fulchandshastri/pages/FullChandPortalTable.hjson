  onClick: () => args.fns.setEditorMode?.("schema")
};
'''
      }
    },
    {
      id: "contentPane",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: args.fns.isSchemaMode?.() === true
};
''',
        css: '''
return `._id {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}`;
'''
      }
    },
    {
      id: "dynamicPage",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "DynamicPage",
        props: '''
const tableKey = args.fns.getTableKey?.() || "books";
const tableVertexLabel = args.fns.getTableVertexLabel?.() || "Book";
return {
  tableKey,
  tableVertexLabel,
  loadFromSetting: true,
  usePolarisUI: true
};
'''
      }
    },
    {
      id: "schemaPane",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
