{
  vertexes: [
    {
      id: "page",
      L: "Page",
      P: {
        public: true
        key: "FullChandAboutASK",
        fns: "return { enabled: () => true }",
        isNoPermissionCheck: true,
        url: "/about-ask-umarala"
        contextName: "aboutAskSettings"
        serverFunction: '''
try {
  const result = await args.executeNamedServerFunction({
    functionName: "loadFulchandPublicPageSettings",
    contextData: { pageId: "about-ask", allowPublicRead: true }
  });
  if (!result?.result?.success) return {};
  return result.result.data?.sections || {};
} catch (error) {
  console.error("Error loading page settings:", error);
  return {};
}
'''
      }
    },
    {
      id: "hero",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  background: linear-gradient(135deg, #8b5a2b 0%, #cd853f 100%);
  color: white;
  padding: 4rem 1rem;
  text-align: center;
  position: relative;
  overflow: hidden;
  
  &::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: url('https://fulchandshastri.com/wp-content/uploads/2024/01/home-banner.png') center/cover;
    opacity: 0.1;
    transform: rotate(-5deg);
  }
}`;
'''
      }
    },
    {
      id: "heroTitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const content = args.contextData.aboutAskSettings?.content;
return {
  as: "h1",
  text: content?.heroTitle
};
''',
        css: '''
return `._id {
  font-size: 3rem;
  font-weight: 800;
  margin-bottom: 1rem;
  position: relative;
  z-index: 1;
  text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
  
  @media (max-width: 768px) {
    font-size: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "heroSubtitle",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const content = args.contextData.aboutAskSettings?.content;
return {
  as: "p",
  text: content?.heroSubtitle
};
''',
        css: '''
return `._id {
  font-size: 1.5rem;
  opacity: 0.9;
  position: relative;
  z-index: 1;
  
  @media (max-width: 768px) {
    font-size: 1.2rem;
  }
}`;
'''
      }
    },
    {
      id: "content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  max-width: 1200px;
  margin: 0 auto;
  padding: 4rem 1rem;
}`;
'''
      }
    },
    {
      id: "introSection",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
  margin-bottom: 4rem;
  
  @media (max-width: 768px) {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}`;
'''
      }
    },
