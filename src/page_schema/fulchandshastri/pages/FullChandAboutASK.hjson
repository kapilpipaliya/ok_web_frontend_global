    },
    {
      id: "introText",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "આત્મા સાધના કેન્દ્ર, ઉમરાળા એ અધ્યાત્મ સાધકો માટે એક પવિત્ર સ્થાન છે. અહીં શ્રી ફુલચંદ શાસ્ત્રીજીના માર્ગદર્શન હેઠળ અનેક સાધકો આત્મ-સાક્ષાત્કારની યાત્રામાં પ્રગતિ કરે છે. આ કેન્દ્ર શાંત વાતાવરણ અને આધ્યાત્મિક શક્તિથી ભરપૂર છે."
};
''',
        css: '''
return `._id {
  font-size: 1.1rem;
  line-height: 1.8;
  color: ${args.theme.mode === 'dark' ? args.theme.var.color.text_light_200 : args.theme.var.color.text_dark_200};
  margin-bottom: 1.5rem;
}`;
'''
      }
    },
