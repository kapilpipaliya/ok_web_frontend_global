{
  vertexes: [
    {
      id: "page",
      L: "Page",
      P: {
        key: "FullChandAboutASK",
        fns: "return { enabled: () => true }",
        isNoPermissionCheck: true,
        url: "/about-ask-umarala"
      }
    },
    {
      id: "rootAttr",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${args.theme.mode === 'dark' ? args.theme.var.color.background_dark_100 : args.theme.var.color.background_light_50};
  color: ${args.theme.mode === 'dark' ? args.theme.var.color.text_light_100 : args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "FullChandHeader"
      }
    },
    {
      id: "hero",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  background: linear-gradient(135deg, #8b5a2b 0%, #cd853f 100%);
  color: white;
  padding: 4rem 1rem;
  text-align: center;
  position: relative;
  overflow: hidden;
  
  &::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: url('https://fulchandshastri.com/wp-content/uploads/2024/01/home-banner.png') center/cover;
    opacity: 0.1;
    transform: rotate(-5deg);
  }
}`;
'''
      }
    },
    {
      id: "heroTitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: "Atma Sadhana Kendra, Umarala"
};
''',
        css: '''
return `._id {
  font-size: 3rem;
  font-weight: 800;
  margin-bottom: 1rem;
  position: relative;
  z-index: 1;
  text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
  
  @media (max-width: 768px) {
    font-size: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "heroSubtitle",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "અધ્યાત્મ સાધનાનું પવિત્ર સ્થાન"
};
''',
        css: '''
return `._id {
  font-size: 1.5rem;
  opacity: 0.9;
  position: relative;
  z-index: 1;
  
  @media (max-width: 768px) {
    font-size: 1.2rem;
  }
}`;
'''
      }
    },
    {
      id: "content",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
