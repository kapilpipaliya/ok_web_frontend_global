};
''',
        css: '''
return `._id {
  width: 100%;
  height: 400px;
  object-fit: cover;
  border-radius: 1rem;
  box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}`;
'''
      }
    },
    {
      id: "introContent",
