        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "જ્ઞાન દીપક ! પ્રજ્વલન એ એક અનોખો કાર્યક્રમ છે જે યુવાનોમાં આધ્યાત્મિક જાગૃતિ લાવવાનો પ્રયાસ કરે છે. આ કાર્યક્રમ દ્વારા અમે પરંપરાગત આધ્યાત્મિક જ્ઞાનને આધુનિક સંદર્ભમાં રજૂ કરીએ છીએ, જેથી નવી પેઢી સરળતાથી તેને સમજી શકે અને અપનાવી શકે."
};
''',
        css: '''
