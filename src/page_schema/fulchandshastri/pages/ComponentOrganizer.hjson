{
  vertexes: [
    {
      id: "page",
      L: "Page",
      P: {
        key: "ComponentOrganizer",
        url: "/portal/components",
        title: "Component Organizer",
        signinRequired: true,
        fns: '''
const checkAdminRole = () => {
  const userRoles = args.user?.OUT?.UserRole || [];
  return userRoles.some((edgeId) => {
    const edge = args.graph.edges[edgeId];
    const role = args.graph.vertexes[edge?.E];
    return role?.P?.key === "Admin";
  });
};

return {
  checkAdminRole
};
''',
        props: '''
return {
  isNoPermissionCheck: true,
  onMount: () => {
    if (!args.user) {
      args.navigate("/auth/signin", { replace: true });
      return;
    }
    if (!args.fns.checkAdminRole?.()) {
      args.showErrorToast?.("Admin access required");
      args.navigate("/", { replace: true });
    }
  }
};
'''
      }
    },
    {
      id: "shell",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "section",
  hide: !args.fns.checkAdminRole?.()
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  height: 100%;
  overflow: hidden;
}`;
'''
      }
    },
    {
      id: "header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return { as: "header" };
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.75rem 1rem;
  border-bottom: 1px solid ${args.theme.var.color.border_light_300};
  background: ${args.theme.var.color.background};
  flex-shrink: 0;
}`;
'''
      }
    },
    {
      id: "headerTitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: "Component Organizer"
};
''',
        css: '''
return `._id {
  margin: 0;
  font-size: 1.25rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "contentPane",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return { as: "div" };
''',
        css: '''
return `._id {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}`;
'''
      }
    },
    {
      id: "dynamicPage",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "DynamicPage",
        props: '''
return {
  tableKey: "components",
  tableVertexLabel: "Component",
  loadFromSetting: true,
  usePolarisUI: true
};
'''
      }
    },
    {
      id: "layout",
      L: "PageLayout",
      P: {
        displayOrder: 1,
        componentName: "PortalLayout"
      }
    }
  ],
  edges: [
    { id: "e1", T: "Attr", S: "page", E: "shell" },
    { id: "e2", T: "Attr", S: "shell", E: "header" },
    { id: "e3", T: "Attr", S: "header", E: "headerTitle" },
    { id: "e4", T: "Attr", S: "shell", E: "contentPane" },
    { id: "e5", T: "Attr", S: "contentPane", E: "dynamicPage" },
    { id: "e_layout", T: "PageLayout", S: "page", E: "layout" }
  ]
}
