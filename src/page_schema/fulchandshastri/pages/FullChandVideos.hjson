return {
  as: "img",
  src: video.thumbnail,
  alt: video.title
};
''',
        css: '''
return `._id {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}`;
'''
