        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  position: relative;
  padding-bottom: 56.25%;
  overflow: hidden;
  background: ${args.theme.var.color.background_light_200};
}`;
'''
      }
    },
    {
      id: "thumbnailImage",
