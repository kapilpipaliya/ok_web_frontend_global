  type: "button",
  text: selectedCount > 0
    ? `Add ${selectedCount} to playlist & play`
    : "Add selected to playlist & play",
  disabled: selectedCount === 0,
  onClick: () => args.fns.playSelectedVideos(videos)
};
'''
