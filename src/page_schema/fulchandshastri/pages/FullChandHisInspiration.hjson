    { id: "e21", T: "Attr", S: "kanjiContent", E: "kanjiImage" },
    { id: "e22", T: "Attr", S: "kanjiImage", E: "kanjiPhoto" },
    { id: "e23", T: "Attr", S: "rootAttr", E: "footer" }
  ]
