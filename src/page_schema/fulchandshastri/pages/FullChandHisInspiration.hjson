{
  vertexes: [
    {
      id: "page",
      L: "Page",
      P: {
        public: true
        key: "FullChandHisInspiration",
        fns: "return { enabled: () => true }",
        isNoPermissionCheck: true,
        url: "/his-inspiration"
        contextName: "hisInspirationSettings"
        serverFunction: '''
try {
  const result = await args.executeNamedServerFunction({
    functionName: "loadFulchandPublicPageSettings",
    contextData: { pageId: "his-inspiration", allowPublicRead: true }
  });
  if (!result?.result?.success) return {};
  return result.result.data?.sections || {};
} catch (error) {
  console.error("Error loading page settings:", error);
  return {};
}
'''
      }
    },
    {
      id: "pageHeader",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  background: linear-gradient(135deg, ${args.theme.var.color.primary_light_100} 0%, ${args.theme.var.color.primary_light_50} 100%);
  padding: 3rem 1rem;
  text-align: center;
}`;
'''
      }
    },
    {
      id: "pageTitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const content = args.contextData.hisInspirationSettings?.content;
return {
  as: "h1",
  text: content?.pageTitle
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text};
  font-size: 3rem;
  font-weight: 700;
  margin: 0;
  
  @media (max-width: 768px) {
    font-size: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "mainContent",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "main"
};
''',
        css: '''
return `._id {
  padding: 3rem 1rem;
}`;
'''
      }
    },
    {
      id: "container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1000px;
  margin: 0 auto;
}`;
'''
      }
    },
    {
      id: "shrimadSection",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  margin-bottom: 4rem;
}`;
'''
      }
    },
    {
      id: "shrimadTitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const content = args.contextData.hisInspirationSettings?.content;
return {
  as: "h2",
  text: content?.shrimadTitle
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.primary};
  font-size: 2.5rem;
  font-weight: 600;
  margin-bottom: 2rem;
  text-align: center;
}`;
'''
      }
    },
    {
      id: "shrimadContent",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 3rem;
  align-items: start;
  
  @media (max-width: 768px) {
    grid-template-columns: 1fr;
  }
}`;
'''
      }
    },
    {
      id: "shrimadImage",
      L: "Attr",
      P: {
        displayOrder: 1,
