{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        settingsPageId: photos
        isNoPermissionCheck: true
        fns: return { enabled: () => true }
        url: /gallery/:category?
        key: Gallery
        updatedAt: 2026-07-15T11:23:21.526Z
        props:
          '''
const locale = args.params?.lang ? String(args.params.lang).toLowerCase() : undefined;
const routeParams = args.context?.getParams?.(args.meta) || {};
const categoryKey = routeParams.category != null && String(routeParams.category).trim() !== ""
  ? String(routeParams.category).trim()
  : null;
return {
  contextName: "gallerySettings",
  serverFunction: `
try {
  const pageResult = await args.executeNamedServerFunction({
    functionName: "loadPublicPageSettings",
    contextData: { pageId: "photos", allowPublicRead: true, locale: ${JSON.stringify(locale ?? null)} }
  });
  const folderResult = await args.executeNamedServerFunction({
    functionName: "loadPublicGalleryFolder",
    contextData: {
      tableKey: "gallery",
      tableVertexLabel: "GalleryItem",
      categoryKey: ${JSON.stringify(categoryKey)},
      locale: ${JSON.stringify(locale ?? null)}
    }
  });

  const sections = pageResult?.result?.success ? (pageResult.result.data?.sections || {}) : {};
  const folderData = folderResult?.result?.success ? (folderResult.result.data || {}) : {};

  return {
    content: sections.content || {},
    folderData
  };
} catch (error) {
  console.error("Error loading gallery page:", error);
  return {
    content: {},
    folderData: { folders: [], items: [], breadcrumb: [] }
  };
}
`
};
'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  padding: 1rem;
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "main"
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  max-width: 1200px;
  margin: 0 auto;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div"
};'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 2
        componentName: GalleryBrowser
        props:
          '''const content = args.contextData.gallerySettings?.content || {};
const folderData = args.contextData.gallerySettings?.folderData || {};
const locale = args.params?.lang ? String(args.params.lang).toLowerCase() : undefined;
const langPrefix = locale && /^[a-z]{2,3}$/i.test(locale) ? `/${locale}` : "";
return {
  tableKey: "gallery",
  tableVertexLabel: "GalleryItem",
  locale,
  useUrlState: true,
  basePath: `${langPrefix}/gallery`,
  initialData: folderData,
  labels: {
    rootBreadcrumbLabel: content.rootBreadcrumbLabel || content.pageTitle || "Gallery",
    emptyFoldersText: content.emptyFoldersText || "No folders in this location.",
    emptyFilesText: content.emptyFilesText || "No files in this folder.",
    loadingText: "Loading…"
  }
};'''
      }
    }
    {
      id: "5"
      L: PageLayout
      P: {
        displayOrder: 1
        componentName: Layout
      }
    }
  ]
  edges: [
    {
      id: e1
      T: Attr
      S: "1"
      E: "2"
    }
    {
      id: e2
      T: PageLayout
      S: "1"
      E: "5"
    }
    {
      id: e3
      T: Attr
      S: "2"
      E: "3"
    }
    {
      id: e4
      T: Attr
      S: "3"
      E: "4"
    }
  ]
}