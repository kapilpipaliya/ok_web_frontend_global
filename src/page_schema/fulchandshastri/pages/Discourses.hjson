  background: ${args.theme.var.color.success_light_100};
  color: ${args.theme.var.color.success};
  border-radius: 50%;
  transition: all 0.2s ease;
  
  &:hover {
    background: ${args.theme.var.color.success};
    color: ${args.theme.var.color.success_text};
