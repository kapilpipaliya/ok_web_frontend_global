  border: 1px solid ${args.theme.var.color.background_light_300};
  border-radius: 0.375rem;
  cursor: pointer;
  transition: all 0.2s ease;
  
  &:hover {
    background: ${args.theme.var.color.background_light_100};
  }
  
  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
}`;
'''
      }
