{
  vertexes: [
    {
      id: "page",
      L: "Page",
      P: {
        public: true
        key: "Discourses",
        fns: "return { enabled: () => true }",
        isNoPermissionCheck: true,
        url: "/discourses"
        settingsPageId: "discourses"
        props: '''
const locale = args.params?.lang ? String(args.params.lang).toLowerCase() : undefined;
return {
  contextName: "discoursesSettings",
  serverFunction: `
try {
  const result = await args.executeNamedServerFunction({
    functionName: "loadPublicPageSettings",
    contextData: { pageId: "discourses", allowPublicRead: true, locale: ${JSON.stringify(locale ?? null)} }
  });
  if (!result?.result?.success) return {};
  return result.result.data?.sections || {};
} catch (error) {
  console.error("Error loading page settings:", error);
  return {};
}
`
};
'''
      }
    },
    {
      id: "pageHeader",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  background: linear-gradient(135deg, ${args.theme.var.color.primary_light_100} 0%, ${args.theme.var.color.primary_light_50} 100%);
  padding: 3rem 1rem;
  text-align: center;
}`;
'''
      }
    },
    {
      id: "pageTitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const content = args.contextData.discoursesSettings?.content;
return {
  as: "h1",
  text: content?.pageTitle
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text};
  font-size: 3rem;
  font-weight: 700;
  margin: 0;
  
  @media (max-width: 768px) {
    font-size: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "pageSubtitle",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const content = args.contextData.discoursesSettings?.content;
return {
  as: "p",
  text: content?.pageSubtitle
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text_light_200};
  font-size: 1.25rem;
  margin-top: 1rem;
}`;
'''
      }
    },
    {
      id: "mainContent",
