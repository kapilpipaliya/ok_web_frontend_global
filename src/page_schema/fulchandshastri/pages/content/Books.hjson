{
  vertexes: [
    {
      id: "page",
      L: "Page",
      P: {
        public: true
        key: "Books",
        fns: "return { enabled: () => true }",
        isNoPermissionCheck: true,
        url: "/books"
        settingsPageId: "books"
        props: '''
const locale = args.params?.lang ? String(args.params.lang).toLowerCase() : undefined;
return {
  contextName: "booksSettings",
  serverFunction: `
try {
  const pageResult = await args.executeNamedServerFunction({
    functionName: "loadPublicPageSettings",
    contextData: { pageId: "books", allowPublicRead: true, locale: ${JSON.stringify(locale ?? null)} }
  });
  const tableResult = await args.executeNamedServerFunction({
    functionName: "loadPublicTableContent",
    contextData: { tableKey: "books", tableVertexLabel: "Book", locale: ${JSON.stringify(locale ?? null)} }
  });
  const recommendedResult = await args.executeNamedServerFunction({
    functionName: "loadPublicTableContent",
    contextData: { tableKey: "recommended_books", tableVertexLabel: "RecommendedBook", locale: ${JSON.stringify(locale ?? null)} }
  });

  const sections = pageResult?.result?.success ? (pageResult.result.data?.sections || {}) : {};
  const tableData = tableResult?.result?.success ? (tableResult.result.data || {}) : {};
  const recommendedData = recommendedResult?.result?.success ? (recommendedResult.result.data || {}) : {};

  const mapBookRows = (data, coverRelationshipType, fileRelationshipType) => {
    const graph = data.graph || { vertexes: {}, edges: {} };
    const rowIds = Array.isArray(data.rowIds) ? data.rowIds : [];
    return rowIds.map((id, index) => {
      const book = graph.vertexes?.[id];
      const resolveFileUrl = (relationshipType) => {
        const edgeIds = book?.OUT?.[relationshipType] || [];
        if (!Array.isArray(edgeIds) || edgeIds.length === 0) return "";
        const edge = graph.edges?.[edgeIds[0]];
        const file = edge?.E != null ? graph.vertexes?.[edge.E] : null;
        const fileName = file?.P?.fileName != null ? String(file.P.fileName).trim() : "";
        if (!fileName) return "";
        return "/api/file/download/" + encodeURIComponent(fileName);
      };
      return {
        serial: index + 1,
        preview: resolveFileUrl(coverRelationshipType),
        name: book?.P?.title || "",
        description: book?.P?.description || "",
        year: book?.P?.year ?? "",
        language: book?.P?.language || "",
        downloadUrl: resolveFileUrl(fileRelationshipType)
      };
    });
  };

  return {
    content: sections.content || {},
    books: mapBookRows(tableData, "BookCoverFile", "BookFile"),
    recommendedBooks: mapBookRows(recommendedData, "RecommendedBookCoverFile", "RecommendedBookFile")
  };
} catch (error) {
  console.error("Error loading books page:", error);
  return { content: {}, books: [], recommendedBooks: [] };
}
`
};
'''
      }
    },
    {
      id: "pageHeader",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  background: linear-gradient(135deg, ${args.theme.var.color.primary_light_100} 0%, ${args.theme.var.color.primary_light_50} 100%);
  padding: 3rem 1rem;
  text-align: center;
}`;
'''
      }
    },
    {
      id: "pageTitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const content = args.contextData.booksSettings?.content;
return {
  as: "h1",
  text: content?.pageTitle || "Books"
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text};
  font-size: 3rem;
  font-weight: 700;
  margin: 0;

  @media (max-width: 768px) {
    font-size: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "pageSubtitle",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const content = args.contextData.booksSettings?.content;
return {
  as: "p",
  text: content?.pageSubtitle || ""
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text_light_200};
  font-size: 1.25rem;
  margin-top: 1rem;
}`;
'''
      }
    },
    {
      id: "mainContent",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        fns: '''
const [activeTab, setActiveTab] = args.createSignal("by");
return {
  activeTab,
  setActiveTab,
  isByTab: () => activeTab() === "by",
  isRecommendedTab: () => activeTab() === "recommended"
};
''',
        props: '''
return {
  as: "main"
};
''',
        css: '''
return `._id {
  padding: 3rem 1rem;
}`;
'''
      }
    },
    {
      id: "container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1200px;
  margin: 0 auto;
}`;
'''
      }
    },
    {
      id: "tabs",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  role: "tablist",
  "aria-label": "Books categories"
};
''',
        css: '''
return `._id {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}`;
'''
      }
    },
    {
      id: "tabBy",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const active = args.fns.isByTab?.() === true;
return {
  as: "button",
  type: "button",
  role: "tab",
  "aria-selected": active ? "true" : "false",
  text: "Books By Fulchand",
  class: active ? "books-tab books-tab-active" : "books-tab",
  onClick: () => args.fns.setActiveTab?.("by")
};
''',
        css: '''
const active = args.fns.isByTab?.() === true;
return `._id.books-tab {
  padding: 0.625rem 1.25rem;
  border: 1px solid ${active ? args.theme.var.color.primary : args.theme.var.color.border};
  border-radius: 0.5rem;
  background: ${active ? args.theme.var.color.primary : args.theme.var.color.background};
  color: ${active ? args.theme.var.color.primary_text : args.theme.var.color.text};
  font-size: 0.9375rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;

  &:hover {
    border-color: ${args.theme.var.color.primary};
    background: ${active ? args.theme.var.color.primary : args.theme.var.color.primary_light_50};
  }

  @media (max-width: 768px) {
    width: 100%;
    text-align: center;
  }
}`;
'''
      }
    },
    {
      id: "tabRecommended",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const active = args.fns.isRecommendedTab?.() === true;
return {
  as: "button",
  type: "button",
  role: "tab",
  "aria-selected": active ? "true" : "false",
  text: "Books Recommended by Fulchand",
  class: active ? "books-tab books-tab-active" : "books-tab",
  onClick: () => args.fns.setActiveTab?.("recommended")
};
''',
        css: '''
const active = args.fns.isRecommendedTab?.() === true;
return `._id.books-tab {
  padding: 0.625rem 1.25rem;
  border: 1px solid ${active ? args.theme.var.color.primary : args.theme.var.color.border};
  border-radius: 0.5rem;
  background: ${active ? args.theme.var.color.primary : args.theme.var.color.background};
  color: ${active ? args.theme.var.color.primary_text : args.theme.var.color.text};
  font-size: 0.9375rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;

  &:hover {
    border-color: ${args.theme.var.color.primary};
    background: ${active ? args.theme.var.color.primary : args.theme.var.color.primary_light_50};
  }

  @media (max-width: 768px) {
    width: 100%;
    text-align: center;
  }
}`;
'''
      }
    },
    {
      id: "booksTable",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "PublicContentTable",
        props: '''
const isRecommended = args.fns.isRecommendedTab?.() === true;
const books = isRecommended
  ? (args.contextData.booksSettings?.recommendedBooks ?? [])
  : (args.contextData.booksSettings?.books ?? []);
return {
  columns: [
    { key: "serial", label: "S.No.", width: "48px" },
    { key: "preview", label: "Preview", width: "120px", align: "center" },
    { key: "name", label: "Name" },
    { key: "description", label: "Description" },
    { key: "year", label: "Year", width: "64px" },
    { key: "language", label: "Language", width: "96px" },
    { key: "downloadUrl", label: "Download", align: "center", width: "96px" }
  ],
  rows: books,
  emptyMessage: isRecommended
    ? "No recommended books available yet."
    : "No books available yet."
};
'''
      }
    },
    {
      id: "bookRow",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "tr"
};
''',
        css: '''
return `._id {
  transition: background 0.2s ease;

  &:hover {
    background: ${args.theme.var.color.background_light_50};
  }
}`;
'''
      }
    },
    {
      id: "cellSerial",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const row = args.contextData.row || {};
return {
  as: "td",
  text: row.serial != null && row.serial !== "" ? String(row.serial) : "",
  style: { width: "48px" }
};
''',
        css: '''
return `._id {
  text-align: left;
  vertical-align: middle;
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "cellPreview",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "td",
  style: { width: "120px" }
};
''',
        css: '''
return `._id {
  text-align: center;
  vertical-align: middle;
}`;
'''
      }
    },
    {
      id: "cellPreviewImage",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const row = args.contextData.row || {};
const src = row.preview || "";
return {
  as: "img",
  src,
  alt: row.name || "Book cover",
  hide: () => !src
};
''',
        css: '''
return `._id {
  width: 40px;
  height: 56px;
  object-fit: cover;
  border-radius: 0.25rem;
  display: block;
  margin: 0 auto;

  @media (min-width: 768px) {
    width: 96px;
    height: 128px;
  }

  @media (min-width: 1024px) {
    width: 112px;
    height: 148px;
  }
}`;
'''
      }
    },
