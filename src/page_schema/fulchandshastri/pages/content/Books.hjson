    },
    {
      id: "layout",
      L: "PageLayout",
      P: {
        displayOrder: 1,
        componentName: "Layout"
      }
    }
  ],
  edges: [
    { id: "e0", T: "Attr", S: "page", E: "pageHeader" },
    { id: "e3", T: "Attr", S: "pageHeader", E: "pageTitle" },
    { id: "e4", T: "Attr", S: "pageHeader", E: "pageSubtitle" },
    { id: "e5", T: "Attr", S: "page", E: "mainContent" },
    { id: "e6", T: "Attr", S: "mainContent", E: "container" },
    { id: "e_tabs", T: "Attr", S: "container", E: "tabs" },
    { id: "e_tab_by", T: "Attr", S: "tabs", E: "tabBy" },
    { id: "e_tab_rec", T: "Attr", S: "tabs", E: "tabRecommended" },
    { id: "e7", T: "Attr", S: "container", E: "booksTable" },
    { id: "e_row", T: "Attr", S: "booksTable", E: "bookRow" },
    { id: "e_serial", T: "Attr", S: "bookRow", E: "cellSerial" },
    { id: "e_preview", T: "Attr", S: "bookRow", E: "cellPreview" },
    { id: "e_preview_img", T: "Attr", S: "cellPreview", E: "cellPreviewImage" },
    { id: "e_name", T: "Attr", S: "bookRow", E: "cellName" },
    { id: "e_desc", T: "Attr", S: "bookRow", E: "cellDescription" },
    { id: "e_year", T: "Attr", S: "bookRow", E: "cellYear" },
    { id: "e_lang", T: "Attr", S: "bookRow", E: "cellLanguage" },
    { id: "e_download", T: "Attr", S: "bookRow", E: "cellDownload" },
    { id: "e_download_link", T: "Attr", S: "cellDownload", E: "cellDownloadLink" },
    { id: "e_layout", T: "PageLayout", S: "page", E: "layout" }
  ]
}
