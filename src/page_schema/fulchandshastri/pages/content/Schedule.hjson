};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text};
  font-size: 2rem;
  font-weight: 600;
  margin-bottom: 2rem;
  text-align: center;
}`;
'''
      }
    },
    {
      id: "scheduleTable",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "PublicContentTable",
        props: '''
const section = args.contextData.scheduleSection;
return {
  columns: [
    { key: "startDate", label: "Start Date", width: "120px" },
    { key: "endDate", label: "End Date", width: "120px" },
    { key: "place", label: "Place" },
    { key: "programme", label: "Programme" },
    { key: "details", label: "Details" }
  ],
  rows: section?.rows ?? [],
  emptyMessage: "No events in this section."
};
'''
      }
    },
    {
      id: "eventRowGroup",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "fragment"
};
'''
      }
    },
    {
      id: "eventRow",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "tr"
};
''',
        css: '''
return `._id {
  transition: background 0.2s ease;

  &:hover {
    background: ${args.theme.var.color.background_light_50};
  }
}`;
'''
      }
    },
    {
      id: "cellStartDate",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const row = args.contextData.row || {};
return {
  as: "td",
  text: row.startDate || "",
  style: { width: "120px" }
};
''',
        css: '''
return `._id {
  text-align: left;
  vertical-align: middle;
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "cellEndDate",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const row = args.contextData.row || {};
return {
  as: "td",
