'''
      }
    },
    {
      id: "layout",
      L: "PageLayout",
      P: {
        displayOrder: 1,
        componentName: "Layout"
      }
    }
  ],
  edges: [
    { id: "e0", T: "Attr", S: "page", E: "pageHeader" },
    { id: "e1", T: "Attr", S: "pageHeader", E: "pageTitle" },
    { id: "e2", T: "Attr", S: "pageHeader", E: "pageSubtitle" },
    { id: "e3", T: "Attr", S: "page", E: "mainContent" },
    { id: "e4", T: "Attr", S: "mainContent", E: "container" },
    { id: "e5", T: "Attr", S: "container", E: "yearSections" },
    { id: "e6", T: "Attr", S: "yearSections", E: "yearSection" },
    { id: "e7", T: "Attr", S: "yearSection", E: "yearTitle" },
    { id: "e8", T: "Attr", S: "yearSection", E: "scheduleTable" },
    { id: "e_row_group", T: "Attr", S: "scheduleTable", E: "eventRowGroup" },
    { id: "e_event_row", T: "Attr", S: "eventRowGroup", E: "eventRow" },
    { id: "e_start", T: "Attr", S: "eventRow", E: "cellStartDate" },
