    { id: "e_banner_cell", T: "Attr", S: "bannerRow", E: "bannerCell" },
    { id: "e_banner_img", T: "Attr", S: "bannerCell", E: "bannerImage" },
    { id: "e9", T: "Attr", S: "container", E: "emptyState" },
    { id: "e_layout", T: "PageLayout", S: "page", E: "layout" }
  ]
}
