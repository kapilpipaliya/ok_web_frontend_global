{
  vertexes: [
    {
      id: "page",
      L: "Page",
      P: {
        key: "FullChandAtmaSiddhiMission",
        fns: "return { enabled: () => true }",
        isNoPermissionCheck: true,
        url: "/atma-siddhi-shastra-mission"
      }
    },
    {
      id: "rootAttr",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${args.theme.mode === 'dark' ? args.theme.var.color.background_dark_100 : args.theme.var.color.background_light_50};
  color: ${args.theme.mode === 'dark' ? args.theme.var.color.text_light_100 : args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "FullChandHeader"
      }
    },
    {
      id: "hero",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  background: linear-gradient(135deg, #2c5f2d 0%, #97bc62 100%);
  color: white;
  padding: 4rem 1rem;
  text-align: center;
  position: relative;
  overflow: hidden;
  
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.1) 0%, transparent 50%);
  }
}`;
'''
      }
    },
    {
      id: "heroTitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: "Atma Siddhi Shastra Mission"
};
''',
        css: '''
return `._id {
  font-size: 3rem;
  font-weight: 800;
  margin-bottom: 1rem;
  position: relative;
  z-index: 1;
  text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
  
  @media (max-width: 768px) {
    font-size: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "heroSubtitle",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "આત્મસિદ્ધિ શાસ્ત્રનો પ્રચાર અને પ્રસાર"
};
''',
        css: '''
return `._id {
  font-size: 1.5rem;
  opacity: 0.9;
  position: relative;
  z-index: 1;
  
  @media (max-width: 768px) {
    font-size: 1.2rem;
  }
}`;
'''
      }
    },
    {
      id: "content",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
