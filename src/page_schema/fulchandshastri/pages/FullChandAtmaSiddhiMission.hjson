'''
      }
    },
    {
      id: "missionText",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "શ્રીમદ્ રાજચંદ્રજી દ્વારા રચિત આત્મસિદ્ધિ શાસ્ત્ર એ આધ્યાત્મિક સાધકો માટે અમૂલ્ય માર્ગદર્શક ગ્રંથ છે. આ મિશનનો મુખ્ય ઉદ્દેશ્ય આ પવિત્ર ગ્રંથના સંદેશને સમગ્ર વિશ્વમાં પહોંચાડવાનો છે. ફુલચંદ શાસ્ત્રીજીના માર્ગદર્શન હેઠળ, અમે આત્મસિદ્ધિના છ પદો દ્વારા મોક્ષના માર્ગને સરળ રીતે સમજાવવાનો પ્રયત્ન કરીએ છીએ."
};
''',
        css: '''
return `._id {
  font-size: 1.2rem;
  line-height: 1.8;
  max-width: 800px;
  margin: 0 auto;
  color: ${args.theme.mode === 'dark' ? args.theme.var.color.text_light_200 : args.theme.var.color.text_dark_200};
}`;
'''
      }
    },
