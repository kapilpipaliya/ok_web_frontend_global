        loop: true,
        props: '''
return {
  data: [
    {
      id: 1,
      number: "૧",
      title: "આત્મા છે",
      description: "આત્માનું અસ્તિત્વ નિર્વિવાદ છે. તે શાશ્વત, અવિનાશી અને ચૈતન્યસ્વરૂપ છે."
    },
    {
      id: 2,
      number: "૨",
      title: "તે નિત્ય છે",
      description: "આત્મા અનાદિ અને અનંત છે. તેનો ક્યારેય નાશ થતો નથી."
    },
    {
      id: 3,
      number: "૩",
      title: "તે કર્તા છે",
      description: "આત્મા પોતાના કર્મોનો કર્તા છે અને તેના ફળોનો ભોક્તા છે."
    },
    {
      id: 4,
      number: "૪",
      title: "તે ભોક્તા છે",
      description: "જીવ પોતાના કર્મોના ફળનો અનુભવ કરે છે."
