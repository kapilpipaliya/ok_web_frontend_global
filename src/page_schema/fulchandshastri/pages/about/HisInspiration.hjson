{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        settingsPageId: his-inspiration
        isNoPermissionCheck: true
        fns: return { enabled: () => true }
        url: /his-inspiration
        key: HisInspiration
        props:
          '''
const locale = args.params?.lang ? String(args.params.lang).toLowerCase() : undefined;
return {
  contextName: "hisInspirationSettings",
  serverFunction: `
try {
  const result = await args.executeNamedServerFunction({
    functionName: "loadPublicPageSettings",
    contextData: { pageId: "his-inspiration", allowPublicRead: true, locale: ${JSON.stringify(locale ?? null)} }
  });
  if (!result?.result?.success) return {};
  return result.result.data?.sections || {};
} catch (error) {
  console.error("Error loading page settings:", error);
  return {};
}
`
};
'''
      }
    }
    {
      id: "2"
      L: PageLayout
      P: {
        displayOrder: 1
        componentName: Layout
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''
return `._id {
  padding: 3rem 1rem;
}`;
'''
        displayOrder: 3
        componentName: Html
        props:
          '''
return {
  as: "main"
};
'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''
