{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        settingsPageId: about-ask
        isNoPermissionCheck: true
        fns: return { enabled: () => true }
        url: /about-ask-umarala
        key: AboutASK
        props:
          '''
const locale = args.params?.lang ? String(args.params.lang).toLowerCase() : undefined;
return {
  contextName: "aboutAskSettings",
  serverFunction: `
try {
  const result = await args.executeNamedServerFunction({
    functionName: "loadPublicPageSettings",
    contextData: { pageId: "about-ask", allowPublicRead: true, locale: ${JSON.stringify(locale ?? null)} }
  });
  if (!result?.result?.success) return {};
  return result.result.data?.sections || {};
} catch (error) {
  console.error("Error loading page settings:", error);
  return {};
}
`
};
'''
      }
    }
    {
      id: "2"
      L: PageLayout
      P: {
        displayOrder: 1
        componentName: Layout
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''
return `._id {
  background: linear-gradient(135deg, #8b5a2b 0%, #cd853f 100%);
  color: white;
  padding: 4rem 1rem;
  text-align: center;
  position: relative;
  overflow: hidden;

  &::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: url('https://fulchandshastri.com/wp-content/uploads/2024/01/home-banner.png') center/cover;
    opacity: 0.1;
    transform: rotate(-5deg);
  }
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "section"
};
'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''
return `._id {
  font-size: 3rem;
  font-weight: 800;
  margin-bottom: 1rem;
  position: relative;
  z-index: 1;
  text-shadow: 2px 2px 4px rgba(0,0,0,0.3);

  @media (max-width: 768px) {
    font-size: 2rem;
  }
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const content = args.contextData.aboutAskSettings?.content;
return {
  as: "h1",
  text: content?.heroTitle
};
'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''
return `._id {
  font-size: 1.5rem;
  opacity: 0.9;
  position: relative;
