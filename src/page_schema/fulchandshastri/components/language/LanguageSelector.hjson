{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        description: Site language switcher for /{lang}/... routes.
        fns:
          '''
const DEFAULT_LANGUAGES = [
  { code: "en", label: "English", shortLabel: "EN", isDefault: true },
  { code: "hi", label: "Hindi", shortLabel: "HI", isDefault: false },
  { code: "gu", label: "Gujarati", shortLabel: "GU", isDefault: false }
];

const isLangCode = (value) =>
  value != null && /^[a-z]{2,3}$/i.test(String(value).trim());

const getCurrentLang = () => {
  const lang = args.params?.lang;
  if (isLangCode(lang)) return String(lang).toLowerCase();
  return "en";
};

const getPagePathWithoutLang = () => {
  const parts = String(args.location?.pathname || "").split("/").filter(Boolean);
  if (parts.length > 0 && isLangCode(parts[0])) {
    return parts.length > 1 ? "/" + parts.slice(1).join("/") : "/";
  }
  return args.location?.pathname || "/";
};

const buildLangUrl = (langCode) => {
  const pagePath = getPagePathWithoutLang();
  if (pagePath === "/" || pagePath === "") return `/${langCode}`;
  const normalized = pagePath.startsWith("/") ? pagePath : `/${pagePath}`;
  return `/${langCode}${normalized}`;
};

const switchLanguage = (langCode) => {
  if (!isLangCode(langCode)) return;
  const next = String(langCode).toLowerCase();
  if (next === getCurrentLang()) return;
  args.navigate(buildLangUrl(next));
};

const getLanguages = () => DEFAULT_LANGUAGES;

const getLanguageIndices = () => {
  const languages = getLanguages();
  const indices = [];
  for (let i = 0; i < languages.length; i++) indices.push(i);
  return indices;
};

const getLanguageAt = (index) => getLanguages()[index] || null;

const isActiveLang = (code) => getCurrentLang() === String(code).toLowerCase();

return {
  getCurrentLang,
  getLanguages,
  getLanguageIndices,
  getLanguageAt,
  switchLanguage,
  isActiveLang
};
'''
        key: LanguageSelector
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''
return `._id.fls-shell {
  display: inline-flex;
  align-items: center;
  gap: 0.125rem;
  padding: 0.125rem;
  border-radius: 0.375rem;
  background: rgba(58, 35, 23, 0.08);
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "fls-shell",
  "aria-label": "Language"
};
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        contextName: flsLangIndex
        css:
          '''
return `._id.fls-tabs {
  display: inline-flex;
  align-items: center;
  gap: 0.125rem;
}`;
'''
        loop: true
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "fls-tabs",
  data: args.fns.getLanguageIndices?.()
};
'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''
const lang = args.fns.getLanguageAt?.(args.contextData.flsLangIndex);
const active = args.fns.isActiveLang?.(lang?.code);
return `._id.fls-btn {
  min-width: 2rem;
  padding: 0.2rem 0.45rem;
  border: none;
  border-radius: 0.25rem;
  background: ${active ? "#3a2317" : "transparent"};
  color: ${active ? "#f5e6d3" : "#3a2317"};
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;

  &:hover {
    background: ${active ? "#3a2317" : "rgba(58, 35, 23, 0.12)"};
  }
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const lang = args.fns.getLanguageAt?.(args.contextData.flsLangIndex);
const active = args.fns.isActiveLang?.(lang?.code);
return {
  as: "button",
  type: "button",
  text: lang?.shortLabel || lang?.code || "",
  title: lang?.label || lang?.code || "",
  class: active ? "fls-btn fls-btn-active" : "fls-btn",
  onClick: () => lang?.code && args.fns.switchLanguage?.(lang.code)
};
'''
      }
    }
  ]
  edges: [
    {
      id: e1
      T: Attr
      S: "1"
      E: "2"
    }
    {
      id: e2
      T: Attr
      S: "2"
      E: "3"
    }
    {
      id: e3
      T: Attr
      S: "3"
      E: "4"
    }
  ]
}