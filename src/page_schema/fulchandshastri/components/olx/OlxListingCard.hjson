{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: OlxListingCard
        description: Marketplace listing card using az-code-lab/ui card styles
        isNoPermissionCheck: true
        fns: return { enabled: () => true }
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const item = c.props || c.listing || {};
const p = item.P || item;
const id = item.id || p.id;
const href = id ? `/olx/item/${encodeURIComponent(id)}` : "/olx";
const price = Number(p.price);
const priceText = Number.isFinite(price)
  ? `₹ ${price.toLocaleString("en-IN")}`
  : "Price on request";
return {
  as: "a",
  href,
  class: "ui-card olx-listing-card",
  onClick: (e) => {
    e.preventDefault();
    if (id) _.navigate(`/olx/item/${encodeURIComponent(id)}`);
  },
  "data-price": priceText
};
'''
        css:
          '''
return `._id {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #ffffff;
  border: 1px solid #d8dee2;
  border-radius: 4px;
  color: #002f34;
  transition: box-shadow 0.2s ease, transform 0.2s ease;
  height: 100%;

  &:hover {
    box-shadow: 0 4px 14px color-mix(in oklch, #002f34 12%, transparent);
    transform: translateY(-2px);
  }
}`;
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const item = c.props || c.listing || {};
const p = item.P || item;
const title = p.title || "Untitled";
const src = String(p.imageUrl || "").trim();
return {
  as: "div",
  class: "olx-listing-thumb",
  style: src
    ? `background-image: url(${JSON.stringify(src)})`
    : undefined,
  "aria-label": title
};
'''
        css:
          '''
return `._id {
  aspect-ratio: 4 / 3;
  background: linear-gradient(145deg, #e8eef0, #c5d4d6);
  background-size: cover;
  background-position: center;
}`;
'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "olx-listing-body"
};
'''
        css:
          '''
return `._id {
  padding: 0.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  flex: 1;
}`;
'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const item = c.props || c.listing || {};
const p = item.P || item;
const price = Number(p.price);
const priceText = Number.isFinite(price)
  ? `₹ ${price.toLocaleString("en-IN")}`
  : "Price on request";
return {
  as: "div",
  class: "olx-listing-price",
  text: priceText
};
'''
        css:
          '''
return `._id {
  font-weight: 800;
  font-size: 1.125rem;
  color: #002f34;
}`;
'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
const item = c.props || c.listing || {};
const p = item.P || item;
return {
  as: "div",
  class: "olx-listing-title",
  text: p.title || "Untitled"
};
'''
        css:
          '''
return `._id {
  font-size: 0.9375rem;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}`;
'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        props:
          '''
const item = c.props || c.listing || {};
const p = item.P || item;
const loc =
  p.city && p.state
    ? `${p.city}, ${p.state}`
    : p.location || "India";
const cat = p.category || "";
return {
  as: "div",
  class: "olx-listing-meta",
  text: cat ? `${loc} · ${cat}` : loc
};
'''
        css:
          '''
return `._id {
  margin-top: auto;
  font-size: 0.75rem;
  color: #406367;
  text-transform: capitalize;
}`;
'''
      }
    }
  ]
  edges: [
    { id: "e1", T: "Attr", S: "1", E: "2" }
    { id: "e2", T: "Attr", S: "2", E: "3" }
    { id: "e3", T: "Attr", S: "2", E: "4" }
    { id: "e4", T: "Attr", S: "4", E: "5" }
    { id: "e5", T: "Attr", S: "4", E: "6" }
    { id: "e6", T: "Attr", S: "4", E: "7" }
  ]
}
