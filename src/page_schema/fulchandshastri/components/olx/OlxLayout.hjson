{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: OlxLayout
        description: OLX marketplace layout — loads az-code-lab/ui CSS, sticky header with search, Sell CTA, and footer
        isNoPermissionCheck: true
        fns: return { enabled: () => true }
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        fns:
          '''
const UI_CSS = "https://cdn.jsdelivr.net/gh/az-code-lab/ui@latest/src/ui.css";
const UI_ICONS = "https://cdn.jsdelivr.net/gh/az-code-lab/ui@latest/src/icons.css";
const UI_FONT = "https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700;800&display=swap";
const LOC_KEY = "olx_location_in";

const [searchQ, setSearchQ] = _.createSignal("");
const [menuOpen, setMenuOpen] = _.createSignal(false);
const [locOpen, setLocOpen] = _.createSignal(false);
const [locLoading, setLocLoading] = _.createSignal(false);
const [states, setStates] = _.createSignal([]);
const [citiesByState, setCitiesByState] = _.createSignal({});
const [draftState, setDraftState] = _.createSignal("");
const [draftCity, setDraftCity] = _.createSignal("");
const [selectedLoc, setSelectedLoc] = _.createSignal(null);

const ensureLink = (id, href) => {
  let link = document.getElementById(id);
  if (!link) {
    link = document.createElement("link");
    link.id = id;
    link.rel = "stylesheet";
    link.href = href;
    document.head.appendChild(link);
  } else if (link.getAttribute("href") !== href) {
    link.href = href;
  }
};

const loadUiCss = () => {
  ensureLink("olx-ui-font", UI_FONT);
  ensureLink("olx-ui-css", UI_CSS);
  ensureLink("olx-ui-icons", UI_ICONS);
  document.documentElement.style.setProperty("--ui-primary", "#002f34");
  document.documentElement.style.setProperty("--ui-secondary", "#406367");
  document.documentElement.style.setProperty("--ui-success", "#23e5db");
  document.documentElement.style.setProperty("--ui-warning", "#ffce32");
  document.documentElement.style.setProperty("--ui-danger", "#ff5636");
  document.documentElement.style.setProperty("--ui-bg", "#f2f4f5");
  document.documentElement.style.setProperty("--ui-text", "#002f34");
  document.documentElement.style.setProperty("--ui-border", "#d8dee2");
  document.documentElement.style.setProperty("--ui-radius", "4px");
  document.documentElement.style.setProperty(
    "--ui-font",
    '"Nunito Sans", system-ui, -apple-system, sans-serif'
  );
};

const readStoredLoc = () => {
  try {
    const raw = localStorage.getItem(LOC_KEY);
    if (!raw) return null;
    const parsed = JSON.parse(raw);
    if (parsed?.state && parsed?.city) return parsed;
  } catch (e) {}
  return null;
};

const persistLoc = (loc) => {
  try {
    if (loc?.state && loc?.city) {
      localStorage.setItem(LOC_KEY, JSON.stringify(loc));
    } else {
      localStorage.removeItem(LOC_KEY);
    }
  } catch (e) {}
  setSelectedLoc(loc);
  window.dispatchEvent(new CustomEvent("olx-location-changed", { detail: loc }));
};

const locationLabel = () => {
  const loc = selectedLoc();
  if (!loc?.state) return "Select location";
  return loc.city ? `${loc.city}, ${loc.state}` : loc.state;
};

const normalizeName = (value) =>
  String(value || "")
    .toLowerCase()
    .replace(/[^a-z]/g, "");

const matchState = (name) => {
  const list = states();
  const n = normalizeName(name);
  if (!n) return "";
  return (
    list.find((s) => normalizeName(s) === n) ||
    list.find((s) => normalizeName(s).includes(n) || n.includes(normalizeName(s))) ||
    ""
  );
};

const matchCity = (stateName, name) => {
  const cities = citiesByState()?.[stateName] || [];
  const n = normalizeName(name);
  if (!n) return "";
  return (
    cities.find((c) => normalizeName(c) === n) ||
    cities.find((c) => normalizeName(c).includes(n) || n.includes(normalizeName(c))) ||
    ""
  );
};

const loadLocationData = async () => {
  try {
    const response = await s({ functionName: "getOlxIndiaLocations", contextData: {} });
    const data = response?.result?.data;
    if (response?.result?.success && data) {
      setStates(data.states || []);
      setCitiesByState(data.citiesByState || {});
    }
  } catch (e) {
    console.error("loadLocationData", e);
  }
};

const openLocationPicker = () => {
  const current = selectedLoc();
  setDraftState(current?.state || "");
  setDraftCity(current?.city || "");
  setLocOpen(true);
};

const closeLocationPicker = () => setLocOpen(false);

const onDraftStateChange = (e) => {
  setDraftState(e.currentTarget.value);
  setDraftCity("");
};

const onDraftCityChange = (e) => {
  setDraftCity(e.currentTarget.value);
};

const cityOptions = () => {
  const st = draftState();
  return st ? citiesByState()?.[st] || [] : [];
};

const applyLocation = () => {
  const state = String(draftState() || "").trim();
  const city = String(draftCity() || "").trim();
  if (!state || !city) {
    _.showWarningToast?.("Select state and city");
    return;
  }
  persistLoc({
    country: "IN",
    state,
    city,
    label: `${city}, ${state}`
  });
  setLocOpen(false);
  _.showSuccessToast?.(`Showing ads in ${city}, ${state}`);
};

const useCurrentLocation = () => {
  if (!navigator.geolocation) {
    _.showErrorToast?.("Geolocation is not supported");
    return;
  }
  setLocLoading(true);
  navigator.geolocation.getCurrentPosition(
    async (pos) => {
      try {
        const { latitude, longitude } = pos.coords;
        const url =
          `https://nominatim.openstreetmap.org/reverse?format=json&lat=${latitude}` +
          `&lon=${longitude}&zoom=10&addressdetails=1`;
        const res = await fetch(url, {
          headers: { Accept: "application/json" }
        });
        const data = await res.json();
        const addr = data?.address || {};
        if (addr.country_code && String(addr.country_code).toLowerCase() !== "in") {
          _.showErrorToast?.("This app only supports locations in India");
          return;
        }
        const stateRaw =
          addr.state || addr.region || addr.state_district || addr.county || "";
        const cityRaw =
          addr.city ||
          addr.town ||
          addr.village ||
          addr.suburb ||
          addr.municipality ||
          addr.county ||
          "";
        let stateName = matchState(stateRaw);
        if (!stateName && states().length === 0) {
          await loadLocationData();
          stateName = matchState(stateRaw);
        }
        if (!stateName) {
          _.showWarningToast?.(
            `Could not match "${stateRaw || "your area"}" to an Indian state. Pick manually.`
          );
          openLocationPicker();
          return;
        }
        let cityName = matchCity(stateName, cityRaw);
        if (!cityName) {
          setDraftState(stateName);
          setDraftCity("");
          setLocOpen(true);
          _.showWarningToast?.(
            `Detected ${stateName}. Select your city to continue.`
          );
          return;
        }
        persistLoc({
          country: "IN",
          state: stateName,
          city: cityName,
          label: `${cityName}, ${stateName}`
        });
        setLocOpen(false);
        _.showSuccessToast?.(`Location set to ${cityName}, ${stateName}`);
      } catch (e) {
        console.error(e);
        _.showErrorToast?.("Could not detect location. Please select manually.");
        openLocationPicker();
      } finally {
        setLocLoading(false);
      }
    },
    (err) => {
      console.error(err);
      setLocLoading(false);
      _.showErrorToast?.("Location permission denied. Select city manually.");
      openLocationPicker();
    },
    { enableHighAccuracy: false, timeout: 12000 }
  );
};

const initLocation = async () => {
  await loadLocationData();
  const stored = readStoredLoc();
  if (stored) {
    setSelectedLoc(stored);
    setDraftState(stored.state || "");
    setDraftCity(stored.city || "");
  }
};

const isSignedIn = () => !!_.user?.P?.uuid;
const userLabel = () =>
  String(_.user?.P?.username || _.user?.P?.email || "Account").trim();

const goHome = () => _.navigate("/olx");
const goSell = () => {
  if (!isSignedIn()) {
    goSignIn("/olx/sell");
    return;
  }
  _.navigate("/olx/sell");
};
const goMyAds = () => {
  if (!isSignedIn()) {
    goSignIn("/olx/my-ads");
    return;
  }
  _.navigate("/olx/my-ads");
};
const goSeller = () => {
  if (!isSignedIn()) {
    goSignIn("/olx/seller");
    return;
  }
  _.navigate("/olx/seller");
};
const goChats = () => {
  if (!isSignedIn()) {
    goSignIn("/olx/chats");
    return;
  }
  _.navigate("/olx/chats");
};
const goSignIn = (returnTo) => {
  try {
    sessionStorage.setItem(
      "olx_return",
      typeof returnTo === "string" && returnTo ? returnTo : "/olx"
    );
  } catch (e) {}
  _.navigate("/auth/signin");
};
const goCategory = (key) => _.navigate(`/olx/category/${encodeURIComponent(key)}`);

const runSearch = (event) => {
  if (event) event.preventDefault();
  const q = String(searchQ() || "").trim();
  if (!q) {
    _.navigate("/olx/search");
    return;
  }
  _.navigate(`/olx/search?q=${encodeURIComponent(q)}`);
};

const categories = [
  { key: "cars", label: "Cars", icon: "ui-icon-car" },
  { key: "properties", label: "Properties", icon: "ui-icon-home" },
  { key: "mobiles", label: "Mobiles", icon: "ui-icon-smartphone" },
  { key: "jobs", label: "Jobs", icon: "ui-icon-briefcase" },
  { key: "bikes", label: "Bikes", icon: "ui-icon-bike" },
  { key: "electronics", label: "Electronics", icon: "ui-icon-monitor" },
  { key: "furniture", label: "Furniture", icon: "ui-icon-package" },
  { key: "fashion", label: "Fashion", icon: "ui-icon-shopping-bag" },
  { key: "books", label: "Books & Sports", icon: "ui-icon-book" },
  { key: "pets", label: "Pets", icon: "ui-icon-paw-print" },
  { key: "services", label: "Services", icon: "ui-icon-wrench" }
];

return {
  searchQ,
  setSearchQ,
  menuOpen,
  setMenuOpen,
  loadUiCss,
  goHome,
  goSell,
  goMyAds,
  goSeller,
  goChats,
  goSignIn,
  goCategory,
  runSearch,
  categories,
  isSignedIn,
  userLabel,
  locOpen,
  locLoading,
  selectedLoc,
  draftState,
  draftCity,
  states,
  cityOptions,
  locationLabel,
  openLocationPicker,
  closeLocationPicker,
  onDraftStateChange,
  onDraftCityChange,
  applyLocation,
  useCurrentLocation,
  initLocation,
  toggleMenu: () => setMenuOpen((v) => !v),
  closeMenu: () => setMenuOpen(false)
};
'''
        props:
          '''
return {
  as: "div",
  class: "olx-shell",
  onMount: () => {
    f.loadUiCss();
    f.initLocation();
  }
};
'''
