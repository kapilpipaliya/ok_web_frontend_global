          '''
return `._id {
  font-size: 0.8rem;
  font-weight: 700;
}`;
'''
      }
    }
    {
      id: "loc_city"
      L: Attr
      P: {
        displayOrder: 5
        componentName: Html
        props:
          '''
return {
  as: "select",
  class: "ui-input",
  value: f.draftCity?.() || "",
  onChange: f.onDraftCityChange,
  disabled: !(f.draftState?.() || "")
};
'''
        css:
          '''
return `._id {
  width: 100%;
}`;
'''
      }
    }
    {
      id: "loc_city_opts"
      L: Attr
      P: {
        contextName: cityOpt
        loop: true
        displayOrder: 1
        componentName: Html
        props:
          '''
const list = [
  {
    value: "",
    label: f.draftState?.() ? "Select city" : "Select state first"
  },
  ...(f.cityOptions?.() || []).map((name) => ({ value: name, label: name }))
];
return {
  as: "fragment",
  data: list
};
'''
      }
    }
    {
      id: "loc_city_opt"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
