      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
return {
  as: "label",
  text: "State / UT"
};
'''
        css:
          '''
return `._id {
  font-size: 0.8rem;
  font-weight: 700;
}`;
'''
      }
    }
    {
      id: "loc_state"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        props:
          '''
return {
  as: "select",
  class: "ui-input",
  value: f.draftState?.() || "",
  onChange: f.onDraftStateChange
};
'''
        css:
          '''
return `._id {
  width: 100%;
}`;
'''
      }
    }
    {
      id: "loc_state_opts"
      L: Attr
      P: {
        contextName: stateOpt
        loop: true
        displayOrder: 1
        componentName: Html
        props:
          '''
const list = [
  { value: "", label: "Select state" },
  ...(f.states?.() || []).map((name) => ({ value: name, label: name }))
];
return {
  as: "fragment",
  data: list
};
'''
      }
    }
    {
      id: "loc_state_opt"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const opt = c.stateOpt || {};
return {
  as: "option",
  value: opt.value || "",
  text: opt.label || "",
  selected: (opt.value || "") === (f.draftState?.() || "")
};
'''
      }
    }
    {
      id: "loc_city_label"
      L: Attr
      P: {
        displayOrder: 4
        componentName: Html
        props:
          '''
return {
  as: "label",
  text: "City"
};
'''
