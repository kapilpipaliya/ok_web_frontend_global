const isAdmin = args.fns.checkAdminRole?.();
const onSettingsRoute = args.fns.isOnSettingsRoute?.();
const panelOpen = args.fns.isPanelOpen?.();
return {
  as: "button",
  type: "button",
  "aria-label": panelOpen ? "Close page settings" : "Edit page settings",
  title: panelOpen ? "Close settings" : "Edit page settings",
  hide: !isAdmin || onSettingsRoute,
  onClick: () => (panelOpen ? args.fns.closePanel?.() : args.fns.togglePanel?.())
};
'''
