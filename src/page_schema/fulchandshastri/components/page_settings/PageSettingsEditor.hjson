return {
  as: "style",
  text: `body.fulchand-settings-panel-open {
  overflow-x: hidden;
}

body.fulchand-settings-panel-open [data-fulchand-page-main] {
  margin-right: var(--fulchand-settings-panel-width, 440px);
  transition: margin-right 0.25s ease;
}

body.fulchand-settings-panel-resizing [data-fulchand-page-main] {
  transition: none;
}`
};
'''
