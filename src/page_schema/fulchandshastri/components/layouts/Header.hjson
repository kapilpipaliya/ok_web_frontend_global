        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "button",
  onClick: async () => {
    const audioElement = args.fns.audioRef();

    if (audioElement) {
      try {
        if (args.fns.musicPlaying()) {
          audioElement.pause();
        } else {
          const playPromise = audioElement.play();
          if (playPromise !== undefined) {
            await playPromise;
          }
        }
      } catch (error) {
        console.error("Audio playback error:", error);
        args.showErrorToast(
          "Unable to play audio. Please check your browser settings.",
        );
      }
    }
  },
};
'''
      }
    }
