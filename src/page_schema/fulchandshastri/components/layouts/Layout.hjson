        description: Shared layout with header, page content slot, and footer for Fulchand Shastri pages
        fns:
          '''
const prefersReducedMotion = () =>
  window.matchMedia("(prefers-reduced-motion: reduce)").matches;

const waitForMotion = (callback, attempts = 80) => {
  const motion = window.__motion;
  if (motion?.inView && motion?.animate) {
    callback(motion);
    return;
  }
  if (attempts <= 0) return;
  setTimeout(() => waitForMotion(callback, attempts - 1), 50);
};

const applyInitialState = (el, state) => {
  if (state.opacity) {
    el.style.opacity = "0";
  }
  const parts = [];
  if (state.x) parts.push(`translateX(${state.x}px)`);
  if (state.y) parts.push(`translateY(${state.y}px)`);
  if (state.scale !== 1) parts.push(`scale(${state.scale})`);
  if (state.rotate) parts.push(`rotate(${state.rotate}deg)`);
  if (parts.length) {
    el.style.transform = parts.join(" ");
  }
};

const animateOnView = (el, options = {}) => {
  if (!el || el.dataset.motionInit) return;

  const {
    opacity = true,
    x = 0,
    y = 24,
    scale = 1,
    rotate = 0,
    duration = 0.55,
    delay = 0,
    easing = "easeOut",
    amount = 0.15,
    margin = "0px 0px -80px 0px"
  } = options;

  if (prefersReducedMotion()) {
    el.dataset.motionInit = "true";
    el.style.opacity = "1";
    return;
  }

  applyInitialState(el, { opacity, x, y, scale, rotate });
  el.dataset.motionInit = "true";

  waitForMotion((motion) => {
    if (!motion) {
      el.style.opacity = "1";
      el.style.transform = "";
      return;
    }

    const keyframes = {};

    if (opacity) {
      keyframes.opacity = [0, 1];
    }

    if (x) {
      keyframes.x = [x, 0];
    }

    if (y) {
      keyframes.y = [y, 0];
    }

    if (scale !== 1) {
      keyframes.scale = [scale, 1];
    }

    if (rotate) {
      keyframes.rotate = [rotate, 0];
    }

    if (Object.keys(keyframes).length === 0) return;

    motion.inView(
      el,
      () => {
        motion.animate(el, keyframes, {
          duration,
          delay,
          easing
        });
      },
      {
        amount,
        margin
      }
    );
  });
};

return {
  animateOnView,
  executeYTOFunction: (functionName, contextData) =>
    args.executeNamedServerFunction({
      functionName,
      contextData: contextData || {}
    })
};
'''
