      // Handle script load errors (e.g., ad blockers)
      script.onerror = () => {
        // Silently fail if blocked by ad blocker or privacy extension
        console.info("Google Analytics blocked by browser extension");
      };

      document.head.appendChild(script);
    }
  },
};
