        displayOrder: 1
        fns:
          '''// Global confirmation dialog state
const [isConfirmDialogOpen, setIsConfirmDialogOpen] = args.createSignal(false);
const [confirmDialogConfig, setConfirmDialogConfig] = args.createStore({
  title: "Confirm Action",
  message: "Are you sure you want to proceed?",
  confirmText: "Confirm",
  cancelText: "Cancel",
  variant: "danger",
  loading: false,
  onConfirm: null,
  onCancel: null
});

// Navigation state
const [isNavigating, setIsNavigating] = args.createSignal(false);

// Global confirm function that can be called from anywhere
const showConfirm = (config) => {
  return new Promise((resolve, reject) => {
    // Use batch to update both config and open state atomically
    args.batch(() => {
      setConfirmDialogConfig({
        title: config.title || "Confirm Action",
        message: config.message || "Are you sure you want to proceed?",
        confirmText: config.confirmText || "Confirm",
        cancelText: config.cancelText || "Cancel",
        variant: config.variant || "danger",
        loading: false,
        onConfirm: async () => {
          try {
            setConfirmDialogConfig("loading", true);
            if (config.onConfirm) {
              const result = await config.onConfirm();
              setIsConfirmDialogOpen(false);
              // Small delay to allow dialog to fully close before resolving
              await new Promise(r => setTimeout(r, 50));
              resolve(result);
            } else {
              setIsConfirmDialogOpen(false);
              // Small delay to allow dialog to fully close before resolving
              await new Promise(r => setTimeout(r, 50));
              resolve(true);
            }
          } catch (error) {
            setConfirmDialogConfig("loading", false);
            setIsConfirmDialogOpen(false);
            reject(error);
          }
        },
        onCancel: () => {
          setIsConfirmDialogOpen(false);
          if (config.onCancel) {
            config.onCancel();
          }
          resolve(false);
        }
      });
      setIsConfirmDialogOpen(true);
    });
  });
};

// Global navigation function with perfect timing
// Monitors actual pathname and search params changes instead of using arbitrary timeouts
const navigateTo = async (path, options = {}) => {
  try {
    // Capture current location before navigation
    // This is our reference point to detect when route actually changes
    const currentPath = args.location.pathname;
    const currentSearch = args.location.search;
    const currentFull = currentPath + currentSearch;

    // Parse the target path to get pathname and search
    const targetUrl = new URL(path, window.location.origin);
    const targetFull = targetUrl.pathname + targetUrl.search;

    // Check if we're navigating to the exact same route (including query params)
    // If so, skip animation entirely to avoid infinite overlay
    if (currentFull === targetFull) {
      console.log('Same route navigation detected, skipping animation');
      return;
    }

    // Start navigation animation - triggers overlay appearance
    setIsNavigating(true);

    // Brief delay to allow overlay to fade in smoothly
    // Provides visual feedback that navigation has started
    await new Promise(resolve => setTimeout(resolve, 100));

    // Fire the navigation - this may be async and take variable time
    args.navigate(path, options);

    // Smart location monitoring system
    // Polls until the actual route change is detected (pathname OR search params)
    const waitForPathChange = () => {
      return new Promise((resolve) => {
        let pollCount = 0;
        const maxPolls = 100; // Safety limit: 5 seconds (100 * 50ms)

        const checkPath = () => {
          pollCount++;

          // Check if pathname OR search params have changed from original
          const newFull = args.location.pathname + args.location.search;
          if (newFull !== currentFull) {
            // Success! Route has changed
            // Add small buffer time for new route components to fully render
            setTimeout(resolve, 100);
          } else if (pollCount >= maxPolls) {
            // Safety timeout: stop polling after max attempts
            // This prevents infinite loops in edge cases
            console.warn('Navigation polling timeout reached');
            resolve();
          } else {
            // Route hasn't changed yet, keep polling
            // Check again in 50ms (fast enough to be imperceptible)
            setTimeout(checkPath, 50);
          }
        };
        // Start the polling
        checkPath();
      });
    };

    // Wait for location to change and new route to render
    await waitForPathChange();

    // End navigation animation - overlay disappears, new content revealed
    setIsNavigating(false);
  } catch (error) {
    // Handle any navigation errors gracefully
    console.error('Navigation error:', error);
    // Always ensure animation state is cleaned up, even on errors
    setIsNavigating(false);
    throw error;
  }
};

return {
  isConfirmDialogOpen,
  setIsConfirmDialogOpen,
  confirmDialogConfig,
  setConfirmDialogConfig,
  showConfirm,
  rbConfirm: showConfirm,  // Alias for easy access
  isNavigating,
  setIsNavigating,
  navigateTo
};'''
        componentName: Html
        props:
          '''return {
  as: "div",
  data: {
    showConfirm: args.fns.showConfirm,
    isConfirmDialogOpen: args.fns.isConfirmDialogOpen,
    confirmDialogConfig: args.fns.confirmDialogConfig,
    rbConfirm: args.fns.rbConfirm
  }
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        name: confirmProvider
        displayOrder: 1
        componentName: Slot
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 2
        componentName: ConfirmDialog
        props:
          '''const isOpen = args.fns.isConfirmDialogOpen?.();
const config = args.fns.confirmDialogConfig || {};

return {
  isOpen: isOpen,
  title: config.title,
  message: config.message,
  confirmText: config.confirmText,
  cancelText: config.cancelText,
  variant: config.variant,
  loading: config.loading,
  onConfirm: config.onConfirm,
  onCancel: config.onCancel,
  getUsePolarisUI: args.contextData.props?.getUsePolarisUI?.() === true
};'''
      }
    }
  ]
  edges: [
