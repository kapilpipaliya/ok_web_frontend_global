        displayOrder: 1
        componentName: Html
        props:
          '''const cfg = f.getUploadConfiguration?.() ?? {};
const dragEnabled = cfg.enableDragDrop !== false;
return {
  as: "div",
  // Do not open the OS file picker on preview click — only the pick button should.
  onClick: (event) => event?.stopPropagation?.(),
  onDragOver: dragEnabled ? (event) => event?.preventDefault?.() : undefined,
  onDrop: dragEnabled
    ? (event) => {
        event?.preventDefault?.();
        event?.stopPropagation?.();
        const dropped = event?.dataTransfer?.files ?? null;
        if (!dropped || dropped.length === 0) return;
        void f.applyFileList?.(dropped);
      }
    : undefined
};'''
