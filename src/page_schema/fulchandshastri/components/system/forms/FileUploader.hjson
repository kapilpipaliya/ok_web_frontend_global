const label = uploading
  ? f.getUploadStatusLabel?.() || cfg.uploadingMessage || "Uploading…"
  : cfg.pickButtonLabel || (cfg.multiple === true ? "Select files" : "Select file");
const disabled = c.props?.disabled === true || uploading;
const onClick = (event) => {
  event?.stopPropagation?.();
  event?.preventDefault?.();
