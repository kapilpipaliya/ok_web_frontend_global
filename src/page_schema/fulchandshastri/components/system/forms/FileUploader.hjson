{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''
const [files, setFiles] = _.createSignal([]);
const [previewUrls, setPreviewUrls] = _.createSignal([]);
const [uploadError, setUploadError] = _.createSignal("");
const [isUploading, setIsUploading] = _.createSignal(false);
const [uploadProgress, setUploadProgress] = _.createSignal(0);
const [uploadStatusText, setUploadStatusText] = _.createSignal("");

let inputRef = null;
const DEFAULT_CHUNK_THRESHOLD_BYTES = 5 * 1024 * 1024;
const DEFAULT_CHUNK_SIZE_BYTES = 4 * 1024 * 1024;

const clearUploadError = () => setUploadError("");
const setUploadErrorMessage = (message) => {
  const text = message != null ? String(message).trim() : "";
  setUploadError(text);
};

const compileUploadHook = (source) => {
  if (typeof source === "function") return source;
  if (typeof source !== "string" || source.trim() === "") return null;
  const sourceText = source.trim();
  const trimmed = sourceText.trimStart();
  const isFnExpr =
    trimmed.startsWith("async ") ||
    trimmed.startsWith("function") ||
    trimmed.includes("=>");
  try {
    if (isFnExpr) {
      return new Function("ctx", "_", `return (${sourceText});`)({}, _);
    }
    const hasLeadingReturn =
      trimmed.startsWith("return ") ||
      trimmed.startsWith("return\t") ||
      trimmed.startsWith("return\n") ||
      trimmed === "return;";
    const body = hasLeadingReturn ? sourceText : `return (${sourceText});`;
    return new Function("ctx", "_", body)({}, _);
  } catch (error) {
    console.warn("FileUploader: invalid upload hook", error);
    return null;
  }
};

const getUploadConfiguration = () => {
  const raw = c.props?.uploadConfiguration;
  if (raw == null || typeof raw !== "object" || Array.isArray(raw)) {
    return {
      accept: "*/*",
      uploadUrl: "/api/file/upload",
      multiple: false,
      maxFiles: 0,
      hidePreview: true,
      enableDragDrop: true,
      pickButtonLabel: "Select file",
      pickButtonVariant: "primary",
      usePolarisUI: false,
      fullWidth: false,
      previewMinHeight: "12.5rem",
      previewMaxItemWidth: "12.5rem",
      previewMaxItemHeight: "12.5rem",
      mediaUrl: "",
      attachUploadedFileToFieldKey: "",
      integrationMode: "upload",
      formDataFieldName: "file",
      successToastMessage: "File uploaded",
      uploadFailedMessage: "Upload failed",
      noFileReturnedMessage: "Upload failed: no file returned",
      notInGraphMessage: "Upload saved but file not found in graph",
      uploadingMessage: "Uploading…",
      showUploadErrorToast: true,
      chunkThresholdBytes: DEFAULT_CHUNK_THRESHOLD_BYTES,
      chunkSizeBytes: DEFAULT_CHUNK_SIZE_BYTES,
      uploadInitUrl: "/api/file/upload/init",
      uploadChunkUrl: "/api/file/upload/chunk",
      uploadCompleteUrl: "/api/file/upload/complete",
      uploadAbortUrl: "/api/file/upload/abort",
      onFileSelect: null,
      onUploadSuccess: null,
    };
  }

  const attachKey =
    raw.attachUploadedFileToFieldKey != null
      ? String(raw.attachUploadedFileToFieldKey).trim()
      : "";
  const multiple = raw.multiple === true;
  const hidePreview = raw.hidePreview === true;
  const maxFilesRaw = Number(raw.maxFiles);
  const maxFiles =
    Number.isFinite(maxFilesRaw) && maxFilesRaw > 0 ? Math.floor(maxFilesRaw) : 0;
  const defaultPickLabel = multiple ? "Select files" : "Select file";
  const pickButtonLabel =
    raw.pickButtonLabel != null && String(raw.pickButtonLabel).trim() !== ""
      ? String(raw.pickButtonLabel).trim()
      : defaultPickLabel;

  return {
    accept: raw.accept != null ? String(raw.accept) : "*/*",
    uploadUrl:
      raw.uploadUrl != null && String(raw.uploadUrl).trim() !== ""
        ? String(raw.uploadUrl).trim()
        : "/api/file/upload",
    multiple,
    maxFiles,
    hidePreview,
    enableDragDrop: raw.enableDragDrop !== false,
    pickButtonLabel,
    pickButtonVariant: raw.pickButtonVariant != null ? String(raw.pickButtonVariant) : "primary",
    usePolarisUI: raw.usePolarisUI === true,
    fullWidth: raw.fullWidth === true,
    previewMinHeight: raw.previewMinHeight != null ? String(raw.previewMinHeight) : "12.5rem",
    previewMaxItemWidth: raw.previewMaxItemWidth != null ? String(raw.previewMaxItemWidth) : "12.5rem",
    previewMaxItemHeight: raw.previewMaxItemHeight != null ? String(raw.previewMaxItemHeight) : "12.5rem",
    previewObjectFit:
      raw.previewObjectFit != null && String(raw.previewObjectFit).trim() !== ""
        ? String(raw.previewObjectFit).trim()
        : "contain",
    mediaUrl: raw.mediaUrl != null ? String(raw.mediaUrl) : "",
    fileDownloadUrlPrefix:
      raw.fileDownloadUrlPrefix != null
        ? String(raw.fileDownloadUrlPrefix)
        : "/api/file/download",
    attachUploadedFileToFieldKey: attachKey,
    integrationMode:
      raw.integrationMode != null && String(raw.integrationMode).trim() !== ""
        ? String(raw.integrationMode).trim()
        : attachKey !== ""
          ? "attachField"
          : "upload",
    formDataFieldName:
      raw.formDataFieldName != null && String(raw.formDataFieldName).trim() !== ""
        ? String(raw.formDataFieldName).trim()
        : "file",
    successToastMessage:
      raw.successToastMessage != null ? String(raw.successToastMessage) : "File uploaded",
    uploadFailedMessage: raw.uploadFailedMessage != null ? String(raw.uploadFailedMessage) : "Upload failed",
    noFileReturnedMessage:
      raw.noFileReturnedMessage != null
        ? String(raw.noFileReturnedMessage)
        : "Upload failed: no file returned",
    notInGraphMessage:
      raw.notInGraphMessage != null
        ? String(raw.notInGraphMessage)
        : "Upload saved but file not found in graph",
    uploadingMessage:
      raw.uploadingMessage != null && String(raw.uploadingMessage).trim() !== ""
        ? String(raw.uploadingMessage).trim()
        : "Uploading…",
    showUploadErrorToast: raw.showUploadErrorToast !== false,
    chunkThresholdBytes:
      Number.isFinite(Number(raw.chunkThresholdBytes)) && Number(raw.chunkThresholdBytes) > 0
        ? Number(raw.chunkThresholdBytes)
        : DEFAULT_CHUNK_THRESHOLD_BYTES,
    chunkSizeBytes:
      Number.isFinite(Number(raw.chunkSizeBytes)) && Number(raw.chunkSizeBytes) > 0
        ? Number(raw.chunkSizeBytes)
        : DEFAULT_CHUNK_SIZE_BYTES,
    uploadInitUrl:
      raw.uploadInitUrl != null && String(raw.uploadInitUrl).trim() !== ""
        ? String(raw.uploadInitUrl).trim()
        : "/api/file/upload/init",
    uploadChunkUrl:
      raw.uploadChunkUrl != null && String(raw.uploadChunkUrl).trim() !== ""
        ? String(raw.uploadChunkUrl).trim()
        : "/api/file/upload/chunk",
    uploadCompleteUrl:
      raw.uploadCompleteUrl != null && String(raw.uploadCompleteUrl).trim() !== ""
        ? String(raw.uploadCompleteUrl).trim()
        : "/api/file/upload/complete",
    uploadAbortUrl:
      raw.uploadAbortUrl != null && String(raw.uploadAbortUrl).trim() !== ""
        ? String(raw.uploadAbortUrl).trim()
        : "/api/file/upload/abort",
    onFileSelect: compileUploadHook(raw.onFileSelect),
    onUploadSuccess: compileUploadHook(raw.onUploadSuccess),
  };
};

const getUploadCallbacks = () => {
  const raw = c.props?.uploadCallbacks;
  return raw != null && typeof raw === "object" && !Array.isArray(raw) ? raw : {};
};

const revokePreviewUrls = (urls) => {
  const list = Array.isArray(urls) ? urls : [];
  for (let i = 0; i < list.length; i++) {
    const url = list[i];
    if (typeof url === "string" && url.startsWith("blob:")) {
      try {
        URL.revokeObjectURL(url);
      } catch (_) {
        /* ignore */
      }
    }
  }
};

const isImageFile = (file) =>
  typeof file?.type === "string" && file.type.startsWith("image/");
const isVideoFile = (file) =>
  typeof file?.type === "string" && file.type.startsWith("video/");
const isImageMime = (mime) =>
  typeof mime === "string" && mime.startsWith("image/");
const isVideoMime = (mime) =>
  typeof mime === "string" && mime.startsWith("video/");

const mimeFromFileName = (fileName) => {
  const lower = String(fileName || "").toLowerCase();
  if (/\.(png|jpe?g|gif|webp|svg|ico|bmp)$/.test(lower)) return "image/*";
  if (/\.(mp4|webm|ogg|mov|m4v)$/.test(lower)) return "video/*";
  return "";
};

const buildDownloadUrlFromVertex = (vertex, cfg) => {
  if (!vertex?.P) return "";
  const fileName =
    vertex.P.fileName != null ? String(vertex.P.fileName).trim() : "";
  if (fileName === "") return "";
  const prefix =
    cfg?.fileDownloadUrlPrefix != null &&
    String(cfg.fileDownloadUrlPrefix).trim() !== ""
      ? String(cfg.fileDownloadUrlPrefix).replace(/\/$/, "")
      : "/api/file/download";
  return `${prefix}/${encodeURIComponent(fileName)}`;
};

const getFormVertexMime = () => {
  const callbacks = getUploadCallbacks();
  const vertexId =
    typeof callbacks.formVertexId === "function" ? callbacks.formVertexId() : null;
  const vertex = vertexId ? g.vertexes[vertexId] : null;
  const p = vertex?.P;
  if (!p) return "";
  if (p.fileType != null && String(p.fileType).trim() !== "") return String(p.fileType);
  if (p.mimeType != null && String(p.mimeType).trim() !== "") return String(p.mimeType);
  return "";
};

const syncPreviewFromVertex = (vertexId) => {
  const cfg = getUploadConfiguration();
  if (cfg.hidePreview === true) return;
  const vertex = g.vertexes[vertexId];
  const url = buildDownloadUrlFromVertex(vertex, cfg);
  if (url === "") return;
  const current = previewUrls();
  if (current.length === 1 && current[0] === url && files().length === 0) return;
  revokePreviewUrls(previewUrls());
  setPreviewUrls([url]);
  setFiles([]);
};

const syncFormFieldsFromVertex = (vertexId, callbacks) => {
  const vertex = g.vertexes[vertexId];
  if (!vertex?.P || typeof callbacks.setFieldValue !== "function") return;
  const p = vertex.P;
  if (p.fileName != null && String(p.fileName).trim() !== "") {
    callbacks.setFieldValue("fileName", String(p.fileName));
  }
  if (p.description != null) {
    callbacks.setFieldValue("description", String(p.description));
  }
  if (p.fileSize != null) {
    callbacks.setFieldValue("fileSize", String(p.fileSize));
  }
  const mime =
    p.mimeType != null && String(p.mimeType).trim() !== ""
      ? String(p.mimeType)
      : p.fileType != null
        ? String(p.fileType)
        : "";
  if (mime !== "") {
    callbacks.setFieldValue("fileType", mime);
  }
  if (p.uploadDate != null && String(p.uploadDate).trim() !== "") {
    callbacks.setFieldValue("uploadDate", String(p.uploadDate));
  }
};

let uploadInProgress = false;

const notifyUploading = (value, progress, statusText) => {
  setIsUploading(value === true);
  if (typeof progress === "number" && Number.isFinite(progress)) {
    setUploadProgress(Math.max(0, Math.min(100, Math.round(progress))));
  } else if (value !== true) {
    setUploadProgress(0);
  }
  if (statusText != null) {
    setUploadStatusText(String(statusText));
  } else if (value !== true) {
    setUploadStatusText("");
  }
  const callbacks = getUploadCallbacks();
  if (typeof callbacks.setIsFileUploading === "function") {
    try {
      callbacks.setIsFileUploading(value === true);
    } catch (_) {
      /* parent may already be disposing */
    }
  }
};

const resetFileInput = () => {
  if (!inputRef) return;
  try {
    inputRef.value = "";
  } catch (_) {
    /* ignore */
  }
};

const clearLocalSelection = () => {
  revokePreviewUrls(previewUrls());
  setPreviewUrls([]);
  setFiles([]);
  resetFileInput();
};

const formatUploadErrorMessage = (error, fallbackMessage) => {
  const raw =
    error instanceof Error
      ? error.message
      : error != null
        ? String(error)
        : "";
  const text = raw.trim() || String(fallbackMessage || "Upload failed");
  if (/already exists/i.test(text)) {
    return `${text}. Choose a different file or rename it before uploading.`;
  }
  return text;
};

const scheduleIdle = (fn) => {
  if (typeof queueMicrotask === "function") {
    queueMicrotask(fn);
    return;
  }
  setTimeout(fn, 0);
};

const parseJsonResponse = async (response) => {
  const contentType = response.headers.get("content-type") || "";
  if (contentType.includes("application/json")) {
    return await response.json();
  }
  const text = await response.text();
  throw new Error(text || response.statusText || "Upload failed");
};

const ensureValidApiPayload = (payload, fallbackMessage) => {
  if (!payload || payload.error || payload.statusCode === 500) {
    const message =
      payload?.error ||
      payload?.message ||
      payload?.statusMessage ||
      fallbackMessage ||
      "Upload failed";
    throw new Error(String(message));
  }
  return payload;
};

const postJson = async (url, body) => {
  const response = await fetch(url, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body || {}),
  });
  const payload = await parseJsonResponse(response);
  // Some runtimes may still return 200 with `{ error }` — treat that as failure.
  if (!response.ok || payload?.error) {
    throw new Error(
      payload?.error ||
        payload?.message ||
        payload?.statusMessage ||
        response.statusText ||
        "Upload failed",
    );
  }
  return ensureValidApiPayload(payload);
};

const uploadFormDataWithProgress = (url, formData, onProgress) =>
  new Promise((resolve, reject) => {
    const xhr = new XMLHttpRequest();
    xhr.open("POST", url);
    xhr.timeout = 10 * 60 * 1000;
    xhr.responseType = "text";
    xhr.upload.onprogress = (event) => {
      if (!event.lengthComputable || typeof onProgress !== "function") return;
      onProgress(Math.round((event.loaded / event.total) * 100));
    };
    xhr.onload = () => {
      let payload = null;
      try {
        payload = xhr.responseText ? JSON.parse(xhr.responseText) : {};
      } catch (_) {
        reject(new Error(xhr.responseText || xhr.statusText || "Upload failed"));
        return;
      }
      if (xhr.status < 200 || xhr.status >= 300) {
        reject(
          new Error(
            payload?.error ||
              payload?.message ||
              payload?.statusMessage ||
              xhr.statusText ||
              "Upload failed",
          ),
        );
        return;
      }
      try {
        resolve(ensureValidApiPayload(payload));
      } catch (error) {
        reject(error);
      }
    };
    xhr.onerror = () => reject(new Error("Network error during upload"));
    xhr.ontimeout = () => reject(new Error("Upload timed out. Try again or use a smaller file."));
    xhr.onabort = () => reject(new Error("Upload aborted"));
    xhr.send(formData);
  });

const buildUploadHookContext = (
  uploadedId,
  uploadedVertex,
  file,
  fileList,
  response,
  cfg,
  callbacks,
  batchMeta
) => ({
  uploadedId,
  uploadedVertex,
  file,
  fileList,
  response,
  configuration: cfg,
  callbacks,
  _,
  fileIndex: batchMeta?.fileIndex ?? 0,
  fileCount: batchMeta?.fileCount ?? (Array.isArray(fileList) ? fileList.length : 1),
  isLastFile: batchMeta?.isLastFile !== false,
  uploadedIds: batchMeta?.uploadedIds || (uploadedId ? [uploadedId] : []),
  syncPreview: (vertexId) => {
    const id =
      vertexId != null && String(vertexId).trim() !== ""
        ? String(vertexId).trim()
        : uploadedId;
    syncPreviewFromVertex(id);
  },
  showSuccess: (message) => {
    _.showSuccessToast?.(
      message != null && String(message).trim() !== ""
        ? String(message).trim()
        : cfg.successToastMessage,
    );
  },
  showError: (message) => {
    const text =
      message != null && String(message).trim() !== ""
        ? String(message).trim()
        : cfg.uploadFailedMessage;
    setUploadErrorMessage(text);
    if (cfg.showUploadErrorToast !== false) {
      _.showErrorToast?.(text);
    }
  },
  syncFormFields: (vertexId) => syncFormFieldsFromVertex(vertexId, callbacks),
});

const handleUploadedResponse = async (data, file, fileList, cfg, callbacks, batchMeta) => {
  if (data?.graph && typeof data.graph === "object") {
    _.setGraphData(0, data.graph, {});
  }

  const rows = data?.result;
  const first = Array.isArray(rows) ? rows[0] : rows;
  const uploadedId = first?.id != null ? String(first.id) : "";
  if (uploadedId === "") throw new Error(cfg.noFileReturnedMessage);

  await Promise.resolve();
  const uploadedVertex = g.vertexes[uploadedId];
  if (!uploadedVertex) throw new Error(cfg.notInGraphMessage);

  clearUploadError();

  const fileCount = batchMeta?.fileCount ?? (Array.isArray(fileList) ? fileList.length : 1);
  const isLastFile = batchMeta?.isLastFile !== false;
  const uploadedIds = Array.isArray(batchMeta?.uploadedIds)
    ? batchMeta.uploadedIds
    : [uploadedId];

  const hookContext = buildUploadHookContext(
    uploadedId,
    uploadedVertex,
    file,
    fileList,
    data,
    cfg,
    callbacks,
    {
      fileIndex: batchMeta?.fileIndex ?? 0,
      fileCount,
      isLastFile,
      uploadedIds,
    },
  );

  if (typeof cfg.onUploadSuccess === "function") {
    await cfg.onUploadSuccess(hookContext);
  } else if (isLastFile) {
    if (
      cfg.integrationMode === "attachField" &&
      cfg.attachUploadedFileToFieldKey !== "" &&
      typeof callbacks.setFieldValue === "function"
    ) {
      callbacks.setFieldValue(
        cfg.attachUploadedFileToFieldKey,
        fileCount > 1 ? uploadedIds : uploadedId,
      );
    }
    syncPreviewFromVertex(uploadedId);
    _.showSuccessToast?.(
      fileCount > 1 ? `${fileCount} files uploaded` : cfg.successToastMessage,
    );
  }

  if (isLastFile && typeof callbacks.onFilesUploaded === "function") {
    try {
      callbacks.onFilesUploaded(uploadedIds.length > 0 ? uploadedIds : [uploadedId]);
    } catch (_) {
      /* parent may ignore */
    }
  }
};

const uploadFileDirect = async (file, cfg, onProgress) => {
  const formData = new FormData();
  formData.append(cfg.formDataFieldName, file);
  return await uploadFormDataWithProgress(cfg.uploadUrl, formData, onProgress);
};

const uploadFileChunked = async (file, cfg, onProgress) => {
  const chunkSize = cfg.chunkSizeBytes || DEFAULT_CHUNK_SIZE_BYTES;
  const init = await postJson(cfg.uploadInitUrl, {
    fileName: file.name,
    fileSize: file.size,
    mimeType: file.type || "",
    chunkSize,
  });

  const uploadId = init?.uploadId != null ? String(init.uploadId) : "";
  const resolvedChunkSize = Number(init?.chunkSize) || chunkSize;
  const totalChunks =
    Number(init?.totalChunks) || Math.ceil(file.size / resolvedChunkSize);

  if (!uploadId) {
    throw new Error("Failed to start chunked upload");
  }

  try {
    for (let chunkIndex = 0; chunkIndex < totalChunks; chunkIndex++) {
      const start = chunkIndex * resolvedChunkSize;
      const end = Math.min(file.size, start + resolvedChunkSize);
      const blob = file.slice(start, end);
      const formData = new FormData();
      formData.append("uploadId", uploadId);
      formData.append("chunkIndex", String(chunkIndex));
      formData.append("totalChunks", String(totalChunks));
      formData.append("chunk", blob, file.name);

      await uploadFormDataWithProgress(cfg.uploadChunkUrl, formData, (chunkPct) => {
        const base = (chunkIndex / totalChunks) * 100;
        const span = 100 / totalChunks;
        if (typeof onProgress === "function") {
          onProgress(base + (chunkPct / 100) * span);
        }
      });

      if (typeof onProgress === "function") {
        onProgress(((chunkIndex + 1) / totalChunks) * 100);
      }
    }

    return await postJson(cfg.uploadCompleteUrl, { uploadId });
  } catch (error) {
    try {
      await postJson(cfg.uploadAbortUrl, { uploadId });
    } catch (_) {
      /* ignore abort errors */
    }
    throw error;
  }
};

const formatBatchStatus = (cfg, fileIndex, fileCount, pct) => {
  const rounded = Math.round(pct);
  const pctText = rounded > 0 ? ` (${rounded}%)` : "";
  if (fileCount > 1) {
    return `Uploading ${fileIndex + 1} of ${fileCount}${pctText}`;
  }
  const base = cfg.uploadingMessage || "Uploading…";
  return rounded > 0 ? `${base} ${rounded}%` : base;
};

const processUpload = async (fileList) => {
  if (uploadInProgress) return;
  uploadInProgress = true;
  const cfg = getUploadConfiguration();
  const callbacks = getUploadCallbacks();
  try {
    if (typeof cfg.onFileSelect === "function") {
      notifyUploading(true, 0, cfg.uploadingMessage);
      await cfg.onFileSelect(fileList, {
        _,
        configuration: cfg,
        callbacks,
        syncPreview: (vertexId) => {
          if (vertexId) syncPreviewFromVertex(String(vertexId));
        },
      });
      return;
    }

    const filesToUpload =
      cfg.multiple === true ? fileList || [] : fileList?.[0] ? [fileList[0]] : [];
    if (filesToUpload.length === 0) return;

    const fileCount = filesToUpload.length;
    const uploadedIds = [];

    for (let fileIndex = 0; fileIndex < fileCount; fileIndex++) {
      const file = filesToUpload[fileIndex];
      const overallBase = (fileIndex / fileCount) * 100;
      const overallSpan = 100 / fileCount;
      notifyUploading(true, overallBase, formatBatchStatus(cfg, fileIndex, fileCount, 0));

      const useChunked = Number(file.size) > Number(cfg.chunkThresholdBytes || 0);
      const data = useChunked
        ? await uploadFileChunked(file, cfg, (pct) => {
            const overall = overallBase + (pct / 100) * overallSpan;
            notifyUploading(true, overall, formatBatchStatus(cfg, fileIndex, fileCount, pct));
          })
        : await uploadFileDirect(file, cfg, (pct) => {
            const overall = overallBase + (pct / 100) * overallSpan;
            notifyUploading(true, overall, formatBatchStatus(cfg, fileIndex, fileCount, pct));
          });

      const rows = data?.result;
      const first = Array.isArray(rows) ? rows[0] : rows;
      const uploadedId = first?.id != null ? String(first.id) : "";
      if (uploadedId) uploadedIds.push(uploadedId);

      const isLastFile = fileIndex === fileCount - 1;
      await handleUploadedResponse(data, file, filesToUpload, cfg, callbacks, {
        fileIndex,
        fileCount,
        isLastFile,
        uploadedIds: [...uploadedIds],
      });
    }

    notifyUploading(true, 100, formatBatchStatus(cfg, fileCount - 1, fileCount, 100));
  } catch (error) {
    console.error("FileUploader upload", error);
    const message = formatUploadErrorMessage(error, cfg.uploadFailedMessage);
    setUploadErrorMessage(message);
    // Keep selected file visible so the user can see what failed; only reset input for retry.
    resetFileInput();
    if (cfg.showUploadErrorToast !== false) {
      _.showErrorToast?.(message);
    }
  } finally {
    uploadInProgress = false;
    // Defer hide/enable updates so Solid is not disposing nested nodes mid-update.
    scheduleIdle(() => {
      notifyUploading(false, 0, "");
    });
  }
};

const applyFileList = async (fileList) => {
  if (!fileList || fileList.length === 0) return;
  if (uploadInProgress || isUploading()) return;
  const cfg = getUploadConfiguration();
  let filesArray = Array.from(fileList).filter(
    (file) => file && typeof file === "object" && typeof file.name === "string" && file.name.trim() !== "",
  );
  if (filesArray.length === 0) return;
  if (cfg.multiple !== true) {
    filesArray = filesArray.slice(0, 1);
  } else if (cfg.maxFiles > 0 && filesArray.length > cfg.maxFiles) {
    setUploadErrorMessage(`Select at most ${cfg.maxFiles} files`);
    if (cfg.showUploadErrorToast !== false) {
      _.showErrorToast?.(`Select at most ${cfg.maxFiles} files`);
    }
    resetFileInput();
    return;
  }
  clearUploadError();
  revokePreviewUrls(previewUrls());
  const urls = filesArray.map((file) => URL.createObjectURL(file));
  setFiles(filesArray);
  setPreviewUrls(urls);
  await Promise.resolve();
  await processUpload(filesArray);
};

_.onCleanup(() => {
  revokePreviewUrls(previewUrls());
  // Do not notify parent FormManagement here — it may already be disposing.
});

const openPicker = () => {
  if (c.props?.disabled === true || isUploading()) return;
  inputRef?.click?.();
};

const setInputRef = (el) => {
  inputRef = el ?? null;
};

const showPreview = () => {
  if (getUploadConfiguration().hidePreview === true) return false;
  return files().length > 0 || previewUrls().length > 0;
};

const previewItems = () => {
  const fileList = files();
  const urls = previewUrls();
  if (fileList.length > 0) {
    return fileList.map((file, index) => ({
      key: `file-${index}`,
      url: urls[index] || "",
      fileName: file?.name || "",
      isImage: isImageFile(file),
      isVideo: isVideoFile(file),
      index,
      total: fileList.length,
    }));
  }
  if (urls.length > 0) {
    const mime = getFormVertexMime();
    const fileList2 = files();
    const fileName =
      fileList2[0]?.name ||
      (() => {
        const callbacks = getUploadCallbacks();
        const vertexId =
          typeof callbacks.formVertexId === "function" ? callbacks.formVertexId() : null;
        const vertex = vertexId ? g.vertexes[vertexId] : null;
        return vertex?.P?.fileName != null ? String(vertex.P.fileName) : "";
      })();
    const resolvedMime = mime || mimeFromFileName(fileName);
    return urls.map((url, index) => {
      const isVideo = resolvedMime
        ? isVideoMime(resolvedMime)
        : isVideoFile(fileList2[index]);
      const isImage = !isVideo && (resolvedMime ? isImageMime(resolvedMime) : true);
      return {
        key: `media-${index}`,
        url,
        fileName,
        isImage,
        isVideo,
        index,
        total: urls.length,
      };
    });
  }
  return [];
};

const getSelectionSummary = () => {
  const count = files().length || previewItems().length;
  if (count <= 0) return "";
  if (count === 1) {
    return files()[0]?.name || previewItems()[0]?.fileName || "1 file";
  }
  return `${count} files selected`;
};

const showSelectionSummary = () =>
  getUploadConfiguration().multiple === true &&
  (files().length > 1 || previewItems().length > 1);

const showUploadError = () => {
  const msg = uploadError();
  return msg != null && String(msg).trim() !== "";
};

const showUploadStatus = () => isUploading() === true;

const getUploadStatusLabel = () => {
  const custom = uploadStatusText();
  if (custom != null && String(custom).trim() !== "") return String(custom).trim();
  const cfg = getUploadConfiguration();
  const pct = uploadProgress();
  if (pct > 0) return `${cfg.uploadingMessage} ${pct}%`;
  return cfg.uploadingMessage || "Uploading…";
};

return {
  getUploadConfiguration,
  applyFileList,
  openPicker,
  setInputRef,
  showPreview,
  showUploadError,
  showUploadStatus,
  getUploadStatusLabel,
  previewItems,
  getSelectionSummary,
  showSelectionSummary,
  uploadError,
  isUploading,
  uploadProgress,
};
'''
