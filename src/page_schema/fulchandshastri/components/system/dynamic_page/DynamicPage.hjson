{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''const pageStateVertexId = args.generateNewVertexId(args.graph, args.setGraph);
args.addNewVertex(0, {
  id: pageStateVertexId,
  L: ["DynamicPageUiState"],
  P: {
    tableSchemaPartVertexIds: null,
    tableIds: null,
    memoizedConfig: null,
    memoizedLoadFromSetting: false,
    isSettingsModalOpen: false,
    settingsModalInitialConfig: null,
    settings: null,
    evaluatedConfig: null,
    loading: false,
    configLoading: true,
    selectedSidebarCategoryId: null,
    selectedRowsByCategory: {},
    sidebarWidth: 240,
    companionMainHeight: null,
    companionPaneHeight: null,
    rowsToRemoveVertexIds: null,
    rowsToAddVertexIds: null,
    mainTableRowIds: [],
    dropCreateReviewOpen: false,
    dropCreateReviewRows: [],
    dropCreateReviewConfirming: false,
    settingsSectionStateMap: {},
    settingsDirtySectionIds: [],
    settingsFormFnsMap: {},
    settingsLoading: false,
    settingsInitializing: false,
    settingsPageId: null,
    siteLanguages: []
  },
  IN: {},
  OUT: {}
}, args.graph, args.setGraph);

const patchPageP = (partial) => {
  args.mergeVertexProperties(0, pageStateVertexId, args.graph, args.setGraph, partial);
};
const pageP = () => args.graph.vertexes[pageStateVertexId]?.P;

const selectedSidebarItem = () => {
  const id = pageP()?.selectedSidebarCategoryId;
  if (id == null) return null;
  return args.graph.vertexes[id] ?? null;
};

// Basic context/prop accessors
// Resolve settings page id without touching getCachedConfig (avoids cycle with isTableSchemaMode → getTableKey).
const getSettingsPageIdWithoutConfig = () => {
  const fromProps = args.contextData.props?.settingsPageId;
  if (fromProps != null && String(fromProps).trim() !== "") return String(fromProps).trim();
  const useUrl = args.contextData.props?.useUrlQueryParams !== false;
  if (useUrl) {
    const fromQuery = args.searchParams?.page;
    if (fromQuery != null && String(fromQuery).trim() !== "") return String(fromQuery).trim();
  }
  const fromState = pageP()?.settingsPageId;
  if (fromState != null && String(fromState).trim() !== "") return String(fromState).trim();
  return null;
};

const getTableKey = () => {
  const raw = args.contextData.props?.tableKey;
  if (raw != null && String(raw).trim() !== "") return String(raw).trim();
  // Do not call getSettingsPageId() here: it falls back to getCachedConfig → isTableSchemaMode → getTableKey.
  const settingsPageId = getSettingsPageIdWithoutConfig();
  if (String(settingsPageId || "").startsWith("table:")) {
    return String(settingsPageId).slice("table:".length).trim();
  }
  return null;
};
const getTableVertexLabel = () => args.contextData.props?.tableVertexLabel;
const getTableSettingsLabel = () => {
  const tableKey = getTableKey();
  if (tableKey) return tableKey;
  const raw = args.contextData.props?.tableSettingsLabel;
  const fallback = getTableVertexLabel();
  if (raw != null && String(raw).trim() !== "") return String(raw).trim();
  return fallback;
};
const getUncategorizedVertexId = () => {
  const label = getTableVertexLabel();
  return label ? '_' + label + '_uncategorized' : null;
};

const PAGE_RESIZE_STORAGE_PREFIX = "dynamic-page-resize:";
const DEFAULT_SIDEBAR_WIDTH = 240;
const MIN_SIDEBAR_WIDTH = 200;
const MAX_SIDEBAR_WIDTH = 800;
let pendingCompanionMainRatio = null;

const getPageResizeStorageKey = () => {
  const label = getTableVertexLabel();
  const key = getTableKey();
  if (label && key) return `${PAGE_RESIZE_STORAGE_PREFIX}${label}:${key}`;
  const settingsPageId = getSettingsPageIdWithoutConfig();
  if (settingsPageId) return `${PAGE_RESIZE_STORAGE_PREFIX}settings:${settingsPageId}`;
  if (label) return `${PAGE_RESIZE_STORAGE_PREFIX}label:${label}`;
  const pathname = typeof window !== "undefined" ? (args.location?.pathname || "") : "";
  if (pathname) return `${PAGE_RESIZE_STORAGE_PREFIX}path:${pathname}`;
  return `${PAGE_RESIZE_STORAGE_PREFIX}default`;
};

const loadStoredPageResize = () => {
  if (typeof window === "undefined") return null;
  try {
    const raw = window.localStorage.getItem(getPageResizeStorageKey());
    if (!raw) return null;
    const parsed = JSON.parse(raw);
    return parsed && typeof parsed === "object" ? parsed : null;
  } catch (_) {
    return null;
  }
};

const persistPageResize = (partial) => {
  if (typeof window === "undefined" || !partial || typeof partial !== "object") return;
  try {
    const current = loadStoredPageResize() || {};
    window.localStorage.setItem(
      getPageResizeStorageKey(),
      JSON.stringify({ ...current, ...partial })
    );
  } catch (_) {}
};

const getSidebarWidth = () => {
  const width = pageP()?.sidebarWidth;
  return typeof width === "number" && width > 0 ? width : DEFAULT_SIDEBAR_WIDTH;
};

const persistSidebarWidthDebounced = args.debounce((width) => {
  persistPageResize({ sidebarWidth: width });
}, 250);

const setSidebarWidth = (width) => {
  const next = Math.round(Number(width) || 0);
  if (next < MIN_SIDEBAR_WIDTH || next > MAX_SIDEBAR_WIDTH) return;
  patchPageP({ sidebarWidth: next });
  persistSidebarWidthDebounced(next);
};

const restorePageResizeFromLocalStorage = () => {
  const stored = loadStoredPageResize();
  if (!stored) return;
  if (
    typeof stored.sidebarWidth === "number" &&
    stored.sidebarWidth >= MIN_SIDEBAR_WIDTH &&
    stored.sidebarWidth <= MAX_SIDEBAR_WIDTH
  ) {
    patchPageP({ sidebarWidth: Math.round(stored.sidebarWidth) });
  }
  if (Number.isFinite(stored.companionMainRatio)) {
    pendingCompanionMainRatio = stored.companionMainRatio;
  }
};

const getLoadFromSetting = () => args.contextData.props?.loadFromSetting === true;
const isTableSchemaMode = () => {
  const pageMode = args.contextData.props?.pageMode;
  if (pageMode === "settings" || pageMode === "dashboard") return false;
  return getLoadFromSetting() && !!getTableKey();
};
const getTableSchemaPartVertexIds = () => pageP()?.tableSchemaPartVertexIds || null;
const getTableIdsState = () => pageP()?.tableIds || null;

const evalConfigBody = (cfgStr) => {
  if (cfgStr == null || String(cfgStr).trim() === "") return null;
  try {
    const configFn = new Function(String(cfgStr));
    const value = configFn();
    return value && typeof value === "object" ? value : null;
  } catch (error) {
    console.error("evalConfigBody failed:", error);
    return null;
  }
};

const stripPartMeta = (value) => {
  if (!value || typeof value !== "object" || Array.isArray(value)) return {};
  const { part: _part, ...rest } = value;
  return rest;
};

const evalSchemaPart = (part) => {
  const ids = getTableSchemaPartVertexIds();
  const vertexId = ids?.[part];
  if (!vertexId) return null;
  const vertex = args.graph?.vertexes?.[vertexId];
  if (!vertex?.P?.config) return null;
  const raw = evalConfigBody(vertex.P.config);
  if (part === "columns") return raw;
  return stripPartMeta(raw);
};

const resolveGeneralFromPart = (generalRaw, tableVertexLabel) => {
  const general = stripPartMeta(generalRaw || {});
  return {
    publicRead: general.publicRead === true,
    title: general.title || tableVertexLabel,
    label: general.label || tableVertexLabel,
    icon: general.icon || "ph:book-open",
    usePolarisUI: general.usePolarisUI === true,
    enableUserScopingForContent: general.enableUserScopingForContent === true,
    enableUserScopingForSidebar: general.enableUserScopingForSidebar === true,
    enableLocalFilters: general.enableLocalFilters !== false,
    enableLocalSort: general.enableLocalSort !== false,
    showSelection: general.showSelection !== false,
    hideExportButtons: general.hideExportButtons === true,
    hideImportButtons: general.hideImportButtons === true,
    hideSettingsButton: general.hideSettingsButton === true,
    hideAddButton: general.hideAddButton === true,
    rowHeight: general.rowHeight ?? 56,
    columnWidths: general.columnWidths || {},
    rowClickable: general.rowClickable === true,
    showRowNumber: general.showRowNumber !== false,
    resizableColumns: general.resizableColumns === true,
    actions: Array.isArray(general.actions) ? general.actions : [],
    hooks: general.hooks && typeof general.hooks === "object" ? general.hooks : {},
    rowExpansion: general.rowExpansion,
    reasonCodeMap: general.reasonCodeMap,
    refetchIntervalWhenQueued: general.refetchIntervalWhenQueued,
    companionPages: Array.isArray(general.companionPages) ? general.companionPages : [],
    dropCreateFrom: general.dropCreateFrom && typeof general.dropCreateFrom === "object"
      ? general.dropCreateFrom
      : null
  };
};

const buildTableRuntimeConfig = () => {
  const tableVertexLabel = getTableIdsState()?.tableVertexLabel || getTableVertexLabel();
  const general = resolveGeneralFromPart(evalSchemaPart("general"), tableVertexLabel);
  const columnsPart = evalSchemaPart("columns");
  const columns = Array.isArray(columnsPart?.columns) ? columnsPart.columns : [];
  const formConfig = evalSchemaPart("formConfig") || {};
  const sidebar = evalSchemaPart("sidebar") || { enabled: false };
  return { general, columns, formConfig, sidebar };
};

const loadTableSchemaParts = async () => {
  const tableKey = getTableKey();
  if (!tableKey) return false;
  try {
    const result = await args.fns.executeYTOFunction("loadTableConfigByKey", { tableKey });
    const errorMessage = extractError(result, true, "Failed to load table schema");
    if (errorMessage) return false;
    applyServerGraphToLocalGraph(result);
    const partVertexIds = result?.result?.data?.partVertexIds;
    const ids = result?.result?.data?.ids;
    if (!partVertexIds || !ids) return false;
    patchPageP({
      tableSchemaPartVertexIds: partVertexIds,
      tableIds: ids,
      evaluatedConfig: null,
      memoizedConfig: null,
      settings: null
    });
    return true;
  } catch (error) {
    console.error("loadTableSchemaParts failed:", error);
    args.showErrorToast?.(error?.message || "Failed to load table schema");
    return false;
  }
};

const getPageMode = () => {
  const fromProps = args.contextData.props?.pageMode;
  if (fromProps === "settings" || fromProps === "table" || fromProps === "dashboard") return fromProps;
  const { config } = getCachedConfig();
  if (config?.pageMode === "settings") return "settings";
  if (config?.pageMode === "dashboard") return "dashboard";
  return "table";
};
const isSettingsPageMode = () => getPageMode() === "settings";
const getDefaultSettingsPageIdFromConfig = (config) => {
  if (!config || typeof config !== "object") return null;
  const groups = config.sidebar?.groups;
  if (Array.isArray(groups)) {
    for (let gi = 0; gi < groups.length; gi++) {
      const items = groups[gi]?.items;
      if (!Array.isArray(items)) continue;
      for (let ii = 0; ii < items.length; ii++) {
        const itemId = items[ii]?.id;
        if (itemId != null && String(itemId).trim() !== "") return String(itemId).trim();
      }
    }
  }
  if (config.id != null && String(config.id).trim() !== "") return String(config.id).trim();
  return null;
};
const getDefaultSettingsPageId = () => {
  const { config } = getCachedConfig();
  return getDefaultSettingsPageIdFromConfig(config);
};
// When false (e.g. VertexPicker modal), ignore URL query entirely and use local/page state.
const useUrlQueryParams = () => prop("useUrlQueryParams") !== false;

const getSettingsPageId = () => {
  const fromProps = args.contextData.props?.settingsPageId;
  if (fromProps != null && String(fromProps).trim() !== "") return String(fromProps).trim();
  if (useUrlQueryParams()) {
    const fromQuery = args.searchParams?.page;
    if (fromQuery != null && String(fromQuery).trim() !== "") return String(fromQuery).trim();
  }
  const fromState = pageP()?.settingsPageId;
  if (fromState != null && String(fromState).trim() !== "") return String(fromState).trim();
  return getDefaultSettingsPageId();
};
const getScopeConfig = () => {
  const { config } = getCachedConfig();
  return config?.scope || args.contextData.props?.scope || {
    vertexLabel: "User",
    idParam: "scopeId"
  };
};
const getScopeId = () => {
  const scopeConfig = getScopeConfig();
  const fromProps = args.contextData.props?.scopeId;
  if (fromProps != null && String(fromProps).trim() !== "") return String(fromProps).trim();
  if (useUrlQueryParams()) {
    const fromSearch = args.searchParams?.[scopeConfig.idParam || "scopeId"];
    if (fromSearch != null && String(fromSearch).trim() !== "") return String(fromSearch).trim();
  }
  return args.user?.P?.uuid || null;
};
const getConfigFunction = () => args.contextData.props?.configFunction;

// Helper to get cached config (and trigger memo evaluation if needed)
const getCachedConfig = () => {
  if (isTableSchemaMode()) {
    const partIds = getTableSchemaPartVertexIds();
    if (partIds) {
      return { config: buildTableRuntimeConfig(), loadFromSetting: true };
    }
    return { config: null, loadFromSetting: true };
  }
  const p = pageP();
  const cached = p?.memoizedConfig;
  if (cached !== null && cached !== undefined) {
    return { config: cached, loadFromSetting: p?.memoizedLoadFromSetting === true };
  }
  updateMemoizedConfig();
  const p2 = pageP();
  return { config: p2?.memoizedConfig ?? null, loadFromSetting: p2?.memoizedLoadFromSetting === true };
};

const ROOT_CONFIG_KEYS = new Set([
  "columns", "formConfig", "sidebar", "actions", "relationshipPropertyBindings",
  "nestedLinePropertyStripKeys", "uniqueKeys", "dashboardConfig", "pageMode",
  "sections", "saveStrategy", "audit", "id", "route", "title", "description",
  "version", "scope", "general"
]);

const getConfigGeneralValue = (key) => {
  if (isTableSchemaMode()) {
    const runtime = buildTableRuntimeConfig();
    if (runtime?.general && runtime.general[key] !== undefined) {
      return runtime.general[key];
    }
    return runtime?.[key];
  }
  const { config } = getCachedConfig();
  if (config?.general && config.general[key] !== undefined) {
    return config.general[key];
  }
  return config?.[key];
};

const getConfigHooks = () => getConfigGeneralValue("hooks");

const prop = (key, localProps) => {
  const fromLocalProps = localProps?.[key];
  if (fromLocalProps !== undefined) {
    return fromLocalProps;
  }
  const fromProps = args.contextData.props?.[key];
  if (fromProps !== undefined) {
    return fromProps;
  }
  const { config, loadFromSetting } = getCachedConfig();
  if (loadFromSetting) {
    if (ROOT_CONFIG_KEYS.has(key)) {
      if (key === "columns") return config?.columns;
      if (key === "formConfig") return config?.formConfig;
      if (key === "sidebar") return config?.sidebar;
      if (key === "actions") {
        if (Array.isArray(config?.actions)) return config.actions;
        return config?.general?.actions;
      }
      return config?.[key];
    }
    const general = config?.general;
    if (general && general[key] !== undefined) {
      return general[key];
    }
    return config?.[key];
  }
};

// Derive server payload from evaluated table config (merged from table_schema parts).
const collectFormConfigFields = (config) => {
  const groups = config?.formConfig?.groups;
  if (!Array.isArray(groups)) return [];
  const out = [];
  for (let gi = 0; gi < groups.length; gi++) {
    const fields = groups[gi]?.fields;
    if (!Array.isArray(fields)) continue;
    for (let fi = 0; fi < fields.length; fi++) out.push(fields[fi]);
  }
  return out;
};

const buildRelationshipPropertyBindings = (config) => {
  if (!config || typeof config !== "object") return [];
  const fields = collectFormConfigFields(config);
  const seen = new Set();
  const bindings = [];
  const addBinding = (prop, rel) => {
    if (!prop || !rel) return;
    const k = `${prop}\0${rel}`;
    if (seen.has(k)) return;
    seen.add(k);
    bindings.push({ prop, rel });
  };
  for (let i = 0; i < fields.length; i++) {
    const f = fields[i];
    if ((f?.dataType === "select" || f?.dataType === "relation") && f.selectConfig?.relationshipType && f.selectConfig?.edgeOnly === true) {
      addBinding(f.key, f.selectConfig.relationshipType);
    }
  }
  const cols = config.columns;
  if (Array.isArray(cols)) {
    for (let ci = 0; ci < cols.length; ci++) {
      const c = cols[ci];
      if (c?.dataType === "relation" && c.selectConfig?.relationshipType && c.selectConfig?.edgeOnly === true) {
        addBinding(c.key, c.selectConfig.relationshipType);
      }
    }
  }
  const extra = config.relationshipPropertyBindings;
  if (Array.isArray(extra)) {
    for (let j = 0; j < extra.length; j++) {
      const row = extra[j];
      addBinding(row?.prop, row?.rel);
    }
  }
  return bindings;
};

const buildNestedLinePropertyStripKeys = (config) => {
  if (!config || typeof config !== "object") return [];
  const fields = collectFormConfigFields(config);
  const keys = [];
  for (let i = 0; i < fields.length; i++) {
    const f = fields[i];
    if (f?.renderer === "nestedLineItems" && f.key) keys.push(String(f.key));
  }
  const extra = config.nestedLinePropertyStripKeys;
  if (Array.isArray(extra)) {
    for (let j = 0; j < extra.length; j++) {
      const k = extra[j];
      if (k != null && String(k) !== "" && !keys.includes(String(k))) keys.push(String(k));
    }
  }
  return keys;
};

// Common function to extract error message from response
// Returns error message string or null if no error
// Optionally shows toast notification if showToast is true
const extractError = (result, showToast = false, defaultMessage = null) => {
  if (!result) return defaultMessage;

  // Check top-level error
  if (result.error) {
    if (showToast) {
      args.showErrorToast?.(result.error);
    }
    return result.error;
  }

  // Check result-level error
  if (result.result?.error) {
    if (showToast) {
      args.showErrorToast?.(result.result.error);
    }
    return result.result.error;
  }

  // Check success: false with message
  if (result.result && result.result.success === false) {
    const errorMessage = result.result.message || result.result.error || defaultMessage;
    if (errorMessage && showToast) {
      args.showErrorToast?.(errorMessage);
    }
    return errorMessage;
  }

  return null;
};

const applyServerGraphToLocalGraph = (response) => {
  const graphPayload = response?.result?.graph ?? response?.graph;
  if (!graphPayload || typeof graphPayload !== "object") return;
  const vertexes = graphPayload.vertexes || {};
  const edges = graphPayload.edges || {};
  const deleted_vertexes = graphPayload.deleted_vertexes;
  const deleted_edges = graphPayload.deleted_edges;
  const hasWork =
    Object.keys(vertexes).length > 0 ||
    Object.keys(edges).length > 0 ||
    (Array.isArray(deleted_vertexes) && deleted_vertexes.length > 0) ||
    (Array.isArray(deleted_edges) && deleted_edges.length > 0);
  if (!hasWork) return;
  args.setGraphData(0, { vertexes, edges, deleted_vertexes, deleted_edges }, {});
};

// Functions invoked by "get*" which must be defined before their usages
const getGenericSettingsFunction = () => {
  const tableKey = getTableKey();
  const tableVertexLabel = getTableVertexLabel();
  if (isTableSchemaMode()) return null;
  if (!tableKey && !tableVertexLabel) return null;

  return async () => {
    try {
      const tableSettingsLabel = getTableSettingsLabel();
      const result = await args.fns.executeYTOFunction("getUserContentSetting", {
        tableVertexLabel: tableVertexLabel || tableKey,
        settingsLabel: tableSettingsLabel,
        key: `${tableSettingsLabel}_settings`
      });

      const errorMessage = extractError(result, true, "Failed to load settings");
      if (errorMessage) {
        return { success: false, data: { setting: null } };
      }

      if (result?.result?.success && result.result.data?.setting) {
        return result.result;
      }
    } catch (error) {
      console.error("Error loading settings:", error);
      args.showErrorToast?.(error?.message || "Failed to load settings");
    }
    return { success: false, data: { setting: null } };
  };
};

const getDashboardSettingKey = () => `${getTableSettingsLabel()}_dashboard`;

const getGenericDashboardSettingsFunction = () => {
  const tableVertexLabel = getTableVertexLabel();
  if (!tableVertexLabel) return null;
  return async () => {
    try {
      const tableSettingsLabel = getTableSettingsLabel();
      const result = await args.fns.executeYTOFunction("getUserContentSetting", {
        tableVertexLabel,
        settingsLabel: tableSettingsLabel,
        key: getDashboardSettingKey()
      });

      const errorMessage = extractError(result, true, "Failed to load dashboard config");
      if (errorMessage) {
        return { success: false, data: { setting: null } };
      }

      if (result?.result?.success && result.result.data?.setting) {
        return result.result;
      }
    } catch (error) {
      console.error("Error loading dashboard config:", error);
      args.showErrorToast?.(error?.message || "Failed to load dashboard config");
    }
    return { success: false, data: { setting: null } };
  };
};

const getGenericSettingsPageConfigFunction = () => {
  return async () => {
    const settingsPageId = getSettingsPageId();
    try {
      const result = await args.fns.executeYTOFunction("getSettingsPageConfig", {
        settingsPageId: settingsPageId || undefined,
        settingsLabel: settingsPageId || undefined
      });
      const errorMessage = extractError(result, true, "Failed to load settings page config");
      if (errorMessage) return { success: false, data: { setting: null } };
      if (result?.result?.success && result.result.data?.setting) return result.result;
    } catch (error) {
      console.error("Error loading settings page config:", error);
      args.showErrorToast?.(error?.message || "Failed to load settings page config");
    }
    return { success: false, data: { setting: null } };
  };
};
const getGenericDataFunction = () => {
  const tableVertexLabel = getTableVertexLabel();
  if (!tableVertexLabel) return null;
  return async (filters = {}) => {
    try {
      const sidebarItem = selectedSidebarItem();
      const sidebarConfig = getSidebarConfig();

      // Get config to check user scoping settings and hooks
      const { config } = getCachedConfig();
      const enableUserScopingForContent = getConfigGeneralValue("enableUserScopingForContent") === true;

      // Get config to check if local filters/sort are enabled
      const enableLocalFilters = getConfigGeneralValue("enableLocalFilters") === true;
      const enableLocalSort = getConfigGeneralValue("enableLocalSort") === true;

      // Build filter parameters
      // Skip filters/sort if local filtering/sorting is enabled
      const filterParams = {
        tableKey: getTableKey(),
        tableVertexLabel,
        search: enableLocalFilters ? undefined : filters.search,
        filters: enableLocalFilters ? undefined : filters.filters,
        sort: enableLocalSort ? undefined : filters.sort,
        enableUserScoping: enableUserScopingForContent,
        tableSettingsLabel: getTableSettingsLabel()
      };

      // Add sidebar filtering if item is selected
      if (sidebarItem && sidebarConfig) {
        const rootKeys = sidebarConfig.rootKeys || {};
        const rootKey = rootKeys.key;

        // If root key or synthetic uncategorized is selected, show items without any category relationship
        const uCat = getUncategorizedVertexId();
        if (
          sidebarItem.P?.key === rootKey ||
          (uCat && (sidebarItem.id === uCat || sidebarItem.P?.key === uCat))
        ) {
          filterParams.showUnassigned = true;
          filterParams.parentVertexLabel = sidebarConfig.parentVertexLabel;
          filterParams.toParentEdgeType = sidebarConfig.toParentEdgeType;
        } else {
          // Filter by selected category
          filterParams.categoryId = sidebarItem.id;
          filterParams.parentVertexLabel = sidebarConfig.parentVertexLabel;
          filterParams.toParentEdgeType = sidebarConfig.toParentEdgeType;
        }
      }

      // Pass hooks to server function - hooks will be executed server-side
      filterParams.hooks = getConfigHooks();
      filterParams.relationshipPropertyBindings = buildRelationshipPropertyBindings(config);

      const result = await args.fns.executeYTOFunction("getUserContent", filterParams);
      applyServerGraphToLocalGraph(result);

      // Check for errors and show toast
      const errorMessage = extractError(result, true, "Failed to load data");
      if (errorMessage) {
        return { data: [], relatedVertexIds: [] };
      }

      // Return successful result — only related vertex ids (full vertices live in args.graph after applyServerGraphToLocalGraph)
      if (result?.result?.success && result.result.data) {
        const data = Array.isArray(result.result.data) ? result.result.data : [];
        const relatedVerticesRaw = Array.isArray(result.result.relatedVertices) ? result.result.relatedVertices : [];
        const relatedVertexIds = relatedVerticesRaw
          .map((relatedVertex) => relatedVertex?.id)
          .filter((vertexId) => vertexId != null && vertexId !== "");
        return { data, relatedVertexIds };
      }

      return { data: [], relatedVertexIds: [] };
  } catch (error) {
    console.error("Error fetching data:", error);
    args.showErrorToast?.("Failed to load data");
    return { data: [], relatedVertexIds: [] };
  }
  };
};

// Background refresh: fetch only rows that are no longer queued (no loader, no full reload)
const refreshQueuedRows = async (elementIds) => {
  const tableVertexLabel = getTableVertexLabel();
  if (!tableVertexLabel || !Array.isArray(elementIds) || elementIds.length === 0) return { success: true, data: [] };
  try {
    const { config } = getCachedConfig();
    const result = await args.fns.executeYTOFunction("getUserContent", {
      tableVertexLabel,
      elementIds,
      onlyNotQueued: true,
      relationshipPropertyBindings: buildRelationshipPropertyBindings(config),
      tableSettingsLabel: getTableSettingsLabel()
    });
    applyServerGraphToLocalGraph(result);
    if (result?.result?.success && result.result.data) return { success: true, data: result.result.data };
  } catch (e) { console.error("refreshQueuedRows:", e); }
  return { success: true, data: [] };
};

// Ad-hoc fetch for another vertex label (e.g. nested line items). Skips sidebar/category scoping.
const fetchUserContentRows = async (params = {}) => {
  const { tableVertexLabel, search, filters, sort, hooks } = params;
  if (!tableVertexLabel) return [];
  const { config } = getCachedConfig();
  const enableUserScopingForContent = getConfigGeneralValue("enableUserScopingForContent") === true;
  try {
    const result = await args.fns.executeYTOFunction("getUserContent", {
      tableVertexLabel,
      search,
      filters,
      sort,
      enableUserScoping: enableUserScopingForContent,
      hooks: hooks !== undefined ? hooks : getConfigHooks(),
      relationshipPropertyBindings: buildRelationshipPropertyBindings(config),
      tableSettingsLabel: getTableSettingsLabel()
    });
    applyServerGraphToLocalGraph(result);
    const errorMessage = extractError(result, false, null);
    if (errorMessage) return [];
    if (result?.result?.success && Array.isArray(result.result.data)) {
      return result.result.data;
    }
  } catch (e) {
    console.error("fetchUserContentRows:", e);
  }
  return [];
};

// Helper function to get sidebar config (needed by updateSidebarCategoryCount)
// This is a simplified version that will be replaced by the full getSidebarConfig later
const getSidebarConfigForCount = () => {
  const { config, loadFromSetting } = getCachedConfig();
  if (loadFromSetting) {
    return config?.sidebar;
  }
  return args.contextData.props?.sidebar || config?.sidebar;
};

// Update sidebar category count after adding/deleting items
// Note: This uses getSidebarConfigForCount which will be replaced by getSidebarConfig
// when it's defined later. This ensures the function is available when getGenericSaveFunction is called.
const updateSidebarCategoryCount = (categoryId, increment = 1) => {
  if (!categoryId) return;

  const sidebarConfig = getSidebarConfigForCount();
  if (!sidebarConfig) return;

  const rootKeys = sidebarConfig.rootKeys || {};
  const rootKey = rootKeys.key;

  const uCat = getUncategorizedVertexId();
  if (categoryId === rootKey || (uCat && categoryId === uCat)) {
    if (uCat) {
      const uncategorizedVertex = args.graph?.vertexes?.[uCat];
      if (uncategorizedVertex) {
        const currentCount = uncategorizedVertex.P?.contentCount ?? 0;
        const newCount = Math.max(0, currentCount + increment);
        args.mergeVertexProperties(0, uCat, args.graph, args.setGraph, {
          contentCount: newCount
        });
      }
    }
    return;
  }

  // For regular categories, update the count directly
  const categoryVertex = args.graph?.vertexes?.[categoryId];
  if (categoryVertex) {
    const currentCount = categoryVertex.P?.contentCount ?? 0;
    const newCount = Math.max(0, currentCount + increment);
    args.mergeVertexProperties(0, categoryId, args.graph, args.setGraph, {
      contentCount: newCount
    });
  }
};

/** True if content id is listed in any TableUiState P.data (row not yet in table after upload→promote). */
const isContentInTableData = (contentId) => {
  if (contentId == null || contentId === "") return false;
  const cid = String(contentId);
  for (const vid in args.graph.vertexes) {
    const v = args.graph.vertexes[vid];
    if (!v?.L?.includes("TableUiState")) continue;
    const data = v.P?.data;
    if (Array.isArray(data) && data.includes(cid)) return true;
  }
  return false;
};

const collectTranslatableFieldKeys = (formConfig) => {
  const keys = [];
  const groups = formConfig?.groups;
  if (!Array.isArray(groups)) return keys;
  for (let gi = 0; gi < groups.length; gi++) {
    const fields = groups[gi]?.fields;
    if (!Array.isArray(fields)) continue;
    for (let fi = 0; fi < fields.length; fi++) {
      const field = fields[fi];
      if (field?.translatable === true && field?.key) keys.push(String(field.key));
    }
  }
  return keys;
};

const getGenericSaveFunction = () => {
  const tableVertexLabel = getTableVertexLabel();
  if (!tableVertexLabel) return null;
  return async ({ mode, data, originalRow }) => {
    const tableConfig = evaluateConfig();
    let uniqueKeys = tableConfig?.uniqueKeys || [];
    try {
      let apiData;
      if (mode === "delete") {
        if (originalRow && (originalRow.L || originalRow.id)) {
          apiData = {
            vertex: originalRow,
            relationships: {}
          };
        } else {
          apiData = {
            vertex: {
              id: originalRow?.id,
              L: originalRow?.L || [],
              P: originalRow?.P || originalRow || {},
              IN: originalRow?.IN || {},
              OUT: originalRow?.OUT || {}
            },
            relationships: {}
          };
        }
      } else {
        apiData = data;
      }

      const enableUserScopingForContent = tableConfig?.enableUserScopingForContent === true;

      const neoElementIdFromVertex = (v) => {
        if (!v || v.id == null || v.id === undefined) return undefined;
        const s = String(v.id).trim();
        return s.includes(":") ? s : undefined;
      };
      const isLocalVertexId = (id) => {
        if (id == null || id === undefined) return false;
        return String(id).trim().startsWith("-");
      };
      const effectiveElementIdFromVertex = (v) =>
        neoElementIdFromVertex(v) ??
        (v?.id != null && !isLocalVertexId(v.id) ? String(v.id).trim() : undefined);

      const resolvedMutateElementId =
        effectiveElementIdFromVertex(originalRow) ??
        effectiveElementIdFromVertex(apiData?.vertex);

      // Add modal after graphFileUpload: File already exists in Neo4j — update metadata, do not CREATE again.
      let operation =
        mode === "add" ? "create" : mode === "edit" ? "update" : "delete";
      if (operation === "create" && resolvedMutateElementId) {
        operation = "update";
      }

      const result = await args.fns.executeYTOFunction("mutateUserContent", {
        tableVertexLabel,
        tableSettingsLabel: getTableSettingsLabel(),
        operation,
        data: apiData,
        elementId: resolvedMutateElementId,
        uniqueKeys: uniqueKeys,
        enableUserScoping: enableUserScopingForContent,
        hooks: getConfigHooks(),
        nestedLinePropertyStripKeys: buildNestedLinePropertyStripKeys(tableConfig),
        translatableFieldKeys: collectTranslatableFieldKeys(tableConfig?.formConfig),
        siteLanguages: getSiteLanguages()
      });
      applyServerGraphToLocalGraph(result);

      const toContentIds = (...values) => {
        const out = [];
        for (let i = 0; i < values.length; i++) {
          const value = values[i];
          const list = Array.isArray(value) ? value : value != null ? [value] : [];
          for (let j = 0; j < list.length; j++) {
            const id = String(list[j] || "").trim();
            if (id && !id.startsWith("-") && !out.includes(id)) out.push(id);
          }
        }
        return out;
      };

      const contentIdsToAssign = toContentIds(
        apiData?.uploadedContentIds,
        result?.result?.data?.id,
        resolvedMutateElementId,
        effectiveElementIdFromVertex(apiData?.vertex)
      );
      const pendingSidebarIds = contentIdsToAssign.filter((id) => !isContentInTableData(id));

      if (
        mode !== "delete" &&
        result?.result?.success === true &&
        pendingSidebarIds.length > 0
      ) {
        const sidebarItem = selectedSidebarItem();
        const sidebarConfig = getSidebarConfig();
        if (sidebarItem && sidebarConfig?.toParentEdgeType) {
          const rootKey = sidebarConfig.rootKeys?.key;
          const uCatSave = getUncategorizedVertexId();
          const isUncatSave =
            uCatSave && (sidebarItem.id === uCatSave || sidebarItem.P?.key === uCatSave);

          if (sidebarItem.P?.key !== rootKey && !isUncatSave) {
            const enableUserScopingForSidebar =
              getConfigGeneralValue("enableUserScopingForSidebar") === true;
            const enableUserScopingForContent =
              getConfigGeneralValue("enableUserScopingForContent") === true;
            for (let ci = 0; ci < pendingSidebarIds.length; ci++) {
              try {
                const relResult = await args.fns.executeYTOFunction(
                  "createSidebarContentRelationship",
                  {
                    categoryId: sidebarItem.id,
                    contentId: pendingSidebarIds[ci],
                    relationshipType: sidebarConfig.toParentEdgeType,
                    categoryLabel: sidebarConfig.parentVertexLabel,
                    contentLabel: tableVertexLabel,
                    enableUserScopingForSidebar,
                    enableUserScopingForContent,
                    hooks: getConfigHooks()
                  }
                );
                applyServerGraphToLocalGraph(relResult);
                if (!extractError(relResult, false)) {
                  updateSidebarCategoryCount(sidebarItem.id, 1);
                }
              } catch (relError) {
                console.error("Error creating sidebar relationship:", relError);
              }
            }
          } else if (sidebarItem.P?.key === rootKey) {
            updateSidebarCategoryCount(rootKey, pendingSidebarIds.length);
          } else {
            const uKey = getUncategorizedVertexId();
            if (uKey) updateSidebarCategoryCount(uKey, pendingSidebarIds.length);
          }
        }
      }

      // If deleting an item, decrement the category count
      if (mode === "delete" && result?.result?.success && originalRow) {
        const sidebarItem = selectedSidebarItem();
        const sidebarConfig = getSidebarConfig();

        if (sidebarItem && sidebarConfig && sidebarConfig.toParentEdgeType) {
          const rootKeys = sidebarConfig.rootKeys || {};
          const rootKey = rootKeys.key;

          // Use the currently selected sidebar item to determine which category to decrement
          const uCatDel = getUncategorizedVertexId();
          const isUncatDel =
            uCatDel && (sidebarItem.id === uCatDel || sidebarItem.P?.key === uCatDel);
          if (sidebarItem.P?.key === rootKey) {
            updateSidebarCategoryCount(rootKey, -1);
          } else if (isUncatDel && uCatDel) {
            updateSidebarCategoryCount(uCatDel, -1);
          } else if (sidebarItem.id) {
            // Decrement the selected category's count
            updateSidebarCategoryCount(sidebarItem.id, -1);
          }
        }
      }

      // Check for errors (don't show toast here, let caller handle it)
      const errorMessage = extractError(result, false, "Failed to save");
      if (errorMessage) {
        return { success: false, message: errorMessage };
      }

      // Return successful result
      if (result?.result?.success) {
        return { success: true, data: result.result.data };
      }

      return { success: false, message: "Failed to save" };
    } catch (error) {
      console.error("Error saving:", error);
      return { success: false, message: error.message || "Failed to save" };
    }
  };
};
const getGenericSaveSettingsFunction = () => {
  if (isSettingsPageMode()) {
    return async (configText) => {
      try {
        const settingsPageId = getSettingsPageId();
        const result = await args.fns.executeYTOFunction("saveSettingsPageConfig", {
          settingsPageId,
          config: configText,
          saveAsDefault: true
        });
        const errorMessage = extractError(result, false, "Failed to save settings page config");
        if (errorMessage) {
          return { success: false, message: errorMessage };
        }
        if (result?.result?.success) {
          return {
            success: true,
            message: result.result.message || "Settings page config saved successfully"
          };
        }
        return { success: false, message: "Failed to save settings page config" };
      } catch (error) {
        console.error("Error saving settings page config:", error);
        return { success: false, message: error?.message || "Failed to save settings page config" };
      }
    };
  }
  const tableKey = getTableKey();
  const tableVertexLabel = getTableVertexLabel();
  if (!tableKey && !tableVertexLabel) return null;
  return async (configText) => {
    try {
      const tableSettingsLabel = getTableSettingsLabel();
      const result = await args.fns.executeYTOFunction("saveUserContentSetting", {
        tableVertexLabel: tableVertexLabel || tableKey,
        settingsLabel: tableSettingsLabel,
        key: `${tableSettingsLabel}_settings`,
        config: configText
      });

      // Check for errors (don't show toast here, let caller handle it)
      const errorMessage = extractError(result, false, "Failed to save settings");
      if (errorMessage) {
        return { success: false, message: errorMessage };
      }

      // Return successful result
      if (result?.result?.success) {
        return { success: true, message: result.result.message || "Settings saved successfully" };
      }

      return { success: false, message: "Failed to save settings" };
    } catch (error) {
      console.error("Error saving settings:", error);
      return { success: false, message: error?.message || "Failed to save settings" };
    }
  };
};
const getGenericImportFunction = () => {
  const tableVertexLabel = getTableVertexLabel();
  if (!tableVertexLabel) return null;
  return async ({ data }) => {
    try {
      // Get config to check user scoping settings and hooks
      const { config } = getCachedConfig();
      const enableUserScopingForContent = getConfigGeneralValue("enableUserScopingForContent") === true;

      const result = await args.fns.executeYTOFunction("importUserContent", {
        tableVertexLabel,
        data,
        enableUserScoping: enableUserScopingForContent,
        hooks: getConfigHooks(),
        tableSettingsLabel: getTableSettingsLabel()
      });

      // Check for errors (don't show toast here, let caller handle it)
      const errorMessage = extractError(result, false, "Failed to import data");
      if (errorMessage) {
        return { success: false, message: errorMessage };
      }

      // Return successful result
      if (result?.result?.success) {
        return { success: true, message: result.result.message };
      }

      return { success: false, message: "Failed to import data" };
    } catch (error) {
      console.error("Error importing data:", error);
      return { success: false, message: error.message || "Failed to import data" };
    }
  };
};
const getGenericExportFunction = () => {
  const tableVertexLabel = getTableVertexLabel();
  if (!tableVertexLabel) return null;
  return async ({ data, columns }) => {
    try {
      const sanitizedColumns = JSON.parse(JSON.stringify(columns));
      // Get config to check user scoping settings and hooks
      const { config } = getCachedConfig();
      const enableUserScopingForContent = getConfigGeneralValue("enableUserScopingForContent") === true;

      const result = await args.fns.executeYTOFunction("exportUserContent", {
        tableVertexLabel,
        format: "csv",
        data: data,
        columns: sanitizedColumns,
        enableUserScoping: enableUserScopingForContent,
        hooks: getConfigHooks(),
        relationshipPropertyBindings: buildRelationshipPropertyBindings(config),
        tableSettingsLabel: getTableSettingsLabel()
      });

      // Check for errors (don't show toast here, let caller handle it)
      const errorMessage = extractError(result, false, "Failed to export data");
      if (errorMessage) {
        return { success: false, message: errorMessage };
      }

      // Return successful result
      if (result?.result?.success) {
        return {
          success: true,
          data: result.result.data,
          tableVertexLabel: result.result.tableVertexLabel,
          filename: result.result.filename
        };
      }

      return { success: false, message: "Failed to export data" };
    } catch (error) {
      console.error("Error exporting data:", error);
      return { success: false, message: error.message || "Failed to export data" };
    }
  };
};

// Functions that may depend on previous definitions
const getDataFunction = () => {
  const { loadFromSetting } = getCachedConfig();
  if (loadFromSetting) {
    return getGenericDataFunction();
  }
  return prop('dataFunction');
};
const getSettingsFunction = () => {
  const loadFromSetting = getLoadFromSetting();
  if (loadFromSetting && isTableSchemaMode()) {
    return null;
  }
  if (loadFromSetting && isDashboardPageMode()) {
    return getGenericDashboardSettingsFunction();
  }
  if (loadFromSetting && isSettingsPageMode()) {
    return getGenericSettingsPageConfigFunction();
  }
  if (loadFromSetting) {
    return getGenericSettingsFunction();
  }
  return prop('settingsFunction');
};
const getFormConfig = () => {
  const formConfig = prop('formConfig');
  const { loadFromSetting } = getCachedConfig();
  if (loadFromSetting && formConfig && !formConfig.saveFunction) {
    // Add generic save function to formConfig when loadFromSetting is true
    return {
      ...formConfig,
      saveFunction: getGenericSaveFunction()
    };
  }
  return formConfig;
};
const getSaveSettingsFunction = () => {
  const loadFromSetting = getLoadFromSetting();
  if (loadFromSetting) {
    return getGenericSaveSettingsFunction();
  }
  return prop('saveSettingsFunction');
};
const getImportFunction = () => {
  const { loadFromSetting } = getCachedConfig();
  if (loadFromSetting) {
    return getGenericImportFunction();
  }
  return prop('importFunction');
};
const getExportFunction = () => {
  const { loadFromSetting } = getCachedConfig();
  if (loadFromSetting) {
    return getGenericExportFunction();
  }
  return prop('exportFunction');
};

// Core config evaluation and memo update functions
const hasEvaluatedConfigContent = (value) => {
  if (value == null || typeof value !== "object") return false;
  return Object.keys(value).length > 0;
};

const evaluateConfig = () => {
  if (isTableSchemaMode()) {
    const partIds = getTableSchemaPartVertexIds();
    if (!partIds) return null;
    return buildTableRuntimeConfig();
  }

  const cached = pageP()?.evaluatedConfig;
  if (hasEvaluatedConfigContent(cached)) return cached;

  const loadFromSetting = getLoadFromSetting();
  const currentSettings = pageP()?.settings;
  let config = null;

  // If loadFromSetting is true, only use settings (no props fallback)
  if (loadFromSetting) {
    if (currentSettings && typeof currentSettings === 'string') {
      try {
        const configFunction = new Function(currentSettings);
        config = configFunction();
        if (hasEvaluatedConfigContent(config)) {
          patchPageP({ evaluatedConfig: config });
          return config;
        }
      } catch (error) {
        console.error("Error evaluating settings function body:", error);
      }
    }
    return null;
  }

  // If settings exist and it's a string (function body), evaluate it
  if (currentSettings && typeof currentSettings === 'string') {
    try {
      const configFunction = new Function(currentSettings);
      const evaluated = configFunction();
      if (hasEvaluatedConfigContent(evaluated)) {
        patchPageP({ evaluatedConfig: evaluated });
        return evaluated;
      }
    } catch (error) {
      console.error("Error evaluating settings function body:", error);
    }
  }

  // Fallback to configFunction
  const configFn = getConfigFunction();
  if (configFn) {
    try {
      const evaluated = configFn();
      if (evaluated && typeof evaluated === 'object') {
        patchPageP({ evaluatedConfig: evaluated });
        return evaluated;
      }
    } catch (error) {
      console.error("Error evaluating config function:", error);
    }
  }

  // Fallback to props
  config = {
    columns: args.contextData.props?.columns || [],
    formConfig: args.contextData.props?.formConfig,
    uniqueKeys: [],
    hooks: args.contextData.props?.hooks,
    usePolarisUI: args.contextData.props?.usePolarisUI,
    enableUserScopingForSidebar: args.contextData.props?.enableUserScopingForSidebar,
    enableUserScopingForContent: args.contextData.props?.enableUserScopingForContent,
    enableLocalFilters: args.contextData.props?.enableLocalFilters,
    enableLocalSort: args.contextData.props?.enableLocalSort,
    sidebar: args.contextData.props?.sidebar
  };
  patchPageP({ evaluatedConfig: config });
  return config;
};
const updateMemoizedConfig = () => {
  const config = evaluateConfig();
  if (!hasEvaluatedConfigContent(config)) return;
  const loadFromSetting = getLoadFromSetting();
  patchPageP({ memoizedConfig: config, memoizedLoadFromSetting: loadFromSetting });
};

// Fetch data from server
const fetchData = async (searchTerm, columnFilters, sortConfig, callback) => {
  const dataFn = getDataFunction();
  if (!dataFn) return;

  // Capture the category item at the time of fetch
  const categoryItemForFetch = selectedSidebarItem();

  patchPageP({ loading: true });
  try {
    const result = await dataFn({
      search: searchTerm,
      filters: columnFilters,
      sort: sortConfig
    });
    if (result?.data) {
      const rowIds = Array.isArray(result.data)
        ? result.data
            .map((row) => (row?.id != null ? String(row.id).trim() : ""))
            .filter(Boolean)
        : [];
      patchPageP({ mainTableRowIds: rowIds });
      callback(result.data, categoryItemForFetch, result.relatedVertexIds || []);
    }
  } catch (error) {
    console.error("Error fetching table data:", error);
    args.showErrorToast?.("Failed to load table data");
  } finally {
    patchPageP({ loading: false });
  }
};


// Handle import
const handleImport = async (dataToImport, callback) => {
  const importFn = getImportFunction();
  if (!importFn) {
    args.showErrorToast?.("Import function not configured");
    return;
  }
  if (!dataToImport) {
    args.showErrorToast?.("Please provide data to import");
    return;
  }
  try {
    patchPageP({ loading: true });
    const result = await importFn({ data: dataToImport });
    if (result?.success) {
      args.showSuccessToast?.(result.message || "Import completed successfully");
      // Refresh data
      callback?.();
    } else {
      args.showErrorToast?.(result?.message || result?.error || "Failed to import data");
    }
  } catch (error) {
    console.error("Error importing:", error);
    args.showErrorToast?.(error?.message || "Failed to import data");
  } finally {
    patchPageP({ loading: false });
  }
};

// Handle export (all data)
const handleExport = async (data = null) => {
  const exportFn = getExportFunction();
  if (!exportFn) {
    args.showErrorToast?.("Export function not configured");
    return;
  }
  try {
    patchPageP({ loading: true });
    const columns = prop('columns');
    const sanitizedColumns = JSON.parse(JSON.stringify(columns));
    const result = await exportFn({ data, columns: sanitizedColumns }); // null means export all data
    if (result?.success && result?.data) {
      // Fix line endings: replace '\n' with real newlines for CSV/text exports
      let exportData = result.data;
      if (
        typeof exportData === "string" &&
        (result.contentType === "text/csv" || result.contentType === "text/plain" || !result.contentType)
      ) {
        exportData = exportData.replace(/\\n/g, "\n");
      }
      const blob = new Blob([exportData], { type: result.contentType || "text/csv" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = result.filename || "export.csv";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      args.showSuccessToast?.("Export completed successfully");
    } else {
      args.showErrorToast?.(result?.message || "Failed to export data");
    }
  } catch (error) {
    console.error("Error exporting:", error);
    args.showErrorToast?.("Failed to export data");
  } finally {
    patchPageP({ loading: false });
  }
};

// Settings management functions

// Load settings - accepts options: { updateState: boolean } (default true)
// When updateState: false, fetches config without updating state and returns config text
const loadSettings = async (options = {}) => {
  const updateState = options.updateState !== false;
  const settingsFn = getSettingsFunction();
  if (!settingsFn) return null;
  try {
    const result = await settingsFn();

    // Handle error cases (result from settingsFn is already processed, check success flag)
    if (result && result.success === false) {
      if (result.message) {
        args.showErrorToast?.(result.message);
      }
      return null;
    }

    if (result?.success && result?.data?.setting) {
      const settingData = result.data.setting.P || {};
      // Get the raw config text (function body) - don't evaluate it
      const configText = settingData.config;
      if (typeof configText === 'string') {
        if (updateState) {
          patchPageP({ settings: configText, evaluatedConfig: null, memoizedConfig: null });
        }
        return configText;
      }
    }
  } catch (error) {
    console.error("Error loading settings:", error);
    args.showErrorToast?.(error?.message || "Failed to load settings");
  }
  return null;
};

// Initialize settings on mount
const initializeSettings = async () => {
  restorePageResizeFromLocalStorage();
  patchPageP({ configLoading: true });
  try {
    if (isTableSchemaMode()) {
      await loadTableSchemaParts();
    } else {
      const settingsFn = getSettingsFunction();
      if (settingsFn) {
        await loadSettings();
        updateMemoizedConfig();
      } else {
        updateMemoizedConfig();
      }
    }
    restoreCompanionMainRatio();
  } catch (error) {
    console.error("[DynamicPage] initializeSettings error:", error);
  } finally {
    patchPageP({ configLoading: false });
    restoreCompanionMainRatio();
  }
};

// Handle opening settings modal — TableFormConfigSchemaEditor loads schema itself.
const handleOpenSettings = async () => {
  patchPageP({ isSettingsModalOpen: true });
};

// Handle saving settings
const handleSaveSettings = async (configText, callback) => {
  const saveFn = getSaveSettingsFunction();
  if (!saveFn) {
    args.showErrorToast?.("Save settings function not configured");
    return;
  }
  try {
    patchPageP({ loading: true });
    // Save the raw function body text, not the evaluated config
    const result = await saveFn(configText);
    if (result?.success) {
      args.showSuccessToast?.(result.message || "Settings saved successfully");
      patchPageP({
        isSettingsModalOpen: false,
        settings: configText,
        evaluatedConfig: null,
        memoizedConfig: null
      });
      // Reload data to apply new settings
      callback?.();
    } else {
      args.showErrorToast?.(result?.message || "Failed to save settings");
    }
  } catch (error) {
    console.error("Error saving settings:", error);
    args.showErrorToast?.("Failed to save settings");
  } finally {
    patchPageP({ loading: false });
  }
};

// Sidebar config
const getSidebarConfig = () => {
  if (isTableSchemaMode()) {
    return evalSchemaPart("sidebar") || { enabled: false };
  }
  const { config, loadFromSetting } = getCachedConfig();
  if (loadFromSetting) {
    return config?.sidebar;
  }
  return args.contextData.props?.sidebar || config?.sidebar;
};

// Check if sidebar is enabled
const hasSidebar = () => {
  const sidebarConfig = getSidebarConfig();
  return sidebarConfig && (sidebarConfig.enabled !== false);
};

// Check if Polaris UI should be used (table-level config)
const getUsePolarisUI = () => {
  const { config } = getCachedConfig();
  return getConfigGeneralValue("usePolarisUI") === true;
};

// Get category key for selected rows storage
const getCategoryKey = (item) => {
  const sidebarConfig = getSidebarConfig();
  if (!item) {
    // No sidebar or no item selected - use 'no-sidebar' key
    return sidebarConfig ? null : 'no-sidebar';
  }
  if (!sidebarConfig) {
    return 'no-sidebar';
  }
  const rootKeys = sidebarConfig.rootKeys || {};
  const rootKey = rootKeys.key;

  const uCatKey = getUncategorizedVertexId();
  if (
    item.P?.key === rootKey ||
    (uCatKey && (item.id === uCatKey || item.P?.key === uCatKey))
  ) {
    return uCatKey ?? '__unassigned__';
  }
  return item.id || 'no-sidebar';
};

// Get selected rows for current category
const getSelectedRows = () => {
  const item = selectedSidebarItem();
  const categoryKey = getCategoryKey(item);
  if (categoryKey === null) return new Set();
  const raw = pageP()?.selectedRowsByCategory?.[categoryKey];
  if (!raw) return new Set();
  return new Set(Array.isArray(raw) ? raw : []);
};

// Set selected rows for current category
const setSelectedRows = (newSelected) => {
  const item = selectedSidebarItem();
  const categoryKey = getCategoryKey(item);
  if (categoryKey === null) return;
  const next = { ...(pageP()?.selectedRowsByCategory ?? {}) };
  next[categoryKey] = Array.from(newSelected);
  patchPageP({ selectedRowsByCategory: next });
};

// Clear selected rows for current category
const clearSelectedRows = () => {
  setSelectedRows(new Set());
};

// Handle sidebar item selection
const handleSidebarItemSelect = (item) => {
  patchPageP({ selectedSidebarCategoryId: item?.id ?? null });

  // Persist selected category in URL (modals set useUrlQueryParams: false).
  if (useUrlQueryParams() && item?.id != null && args.setSearchParams) {
    const current = args.searchParams || {};
    args.setSearchParams({ ...current, sidebarCategory: item.id }, { replace: true });
  }

  // Opt-in: treat sidebar category click as the picker selection value.
  if (args.contextData.props?.allowSidebarSelection === true && item?.id) {
    const onSidebarItemSelect = prop("onSidebarItemSelect");
    if (typeof onSidebarItemSelect === "function") {
      onSidebarItemSelect(item, args);
    }
    const onSelectionChange = getOnSelectionChange();
    if (typeof onSelectionChange === "function") {
      onSelectionChange(new Set([String(item.id)]), [{ id: item.id, vertex: item }], args);
    }
  }
};

// Handle moving items to category
const handleMoveItemsToCategory = async (contentIds, categoryId, sidebarConfig) => {
  const tableVertexLabel = getTableVertexLabel();
  if (!tableVertexLabel || !sidebarConfig) {
    return { success: false, message: "Missing configuration" };
  }

  const { config } = getCachedConfig();
            const enableUserScopingForSidebar = getConfigGeneralValue("enableUserScopingForSidebar") === true;
            const enableUserScopingForContent = getConfigGeneralValue("enableUserScopingForContent") === true;

  const relationshipType = tableVertexLabel ? `User${tableVertexLabel}` : null;

  try {
    patchPageP({ loading: true });
    const uCatMove = getUncategorizedVertexId();
    const uncategorizedSlot = uCatMove ?? '__unassigned__';
    const currentSelected = selectedSidebarItem();
    const sourceCategoryId = currentSelected?.id ?? null;

    const normalizeCategoryId = (id) =>
      id === null || id === undefined || (uCatMove != null && id === uCatMove)
        ? uncategorizedSlot
        : id;
    if (normalizeCategoryId(sourceCategoryId) === normalizeCategoryId(categoryId)) {
      const label = prop('label') || 'Item';
      const plural = label.endsWith('y') ? label.slice(0, -1) + 'ies' : label + (label.endsWith('s') ? '' : 's');
      const msg = `${plural} are already in this category`;
      args.showWarningToast?.(msg);
      return { success: false, message: msg };
    }

    const contentLabelDisplay = prop('label') || 'Item';
    const contextData = {
      contentIds: contentIds,
      categoryId: categoryId,
      relationshipType: sidebarConfig.toParentEdgeType,
      categoryLabel: sidebarConfig.parentVertexLabel,
      contentLabel: tableVertexLabel,
      contentLabelDisplay: contentLabelDisplay,
      enableUserScopingForSidebar: enableUserScopingForSidebar,
      enableUserScopingForContent: enableUserScopingForContent,
      sourceCategoryId: sourceCategoryId,
      hooks: getConfigHooks()
    };

    const result = await args.executeNamedServerFunction({
      functionName: "moveItemsToCategory",
      contextData: contextData
    });

    // Check for errors and show toast
    const errorMessage = extractError(result, true, "Failed to move items");
    if (errorMessage) {
      return { success: false, message: errorMessage };
    }

    // Clear table selection after move (moved items are gone from current view; avoids stale selection and draggable issues)
    clearSelectedRows();

    // Trigger table to remove moved rows (parent state, Table reacts - no reload needed)
    if (result?.result?.success && contentIds?.length) {
      const removeSet = new Set(contentIds.map((id) => String(id)));
      const nextMainIds = (Array.isArray(pageP()?.mainTableRowIds) ? pageP().mainTableRowIds : [])
        .map((id) => String(id))
        .filter((id) => !removeSet.has(id));
      patchPageP({
        rowsToRemoveVertexIds: contentIds,
        mainTableRowIds: nextMainIds
      });
    }

    // Process graph data if available
    if (result?.result?.success && result.result.data) {
      if (result.graph && result.graph.vertexes) {
        args.setGraphData(0, result.graph, {});
      }
    }

    return result?.result || { success: false, message: "Failed to move items" };
  } catch (error) {
    console.error("Error moving items:", error);
    const errorMessage = error.message || "Failed to move items";
    args.showErrorToast?.(errorMessage);
    return { success: false, message: errorMessage };
  } finally {
    patchPageP({ loading: false });
  }
};


const getShowSelection = () => {
  const value = prop("showSelection");
  return value === true;
};

const getSelectionMode = () => {
  const value = prop("selectionMode");
  return value === "single" ? "single" : "multiple";
};

const getOnSelectionChange = () => prop("onSelectionChange");

const getInitialSelectedRowIds = () => {
  const value = prop("initialSelectedRowIds");
  return Array.isArray(value) ? value : undefined;
};

const getCompanionPages = () => {
  if (args.contextData.props?.disableCompanionPages === true) return [];
  const pageMode = args.contextData.props?.pageMode || getPageMode?.();
  if (pageMode === "settings" || pageMode === "dashboard") return [];
  const fromProps = prop("companionPages");
  if (Array.isArray(fromProps) && fromProps.length > 0) return fromProps;
  const fromGeneral = getConfigGeneralValue("companionPages");
  return Array.isArray(fromGeneral) ? fromGeneral : [];
};

const hasCompanionPages = () => getCompanionPages().length > 0;

const COMPANION_SPLIT_TRACK_PX = 6;
const MIN_COMPANION_MAIN_HEIGHT = 160;
const MIN_COMPANION_PANE_HEIGHT = 180;
const DEFAULT_COMPANION_MAIN_RATIO = 0.58;

const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

const getCompanionAvailableHeight = () => {
  const shellEl = primaryPaneRef?.parentElement;
  if (!shellEl) return null;
  const available =
    shellEl.getBoundingClientRect().height - COMPANION_SPLIT_TRACK_PX;
  return available > MIN_COMPANION_MAIN_HEIGHT + MIN_COMPANION_PANE_HEIGHT
    ? available
    : null;
};

const getCompanionMinRatio = (available) => MIN_COMPANION_MAIN_HEIGHT / available;
const getCompanionMaxRatio = (available) =>
  (available - MIN_COMPANION_PANE_HEIGHT) / available;

const clampCompanionRatio = (ratio, available) =>
  clamp(ratio, getCompanionMinRatio(available), getCompanionMaxRatio(available));

const parseCompanionRatio = (ratio) =>
  Number.isFinite(ratio) ? ratio : DEFAULT_COMPANION_MAIN_RATIO;

const getCompanionMainHeight = () => {
  const height = pageP()?.companionMainHeight;
  return typeof height === "number" && height > 0 ? height : null;
};

const getCompanionPaneHeight = () => {
  const height = pageP()?.companionPaneHeight;
  return typeof height === "number" && height > 0 ? height : null;
};

const getCompanionSplitGridRows = () => {
  if (!hasCompanionPages()) return null;
  const track = `${COMPANION_SPLIT_TRACK_PX}px`;
  const mainHeight = getCompanionMainHeight();
  const paneHeight = getCompanionPaneHeight();
  if (mainHeight != null && paneHeight != null) {
    return `${mainHeight}px ${track} ${paneHeight}px`;
  }
  if (mainHeight != null) {
    return `${mainHeight}px ${track} minmax(${MIN_COMPANION_PANE_HEIGHT}px, 1fr)`;
  }
  if (paneHeight != null) {
    return `minmax(${MIN_COMPANION_MAIN_HEIGHT}px, 1fr) ${track} ${paneHeight}px`;
  }
  return `minmax(${MIN_COMPANION_MAIN_HEIGHT}px, 58fr) ${track} minmax(${MIN_COMPANION_PANE_HEIGHT}px, 42fr)`;
};

const setCompanionMainHeight = (height) => {
  const next = Math.round(Number(height) || 0);
  if (next <= 0) return;
  patchPageP({ companionMainHeight: next, companionPaneHeight: null });
};

const setCompanionPaneHeight = (height) => {
  const next = Math.round(Number(height) || 0);
  if (next <= 0) return;
  patchPageP({ companionPaneHeight: next, companionMainHeight: null });
};

const [companionResizeActive, setCompanionResizeActive] = args.createSignal(false);
let primaryPaneRef = null;

const applyCompanionMainRatio = (ratio) => {
  const available = getCompanionAvailableHeight();
  if (available == null) return null;
  const clampedRatio = clampCompanionRatio(parseCompanionRatio(ratio), available);
  const mainHeight = Math.round(available * clampedRatio);
  patchPageP({ companionMainHeight: mainHeight, companionPaneHeight: null });
  return clampedRatio;
};

const persistCompanionMainRatio = (ratio) => {
  const appliedRatio =
    ratio != null && Number.isFinite(ratio)
      ? applyCompanionMainRatio(ratio)
      : (() => {
          const available = getCompanionAvailableHeight();
          const mainHeight = getCompanionMainHeight();
          if (available == null || mainHeight == null) return null;
          return applyCompanionMainRatio(mainHeight / available);
        })();
  if (appliedRatio == null) return;
  persistPageResize({ companionMainRatio: appliedRatio });
};

const restoreCompanionMainRatio = () => {
  if (!hasCompanionPages()) return;
  if (pendingCompanionMainRatio == null || !Number.isFinite(pendingCompanionMainRatio)) {
    return;
  }
  if (applyCompanionMainRatio(pendingCompanionMainRatio) != null) {
    pendingCompanionMainRatio = null;
  }
};

const setPrimaryPaneRef = (el) => {
  primaryPaneRef = el || null;
  restoreCompanionMainRatio();
};

const handleCompanionSplitResize = (e) => {
  if (!hasCompanionPages()) return;
  e.preventDefault();
  e.stopPropagation();

  const primaryEl = primaryPaneRef;
  const shellEl = primaryEl?.parentElement;
  if (!primaryEl || !shellEl) return;

  const startY = e.clientY;
  const startMainHeight = primaryEl.getBoundingClientRect().height;
  const shellHeight = shellEl.getBoundingClientRect().height;
  const maxMainHeight = shellHeight - MIN_COMPANION_PANE_HEIGHT - COMPANION_SPLIT_TRACK_PX;

  setCompanionResizeActive(true);
  document.body.style.cursor = "row-resize";
  document.body.style.userSelect = "none";

  const handleMove = (moveEvent) => {
    const deltaY = moveEvent.clientY - startY;
    let nextMain = startMainHeight + deltaY;
    nextMain = Math.max(MIN_COMPANION_MAIN_HEIGHT, nextMain);
    nextMain = Math.min(maxMainHeight, nextMain);
    setCompanionMainHeight(nextMain);
  };

  const handleUp = () => {
    setCompanionResizeActive(false);
    document.body.style.cursor = "";
    document.body.style.userSelect = "";
    document.removeEventListener("pointermove", handleMove);
    document.removeEventListener("pointerup", handleUp);
    document.removeEventListener("pointercancel", handleUp);
    persistCompanionMainRatio();
  };

  document.addEventListener("pointermove", handleMove);
  document.addEventListener("pointerup", handleUp);
  document.addEventListener("pointercancel", handleUp);
};

const getTablePassthroughProps = () => {
  const passthrough = {};
  const showSelectionValue = prop("showSelection");
  if (showSelectionValue !== undefined) {
    passthrough.showSelection = showSelectionValue === true;
  }
  const selectionModeValue = prop("selectionMode");
  if (selectionModeValue === "single" || selectionModeValue === "multiple") {
    passthrough.selectionMode = selectionModeValue;
  }
  const onSelectionChange = getOnSelectionChange();
  if (typeof onSelectionChange === "function") {
    passthrough.onSelectionChange = onSelectionChange;
  }
  const initialSelectedRowIds = getInitialSelectedRowIds();
  if (Array.isArray(initialSelectedRowIds)) {
    passthrough.initialSelectedRowIds = initialSelectedRowIds;
  }
  const onRowClick = prop("onRowClick");
  if (typeof onRowClick === "function") {
    passthrough.onRowClick = onRowClick;
  }
  // Explicit false must win over general.rowClickable from settings (embedded pickers).
  const rowClickableValue = prop("rowClickable");
  if (rowClickableValue !== undefined) {
    passthrough.rowClickable = rowClickableValue === true;
  }
  const hidePageChromeValue = prop("hidePageChrome");
  if (hidePageChromeValue !== undefined) {
    passthrough.hidePageChrome = hidePageChromeValue === true;
  }
  const actionHandlers = prop("actionHandlers");
  if (actionHandlers && typeof actionHandlers === "object") {
    passthrough.actionHandlers = actionHandlers;
  }
  // Embedded/modal DynamicPage: keep table search/filters/sort in local state only.
  if (prop("useUrlQueryParams") === false) {
    passthrough.useUrlQueryParams = false;
  }
  // Fill parent height (companions, pickers, portal split panes) instead of 100vh.
  if (prop("embeddedMode") === true || hasCompanionPages()) {
    passthrough.embeddedMode = true;
  }
  const dropCreateFrom = getDropCreateFromConfig();
  if (dropCreateFrom && dropCreateFrom.enabled !== false) {
    passthrough.dropCreateFrom = dropCreateFrom;
    passthrough.onDropCreateFrom = handleTableDropCreateFrom;
  }
  passthrough.sourceTableVertexLabel = getTableVertexLabel();
  passthrough.sourceTableKey = getTableKey();
  return passthrough;
};

// --- Settings Page Mode: orchestration, adapter, dirty tracking ---

const getSettingsSidebarConfig = () => {
  const config = evaluateConfig();
  return config?.sidebar || null;
};

const getSaveStrategy = () => {
  const config = evaluateConfig();
  return config?.saveStrategy || { mode: "section", showSaveBar: true, warnOnLeave: true };
};

const isSettingsLoading = () => pageP()?.settingsLoading === true;

const getSectionStateMap = () => pageP()?.settingsSectionStateMap || {};

const getSectionState = (sectionId) => {
  if (!sectionId) return null;
  return getSectionStateMap()[sectionId] || null;
};

const patchSectionStateMap = (sectionId, sectionState) => {
  const currentMap = { ...getSectionStateMap() };
  currentMap[sectionId] = sectionState;
  patchPageP({ settingsSectionStateMap: currentMap });
};

const getDirtySectionIds = () => {
  const dirtyIds = pageP()?.settingsDirtySectionIds;
  return Array.isArray(dirtyIds) ? dirtyIds : [];
};

const markSectionDirty = (sectionId) => {
  if (!sectionId) return;
  const current = getDirtySectionIds();
  if (current.includes(sectionId)) return;
  patchPageP({ settingsDirtySectionIds: [...current, sectionId] });
};

const markSectionClean = (sectionId, newValues, meta) => {
  if (!sectionId) return;
  const current = getDirtySectionIds().filter((id) => id !== sectionId);
  patchPageP({ settingsDirtySectionIds: current });
  const existingState = getSectionState(sectionId) || {};
  patchSectionStateMap(sectionId, {
    ...existingState,
    values: newValues != null ? newValues : existingState.values,
    initialValues: newValues != null ? { ...newValues } : existingState.initialValues,
    version: meta?.version != null ? Number(meta.version) : existingState.version ?? 0,
    documentId: meta?.documentId != null ? meta.documentId : existingState.documentId ?? null
  });
};

const dirtyTracker = {
  hasDirty: () => getDirtySectionIds().length > 0,
  getDirtySectionIds,
  registerSection: (sectionId) => sectionId,
  markDirty: markSectionDirty,
  markClean: markSectionClean
};

const registerSectionFormFns = (sectionId, formFns) => {
  const currentMap = { ...(pageP()?.settingsFormFnsMap || {}) };
  currentMap[sectionId] = formFns;
  patchPageP({ settingsFormFnsMap: currentMap });
};

const settingsAdapter = {
  loadPage: async () => {
    const config = evaluateConfig();
    const settingsPageId = getSettingsPageId();
    const scopeConfig = getScopeConfig();
    const scopeId = getScopeId();
    if (!settingsPageId) return { success: false, message: "Missing settingsPageId" };

    patchPageP({ settingsLoading: true });
    try {
      const result = await args.fns.executeYTOFunction("loadSettingsPage", {
        pageId: settingsPageId,
        scopeVertexLabel: scopeConfig.vertexLabel,
        scopeId,
        scopeMatchProperty: scopeConfig.matchProperty,
        sections: config?.sections || []
      });

      const errorMessage = extractError(result, true, "Failed to load settings");
      if (errorMessage) return { success: false, message: errorMessage };

      if (result?.result?.success) {
        const sectionsData = result.result.data?.sections || {};
        const stateMap = {};
        for (const sectionId in sectionsData) {
          const sectionData = sectionsData[sectionId];
          stateMap[sectionId] = {
            values: sectionData.values || {},
            initialValues: { ...(sectionData.values || {}) },
            version: sectionData.version ?? 0,
            documentId: sectionData.documentId ?? null
          };
        }
        patchPageP({ settingsSectionStateMap: stateMap, settingsDirtySectionIds: [] });
        return { success: true, data: sectionsData };
      }
    } catch (error) {
      console.error("settingsAdapter.loadPage:", error);
      args.showErrorToast?.(error?.message || "Failed to load settings");
    } finally {
      patchPageP({ settingsLoading: false });
    }
    return { success: false, message: "Failed to load settings" };
  },

  saveSection: async ({ sectionId, sectionConfig, values, version }) => {
    const settingsPageId = getSettingsPageId();
    const scopeConfig = getScopeConfig();
    const scopeId = getScopeId();
    const pageConfig = evaluateConfig();

    if (String(settingsPageId || "").startsWith("table:")) {
      const tableKey = getTableKey() || String(settingsPageId).slice("table:".length).trim();
      const result = await args.fns.executeYTOFunction("saveTableConfigSection", {
        tableKey,
        sectionId,
        values,
        version,
        sectionConfig,
        pageConfig
      });
      const errorMessage = extractError(result, false, "Failed to save table section");
      if (errorMessage) {
        args.showErrorToast?.(errorMessage);
        return { success: false, message: errorMessage };
      }
      if (result?.result?.success) {
        args.showSuccessToast?.(result.result.message || "Table section saved");
        markSectionClean(sectionId, result.result.data?.values, {
          version: result.result.data?.version,
          documentId: result.result.data?.documentId
        });
        patchPageP({ evaluatedConfig: null, memoizedConfig: null });
        if (isTableSchemaMode()) {
          await loadTableSchemaParts();
        } else {
          await args.fns.initializeSettings?.();
        }
        return result.result;
      }
      return { success: false, message: "Failed to save table section" };
    }

    const result = await args.fns.executeYTOFunction("saveSettingsSection", {
      pageId: settingsPageId,
      sectionId,
      values,
      version,
      scopeVertexLabel: scopeConfig.vertexLabel,
      scopeId,
      scopeMatchProperty: scopeConfig.matchProperty,
      sectionConfig,
      pageConfig,
      auditEnabled: pageConfig?.audit?.enabled !== false
    });

    const errorMessage = extractError(result, false, "Failed to save settings");
    if (errorMessage) {
      args.showErrorToast?.(errorMessage);
      return { success: false, message: errorMessage };
    }

    if (result?.result?.success) {
      args.showSuccessToast?.(result.result.message || "Settings saved");
      markSectionClean(sectionId, result.result.data?.values, {
        version: result.result.data?.version,
        documentId: result.result.data?.documentId
      });
      if (typeof window !== "undefined") {
        window.dispatchEvent(new CustomEvent("fulchand-settings-saved", {
          detail: { pageId: settingsPageId, sectionId }
        }));
      }
      return result.result;
    }
    return { success: false, message: "Failed to save settings" };
  },

  resetSection: async ({ sectionId, sectionConfig }) => {
    const settingsPageId = getSettingsPageId();
    const scopeConfig = getScopeConfig();
    const scopeId = getScopeId();

    const result = await args.fns.executeYTOFunction("resetSettingsSection", {
      pageId: settingsPageId,
      sectionId,
      scopeVertexLabel: scopeConfig.vertexLabel,
      scopeId,
      scopeMatchProperty: scopeConfig.matchProperty,
      sectionConfig,
      deleteDocument: false
    });

    if (result?.result?.success) {
      markSectionClean(sectionId, result.result.data?.values, {
        version: result.result.data?.version,
        documentId: result.result.data?.documentId
      });
      args.showSuccessToast?.(result.result.message || "Settings reset");
    }
    return result?.result || { success: false };
  }
};

const saveSettingsSection = async (payload) => settingsAdapter.saveSection(payload);

const loadSettingsPageData = async () => settingsAdapter.loadPage();

const handleSaveAllDirtySections = async () => {
  const dirtySectionIds = getDirtySectionIds();
  const config = evaluateConfig();
  const sections = config?.sections || [];
  const formFnsMap = pageP()?.settingsFormFnsMap || {};

  for (let index = 0; index < dirtySectionIds.length; index++) {
    const sectionId = dirtySectionIds[index];
    const sectionConfig = sections.find((section) => section.id === sectionId);
    const formFns = formFnsMap[sectionId];
    if (formFns && typeof formFns.handleSave === "function") {
      await formFns.handleSave();
    } else {
      const sectionState = getSectionState(sectionId);
      await settingsAdapter.saveSection({
        sectionId,
        sectionConfig,
        values: sectionState?.values || {},
        version: sectionState?.version ?? 0
      });
    }
  }
};

const handleDiscardChanges = async () => {
  await loadSettingsPageData();
  args.showSuccessToast?.("Changes discarded");
};

const initializeSettingsPage = async () => {
  if (pageP()?.settingsInitializing === true) return;
  patchPageP({ configLoading: true, settingsInitializing: true });
  try {
    const settingsFn = getSettingsFunction();
    if (settingsFn) {
      await loadSettings();
      updateMemoizedConfig();
    }
    ensureSettingsPageQueryParam();
    const settingsPageId = getSettingsPageId();
    if (settingsPageId && pageP()?.settingsPageId !== settingsPageId) {
      patchPageP({ settingsPageId });
    }
    syncSiteLanguagesFromProps();
    await loadSettingsPageData();
  } finally {
    patchPageP({ configLoading: false, settingsInitializing: false });
  }
};

const syncSiteLanguagesFromProps = () => {
  const fromProps = args.contextData.props?.siteLanguages;
  if (!Array.isArray(fromProps) || fromProps.length === 0) return;
  const cached = pageP()?.siteLanguages;
  if (JSON.stringify(cached) === JSON.stringify(fromProps)) return;
  patchPageP({ siteLanguages: fromProps });
};

const getSiteLanguages = () => {
  const fromProps = args.contextData.props?.siteLanguages;
  if (Array.isArray(fromProps) && fromProps.length > 0) return fromProps;
  const cached = pageP()?.siteLanguages;
  if (Array.isArray(cached) && cached.length > 0) return cached;
  return [
    { code: "en", label: "English", isDefault: true },
    { code: "hi", label: "Hindi", isDefault: false },
    { code: "gu", label: "Gujarati", isDefault: false }
  ];
};

args.createEffect(() => {
  syncSiteLanguagesFromProps();
});

const ensureSettingsPageQueryParam = () => {
  if (!useUrlQueryParams()) return;
  const fromProps = args.contextData.props?.settingsPageId;
  if (fromProps != null && String(fromProps).trim() !== "") return;
  const fromQuery = args.searchParams?.page;
  if (fromQuery != null && String(fromQuery).trim() !== "") return;
  const defaultId = getDefaultSettingsPageId();
  if (defaultId) {
    args.setSearchParams({ page: defaultId }, { replace: true });
  }
};

const resetSettingsPageData = () => {
  patchPageP({
    settings: null,
    evaluatedConfig: null,
    memoizedConfig: null,
    tableSchemaPartVertexIds: null,
    tableIds: null,
    settingsSectionStateMap: {},
    settingsDirtySectionIds: [],
    settingsFormFnsMap: {}
  });
};

args.createEffect(() => {
  if (typeof window === "undefined") return;
  const handleTableSchemaSaved = (event) => {
    const savedTableKey = event?.detail?.tableKey;
    if (!savedTableKey || savedTableKey !== getTableKey()) return;
    if (!isTableSchemaMode()) return;
    void loadTableSchemaParts();
  };
  window.addEventListener("fulchand-table-schema-saved", handleTableSchemaSaved);
  return () => window.removeEventListener("fulchand-table-schema-saved", handleTableSchemaSaved);
});

args.createEffect(() => {
  if (!isSettingsPageMode()) return;
  getCachedConfig();

  const nextPageId = getSettingsPageId();
  if (!nextPageId) {
    if (getLoadFromSetting()) {
      void initializeSettingsPage();
    } else {
      patchPageP({ configLoading: false });
    }
    return;
  }

  const prevPageId = pageP()?.settingsPageId;
  if (prevPageId === nextPageId) return;

  if (prevPageId != null) resetSettingsPageData();
  patchPageP({ settingsPageId: nextPageId });
  void initializeSettingsPage();
});

// Dashboard mode helpers (rendering delegated to DashboardHost; no server queries here)
const getDashboardConfig = () => {
  const config = evaluateConfig();
  const hasEvaluated = hasEvaluatedConfigContent(config);
  if (!hasEvaluated) {
    return null;
  }
  const dashboard =
    config?.dashboardConfig && typeof config.dashboardConfig === "object"
      ? config.dashboardConfig
      : args.contextData.props?.dashboardConfig && typeof args.contextData.props.dashboardConfig === "object"
        ? args.contextData.props.dashboardConfig
        : null;
  return dashboard;
};

const isDashboardPageMode = () => {
  if (args.contextData.props?.pageMode === "dashboard") return true;
  const config = evaluateConfig();
  return config?.pageMode === "dashboard" || !!(config?.dashboardConfig && typeof config.dashboardConfig === "object");
};

const getDropCreateFromConfig = () => {
  const fromProps = prop("dropCreateFrom");
  if (fromProps && typeof fromProps === "object") return fromProps;
  const fromGeneral = getConfigGeneralValue("dropCreateFrom");
  if (fromGeneral && typeof fromGeneral === "object") return fromGeneral;
  return null;
};

const resolveMediaTypeFromFile = (fileVertex, rules) => {
  const mime = String(fileVertex?.P?.mimeType || fileVertex?.P?.fileType || "").toLowerCase();
  const list = Array.isArray(rules) ? rules : [];
  let fallback = "Photo";
  for (let i = 0; i < list.length; i++) {
    const rule = list[i] || {};
    if (rule.match === "default") {
      fallback = rule.mediaType || fallback;
      continue;
    }
    if (rule.match === "mimeStartsWith" && mime.startsWith(String(rule.value || "").toLowerCase())) {
      return rule.mediaType || fallback;
    }
    if (rule.match === "mimeEquals" && mime === String(rule.value || "").toLowerCase()) {
      return rule.mediaType || fallback;
    }
  }
  return fallback;
};

const getOutgoingTargetIds = (vertex, relationshipType) => {
  if (!vertex || !relationshipType) return [];
  const edgesMap = args.graph?.edges || {};
  const outArr = vertex.OUT?.[relationshipType];
  if (!Array.isArray(outArr)) return [];
  const ids = [];
  for (let i = 0; i < outArr.length; i++) {
    const endId = edgesMap[outArr[i]]?.E;
    if (endId != null && String(endId).trim() !== "") ids.push(String(endId));
  }
  return ids;
};

const getDropCreateFileRelationshipTypes = (dropConfig) => {
  const relDefs = Array.isArray(dropConfig?.create?.relationships)
    ? dropConfig.create.relationships
    : [];
  const types = [];
  for (let i = 0; i < relDefs.length; i++) {
    const rel = relDefs[i];
    if (rel?.fromDroppedItem === true && rel?.relationshipType) {
      types.push(String(rel.relationshipType));
    }
  }
  return types.length > 0 ? types : ["GalleryItemFile"];
};

const getMainTableRowVertices = () => {
  const ids = Array.isArray(pageP()?.mainTableRowIds) ? pageP().mainTableRowIds : [];
  const rows = [];
  for (let i = 0; i < ids.length; i++) {
    const id = ids[i] != null ? String(ids[i]).trim() : "";
    if (!id) continue;
    const vertex = args.graph.vertexes[id];
    if (vertex) rows.push(vertex);
  }
  return rows;
};

const mergeMainTableRowIds = (idsToAdd) => {
  const cur = Array.isArray(pageP()?.mainTableRowIds) ? pageP().mainTableRowIds.map(String) : [];
  const merged = [...cur];
  const list = Array.isArray(idsToAdd) ? idsToAdd : [];
  for (let i = 0; i < list.length; i++) {
    const id = list[i] != null ? String(list[i]).trim() : "";
    if (id && !merged.includes(id)) merged.push(id);
  }
  patchPageP({ mainTableRowIds: merged });
};

const findDuplicateDroppedFilesInCurrentTable = (fileIds, dropConfig) => {
  const wanted = new Set(
    (Array.isArray(fileIds) ? fileIds : [])
      .map((id) => (id != null ? String(id).trim() : ""))
      .filter(Boolean)
  );
  if (wanted.size === 0) return [];

  const relTypes = getDropCreateFileRelationshipTypes(dropConfig);
  const duplicatesByFileId = new Map();
  const rows = getMainTableRowVertices();

  for (let ri = 0; ri < rows.length; ri++) {
    const row = rows[ri];
    for (let ti = 0; ti < relTypes.length; ti++) {
      const targets = getOutgoingTargetIds(row, relTypes[ti]);
      for (let fi = 0; fi < targets.length; fi++) {
        const fileId = targets[fi];
        if (!wanted.has(fileId) || duplicatesByFileId.has(fileId)) continue;
        const fileVertex = args.graph.vertexes[fileId];
        duplicatesByFileId.set(fileId, {
          fileId,
          fileName:
            fileVertex?.P?.fileName != null && String(fileVertex.P.fileName).trim() !== ""
              ? String(fileVertex.P.fileName).trim()
              : fileId,
          galleryItemId: row.id,
          title: row.P?.title != null ? String(row.P.title) : ""
        });
      }
    }
  }

  return Array.from(duplicatesByFileId.values());
};

const notifyDropCreateDuplicates = (duplicates, messages) => {
  if (!Array.isArray(duplicates) || duplicates.length === 0) return;
  const names = duplicates.map((d) => d.fileName).join(", ");
  if (duplicates.length === 1) {
    const template =
      messages?.duplicateInCategory ||
      '"{fileName}" is already associated in this category';
    args.showWarningToast?.(template.replace("{fileName}", duplicates[0].fileName));
    return;
  }
  const template =
    messages?.duplicatesInCategory ||
    "{count} file(s) already associated in this category: {names}";
  args.showWarningToast?.(
    template.replace("{count}", String(duplicates.length)).replace("{names}", names)
  );
};

const buildDropCreateDraftRows = (fileIds, dropConfig) => {
  const createCfg = dropConfig?.create || {};
  const prefix = dropConfig?.fileDownloadUrlPrefix || "/api/file/download";
  const rows = [];
  for (let i = 0; i < fileIds.length; i++) {
    const fileId = String(fileIds[i] || "").trim();
    if (!fileId) continue;
    const fileVertex = args.graph.vertexes[fileId];
    if (!fileVertex) continue;
    const fileName =
      fileVertex.P?.fileName != null ? String(fileVertex.P.fileName).trim() : "";
    const mime = String(fileVertex.P?.mimeType || fileVertex.P?.fileType || "");
    const titleFrom = createCfg.titleFrom || "fileName";
    const descriptionFrom = createCfg.descriptionFrom || "description";
    const title =
      fileVertex.P?.[titleFrom] != null && String(fileVertex.P[titleFrom]).trim() !== ""
        ? String(fileVertex.P[titleFrom]).trim()
        : fileName || "Untitled";
    const description =
      fileVertex.P?.[descriptionFrom] != null
        ? String(fileVertex.P[descriptionFrom])
        : "";
    const mediaType = resolveMediaTypeFromFile(fileVertex, createCfg.mediaTypeRules);
    const previewUrl =
      fileName && mime.startsWith("image/")
        ? `${prefix}/${encodeURIComponent(fileName)}`
        : "";
    rows.push({
      fileId,
      fileName,
      mimeType: mime,
      fileType: mime,
      title,
      mediaType,
      description,
      previewUrl
    });
  }
  return rows;
};

const openDropCreateReview = (rows) => {
  patchPageP({
    dropCreateReviewOpen: true,
    dropCreateReviewRows: Array.isArray(rows) ? rows : [],
    dropCreateReviewConfirming: false
  });
};

const closeDropCreateReview = () => {
  if (pageP()?.dropCreateReviewConfirming === true) return;
  patchPageP({
    dropCreateReviewOpen: false,
    dropCreateReviewRows: [],
    dropCreateReviewConfirming: false
  });
};

const updateDropCreateReviewRow = (rowIndex, fieldKey, value) => {
  const rows = Array.isArray(pageP()?.dropCreateReviewRows)
    ? [...pageP().dropCreateReviewRows]
    : [];
  if (rowIndex < 0 || rowIndex >= rows.length) return;
  rows[rowIndex] = { ...rows[rowIndex], [fieldKey]: value };
  patchPageP({ dropCreateReviewRows: rows });
};

const removeDropCreateReviewRow = (rowIndex) => {
  const rows = Array.isArray(pageP()?.dropCreateReviewRows)
    ? [...pageP().dropCreateReviewRows]
    : [];
  if (rowIndex < 0 || rowIndex >= rows.length) return;
  rows.splice(rowIndex, 1);
  patchPageP({ dropCreateReviewRows: rows });
};

const saveDropCreateReviewRow = async (draft, saveData) => {
  const dropConfig = getDropCreateFromConfig();
  if (!dropConfig || dropConfig.enabled === false) return false;

  const tableVertexLabel = getTableVertexLabel();
  if (!tableVertexLabel) return false;

  const createCfg = dropConfig.create || {};
  const relDefs = Array.isArray(createCfg.relationships) ? createCfg.relationships : [];
  const thumbCfg = createCfg.thumbnailForImageMime;
  const enableUserScopingForContent =
    getConfigGeneralValue("enableUserScopingForContent") === true;
  const tableConfig = evaluateConfig();

  const fileId = String(draft?.fileId || "").trim();
  if (!fileId) {
    args.showErrorToast?.("File is required");
    return false;
  }

  const duplicates = findDuplicateDroppedFilesInCurrentTable([fileId], dropConfig);
  if (duplicates.length > 0) {
    notifyDropCreateDuplicates(duplicates, dropConfig.messages || {});
    return false;
  }

  const vertex = saveData?.vertex;
  const properties = vertex?.P && typeof vertex.P === "object" ? { ...vertex.P } : {};

  const relationships =
    saveData?.relationships && typeof saveData.relationships === "object"
      ? { ...saveData.relationships }
      : {};

  // Ensure configured file relationships from the dropped file when form did not set them.
  for (let ri = 0; ri < relDefs.length; ri++) {
    const rel = relDefs[ri];
    if (!rel?.fieldKey || !rel?.relationshipType || !rel?.targetLabel) continue;
    if (rel.fromDroppedItem === true && fileId) {
      const existing = relationships[rel.fieldKey];
      const existingIds = Array.isArray(existing?.targetIds) ? existing.targetIds : [];
      if (existingIds.length === 0) {
        relationships[rel.fieldKey] = {
          relationshipType: rel.relationshipType,
          targetLabel: rel.targetLabel,
          targetIds: [fileId]
        };
      }
    }
  }

  const mime = String(draft?.mimeType || draft?.fileType || properties.fileType || "").toLowerCase();
  if (
    thumbCfg?.fieldKey &&
    thumbCfg?.relationshipType &&
    thumbCfg?.targetLabel &&
    fileId &&
    mime.startsWith("image/")
  ) {
    const existingThumb = relationships[thumbCfg.fieldKey];
    const thumbIds = Array.isArray(existingThumb?.targetIds) ? existingThumb.targetIds : [];
    if (thumbIds.length === 0) {
      relationships[thumbCfg.fieldKey] = {
        relationshipType: thumbCfg.relationshipType,
        targetLabel: thumbCfg.targetLabel,
        targetIds: [fileId]
      };
    }
  }

  const result = await args.fns.executeYTOFunction("mutateUserContent", {
    tableVertexLabel,
    tableSettingsLabel: getTableSettingsLabel(),
    operation: "create",
    data: {
      vertex: {
        id: null,
        L: [tableVertexLabel],
        P: properties,
        IN: {},
        OUT: {}
      },
      relationships
    },
    enableUserScoping: enableUserScopingForContent,
    hooks: getConfigHooks(),
    nestedLinePropertyStripKeys: buildNestedLinePropertyStripKeys(tableConfig),
    translatableFieldKeys: collectTranslatableFieldKeys(tableConfig?.formConfig),
    siteLanguages: getSiteLanguages()
  });
  applyServerGraphToLocalGraph(result);

  const errorMessage = extractError(result, false, "Failed to create");
  if (errorMessage || result?.result?.success !== true) {
    args.showErrorToast?.(errorMessage || "Failed to create gallery item");
    return false;
  }

  const createdId = result?.result?.data?.id;
  if (
    createCfg.assignToActiveSidebarCategory === true &&
    createdId
  ) {
    const sidebarItem = selectedSidebarItem();
    const sidebarConfig = getSidebarConfig();
    if (sidebarItem && sidebarConfig?.toParentEdgeType) {
      const rootKey = sidebarConfig.rootKeys?.key;
      const uCatSave = getUncategorizedVertexId();
      const isUncatSave =
        uCatSave &&
        (sidebarItem.id === uCatSave || sidebarItem.P?.key === uCatSave);
      if (sidebarItem.P?.key !== rootKey && !isUncatSave) {
        const enableUserScopingForSidebar =
          getConfigGeneralValue("enableUserScopingForSidebar") === true;
        try {
          const relResult = await args.fns.executeYTOFunction(
            "createSidebarContentRelationship",
            {
              categoryId: sidebarItem.id,
              contentId: createdId,
              relationshipType: sidebarConfig.toParentEdgeType,
              categoryLabel: sidebarConfig.parentVertexLabel,
              contentLabel: tableVertexLabel,
              enableUserScopingForSidebar,
              enableUserScopingForContent,
              hooks: getConfigHooks()
            }
          );
          applyServerGraphToLocalGraph(relResult);
          if (!extractError(relResult, false)) {
            updateSidebarCategoryCount(sidebarItem.id, 1);
          }
        } catch (relError) {
          console.error("Error creating sidebar relationship:", relError);
        }
      } else if (sidebarItem.P?.key === rootKey) {
        updateSidebarCategoryCount(rootKey, 1);
      } else if (uCatSave) {
        updateSidebarCategoryCount(uCatSave, 1);
      }
    }
  }

  return result?.result || { success: true, data: { id: createdId } };
};

const finishDropCreateReview = (createdIds) => {
  const dropConfig = getDropCreateFromConfig();
  const messages = dropConfig?.messages || {};
  const ids = Array.isArray(createdIds)
    ? createdIds.map((id) => String(id || "").trim()).filter(Boolean)
    : [];

  if (ids.length > 0) {
    mergeMainTableRowIds(ids);
    patchPageP({ rowsToAddVertexIds: ids });
    const successTemplate = messages.success || "Created {count} item(s)";
    args.showSuccessToast?.(
      successTemplate.replace("{count}", String(ids.length))
    );
  }

  patchPageP({
    dropCreateReviewOpen: false,
    dropCreateReviewRows: [],
    dropCreateReviewConfirming: false,
    loading: false
  });
};

const getDropCreateReviewModalProps = () => {
  const dropConfig = getDropCreateFromConfig();
  const reviewModal = dropConfig?.reviewModal || {};
  const formConfig = getFormConfig() || evaluateConfig()?.formConfig || null;
  return {
    isOpen: pageP()?.dropCreateReviewOpen === true,
    title: reviewModal.title || "Review items",
    maxWidth: reviewModal.maxWidth || "1100px",
    confirmLabel: reviewModal.confirmLabel || "Create",
    cancelLabel: reviewModal.cancelLabel || "Cancel",
    removeRowLabel: reviewModal.removeRowLabel || "Remove",
    emptyHint: reviewModal.emptyHint || "No rows.",
    hint: reviewModal.hint,
    rows: Array.isArray(pageP()?.dropCreateReviewRows)
      ? pageP().dropCreateReviewRows
      : [],
    confirming: pageP()?.dropCreateReviewConfirming === true,
    usePolarisUI: getUsePolarisUI(),
    fileDownloadUrlPrefix:
      dropConfig?.fileDownloadUrlPrefix || "/api/file/download",
    formConfig,
    tableVertexLabel: getTableVertexLabel(),
    onRemoveRow: removeDropCreateReviewRow,
    onCancel: closeDropCreateReview,
    onSaveRow: saveDropCreateReviewRow,
    onConfirmStart: () => {
      patchPageP({ dropCreateReviewConfirming: true, loading: true });
    },
    onConfirmEnd: (createdIds) => {
      // Partial failure: keep modal open but stop confirming spinner.
      if (Array.isArray(createdIds) && createdIds.length > 0) {
        mergeMainTableRowIds(createdIds);
        patchPageP({ rowsToAddVertexIds: createdIds });
      }
      patchPageP({ dropCreateReviewConfirming: false, loading: false });
    },
    onConfirmSuccess: (createdIds) => {
      finishDropCreateReview(createdIds);
    }
  };
};

const handleTableDropCreateFrom = async (payload) => {
  const dropConfig = getDropCreateFromConfig();
  if (!dropConfig || dropConfig.enabled === false) return { success: false };

  const messages = dropConfig.messages || {};
  const sourceLabels = Array.isArray(dropConfig.sourceTableVertexLabels)
    ? dropConfig.sourceTableVertexLabels
    : [];
  const sourceKeys = Array.isArray(dropConfig.sourceTableKeys)
    ? dropConfig.sourceTableKeys
    : [];

  const sourceLabel = payload?.sourceTableVertexLabel
    ? String(payload.sourceTableVertexLabel)
    : "";
  const sourceKey = payload?.sourceTableKey ? String(payload.sourceTableKey) : "";

  const labelOk = sourceLabels.length === 0 || sourceLabels.includes(sourceLabel);
  const keyOk = sourceKeys.length === 0 || sourceKeys.includes(sourceKey);
  if (!labelOk || !keyOk) {
    args.showErrorToast?.(messages.wrongSource || "This drop source is not allowed");
    return { success: false };
  }

  const itemIds = Array.isArray(payload?.itemIds)
    ? payload.itemIds.map((id) => String(id || "").trim()).filter(Boolean)
    : [];
  if (itemIds.length === 0) {
    args.showErrorToast?.(messages.emptySelection || "Select one or more items first");
    return { success: false };
  }

  const drafts = buildDropCreateDraftRows(itemIds, dropConfig);
  if (drafts.length === 0) {
    args.showErrorToast?.(messages.emptySelection || "No valid files to add");
    return { success: false };
  }

  const duplicates = findDuplicateDroppedFilesInCurrentTable(
    drafts.map((row) => row.fileId),
    dropConfig
  );
  const duplicateFileIds = new Set(duplicates.map((row) => String(row.fileId)));
  if (duplicates.length > 0) {
    notifyDropCreateDuplicates(duplicates, messages);
  }

  const uniqueDrafts = drafts.filter(
    (row) => !duplicateFileIds.has(String(row.fileId || "").trim())
  );
  if (uniqueDrafts.length === 0) {
    return { success: false };
  }

  openDropCreateReview(uniqueDrafts);
  return { success: true };
};

