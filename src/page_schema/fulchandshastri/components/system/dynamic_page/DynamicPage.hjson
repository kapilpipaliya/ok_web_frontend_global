    {
      id: "11"
      L: Attr
      P: {
        css:
          '''const active = args.fns.companionResizeActive?.() === true;
return `._id {
  width: 100%;
  height: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: row-resize;
  touch-action: none;
  user-select: none;
  position: relative;
  flex-shrink: 0;

  &::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    height: 2px;
    background: ${args.theme.var.color.border};
    transition: background-color 0.2s;
  }

  ${active ? `
  &::before {
    background: ${args.theme.var.color.text_light_300};
  }
  ` : ""}

  @media (hover: hover) {
    &:hover::before {
      background: ${args.theme.var.color.text_light_300};
    }
  }
}`;'''
        displayOrder: 2
        componentName: Html
        key: dynamic_page_companion_resize
        props:
          '''const active = args.fns.companionResizeActive?.() === true;
return {
  as: "button",
  type: "button",
  hide: args.fns.hasCompanionPages?.() !== true,
  "attr:aria-label": "Resize main and companion tables",
  "attr:aria-orientation": "horizontal",
  "attr:role": "separator",
  "attr:data-active": active ? "" : undefined,
  onPointerDown: (e) => {
    if (e.currentTarget?.setPointerCapture) {
      e.currentTarget.setPointerCapture(e.pointerId);
    }
    args.fns.handleCompanionSplitResize?.(e);
  }
};'''
      }
    }
