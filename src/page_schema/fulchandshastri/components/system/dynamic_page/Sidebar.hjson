        displayOrder: 2
        componentName: Html
        key: sidebar_resize_handle
        props:
          '''
const setSidebarWidth = args.contextData.props?.setSidebarWidth;
const sidebarWidth = args.contextData.props?.sidebarWidth?.() || 240;

return {
  as: "div",
  onMouseDown: (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (!setSidebarWidth) return;

    const startX = e.clientX;
    const startWidth = sidebarWidth;

    const handleMouseMove = (moveEvent) => {
      const deltaX = moveEvent.clientX - startX;
      const newWidth = Math.max(200, Math.min(800, startWidth + deltaX)); // Min 200px, Max 800px
      setSidebarWidth(newWidth);
    };

    const handleMouseUp = () => {
      document.removeEventListener('mousemove', handleMouseMove);
      document.removeEventListener('mouseup', handleMouseUp);
    };

    document.addEventListener('mousemove', handleMouseMove);
    document.addEventListener('mouseup', handleMouseUp);
  }
};
'''
      }
    }
