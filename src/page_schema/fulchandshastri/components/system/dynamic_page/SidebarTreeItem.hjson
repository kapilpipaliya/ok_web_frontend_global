        props:
          '''const item = f.getItem();
const isRoot = f.isUncategorizedTreeNode?.(item) ?? false;
const isDragging = f.isDragging?.() || false;
const isDragOver = f.isDragOver?.() || false;
const isValidDrop = f.isValidDrop?.() ?? true;

return {
  as: "div",
  onClick: f.handleItemClick,
  ref: (el) => {
    if (el) {
      // Initialize both draggable and drop target on the same element
      if (!isRoot && f.initDraggable) {
        f.initDraggable(el);
      }
      if (f.initDropTarget) {
        f.initDropTarget(el);
      }
    } else {
      // Cleanup on unmount (ref called with null)
      if (f.cleanupDragAndDrop) {
        f.cleanupDragAndDrop();
      }
    }
  },
  onCleanup: () => {
    // Ensure drag-and-drop listeners are removed on unmount (backup if ref(null) not called)
    if (f.cleanupDragAndDrop) {
      f.cleanupDragAndDrop();
    }
  },
  style: isDragging ? { opacity: 0.5 } : {}
};'''
