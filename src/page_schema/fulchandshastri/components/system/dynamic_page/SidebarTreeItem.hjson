        css:
          '''const isHovered = f.isSelected();
const isDirectMatch = f.isDirectMatch();
const isAncestorOfMatch = f.isAncestorOfMatch?.() ?? false;
const isDragOver = f.isDragOver();
const isValidDrop = f.isValidDrop?.() ?? true;
const isDragging = f.isDragging?.() || false;
const item = f.getItem();
const rootKeys = c.props?.sidebarConfig?.rootKeys || {};
const rootKey = rootKeys.key;
const isRoot =
  item?.P?.key === rootKey || (f.isUncategorizedTreeNode?.(item) ?? false);
const isQueued = f.isQueued?.() ?? false;

// Determine drag over styling based on validation
let dragOverStyle = "";
if (isDragOver) {
  if (isValidDrop) {
    // Valid drop: green border and subtle green background
    dragOverStyle = `background-color: ${t.var.color.success_light_200}; border: 2px dashed ${t.var.color.success_light_200};`;
  } else {
    // Invalid drop: red border and red background with opacity
    dragOverStyle = `background-color: ${t.var.color.error_light_200}; border: 2px dashed ${t.var.color.error_light_200}; cursor: not-allowed;`;
  }
}

// Compute background color variable based on state
let backgroundColor = "";
if (dragOverStyle.includes('background-color')) {
  // The dragOverStyle already sets background color, so don't override
  // No action needed since dragOverStyle will apply its background
} else if (isHovered) {
  backgroundColor = t.var.color.background_dark_150;
} else if (isDirectMatch) {
  backgroundColor = t.var.color.primary_light_500;
//} else if (!isDirectMatch && isAncestorOfMatch) {
//  backgroundColor = t.var.color.primary_light_600;
}

// Compose the style string
return `._id {
  align-items: center;
  cursor: ${isRoot || isQueued ? 'default' : isDragging ? 'grabbing' : isDragOver && !isValidDrop ? 'not-allowed' : 'grab'};
  display: flex;
  gap: 0.375rem;
  font-size: 14px;
  font-weight: ${f.hasChildren() ? "bold" : "normal"};
  width: 100%;
  position: relative;
  border-radius: ${f.hasChildren() ? "5px" : "0 5px 5px 0"};
  ${backgroundColor ? `background-color: ${backgroundColor};
  ${isDirectMatch ? " font-weight: bold;" : ""}` : ""}
  ${dragOverStyle}
  ${isDragging ? `opacity: 0.5;` : ""}
  padding: 2px 0;
  transition: background-color 0.15s ease-in-out;
  ${f.hasChildren() ? "" : `border-left: 1px dashed ${t.var.color.border};`}

  &:hover {
    background-color: ${t.var.color.background_dark_150};
  }

  &:hover .tree-item-actions {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
}`;'''
        displayOrder: 1
        componentName: Html
