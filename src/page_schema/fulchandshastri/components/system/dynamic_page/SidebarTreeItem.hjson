{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''
// Get props from context
const getItem = () => c.props?.item;
const getExpandedKeys = () => c.props?.expandedKeys || [];
const getSelectedItem = () => c.props?.selectedItem;
const getOnToggleExpand = () => c.props?.onToggleExpand;
const getOnItemSelect = () => c.props?.onItemSelect;
const getFetchChildren = () => c.props?.fetchChildren;
const getParentVertexLabel = () => c.props?.sidebarConfig?.parentVertexLabel;
const getToParentEdgeType = () => c.props?.sidebarConfig?.toParentEdgeType;
const getUncategorizedVertexId = () => {
  const label = c.props?.tableVertexLabel;
  return label ? '_' + label + '_uncategorized' : null;
};
const isUncategorizedTreeNode = (node) => {
  if (!node) return false;
  const uid = getUncategorizedVertexId();
  return !!(uid && (node.id === uid || node.P?.key === uid));
};

// Helper function to get sortable name from item
const getItemSortName = (item) => {
  if (!item) return "";
  return item.P?.name || item.P?.title || item.P?.key || "";
};

// Get children and loading from props (from graph)
const getChildren = () => {
  const children = c.props?.childItems || [];
  // Sort children by name alphabetically
  return children.sort((a, b) => {
    const nameA = getItemSortName(a);
    const nameB = getItemSortName(b);
    return nameA.localeCompare(nameB);
  });
};

const getLoading = () => {
  return c.props?.loading || false;
};

// Search: getters from props
const getSearchActive = () => c.props?.searchActive ?? false;
const getFilterTree = () => c.props?.filterTree;
const getShouldExpandForSearch = () => c.props?.shouldExpandForSearch;

// Search: show item when no search or when item/children match
const shouldShowItem = () => {
  if (!getSearchActive() || !getFilterTree()) return true;
  const item = getItem();
  if (!item) return true;
  const r = getFilterTree()(item);
  return r && (r.match || r.matchedChildren);
};

// Search: direct match for highlight (node's text matches)
const isDirectMatch = () => {
  if (!getSearchActive() || !getFilterTree()) return false;
  const item = getItem();
  if (!item) return false;
  return getFilterTree()(item).match;
};

// Search: ancestor of a match (parent path to a matched node)
const isAncestorOfMatch = () => {
  if (!getSearchActive() || !getFilterTree()) return false;
  const item = getItem();
  if (!item) return false;
  const r = getFilterTree()(item);
  return r && r.matchedChildren && !r.match;
};

// Check if item is expanded - when search active use shouldExpandForSearch, else use expandedKeys
const isExpanded = () => {
  const item = getItem();
  if (!item) return false;
  if (getSearchActive() && getShouldExpandForSearch()) {
    return getShouldExpandForSearch()(item);
  }
  const expandedKeys = getExpandedKeys();
  return Array.isArray(expandedKeys) && expandedKeys.includes(item.id);
};

// Check if item is selected
const isSelected = () => {
  const item = getItem();
  const selectedItem = getSelectedItem();
  if (!item || !selectedItem) return false;
  return item.id === selectedItem.id;
};

// Refresh children function - calls parent's fetchChildren
const refreshChildren = async () => {
  const item = getItem();
  if (!item) return;

  const fetchChildrenFn = getFetchChildren();
  if (fetchChildrenFn) {
    await fetchChildrenFn(item.id, true);
  }
};

// Fetch children on mount if expanded
const fetchChildrenIfNeeded = async () => {
  const item = getItem();
  if (!item) return;

  const expanded = isExpanded();
  if (!expanded) return;

  const childrenList = getChildren();

  // Always fetch children when expanded if we don't have them loaded yet
  // This ensures nested children are fetched from the server
  if (childrenList.length === 0) {
    const fetchChildrenFn = getFetchChildren();
    if (fetchChildrenFn) {
      await fetchChildrenFn(item.id);
    }
  }
};

// Handle expand toggle
const handleToggleExpand = async () => {
  const item = getItem();
  if (!item) return;

  const onToggleExpand = getOnToggleExpand();
  if (onToggleExpand) {
    const wasExpanded = isExpanded();
    await onToggleExpand(item.id);
    // Always fetch children when expanding (even if we think we have them)
    // This ensures nested children are properly fetched from the server
    if (!wasExpanded) {
      // Fetch children from server to ensure they're in the graph
      const fetchChildrenFn = getFetchChildren();
      if (fetchChildrenFn) {
        await fetchChildrenFn(item.id);
      }
    }
  }
};

// Handle item click
const handleItemClick = () => {
  const item = getItem();
  const onItemSelect = getOnItemSelect();
  if (item && onItemSelect) {
    onItemSelect(item);
  }
};

// Get item display name (with content count)
const getItemName = () => {
  const item = getItem();
  if (!item) return "";

  const baseName = item.P?.name || item.P?.title || item.P?.key || "No name";

  // Use content count from vertex P property
  const contentCount = item.P?.contentCount ?? 0;
  if (contentCount > 0) {
    return `${baseName} (${contentCount})`;
  }

  return baseName;
};

// Get item icon
const getItemIcon = () => {
  const item = getItem();
  if (!item) return null;

  // First check if item has explicit icon
  if (item.P?.icon) {
    return item.P.icon;
  }

  // Then check for default icon in sidebarConfig
  const sidebarConfig = c.props?.sidebarConfig;
  if (sidebarConfig?.defaultIcon) {
    return sidebarConfig.defaultIcon;
  }

  // No icon configured
  return null;
};

// Sync status for sidebar items (queued = reload icon, failed = error icon)
const getSyncStatus = () => {
  const item = getItem();
  return item?.P?.syncStatus ?? null;
};

// True when item is queued (sync in progress) - no operations allowed
const isQueued = () => getSyncStatus() === 'queued';

// Check if item has children
// Show expand button if we have children loaded or if relationships indicate children exist
const hasChildren = () => {
  const item = getItem();
  if (!item) return false;

  // Check if we have children in graph
  const childrenList = getChildren();
  if (childrenList.length > 0) {
    return true;
  }

  // If no children in graph, check if the vertex has IN relationships indicating it has children
  // Relationship direction: child-[toParentEdgeType]->parent
  // So parent has IN relationships from children (children point to parent)
  // When processResult processes relationships, it sets up parent.IN[toParentEdgeType]
  const toParentEdgeType = getToParentEdgeType();
  if (toParentEdgeType && item.IN && item.IN[toParentEdgeType] && item.IN[toParentEdgeType].length > 0) {
    return true;
  }

  // For nested items that haven't been fetched yet, we don't know if they have children
  // But we should allow expansion to check - show expand button if item might have children
  // This allows nested items to be expanded to fetch and check for children
  // The expand button will be hidden if no children are found after fetching
  return true;
};

// Get onItemUpdate callback from props
const getOnItemUpdate = () => c.props?.onItemUpdate;

// Get onItemDelete callback from props
const getOnItemDelete = () => c.props?.onItemDelete;

// Get fetchRoot function from props
const getFetchRoot = () => c.props?.fetchRoot;

// Open add/edit modals (handled by parent Sidebar - single modal for one item at a time)
const handleOpenAddModal = (e) => {
  e.stopPropagation();
  const item = getItem();
  const onOpenAddModal = c.props?.onOpenAddModal;
  if (item && onOpenAddModal) {
    onOpenAddModal(item);
  }
};

const handleOpenEditModal = (e) => {
  e.stopPropagation();
  const item = getItem();
  const onOpenEditModal = c.props?.onOpenEditModal;
  if (item && onOpenEditModal) {
    onOpenEditModal(item);
  }
};

// Drag and drop handlers using @atlaskit/pragmatic-drag-and-drop
const [isDragOver, setIsDragOver] = _.createSignal(false);
const [isDragging, setIsDragging] = _.createSignal(false);
const [isValidDrop, setIsValidDrop] = _.createSignal(true);
const [draggedCategoryId, setDraggedCategoryId] = _.createSignal(null);
const draggableCleanup = { current: null };
const dropTargetCleanup = { current: null };

// Helper function to check if a category is a descendant of another
// Relationship direction: child-[toParentEdgeType]->parent
// To check if targetId is a descendant of categoryId, we traverse from targetId to categoryId
const isDescendantOf = (targetId, categoryId) => {
  if (!targetId || !categoryId || targetId === categoryId) {
    return false;
  }

  const toParentEdgeType = getToParentEdgeType();
  if (!toParentEdgeType) return false;

  try {
    // Get target vertex from graph
    const targetVertex = g?.vertexes?.[targetId];
    if (!targetVertex) return false;

    // Traverse up the parent chain to see if we reach categoryId
    // Use evalExpression to follow the toParentEdgeType relationship backwards
    // Since child-[toParentEdgeType]->parent, we use ->toParentEdgeType to go from child to parent
    const parent = _.evalExpression(
      `->${toParentEdgeType}`,
      { graph: g, setGraph: sg, vertexes: [targetVertex] }
    );

    if (!parent || parent.length === 0) {
      // No parent, so not a descendant
      return false;
    }

    const parentId = parent[0]?.id;
    if (!parentId) return false;

    // If parent is the category we're checking against, target is a direct child
    if (parentId === categoryId) {
      return true;
    }

    // Recursively check if parent is a descendant
    return isDescendantOf(parentId, categoryId);
  } catch (error) {
    console.error("Error checking descendant:", error);
    return false;
  }
};

// Validate if a drop target is valid for the dragged category
const validateDropTarget = (categoryId, targetId) => {
  if (!categoryId || !targetId) {
    return { valid: false, reason: "Missing category or target ID" };
  }

  // Check 1: Cannot drop on itself
  if (categoryId === targetId) {
    return { valid: false, reason: "Cannot move a category to itself" };
  }

  const uidVal = getUncategorizedVertexId();
  if (uidVal && categoryId === uidVal) {
    return { valid: false, reason: "Root items cannot be moved" };
  }

  // Check 3: Cannot drop on a descendant
  if (isDescendantOf(targetId, categoryId)) {
    return { valid: false, reason: "Cannot move a category to its own descendant" };
  }

  return { valid: true };
};

// Initialize draggable for sidebar item using pragmatic-drag-and-drop
const initDraggable = (element) => {
  if (!element || !_.draggable) return;

  const item = getItem();
  if (!item) return;

  if (isUncategorizedTreeNode(item)) {
    return;
  }

  // Clean up existing draggable if any
  if (draggableCleanup.current) {
    draggableCleanup.current();
  }

  const cleanup = _.draggable({
    element,
    canDrag: () => !isQueued(),
    getInitialData: () => ({
      type: 'sidebar-item',
      categoryId: item.id,
      categoryName: item.P?.name || item.P?.key || 'Category'
    }),
    onGenerateDragPreview: ({ nativeSetDragImage }) => {
      // If available, render a custom native drag preview so it doesn't disappear
      // when the default preview is disabled by pragmatic-drag-and-drop.
      if (!_.setCustomNativeDragPreview || !nativeSetDragImage) return;
      const item = getItem();
      if (!item) return;

      const label = item.P?.name || item.P?.title || item.P?.key || "Category";
      const count = item.P?.contentCount ?? null;

      return _.setCustomNativeDragPreview({
        nativeSetDragImage,
        getOffset: _.pointerOutsideOfPreview
          ? _.pointerOutsideOfPreview({ x: "8px", y: "8px" })
          : undefined,
        render: ({ container }) => {
          // Basic "pill" preview that mirrors sidebar row content.
          container.style.boxSizing = "border-box";
          container.style.display = "flex";
          container.style.alignItems = "center";
          container.style.gap = "8px";
          container.style.padding = "8px 10px";
          container.style.borderRadius = "10px";
          container.style.border = `1px solid ${t?.var?.color?.border ?? "rgba(0,0,0,0.2)"}`;
          container.style.background = `${t?.var?.color?.background_light_200 ?? "#fff"}`;
          container.style.color = `${t?.var?.color?.text ?? "#111"}`;
          container.style.boxShadow = "0 8px 24px rgba(0,0,0,0.18)";
          container.style.maxWidth = "280px";
          container.style.pointerEvents = "none";
          container.style.fontSize = "14px";
          container.style.fontWeight = "600";
          container.style.whiteSpace = "nowrap";
          container.style.overflow = "hidden";
          container.style.textOverflow = "ellipsis";

          // Small grab dot
          const dot = document.createElement("div");
          dot.style.width = "10px";
          dot.style.height = "10px";
          dot.style.borderRadius = "9999px";
          dot.style.background = `${t?.var?.color?.primary ?? "#4f46e5"}`;
          dot.style.flex = "0 0 auto";

          const text = document.createElement("div");
          text.style.minWidth = "0";
          text.style.flex = "1 1 auto";
          text.style.whiteSpace = "nowrap";
          text.style.overflow = "hidden";
          text.style.textOverflow = "ellipsis";
          text.textContent = count !== null && count !== undefined && count > 0 ? `${label} (${count})` : label;

          container.appendChild(dot);
          container.appendChild(text);
        }
      });
    },
    onDragStart: () => {
      setIsDragging(true);
      setDraggedCategoryId(item.id);
      setIsValidDrop(true);
      if (element) {
        element.style.opacity = '0.5';
      }
    },
    onDrop: () => {
      setIsDragging(false);
      setDraggedCategoryId(null);
      if (element) {
        element.style.opacity = '1';
      }
    }
  });

  draggableCleanup.current = cleanup;
  return cleanup;
};

// Initialize drop target for sidebar item using pragmatic-drag-and-drop
const initDropTarget = (element) => {
  if (!element || !_.dropTargetForElements) return;

  const item = getItem();
  if (!item) return;

  // Clean up existing drop target if any
  if (dropTargetCleanup.current) {
    dropTargetCleanup.current();
  }

  const cleanup = _.dropTargetForElements({
    element,
    getData: () => ({}),
    canDrop: (_) => {
      // Note: Don't return false for isQueued here - we need drop target to stay active
      // so onDrag fires and we can show red highlight; onDrop will reject the drop
      const source = _.source;
      const data = source.data;

      // Validate table items drop
      if (data && data.type === 'table-items') {
        // Check if there are valid item IDs
        if (!data.itemIds || !Array.isArray(data.itemIds) || data.itemIds.length === 0) {
          return false;
        }
        // Reject drops from a different table (e.g. Files onto Gallery sidebar)
        const contentLabel = c.props?.tableVertexLabel
          || c.props?.contentLabel
          || null;
        const sourceLabel = data.sourceTableVertexLabel != null
          ? String(data.sourceTableVertexLabel)
          : "";
        if (contentLabel && sourceLabel && sourceLabel !== String(contentLabel)) {
          return false;
        }
        return true;
      }

      // Allow sidebar items
      if (data && data.type === 'sidebar-item') {
        return true;
      }

      return false;
    },
    onDragEnter: () => {
      setIsDragOver(true);
    },
    onDrag: (event) => {
      const source = event.source;
      const data = source.data;

      // Cannot drop onto a queued (syncing) item
      if (isQueued()) {
        setIsValidDrop(false);
        setIsDragOver(true);
        return;
      }

      // Validate drop target for sidebar items
      if (data && data.type === 'sidebar-item' && data.categoryId) {
        const validation = validateDropTarget(data.categoryId, item.id);
        setIsValidDrop(validation.valid);
      } else if (data && data.type === 'table-items') {
        // Table items: disallow dropping into the currently active category (compare by vertex id only)
        const currentSelected = getSelectedItem();
        const isSameActiveCategory = !!currentSelected && !!item && currentSelected.id === item.id;
        setIsValidDrop(!isSameActiveCategory);
      } else {
        // Table items - allow drop
        setIsValidDrop(true);
      }
      setIsDragOver(true);
    },
    onDragLeave: () => {
      setIsDragOver(false);
    },
    onDrop: async (event) => {
      setIsDragOver(false);

      // Cannot drop onto a queued (syncing) item
      if (isQueued()) {
        _.showWarningToast?.("Cannot drop here: item is syncing");
        return;
      }

      const source = event.source;
      const data = source.data;

      // Handle sidebar item drops
      if (data && data.type === 'sidebar-item' && data.categoryId) {
        // Re-validate before proceeding
        const validation = validateDropTarget(data.categoryId, item.id);
        if (!validation.valid) {
          _.showWarningToast?.(validation.reason || "Cannot drop here");
          return;
        }

        const uidDrop = getUncategorizedVertexId();
        const newParentId = uidDrop && item.id === uidDrop ? null : item.id;

        // Move the sidebar item
        await handleMoveSidebarItem(data.categoryId, newParentId);
        return;
      }

      // Handle table item drops (existing functionality)
      if (data && data.type === 'table-items' && data.itemIds && Array.isArray(data.itemIds)) {
        // Re-check same-active-category guard (vertex id only)
        const currentSelected = getSelectedItem();
        if (currentSelected && item && currentSelected.id === item.id) {
          const contentLabel = c.props?.contentLabel || "Item";
          const plural = contentLabel.endsWith('y') ? contentLabel.slice(0, -1) + 'ies' : contentLabel + (contentLabel.endsWith('s') ? '' : 's');
          _.showWarningToast?.(`${plural} are already in this category`);
          return;
        }
        await handleTableItemsDrop(data.itemIds);
      }
    },
    onDropTargetChange: (event) => {
      setIsDragOver(event.isActive);
    }
  });

  dropTargetCleanup.current = cleanup;
  return cleanup;
};

// Cleanup function
const cleanupDragAndDrop = () => {
  if (draggableCleanup.current) {
    draggableCleanup.current();
    draggableCleanup.current = null;
  }
  if (dropTargetCleanup.current) {
    dropTargetCleanup.current();
    dropTargetCleanup.current = null;
  }
};

// Handle moving sidebar item to new parent
const handleMoveSidebarItem = async (categoryId, newParentId) => {
  const parentVertexLabel = getParentVertexLabel();
  const toParentEdgeType = getToParentEdgeType();
  const rootKeys = c.props?.sidebarConfig?.rootKeys || {};
  const enableUserScoping = c.props?.enableUserScoping === true;
  const hooks = c.props?.hooks;
  const label = c.props?.label || "Item";

  const moveContextData = {
    categoryId,
    newParentId,
    parentVertexLabel,
    toParentEdgeType,
    rootKeys,
    enableUserScoping,
    hooks: hooks,
    label: label,
    tableVertexLabel: c.props?.tableVertexLabel
  };

  try {
    f.setOperationLoading?.(true);

    const result = await s({
      functionName: "moveSidebarItem",
      contextData: moveContextData
    });

    // Check for errors and show toast
    const errorMessage = f.extractError?.(result, true, `Failed to move ${label}`);
    if (errorMessage) {
      return false;
    }

    if (result?.result?.success) {
      // Apply graph update from move (edge change); getRoot() is computed from graph so roots update automatically
      if (result.graph && (result.graph.vertexes || result.graph.edges)) {
        _.setGraphData(0, result.graph, {});
      }
      // Preserve expanded state: keep moved item and new parent expanded after move
      const setExpandedKeysFn = c.props?.setExpandedKeys;
      if (setExpandedKeysFn) {
        setExpandedKeysFn(keys => [...new Set([...(Array.isArray(keys) ? keys : []), categoryId, newParentId].filter(Boolean))]);
      }
      _.showSuccessToast?.(result.result.message || `${label} moved successfully`);
      return true;
    }

    return false;
  } catch (error) {
    console.error("Error moving sidebar item:", error);
    _.showErrorToast?.(`Failed to move ${label}`);
    return false;
  } finally {
    f.setOperationLoading?.(false);
  }
};

// Handle table items drop (extracted from handleDrop)
const handleTableItemsDrop = async (itemIds) => {
  f.setOperationLoading?.(true);
  try {
    const item = getItem();
    if (!item) return;

    const onMoveItemsToCategory = c.props?.onMoveItemsToCategory;
    if (!onMoveItemsToCategory) {
      _.showErrorToast?.("Move function not available");
      return;
    }

    const parentVertexLabel = getParentVertexLabel();
    const toParentEdgeType = getToParentEdgeType();
    const rootKeys = c.props?.sidebarConfig?.rootKeys || {};

    // Prevent dropping into the same active category (vertex id only)
    const currentSelected = getSelectedItem();
    if (currentSelected && item && currentSelected.id === item.id) {
      const contentLabel = c.props?.contentLabel || "Item";
      const plural = contentLabel.endsWith('y') ? contentLabel.slice(0, -1) + 'ies' : contentLabel + (contentLabel.endsWith('s') ? '' : 's');
      _.showWarningToast?.(`${plural} are already in this category`);
      return;
    }

    const uCatDrop = getUncategorizedVertexId();
    const categoryId = uCatDrop && item.id === uCatDrop ? null : item.id;

    // Get sidebar config
    const sidebarConfig = {
      parentVertexLabel: parentVertexLabel,
      toParentEdgeType: toParentEdgeType,
      rootKeys: rootKeys
    };

    // Call move function from parent
    const result = await onMoveItemsToCategory(itemIds, categoryId, sidebarConfig);

    if (result?.success) {
      const contentLabel = c.props?.contentLabel || "item";
      const plural = contentLabel.endsWith('y') ? contentLabel.slice(0, -1) + 'ies' : contentLabel + (contentLabel.endsWith('s') ? '' : 's');
      _.showSuccessToast?.(result.message || `Moved ${itemIds.length} ${itemIds.length !== 1 ? plural : contentLabel} successfully`);

      // Determine source category (where items were moved FROM); use vertex id only
      const sourceCategory = currentSelected;
      const uid = getUncategorizedVertexId();
      const isSourceUncategorized = sourceCategory && uid && sourceCategory.id === uid;
      const isTargetUncategorized = !!(uid && item.id === uid);

      // Update content counts using mergeVertexProperties
      const updatedCounts = result.data?.updatedCounts;

      if (updatedCounts) {
        // Update target category count (if not uncategorized)
        if (updatedCounts.targetCategoryId && !isTargetUncategorized && item.id === updatedCounts.targetCategoryId) {
          _.mergeVertexProperties(0, item.id, g, sg, {
            contentCount: updatedCounts.targetCount
          });
        }

        // Update source category count (if not uncategorized)
        if (updatedCounts.sourceCategoryId && !isSourceUncategorized && currentSelected && currentSelected.id === updatedCounts.sourceCategoryId) {
          _.mergeVertexProperties(0, currentSelected.id, g, sg, {
            contentCount: updatedCounts.sourceCount
          });
        }

        // For uncategorized target, update the uncategorized vertex directly if it exists
        const tgtUncatId = uid;
        if (
          isTargetUncategorized &&
          tgtUncatId &&
          updatedCounts.targetCategoryId === tgtUncatId &&
          updatedCounts.targetCount !== undefined
        ) {
          const uncategorizedVertex = g?.vertexes?.[tgtUncatId];
          if (uncategorizedVertex) {
            _.mergeVertexProperties(0, tgtUncatId, g, sg, {
              contentCount: updatedCounts.targetCount
            });
          } else {
            // If uncategorized vertex doesn't exist in graph, refresh root items (preserve expanded state)
            const fetchRootFn = getFetchRoot();
            if (fetchRootFn) {
              await fetchRootFn({ preserveExpanded: true });
            }
          }
        }

        // For uncategorized source, update the uncategorized vertex directly if it exists
        if (
          isSourceUncategorized &&
          tgtUncatId &&
          updatedCounts.sourceCategoryId === tgtUncatId &&
          updatedCounts.sourceCount !== undefined
        ) {
          const uncategorizedVertex = g?.vertexes?.[tgtUncatId];
          if (uncategorizedVertex) {
            _.mergeVertexProperties(0, tgtUncatId, g, sg, {
              contentCount: updatedCounts.sourceCount
            });
          } else {
            // If uncategorized vertex doesn't exist in graph, refresh root items (preserve expanded state)
            const fetchRootFn = getFetchRoot();
            if (fetchRootFn) {
              await fetchRootFn({ preserveExpanded: true });
            }
          }
        }
      }

      // Always refresh root items if moving to/from uncategorized (as fallback); preserve expanded state so tree does not collapse
      if (isSourceUncategorized || isTargetUncategorized) {
        const fetchRootFn = getFetchRoot();
        if (fetchRootFn) {
          await fetchRootFn({ preserveExpanded: true });
        }
      }

      // Keep drop target and its ancestors expanded so the parent item does not collapse
      const setExpandedKeysFn = c.props?.setExpandedKeys;
      if (setExpandedKeysFn && item?.id) {
        const toParentEdgeType = getToParentEdgeType();
        const ancestorIds = [];
        let current = item;
        while (current?.id) {
          ancestorIds.push(current.id);
          const parent = _.evalExpression?.(`->${toParentEdgeType}`, { graph: g, setGraph: sg, vertexes: [current] })?.[0];
          current = parent || null;
        }
        if (ancestorIds.length > 0) {
          setExpandedKeysFn(keys => [...new Set([...(Array.isArray(keys) ? keys : []), ...ancestorIds])]);
        }
      }
    } else {
      // Check for errors and show toast (result is from onMoveItemsToCategory, not executeNamedServerFunction)
      if (result && result.success === false) {
        _.showErrorToast?.(result.message || "Failed to move items");
      } else {
        _.showErrorToast?.("Failed to move items");
      }
    }
  } finally {
    f.setOperationLoading?.(false);
  }
};

// Handle delete
const handleDelete = async (e) => {
  e.stopPropagation();
  const item = getItem();
  if (!item) return;
  if (isQueued()) {
    _.showWarningToast?.("Cannot delete: item is syncing");
    return;
  }

  const parentVertexLabel = getParentVertexLabel();
  const toParentEdgeType = getToParentEdgeType();
  const rootKeys = c.props?.sidebarConfig?.rootKeys || {};

  if (isUncategorizedTreeNode(item)) {
    _.showErrorToast?.("Root item cannot be deleted");
    return;
  }

  // Confirm deletion using rbConfirm
  const rbConfirm = f?.rbConfirm;
  if (!rbConfirm) {
    _.showErrorToast?.("Delete confirmation not available");
    return;
  }

  const confirmed = await rbConfirm({
    title: "Delete Item",
    message: `Are you sure you want to delete "${item.P?.name || item.P?.key || 'this item'}"? This action cannot be undone.`,
    confirmText: "Delete",
    cancelText: "Cancel",
    variant: "danger"
  });

  if (!confirmed) {
    return;
  }

  // Delete the vertex (use label from getSidebarLabel: config?.label || config?.parentVertexLabel)
  try {
    f.setOperationLoading?.(true);

    const label = c.props?.label || "Item";
    const result = await s({
      functionName: "saveSidebarVertex",
      contextData: {
        vertexId: item.id,
        name: item.P?.name || "",
        key: item.P?.key || "",
        parentId: null,
        parentVertexLabel: parentVertexLabel,
        toParentEdgeType: toParentEdgeType,
        rootKeys: rootKeys,
        properties: item.P || {},
        operation: "delete",
        tableVertexLabel: c.props?.tableVertexLabel,
        relationshipType: c.props?.relationshipType,
        enableUserScoping: c.props?.enableUserScoping,
        hooks: c.props?.hooks,
        label: label
      }
    });

    if (result?.result?.success) {
      _.showSuccessToast?.(`${label} deleted successfully`);

      // Get vertex from graph to collect all connected edges
      const vertex = g.vertexes[item.id];
      const edgeIdsToDelete = [];

      if (vertex) {
        // Collect all outgoing edge IDs
        if (vertex.OUT) {
          for (const edgeType in vertex.OUT) {
            const edgeIds = vertex.OUT[edgeType] || [];
            edgeIdsToDelete.push(...edgeIds);
          }
        }

        // Collect all incoming edge IDs
        if (vertex.IN) {
          for (const edgeType in vertex.IN) {
            const edgeIds = vertex.IN[edgeType] || [];
            edgeIdsToDelete.push(...edgeIds);
          }
        }
      }

      // Delete all edges before calling setGraphData
      for (const edgeId of edgeIdsToDelete) {
        _.deleteEdge(0, edgeId, g, sg);
      }

      // Use setGraphData to handle vertex deletion from graph
      if (result.graph) {
        const graphData = {
          vertexes: result.graph.vertexes || {},
          edges: {},
          deleted_vertexes: result.result.deleted_vertexes || [item.id],
          deleted_edges: []
        };
        _.setGraphData(0, graphData, {});
      }

      // Notify parent to remove item from tree
      const onItemDelete = getOnItemDelete();
      if (onItemDelete) {
        onItemDelete(item.id);
      }
    } else {
      // Check for errors and show toast
      const errorMessage = f.extractError?.(result, true, "Failed to delete item");
      if (!errorMessage) {
        // If extractError didn't find an error but success is false, show default message
        _.showErrorToast?.("Failed to delete item");
      }
    }
  } catch (error) {
    console.error("Error deleting item:", error);
    _.showErrorToast?.("Failed to delete item");
  } finally {
    f.setOperationLoading?.(false);
  }
};

return {
  getItem,
  getExpandedKeys,
  getSelectedItem,
  getOnToggleExpand,
  getOnItemSelect,
  getFetchChildren,
  isExpanded,
  isSelected,
  getChildren,
  getLoading,
  fetchChildrenIfNeeded,
  handleToggleExpand,
  handleItemClick,
  getItemName,
  getItemIcon,
  getSyncStatus,
  isQueued,
  hasChildren,
  shouldShowItem,
  isDirectMatch,
  isAncestorOfMatch,
  handleOpenAddModal,
  handleOpenEditModal,
  getOnItemUpdate,
  handleDelete,
  getOnItemDelete,
  refreshChildren,
  isDragOver,
  setIsDragOver,
  isDragging,
  isValidDrop,
  isDescendantOf,
  validateDropTarget,
  initDraggable,
  initDropTarget,
  cleanupDragAndDrop,
  handleMoveSidebarItem,
  handleTableItemsDrop,
  getUsePolarisUI: () => f.getUsePolarisUI?.() === true,
  isUncategorizedTreeNode,
  getUncategorizedVertexId
};
