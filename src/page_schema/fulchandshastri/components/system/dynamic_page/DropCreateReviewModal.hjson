{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: DropCreateReviewModal
        description: "Review modal for drag-drop create using FormManagement per draft row."
        fns:
          '''
const getProps = () => args.contextData.props || {};

const [formApisByKey, setFormApisByKey] = args.createStore({});

const getRows = () => {
  const rows = getProps().rows;
  return Array.isArray(rows) ? rows : [];
};

const rowKey = (row, rowIndex) => {
  if (row?.fileId) return String(row.fileId);
  return `idx-${rowIndex}`;
};

const isConfirming = () => getProps().confirming === true;

const getPreviewUrl = (row) => {
  if (!row) return "";
  if (row.previewUrl) return String(row.previewUrl);
  const fileName = row.fileName != null ? String(row.fileName).trim() : "";
  if (!fileName) return "";
  const mime = String(row.mimeType || row.fileType || "");
  if (mime && !mime.startsWith("image/")) return "";
  const prefix = getProps().fileDownloadUrlPrefix || "/api/file/download";
  return `${prefix}/${encodeURIComponent(fileName)}`;
};

const registerFormApi = (row, rowIndex, formApi) => {
  const key = rowKey(row, rowIndex);
  setFormApisByKey(key, formApi);
  if (!row || !formApi?.setFieldValue) return;

  // Prefill editable fields + file relationship after FormManagement initializes.
  if (row.title != null) formApi.setFieldValue("title", row.title);
  if (row.mediaType != null) formApi.setFieldValue("mediaType", row.mediaType);
  if (row.description != null) formApi.setFieldValue("description", row.description);
  if (row.fileId) {
    formApi.setFieldValue("file", row.fileId);
    const mime = String(row.mimeType || row.fileType || "").toLowerCase();
    if (mime.startsWith("image/")) {
      formApi.setFieldValue("thumbnail", row.fileId);
    }
  }
};

const removeRow = (row, rowIndex) => {
  const key = rowKey(row, rowIndex);
  const api = formApisByKey[key];
  if (api?.formTxnId) {
    const txnId = typeof api.formTxnId === "function" ? api.formTxnId() : api.formTxnId;
    if (txnId && txnId > 0) {
      args.revertTransaction(txnId);
    }
  }
  setFormApisByKey(key, undefined);
  getProps().onRemoveRow?.(rowIndex);
};

const handleConfirm = async () => {
  if (isConfirming()) return;
  const rows = getRows();
  if (rows.length === 0) {
    args.showErrorToast?.(getProps().emptyHint || "No rows to create");
    return;
  }

  const onSaveRow = getProps().onSaveRow;
  if (typeof onSaveRow !== "function") {
    args.showErrorToast?.("Save handler missing");
    return;
  }

  getProps().onConfirmStart?.();

  const createdIds = [];
  try {
    for (let i = 0; i < rows.length; i++) {
      const draft = rows[i];
      const api = formApisByKey[rowKey(draft, i)];
      if (!api?.handleSave) {
        args.showErrorToast?.("Form not ready for row " + (i + 1));
        getProps().onConfirmEnd?.(createdIds);
        return;
      }
      const result = await api.handleSave();
      if (!result) {
        getProps().onConfirmEnd?.(createdIds);
        return;
      }
      const id =
        result?.data?.id ||
        result?.result?.data?.id ||
        result?.id ||
        null;
      if (id) createdIds.push(String(id));
    }
    getProps().onConfirmSuccess?.(createdIds);
  } catch (error) {
    console.error("DropCreateReviewModal confirm:", error);
    args.showErrorToast?.(error?.message || "Failed to create items");
    getProps().onConfirmEnd?.(createdIds);
  }
};

const handleCancel = () => {
  if (isConfirming()) return;
  Object.keys(formApisByKey).forEach((key) => {
    const api = formApisByKey[key];
    if (api?.formTxnId) {
      const txnId = typeof api.formTxnId === "function" ? api.formTxnId() : api.formTxnId;
      if (txnId && txnId > 0) args.revertTransaction(txnId);
    }
  });
  setFormApisByKey(args.reconcile({}));
  getProps().onCancel?.();
};

const buildRowSaveHandler = (row, rowIndex) => {
  return async (saveData) => {
    const draft = getRows().find((r, i) => rowKey(r, i) === rowKey(row, rowIndex)) || row;
    const onSaveRow = getProps().onSaveRow;
    if (typeof onSaveRow !== "function") return false;
    return await onSaveRow(draft, saveData, rowIndex);
  };
};

return {
  getProps,
  getRows,
  rowKey,
  isConfirming,
  getPreviewUrl,
  registerFormApi,
  removeRow,
  handleConfirm,
  handleCancel,
  buildRowSaveHandler
};
'''
      }
    }
    {
      id: "root"
      L: Attr
      P: {
        displayOrder: 1
        componentName: ContentModal
        props:
          '''
const p = args.fns.getProps();
return {
  isOpen: p.isOpen === true,
  title: p.title || "Review items",
  maxWidth: p.maxWidth || "1100px",
  usePolarisUI: p.usePolarisUI === true,
  onClose: () => args.fns.handleCancel?.()
};
'''
      }
    }
    {
      id: "body"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        slotName: children
        props: return { as: "div" };
        css:
          '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  min-height: 0;
  max-height: calc(90vh - 5rem);
  padding: 1rem 1.25rem 1.25rem;
}`;
'''
      }
    }
    {
      id: "hint"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const hint = args.fns.getProps()?.hint;
return {
  as: "p",
  text: hint || "",
  hide: !hint
};
'''
        css:
          '''
return `._id {
  margin: 0;
  font-size: 0.875rem;
  color: ${args.theme.var.color.text_dark_400};
}`;
'''
      }
    }
    {
      id: "empty"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
return {
  as: "p",
  text: args.fns.getProps()?.emptyHint || "No rows.",
  hide: args.fns.getRows().length > 0
};
'''
        css:
          '''
return `._id {
  margin: 0;
  padding: 1.5rem 0.5rem;
  text-align: center;
  color: ${args.theme.var.color.text_dark_400};
  font-size: 0.9rem;
}`;
'''
      }
    }
    {
      id: "rows"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        loop: true
        contextName: draftRow
        props:
          '''
return {
  as: "div",
  data: args.fns.getRows(),
  hide: args.fns.getRows().length === 0
};
'''
        css:
          '''
return `._id {
  flex: 1;
  min-height: 0;
  overflow: auto;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}`;
'''
      }
    }
    {
      id: "rowCard"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props: return { as: "article" };
        css:
          '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding: 0.75rem;
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.5rem;
  background: ${args.theme.var.color.background};
}`;
'''
      }
    }
    {
      id: "rowHeader"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props: return { as: "div" };
        css:
          '''
return `._id {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}`;
'''
      }
    }
    {
      id: "previewBox"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const draftRow = args.contextData.draftRow;
const url = args.fns.getPreviewUrl(draftRow);
return {
  as: "div",
  "attr:aria-label": url ? "File preview" : "No preview"
};
'''
        css:
          '''
return `._id {
  width: 72px;
  height: 52px;
  border-radius: 0.375rem;
  border: 1px solid ${args.theme.var.color.border};
  background: ${args.theme.var.color.background_light_200};
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}`;
'''
      }
    }
    {
      id: "previewImg"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const draftRow = args.contextData.draftRow;
const url = args.fns.getPreviewUrl(draftRow);
return {
  as: "img",
  src: url,
  alt: draftRow?.fileName || "Preview",
  hide: !url
};
'''
        css:
          '''
return `._id {
  width: 100%;
  height: 100%;
  object-fit: cover;
}`;
'''
      }
    }
    {
      id: "previewIcon"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
const draftRow = args.contextData.draftRow;
const url = args.fns.getPreviewUrl(draftRow);
const mime = String(draftRow?.mimeType || draftRow?.fileType || "");
let icon = "ph:file";
if (mime.startsWith("video/")) icon = "ph:video";
else if (mime === "application/pdf" || mime.includes("pdf")) icon = "ph:file-pdf";
return {
  as: "icon",
  icon,
  width: 22,
  height: 22,
  hide: !!url
};
'''
      }
    }
    {
      id: "fileMeta"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
const draftRow = args.contextData.draftRow;
return {
  as: "div",
  text: draftRow?.fileName || "File"
};
'''
        css:
          '''
return `._id {
  flex: 1;
  min-width: 0;
  font-size: 0.875rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}`;
'''
      }
    }
    {
      id: "removeBtn"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        props:
          '''
const rowIndex = args.contextData.draftRow_index;
const draftRow = args.contextData.draftRow;
const label = args.fns.getProps()?.removeRowLabel || "Remove";
return {
  as: "button",
  type: "button",
  text: label,
  disabled: args.fns.isConfirming(),
  onClick: () => args.fns.removeRow(draftRow, rowIndex),
  "attr:aria-label": label
};
'''
        css:
          '''
return `._id {
  border: none;
  background: transparent;
  color: ${args.theme.var.color.error};
  font-size: 0.75rem;
  cursor: pointer;
  padding: 0.25rem 0.35rem;
  border-radius: 0.25rem;
  flex-shrink: 0;
}
._id:hover:not(:disabled) {
  background: ${args.theme.var.color.error_light_900};
}
._id:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}`;
'''
      }
    }
    {
      id: "form"
      L: Attr
      P: {
        displayOrder: 2
        componentName: FormManagement
        props:
          '''
const p = args.fns.getProps();
const draftRow = args.contextData.draftRow;
const rowIndex = args.contextData.draftRow_index;
return {
  formConfig: p.formConfig,
  mode: "add",
  inModal: true,
  hideActionsBar: true,
  vertexLabel: p.tableVertexLabel || "GalleryItem",
  onSave: args.fns.buildRowSaveHandler(draftRow, rowIndex),
  onFnsReady: (formApi) => args.fns.registerFormApi(draftRow, rowIndex, formApi),
  hide: !p.formConfig
};
'''
      }
    }
    {
      id: "footer"
      L: Attr
      P: {
        displayOrder: 4
        componentName: Html
        props: return { as: "div" };
        css:
          '''
return `._id {
  display: flex;
  justify-content: flex-end;
  gap: 0.5rem;
  flex-shrink: 0;
  padding-top: 0.25rem;
}`;
'''
      }
    }
    {
      id: "cancelBtn"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Button
        props:
          '''
const p = args.fns.getProps();
return {
  text: p.cancelLabel || "Cancel",
  variant: "secondary",
  disabled: args.fns.isConfirming(),
  onClick: () => args.fns.handleCancel?.()
};
'''
      }
    }
    {
      id: "confirmBtn"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Button
        props:
          '''
const p = args.fns.getProps();
const count = args.fns.getRows().length;
return {
  text: p.confirmLabel || "Create",
  variant: "primary",
  disabled: args.fns.isConfirming() || count === 0,
  onClick: () => void args.fns.handleConfirm?.()
};
'''
      }
    }
  ]
  edges: [
    { id: "e1", T: "Attr", S: "1", E: "root" }
    { id: "e2", T: "Attr", S: "root", E: "body" }
    { id: "e3", T: "Attr", S: "body", E: "hint" }
    { id: "e4", T: "Attr", S: "body", E: "empty" }
    { id: "e5", T: "Attr", S: "body", E: "rows" }
    { id: "e6", T: "Attr", S: "body", E: "footer" }
    { id: "e7", T: "Attr", S: "rows", E: "rowCard" }
    { id: "e8", T: "Attr", S: "rowCard", E: "rowHeader" }
    { id: "e9", T: "Attr", S: "rowCard", E: "form" }
    { id: "e10", T: "Attr", S: "rowHeader", E: "previewBox" }
    { id: "e11", T: "Attr", S: "previewBox", E: "previewImg" }
    { id: "e12", T: "Attr", S: "previewBox", E: "previewIcon" }
    { id: "e13", T: "Attr", S: "rowHeader", E: "fileMeta" }
    { id: "e14", T: "Attr", S: "rowHeader", E: "removeBtn" }
    { id: "e15", T: "Attr", S: "footer", E: "cancelBtn" }
    { id: "e16", T: "Attr", S: "footer", E: "confirmBtn" }
  ]
}
