{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        dynamicComponent: Button, LoadingSpinner, TableGeneralSchemaEditor, TableColumnsSchemaEditor, TableFormConfigSchemaEditor, TableSidebarSchemaEditor, Html
        description: Tabbed shell for editing all table schema parts (general, columns, formConfig, sidebar).
        fns:
          '''
const getProps = () => c.props || {};
const getTableKey = () => {
  const v = getProps().tableKey;
  return v != null && String(v).trim() !== "" ? String(v).trim() : null;
};
const isEmbeddedMode = () => getProps().embeddedMode === true;

const executeYTOFunction = (fn, ctx) =>
  s({ functionName: fn, contextData: ctx || {} });

const TABS = [
  { id: "general", label: "General" },
  { id: "columns", label: "Columns" },
  { id: "formConfig", label: "Form config" },
  { id: "sidebar", label: "Sidebar" }
];

const [loading, setLoading] = _.createSignal(true);
const [tableIds, setTableIds] = _.createSignal(null);
const [activeTab, setActiveTab] = _.createSignal("general");

const loadTableIds = async () => {
  const tableKey = getTableKey();
  if (!tableKey) {
    setTableIds(null);
    setLoading(false);
    return;
  }
  setLoading(true);
  try {
    const result = await executeYTOFunction("getTableIds", { tableKey });
    if (!result?.result?.success) {
      _.showErrorToast?.(result?.result?.message || "Failed to resolve table");
      setTableIds(null);
      return;
    }
    setTableIds(result.result.data);
  } catch (error) {
    _.showErrorToast?.("Failed to resolve table");
    setTableIds(null);
  } finally {
    setLoading(false);
  }
};

const getSchemaKeyForTab = (tabId) => {
  const ids = tableIds();
  return ids?.schemaKeys?.[tabId] || null;
};

const isTabActive = (tabId) => activeTab() === tabId;

const onSaved = () => {
  const cb = getProps().onSaved;
  if (typeof cb === "function") cb();
};

return {
  TABS, loading, tableIds, activeTab, setActiveTab,
  loadTableIds, getTableKey, getSchemaKeyForTab, isTabActive,
  isEmbeddedMode, onSaved
};
'''
        key: TableSchemaEditorShell
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  height: 100%;
  background: ${t.var.color.background};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  onMount: () => { void f.loadTableIds?.(); }
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.625rem 1rem;
  border-bottom: 1px solid ${t.var.color.border};
  background: ${t.var.color.background_light_100};
  flex-shrink: 0;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "header" };
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''return `._id {
  margin: 0;
  font-size: 1rem;
  font-weight: 700;
  color: ${t.var.color.text};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const ids = f.tableIds?.();
const tableKey = f.getTableKey?.();
return {
  as: "h2",
  text: ids?.name ? `Table schema — ${ids.name}` : `Table schema — ${tableKey || ""}`
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
}`;'''
        displayOrder: 2
        componentName: Html
        props: return { as: "nav" };
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        contextName: tsesTab
        loop: true
        displayOrder: 1
        componentName: Html
        props: "return { data: f.TABS || [] };"
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Button
        props:
          '''const tab = c.tsesTab;
const active = f.isTabActive?.(tab.id);
return {
  variant: active ? "primary" : "secondary",
  size: "sm",
  text: tab.label,
  type: "button",
  onClick: () => f.setActiveTab?.(tab.id)
};'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        displayOrder: 2
        componentName: LoadingSpinner
        props: "return { hide: f.loading?.() !== true };"
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        css:
          '''return `._id {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}`;'''
        displayOrder: 3
        componentName: Html
        props:
          '''return {
  as: "div",
  hide: f.loading?.() === true || !f.tableIds?.()
};'''
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        displayOrder: 1
        componentName: TableGeneralSchemaEditor
        props:
          '''return {
  hide: f.isTabActive?.("general") !== true,
  tableKey: f.getTableKey?.(),
  schemaKey: f.getSchemaKeyForTab?.("general"),
  title: "General",
  embeddedMode: f.isEmbeddedMode?.(),
  onSaved: () => f.onSaved?.()
};'''
      }
    }
    {
      id: "11"
