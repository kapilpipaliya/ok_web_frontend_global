{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        dynamicComponent: TextInput, Button, IconButton, Html
        description: Visual editor for formConfig groups[].fields[] schema.
        fns:
          '''
const getProps = () => args.contextData.props || {};
const DEFAULT_SITE_LANGUAGES = [
  { code: "en", label: "English", isDefault: true },
  { code: "hi", label: "Hindi", isDefault: false },
  { code: "gu", label: "Gujarati", isDefault: false }
];

const getSiteLanguages = () => {
  const languages = getProps().siteLanguages;
  if (Array.isArray(languages) && languages.length > 0) return languages;
  return DEFAULT_SITE_LANGUAGES;
};

const getGroups = () => {
  const groups = getProps().groups;
  if (!Array.isArray(groups)) return [];
  return groups.map((g) => ({
    ...g,
    fields: Array.isArray(g?.fields) ? g.fields.map((f) => ({ ...f })) : []
  }));
};

const emitGroups = (groups) => {
  const onChange = getProps().onChange;
  if (typeof onChange === "function") onChange({ groups });
};

const [selectedGroupIndex, setSelectedGroupIndex] = args.createSignal(0);
const [selectedFieldIndex, setSelectedFieldIndex] = args.createSignal(null);

const getSelectedGroupIndex = () => {
  const groups = getGroups();
  const idx = selectedGroupIndex();
  if (groups.length === 0) return -1;
  if (idx >= 0 && idx < groups.length) return idx;
  return 0;
};

const getSelectedGroup = () => {
  const idx = getSelectedGroupIndex();
  return idx >= 0 ? getGroups()[idx] : null;
};

const getFields = () => {
  const group = getSelectedGroup();
  return group?.fields || [];
};

const getFieldIndices = () => {
  const fields = getFields();
  const indices = [];
  for (let i = 0; i < fields.length; i++) indices.push(i);
  return indices;
};

const getGroupIndices = () => {
  const groups = getGroups();
  const indices = [];
  for (let i = 0; i < groups.length; i++) indices.push(i);
  return indices;
};

const getGroupAt = (index) => getGroups()[index] || {};
const getFieldAt = (index) => getFields()[index] || {};

const setGroups = (nextGroups) => {
  emitGroups(nextGroups);
};

const updateGroupAt = (index, partial) => {
  const groups = getGroups();
  setGroups(groups.map((g, i) => (i === index ? { ...g, ...partial } : g)));
};

const addGroup = () => {
  const groups = getGroups();
  const next = [
    ...groups,
    {
      key: `group_${Date.now()}`,
      title: "New group",
      gridColumns: 2,
      fields: []
    }
  ];
  setGroups(next);
  setSelectedGroupIndex(next.length - 1);
  setSelectedFieldIndex(null);
};

const deleteGroup = (index) => {
  const groups = getGroups().filter((_, i) => i !== index);
  setGroups(groups);
  setSelectedGroupIndex(Math.min(selectedGroupIndex(), Math.max(0, groups.length - 1)));
  setSelectedFieldIndex(null);
};

const selectGroup = (index) => {
  setSelectedGroupIndex(index);
  setSelectedFieldIndex(null);
};

const updateSelectedGroup = (partial) => {
  const idx = getSelectedGroupIndex();
  if (idx < 0) return;
  updateGroupAt(idx, partial);
};

const setFieldsOnSelectedGroup = (fields) => {
  updateSelectedGroup({ fields });
};

const addField = () => {
  const fields = getFields();
  const next = [
    ...fields,
    {
      key: `field_${Date.now()}`,
      label: "New field",
      dataType: "text",
      renderer: "text",
      required: false,
      translatable: false,
      colSpan: 1
    }
  ];
  setFieldsOnSelectedGroup(next);
  setSelectedFieldIndex(next.length - 1);
};

const updateFieldAt = (index, partial) => {
  const fields = getFields();
  setFieldsOnSelectedGroup(fields.map((f, i) => (i === index ? { ...f, ...partial } : f)));
};

const deleteField = (index) => {
  setFieldsOnSelectedGroup(getFields().filter((_, i) => i !== index));
  if (selectedFieldIndex() === index) setSelectedFieldIndex(null);
};

const moveField = (index, direction) => {
  const fields = [...getFields()];
  const target = index + direction;
  if (target < 0 || target >= fields.length) return;
  const tmp = fields[index];
  fields[index] = fields[target];
  fields[target] = tmp;
  setFieldsOnSelectedGroup(fields);
  setSelectedFieldIndex(target);
};

const isGroupSelected = (index) => getSelectedGroupIndex() === index;
const isFieldSelected = (index) => selectedFieldIndex() === index;

return {
  getSiteLanguages,
  getGroupIndices,
  getGroupAt,
  getSelectedGroupIndex,
  getSelectedGroup,
  getFieldIndices,
  getFieldAt,
  addGroup,
  deleteGroup,
  selectGroup,
  updateSelectedGroup,
  addField,
  updateFieldAt,
  deleteField,
  moveField,
  isGroupSelected,
  isFieldSelected,
  setSelectedFieldIndex,
  selectedFieldIndex
};
'''
        key: FormConfigGroupsSchemaEditor
      }
    }
    {
      id: "2"
