{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        dynamicComponent: Button, TextInput, TextArea, LoadingSpinner, Html
        description: Visual editor for table columns schema with load/save.
        fns:
          '''
const getProps = () => args.contextData.props || {};
const getTableKey = () => {
  const v = getProps().tableKey;
  return v != null && String(v).trim() !== "" ? String(v).trim() : null;
};
const getSchemaKey = () => {
  const v = getProps().schemaKey;
  return v != null && String(v).trim() !== "" ? String(v).trim() : null;
};
const executeYTOFunction = (functionName, contextData) =>
  args.executeNamedServerFunction({ functionName, contextData: contextData || {} });

const [loading, setLoading] = args.createSignal(false);
const [saving, setSaving] = args.createSignal(false);
const [schemaData, setSchemaData] = args.createSignal(null);
const [configJsonText, setConfigJsonText] = args.createSignal("");
const [jsonError, setJsonError] = args.createSignal("");
const [isDirty, setIsDirty] = args.createSignal(false);
const [editorMode, setEditorMode] = args.createSignal("visual");
const [selectedColumnIndex, setSelectedColumnIndex] = args.createSignal(null);

const isJsonMode = () => editorMode() === "json";

const syncJsonFromData = (data) => {
  const payload = data && typeof data === "object" ? { ...data } : {};
  setConfigJsonText(JSON.stringify(payload, null, 2));
  setJsonError("");
};

const applyLoadedSetting = (setting) => {
  if (!setting?.P?.config) {
    setSchemaData({ part: "columns", columns: [] });
    syncJsonFromData({ part: "columns", columns: [] });
    setIsDirty(false);
    return;
  }
  try {
    const data = new Function(setting.P.config)();
    setSchemaData(data && typeof data === "object" ? data : { part: "columns", columns: [] });
    syncJsonFromData(data);
    setIsDirty(false);
  } catch (error) {
    setSchemaData(null);
    setConfigJsonText(String(setting.P.config || ""));
    setJsonError("Failed to parse stored config");
  }
};

const loadSchema = async () => {
  const schemaKey = getSchemaKey();
  if (!schemaKey) return;
  setLoading(true);
  try {
    const result = await executeYTOFunction("getTableSchema", { key: schemaKey });
    if (!result?.result?.success) {
      args.showErrorToast?.(result?.result?.message || "Failed to load table schema");
      return;
    }
    applyLoadedSetting(result.result.data?.setting);
  } catch (error) {
    args.showErrorToast?.("Failed to load table schema");
  } finally {
    setLoading(false);
  }
};

const getColumns = () => {
  const data = schemaData();
  const cols = data?.columns;
  return Array.isArray(cols) ? cols.map((c) => ({ ...c })) : [];
};

const getColumnIndices = () => {
  const cols = getColumns();
  const indices = [];
  for (let i = 0; i < cols.length; i++) indices.push(i);
  return indices;
};

const getColumnAt = (index) => getColumns()[index] || {};

const patchColumns = (columns) => {
  const next = { ...(schemaData() || { part: "columns" }), part: "columns", columns };
  setSchemaData(next);
  syncJsonFromData(next);
  setIsDirty(true);
};

const updateColumnAt = (index, partial) => {
  patchColumns(getColumns().map((c, i) => (i === index ? { ...c, ...partial } : c)));
};

const addColumn = () => {
  const cols = getColumns();
  patchColumns([
    ...cols,
    { key: `col_${Date.now()}`, label: "New column", dataType: "text", renderer: "text", width: "120px", sortable: true }
  ]);
  setSelectedColumnIndex(cols.length);
};

const deleteColumn = (index) => {
  patchColumns(getColumns().filter((_, i) => i !== index));
  if (selectedColumnIndex() === index) setSelectedColumnIndex(null);
};

const buildConfigObject = () => {
  if (isJsonMode()) return JSON.parse(configJsonText());
  const data = schemaData();
  return data && typeof data === "object" ? data : { part: "columns", columns: [] };
};

const saveSchema = async () => {
  const schemaKey = getSchemaKey();
  if (!schemaKey) {
    args.showErrorToast?.("Schema key is missing");
    return;
  }
  setSaving(true);
  try {
    const configObj = buildConfigObject();
    const configBody = `return ${JSON.stringify(configObj, null, 2)};`;
    const result = await executeYTOFunction("saveTableSchema", {
      key: schemaKey,
      tableKey: getTableKey(),
      part: "columns",
      config: configBody,
      name: getProps().title || "Table columns schema"
    });
    if (!result?.result?.success) {
      args.showErrorToast?.(result?.result?.message || "Failed to save");
      return;
    }
    args.showSuccessToast?.(result.result.message || "Table schema saved");
    applyLoadedSetting(result.result.data?.setting);
    setIsDirty(false);
    getProps().onSaved?.();
  } catch (error) {
    args.showErrorToast?.(error instanceof Error && isJsonMode() ? "Invalid JSON" : "Failed to save table schema");
  } finally {
    setSaving(false);
  }
};

const setEditorModeSafe = (mode) => {
  if (mode === "json") syncJsonFromData(schemaData());
  setEditorMode(mode);
};

return {
  loading, saving, isJsonMode, isDirty, configJsonText, setConfigJsonText, jsonError,
  loadSchema, saveSchema, setEditorMode: setEditorModeSafe,
  getColumnIndices, getColumnAt, selectedColumnIndex, setSelectedColumnIndex,
  addColumn, updateColumnAt, deleteColumn, patchColumns
};
'''
        key: TableColumnsSchemaEditor
      }
    }
