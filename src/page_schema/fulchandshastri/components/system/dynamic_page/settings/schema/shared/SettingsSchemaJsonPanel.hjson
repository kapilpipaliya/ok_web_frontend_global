{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        dynamicComponent: Button, TextArea, Html
        description: JSON editor panel for settings page schema.
        key: SettingsSchemaJsonPanel
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''
return `._id {
  flex: 1;
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: ${args.theme.var.color.background};
}`;
'''
        displayOrder: 3
        componentName: Html
        props:
          '''const api = args.contextData.props?.editorApi || {};

return {
  as: "div",
  hide: api.isVisualMode?.() === true
};
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''
return `._id {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.5rem 1rem;
  border-bottom: 1px solid ${args.theme.var.color.border};
  background: ${args.theme.var.color.background_light_100};
  flex-shrink: 0;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div"
};
'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''
return `._id {
  margin: 0;
  font-size: 0.8125rem;
  color: ${args.theme.var.color.text_light_500};
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "p",
  text: "Schema config (JSON). Structure only — no default values."
};
'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Button
        props:
          '''const api = args.contextData.props?.editorApi || {};

return {
  variant: "secondary",
  size: "sm",
  text: "Reset from visual",
  type: "button",
  title: "Replace JSON with the current visual editor state",
  onClick: () => api.syncJsonFromVisual?.()
};
'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          '''
return `._id {
  padding: 0.5rem 1rem;
  font-size: 0.8125rem;
  color: ${args.theme.var.color.error_text};
  background: ${args.theme.var.color.error_light_100};
  border-bottom: 1px solid ${args.theme.var.color.error};
  flex-shrink: 0;
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''const api = args.contextData.props?.editorApi || {};

const error = api.jsonError?.();
return {
  as: "div",
  text: error ? `JSON error: ${error}` : "",
  hide: !error,
  role: "alert"
};
'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''
return `._id {
  flex: 1;
  min-height: 0;
  padding: 0.75rem 1rem;
  display: flex;
  flex-direction: column;
}`;
'''
        displayOrder: 3
        componentName: Html
        props:
          '''
return { as: "div" };
'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        css:
          '''
return `._id {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;

  textarea {
    flex: 1;
    min-height: 20rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8125rem;
    line-height: 1.5;
    resize: none;
  }
}`;
'''
        displayOrder: 1
        componentName: TextArea
        props:
          '''const api = args.contextData.props?.editorApi || {};

return {
  label: "Config JSON",
  value: api.configJsonText?.() || "",
  rows: 24,
  resize: "none",
  placeholder: `{"pageMode": "settings", ...}`,
  onChange: (e) => api.onJsonTextChange?.(e.target.value)
};
'''
      }
    }
  ]
