        displayOrder: 2
        componentName: FieldArraySchemaEditor
        props:
          '''const api = args.contextData.props?.editorApi || {};

const field = api.getSelectedField?.();
const fieldIndex = api.selectedFieldIndex?.();
const sectionId = api.selectedSectionId?.();
return {
  hide: !field || field.renderer !== "fieldArray",
  key: sectionId != null && fieldIndex != null
    ? `field-array-schema-${sectionId}-${fieldIndex}`
    : "field-array-schema-none",
  field,
  siteLanguages: api.getSiteLanguages?.(),
  onChange: (patch) => api.onFieldArraySchemaChange?.(patch)
};
'''
