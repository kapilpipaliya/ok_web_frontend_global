};
'''
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        css:
          '''const api = args.contextData.props?.editorApi || {};

const index = args.contextData.configFieldItem;
const active = api.selectedFieldIndex?.() === index;
const dragSource = api.fieldDragSource?.();
const dragging =
  api.draggedFieldIndex?.() === index &&
  dragSource?.sectionId === api.selectedSectionId?.() &&
  dragSource?.index === index;
return `._id.fsce-field-item {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.625rem 0.75rem;
  border-radius: 0.375rem;
  border: 1px solid ${active ? args.theme.var.color.primary : args.theme.var.color.border};
  background: ${active ? args.theme.var.color.primary_light_50 : args.theme.var.color.background};
  cursor: pointer;
  box-sizing: border-box;
  flex-shrink: 0;
  ${dragging ? "opacity: 0.5;" : ""}

  .fsce-field-drag-handle {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s ease, visibility 0.15s ease;
  }

  &:hover .fsce-field-drag-handle {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  ${dragging ? `
  & .fsce-field-drag-handle {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }` : ""}
}

._id.fsce-field-drop-before::before {
  content: "";
  position: absolute;
  left: 0.5rem;
  right: 0.5rem;
  top: 0;
  height: 2px;
  background: ${args.theme.var.color.primary};
  border-radius: 9999px;
  transform: translateY(-50%);
  z-index: 2;
  pointer-events: none;
  box-shadow: 0 0 0 1px ${args.theme.var.color.primary_light_200};
}

._id.fsce-field-drop-before::after {
  content: "";
  position: absolute;
  left: 0.25rem;
  top: 0;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: ${args.theme.var.color.primary};
  transform: translateY(-50%);
  z-index: 2;
  pointer-events: none;
}

._id.fsce-field-drop-after::before {
  content: "";
  position: absolute;
  left: 0.5rem;
  right: 0.5rem;
  bottom: 0;
  height: 2px;
  background: ${args.theme.var.color.primary};
  border-radius: 9999px;
  transform: translateY(50%);
  z-index: 2;
  pointer-events: none;
  box-shadow: 0 0 0 1px ${args.theme.var.color.primary_light_200};
}

._id.fsce-field-drop-after::after {
  content: "";
  position: absolute;
  left: 0.25rem;
  bottom: 0;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: ${args.theme.var.color.primary};
  transform: translateY(50%);
  z-index: 2;
  pointer-events: none;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''const api = args.contextData.props?.editorApi || {};

const index = args.contextData.configFieldItem;
const field = api.getFieldAt?.(index) || {};
const dropBefore = api.isFieldDropBefore?.(index);
const dropAfter = api.isFieldDropAfter?.(index);
return {
  as: "div",
  class: `fsce-field-item${dropBefore ? " fsce-field-drop-before" : ""}${dropAfter ? " fsce-field-drop-after" : ""}`,
  role: "button",
  tabIndex: 0,
  onClick: () => api.selectField?.(index),
  onKeyDown: (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      api.selectField?.(index);
    }
  },
  ref: (element) => {
    if (element && typeof index === "number" && api.attachFieldDropTarget) {
      api.attachFieldDropTarget(element, index);
    }
  }
};
'''
      }
    }
    {
      id: "12"
      L: Attr
      P: {
        css:
          '''
return `._id.fsce-field-drag-handle {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 1.25rem;
  height: 1.25rem;
  color: ${args.theme.var.color.text_light_500};
  cursor: grab;
  touch-action: none;
  user-select: none;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''const api = args.contextData.props?.editorApi || {};

const index = args.contextData.configFieldItem;
return {
  as: "div",
  class: "fsce-field-drag-handle",
  role: "presentation",
  onClick: (e) => e.stopPropagation?.(),
  onMouseDown: (e) => e.stopPropagation?.(),
  ref: (element) => {
    if (element && typeof index === "number" && api.attachFieldDraggable) {
      api.attachFieldDraggable(element, index);
    }
  }
};
'''
      }
    }
