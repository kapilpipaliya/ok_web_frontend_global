        displayOrder: 1
        componentName: Html
        props:
          '''const api = args.contextData.props?.editorApi || {};

const section = api.getSelectedSection?.();
return {
  as: "div",
  hide: !section,
  ref: (element) => {
    if (element && api.attachFieldsListBoundary) {
      api.attachFieldsListBoundary(element);
    }
  }
};
'''
