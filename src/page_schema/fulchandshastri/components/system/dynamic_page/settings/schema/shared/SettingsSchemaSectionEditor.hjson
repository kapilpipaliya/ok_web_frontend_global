        displayOrder: 1
        componentName: FormManagement
        props:
          '''const api = args.contextData.props?.editorApi || {};

const field = api.getSelectedField?.();
const fieldIndex = api.selectedFieldIndex?.();
const sectionId = api.selectedSectionId?.();
const initialVertex = api.fieldEditorVertex?.();
return {
  hide: !field || !initialVertex,
  key: sectionId != null && fieldIndex != null
    ? `field-editor-${sectionId}-${fieldIndex}`
    : "field-editor-none",
  formConfig: api.FIELD_EDITOR_FORM_CONFIG,
  initialVertex,
  mode: "edit",
  vertexLabel: "SettingsSchemaFormData",
  hideActionsBar: true,
  onFnsReady: api.registerFieldEditorFormFns,
  onFieldChange: () => api.syncFieldFromForm?.()
};
'''
