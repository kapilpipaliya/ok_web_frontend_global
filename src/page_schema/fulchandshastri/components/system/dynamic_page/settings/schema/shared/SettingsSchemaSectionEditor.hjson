    {
      id: "9"
      L: Attr
      P: {
        css:
          '''
return `._id.fsce-field-items-list {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  width: 100%;
  min-height: 0;
}

._id.fsce-field-items-list-dragging {
  padding-top: 0.375rem;
  padding-bottom: 0.375rem;
  min-height: 2.5rem;
}

._id.fsce-field-list-drop-empty::before {
  content: "";
  position: absolute;
  left: 0.5rem;
  right: 0.5rem;
  top: 0.375rem;
  height: 2px;
  background: ${args.theme.var.color.primary};
  border-radius: 9999px;
  z-index: 2;
  pointer-events: none;
  box-shadow: 0 0 0 1px ${args.theme.var.color.primary_light_200};
}

._id.fsce-field-list-drop-empty::after {
  content: "";
  position: absolute;
  left: 0.25rem;
  top: calc(0.375rem - 3px);
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: ${args.theme.var.color.primary};
  z-index: 2;
  pointer-events: none;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''const api = args.contextData.props?.editorApi || {};

const emptyDrop = api.isFieldListEmptyDrop?.();
const dragging = !!api.fieldDragSource?.();
return {
  as: "div",
  class: [
    "fsce-field-items-list",
    dragging ? "fsce-field-items-list-dragging" : "",
    emptyDrop ? "fsce-field-list-drop-empty" : ""
  ].filter(Boolean).join(" "),
  ref: (element) => {
    if (element && api.attachFieldListDropTarget) {
      api.attachFieldListDropTarget(element);
    }
  }
};
'''
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        contextName: configFieldItem
        loop: true
