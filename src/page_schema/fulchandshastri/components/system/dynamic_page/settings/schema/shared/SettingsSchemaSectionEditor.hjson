        displayOrder: 1
        componentName: FormManagement
        props:
          '''const api = args.contextData.props?.editorApi || {};

const section = api.getSelectedSection?.();
const initialVertex = api.sectionMetaVertex?.();
return {
  hide: api.isSingleSectionMode?.() === true || !section || !initialVertex,
  key: section ? `section-meta-${section.id}` : "section-meta-none",
  formConfig: api.SECTION_META_FORM_CONFIG,
  initialVertex,
  mode: "edit",
  vertexLabel: "SettingsSchemaFormData",
  hideActionsBar: true,
  onFnsReady: api.registerSectionMetaFormFns,
  onFieldChange: () => api.syncSectionMetaFromForm?.()
};
'''
      }
