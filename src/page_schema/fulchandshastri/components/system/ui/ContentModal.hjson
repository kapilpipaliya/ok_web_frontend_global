      id: "4"
      L: Attr
      P: {
        css:
          '''
return `._id {
  padding: 1rem 1.25rem;
  border-bottom: 1px solid ${args.theme.var.color.border};
  display: flex;
  align-items: center;
  justify-content: space-between;
