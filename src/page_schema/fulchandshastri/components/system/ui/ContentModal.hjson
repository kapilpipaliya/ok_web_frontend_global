    {
      id: "2"
      L: Attr
      P: {
        css:
          '''
return `._id {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  animation: contentModalFadeIn 0.2s ease;
}

@keyframes contentModalFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@media (max-width: 768px) {
  ._id {
    padding: 0;
    align-items: flex-end;
  }
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  hide: args.contextData.props?.isOpen !== true,
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      args.contextData.props?.onClose?.();
    }
  }
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''
const maxWidth = args.contextData.props?.maxWidth || "880px";
return `._id {
  background: ${args.theme.var.color.background};
  border-radius: 0.75rem;
  width: 100%;
  max-width: ${maxWidth};
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.12);
  animation: contentModalSlideUp 0.28s ease;
  overflow: hidden;
}

@keyframes contentModalSlideUp {
  from {
    opacity: 0;
    transform: translateY(16px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-width: 768px) {
  ._id {
    max-width: 100%;
    max-height: 100vh;
    height: 100vh;
    border-radius: 0;
  }
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  onClick: (e) => e.stopPropagation()
};'''
      }
    }
