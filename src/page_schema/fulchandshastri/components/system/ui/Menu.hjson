        props:
          '''const item = c.menuItem;
const parentProps = c.props || {};
const depth = f.getDepth();

return {
  items: f.getChildren(item),
  depth: depth + 1,
  layout: "panel",
  controller: f.getController(),
  rootPlacement: parentProps.rootPlacement,
  submenuPlacement: parentProps.submenuPlacement,
  closeDelay: parentProps.closeDelay,
  isActive: parentProps.isActive,
  onItemClick: parentProps.onItemClick,
  triggerColor: parentProps.triggerColor,
  panelBackground: parentProps.panelBackground,
  hoverBackground: parentProps.hoverBackground,
  activeBorderColor: parentProps.activeBorderColor
};'''
