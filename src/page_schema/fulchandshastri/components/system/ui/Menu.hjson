        css:
          '''const layout = f.getLayout();
if (layout === "bar") {
  return `._id {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    align-items: center;
    min-width: 0;
    -webkit-tap-highlight-color: transparent;
  }`;
}
return `._id {
  display: flex;
  flex-direction: column;
  min-width: 220px;
  max-width: min(90vw, 320px);
  padding: 0.25rem 0;
  -webkit-tap-highlight-color: transparent;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const layout = f.getLayout();
const isRoot = f.getDepth() === 0;
return {
  as: layout === "bar" ? "nav" : "div",
  "data-menu-root": isRoot ? "true" : undefined,
  "attr:role": layout === "panel" ? "menu" : "navigation",
  onMount: isRoot ? () => f.getController().onMount() : undefined
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        contextName: menuItem
        loop: true
