{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        isNoPermissionCheck: true
        description: SSR-safe nested menu. All items render in HTML; Floating UI positions on open. Props: items[{id,text,href,children|submenu}], depth, layout, controller, placements, closeDelay, isActive, onItemClick, colors.
        fns:
          '''
const props = () => c.props || {};

const getDepth = () => Number(props().depth) || 0;
const getLayout = () =>
  props().layout || (getDepth() === 0 ? "bar" : "panel");
const getItems = () => {
  const items = props().items;
  return Array.isArray(items) ? items : [];
};
const getChildren = (item) => {
  if (!item) return [];
  if (Array.isArray(item.children) && item.children.length) return item.children;
  if (Array.isArray(item.submenu) && item.submenu.length) return item.submenu;
  return [];
};
const getItemId = (item) =>
  item?.id != null ? String(item.id) : String(item?.text || "");

const getRootPlacement = () => props().rootPlacement || "bottom-start";
const getSubmenuPlacement = () => props().submenuPlacement || "right-start";
const getCloseDelay = () => Number(props().closeDelay) || 250;

const getTriggerColor = () =>
  props().triggerColor || t.var.color.text;
const getPanelBackground = () =>
  props().panelBackground || t.var.color.background;
const getHoverBackground = () =>
  props().hoverBackground || "rgba(0, 0, 0, 0.08)";
const getActiveBorderColor = () =>
  props().activeBorderColor || getTriggerColor();

const getPagePath = () => {
  const parts = String(_.location?.pathname || "")
    .split("/")
    .filter(Boolean);
  if (parts.length > 0 && /^[a-z]{2,3}$/i.test(parts[0])) {
    return parts.length > 1 ? "/" + parts.slice(1).join("/") : "/";
  }
  return _.location?.pathname || "/";
};

const defaultIsActive = (item) => {
  if (!item) return false;
  const currentPath = getPagePath();
  const itemPath = item.baseHref || item.href;
  if (itemPath && itemPath !== "#" && currentPath === itemPath) return true;
  return getChildren(item).some((child) => defaultIsActive(child));
};

const isItemActive = (item) => {
  const custom = props().isActive;
  if (typeof custom === "function") return !!custom(item);
  return defaultIsActive(item);
};

const isMouseLikePointer = (pointerType) =>
  !pointerType || pointerType === "mouse" || pointerType === "pen";

const createController = () => {
  const [openPath, setOpenPath] = _.createSignal([]);
  const triggerRefs = new Map();
  const menuRefs = new Map();
  const floatingCleanups = new Map();
  let closeTimer = null;
  let lastPointerType = "mouse";

  const setTriggerRef = (id) => (el) => {
    if (el) triggerRefs.set(id, el);
    else triggerRefs.delete(id);
  };

  const setMenuRef = (id) => (el) => {
    if (el) menuRefs.set(id, el);
    else menuRefs.delete(id);
  };

  const isInsideMenus = (target) => {
    if (!target) return false;
    for (const el of triggerRefs.values()) {
      if (el.contains?.(target)) return true;
    }
    for (const el of menuRefs.values()) {
      if (el.contains?.(target)) return true;
    }
    return false;
  };

  const stopFloating = (id) => {
    const cleanup = floatingCleanups.get(id);
    if (cleanup) {
      cleanup();
      floatingCleanups.delete(id);
    }
  };

  const setupFloating = async (id, placement, offsetPx) => {
    stopFloating(id);
    const trigger = triggerRefs.get(id);
    const menu = menuRefs.get(id);
    if (!trigger || !menu || !_.floatingUI) return;

    const { computePosition, flip, shift, offset, autoUpdate, size } =
      _.floatingUI;

    const middleware = [
      offset(offsetPx),
      flip({ fallbackAxisSideDirection: "start" }),
      shift({ padding: 8 }),
    ];
    if (typeof size === "function") {
      middleware.push(
        size({
          padding: 8,
          apply({ availableHeight, elements }) {
            Object.assign(elements.floating.style, {
              maxHeight: `${Math.max(120, availableHeight)}px`,
              overflowY: "auto",
              WebkitOverflowScrolling: "touch",
            });
          },
        }),
      );
    }

    const updatePosition = async () => {
      const { x, y } = await computePosition(trigger, menu, {
        placement,
        strategy: "fixed",
        middleware,
      });
      Object.assign(menu.style, {
        left: `${x}px`,
        top: `${y}px`,
      });
    };

    await updatePosition();
    floatingCleanups.set(
      id,
      autoUpdate(trigger, menu, updatePosition, {
        ancestorScroll: true,
        ancestorResize: true,
        elementResize: true,
        layoutShift: true,
      }),
    );
  };

  const clearCloseTimer = () => {
    if (closeTimer) {
      clearTimeout(closeTimer);
      closeTimer = null;
    }
  };

  const closeAll = () => {
    clearCloseTimer();
    const path = openPath();
    for (const menuId of path) stopFloating(menuId);
    setOpenPath([]);
  };

  const closeFrom = (depth) => {
    clearCloseTimer();
    const prev = openPath();
    for (let i = depth; i < prev.length; i++) stopFloating(prev[i]);
    setOpenPath(prev.slice(0, depth));
  };

  const keepOpen = () => clearCloseTimer();

  const scheduleClose = () => {
    clearCloseTimer();
    closeTimer = setTimeout(() => closeAll(), getCloseDelay());
  };

  const openAt = (depth, id) => {
    keepOpen();
    const prev = openPath();
    const next = [...prev.slice(0, depth), id];
    for (let i = depth; i < prev.length; i++) {
      if (prev[i] && prev[i] !== next[i]) stopFloating(prev[i]);
    }
    setOpenPath(next);
    const placement =
      depth === 0 ? getRootPlacement() : getSubmenuPlacement();
    const offsetPx = depth === 0 ? 4 : 0;
    // Panels are always in the DOM (SSR); position after paint
    requestAnimationFrame(() => {
      void setupFloating(id, placement, offsetPx);
    });
  };

  const toggleAt = (depth, id) => {
    keepOpen();
    if (
      isOpen(id) &&
      openPath()[depth] === id &&
      openPath().length === depth + 1
    ) {
      closeFrom(depth);
      return;
    }
    openAt(depth, id);
  };

  const isOpen = (id) => openPath().includes(id);

  const onParentPointerEnter = (event, depth, id) => {
    if (event?.pointerType) lastPointerType = event.pointerType;
    if (!isMouseLikePointer(event?.pointerType)) return;
    openAt(depth, id);
  };

  const onParentPointerLeave = (event) => {
    if (event?.pointerType) lastPointerType = event.pointerType;
    if (!isMouseLikePointer(event?.pointerType)) return;
    scheduleClose();
  };

  const onParentPointerDown = (event) => {
    if (event?.pointerType) lastPointerType = event.pointerType;
  };

  const onParentClick = (event, depth, id) => {
    event?.preventDefault?.();
    event?.stopPropagation?.();
    if (isMouseLikePointer(lastPointerType)) {
      if (!isOpen(id)) openAt(depth, id);
      return;
    }
    toggleAt(depth, id);
  };

  const onOutsidePointerDown = (event) => {
    if (openPath().length === 0) return;
    if (isInsideMenus(event.target)) return;
    closeAll();
  };

  const onDocumentKeyDown = (event) => {
    if (event.key === "Escape" && openPath().length > 0) {
      event.preventDefault();
      closeAll();
    }
  };

  const onMount = () => {
    document.addEventListener("pointerdown", onOutsidePointerDown, true);
    document.addEventListener("keydown", onDocumentKeyDown);
    return () => {
      document.removeEventListener("pointerdown", onOutsidePointerDown, true);
      document.removeEventListener("keydown", onDocumentKeyDown);
      clearCloseTimer();
      for (const cleanup of floatingCleanups.values()) cleanup();
      floatingCleanups.clear();
    };
  };

  return {
    openPath,
    openAt,
    toggleAt,
    closeFrom,
    isOpen,
    keepOpen,
    scheduleClose,
    closeAll,
    setTriggerRef,
    setMenuRef,
    onParentPointerEnter,
    onParentPointerLeave,
    onParentPointerDown,
    onParentClick,
    onMount,
  };
};

let localController = null;
const getController = () => {
  const fromProps = props().controller;
  if (fromProps) return fromProps;
  if (!localController) localController = createController();
  return localController;
};

const onItemClick = (item) => {
  getController().closeAll();
  const handler = props().onItemClick;
  if (typeof handler === "function") handler(item);
};

return {
  props,
  getDepth,
  getLayout,
  getItems,
  getChildren,
  getItemId,
  getTriggerColor,
  getPanelBackground,
  getHoverBackground,
  getActiveBorderColor,
  isItemActive,
  getController,
  onItemClick,
};
'''
