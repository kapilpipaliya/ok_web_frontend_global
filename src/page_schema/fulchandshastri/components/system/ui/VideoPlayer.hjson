          '''return `._id {
  width: 100%;
  height: calc(100% - 48px);
  background: ${args.theme.var.color.background_dark_900};
  position: relative;
}`;'''
        displayOrder: 2
        fns:
          '''// Create reactive store for player state
const [playerState, setPlayerState] = args.createStore({
  player: null,
  isPlayerReady: false,
  apiLoaded: false,
  isLoading: false
});

// Initialize YouTube iframe API (only when needed)
const initYouTubeAPI = () => {
  if (playerState.apiLoaded || window.YT) {
    if (!playerState.apiLoaded) {
      setPlayerState('apiLoaded', true);
      setPlayerState('isLoading', false);
    }
    return;
  }

  setPlayerState('isLoading', true);
  const tag = document.createElement('script');
  tag.src = 'https://www.youtube.com/iframe_api';
  tag.onload = () => {
    setPlayerState('apiLoaded', true);
    setPlayerState('isLoading', false);
  };
  tag.onerror = () => {
    setPlayerState('isLoading', false);
    console.error('Failed to load YouTube API');
  };
  const firstScriptTag = document.getElementsByTagName('script')[0];
  firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
};

// Watch player state and load API only when player is opened
args.createEffect(() => {
  const getPlayerState = args.contextData.props?.playerState;
  const currentState = getPlayerState?.();

  // Only load API when player is actually opened (not closed)
  if (currentState !== "closed" && !playerState.apiLoaded && !playerState.isLoading) {
    args.runWithOwner(() => {
      initYouTubeAPI();
    });
  }
});

return {
  playerState,
  setPlayer: (p) => setPlayerState('player', p),
  setPlayerReady: (ready) => {
    setPlayerState('isPlayerReady', ready);
    if (ready) {
      setPlayerState('isLoading', false);
    }
  }
};'''
        componentName: Html
        props:
          '''return {
  as: "div"
};'''
      }
    }
    {
      id: "21"
      L: Attr
      P: {
        css:
          '''return `._id {
  width: 100%;
  height: 100%;
}`;'''
        displayOrder: 1
        fns:
          '''// Watch for video changes and update player without changing iframe src
args.createEffect(() => {
  const getCurrentVideo = args.untrack(() => args.contextData.props?.currentVideo);
  const video = getCurrentVideo?.();
  const currentId = video?.P?.youtubeId || "";
  args.untrack(() => {
    const player = args.fns.playerState.player;
    const isReady = args.fns.playerState.isPlayerReady;

    if (player && isReady && currentId) {
      try {
        // Use loadVideoById to change video without creating history entry
        player.loadVideoById(currentId);
      } catch (e) {
        console.error('Error loading video:', e);
      }
    }
  });
});

return {};'''
        componentName: Html
        props:
          '''const getCurrentVideo = args.contextData.props?.currentVideo;
const video = getCurrentVideo?.();
const youtubeId = video?.P?.youtubeId || "";

return {
  as: "div",
  id: "youtube-player",
  // only onMount works, ref function not works.
  onMount: () => {
    if (args.fns.playerState.player) return;

    // Set loading state when starting player initialization
    args.fns.setPlayerReady(false);

    // Wait for YT API to be ready
    const initPlayer = () => {
      if (!args.fns.playerState.apiLoaded || !window.YT || !window.YT.Player) {
        setTimeout(initPlayer, 100);
        return;
      }

      try {
        // Create YouTube player
        // YouTube TOS: https://developers.google.com/youtube/terms/required-minimum-functionality
        // Required Minimum Functionality:
        // 1. Player controls must be visible and functional (play, pause, volume, seek)
        // 2. Fullscreen button must be available
        // 3. YouTube branding must be visible (logo/watermark)
        // 4. Link to watch on YouTube must be provided
        // 5. Related videos should be shown (rel parameter)
        const ytPlayer = new window.YT.Player("youtube-player", {
          height: '100%',
          width: '100%',
          videoId: youtubeId || '',
          playerVars: {
            autoplay: 1,
            controls: 1,  // YouTube TOS Required: Player controls (play, pause, volume, seek) must be visible
            enablejsapi: 1,
            origin: window.location.origin,
            modestbranding: 1,  // YouTube TOS Required: Minimize branding but keep YouTube logo/watermark visible
            fs: 1,  // YouTube TOS Required: Enable fullscreen button
            // rel: 1  // YouTube TOS Required: Show related videos at video end
            rel: 0  // VIOLATION: Disabled to prevent showing other channels' videos (keep this until YouTube enforces)
          },
          events: {
            onReady: (event) => {
              args.fns.setPlayerReady(true);
              args.fns.setPlayer(ytPlayer);
            },
            onStateChange: (event) => {
              // YouTube player states: 0=ended
              if (event.data === 0) {
                const getPlayerState = args.contextData.props?.playerState;
                const playNext = args.contextData.props?.playNext;
                const currentState = getPlayerState?.();
                if (currentState === "minimized" || currentState === "maximized") {
                  playNext?.();
                }
              }
            },
            onError: (event) => {
              console.error('YouTube player error:', event.data);
              // when I get error: Video unavailable
              // This video contains content from..., who has blocked it on copyright grounds
              // setPlayerReady(false) keeps it showing loading spinner:
              // args.fns.setPlayerReady(false);
            }
          }
        });
      } catch (error) {
        console.error('Failed to initialize YouTube player:', error);
        args.fns.setPlayerReady(false);
      }
    };

    initPlayer();
  },
  onCleanup: () => {
    args.fns.playerState.player.destroy();
    args.fns.setPlayerReady(false);
    args.fns.playerState.setPlayer(null);
  }
};'''
      }
    }
    {
