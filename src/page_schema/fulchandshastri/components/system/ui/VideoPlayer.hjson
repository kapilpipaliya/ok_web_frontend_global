        css:
          '''const getPlayerState = args.contextData.props?.playerState;
const state = getPlayerState?.() || "closed";
const isMinimized = state === "minimized";
const isMaximized = state === "maximized";

return `._id {
  position: fixed;
  z-index: 99;
  background: ${args.theme.var.color.background_dark_900};
  border-radius: ${isMinimized ? '0.5rem' : '0'};
  box-shadow: ${isMinimized ? '0 4px 20px rgba(0, 0, 0, 0.3)' : 'none'};
  overflow: hidden;
  transition: box-shadow 0.3s ease, border-radius 0.3s ease;
}

._id[data-state="minimized"] {
  bottom: ${args.theme.var.spacing.lg};
  right: ${args.theme.var.spacing.lg};
  width: 480px;
  height: 270px;
  min-width: 480px;
  min-height: 270px;
}

._id[data-state="maximized"] {
  top: 0 !important;
  left: 0 !important;
  right: 0;
  bottom: 0;
  width: 100vw !important;
  height: 100vh !important;
}

@media (max-width: 768px) {
  ._id[data-state="minimized"] {
    /* Remove min-width/min-height constraints on mobile */
    min-width: unset;
    min-height: unset;
    /* Max width ensures player never exceeds screen */
    max-width: calc(100vw - 16px);
  }
}`;'''
        displayOrder: 1
        fns:
          '''// State to track if resize is active
const [isResizing, setIsResizing] = args.createSignal(false);

// Get responsive values based on screen size
const getResponsiveValues = () => {
  const isMobile = window.innerWidth < 768;
  return {
    isMobile,
    minWidth: isMobile ? 280 : 480,
    minHeight: isMobile ? 158 : 270, // 16:9 aspect ratio
    maxWidth: isMobile ? window.innerWidth - 16 : window.innerWidth,
    defaultX: isMobile ? 8 : null,
    defaultY: isMobile ? 80 : null
  };
};

// Function to constrain player position within viewport bounds
const constrainPlayerPosition = () => {
  const getPlayerState = args.contextData.props?.playerState;
  const state = getPlayerState?.();
  if (state !== "minimized") return;

  const playerPosition = args.contextData.props?.playerPosition || { x: null, y: null };
  const playerSize = args.contextData.props?.playerSize || { width: 480, height: 270 };
  const setPlayerPosition = args.contextData.props?.setPlayerPosition;

  if (playerPosition.x === null || playerPosition.y === null) return;

  // Get viewport bounds
  const viewportWidth = window.innerWidth;
  const viewportHeight = window.innerHeight;

  // Calculate constrained position
  const maxX = Math.max(0, viewportWidth - playerSize.width);
  const maxY = Math.max(0, viewportHeight - playerSize.height);

  let newX = playerPosition.x;
  let newY = playerPosition.y;
  let needsUpdate = false;

  // Constrain X position
  if (newX < 0) {
    newX = 0;
    needsUpdate = true;
  } else if (newX > maxX) {
    newX = maxX;
    needsUpdate = true;
  }

  // Constrain Y position
  if (newY < 0) {
    newY = 0;
    needsUpdate = true;
  } else if (newY > maxY) {
    newY = maxY;
    needsUpdate = true;
  }

  // Update position if needed
  if (needsUpdate) {
    setPlayerPosition?.({ x: newX, y: newY });
  }
};

// Common resize handler factory
// Accepts direction: 'n', 's', 'e', 'w', 'ne', 'nw', 'se', 'sw'
const createResizeHandler = (direction) => {
  // Determine resize behavior based on direction
  const resizeWidth = direction.includes('e') ? 'add' : direction.includes('w') ? 'subtract' : null;
  const resizeHeight = direction.includes('s') ? 'add' : direction.includes('n') ? 'subtract' : null;
  const adjustX = direction.includes('w');
  const adjustY = direction.includes('n');

  return (e) => {
    const getPlayerState = args.contextData.props?.playerState;
    const state = getPlayerState?.();
    if (state !== "minimized") return;

    e.preventDefault();
    e.stopPropagation();

    // Show overlay to prevent iframe from capturing mouse events
    setIsResizing(true);

    const playerEl = e.currentTarget.parentElement;
    const rect = playerEl.getBoundingClientRect();
    const startX = e.clientX;
    const startY = e.clientY;
    const startWidth = rect.width;
    const startHeight = rect.height;
    const startLeft = rect.left;
    const startTop = rect.top;
    const setPlayerSize = args.contextData.props?.setPlayerSize;
    const setPlayerPosition = args.contextData.props?.setPlayerPosition;
    const playerPosition = args.contextData.props?.playerPosition || { x: null, y: null };

    const handleMouseMove = (moveEvent) => {
      const deltaX = moveEvent.clientX - startX;
      const deltaY = moveEvent.clientY - startY;

      let newWidth = startWidth;
      let newHeight = startHeight;
      let newX = playerPosition.x;
      let newY = playerPosition.y;

      // Get responsive values
      const { minWidth, minHeight, maxWidth } = getResponsiveValues();

      // Calculate new dimensions based on resize direction
      if (resizeWidth === 'add') {
        newWidth = Math.min(maxWidth, Math.max(minWidth, startWidth + deltaX));
      } else if (resizeWidth === 'subtract') {
        newWidth = Math.min(maxWidth, Math.max(minWidth, startWidth - deltaX));
      }

      if (resizeHeight === 'add') {
        newHeight = Math.max(minHeight, startHeight + deltaY);
      } else if (resizeHeight === 'subtract') {
        newHeight = Math.max(minHeight, startHeight - deltaY);
      }

      // Adjust position if resizing from left or top
      if (adjustX) {
        newX = startLeft + (startWidth - newWidth);
      }
      if (adjustY) {
        newY = startTop + (startHeight - newHeight);
      }

      setPlayerSize?.({ width: newWidth, height: newHeight });
      setPlayerPosition?.({ x: newX, y: newY });
    };

    const handleMouseUp = () => {
      document.removeEventListener('mousemove', handleMouseMove);
      document.removeEventListener('mouseup', handleMouseUp);
      // Hide overlay after resize completes
      setIsResizing(false);
    };

    document.addEventListener('mousemove', handleMouseMove);
    document.addEventListener('mouseup', handleMouseUp);
  };
};

// Touch resize handler for iPad/mobile support
const createTouchResizeHandler = (direction) => {
  // Determine resize behavior based on direction
  const resizeWidth = direction.includes('e') ? 'add' : direction.includes('w') ? 'subtract' : null;
  const resizeHeight = direction.includes('s') ? 'add' : direction.includes('n') ? 'subtract' : null;
  const adjustX = direction.includes('w');
  const adjustY = direction.includes('n');

  return (e) => {
    const getPlayerState = args.contextData.props?.playerState;
    const state = getPlayerState?.();
    if (state !== "minimized") return;

    e.preventDefault();
    e.stopPropagation();

    // Show overlay to prevent iframe from capturing touch events
    setIsResizing(true);

    const touch = e.touches[0];
    const playerEl = e.currentTarget.parentElement;
    const rect = playerEl.getBoundingClientRect();
    const startX = touch.clientX;
    const startY = touch.clientY;
    const startWidth = rect.width;
    const startHeight = rect.height;
    const startLeft = rect.left;
    const startTop = rect.top;
    const setPlayerSize = args.contextData.props?.setPlayerSize;
    const setPlayerPosition = args.contextData.props?.setPlayerPosition;
    const playerPosition = args.contextData.props?.playerPosition || { x: null, y: null };

    const handleTouchMove = (moveEvent) => {
      const touch = moveEvent.touches[0];
      const deltaX = touch.clientX - startX;
      const deltaY = touch.clientY - startY;

      let newWidth = startWidth;
      let newHeight = startHeight;
      let newX = playerPosition.x;
      let newY = playerPosition.y;

      // Get responsive values
      const { minWidth, minHeight, maxWidth } = getResponsiveValues();

      // Calculate new dimensions based on resize direction
      if (resizeWidth === 'add') {
        newWidth = Math.min(maxWidth, Math.max(minWidth, startWidth + deltaX));
      } else if (resizeWidth === 'subtract') {
        newWidth = Math.min(maxWidth, Math.max(minWidth, startWidth - deltaX));
      }

      if (resizeHeight === 'add') {
        newHeight = Math.max(minHeight, startHeight + deltaY);
      } else if (resizeHeight === 'subtract') {
        newHeight = Math.max(minHeight, startHeight - deltaY);
      }

      // Adjust position if resizing from left or top
      if (adjustX) {
        newX = startLeft + (startWidth - newWidth);
      }
      if (adjustY) {
        newY = startTop + (startHeight - newHeight);
      }

      setPlayerSize?.({ width: newWidth, height: newHeight });
      setPlayerPosition?.({ x: newX, y: newY });
    };

    const handleTouchEnd = () => {
      document.removeEventListener('touchmove', handleTouchMove);
      document.removeEventListener('touchend', handleTouchEnd);
      // Hide overlay after resize completes
      setIsResizing(false);
    };

    document.addEventListener('touchmove', handleTouchMove);
    document.addEventListener('touchend', handleTouchEnd);
  };
};

return {
  createResizeHandler,
  createTouchResizeHandler,
  isResizing,
  getResponsiveValues,
  constrainPlayerPosition
};'''
        componentName: Html
        props:
          '''const getPlayerState = args.contextData.props?.playerState;
const currentState = getPlayerState?.() || "closed";
const playerPosition = args.contextData.props?.playerPosition || { x: null, y: null };
const playerSize = args.contextData.props?.playerSize || { width: 480, height: 270 };

// Get responsive values from fns
const { isMobile, defaultX, defaultY } = args.fns.getResponsiveValues();
const x = playerPosition.x !== null ? playerPosition.x : defaultX;
const y = playerPosition.y !== null ? playerPosition.y : defaultY;

// Constrain width on mobile screens
let constrainedWidth = playerSize.width;
let constrainedHeight = playerSize.height;

if (isMobile && currentState === "minimized") {
  // On mobile, use available width with padding
  const availableWidth = window.innerWidth - 16; // 8px padding on each side
  constrainedWidth = Math.min(playerSize.width, availableWidth);

  // Maintain 16:9 aspect ratio
  constrainedHeight = Math.round(constrainedWidth * 9 / 16);
}

// Build inline styles for positioning
const positionStyle = currentState === "minimized" && x !== null && y !== null
  ? { left: `${x}px`, top: `${y}px`, width: `${constrainedWidth}px`, height: `${constrainedHeight}px` }
  : {};

return {
  as: "div",
  hide: () => {
    const state = getPlayerState?.();
    return state === "closed";
  },
  "data-state": currentState,
  style: positionStyle,
  onMount: () => {
    // Handle viewport resize/rotation to keep player visible
    const handleResize = () => {
      args.fns.constrainPlayerPosition();
    };

    window.addEventListener('resize', handleResize);
    window.addEventListener('orientationchange', handleResize);

    // Initial constraint check
    handleResize();
  },
  onCleanup: () => {
    const handleResize = () => {
      args.fns.constrainPlayerPosition();
    };
    window.removeEventListener('resize', handleResize);
    window.removeEventListener('orientationchange', handleResize);
  }
};'''
