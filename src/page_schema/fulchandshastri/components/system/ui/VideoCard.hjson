const item = args.contextData.props?.item;
const itemSetting = args.contextData.props?.itemSetting;
const itemType = args.contextData.props?.itemType;

// Check if this is an extension item
const isExtensionItem = item?.P?.extensionExists !== undefined;

let metaText = "";

if (itemType === "channel") {
  const subscriberCount = item?.P?.subscriberCount || 0;
  const videoCount = item?.P?.videoCount ?? 0;

  let parts = [];
  if (subscriberCount >= 1000000) {
    parts.push(`${(subscriberCount / 1000000).toFixed(1)}M subscribers`);
  } else if (subscriberCount >= 1000) {
    parts.push(`${(subscriberCount / 1000).toFixed(1)}K subscribers`);
  } else if (subscriberCount > 0) {
    parts.push(`${subscriberCount} subscriber${subscriberCount !== 1 ? 's' : ''}`);
  }

  // Don't show video count for extension items
  if (!isExtensionItem) {
    parts.push(`${videoCount} video${videoCount !== 1 ? 's' : ''}`);
  }
  metaText = parts.join(' • ');
} else if (itemType === "playlist") {
  const videoCount = item?.P?.itemCount ?? 0;
  const channelTitle = item?.P?.channelTitle || "";

  // Don't show video count for extension items
  if (!isExtensionItem) {
    metaText = `${videoCount} video${videoCount !== 1 ? 's' : ''}`;
  }

  // If there's a parent channel, show it
  if (channelTitle) {
    if (metaText) {
      metaText += ` • ${channelTitle}`;
    } else {
      metaText = channelTitle;
    }
  }
} else if (itemType === "video") {
  const channelTitle = item?.P?.channelTitle || "";
  metaText = channelTitle;
}

return {
  as: "span",
  text: metaText,
  hide: !metaText
};
'''
      }
    }
    {
