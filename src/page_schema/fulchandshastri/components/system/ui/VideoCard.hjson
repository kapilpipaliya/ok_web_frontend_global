      L: Attr
      P: {
        css:
          '''
return `._id {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}`;
'''
        displayOrder: 5
        componentName: Html
        props:
          '''
const item = args.contextData.props?.item;
const itemSetting = args.contextData.props?.itemSetting;
const note = itemSetting?.P?.note || "";
const hasNote = note.length > 0;

// Check if this is an unsaved extension item
const isExtensionItem = item?.P?.extensionExists !== undefined;
const notSaved = isExtensionItem && !item?.P?.extensionExists;

return {
  as: "div",
  hide: !hasNote || notSaved
};
'''
      }
