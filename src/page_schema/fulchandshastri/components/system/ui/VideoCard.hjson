      L: Attr
      P: {
        css:
          '''
return `._id {
  font-size: 0.75rem;
  color: ${args.theme.var.color.text};
  line-height: 1.3;
  cursor: pointer;

  &:hover {
    text-decoration: underline;
  }
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''
const item = args.contextData.props?.item;
const itemSetting = args.contextData.props?.itemSetting;
const itemType = args.contextData.props?.itemType;
const note = itemSetting?.P?.note || "";
const shouldTruncate = note.length > 30;
const displayNote = shouldTruncate ? note.substring(0, 30) + "..." : note;

return {
  as: "span",
  text: displayNote,
  onClick: (e) => {
    e.stopPropagation();
    args.fns.openNoteModal?.(item, note);
  }
};
'''
      }
