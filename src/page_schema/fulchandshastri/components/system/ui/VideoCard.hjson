        displayOrder: 1
        fns:
          '''
// Common function to get effective setting (prefers live polling data over stale itemSetting)
const getEffectiveSetting = () => {
  const item = args.contextData.props?.item;
  const itemType = args.contextData.props?.itemType;
  const processingStatus = args.contextData.props?.processingStatus;

  // Prefer processing queueStatus (live updates from polling) over item (stale data)
  return (itemType === "playlist" && processingStatus?.playlist) ||
         (itemType === "channel" && processingStatus?.channel) ||
         item;
};

return {
  getEffectiveSetting
};
'''
        componentName: Html
        props:
          '''
const containerClass = args.contextData.props?.class || "";
return {
  as: "div",
  class: containerClass,
};
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''
return `._id {
  width: 100px;
  height: 56px;
  background-color: ${args.theme.var.color.background_light_300};
  border-radius: 0.375rem;
  flex-shrink: 0;
  overflow: hidden;
  cursor: pointer;
  transition: transform 0.2s ease;
  text-decoration: none;
  display: block;
  position: relative;

  &:hover {
    transform: scale(1.05);
  }
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const item = args.contextData.props?.item;
const itemType = args.contextData.props?.itemType;

// Check if this is an extension item (has extensionExists property)
const isExtensionItem = item?.P?.extensionExists !== undefined;

const youtubeId = item?.P?.youtubeId || "";

// Priority order: stored thumbs > YouTube CDN fallback from youtubeId
const thumbnailUrl = item?.P?.thumbnailMaxres ||
                     item?.P?.thumbnailStandard ||
                     item?.P?.thumbnailHigh ||
                     item?.P?.thumbnailMedium ||
                     item?.P?.thumbnailDefault ||
                     item?.P?.thumbnailUrl ||
                     item?.P?.thumbnail ||
                     (itemType === "video" && youtubeId
                       ? `https://img.youtube.com/vi/${youtubeId}/mqdefault.jpg`
                       : "");

// Check if we're in public view and preserve those parameters
const isPublicView = args.searchParams?.page === "public";
const publicUsername = args.searchParams?.username || null;
const publicParams = isPublicView && publicUsername 
  ? `&page=public&username=${encodeURIComponent(publicUsername)}` 
  : "";

let href, target;
if (itemType === "video") {
  href = args.fns.getYouTubeUrl?.(item, itemType);
  target = "_blank";
} else if (itemType === "playlist") {
  href = `/content?type=playlists&id=${youtubeId}${publicParams}`;
  target = "_self";
} else {
  href = `/content?type=channels&id=${youtubeId}${publicParams}`;
  target = "_self";
}

return {
  as: "a",
  href: href,
  target: target,
  rel: target === "_blank" ? "noopener" : "",
  style: thumbnailUrl ? `background-image: url('${thumbnailUrl}'); background-size: cover; background-position: center;` : "",
  onClick: (e) => {
    e.preventDefault();
    e.stopPropagation();

    // Check if running in extension iframe
    const isInExtension = window.self !== window.top;

    // Check if this is an extension item that's not added yet
    const isExtensionItem = item?.P?.extensionExists !== undefined;
    const notAdded = isExtensionItem && !item?.P?.extensionExists;

    if (itemType === "video") {
      if (isInExtension) {
        // Use common function to open in parent tab when in extension
        const youtubeUrl = `https://www.youtube.com/watch?v=${youtubeId}`;
        args.fns.openYouTubeInParentTab(youtubeUrl);
      } else {
        // Use video player when in main app
        args.fns.playVideo?.(item);
      }
    } else {
      // Handle playlists and channels
      const youtubeUrl = args.fns.getYouTubeUrl?.(item, itemType);

      const contentType = itemType === "playlist" ? "playlists" : "channels";

      if (notAdded) {
        args.fns.openYouTubeInParentTab(youtubeUrl);
      } else {
        // Preserve public view parameters if in public view
        const isPublicView = args.searchParams?.page === "public";
        const publicUsername = args.searchParams?.username || null;
        const publicParams = isPublicView && publicUsername 
          ? `&page=public&username=${encodeURIComponent(publicUsername)}` 
          : "";
        args.navigate(`/content?type=${contentType}&id=${youtubeId}${publicParams}`);
      }
    }
  }
};
'''
      }
    }
