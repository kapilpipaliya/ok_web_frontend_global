      L: Attr
      P: {
        css:
          '''
return `._id {
  padding: 2rem 1rem;
  text-align: center;
  color: ${args.theme.var.color.text_light_300};
  margin: 0;
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''
const rows = args.contextData.props?.rows || [];
const emptyMessage = args.contextData.props?.emptyMessage || "No items available yet.";
return {
  as: "p",
  text: emptyMessage,
  hide: () => Array.isArray(rows) && rows.length > 0
};
'''
      }
    }
