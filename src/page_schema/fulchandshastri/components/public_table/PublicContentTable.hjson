      L: Attr
      P: {
        css:
          '''
const column = args.contextData.column || {};
const align = column.align || "left";
return `._id {
  text-align: ${align};
  font-weight: 600;
  color: ${args.theme.var.color.text};
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
