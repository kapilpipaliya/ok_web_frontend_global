{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        description: Media file card for Photo/Video/Pdf. Props: item, onOpen(item), index.
        key: GalleryFileCard
        updatedAt: 2026-07-13T18:16:26.834Z
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  width: 100%;
  text-align: left;
  padding: 0;
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.75rem;
  background: ${args.theme.var.color.background};
  overflow: hidden;
  cursor: pointer;
  text-decoration: none;
  color: inherit;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;

  &:hover {
    transform: translateY(-2px);
    border-color: ${args.theme.var.color.primary_light_300};
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }

  &:focus-visible {
    outline: 2px solid ${args.theme.var.color.primary};
    outline-offset: 2px;
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const item = args.contextData.props?.item || args.contextData.props || {};
const index = args.contextData.props?.index ?? args.contextData.index ?? 0;
const href = args.contextData.props?.href || item.fileUrl || "";
const onOpen = args.contextData.props?.onOpen;
return {
  as: href ? "a" : "button",
  type: href ? undefined : "button",
  href: href || undefined,
  target: href ? "_blank" : undefined,
  rel: href ? "noopener noreferrer" : undefined,
  "data-animate": "",
  ref: (el) => el && args.fns.animateOnView?.(el, { delay: index * 0.05 }),
  onClick: (e) => {
    if (!onOpen) return;
    e.preventDefault();
    onOpen(item);
  }
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  background: ${args.theme.var.color.background_light_200};
  overflow: hidden;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''return `._id {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease;

  button:hover & {
    transform: scale(1.04);
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const item = args.contextData.props?.item || args.contextData.props || {};
const src = item.previewUrl || "";
return {
  as: src ? "img" : "fragment",
  src: src || undefined,
  alt: item.title || "Gallery item",
  loading: "lazy"
};'''
      }
    }
