{
  vertexes: [
    {
      id: "1",
      L: "Component",
      P: {
        key: "GalleryPreviewModal",
        description: "Gallery preview modal with Carousel prev/next. Props: isOpen, items, startIndex, onClose."
      }
    },
    {
      id: "overlay",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: args.contextData.props?.isOpen !== true,
  onClick: (e) => {
    if (e.target === e.currentTarget) args.contextData.props?.onClose?.();
  }
};
''',
        css: '''
return `._id {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(4px);
}`;
'''
      }
    },
    {
      id: "dialog",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  role: "dialog",
  "aria-modal": "true"
};
''',
        css: '''
return `._id {
  width: 100%;
  max-width: 960px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  background: ${args.theme.var.color.background};
  border-radius: 0.75rem;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
}`;
'''
      }
    },
    {
      id: "header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return { as: "div" };
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.875rem 1rem;
  border-bottom: 1px solid ${args.theme.var.color.border};
  flex-shrink: 0;
}`;
'''
      }
    },
    {
      id: "headerTitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const items = Array.isArray(args.contextData.props?.items) ? args.contextData.props.items : [];
const startIndex = Math.max(0, Number(args.contextData.props?.startIndex) || 0);
const count = items.length;
return {
  as: "h2",
  text: count > 0 ? `Gallery preview (${Math.min(startIndex + 1, count)} / ${count})` : "Gallery preview"
};
''',
        css: '''
return `._id {
  margin: 0;
  font-size: 1.125rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "closeBtn",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "button",
  type: "button",
  "aria-label": "Close",
  onClick: () => args.contextData.props?.onClose?.()
};
''',
        css: '''
return `._id {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border: none;
  border-radius: 0.375rem;
  background: transparent;
  color: ${args.theme.var.color.text};
  cursor: pointer;

  &:hover {
    background: ${args.theme.var.color.background_light_200};
  }
}`;
'''
      }
    },
    {
      id: "closeIcon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "ph:x",
  width: 18,
  height: 18
};
'''
      }
    },
    {
      id: "body",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return { as: "div" };
''',
        css: '''
return `._id {
  flex: 1;
  min-height: 0;
  overflow: auto;
  padding: 1rem;
}`;
'''
      }
    },
    {
      id: "carousel",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Carousel",
        props: '''
const items = Array.isArray(args.contextData.props?.items) ? args.contextData.props.items : [];
const rawIndex = Number(args.contextData.props?.startIndex);
const startIndex = Number.isFinite(rawIndex)
  ? Math.min(Math.max(0, Math.floor(rawIndex)), Math.max(0, items.length - 1))
  : 0;
return {
  data: items,
  contextName: "gallerySlide",
  loop: true,
  showArrows: true,
  showDots: true,
  options: { startIndex },
  hide: items.length === 0
};
'''
      }
    },
    {
      id: "slide",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return { as: "div" };
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
  min-width: 0;
  padding: 0 0.25rem;
}`;
'''
      }
    },
    {
      id: "mediaWrap",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return { as: "div" };
''',
        css: '''
return `._id {
  position: relative;
  width: 100%;
  min-height: 16rem;
  max-height: 62vh;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0.5rem;
  overflow: hidden;
  background: ${args.theme.var.color.background_light_100};
}`;
'''
      }
    },
    {
      id: "photoPreview",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.gallerySlide || {};
const isPhoto = (item.mediaType || "Photo") === "Photo";
const src = item.fileUrl || item.previewUrl || "";
return {
  as: isPhoto && src ? "img" : "fragment",
  src: src || undefined,
  alt: item.title || "Photo",
  loading: "lazy"
};
''',
        css: '''
return `._id {
  width: 100%;
  max-height: 62vh;
  object-fit: contain;
  display: block;
}`;
'''
      }
    },
    {
      id: "videoPreview",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const item = args.contextData.gallerySlide || {};
const isVideo = item.mediaType === "Video";
const src = item.fileUrl || "";
return {
  as: isVideo && src ? "video" : "fragment",
  src: src || undefined,
  controls: true,
  playsinline: true
};
''',
        css: '''
return `._id {
  width: 100%;
  max-height: 62vh;
  background: ${args.theme.var.color.background_dark_900};
}`;
'''
      }
    },
    {
      id: "pdfPreview",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const item = args.contextData.gallerySlide || {};
const isPdf = item.mediaType === "Pdf";
const src = item.fileUrl || "";
return {
  as: isPdf && src ? "iframe" : "fragment",
  src: src || undefined,
  title: item.title || "PDF preview"
};
''',
        css: '''
return `._id {
  width: 100%;
  min-height: 62vh;
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.5rem;
  background: ${args.theme.var.color.background_light_50};
}`;
'''
      }
    },
    {
      id: "typeBadge",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
const item = args.contextData.gallerySlide || {};
return {
  as: "span",
  text: item.mediaType || "File"
};
''',
        css: '''
return `._id {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
  padding: 0.2rem 0.5rem;
  border-radius: 0.25rem;
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
  border: 1px solid ${args.theme.var.color.border};
}`;
'''
      }
    },
    {
      id: "slideTitle",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const item = args.contextData.gallerySlide || {};
return {
  as: "h3",
  text: item.title || "Untitled"
};
''',
        css: '''
return `._id {
  margin: 0;
  font-size: 1.0625rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "slideDescription",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const item = args.contextData.gallerySlide || {};
return {
  as: "p",
  text: item.description || "",
  hide: !item.description
};
''',
        css: '''
return `._id {
  margin: 0;
  color: ${args.theme.var.color.text_light_200};
  font-size: 0.9375rem;
  line-height: 1.5;
}`;
'''
      }
    },
    {
      id: "slideActions",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
const item = args.contextData.gallerySlide || {};
return {
  as: "div",
  hide: !item.fileUrl
};
''',
        css: '''
return `._id {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}`;
'''
      }
    },
    {
      id: "openLink",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.gallerySlide || {};
return {
  as: "a",
  href: item.fileUrl || "#",
  target: "_blank",
  rel: "noopener noreferrer",
  text: "Open / Download"
};
''',
        css: '''
return `._id {
  display: inline-flex;
  align-items: center;
  padding: 0.5rem 1rem;
  border-radius: 0.375rem;
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  text-decoration: none;
  font-weight: 600;
  font-size: 0.875rem;

  &:hover {
    background: ${args.theme.var.color.primary_dark_200};
  }
}`;
'''
      }
    },
    {
      id: "emptyState",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const items = Array.isArray(args.contextData.props?.items) ? args.contextData.props.items : [];
return {
  as: "p",
  text: "No files to preview.",
  hide: items.length > 0
};
''',
        css: '''
return `._id {
  margin: 0;
  text-align: center;
  color: ${args.theme.var.color.text_light_300};
  padding: 2rem 1rem;
}`;
'''
      }
    }
  ],
  edges: [
    { id: "e1", T: "Attr", S: "1", E: "overlay" },
    { id: "e2", T: "Attr", S: "overlay", E: "dialog" },
    { id: "e3", T: "Attr", S: "dialog", E: "header" },
    { id: "e4", T: "Attr", S: "header", E: "headerTitle" },
    { id: "e5", T: "Attr", S: "header", E: "closeBtn" },
    { id: "e6", T: "Attr", S: "closeBtn", E: "closeIcon" },
    { id: "e7", T: "Attr", S: "dialog", E: "body" },
    { id: "e8", T: "Attr", S: "body", E: "carousel" },
    { id: "e9", T: "Attr", S: "carousel", E: "slide" },
    { id: "e10", T: "Attr", S: "slide", E: "mediaWrap" },
    { id: "e11", T: "Attr", S: "mediaWrap", E: "photoPreview" },
    { id: "e12", T: "Attr", S: "mediaWrap", E: "videoPreview" },
    { id: "e13", T: "Attr", S: "mediaWrap", E: "pdfPreview" },
    { id: "e14", T: "Attr", S: "mediaWrap", E: "typeBadge" },
    { id: "e15", T: "Attr", S: "slide", E: "slideTitle" },
    { id: "e16", T: "Attr", S: "slide", E: "slideDescription" },
    { id: "e17", T: "Attr", S: "slide", E: "slideActions" },
    { id: "e18", T: "Attr", S: "slideActions", E: "openLink" },
    { id: "e19", T: "Attr", S: "body", E: "emptyState" }
  ]
}
