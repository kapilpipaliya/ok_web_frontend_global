    {
      id: "8"
      L: Attr
      P: {
        css:
          '''return `._id {
  flex: 1;
  min-height: 0;
  overflow: auto;
  padding: 1rem;
}`;'''
        displayOrder: 2
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Carousel
        props:
          '''const items = Array.isArray(args.contextData.props?.items) ? args.contextData.props.items : [];
const rawIndex = Number(args.contextData.props?.startIndex);
const startIndex = Number.isFinite(rawIndex)
  ? Math.min(Math.max(0, Math.floor(rawIndex)), Math.max(0, items.length - 1))
  : 0;
return {
  data: items,
  contextName: "gallerySlide",
  loop: true,
  showArrows: true,
  showDots: true,
  options: { startIndex },
  hide: items.length === 0
};'''
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
  min-width: 0;
  padding: 0 0.25rem;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        css:
          '''return `._id {
  position: relative;
  width: 100%;
  min-height: 16rem;
  max-height: 62vh;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0.5rem;
  overflow: hidden;
  background: ${args.theme.var.color.background_light_100};
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "12"
      L: Attr
      P: {
        css:
          '''return `._id {
  width: 100%;
  max-height: 62vh;
  object-fit: contain;
  display: block;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const item = args.contextData.gallerySlide || {};
const isPhoto = (item.mediaType || "Photo") === "Photo";
const src = item.fileUrl || item.previewUrl || "";
return {
  as: isPhoto && src ? "img" : "fragment",
  src: src || undefined,
  alt: item.title || "Photo",
  loading: "lazy"
};'''
      }
    }
    {
      id: "13"
      L: Attr
      P: {
        css:
          '''return `._id {
  width: 100%;
  max-height: 62vh;
  background: ${args.theme.var.color.background_dark_900};
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const item = args.contextData.gallerySlide || {};
const isVideo = item.mediaType === "Video";
const src = item.fileUrl || "";
return {
  as: isVideo && src ? "video" : "fragment",
  src: src || undefined,
  controls: true,
  playsinline: true
};'''
      }
    }
    {
      id: "14"
      L: Attr
      P: {
        css:
          '''return `._id {
  width: 100%;
  min-height: 62vh;
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.5rem;
  background: ${args.theme.var.color.background_light_50};
}`;'''
        displayOrder: 3
        componentName: Html
        props:
          '''const item = args.contextData.gallerySlide || {};
const isPdf = item.mediaType === "Pdf";
const src = item.fileUrl || "";
return {
  as: isPdf && src ? "iframe" : "fragment",
  src: src || undefined,
  title: item.title || "PDF preview"
};'''
      }
    }
