  border-radius: 0.75rem;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  role: "dialog",
  "aria-modal": "true"
};'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.875rem 1rem;
  border-bottom: 1px solid ${args.theme.var.color.border};
  flex-shrink: 0;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id {
  margin: 0;
  font-size: 1.125rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const items = Array.isArray(args.contextData.props?.items) ? args.contextData.props.items : [];
const startIndex = Math.max(0, Number(args.contextData.props?.startIndex) || 0);
const count = items.length;
return {
  as: "h2",
  text: count > 0 ? `Gallery preview (${Math.min(startIndex + 1, count)} / ${count})` : "Gallery preview"
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border: none;
  border-radius: 0.375rem;
  background: transparent;
  color: ${args.theme.var.color.text};
  cursor: pointer;

  &:hover {
    background: ${args.theme.var.color.background_light_200};
  }
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "button",
  type: "button",
  "aria-label": "Close",
  onClick: () => args.contextData.props?.onClose?.()
};'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
