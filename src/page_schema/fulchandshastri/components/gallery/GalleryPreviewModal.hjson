      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(4px);
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  hide: args.contextData.props?.isOpen !== true,
  onClick: (e) => {
    if (e.target === e.currentTarget) args.contextData.props?.onClose?.();
  }
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  width: 100%;
  max-width: 960px;
  max-height: 90vh;
