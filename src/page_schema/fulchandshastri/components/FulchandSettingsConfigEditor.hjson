        props: '''
const index = args.contextData.configSectionItem;
const section = args.fns.getSectionAt?.(index) || {};
return {
  as: "div",
  class: "fsce-section-item",
  role: "button",
  tabIndex: 0,
  onClick: () => args.fns.selectSection?.(section.id),
  onKeyDown: (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      args.fns.selectSection?.(section.id);
    }
  },
  ref: (element) => {
    if (element && typeof index === "number" && args.fns.attachSectionDropTarget) {
      args.fns.attachSectionDropTarget(element, index);
