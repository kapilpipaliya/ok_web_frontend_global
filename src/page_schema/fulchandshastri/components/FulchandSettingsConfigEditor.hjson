};
''',
        css: '''
const index = args.contextData.configSectionItem;
const section = args.fns.getSectionAt?.(index) || {};
const active = args.fns.selectedSectionId?.() === section.id;
const dragOver = args.fns.dragOverSectionIndex?.() === index;
const dragging = args.fns.draggedSectionIndex?.() === index;
const fieldDragOver = args.fns.dragOverSectionIdForField?.() === section.id;
return `._id.fsce-section-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 0.375rem;
  width: 100%;
  padding: 0.5rem;
  border-radius: 0.375rem;
  border: 1px solid ${active ? args.theme.var.color.primary : args.theme.var.color.border};
  background: ${active ? args.theme.var.color.primary_light_100 : args.theme.var.color.background};
  cursor: pointer;
  box-sizing: border-box;
  flex-shrink: 0;
  ${dragOver ? `outline: 2px dashed ${args.theme.var.color.primary};` : ""}
  ${fieldDragOver ? `outline: 2px dashed ${args.theme.var.color.success}; background: ${args.theme.var.color.success_light_100};` : ""}
  ${dragging ? "opacity: 0.5;" : ""}

  .fsce-section-drag-handle {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s ease, visibility 0.15s ease;
  }

  &:hover .fsce-section-drag-handle {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  ${dragging ? `
  & .fsce-section-drag-handle {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }` : ""}
}`;
'''
      }
    },
    {
      id: "fsce_section_drag",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const index = args.contextData.configSectionItem;
return {
  as: "div",
  class: "fsce-section-drag-handle",
  role: "presentation",
  onClick: (e) => e.stopPropagation?.(),
  onMouseDown: (e) => e.stopPropagation?.(),
  ref: (element) => {
    if (element && typeof index === "number" && args.fns.attachSectionDraggable) {
      args.fns.attachSectionDraggable(element, index);
    }
  }
};
'''
        css: '''
return `._id.fsce-section-drag-handle {
