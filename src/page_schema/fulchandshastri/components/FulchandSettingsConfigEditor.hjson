return {
  as: "div",
  class: `fsce-field-item${dropBefore ? " fsce-field-drop-before" : ""}${dropAfter ? " fsce-field-drop-after" : ""}`,
  role: "button",
  tabIndex: 0,
  onClick: () => args.fns.selectField?.(index),
  onKeyDown: (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      args.fns.selectField?.(index);
    }
  },
  ref: (element) => {
    if (element && typeof index === "number" && args.fns.attachFieldDropTarget) {
      args.fns.attachFieldDropTarget(element, index);
    }
  }
};
