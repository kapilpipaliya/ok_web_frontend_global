        css: '''
const index = args.contextData.configFieldItem;
const active = args.fns.selectedFieldIndex?.() === index;
const dragSource = args.fns.fieldDragSource?.();
const dragging =
  args.fns.draggedFieldIndex?.() === index &&
  dragSource?.sectionId === args.fns.selectedSectionId?.() &&
  dragSource?.index === index;
return `._id.fsce-field-item {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.625rem 0.75rem;
  border-radius: 0.375rem;
  border: 1px solid ${active ? args.theme.var.color.primary : args.theme.var.color.border};
  background: ${active ? args.theme.var.color.primary_light_50 : args.theme.var.color.background};
  cursor: pointer;
  box-sizing: border-box;
  flex-shrink: 0;
  ${dragging ? "opacity: 0.5;" : ""}

  .fsce-field-drag-handle {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s ease, visibility 0.15s ease;
  }

  &:hover .fsce-field-drag-handle {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  ${dragging ? `
  & .fsce-field-drag-handle {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }` : ""}
}

._id.fsce-field-drop-before::before {
  content: "";
  position: absolute;
  left: 0.5rem;
  right: 0.5rem;
  top: 0;
  height: 2px;
  background: ${args.theme.var.color.primary};
  border-radius: 9999px;
  transform: translateY(-50%);
  z-index: 2;
  pointer-events: none;
  box-shadow: 0 0 0 1px ${args.theme.var.color.primary_light_200};
}

._id.fsce-field-drop-before::after {
  content: "";
  position: absolute;
  left: 0.25rem;
  top: 0;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: ${args.theme.var.color.primary};
  transform: translateY(-50%);
  z-index: 2;
  pointer-events: none;
}

._id.fsce-field-drop-after::before {
  content: "";
  position: absolute;
  left: 0.5rem;
  right: 0.5rem;
  bottom: 0;
  height: 2px;
  background: ${args.theme.var.color.primary};
  border-radius: 9999px;
  transform: translateY(50%);
  z-index: 2;
  pointer-events: none;
  box-shadow: 0 0 0 1px ${args.theme.var.color.primary_light_200};
}

._id.fsce-field-drop-after::after {
  content: "";
  position: absolute;
  left: 0.25rem;
  bottom: 0;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: ${args.theme.var.color.primary};
  transform: translateY(50%);
  z-index: 2;
  pointer-events: none;
}`;
'''
