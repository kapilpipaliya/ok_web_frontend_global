  value: field?.defaultValue != null && typeof field.defaultValue === "object" ? field.defaultValue : {},
  multiline: (args.fns.getFieldEditorFormP?.()?.renderer ?? field?.renderer) === "textArea",
  onChange: (nextValue) => args.fns.updateFieldDefaultLocalized?.(nextValue)
};
