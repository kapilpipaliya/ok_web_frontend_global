{
  vertexes: [
    {
      id: "fcl_root",
      L: "Component",
      P: {
        key: "FullChandLayout",
        description: "Shared layout with header, page content slot, and footer for Fulchand Shastri pages",
        fns: '''
const prefersReducedMotion = () =>
  window.matchMedia("(prefers-reduced-motion: reduce)").matches;

const waitForMotion = (callback, attempts = 80) => {
  const motion = window.__motion;
  if (motion?.inView && motion?.animate) {
    callback(motion);
    return;
  }
  if (attempts <= 0) return;
  setTimeout(() => waitForMotion(callback, attempts - 1), 50);
};

const applyInitialState = (el, state) => {
  if (state.opacity) {
    el.style.opacity = "0";
  }
  const parts = [];
  if (state.x) parts.push(`translateX(${state.x}px)`);
  if (state.y) parts.push(`translateY(${state.y}px)`);
  if (state.scale !== 1) parts.push(`scale(${state.scale})`);
  if (state.rotate) parts.push(`rotate(${state.rotate}deg)`);
  if (parts.length) {
    el.style.transform = parts.join(" ");
  }
};

const animateOnView = (el, options = {}) => {
  if (!el || el.dataset.motionInit) return;

  const {
    opacity = true,
    x = 0,
    y = 24,
    scale = 1,
    rotate = 0,
    duration = 0.55,
    delay = 0,
    easing = "easeOut",
    amount = 0.15,
    margin = "0px 0px -80px 0px"
  } = options;

  if (prefersReducedMotion()) {
    el.dataset.motionInit = "true";
    el.style.opacity = "1";
    return;
  }

  applyInitialState(el, { opacity, x, y, scale, rotate });
  el.dataset.motionInit = "true";

  waitForMotion((motion) => {
    if (!motion) {
      el.style.opacity = "1";
      el.style.transform = "";
      return;
    }

    const keyframes = {};

    if (opacity) {
      keyframes.opacity = [0, 1];
    }

    if (x) {
      keyframes.x = [x, 0];
    }

    if (y) {
      keyframes.y = [y, 0];
    }

    if (scale !== 1) {
      keyframes.scale = [scale, 1];
    }

    if (rotate) {
      keyframes.rotate = [rotate, 0];
    }

    if (Object.keys(keyframes).length === 0) return;

    motion.inView(
      el,
      () => {
        motion.animate(el, keyframes, {
          duration,
          delay,
          easing
        });
      },
      {
        amount,
        margin
      }
    );
  });
};

return {
  animateOnView,
  executeYTOFunction: (functionName, contextData) =>
    args.executeNamedServerFunction({
      functionName,
      contextData: contextData || {}
    })
};
'''
      }
    },
    {
      id: "fcl_motion_style",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "style",
  text: `[data-animate]:not([data-motion-init]) { opacity: 0; }

@media (prefers-reduced-motion: reduce) {
  [data-animate] { opacity: 1; }
}`
};
'''
      }
    },
    {
      id: "fcl_motion_script",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "script",
  type: "module",
  text: `import { animate, scroll, inView } from "https://cdn.jsdelivr.net/npm/motion@latest/+esm";
window.__motion = { animate, scroll, inView };`
};
'''
      }
    },
    {
      id: "fcl_shell",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: ${args.theme.var.color.background};
}`;
'''
      }
    },
    {
      id: "fcl_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "FullChandHeader",
        props: '''
return {};
'''
      }
    },
    {
      id: "fcl_main",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  "data-fulchand-page-main": ""
};
''',
        css: '''
return `._id {
  flex: 1;
  width: 100%;
}`;
'''
      }
    },
    {
      id: "fcl_settings_editor",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "FullChandPageSettingsEditor"
      }
    },
    {
      id: "fcl_slot",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Slot"
      }
    },
    {
      id: "fcl_confirm",
      L: "Attr",
      P: {
        displayOrder: 5,
        componentName: "ConfirmProvider"
      }
    },
    {
      id: "fcl_footer",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "FullChandFooter",
        props: '''
return {};
'''
      }
    }
  ],
  edges: [
    { id: "fcl_e0", T: "Attr", S: "fcl_root", E: "fcl_motion_style" },
    { id: "fcl_e0b", T: "Attr", S: "fcl_root", E: "fcl_motion_script" },
    { id: "fcl_e1", T: "Attr", S: "fcl_root", E: "fcl_shell" },
    { id: "fcl_e2", T: "Attr", S: "fcl_shell", E: "fcl_header" },
    { id: "fcl_e3", T: "Attr", S: "fcl_shell", E: "fcl_main" },
    { id: "fcl_e4", T: "Attr", S: "fcl_shell", E: "fcl_footer" },
    { id: "fcl_e4b", T: "Attr", S: "fcl_root", E: "fcl_confirm" },
    { id: "fcl_e5", T: "Attr", S: "fcl_root", E: "fcl_settings_editor" },
    { id: "fcl_e6", T: "Attr", S: "fcl_main", E: "fcl_slot" }
  ]
}
