{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        isNoPermissionCheck: true
        fns: return { enabled: () => true }
        key: FeatureCard
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''
return `._id {
  background: ${args.theme.var.color.background};
  border: 1px solid ${args.theme.var.color.background_light_300};
  border-radius: 0.75rem;
  padding: 2rem;
  transition: all 0.3s ease;

  &:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    transform: translateY(-4px);
    border-color: ${args.theme.var.color.primary_light_300};
  }
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const feature = args.contextData.props || {};
const index = args.contextData.index ?? 0;
return {
  as: "div",
  "data-animate": "",

  ref: (el) => el && args.fns.animateOnView(el, { delay: index * 0.08 })
};
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''
return `._id {
  width: 4rem;
  height: 4rem;
  background: ${args.theme.var.color.primary_light_100};
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1.5rem;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const feature = args.contextData.props || {};
const showIcon = feature.icon ? true : false;
return {
  as: showIcon ? "div" : "fragment"
};
'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''
return `._id {
  color: ${args.theme.var.color.primary};
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const feature = args.contextData.props || {};
return {
  as: "icon",
  icon: feature.icon || "carbon:star",
  width: 32,
  height: 32
};
'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''
return `._id {
  margin-bottom: 1.5rem;
  border-radius: 0.5rem;
  overflow: hidden;
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''
const feature = args.contextData.props || {};
