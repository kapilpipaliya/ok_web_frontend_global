return {
  as: showImage ? "div" : "fragment"
};
'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          '''
return `._id {
  width: 100%;
  height: auto;
  display: block;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const feature = args.contextData.props || {};
return {
  as: "img",
  src: feature.image || "",
  alt: feature.title || "Feature image",
  width: "100%"
};
'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''
return `._id {
  text-align: ${args.contextData.props?.align || 'left'};
}`;
'''
        displayOrder: 3
        componentName: Html
        props:
          '''
return {
  as: "div"
};
'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        css:
          '''
return `._id {
  color: ${args.theme.var.color.text};
  font-size: 1.5rem;
  font-weight: 600;
  margin: 0 0 1rem 0;
  line-height: 1.4;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const feature = args.contextData.props || {};
return {
  as: "h3",
  text: feature.title || "Feature Title"
};
'''
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        css:
          '''
return `._id {
  color: ${args.theme.var.color.text_light_200};
  font-size: 1rem;
  line-height: 1.7;
  margin: 0 0 1rem 0;
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''
const feature = args.contextData.props || {};
return {
  as: "p",
  text: feature.description || "Feature description goes here."
};
'''
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        css:
          '''
return `._id {
  margin-top: 1.5rem;
}`;
'''
        displayOrder: 3
        componentName: Html
        props:
          '''
const feature = args.contextData.props || {};
const showLink = feature.link ? true : false;
return {
  as: showLink ? "div" : "fragment"
};
'''
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        css:
          '''
return `._id {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: ${args.theme.var.color.primary};
  text-decoration: none;
  font-weight: 500;
  transition: all 0.2s ease;

  &:hover {
    gap: 0.75rem;
    text-decoration: underline;
  }
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const feature = args.contextData.props || {};
const localizeHref = (path) => {
  if (!path || path.startsWith("http") || path.startsWith("mailto:") || path === "#") return path || "#";
  const lang = args.params?.lang;
  const code = lang && /^[a-z]{2,3}$/i.test(String(lang)) ? String(lang).toLowerCase() : "en";
  if (path === "/") return `/${code}`;
  const normalized = path.startsWith("/") ? path : `/${path}`;
  return `/${code}${normalized}`;
};
return {
  as: "a",
  href: localizeHref(feature.link),
  text: feature.linkText || "Learn More"
};
'''
      }
    }
    {
      id: "12"
      L: Attr
      P: {
