      id: "15"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  background: ${args.theme.var.color.background_light_200};
  color: ${args.theme.var.color.text};
  border: 1px solid ${args.theme.var.color.background_light_400};
  border-radius: 0.375rem;
  text-decoration: none;
