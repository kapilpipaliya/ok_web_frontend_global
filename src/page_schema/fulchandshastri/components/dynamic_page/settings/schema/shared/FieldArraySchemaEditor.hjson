      id: "faf_item_field_delete",
      L: "Attr",
      P: {
        displayOrder: 5,
        componentName: "IconButton",
        props: '''
const index = args.contextData.fafItemFieldIndex;
return {
  icon: "ph:trash",
  variant: "danger",
  size: "sm",
  title: "Remove item field",
  onClick: () => args.fns.deleteItemField?.(index)
};
'''
      }
    }
