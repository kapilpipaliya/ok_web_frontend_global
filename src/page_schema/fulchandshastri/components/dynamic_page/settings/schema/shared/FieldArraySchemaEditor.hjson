}`;
'''
      }
    },
    {
      id: "faf_item_field_loop",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "fafItemFieldIndex",
        loop: true,
        props: '''
return {
  data: args.fns.getItemFieldIndices?.() || []
};
'''
      }
    },
    {
      id: "faf_item_field_row",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return { as: "div", class: "faf-item-field-row" };
''',
        css: '''
return `._id.faf-item-field-row {
  display: grid;
  grid-template-columns: minmax(5rem, 1fr) minmax(6rem, 1.2fr) minmax(6rem, 1fr) auto auto;
  gap: 0.5rem;
  align-items: end;
  padding: 0.625rem;
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.375rem;
  background: ${args.theme.var.color.background_light_50};

  @media (max-width: 768px) {
    grid-template-columns: 1fr;
  }
}`;
'''
      }
    },
    {
      id: "faf_item_field_key",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "TextInput",
        props: '''
const index = args.contextData.fafItemFieldIndex;
const itemField = args.fns.getItemFieldAt?.(index) || {};
return {
  label: "Key",
  value: itemField.key || "",
  onChange: (e) => args.fns.updateItemFieldAt?.(index, { key: e.target.value })
};
'''
      }
    },
    {
      id: "faf_item_field_label",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "TextInput",
        props: '''
const index = args.contextData.fafItemFieldIndex;
const itemField = args.fns.getItemFieldAt?.(index) || {};
return {
  label: "Label",
  value: itemField.label || "",
  onChange: (e) => args.fns.updateItemFieldAt?.(index, { label: e.target.value })
};
'''
      }
    },
    {
      id: "faf_item_field_renderer_wrap",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return { as: "div", class: "faf-renderer-wrap" };
''',
        css: '''
return `._id.faf-renderer-wrap {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}`;
'''
      }
    },
    {
      id: "faf_item_field_renderer_label",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "label",
  text: "Renderer",
  class: "faf-field-label"
};
''',
        css: '''
return `._id.faf-field-label {
  font-size: 0.75rem;
  font-weight: 500;
  color: ${args.theme.var.color.muted};
}`;
'''
      }
    },
    {
      id: "faf_item_field_renderer",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const index = args.contextData.fafItemFieldIndex;
const itemField = args.fns.getItemFieldAt?.(index) || {};
const renderer = itemField.renderer || "text";
return {
  as: "select",
  class: "faf-renderer-select",
  value: renderer,
  onChange: (e) => {
    const nextRenderer = e.target.value;
    const dataType = nextRenderer === "checkbox" ? "boolean" : "text";
    args.fns.updateItemFieldAt?.(index, {
      renderer: nextRenderer,
      dataType,
      translatable: nextRenderer === "text" || nextRenderer === "textArea"
    });
  }
};
''',
        css: '''
return `._id.faf-renderer-select {
  width: 100%;
  padding: 0.5rem 0.625rem;
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.375rem;
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
  font-size: 0.8125rem;
}`;
'''
      }
    },
    {
      id: "faf_renderer_opt_text",
      L: "Attr",
