return { as: "div", class: "faf-required-wrap" };
''',
        css: '''
return `._id.faf-required-wrap {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  padding-bottom: 0.5rem;
  white-space: nowrap;
}`;
'''
      }
    },
    {
      id: "faf_item_field_required",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const index = args.contextData.fafItemFieldIndex;
const itemField = args.fns.getItemFieldAt?.(index) || {};
return {
  as: "input",
  type: "checkbox",
  checked: itemField.required === true,
  onChange: (e) => args.fns.updateItemFieldAt?.(index, { required: e.target.checked })
};
'''
      }
    },
    {
      id: "faf_item_field_required_text",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "span",
  text: "Required",
  class: "faf-required-text"
};
''',
        css: '''
return `._id.faf-required-text {
  font-size: 0.75rem;
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "faf_item_field_translatable_wrap",
      L: "Attr",
      P: {
        displayOrder: 5,
        componentName: "Html",
        props: '''
const index = args.contextData.fafItemFieldIndex;
const itemField = args.fns.getItemFieldAt?.(index) || {};
const isTextField = itemField.renderer === "text" || itemField.renderer === "textArea";
return {
  as: "div",
  hide: !isTextField,
  class: "faf-translatable-wrap"
};
''',
        css: '''
return `._id.faf-translatable-wrap {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  padding-bottom: 0.5rem;
  white-space: nowrap;
}`;
'''
      }
    },
    {
      id: "faf_item_field_translatable",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const index = args.contextData.fafItemFieldIndex;
const itemField = args.fns.getItemFieldAt?.(index) || {};
return {
  as: "input",
  type: "checkbox",
  checked: itemField.translatable !== false,
  onChange: (e) => args.fns.updateItemFieldAt?.(index, { translatable: e.target.checked })
};
'''
      }
    },
    {
      id: "faf_item_field_translatable_text",
      L: "Attr",
      P: {
        displayOrder: 2,
