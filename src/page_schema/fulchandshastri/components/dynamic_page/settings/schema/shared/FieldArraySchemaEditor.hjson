  font-weight: 600;
}`;
'''
      }
    },
    {
      id: "faf_add_item_field_btn",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Button",
        props: '''
return {
  variant: "secondary",
  size: "sm",
  text: "Add field",
  type: "button",
  onClick: () => args.fns.addItemField?.()
};
'''
      }
    },
    {
      id: "faf_item_fields_list",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return { as: "div", class: "faf-item-fields-list" };
''',
        css: '''
return `._id.faf-item-fields-list {
