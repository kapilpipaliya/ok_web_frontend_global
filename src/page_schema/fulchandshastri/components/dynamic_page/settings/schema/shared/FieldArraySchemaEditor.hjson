{
  vertexes: [
    {
      id: "faf_root",
      L: "Component",
      P: {
        key: "FieldArraySchemaEditor",
        description: "Visual editor for fieldArray schema config and item fields (schema only).",
        dynamicComponent: "TextInput, Button, IconButton, Html",
        fns: '''
const getProps = () => args.contextData.props || {};
const getField = () => getProps().field || {};
const DEFAULT_SITE_LANGUAGES = [
  { code: "en", label: "English", isDefault: true },
  { code: "hi", label: "Hindi", isDefault: false },
  { code: "gu", label: "Gujarati", isDefault: false }
];
const getSiteLanguages = () => {
  const languages = getProps().siteLanguages;
  if (Array.isArray(languages) && languages.length > 0) return languages;
  return DEFAULT_SITE_LANGUAGES;
};

const isTextRenderer = (renderer) => renderer === "text" || renderer === "textArea";

const emitPatch = (patch) => {
  const onChange = getProps().onChange;
  if (typeof onChange === "function") onChange(patch);
};

const defaultConfig = () => ({
  itemLabel: "Item",
  addButtonLabel: "Add item",
  itemFields: [
    { key: "title", label: "Title", dataType: "text", renderer: "text", required: true, translatable: true }
  ]
});

const getConfig = () => {
  const config = getField().fieldArrayConfig;
  if (!config || typeof config !== "object") return defaultConfig();
  return {
    ...defaultConfig(),
    ...config,
    itemFields: Array.isArray(config.itemFields) ? config.itemFields.map((f) => ({ ...f })) : defaultConfig().itemFields
  };
};

const getItemFields = () => {
  const fields = getConfig().itemFields;
  return Array.isArray(fields) ? fields.map((field) => ({ ...field })) : [];
};

const getItemFieldIndices = () => {
  const fields = getItemFields();
  const indices = [];
  for (let index = 0; index < fields.length; index++) indices.push(index);
  return indices;
};

const getItemFieldAt = (index) => getItemFields()[index] || {};

const updateConfig = (partial) => {
  emitPatch({ fieldArrayConfig: { ...getConfig(), ...partial } });
};

const setItemFields = (itemFields) => updateConfig({ itemFields });

const addItemField = () => {
  const fields = getItemFields();
  setItemFields([
    ...fields,
    {
      key: `field_${Date.now()}`,
      label: "New field",
      dataType: "text",
      renderer: "text",
      translatable: true,
      required: false
    }
  ]);
};

const updateItemFieldAt = (index, partial) => {
  const fields = getItemFields();
  setItemFields(fields.map((field, i) => (i === index ? { ...field, ...partial } : field)));
};

const deleteItemField = (index) => {
  setItemFields(getItemFields().filter((_, i) => i !== index));
};

return {
  getConfig,
  getSiteLanguages,
  getItemFieldIndices,
  getItemFieldAt,
  updateConfig,
  addItemField,
  updateItemFieldAt,
  deleteItemField
};
'''
      }
    },
    {
      id: "faf_shell",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const field = args.contextData.props?.field;
return {
  as: "div",
  hide: !field || field.renderer !== "fieldArray"
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  width: 100%;
}`;
'''
      }
    },
    {
      id: "faf_config_section",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return { as: "div", class: "faf-config-section" };
''',
        css: '''
return `._id.faf-config-section {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding: 0.75rem;
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.5rem;
  background: ${args.theme.var.color.background_light_50};
}`;
'''
      }
    },
    {
      id: "faf_config_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h4",
  text: "Array settings",
  class: "faf-section-title"
};
''',
        css: '''
return `._id.faf-section-title {
  margin: 0;
  font-size: 0.8125rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "faf_config_grid",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return { as: "div", class: "faf-config-grid" };
''',
        css: '''
return `._id.faf-config-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.625rem;
  width: 100%;

  @media (max-width: 640px) {
    grid-template-columns: 1fr;
  }
}`;
'''
      }
    },
    {
      id: "faf_item_label_input",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "TextInput",
        props: '''
const config = args.fns.getConfig?.() || {};
return {
  label: "Item label",
  value: config.itemLabel || "",
  placeholder: "Item",
  onChange: (e) => args.fns.updateConfig?.({ itemLabel: e.target.value })
};
'''
      }
    },
    {
      id: "faf_add_label_input",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "TextInput",
        props: '''
const config = args.fns.getConfig?.() || {};
return {
  label: "Add button label",
  value: config.addButtonLabel || "",
  placeholder: "Add item",
  onChange: (e) => args.fns.updateConfig?.({ addButtonLabel: e.target.value })
};
'''
      }
    },
    {
      id: "faf_min_items_input",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "TextInput",
        props: '''
const config = args.fns.getConfig?.() || {};
return {
  label: "Min items",
  type: "number",
  value: config.minItems != null ? String(config.minItems) : "",
  placeholder: "0",
  onChange: (e) => {
    const raw = e.target.value;
    args.fns.updateConfig?.({
      minItems: raw === "" ? undefined : Number(raw)
    });
  }
};
'''
      }
    },
    {
      id: "faf_max_items_input",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "TextInput",
        props: '''
const config = args.fns.getConfig?.() || {};
return {
  label: "Max items",
  type: "number",
  value: config.maxItems != null ? String(config.maxItems) : "",
  placeholder: "No limit",
  onChange: (e) => {
    const raw = e.target.value;
    args.fns.updateConfig?.({
      maxItems: raw === "" ? undefined : Number(raw)
    });
  }
};
'''
      }
    },
    {
      id: "faf_item_fields_section",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
