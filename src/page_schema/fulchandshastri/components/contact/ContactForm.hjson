return {
  as: "form",
  onSubmit: (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData);
    console.log('Contact form submitted:', data);
    args.showSuccessToast('Thank you for contacting us. We will get back to you soon!');
    e.target.reset();
  }
};
'''
