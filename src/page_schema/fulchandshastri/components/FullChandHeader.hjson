    {
      id: "musicPlayer",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const headerState = args.contextData.headerState;
return {
  as: "button",
  onClick: async () => {
    const audioElement = headerState.audioRef();

    if (audioElement) {
      try {
        if (headerState.musicPlaying()) {
          audioElement.pause();
        } else {
          const playPromise = audioElement.play();
          if (playPromise !== undefined) {
            await playPromise;
          }
        }
      } catch (error) {
        console.error('Audio playback error:', error);
        args.showErrorToast('Unable to play audio. Please check your browser settings.');
      }
    }
  }
};
''',
        css: '''
return `._id {
  background: none;
  border: none;
  color: #3a2317;
  cursor: pointer;
  padding: 0.25rem;
  transition: opacity 0.2s ease;
  
  &:hover {
    opacity: 0.7;
  }
}`;
'''
      }
    },
    {
      id: "musicIcon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const headerState = args.contextData.headerState;
return {
  as: "icon",
  icon: headerState.musicPlaying() ? "carbon:stop-filled" : "carbon:play-filled",
  width: 24,
  height: 24
};
'''
      }
    },
    {
      id: "audioElement",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const headerState = args.contextData.headerState;
return {
  as: "audio",
  src: "/audio/au.mp3", // Using local file to avoid CORS issues
  // loop: true,
  preload: "auto",
  onPlay: () => headerState.setMusicPlaying(true),
  onPause: () => headerState.setMusicPlaying(false),
  onEnded: () => headerState.setMusicPlaying(false),
  ref: (el) => {
    if (el) {
      headerState.setAudioRef(el);
    }
  }
};
'''
      }
    },
