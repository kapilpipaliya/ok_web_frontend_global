};
''',
        css: '''
return `._id {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  background: #f5e6d3;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  min-width: 220px;
  z-index: 1000;
  
  @media (max-width: 768px) {
    position: static;
    display: block;
    box-shadow: none;
    background: rgba(0, 0, 0, 0.05);
  }
}`;
'''
      }
    },
    {
      id: "submenuData",
      L: "Attr",
      P: {
