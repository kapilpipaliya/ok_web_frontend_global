    {
      id: "navigationData",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        contextName: "navigation",
        props: '''
const getCurrentLang = () => {
  const lang = args.params?.lang;
  if (lang && /^[a-z]{2,3}$/i.test(String(lang))) return String(lang).toLowerCase();
  return "en";
};

const localizeHref = (path) => {
  if (!path || path.startsWith("http") || path.startsWith("mailto:") || path === "#") return path;
  const lang = getCurrentLang();
  if (path === "/") return `/${lang}`;
  const normalized = path.startsWith("/") ? path : `/${path}`;
  return `/${lang}${normalized}`;
};

const baseNav = [
  {
    id: 1,
    text: "Home",
    href: "/",
    submenu: null
  },
  {
    id: 2,
    text: "About",
    href: "#",
    submenu: [
      { id: 1, text: "About Fulchand", href: "/about-fulchand" },
      { id: 2, text: "His Inspiration", href: "/his-inspiration" },
      { id: 3, text: "About ASK Umarala", href: "/about-ask-umarala" },
      { id: 4, text: "Atma Siddhi Shastra Mission", href: "/atma-siddhi-shastra-mission" },
      { id: 5, text: "Gyaan Deepak ! Prajwalan", href: "/gyaan-deepak-prajwalan" },
      { id: 6, text: "Atma Sadhana Nitya Kram", href: "/atma-sadhana-nitya-kram" }
    ]
  },
  {
    id: 3,
    text: "Books",
    href: "/books",
    submenu: null
  },
  {
    id: 4,
    text: "Discourses",
    href: "/discourses",
    submenu: null
  },
  {
    id: 5,
    text: "Schedule",
    href: "/schedule",
    submenu: null
  },
  {
    id: 6,
    text: "Gallery",
    href: "#",
    submenu: [
      { id: 1, text: "Photos", href: "/photos" },
      { id: 2, text: "Videos", href: "/videos" }
    ]
  },
  {
    id: 7,
    text: "Donation",
    href: "/donation",
    submenu: null
  },
  {
    id: 8,
    text: "Bhakti",
    href: "/bhakti",
    submenu: null
  },
  {
    id: 9,
    text: "Contact",
    href: "/contact",
    submenu: null
  }
];

return {
  data: baseNav.map((item) => ({
    ...item,
    href: localizeHref(item.href),
    baseHref: item.href,
    submenu: Array.isArray(item.submenu)
      ? item.submenu.map((sub) => ({
          ...sub,
          href: localizeHref(sub.href),
          baseHref: sub.href
        }))
      : null
  }))
};
'''
      }
    },
    {
      id: "navMenu",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
const headerState = args.contextData.headerState;
return {
