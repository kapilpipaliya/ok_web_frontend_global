'''
      }
    },
    {
      id: "submenuLink",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const submenuItem = args.contextData.submenuItem;
return {
  as: "a",
  href: submenuItem.href,
  text: submenuItem.text
};
''',
        css: '''
const submenuItem = args.contextData.submenuItem;
const getPagePath = () => {
  const parts = String(args.location?.pathname || "").split("/").filter(Boolean);
  if (parts.length > 0 && /^[a-z]{2,3}$/i.test(parts[0])) {
    return parts.length > 1 ? "/" + parts.slice(1).join("/") : "/";
  }
  return args.location?.pathname || "/";
};
const currentPath = getPagePath();
const isActive = currentPath === (submenuItem.baseHref || submenuItem.href);
return `._id {
  display: block;
  padding: 0.75rem 1.5rem;
  color: #3a2317;
  text-decoration: none;
  transition: all 0.2s ease;
  
  &:hover {
    background: rgba(0, 0, 0, 0.05);
  }
  
  ${isActive ? `
    background: rgba(0, 0, 0, 0.03);
    font-weight: 600;
    border-left: 2px solid #3a2317;
    padding-left: calc(1.5rem - 2px);
  ` : ''}
  
  @media (max-width: 768px) {
    padding: 0.5rem 1rem 0.5rem 2rem;
    font-size: 0.9rem;
    
    ${isActive ? `
      padding-left: calc(2rem - 2px);
    ` : ''}
  }
}`;
'''
      }
