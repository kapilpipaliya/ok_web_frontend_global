        css: '''
const headerState = args.contextData.headerState;
const isMenuOpen = headerState.mobileMenuOpen();
return `._id {
  display: flex;
  gap: 0;
  align-items: center;
  
  @media (max-width: 768px) {
    display: ${isMenuOpen ? 'flex' : 'none'};
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    background: #f5e6d3;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    z-index: 1000;
  }
}`;
'''
