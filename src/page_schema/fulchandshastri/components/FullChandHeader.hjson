'''
      }
    },
    {
      id: "navLink",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const navItem = args.contextData.navItem;
const getPagePath = () => {
  const parts = String(args.location?.pathname || "").split("/").filter(Boolean);
  if (parts.length > 0 && /^[a-z]{2,3}$/i.test(parts[0])) {
    return parts.length > 1 ? "/" + parts.slice(1).join("/") : "/";
  }
  return args.location?.pathname || "/";
};
const currentPath = getPagePath();
const itemPath = navItem.baseHref || navItem.href;
const isActive = currentPath === itemPath ||
  (navItem.submenu && navItem.submenu.some((item) => currentPath === (item.baseHref || item.href)));
return {
  as: "a",
  href: navItem.href,
  text: navItem.text
};
''',
        css: '''
const navItem = args.contextData.navItem;
const getPagePath = () => {
  const parts = String(args.location?.pathname || "").split("/").filter(Boolean);
  if (parts.length > 0 && /^[a-z]{2,3}$/i.test(parts[0])) {
    return parts.length > 1 ? "/" + parts.slice(1).join("/") : "/";
  }
  return args.location?.pathname || "/";
};
const currentPath = getPagePath();
const itemPath = navItem.baseHref || navItem.href;
const isActive = currentPath === itemPath ||
  (navItem.submenu && navItem.submenu.some((item) => currentPath === (item.baseHref || item.href)));
return `._id {
  padding: 1rem 1.5rem;
  color: #3a2317;
  text-decoration: none;
  font-weight: 500;
  display: inline-block;
  transition: all 0.2s ease;
  position: relative;
  
  &:hover {
    background: rgba(0, 0, 0, 0.1);
  }
  
  ${isActive ? `
    &::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 1rem;
      right: 1rem;
      height: 2px;
      background: #3a2317;
    }
  ` : ''}
  
  @media (max-width: 768px) {
    display: block;
    width: 100%;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    
    ${isActive ? `
      background: rgba(0, 0, 0, 0.05);
      border-left: 3px solid #3a2317;
      padding-left: calc(1rem - 3px);
      
      &::after {
        display: none;
      }
    ` : ''}
  }
}`;
'''
      }
    },
    {
      id: "submenuWrapper",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const navItem = args.contextData.navItem;
return {
