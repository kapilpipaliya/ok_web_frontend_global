  border: 2px solid #8b6914;
  box-shadow: -10px 10px 30px rgba(0, 0, 0, 0.3);
  transform: rotateY(10deg);
  padding: 2rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;

  &::before {
    content: '';
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    border: 1px solid #d4a574;
  }

  @media (max-width: 768px) {
    width: 90%;
    max-width: 350px;
    transform: none;
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div"
};'''
