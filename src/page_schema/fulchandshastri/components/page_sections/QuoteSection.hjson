{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        isNoPermissionCheck: true
        fns: return { enabled: () => true }
        key: QuoteSection
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  background: linear-gradient(135deg, ${args.theme.var.color.background_light_50} 0%, ${args.theme.var.color.background_light_100} 100%);
  padding: 3rem 1rem;
  margin: 2rem 0;
  position: relative;
  overflow: hidden;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const quote = args.contextData.props || {};
return {
  as: "section",
  "data-animate": "",

  ref: (el) => el && args.fns.animateOnView?.(el),
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  position: absolute;
  top: 1rem;
  left: 1rem;
  font-size: 4rem;
  color: ${args.theme.var.color.primary_light_300};
  opacity: 0.3;
  font-family: serif;
  line-height: 1;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div"
};'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "span",
  text: '"'
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id {
  max-width: 800px;
  margin: 0 auto;
  text-align: center;
  position: relative;
  z-index: 1;
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "div"
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 1.5rem;
  font-style: italic;
  color: ${args.theme.var.color.text};
  line-height: 1.8;
  margin: 0 0 1.5rem 0;
  padding: 0 2rem;

  @media (max-width: 768px) {
    font-size: 1.25rem;
    padding: 0 1rem;
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const quote = args.contextData.props || {};
return {
  as: "blockquote",
  text: quote.text || "The soul's journey towards enlightenment begins with a single step of self-realization."
};'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  color: ${args.theme.var.color.text_light_300};
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "div"
};'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 1.25rem;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "span",
  text: "—"
};'''
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-style: normal;
  font-weight: 500;
  font-size: 1.125rem;
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const quote = args.contextData.props || {};
return {
  as: "cite",
  text: quote.author || "Fulchand Shastri"
};'''
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        css:
          '''return `._id {
  position: absolute;
  bottom: 1rem;
  right: 1rem;
  font-size: 4rem;
  color: ${args.theme.var.color.primary_light_300};
  opacity: 0.3;
  font-family: serif;
  line-height: 1;
  transform: rotate(180deg);
}`;'''
        displayOrder: 3
        componentName: Html
        props:
          '''return {
  as: "div"
};'''
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "span",
  text: '"'
};'''
      }
    }
  ]
