        props: '''
return {
  icon: "ph:x",
  variant: "ghost",
  size: "sm",
  title: "Close settings panel",
  onClick: () => args.fns.closePanel?.()
};
'''
      }
    },
    {
      id: "fpse_mode_tabs",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return { as: "div" };
''',
        css: '''
return `._id {
  display: flex;
  gap: 0.25rem;
}`;
'''
      }
    },
    {
      id: "fpse_content_tab",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Button",
        props: '''
const active = args.fns.editorMode?.() !== "schema";
return {
  variant: active ? "primary" : "secondary",
  size: "sm",
  text: "Content",
  type: "button",
  onClick: () => args.fns.setEditorMode?.("content")
};
'''
      }
    },
    {
      id: "fpse_schema_tab",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Button",
        props: '''
const active = args.fns.editorMode?.() === "schema";
return {
  variant: active ? "primary" : "secondary",
  size: "sm",
  text: "Fields",
  type: "button",
  onClick: () => args.fns.setEditorMode?.("schema")
};
'''
      }
    },
    {
      id: "fpse_section_nav",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "FulchandSettingsSectionNav",
        props: '''
const isSchema = args.fns.editorMode?.() === "schema";
return {
  sections: args.fns.sectionNav?.() || [],
  activeSectionId: args.fns.activeSectionId?.(),
  onSectionClick: (sectionId) => args.fns.scrollToSection?.(sectionId),
  hide: isSchema
};
'''
      }
    },
    {
      id: "fpse_panel_body",
      L: "Attr",
