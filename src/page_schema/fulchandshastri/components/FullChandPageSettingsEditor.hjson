}`;
'''
      }
    },
    {
      id: "fpse_content_editor",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: args.fns.editorMode?.() === "schema"
};
''',
        css: '''
return `._id {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}`;
'''
      }
    },
    {
      id: "fpse_dynamic_page",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "DynamicPage",
        key: "fulchand_embedded_settings_editor",
        props: '''
const settingsPageId = args.fns.getSettingsPageId?.();
return {
  pageMode: "settings",
  settingsPageId,
  loadFromSetting: true,
  embeddedMode: true,
  hideSettingsSidebar: true,
  scopeId: "Default",
  siteLanguages: args.fns.siteLanguages?.() || [],
  scope: {
    vertexLabel: "GlobalSetting",
    matchProperty: "key",
    idParam: "scopeId"
  },
  hide: !settingsPageId
};
'''
      }
    },
    {
      id: "fpse_schema_editor",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "FulchandSettingsConfigEditor",
        props: '''
const settingsPageId = args.fns.getSettingsPageId?.();
return {
  settingsPageId,
  siteLanguages: args.fns.siteLanguages?.() || [],
  hide: args.fns.editorMode?.() !== "schema",
  onSaved: () => {
    args.fns.loadSectionNav?.();
    args.fns.refreshPagePreview?.();
  }
};
'''
      }
    }
  ]
  edges: [
    { id: "fpse_e0", T: "Attr", S: "fpse_root", E: "fpse_body_style" },
