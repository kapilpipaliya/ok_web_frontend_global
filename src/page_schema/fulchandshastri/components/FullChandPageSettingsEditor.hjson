  gap: 0.25rem;
}`;
'''
      }
    },
    {
      id: "fpse_refresh_btn"
      L: Attr
      P: {
        displayOrder: 1
        componentName: IconButton
        props: '''
return {
  icon: "ph:arrow-clockwise",
  variant: "ghost",
  size: "sm",
  title: "Refresh page preview",
  onClick: () => args.fns.refreshPagePreview?.()
};
'''
      }
    },
    {
      id: "fpse_close_btn"
      L: Attr
      P: {
        displayOrder: 2
