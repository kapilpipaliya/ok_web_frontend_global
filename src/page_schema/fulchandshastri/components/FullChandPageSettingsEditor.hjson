    { id: "fpse_e2", T: "Attr", S: "fpse_root", E: "fpse_panel" },
    { id: "fpse_e3", T: "Attr", S: "fpse_toggle", E: "fpse_toggle_icon" },
    { id: "fpse_e4", T: "Attr", S: "fpse_toggle", E: "fpse_toggle_label" },
    { id: "fpse_e5", T: "Attr", S: "fpse_panel", E: "fpse_panel_header" },
    { id: "fpse_e6", T: "Attr", S: "fpse_panel", E: "fpse_panel_body" },
    { id: "fpse_e7", T: "Attr", S: "fpse_panel_header", E: "fpse_header_row" },
    { id: "fpse_e7b", T: "Attr", S: "fpse_panel_header", E: "fpse_mode_tabs" },
    { id: "fpse_e8", T: "Attr", S: "fpse_panel_header", E: "fpse_section_nav" },
    { id: "fpse_e9", T: "Attr", S: "fpse_header_row", E: "fpse_header_title" },
    { id: "fpse_e10", T: "Attr", S: "fpse_header_row", E: "fpse_header_actions" },
    { id: "fpse_e10b", T: "Attr", S: "fpse_mode_tabs", E: "fpse_content_tab" },
    { id: "fpse_e10c", T: "Attr", S: "fpse_mode_tabs", E: "fpse_schema_tab" },
    { id: "fpse_e11", T: "Attr", S: "fpse_header_actions", E: "fpse_refresh_btn" },
    { id: "fpse_e12", T: "Attr", S: "fpse_header_actions", E: "fpse_close_btn" },
    { id: "fpse_e13", T: "Attr", S: "fpse_panel_body", E: "fpse_content_editor" },
    { id: "fpse_e13b", T: "Attr", S: "fpse_panel_body", E: "fpse_schema_editor" },
    { id: "fpse_e14", T: "Attr", S: "fpse_content_editor", E: "fpse_dynamic_page" }
  ]
}
