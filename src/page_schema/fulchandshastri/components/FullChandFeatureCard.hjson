{
  vertexes: [
    {
      id: "root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const feature = args.contextData.props || {};
return {
  as: "div"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.background};
  border: 1px solid ${args.theme.var.color.background_light_300};
  border-radius: 0.75rem;
  padding: 2rem;
  transition: all 0.3s ease;
  
  &:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    transform: translateY(-4px);
    border-color: ${args.theme.var.color.primary_light_300};
  }
}`;
'''
      }
    },
    {
      id: "iconWrapper",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const feature = args.contextData.props || {};
const showIcon = feature.icon ? true : false;
return {
  as: showIcon ? "div" : "fragment"
};
''',
        css: '''
return `._id {
  width: 4rem;
  height: 4rem;
  background: ${args.theme.var.color.primary_light_100};
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1.5rem;
}`;
'''
      }
    },
    {
      id: "icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const feature = args.contextData.props || {};
return {
  as: "icon",
  icon: feature.icon || "carbon:star",
  width: 32,
  height: 32
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.primary};
}`;
'''
      }
    },
    {
      id: "imageWrapper",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const feature = args.contextData.props || {};
const showImage = feature.image ? true : false;
return {
  as: showImage ? "div" : "fragment"
};
''',
        css: '''
return `._id {
  margin-bottom: 1.5rem;
  border-radius: 0.5rem;
  overflow: hidden;
}`;
'''
      }
    },
    {
      id: "image",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const feature = args.contextData.props || {};
return {
  as: "img",
  src: feature.image || "",
  alt: feature.title || "Feature image",
  width: "100%"
};
''',
        css: '''
return `._id {
  width: 100%;
  height: auto;
  display: block;
}`;
'''
      }
    },
    {
      id: "content",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  text-align: ${args.contextData.props?.align || 'left'};
}`;
'''
      }
    },
    {
      id: "title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const feature = args.contextData.props || {};
return {
  as: "h3",
  text: feature.title || "Feature Title"
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text};
  font-size: 1.5rem;
  font-weight: 600;
  margin: 0 0 1rem 0;
  line-height: 1.4;
}`;
'''
      }
    },
    {
      id: "description",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const feature = args.contextData.props || {};
return {
  as: "p",
  text: feature.description || "Feature description goes here."
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text_light_200};
  font-size: 1rem;
  line-height: 1.7;
  margin: 0 0 1rem 0;
}`;
'''
      }
    },
    {
      id: "linkWrapper",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const feature = args.contextData.props || {};
const showLink = feature.link ? true : false;
return {
  as: showLink ? "div" : "fragment"
};
''',
        css: '''
return `._id {
  margin-top: 1.5rem;
}`;
'''
      }
    },
    {
      id: "link",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const feature = args.contextData.props || {};
return {
  as: "a",
  href: feature.link || "#",
  text: feature.linkText || "Learn More"
};
''',
        css: '''
return `._id {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: ${args.theme.var.color.primary};
  text-decoration: none;
  font-weight: 500;
  transition: all 0.2s ease;
  
  &:hover {
    gap: 0.75rem;
    text-decoration: underline;
  }
}`;
'''
      }
    },
    {
      id: "arrowIcon",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:arrow-right",
  width: 16,
  height: 16
};
'''
      }
    }
  ],
  edges: [
    { id: "e1", T: "Attr", S: "root", E: "iconWrapper" },
    { id: "e2", T: "Attr", S: "iconWrapper", E: "icon" },
    { id: "e3", T: "Attr", S: "root", E: "imageWrapper" },
    { id: "e4", T: "Attr", S: "imageWrapper", E: "image" },
    { id: "e5", T: "Attr", S: "root", E: "content" },
    { id: "e6", T: "Attr", S: "content", E: "title" },
    { id: "e7", T: "Attr", S: "content", E: "description" },
    { id: "e8", T: "Attr", S: "content", E: "linkWrapper" },
    { id: "e9", T: "Attr", S: "linkWrapper", E: "link" },
    { id: "e10", T: "Attr", S: "link", E: "arrowIcon" }
  ]
}