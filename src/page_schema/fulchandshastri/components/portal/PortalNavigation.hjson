        }
      },
      {
        id: "dravya_drishti_prakash_videos_table",
        href: "/portal/table?table=DravyaDrishtiPrakashVideo&key=dravya_drishti_prakash_videos",
        label: "Dravya Drishti Prakash Videos",
        icon: "ph:youtube-logo",
        pathCheck: () => {
          if (String(_.location?.pathname || "") !== "/portal/table") return false;
          return String(_.searchParams?.table || "").trim() === "DravyaDrishtiPrakashVideo";
        }
      },
      {
        id: "files_organizer",
        href: "/portal/table?table=File&key=files",
        label: "Files",
        icon: "ph:folder",
        pathCheck: () => {
          if (String(_.location?.pathname || "") !== "/portal/table") return false;
          return String(_.searchParams?.table || "").trim() === "File";
        }
      }
    ]
  }
];

const portalNavSections = _.createMemo(() =>
  portalNavSectionsData.filter(
    (section) => !section.showIf || section.showIf(),
  ),
);

const isNavItemActive = (item) =>
  item.pathCheck ? item.pathCheck() : false;

const onUserMenuMount = () => {
  document.addEventListener("click", handleUserMenuDocumentClick);
  return () => {
    document.removeEventListener("click", handleUserMenuDocumentClick);
    if (userMenuFloatingCleanup) userMenuFloatingCleanup();
  };
};

return {
  userMenuOpen,
  menuHoverKey,
  setUserMenuTriggerRef,
  setUserMenuPanelRef,
  setMenuItemHover,
  clearMenuItemHover,
  toggleUserMenu,
  closeUserMenu,
  navigateFromUserMenu,
  navigateToLogout,
  onUserMenuMount,
  checkAdminRole,
  portalNavSections,
  isNavItemActive
};
