      L: Attr
      P: {
        css:
          '''
return `._id {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: ${args.theme.var.color.background};
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: ${args.theme.var.spacing.xxl};
  z-index: 1;
  opacity: 0;
  animation: fadeIn 0.2s ease-out forwards;
}

@keyframes fadeIn {
  to {
    opacity: 1;
  }
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''
const isNavigating = args.fns.isNavigating?.();

return {
  as: "div",
  style: {
    display: isNavigating ? "flex" : "none"
  }
};
'''
