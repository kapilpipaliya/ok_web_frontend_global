{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: FormFieldArray
        dynamicComponent: TextInput, TextArea, Button
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        fns:
          '''
const getProps = () => args.contextData.props || {};
const getField = () => getProps().field || {};
const getConfig = () => getField().fieldArrayConfig || {};

const getItemFields = () => {
  const itemFields = getConfig().itemFields;
  return Array.isArray(itemFields) ? itemFields : [];
};

const parseItems = (value) => {
  if (Array.isArray(value)) return value.map((item) => ({ ...(item || {}) }));
  if (typeof value === "string" && value.trim() !== "") {
    try {
      const parsed = JSON.parse(value);
      return Array.isArray(parsed) ? parsed.map((item) => ({ ...(item || {}) })) : [];
    } catch {
      return [];
    }
  }
  return [];
};

const getItems = () => parseItems(getProps().value);

const commitItems = (items) => {
  getProps().onChange?.(items);
};

const buildDefaultItem = () => {
  const item = {};
  const itemFields = getItemFields();
  for (let fieldIndex = 0; fieldIndex < itemFields.length; fieldIndex++) {
    const itemField = itemFields[fieldIndex];
    if (!itemField?.key) continue;
    if (itemField.defaultValue !== undefined) {
      item[itemField.key] = itemField.defaultValue;
    } else if (itemField.dataType === "boolean" || itemField.renderer === "checkbox") {
      item[itemField.key] = false;
    } else {
      item[itemField.key] = "";
    }
  }
  return item;
};

const updateItemField = (itemIndex, fieldKey, fieldValue) => {
  const items = getItems();
  if (!items[itemIndex]) return;
  const nextItems = items.map((item, index) =>
    index === itemIndex ? { ...item, [fieldKey]: fieldValue } : item
  );
  commitItems(nextItems);
};

const addItem = () => {
  const config = getConfig();
  const items = getItems();
  if (config.maxItems != null && items.length >= Number(config.maxItems)) return;
  commitItems([...items, buildDefaultItem()]);
};

const removeItem = (itemIndex) => {
  const config = getConfig();
  const items = getItems();
  if (config.minItems != null && items.length <= Number(config.minItems)) return;
  commitItems(items.filter((_, index) => index !== itemIndex));
};

// Use stable numeric indices for loop data so Solid <For> does not remount rows on each keystroke.
const getItemIndices = () => {
  const items = getItems();
  const indices = [];
  for (let index = 0; index < items.length; index++) {
    indices.push(index);
  }
  return indices;
};

const getItemAt = (itemIndex) => getItems()[itemIndex] || {};

const getItemLabel = (itemIndex) =>
  `${getConfig().itemLabel || "Item"} ${itemIndex + 1}`;

const getItemFieldValue = (item, itemField) => {
  if (!itemField?.key) return "";
  const value = item?.[itemField.key];
  if (value == null) return "";
  return value;
};

const isDisabled = () => getProps().disabled === true;

return {
  getField,
  getConfig,
  getItemFields,
  getItemIndices,
  getItemAt,
  getItemLabel,
  addItem,
  removeItem,
  updateItemField,
  getItemFieldValue,
  isDisabled
};
'''
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "fm-field-array"
};
'''
        css:
          '''
return `._id.fm-field-array {
  display: flex;
  flex-direction: column;
  gap: ${args.theme.var.spacing.md};
  width: 100%;
}`;
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Button
        props:
          '''
return {
  variant: "secondary",
  text: args.fns.getConfig()?.addButtonLabel || "Add item",
  type: "button",
  disabled: args.fns.isDisabled(),
  onClick: () => args.fns.addItem()
};
'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 2
        contextName: fieldArrayItem
        loop: true
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "fm-field-array-item",
  data: args.fns.getItemIndices()
};
'''
        css:
          '''
return `._id.fm-field-array-item {
  display: flex;
  flex-direction: column;
  gap: ${args.theme.var.spacing.sm};
  padding: ${args.theme.var.spacing.md};
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.5rem;
  background: ${args.theme.var.color.background_light_50};
}`;
'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "fm-field-array-item-header"
};
'''
        css:
          '''
return `._id.fm-field-array-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: ${args.theme.var.spacing.sm};
}`;
'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const itemIndex = args.contextData.fieldArrayItem;
return {
  as: "div",
  text: args.fns.getItemLabel(itemIndex),
  class: "fm-field-array-item-title"
};
'''
        css:
          '''
return `._id.fm-field-array-item-title {
  font-size: ${args.theme.var.fontSize.sm};
  font-weight: 600;
  color: ${args.theme.var.color.text};
}`;
'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Button
        props:
          '''
const itemIndex = args.contextData.fieldArrayItem;
return {
  variant: "danger",
  size: "sm",
  text: "Remove",
  type: "button",
  disabled: args.fns.isDisabled(),
  onClick: () => args.fns.removeItem(itemIndex)
};
'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        displayOrder: 2
        contextName: fieldArrayField
        loop: true
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "fm-field-array-field",
  data: args.fns.getItemFields()
};
'''
        css:
          '''
return `._id.fm-field-array-field {
  display: flex;
  flex-direction: column;
  gap: ${args.theme.var.spacing.xs};
  width: 100%;
}`;
'''
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const itemField = args.contextData.fieldArrayField || {};
return {
  as: "label",
  text: itemField.label || itemField.key || "Field",
  class: "fm-field-array-field-label"
};
'''
        css:
          '''
return `._id.fm-field-array-field-label {
  font-size: ${args.theme.var.fontSize.sm};
  font-weight: 500;
  color: ${args.theme.var.color.text};
}`;
'''
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        displayOrder: 2
        componentName: TextArea
        props:
          '''
const itemField = args.contextData.fieldArrayField || {};
const itemIndex = args.contextData.fieldArrayItem;
const hide = itemField.renderer !== "textArea";
const value = args.fns.getItemFieldValue(args.fns.getItemAt(itemIndex), itemField);
return {
  hide,
  value,
  onChange: (e) => args.fns.updateItemField(itemIndex, itemField.key, e.target.value),
  placeholder: itemField.placeholder || "",
  required: itemField.required === true,
  disabled: args.fns.isDisabled()
};
'''
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        displayOrder: 3
        componentName: TextInput
        props:
          '''
const itemField = args.contextData.fieldArrayField || {};
const itemIndex = args.contextData.fieldArrayItem;
const hide = itemField.renderer === "textArea";
const value = args.fns.getItemFieldValue(args.fns.getItemAt(itemIndex), itemField);
return {
  hide,
  value,
  onChange: (e) => args.fns.updateItemField(itemIndex, itemField.key, e.target.value),
  placeholder: itemField.placeholder || "",
  required: itemField.required === true,
  disabled: args.fns.isDisabled(),
  type: itemField.dataType === "number" ? "number" : "text"
};
'''
      }
    }
  ]
