{
  vertexes: [
    {
      id: "1"
      L: EmailTemplate
      P: {
        description: Confirmation email sent after an email address change has been successfully completed
        title: Email Change Successful
        key: EmailChangeSuccessful
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        as: div
        css:
          '''return `._id {
  min-height: 100vh;
  background-color: ${args.theme.var.color.background_hex};
  color: ${args.theme.var.color.text_hex};
  padding: 32px;
}`;'''
        displayOrder: 1
        componentName: Html
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        as: div
        css:
          '''return `._id {
  max-width: 600px;
  margin: auto;
  padding: 32px;
  background-color: ${args.theme.var.color.background_light_100_hex};
  color: ${args.theme.var.color.text_hex};
}`;'''
        displayOrder: 3
        componentName: Html
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        as: div
        css: ""
        displayOrder: 1
        componentName: Html
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        as: a
        displayOrder: 1
        componentName: Html
        href: /
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          '''return `._id {
  height:80px; margin-bottom:24px;
}`;'''
        as: img
        displayOrder: 1
        componentName: Html
        props:
          '''return {
            alt: "Logo",
            src: "/api/file/downloadCompanyRectangularLogo"
            }'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        as: hr
        css:
          '''return `._id {
  border: none;
  border-top: 1px solid ${args.theme.var.color.border_hex};
  margin-top:24px; margin-bottom:24px;
}`;'''
        displayOrder: 2
        componentName: Html
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        as: div
        css:
          '''return `._id {
  color: ${args.theme.var.color.text_hex};
}`;'''
        displayOrder: 2
        componentName: Html
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        css:
          '''return `._id {
      color: ${args.theme.var.color.text_hex};
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 16px;
    }`;'''
        as: h1
        displayOrder: 1
        componentName: Html
        text: Email Change Successful
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        css:
          '''return `._id {
      color: ${args.theme.var.color.text_hex};
      margin-bottom: 16px;
    }`;'''
        as: p
        displayOrder: 2
        componentName: Html
        text: Your email address has been successfully updated. This is now your primary email for account notifications and communications.
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        css:
          '''return `._id {
      color: ${args.theme.var.color.text_hex};
      margin-bottom: 16px;
    }`;'''
        as: p
        displayOrder: 3
        componentName: Html
        text: If you need to make any additional changes to your account, please visit your account settings.
      }
    }
    {
      id: "12"
      L: Attr
      P: {
        as: a
        css:
          '''return `._id {
      background-color: ${args.theme.var.color.primary_hex};
      border: none;
      border-radius: 4px;
      color: ${args.theme.var.color.primary_text_hex};
      cursor: pointer;
      display: inline-block;
      padding: 8px 16px;
      text-decoration: none;
    }`;'''
        displayOrder: 4
        componentName: Html
        text: Go to Account Settings
        target: _blank
        props:
          '''return {
      // href: window.location.origin + "/admin/UserSettings",
      href: "/"
    }'''
      }
    }
    {
      id: "13"
      L: Attr
      P: {
        as: div
        css:
          '''return `._id {
  margin-top: 32px;
  text-align: center;
}`;'''
        displayOrder: 3
        componentName: Html
      }
    }
    {
      id: "14"
      L: Attr
      P: {
        css:
          '''return `._id {
  color: ${args.theme.var.color.text_light_200_hex};
  font-size: 12px;
}`;'''
        as: p
        displayOrder: 1
        componentName: Html
        text: © 2025 ${args.globalSetting?.P.appName}. All rights reserved.
      }
    }
  ]
  edges: [
