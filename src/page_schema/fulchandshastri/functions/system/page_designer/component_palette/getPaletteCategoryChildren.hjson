{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Fetches category and content children for a Page Designer palette category parent.
        body:
          '''
const actualUser = await _.getUserFromSession();
if (!actualUser) {
  return { success: false, message: "User session not found. Please log in and try again.", data: [] };
}

const { parentVertexLabel, toParentEdgeType, parentId, tableVertexLabel } = c;

if (!parentVertexLabel || !toParentEdgeType || !parentId) {
  return {
    success: false,
    message: "parentVertexLabel, toParentEdgeType and parentId are required",
    data: []
  };
}

if (!_.context.nodes) _.context.nodes = {};

const categoryResult = await _.session.run(
  `MATCH (child:${parentVertexLabel})-[r:${toParentEdgeType}]->(parent:${parentVertexLabel})
   WHERE elementId(parent) = $parentId
   RETURN child, parent, r
   ORDER BY COALESCE(child.displayOrder, 0), COALESCE(child.key, '') ASC`,
  { parentId }
);
const categoryVertices = _.processResult(categoryResult.records, _.context, ['child', 'parent'], 'r');

if (tableVertexLabel) {
  const contentResult = await _.session.run(
    `MATCH (content:${tableVertexLabel})-[r:${toParentEdgeType}]->(cat:${parentVertexLabel})
     WHERE elementId(cat) = $parentId
     RETURN content, cat, r
     ORDER BY COALESCE(content.displayOrder, 0), COALESCE(content.key, '') ASC`,
    { parentId }
  );
  _.processResult(contentResult.records, _.context, ['content', 'cat'], 'r');
}

return {
  success: true,
  data: categoryVertices,
  message: `Loaded children for palette category`
};
'''
        key: getPaletteCategoryChildren
      }
    }
  ]
  edges: []
}