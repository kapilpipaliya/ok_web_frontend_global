{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: fulchandLocalizationHelpers
        description: Fulchand settings localization — normalize, resolve, validate translatable field values.
        body:
          '''
/**
 * contextData.action:
 *   isTranslatableField | normalizeLocalizedValue | resolveLocalizedValue |
 *   firstNonEmptyLanguage | localizeSectionValues | validateLocalizedField |
 *   applyTranslatableDefaults | getDefaultLanguageCode
 */

const action = args.contextData?.action;
if (!action) {
  return { success: false, message: "action is required" };
}

const DEFAULT_LANGUAGES = [
  { code: "en", label: "English", isDefault: true },
  { code: "hi", label: "Hindi", isDefault: false },
  { code: "gu", label: "Gujarati", isDefault: false }
];

const isTranslatableField = (field) => field?.translatable !== false;

const getDefaultLanguageCode = (languages) => {
  const list = Array.isArray(languages) && languages.length > 0 ? languages : DEFAULT_LANGUAGES;
  const explicit = list.find((lang) => lang?.isDefault === true && lang?.code);
  if (explicit?.code) return String(explicit.code);
  const first = list.find((lang) => lang?.code);
  return first?.code ? String(first.code) : "en";
};

const normalizeLanguageList = (languages) => {
  if (!Array.isArray(languages) || languages.length === 0) return DEFAULT_LANGUAGES;
  return languages
    .filter((lang) => lang?.code != null && String(lang.code).trim() !== "")
    .map((lang) => ({
      code: String(lang.code).trim(),
      label: lang.label != null ? String(lang.label) : String(lang.code).trim(),
      isDefault: lang.isDefault === true
    }));
};

const isLocalizedObject = (value) =>
  value != null && typeof value === "object" && !Array.isArray(value);

const normalizeLocalizedValue = (value, languages, defaultCode) => {
  const list = normalizeLanguageList(languages);
  const code = defaultCode || getDefaultLanguageCode(list);
  const normalized = {};
  for (let i = 0; i < list.length; i++) {
    const langCode = list[i].code;
    normalized[langCode] = "";
  }
  if (isLocalizedObject(value)) {
    for (const key of Object.keys(value)) {
      if (Object.prototype.hasOwnProperty.call(normalized, key)) {
        normalized[key] = value[key] == null ? "" : String(value[key]);
      }
    }
    return normalized;
  }
  if (typeof value === "string") {
    normalized[code] = value;
  }
  return normalized;
};

const firstNonEmptyLanguage = (value, languages) => {
  if (!isLocalizedObject(value)) return "";
  const list = normalizeLanguageList(languages);
  for (let i = 0; i < list.length; i++) {
    const langCode = list[i].code;
    const text = value[langCode];
    if (text != null && String(text).trim() !== "") return String(text);
  }
  return "";
};

const resolveLocalizedValue = (value, locale, languages) => {
  if (!isLocalizedObject(value)) return "";
  const list = normalizeLanguageList(languages);
  const defaultCode = getDefaultLanguageCode(list);
  const resolvedLocale = locale || defaultCode;
  return (
    value[resolvedLocale]
    || value[defaultCode]
    || firstNonEmptyLanguage(value, list)
    || ""
  );
};

const validateLocalizedField = (field, value, languages) => {
  if (!isTranslatableField(field)) return null;
  if (field?.required !== true) return null;
  const list = normalizeLanguageList(languages);
  const defaultCode = getDefaultLanguageCode(list);
  const normalized = normalizeLocalizedValue(value, list, defaultCode);
  const defaultValue = normalized[defaultCode];
  if (defaultValue == null || String(defaultValue).trim() === "") {
    const fieldKey = field?.key || field?.name || "field";
    return `${fieldKey} requires a value in the default language (${defaultCode})`;
  }
  return null;
};

const collectFormFields = (sectionConfig) => {
  const formConfig = sectionConfig?.form;
  if (!formConfig) return [];
  if (Array.isArray(formConfig.groups)) {
    const fields = [];
    for (let gi = 0; gi < formConfig.groups.length; gi++) {
      const groupFields = formConfig.groups[gi]?.fields;
      if (Array.isArray(groupFields)) fields.push(...groupFields);
    }
    return fields;
  }
  if (Array.isArray(formConfig.fields)) return formConfig.fields;
  return [];
};

const applyValueAction = (field, value, mode, languages, locale) => {
  if (!isTranslatableField(field)) return value;
  if (mode === "resolve") {
    return resolveLocalizedValue(value, locale, languages);
  }
  const defaultCode = getDefaultLanguageCode(languages);
  return normalizeLocalizedValue(value, languages, defaultCode);
};

const localizeSectionValues = (sectionConfig, values, mode, languages, locale) => {
  const fields = collectFormFields(sectionConfig);
  const output = { ...(values || {}) };
  for (let fi = 0; fi < fields.length; fi++) {
    const field = fields[fi];
    const fieldKey = field?.key;
    if (!fieldKey) continue;
    if (field.renderer === "fieldArray" && Array.isArray(output[fieldKey])) {
      const itemFields = field.fieldArrayConfig?.itemFields || [];
      output[fieldKey] = output[fieldKey].map((item) => {
        const nextItem = { ...(item || {}) };
        for (let ii = 0; ii < itemFields.length; ii++) {
          const itemField = itemFields[ii];
          const itemKey = itemField?.key;
          if (!itemKey) continue;
          nextItem[itemKey] = applyValueAction(
            itemField,
            nextItem[itemKey],
            mode,
            languages,
            locale
          );
        }
        return nextItem;
      });
      continue;
    }
    output[fieldKey] = applyValueAction(field, output[fieldKey], mode, languages, locale);
  }
  return output;
};

const applyTranslatableDefaultsToField = (field) => {
  if (!field || typeof field !== "object") return field;
  const isTextField = field.renderer === "text" || field.renderer === "textArea";
  const next = { ...field };
  if (next.translatable === undefined) {
    next.translatable = isTextField;
  }
  if (next.renderer === "fieldArray" && next.fieldArrayConfig?.itemFields) {
    next.fieldArrayConfig = {
      ...next.fieldArrayConfig,
      itemFields: next.fieldArrayConfig.itemFields.map((itemField) =>
        applyTranslatableDefaultsToField(itemField)
      )
    };
  }
  if (isTextField && next.translatable !== false && next.dataType === undefined) {
    next.dataType = "text";
  }
  return next;
};

if (action === "isTranslatableField") {
  return { success: true, data: { translatable: isTranslatableField(args.contextData.field) } };
}

if (action === "getDefaultLanguageCode") {
  return {
    success: true,
    data: { defaultCode: getDefaultLanguageCode(args.contextData.languages) }
  };
}

if (action === "normalizeLanguageList") {
  return {
    success: true,
    data: { languages: normalizeLanguageList(args.contextData.languages) }
  };
}

if (action === "normalizeLocalizedValue") {
  const { value, languages, defaultCode } = args.contextData;
  return {
    success: true,
    data: { value: normalizeLocalizedValue(value, languages, defaultCode) }
  };
}

if (action === "firstNonEmptyLanguage") {
  const { value, languages } = args.contextData;
  return {
    success: true,
    data: { text: firstNonEmptyLanguage(value, languages) }
  };
}

if (action === "resolveLocalizedValue") {
  const { value, locale, languages } = args.contextData;
  return {
    success: true,
    data: { text: resolveLocalizedValue(value, locale, languages) }
  };
}

if (action === "validateLocalizedField") {
  const { field, value, languages } = args.contextData;
  const error = validateLocalizedField(field, value, languages);
  if (error) return { success: false, message: error };
  return { success: true, data: { valid: true } };
}

if (action === "localizeSectionValues") {
  const { sectionConfig, values, mode, languages, locale } = args.contextData;
  return {
    success: true,
    data: {
      values: localizeSectionValues(sectionConfig, values, mode, languages, locale)
    }
  };
}

if (action === "applyTranslatableDefaults") {
  const { field } = args.contextData;
  return {
    success: true,
    data: { field: applyTranslatableDefaultsToField(field) }
  };
}

return { success: false, message: `Unknown action: ${action}` };
'''
      }
    }
  ]
  edges: []
}
