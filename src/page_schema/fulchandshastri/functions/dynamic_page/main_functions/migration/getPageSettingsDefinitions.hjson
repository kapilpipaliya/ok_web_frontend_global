{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: getPageSettingsDefinitions
        description: Returns Fulchand Shastri settings page configs and default section documents for all public pages.
        body:
          '''
const DEFAULT_SITE_LANGUAGES = [
  { code: "en", label: "English", isDefault: true },
  { code: "hi", label: "Hindi", isDefault: false },
  { code: "gu", label: "Gujarati", isDefault: false }
];

const NON_TRANSLATABLE_FIELD_KEYS = new Set([
  "leftVideoUrl", "rightVideoUrl", "videoUrl", "videoId", "youtubeId", "audioUrl",
  "thumbnail", "imageUrl", "pdfUrl", "downloadUrl", "mapUrl", "website", "url", "href",
  "icon", "link", "align", "code", "language", "duration", "views", "date", "email",
  "phone", "slug", "key", "path", "file", "src", "langOption1", "langOption2",
  "langOption3", "langOption4", "videoEmbedUrl", "spotifyUrl", "facebookUrl",
  "instagramUrl", "twitterUrl", "youtubeUrl", "whatsappNumber", "addressLine1",
  "addressLine2", "postalCode", "city", "country", "latitude", "longitude"
]);

function buildField({ key, label, renderer, translatable, ...rest }) {
  const isTextField = renderer === "text" || renderer === "textArea";
  let resolvedTranslatable = translatable;
  if (resolvedTranslatable === undefined) {
    resolvedTranslatable = isTextField;
  }
  if (NON_TRANSLATABLE_FIELD_KEYS.has(key)) {
    resolvedTranslatable = false;
  }
  return {
    key,
    label,
    renderer,
    dataType:
      renderer === "fieldArray" ? "array" : renderer === "checkbox" ? "boolean" : "text",
    translatable: resolvedTranslatable,
    ...rest
  };
}

function finalizeField(field) {
  if (!field || typeof field !== "object") return field;
  const finalized = buildField({
    key: field.key,
    label: field.label,
    renderer: field.renderer || "text",
    translatable: field.translatable,
    required: field.required,
    colSpan: field.colSpan,
    defaultValue: field.defaultValue,
    placeholder: field.placeholder,
    maxLength: field.maxLength,
    minLength: field.minLength,
    validation: field.validation,
    fieldArrayConfig: field.fieldArrayConfig
      ? {
          ...field.fieldArrayConfig,
          itemFields: (field.fieldArrayConfig.itemFields || []).map((itemField) =>
            finalizeField(itemField)
          )
        }
      : undefined
  });
  return finalized;
}

function getDefaultLanguageCode(languages) {
  const list = Array.isArray(languages) && languages.length > 0 ? languages : DEFAULT_SITE_LANGUAGES;
  const explicit = list.find((lang) => lang?.isDefault === true && lang?.code);
  if (explicit?.code) return String(explicit.code);
  return list[0]?.code ? String(list[0].code) : "en";
}

function isTranslatableField(field) {
  return field?.translatable !== false;
}

function normalizeLocalizedDefault(value, languages, defaultCode) {
  const code = defaultCode || getDefaultLanguageCode(languages);
  const normalized = {};
  for (let i = 0; i < languages.length; i++) {
    normalized[languages[i].code] = "";
  }
  if (value != null && typeof value === "object" && !Array.isArray(value)) {
    for (const langKey of Object.keys(value)) {
      if (Object.prototype.hasOwnProperty.call(normalized, langKey)) {
        normalized[langKey] = value[langKey] == null ? "" : String(value[langKey]);
      }
    }
    return normalized;
  }
  if (typeof value === "string") {
    normalized[code] = value;
  }
  return normalized;
}

function localizeFieldValue(field, value, languages) {
  if (!isTranslatableField(field)) return value;
  const defaultCode = getDefaultLanguageCode(languages);
  return normalizeLocalizedDefault(value, languages, defaultCode);
}

function localizeDefaultDocumentValues(page, languages) {
  const defaultCode = getDefaultLanguageCode(languages);
  return (page.defaultDocuments || []).map((doc) => {
    const section = (page.sections || []).find((s) => s.id === doc.sectionId);
    if (!section) return doc;
    const values = { ...(doc.values || {}) };
    for (let fi = 0; fi < (section.fields || []).length; fi++) {
      const field = section.fields[fi];
      if (!field?.key) continue;
      if (field.renderer === "fieldArray" && Array.isArray(values[field.key])) {
        const itemFields = field.fieldArrayConfig?.itemFields || [];
        values[field.key] = values[field.key].map((item) => {
          const nextItem = { ...(item || {}) };
          for (let ii = 0; ii < itemFields.length; ii++) {
            const itemField = itemFields[ii];
            if (!itemField?.key) continue;
            nextItem[itemField.key] = localizeFieldValue(
              itemField,
              nextItem[itemField.key],
              languages
            );
          }
          return nextItem;
        });
      } else if (Object.prototype.hasOwnProperty.call(values, field.key)) {
        values[field.key] = localizeFieldValue(field, values[field.key], languages);
      }
    }
    return { ...doc, values };
  });
}

function finalizePage(page) {
  const sections = (page.sections || []).map((section) => ({
    ...section,
    fields: (section.fields || []).map((field) => finalizeField(field))
  }));
  const localizedDefaults = localizeDefaultDocumentValues(
    { ...page, sections },
    DEFAULT_SITE_LANGUAGES
  );
  return {
    ...page,
    sections,
    defaultDocuments: localizedDefaults
  };
}

