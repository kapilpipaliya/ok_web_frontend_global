    ],
    "defaultDocuments": [
      {
        "pageId": "about",
        "sectionId": "content",
        "values": {
          "heroTitle": "About Fulchand",
          "heroSubtitle": "An Enlightened Master Devoted to Spreading Divine Knowledge",
          "introPara1": "Fulchand is an enlightened master who has devoted his life to spreading the teachings of his spiritual guru, Shrimad Rajchandra, in more than 220 countries around the world. Born in Gujarat, India, his spiritual journey began at a young age when he encountered the profound teachings that would shape his life's mission.",
          "introPara2": "Though he is strongly rooted in the Jainism theory of Samyak Darshan (Enlightenment) and Moksha (Nirvana), he aims to share this divine knowledge with every soul in the world that is ready to acquire it, regardless of caste, creed, religious inclination, nationality, food habits, gender or any other differentials.",
          "introPara3": "His disciples think of him as an ocean of compassion as he has relentlessly sweated, toiled and even bled, just to spread the call of the divine to as many souls as he possibly can. He wishes he could communicate with trees and animals too and help them understand the Eternal Truth as well.",
          "journeyTitle": "The Spiritual Journey",
          "teachingsTitle": "Core Teachings",
          "teaching1Title": "Samyak Darshan",
          "teaching1Text": "Right perception and enlightenment",
          "teaching2Title": "Moksha",
          "teaching2Text": "Liberation and ultimate freedom",
          "teaching3Title": "Universal Love",
          "teaching3Text": "Compassion for all beings",
          "teaching4Title": "Self-Realization",
          "teaching4Text": "Knowing one's true nature"
        }
      }
    ]
  },
