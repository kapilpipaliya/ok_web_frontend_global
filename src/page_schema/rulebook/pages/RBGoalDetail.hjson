    {
      id: "related_rule_meta",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const ruleData = args.fns.goalData?.()?.rule;
const streakData = args.fns.goalData?.()?.streak;

if (!ruleData) {
  return {
    as: "div",
    text: "No rule linked to this goal"
  };
}

const frequency = ruleData.P?.frequency || "Unknown";
const priority = ruleData.P?.priority || "Unknown";
const currentStreak = streakData?.P?.currentStreak || 0;
const streakText = currentStreak > 0 ? `${currentStreak} day streak` : "No streak";

return {
  as: "div",
  text: `${frequency} • ${priority} Priority • ${streakText}`
};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.sm};
  color: ${args.theme.var.color.muted};
}`;
'''
      }
