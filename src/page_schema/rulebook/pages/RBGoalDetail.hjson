return {
  as: "div"
};
''',
        css: '''
const goalData = args.fns.goalData?.()?.goal;
const progressPercentage = goalData?.P?.progressPercentage || 0;
const textColor = progressPercentage <= 5 ? args.theme.var.color.text : 'white';

return `._id {
  width: ${progressPercentage}%;
  height: 16px;
  background: linear-gradient(90deg, ${args.theme.var.color.success}, ${args.theme.var.color.primary});
  border-radius: ${args.theme.var.borderRadius.full};
  transition: width ${args.theme.var.animation.slow} ease;
  position: relative;

  &:after {
    content: '${progressPercentage}%';
    position: absolute;
    right: ${args.theme.var.spacing.sm};
    top: 50%;
    transform: translateY(-50%);
    font-size: ${args.theme.var.fontSize.xs};
    font-weight: 600;
    color: ${textColor};
    text-shadow: ${progressPercentage <= 5 ? 'none' : '0 1px 2px rgba(0,0,0,0.3)'};
  }
}`;
'''
