{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "RBGoalDetail",
        url: "/rb/goal-detail",
        fns: '''
const [showGoalModal, setShowGoalModal] = args.createSignal(false);
const [goalModalMode, setGoalModalMode] = args.createSignal("edit");
const [selectedGoal, setSelectedGoal] = args.createSignal(null);

// Goal data state
const [goalData, setGoalData] = args.createSignal(null);
const [isGoalLoading, setIsGoalLoading] = args.createSignal(true);
const [goalError, setGoalError] = args.createSignal(null);

// Load goal data
const loadGoalData = async () => {
  const goalId = args.searchParams?.goalId;
  if (!goalId) {
    setGoalError("Goal ID is required");
    setIsGoalLoading(false);
    return;
  }

  setIsGoalLoading(true);
  setGoalError(null);

  try {
    const response = await args.executeNamedServerFunction({
      functionName: "getGoalById",
      contextData: { goalId }
    });

    if (response.error) {
      throw new Error(response.error);
    }

    const result = response.result;
    if (result.success) {
      setGoalData(result.data);
    } else {
      throw new Error(result.message || "Failed to fetch goal data");
    }
  } catch (err) {
    console.error("Error loading goal data:", err);
    setGoalError(err.message);
    args.showErrorToast(err.message);
  } finally {
    setIsGoalLoading(false);
  }
};

// Load data on mount
const onMount = () => {
  loadGoalData();
};

return {
  showGoalModal,
  setShowGoalModal,
  goalModalMode,
  setGoalModalMode,
  selectedGoal,
  setSelectedGoal,
  goalData,
  setGoalData,
  isGoalLoading,
  setIsGoalLoading,
  goalError,
  setGoalError,
  loadGoalData,
  onMount
};
''',
        props: '''
return {
  isNoPermissionCheck: true,
  onMount: args.fns.onMount
};
'''
      }
    },
