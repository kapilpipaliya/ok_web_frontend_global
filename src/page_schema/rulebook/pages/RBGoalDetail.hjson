    {
      id: "goal_form_modal",
      L: "Attr",
      P: {
        displayOrder: 6,
        componentName: "RBGoalFormModal",
        props: '''
const showGoalModal = args.fns.showGoalModal;
const goalModalMode = args.fns.goalModalMode;
const selectedGoal = args.fns.selectedGoal;
const setShowGoalModal = args.fns.setShowGoalModal;

return {
  isOpen: showGoalModal?.(),
  mode: goalModalMode?.(),
  goalData: selectedGoal?.(),
  onClose: () => {
    setShowGoalModal?.(false);
  },
  onSave: (result) => {
    // Refresh goal data after successful save
    const refreshData = args.fns.loadGoalData;
    if (refreshData) {
      refreshData();
    }
  },
  onDelete: (result) => {
    // Navigate back to goals page after deletion
    args.navigate("/rb/goals");
  }
};
'''
      }
    }
