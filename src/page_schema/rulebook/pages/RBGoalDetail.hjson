    {
      id: "goal_menu_edit",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const fullGoalData = args.fns.goalData?.();
const goalData = fullGoalData?.goal;
const ruleData = fullGoalData?.rule;
const setShowGoalModal = args.fns.setShowGoalModal;
const setGoalModalMode = args.fns.setGoalModalMode;
const setSelectedGoal = args.fns.setSelectedGoal;

return {
  as: "button",
  text: "✏️ Edit",
  onClick: (e) => {
    e.preventDefault();
    e.stopPropagation();

    if (!goalData) {
      args.showErrorToast("Goal data not available");
      return;
    }

    // Prepare goal data for the modal
    const editData = {
      id: goalData.id,
      title: goalData.P.title,
      description: goalData.P.description,
      linkedRule: ruleData?.id || "",
      goalType: goalData.P.goalType,
      targetValue: goalData.P.targetValue,
      unit: goalData.P.unit,
      targetDate: goalData.P.targetDate,
      reward: goalData.P.reward,
      currentValue: goalData.P.currentValue
    };

    setSelectedGoal?.(editData);
    setGoalModalMode?.("edit");
    setShowGoalModal?.(true);
  }
};
''',
        css: '''
return `._id {
  display: block;
  width: 100%;
  text-align: left;
  background: none;
  border: none;
  padding: ${args.theme.var.spacing.sm} ${args.theme.var.spacing.md};
  color: ${args.theme.var.color.text};
  font-size: ${args.theme.var.fontSize.sm};
  cursor: pointer;
  transition: all ${args.theme.var.animation.fast} ease;

  &:hover {
    background: ${args.theme.var.color.background_light_200};
  }
}`;
'''
      }
    },
    {
      id: "goal_menu_complete",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const goalData = args.fns.goalData?.()?.goal;

return {
  as: "button",
  text: goalData?.P?.isCompleted ? "✅ Completed" : "🏆 Mark Complete",
  disabled: goalData?.P?.isCompleted,
  onClick: async (e) => {
    e.preventDefault();
    e.stopPropagation();

    if (!goalData) {
      args.showErrorToast("Goal data not available");
      return;
    }

    if (goalData.P.isCompleted) {
      return; // Already completed
    }

    const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
    if (!rbConfirm) {
      args.showErrorToast("Confirmation dialog not available");
      return;
    }

    const confirmed = await rbConfirm({
      title: "Mark Goal Complete",
      message: "Are you sure you want to mark this goal as complete?",
      confirmText: "Mark Complete",
      cancelText: "Cancel",
      variant: "primary"
    });

    if (confirmed) {
      try {
        const response = await args.executeNamedServerFunction({
          functionName: "updateGoalProgress",
          contextData: {
            goalId: goalData.id,
            manualProgress: goalData.P.targetValue // Set to target value to complete
          }
        });

        if (response.error) {
          args.showErrorToast(response.error);
          return;
        }

        const result = response.result;
        if (result.success) {
          args.showSuccessToast(result.message || "Goal marked as complete!");
          // Refresh the page data
          window.location.reload();
        } else {
          args.showErrorToast(result.message || "Failed to mark goal as complete");
        }
      } catch (error) {
        args.showErrorToast("Error completing goal: " + error.message);
      }
    }
  }
};
''',
        css: '''
return `._id {
  display: block;
  width: 100%;
  text-align: left;
  background: none;
  border: none;
  padding: ${args.theme.var.spacing.sm} ${args.theme.var.spacing.md};
  color: ${args.theme.var.color.text};
  font-size: ${args.theme.var.fontSize.sm};
  cursor: pointer;
  transition: all ${args.theme.var.animation.fast} ease;

  &:hover {
    background: ${args.theme.var.color.background_light_200};
  }
}`;
'''
      }
