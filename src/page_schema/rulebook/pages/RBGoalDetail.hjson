    {
      id: "goal_menu",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        slotName: "right",
        props: '''
const [showMenu, setShowMenu] = args.createSignal(false);

// Global close event handler
const handleCloseAllMenus = (e) => {
  const ref = args.ref();
  if (ref && !ref.contains(e.target)) {
    setShowMenu(false);
  }
};

return {
  as: "div",
  contextName: "menuState",
  data: { showMenu, setShowMenu },
  "data-dropdown-menu": true,
  onMount: () => {
    document.addEventListener('click', handleCloseAllMenus);
  },
  onCleanup: () => {
    document.removeEventListener('click', handleCloseAllMenus);
  }
};
''',
        css: '''
return `._id {
  position: relative;
  display: inline-block;
}`;
'''
      }
