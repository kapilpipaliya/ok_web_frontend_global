    {
      id: "goal_menu_delete",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const goalData = args.fns.goalData?.()?.goal;

return {
  as: "button",
  text: "🗑️ Delete",
  onClick: async (e) => {
    e.preventDefault();
    e.stopPropagation();

    if (!goalData) {
      args.showErrorToast("Goal data not available");
      return;
    }

    const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
    if (!rbConfirm) {
      args.showErrorToast("Confirmation dialog not available");
      return;
    }

    const confirmed = await rbConfirm({
      title: "Delete Goal",
      message: "⚠️ WARNING: This will permanently delete:\n• This goal\n• All progress data\n• All tracking history\n\nThis action cannot be undone!",
      confirmText: "Delete Goal",
      cancelText: "Cancel",
      variant: "danger"
    });

    if (confirmed) {
      try {
        const response = await args.executeNamedServerFunction({
          functionName: "deleteGoal",
          contextData: { goalId: goalData.id }
        });

        if (response.error) {
          args.showErrorToast(response.error);
          return;
        }

        const result = response.result;
        if (result.success) {
          args.showSuccessToast(result.message || "Goal deleted successfully!");
          args.navigate("/rb/goals");
        } else {
          args.showErrorToast(result.message || "Failed to delete goal");
        }
      } catch (error) {
        args.showErrorToast("Error deleting goal: " + error.message);
      }
    }
  }
};
''',
        css: '''
return `._id {
