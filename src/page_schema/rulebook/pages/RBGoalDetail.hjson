      P: {
        displayOrder: 1,
        componentName: "Html",
        slotName: "subtitle",
        props: '''
const goalData = args.fns.goalData?.()?.goal;
const statusText = goalData?.P?.isCompleted ? "Completed" : "Active";
const targetText = goalData?.P?.targetDateFormatted ? `Target: ${goalData.P.targetDateFormatted}` : "";
const valueText = goalData?.P?.targetValue ? `${goalData.P.targetValue} ${goalData.P.unit || 'units'}` : "";

const metaText = [targetText, valueText, statusText].filter(Boolean).join(" • ");

return {
  as: "div",
  text: metaText || "Goal Details"
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.muted};
