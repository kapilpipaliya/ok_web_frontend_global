const ruleData = args.fns.goalData?.()?.rule;

return {
  as: "div",
  text: "No rule is linked to this goal. Goals work best when connected to specific rules for automatic progress tracking.",
  show: !ruleData
};
''',
        css: '''
return `._id {
  padding: ${args.theme.var.spacing.lg};
  background: ${args.theme.var.color.info_light_100};
  color: ${args.theme.var.color.info_dark_200};
  border-radius: ${args.theme.var.borderRadius.md};
  font-style: italic;
  text-align: center;
}`;
'''
