        props: '''
const reportType = c?.timeTabs?.reportType;
const setReportType = c?.timeTabs?.setReportType;
const fetchReportsData = c?.timeTabs?.fetchReportsData;
const isActive = reportType === "day";

const handleClick = () => {
  if (setReportType && fetchReportsData) {
    setReportType("day");
    fetchReportsData("day");
  }
};

return {
  as: "button",
  text: "Day",
  onClick: handleClick
};
''',
        css: '''
