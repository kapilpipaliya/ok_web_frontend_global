return {
  text: "Reports & Analytics"
};
'''
      }
    },
    {
      id: "export_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        slotName: "right",
        props: '''
const exportData = () => {
  const data = c?.reportsPageContext?.reportsData?.();
  if (data) {
    const jsonStr = JSON.stringify(data, null, 2);
    const blob = new Blob([jsonStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `rulebook-report-${data.reportType}-${new Date().toISOString().split('T')[0]}.json`;
    a.click();
    URL.revokeObjectURL(url);
    _.showSuccessToast('Report exported successfully!');
  }
};

return {
  as: "button",
  "aria-label": "Export data",
  onClick: exportData
};
''',
        css: '''
return `._id {
  background: ${t.var.color.background};
  border: 1px solid ${t.var.color.border};
  color: ${t.var.color.text};
  cursor: pointer;
  padding: ${t.var.spacing.sm} ${t.var.spacing.md};
  border-radius: ${t.var.borderRadius.md};
  transition: all 300ms ease;
  display: flex;
  align-items: center;
  gap: ${t.var.spacing.sm};
  font-weight: 500;
}

._id:hover {
  background: ${t.var.color.background_dark_200};
  border-color: ${t.var.color.primary};
  transform: translateY(-1px);
}

._id:active {
  transform: translateY(0);
}`;
'''
      }
