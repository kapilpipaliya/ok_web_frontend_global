      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "RBD3Chart",
        props: '''
const reportsData = c?.reportsPageContext?.reportsData?.();

if (!reportsData?.summary) {
  const isMobile = window.innerWidth <= 768;
  const chartSize = isMobile ? Math.min(window.innerWidth - 60, 280) : 350;

  return {
    chartType: "pie",
    width: chartSize,
    height: chartSize,
    data: null
  };
}

const summary = reportsData.summary || {};
const completed = summary.completed || 0;
const partial = summary.partial || 0;
const missed = summary.missed || 0;

const chartData = {
  labels: ["Completed", "Partial", "Missed"],
  datasets: [
    {
      label: "Status Distribution",
      data: [completed, partial, missed],
      backgroundColor: [
        t.var.color.success + "80",
        t.var.color.warning + "80",
        t.var.color.error + "80"
      ],
      borderColor: [
        t.var.color.success,
        t.var.color.warning,
        t.var.color.error
      ]
    }
  ]
};

// Make chart responsive
const isMobile = window.innerWidth <= 768;
const chartSize = isMobile ? Math.min(window.innerWidth - 60, 280) : 350;

return {
  chartType: "pie",
  width: chartSize,
  height: chartSize,
  data: chartData
};
'''
