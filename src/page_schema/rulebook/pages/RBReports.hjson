    {
      id: "category_performance_chart",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "RBD3Chart",
        props: '''
const reportsData = c?.reportsPageContext?.reportsData?.();

if (!reportsData?.categories || reportsData.categories.length === 0) {
  const isMobile = window.innerWidth <= 768;
  const chartWidth = isMobile ? Math.min(window.innerWidth - 60, 350) : 600;
  const chartHeight = isMobile ? 200 : 300;

  return {
    chartType: "bar",
    width: chartWidth,
    height: chartHeight,
    data: null
  };
}

// Create bar chart data for category completion rates
const categories = reportsData.categories ? reportsData.categories.slice(0, 8) : []; // Limit to top 8 categories

const chartData = {
  labels: categories.map(cat => cat.category?.P?.name || "Unnamed"),
  datasets: [
    {
      label: 'Completion Rate (%)',
      data: categories.map(cat => cat.stats?.completionRate || 0),
      backgroundColor: categories.map(cat => cat.category?.P?.color || t.var.color.primary + "80"),
      borderColor: categories.map(cat => cat.category?.P?.color || t.var.color.primary)
    }
  ]
};

// Make chart responsive
const isMobile = window.innerWidth <= 768;
const chartWidth = isMobile ? Math.min(window.innerWidth - 60, 350) : 600;
const chartHeight = isMobile ? 200 : 300;

return {
  chartType: "bar",
  width: chartWidth,
  height: chartHeight,
  data: chartData
};
'''
