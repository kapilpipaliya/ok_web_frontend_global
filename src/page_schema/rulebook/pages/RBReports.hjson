      P: {
        displayOrder: 1,
        componentName: "RBD3Chart",
        props: '''
const reportsData = c?.reportsPageContext?.reportsData?.();

if (!reportsData?.chartData) {
  const isMobile = window.innerWidth <= 768;
  const chartWidth = isMobile ? Math.min(window.innerWidth - 60, 350) : 800;
  const chartHeight = isMobile ? 200 : 300;

  return {
    chartType: "area",
    width: chartWidth,
    height: chartHeight,
    data: null
  };
}

const chartData = {
  labels: reportsData.chartData?.labels || [],
  datasets: [
    {
      label: 'Completed',
      data: reportsData.chartData?.completedData || [],
      backgroundColor: t.var.color.success + '80',
      borderColor: t.var.color.success
    },
    {
      label: 'Partial',
      data: reportsData.chartData?.partialData || [],
      backgroundColor: t.var.color.warning + '60',
      borderColor: t.var.color.warning
    },
    {
      label: 'Missed',
      data: reportsData.chartData?.missedData || [],
      backgroundColor: t.var.color.error + '40',
      borderColor: t.var.color.error
    }
  ]
};

// Make chart responsive
const isMobile = window.innerWidth <= 768;
const chartWidth = isMobile ? Math.min(window.innerWidth - 60, 350) : 800;
const chartHeight = isMobile ? 200 : 300;

return {
  chartType: "area",
  width: chartWidth,
  height: chartHeight,
  data: chartData
};
'''
