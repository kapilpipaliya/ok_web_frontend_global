              t.var.color.error;

return `._id {
  background: ${t.var.color.background};
  border: 1px solid ${t.var.color.border};
  border-radius: ${t.var.borderRadius.lg};
  padding: ${t.var.spacing.lg};
  text-align: center;
  transition: all 300ms ease;
}

._id:hover {
