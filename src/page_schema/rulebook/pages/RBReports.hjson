{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "RBReports",
        url: "/rb/reports",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
// Create signals for state management
const [reportType, setReportType] = _.createSignal('week');
const [reportsData, setReportsData] = _.createSignal(null);
const [isLoading, setIsLoading] = _.createSignal(true);
const [error, setError] = _.createSignal(null);

// Function to fetch reports data
const fetchReportsData = async (type) => {
  try {
    setIsLoading(true);
    setError(null);

    const response = await s({
      functionName: 'getReportsData',
      contextData: {
        reportType: type,
        includeStreaks: true,
        includeInsights: true
      }
    });

    // Handle error response
    if (response.error) {
      setError(response.error);
      _.showErrorToast(response.error);
      return;
    }

    // Handle success response
    if (response.result && response.result.success) {
      setReportsData(response.result.data);
    } else {
      const message = response.result?.message || 'Failed to load reports data';
      setError(message);
      _.showErrorToast(message);
    }
  } catch (err) {
    console.error('Error fetching reports data:', err);
    setError('Failed to load reports data. Please try again.');
    _.showErrorToast('Failed to load reports data');
  } finally {
    setIsLoading(false);
  }
};

// Initial data fetch on mount
const onMount = () => {
  fetchReportsData(reportType());
};

return {
  isNoPermissionCheck: true,
  contextName: "reportsPageContext",
  onMount,
  data: {
    reportType,
    setReportType,
    reportsData,
    setReportsData,
    isLoading,
    setIsLoading,
    error,
    setError,
    fetchReportsData
  }
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
        componentName: "RBLayout",
        displayOrder: 1
      }
    },
    {
      id: "page_content",
      L: "Attr",
      P: {
        displayOrder: 2,
