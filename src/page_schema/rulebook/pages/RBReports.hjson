const insight = c?.insightsList;
const type = insight?.type || 'info';
const bgColor = type === 'success' ? t.var.color.success_light_100 :
                 type === 'warning' ? t.var.color.warning_light_100 :
                 type === 'error' ? t.var.color.error_light_100 :
                 t.var.color.info_light_100;
const borderColor = type === 'success' ? t.var.color.success_light_300 :
                    type === 'warning' ? t.var.color.warning_light_300 :
                    type === 'error' ? t.var.color.error_light_300 :
                    t.var.color.info_light_300;
const textColor = type === 'success' ? t.var.color.success_dark_700 :
                  type === 'warning' ? t.var.color.warning_dark_700 :
                  type === 'error' ? t.var.color.error_dark_700 :
                  t.var.color.info_dark_700;

return `._id {
  background: ${bgColor};
  border: 1px solid ${borderColor};
  color: ${textColor};
  padding: ${t.var.spacing.sm} ${t.var.spacing.md};
  border-radius: ${t.var.borderRadius.md};
  font-size: 1rem;
  line-height: 1.5;
}`;
'''
