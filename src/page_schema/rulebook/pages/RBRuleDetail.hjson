    {
      id: "edit_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "button",
  onClick: (e) => {
    e.preventDefault();
    e.stopPropagation();
    const { setShowRuleModal, setModalMode, setSelectedRule } = args.contextData.ruleDetail?.ruleModal || {};
    const ruleData = args.contextData.ruleDetail?.ruleData?.();
    const rule = ruleData?.rule;
    const category = ruleData?.category;

    if (rule) {
      // Create rule data with category ID in P properties for the modal
      const ruleForModal = {
        ...rule,
        P: {
          ...rule.P,
          categoryId: category?.id // Add categoryId to P properties where modal expects it
        }
      };

      setSelectedRule?.(ruleForModal);
      setModalMode?.("edit");
      setShowRuleModal?.(true);
    } else {
      args.showErrorToast("Rule data not available");
    }
  },
  "aria-label": "Edit rule"
};
''',
        css: '''
return `._id {
  background: none;
  border: none;
  color: ${args.theme.var.color.muted};
  cursor: pointer;
  text-decoration: none;
  padding: ${args.theme.var.spacing.sm};
  border-radius: ${args.theme.var.borderRadius.sm};
  transition: all ${args.theme.var.animation.fast} ease;

  &:hover {
    background: ${args.theme.var.color.background_light_200};
    color: ${args.theme.var.color.text};
  }
}`;
'''
