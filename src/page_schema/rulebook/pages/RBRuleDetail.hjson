        css: '''
const ruleData = args.contextData.ruleDetail?.ruleData?.();
const rule = ruleData?.rule;
const priority = rule?.P?.priority || "medium";

// Get priority color
const getPriorityColor = (priority) => {
  switch (priority) {
    case "low":
      return args.theme.var.color.success;
    case "medium":
      return args.theme.var.color.warning;
    case "high":
      return args.theme.var.color.error;
    case "critical":
      return args.theme.var.color.error_dark_200;
    default:
      return args.theme.var.color.text;
  }
};

return `._id {
  font-weight: 600;
  color: ${getPriorityColor(priority)};
}`;
'''
