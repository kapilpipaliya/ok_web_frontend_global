        props: '''
return {
  as: "button",
  onClick: (e) => {
    e.preventDefault();
    e.stopPropagation();
    const { setShowGoalModal, setModalMode, setSelectedGoal } = c.ruleDetail?.goalModal || {};
    const ruleData = c.ruleDetail?.ruleData?.();
    const rule = ruleData?.rule;
    const ruleId = rule?.id;

    // Set goal data with current rule pre-selected
    setSelectedGoal?.({
      linkedRule: ruleId,
      ruleData: ruleData
    });
    setModalMode?.("create");
    setShowGoalModal?.(true);
  },
  "aria-label": "Add new goal"
};
''',
        css: '''
return `._id {
  background: ${t.var.color.success};
  color: ${t.var.color.success_text};
  border: none;
  cursor: pointer;
  padding: ${t.var.spacing.sm};
