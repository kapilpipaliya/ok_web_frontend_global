        displayOrder: 3,
        componentName: "Html",
        props: '''
const ruleData = c.ruleDetail?.ruleData?.();
const stats = ruleData?.stats;
const currentStreak = stats?.currentStreak || 0;
const flames = Math.min(currentStreak, 10); // Cap at 10 flames
const flameText = currentStreak > 0 ? "🔥".repeat(flames) : "⚪";

return {
  as: "div",
  text: flameText
};
''',
