{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "RBRuleDetail",
        url: "/rb/rule-detail",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
// Rule modal state
const [showRuleModal, setShowRuleModal] = args.createSignal(false);
const [modalMode, setModalMode] = args.createSignal("create");
const [selectedRule, setSelectedRule] = args.createSignal(null);

// Rule data state
const [ruleData, setRuleData] = args.createSignal(null);
const [isLoading, setIsLoading] = args.createSignal(true);
const [error, setError] = args.createSignal(null);

// Load rule data
const loadRuleData = async () => {
  const ruleId = args.searchParams?.ruleId;
  if (!ruleId) {
    setError("Rule ID is required");
    setIsLoading(false);
    return;
  }

  setIsLoading(true);
  setError(null);

  try {
    // Use the getRuleById function
    const ruleResult = await args.executeNamedServerFunction({
      functionName: "getRuleById",
      contextData: {
        ruleId
      }
    });

    if (ruleResult.error) {
      throw new Error(ruleResult.error);
    }

    if (ruleResult.result?.success) {
      const ruleDataResponse = ruleResult.result.data.rule;
      setRuleData(ruleDataResponse);
    } else {
      throw new Error(ruleResult.result?.message || "Failed to load rule data");
    }

  } catch (err) {
    console.error("Error loading rule data:", err);
    setError(err.message);
    args.showErrorToast(err.message);
  } finally {
    setIsLoading(false);
  }
};

// Load data on mount
const onMount = () => {
  loadRuleData();
};

return {
  isNoPermissionCheck: true,
  contextName: "ruleDetail",
  onMount,
  data: {
    ruleData,
    isLoading,
    error,
    refreshData: loadRuleData,
    ruleModal: {
      showRuleModal,
      setShowRuleModal,
      modalMode,
      setModalMode,
      selectedRule,
      setSelectedRule,
      refreshData: loadRuleData
    }
  }
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
        componentName: "RBLayout",
        displayOrder: 1
      }
    },
    {
      id: "page_content",
      L: "Attr",
      P: {
