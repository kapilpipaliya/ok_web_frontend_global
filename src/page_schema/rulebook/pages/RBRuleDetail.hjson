{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "RBRuleDetail",
        url: "/rb/rule-detail",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
// Rule modal state
const [showRuleModal, setShowRuleModal] = _.createSignal(false);
const [modalMode, setModalMode] = _.createSignal("create");
const [selectedRule, setSelectedRule] = _.createSignal(null);

// Goal modal state
const [showGoalModal, setShowGoalModal] = _.createSignal(false);
const [goalModalMode, setGoalModalMode] = _.createSignal("create");
const [selectedGoal, setSelectedGoal] = _.createSignal(null);

// Rule data state
const [ruleData, setRuleData] = _.createSignal(null);
const [goals, setGoals] = _.createSignal([]);
const [isLoading, setIsLoading] = _.createSignal(true);
const [error, setError] = _.createSignal(null);

// Load rule data
const loadRuleData = async () => {
  const ruleId = _.searchParams?.ruleId;
  if (!ruleId) {
    setError("Rule ID is required");
    setIsLoading(false);
    return;
  }

  setIsLoading(true);
  setError(null);

  try {
    // Use the getRuleById function
    const ruleResult = await s({
      functionName: "getRuleById",
      contextData: {
        ruleId
      }
    });

    if (ruleResult.error) {
      throw new Error(ruleResult.error);
    }

    if (ruleResult.result?.success) {
      const ruleDataResponse = ruleResult.result.data.rule;
      setRuleData(ruleDataResponse);
    } else {
      throw new Error(ruleResult.result?.message || "Failed to load rule data");
    }

    // Load goals for this rule
    console.log("Loading goals for rule:", ruleId);
    const goalsResult = await s({
      functionName: "getGoals",
      contextData: {
        ruleId: ruleId,  // Pass the ruleId to get goals only for this rule
        includeCompleted: true  // Include completed goals as well
      }
    });

    if (goalsResult.result?.success) {
      const ruleGoals = goalsResult.result.data.goals || [];
      console.log("Goals loaded for rule:", ruleGoals.length);
      setGoals(ruleGoals);
    } else {
      console.log("Failed to load goals:", goalsResult.result?.message);
      setGoals([]);
    }

  } catch (err) {
    console.error("Error loading rule data:", err);
    setError(err.message);
    _.showErrorToast(err.message);
  } finally {
    setIsLoading(false);
  }
};

// Load data on mount
const onMount = () => {
  loadRuleData();
};

return {
  isNoPermissionCheck: true,
  contextName: "ruleDetail",
  onMount,
  data: {
    ruleData,
    goals,
    isLoading,
    error,
    refreshData: loadRuleData,
    ruleModal: {
      showRuleModal,
      setShowRuleModal,
      modalMode,
      setModalMode,
      selectedRule,
      setSelectedRule,
      refreshData: loadRuleData
    },
    goalModal: {
      showGoalModal,
      setShowGoalModal,
      modalMode: goalModalMode,
      setModalMode: setGoalModalMode,
      selectedGoal,
      setSelectedGoal,
      refreshData: loadRuleData
    }
  }
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
        componentName: "RBLayout",
        displayOrder: 1
      }
    },
