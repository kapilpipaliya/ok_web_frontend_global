const modalData = args.contextData.ruleDetail?.ruleModal || {};
return {
  isOpen: modalData.showRuleModal?.(),
  mode: modalData.modalMode?.(),
  ruleData: modalData.selectedRule?.(),
  onClose: () => {
    modalData.setShowRuleModal?.(false);
    modalData.setSelectedRule?.(null);
  },
  onSave: (result) => {
    // Refresh page data after successful save
    if (modalData.refreshData) {
      modalData.refreshData();
    }
  },
  onDelete: (result) => {
    // Navigate back to rules page after successful delete
    args.navigate("/rb/rules");
  }
};
'''
