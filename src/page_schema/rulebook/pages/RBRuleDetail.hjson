        css: '''
const ruleData = c.ruleDetail?.ruleData?.();
const rule = ruleData?.rule;
const priority = rule?.P?.priority || "medium";

// Get priority color
const getPriorityColor = (priority) => {
  switch (priority) {
    case "low":
      return t.var.color.success;
    case "medium":
      return t.var.color.warning;
    case "high":
      return t.var.color.error;
    case "critical":
      return t.var.color.error_dark_200;
    default:
      return t.var.color.text;
  }
};

return `._id {
  font-weight: 600;
  color: ${getPriorityColor(priority)};
}`;
'''
