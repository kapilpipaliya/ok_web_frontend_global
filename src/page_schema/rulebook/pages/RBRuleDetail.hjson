        slotName: "right",
        props: '''
return {
  as: "button",
  onClick: (e) => {
    e.preventDefault();
    e.stopPropagation();
    const { setShowRuleModal, setModalMode, setSelectedRule } = c.ruleDetail?.ruleModal || {};
    const ruleData = c.ruleDetail?.ruleData?.();
    const rule = ruleData?.rule;
    const category = ruleData?.category;

    if (rule) {
      // Create rule data with category ID in P properties for the modal
      const ruleForModal = {
        ...rule,
        P: {
          ...rule.P,
          categoryId: category?.id // Add categoryId to P properties where modal expects it
        }
      };

      setSelectedRule?.(ruleForModal);
      setModalMode?.("edit");
      setShowRuleModal?.(true);
    } else {
      _.showErrorToast("Rule data not available");
    }
  },
  "aria-label": "Edit rule"
};
''',
        css: '''
