    {
      id: "empty_goals_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "RBButton",
        props: '''
return {
  text: "Add First Goal",
  variant: "primary",
  onClick: (e) => {
    e.preventDefault();
    e.stopPropagation();
    const { setShowGoalModal, setModalMode, setSelectedGoal } = c.ruleDetail?.goalModal || {};
    const ruleData = c.ruleDetail?.ruleData?.();
    const rule = ruleData?.rule;
    const ruleId = rule?.id;

    // Set goal data with current rule pre-selected
    setSelectedGoal?.({
      linkedRule: ruleId,
      ruleData: ruleData
    });
    setModalMode?.("create");
    setShowGoalModal?.(true);
  }
};
'''
      }
    },
    {
      id: "goal_form_modal",
      L: "Attr",
      P: {
        displayOrder: 999,
        componentName: "RBGoalFormModal",
        props: '''
const modalData = c.ruleDetail?.goalModal || {};
const refreshData = c.ruleDetail?.refreshData;

return {
  isOpen: modalData.showGoalModal?.(),
  mode: modalData.modalMode?.(),
  goalData: modalData.selectedGoal?.(),
  onClose: () => {
    modalData.setShowGoalModal?.(false);
    modalData.setSelectedGoal?.(null);
  },
  onSave: async (result) => {
    // Close the modal first
    modalData.setShowGoalModal?.(false);
    modalData.setSelectedGoal?.(null);
    
    // Add a small delay to ensure database transaction completes
    await new Promise(resolve => setTimeout(resolve, 500));
    
    // Refresh rule and goals data after successful save
    console.log("Goal saved, refreshing data...");
    if (refreshData) {
      await refreshData();
    }
  },
  onDelete: async (result) => {
    // Close the modal first
    modalData.setShowGoalModal?.(false);
    modalData.setSelectedGoal?.(null);
    
    // Add a small delay to ensure database transaction completes
    await new Promise(resolve => setTimeout(resolve, 500));
    
    // Refresh rule and goals data after successful delete
    console.log("Goal deleted, refreshing data...");
    if (refreshData) {
      await refreshData();
    }
  }
};
'''
      }
    },
    {
      id: "rule_form_modal",
      L: "Attr",
      P: {
        displayOrder: 999,
        componentName: "RBRuleFormModal",
        props: '''
const modalData = c.ruleDetail?.ruleModal || {};
return {
  isOpen: modalData.showRuleModal?.(),
  mode: modalData.modalMode?.(),
  ruleData: modalData.selectedRule?.(),
  onClose: () => {
    modalData.setShowRuleModal?.(false);
    modalData.setSelectedRule?.(null);
  },
  onSave: (result) => {
    // Refresh page data after successful save
    if (modalData.refreshData) {
      modalData.refreshData();
    }
  },
  onDelete: (result) => {
    // Navigate back to rules page after successful delete
    _.navigate("/rb/rules");
  }
};
'''
      }
    }
