return {
  as: "section"
};
''',
        css: '''
return `._id {
  text-align: center;
  padding: ${args.theme.var.spacing.xxl} ${args.theme.var.spacing.xl};
  background: linear-gradient(135deg, ${args.theme.var.color.primary}, ${args.theme.var.color.success});
  border-radius: ${args.theme.var.borderRadius.xl};
  color: ${args.theme.var.color.primary_text};
}

._id h2 {
  font-size: ${args.theme.var.fontSize.xxl};
  font-weight: 700;
  margin-bottom: ${args.theme.var.spacing.lg};
  color: ${args.theme.var.color.primary_text};
}

._id p {
  font-size: ${args.theme.var.fontSize.lg};
  margin-bottom: ${args.theme.var.spacing.xl};
  opacity: 0.9;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

._id .buttons {
  display: flex;
  gap: ${args.theme.var.spacing.lg};
  justify-content: center;
  flex-wrap: wrap;
}

._id button {
  padding: ${args.theme.var.spacing.md} ${args.theme.var.spacing.xl};
  border: none;
  border-radius: ${args.theme.var.borderRadius.full};
  font-size: ${args.theme.var.fontSize.lg};
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}

._id .primary-btn {
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.primary};
}

._id .primary-btn:hover {
  background: ${args.theme.var.color.background_light_200};
  transform: translateY(-2px);
  box-shadow: 0 8px 20px ${args.theme.var.color.primary_light_400};
}

._id .secondary-btn {
  background: transparent;
  color: ${args.theme.var.color.primary_text};
  border: 2px solid ${args.theme.var.color.primary_text};
}

._id .secondary-btn:hover {
  background: ${args.theme.var.color.primary_text};
  color: ${args.theme.var.color.primary};
  transform: translateY(-2px);
}

@media (max-width: 768px) {
  ._id {
    padding: ${args.theme.var.spacing.xl};
  }

  ._id h2 {
    font-size: ${args.theme.var.fontSize.xl};
  }

  ._id p {
    font-size: ${args.theme.var.fontSize.md};
  }

  ._id .buttons {
    flex-direction: column;
    align-items: center;
    gap: ${args.theme.var.spacing.md};
  }

  ._id button {
    width: 100%;
    max-width: 300px;
  }
}`;
'''
