{
  vertexes: [
    {
      id: "features_page",
      L: "Page",
      P: {
        key: "RBFeatures",
        url: "/features",
        title: "Features - Personal Rulebook",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "features_layout_1",
      L: "PageLayout",
      P: {
        componentName: "RBWebsiteLayout",
        displayOrder: 1
      }
    },
    {
      id: "features_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1200px;
  margin: 0 auto;
  padding: ${args.theme.var.spacing.lg};
  color: ${args.theme.var.color.text};
}

@media (max-width: 768px) {
  ._id {
    padding: ${args.theme.var.spacing.md};
  }
}`;
'''
      }
    },
    {
      id: "page_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RBHeader"
      }
    },
    {
      id: "header_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        slotName: "center",
        props: '''
return {
  as: "h1",
  text: "Powerful Features for Personal Growth"
};
''',
        css: '''
return `._id {
  font-size: 2rem;
  font-weight: 700;
  color: ${args.theme.var.color.primary};
  margin: 0;
}

@media (max-width: 768px) {
  ._id {
    font-size: 1.75rem;
  }
}`;
'''
      }
    },
    {
      id: "header_subtitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        slotName: "subtitle",
        props: '''
return {
  as: "p",
  text: "Everything you need to transform your personal principles into consistent daily habits"
};
''',
        css: '''
return `._id {
  font-size: 1.1rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin: 0 auto;
  max-width: 700px;
}

@media (max-width: 768px) {
  ._id {
    font-size: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "main_features_section",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  margin-bottom: ${args.theme.var.spacing.xxl};
}`;
'''
      }
    },
    {
      id: "main_features_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h2",
  text: "Core Features"
};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.xxl};
  font-weight: 700;
  color: ${args.theme.var.color.primary};
  text-align: center;
  margin-bottom: ${args.theme.var.spacing.xl};
  position: relative;
}

._id::after {
  content: '';
  position: absolute;
  bottom: -${args.theme.var.spacing.md};
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 4px;
  background: ${args.theme.var.color.primary};
  border-radius: 2px;
}`;
'''
      }
    },
    {
      id: "main_features_grid",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: ${args.theme.var.spacing.xl};
}

@media (max-width: 768px) {
  ._id {
    grid-template-columns: 1fr;
    gap: ${args.theme.var.spacing.lg};
  }
}`;
'''
      }
    },
    {
      id: "feature_rule_management",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  padding: ${args.theme.var.spacing.xl};
  background: ${args.theme.var.color.background_light_100};
  border-radius: ${args.theme.var.borderRadius.xl};
  border: 2px solid ${args.theme.var.color.primary_light_200};
  transition: all 0.3s ease;
}

._id:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 25px ${args.theme.var.color.primary_light_300};
  border-color: ${args.theme.var.color.primary_light_300};
}

._id .icon {
  color: ${args.theme.var.color.primary};
  margin-bottom: ${args.theme.var.spacing.lg};
}

._id h3 {
  color: ${args.theme.var.color.primary};
  font-weight: 700;
  font-size: ${args.theme.var.fontSize.xl};
  margin-bottom: ${args.theme.var.spacing.md};
}

._id p {
  color: ${args.theme.var.color.text};
  line-height: 1.7;
  margin-bottom: ${args.theme.var.spacing.lg};
  font-size: ${args.theme.var.fontSize.md};
}

._id ul {
  color: ${args.theme.var.color.text};
  padding-left: ${args.theme.var.spacing.lg};
}

._id li {
  margin-bottom: ${args.theme.var.spacing.xs};
  line-height: 1.6;
}`;
'''
      }
