    {
      id: "timezone_preference",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        fns: '''
const fetchTimezones = async () => {
  try {
    const response = await s({
      functionName: "getAvailableTimezones",
      contextData: {}
    });

    if (response.error) {
      return null;
    }

    if (response.result && response.result.success) {
      return response.result.data;
    }
    return null;
  } catch (error) {
    return null;
  }
};

const saveTimezone = async (timezone) => {
  try {
    const response = await s({
      functionName: "updateUserTimezone",
      contextData: { timezone }
    });

    if (response.error) {
      _.showErrorToast(response.error);
      return false;
    }

    if (response.result && response.result.success) {
      _.showSuccessToast(response.result.message);
      return true;
    } else {
      const errorMsg = response.result?.message || "Failed to update timezone";
      _.showErrorToast(errorMsg);
      return false;
    }
  } catch (error) {
    _.showErrorToast("Error updating timezone: " + error.message);
    return false;
  }
};

return { fetchTimezones, saveTimezone };
''',
        props: '''
const [timezoneData, setTimezoneData] = _.createSignal(null);
const [selectedTimezone, setSelectedTimezone] = _.createSignal('');
const [loading, setLoading] = _.createSignal(true);
const [saving, setSaving] = _.createSignal(false);
const [searchTerm, setSearchTerm] = _.createSignal('');
const [showDropdown, setShowDropdown] = _.createSignal(false);

const handleSave = async () => {
  setSaving(true);
  try {
    const success = await f.saveTimezone(selectedTimezone());
    if (success) {
      // Reload timezone data from server to get the updated value
      const freshData = await f.fetchTimezones();
      if (freshData) {
        setTimezoneData(freshData);
        setSelectedTimezone(freshData.currentTimezone);
        setSearchTerm(freshData.currentTimezone);
      }
    }
  } catch (error) {
    _.showErrorToast('Failed to save timezone');
  } finally {
    setSaving(false);
  }
};

return {
  as: "div",
  data: {
    timezoneData,
    selectedTimezone,
    setSelectedTimezone,
    loading,
    searchTerm,
    setSearchTerm,
    showDropdown,
    setShowDropdown,
    saving,
    setSaving,
    handleSave
  },
  onMount: async () => {
    // Load timezones when component mounts
    const data = await f.fetchTimezones();
    if (data) {
      setTimezoneData(data);
      setSelectedTimezone(data.currentTimezone || 'UTC');
      setSearchTerm(data.currentTimezone || 'UTC');
    } else {
      setSelectedTimezone('UTC');
      setSearchTerm('UTC');
    }
    setLoading(false);
  }
};
''',
        css: '''
return `._id {
  padding: ${t.var.spacing.md} 0;
  border-bottom: 1px solid ${t.var.color.border};
}`;
''',
        contextName: "timezoneSection"
      }
