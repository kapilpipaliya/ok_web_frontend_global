}`;
'''
      }
    },
    {
      id: "timezone_subtitle",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const timezoneSection = c?.timezoneSection;
if (!timezoneSection) {
  return {
    as: "div",
    text: "Loading timezone information..."
  };
}

const { selectedTimezone, loading } = timezoneSection;

if (loading()) {
  return {
    as: "div",
    text: "Loading timezone information..."
  };
}

const tz = selectedTimezone() || 'UTC';
const now = new Date();
const timeString = now.toLocaleString('en-US', {
  timeZone: tz,
  dateStyle: 'medium',
  timeStyle: 'short'
});

return {
  as: "div",
  text: `Current time: ${timeString}`
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  color: ${t.var.color.text_light_500};
}`;
'''
