    },
    {
      id: "delete_data_confirm",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "RBButton",
        props: '''
const {
  setShowDeleteConfirmation,
  deleteDataLoading,
  setDeleteDataLoading
} = c.dangerSection;

return {
  text: deleteDataLoading() ? "Deleting..." : "Yes, Delete All Data",
  variant: "danger",
  loading: deleteDataLoading(),
  disabled: deleteDataLoading(),
  onClick: async () => {
    setDeleteDataLoading(true);
    try {
      const response = await s({
        functionName: "deleteAllUserData",
        contextData: {}
      });

      if (response.error) {
        _.showErrorToast(response.error);
        return;
      }

      const result = response.result;
      if (result.success) {
        _.showSuccessToast(result.message);
        setShowDeleteConfirmation(false);
        // Optionally redirect to home or reload page
        setTimeout(() => {
          _.navigate("/rb");
        }, 1500);
      } else {
        _.showErrorToast(result.message || "Failed to delete data");
      }
    } catch (error) {
      _.showErrorToast("Error deleting data: " + error.message);
    } finally {
      setDeleteDataLoading(false);
    }
  }
};
'''
      }
    },
