        componentName: "Html",
        fns: '''
const generateSampleData = async () => {
  try {
    const response = await s({
      functionName: "generateSampleData",
      contextData: {}
    });

    if (response.error) {
      _.showErrorToast(response.error);
      return false;
    }

    if (response.result && response.result.success) {
      _.showSuccessToast(response.result.message);
      return true;
    } else {
      const errorMsg = response.result?.message || "Failed to generate sample data";
      _.showErrorToast(errorMsg);
      return false;
    }
  } catch (error) {
    _.showErrorToast("Error generating sample data: " + error.message);
    return false;
  }
};

return { generateSampleData };
''',
        props: '''
// Check if admin=true query parameter is present
const isAdmin = _.searchParams?.admin === 'true';

const [generating, setGenerating] = _.createSignal(false);

const handleGenerateSampleData = async () => {
  setGenerating(true);
  try {
    await f.generateSampleData();
  } finally {
    setGenerating(false);
  }
};

return {
  as: "section",
  show: isAdmin,
  data: {
    generating,
    handleGenerateSampleData
  }
};
''',
