{
  vertexes: [
    {
      id: "page_root"
      L: "Page"
      P: {
        key: "RBStreakAnalytics"
        url: "/rb/analytics",
        fns: '''
        return {
          enabled: true
        };
        ''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    }
    {
      id: "layout1"
      L: "PageLayout"
      P: {
        componentName: "RBLayout"
        displayOrder: 1
      }
    }
    {
      id: "page_wrapper"
      L: "Attr"
      P: {
        displayOrder: 1
        componentName: "Html"
        contextName: "analyticsData"
        serverFunction: '''
// Get current authenticated user from session
const user = await args.getUserFromSession();
if (!user) {
  throw new Error("User session not found. Please log in and try again.");
}

// Calculate date range for all time
const today = new Date();
const todayStr = today.toISOString().split('T')[0];
const startDate = '2020-01-01'; // Far back date to include everything

const queryParams = {
  userUuid: user.P.uuid,
  startDate,
  endDate: todayStr
};

// STEP 1: Get overall streak statistics
const overallStreakQuery = `
  MATCH (u:User {uuid: $userUuid})-[:UserRuleStreak]->(rs:RuleStreak)-[:RuleStreakRule]->(r:Rule)<-[:UserRule]-(u)
  MATCH (r)-[:RuleCategory]->(rc:RuleCategory)<-[:UserRuleCategory]-(u)
  WHERE rs.isActive = true
  RETURN
    COUNT(*) as totalRules,
    COUNT(CASE WHEN rs.currentStreak > 0 THEN 1 END) as activeStreaks,
    AVG(rs.currentStreak) as avgCurrentStreak,
    AVG(rs.longestStreak) as avgLongestStreak,
    MAX(rs.currentStreak) as maxCurrentStreak,
    MAX(rs.longestStreak) as maxLongestStreak,
    SUM(rs.totalCompletions) as totalCompletions,
    AVG(rs.totalCompletions) as avgCompletions
`;

const overallResult = await args.session.run(overallStreakQuery, queryParams);
const overallStats = overallResult.records[0];

// STEP 2: Get top current streaks
const topCurrentStreaksQuery = `
  MATCH (u:User {uuid: $userUuid})-[:UserRuleStreak]->(rs:RuleStreak)-[:RuleStreakRule]->(r:Rule)<-[:UserRule]-(u)
  MATCH (r)-[:RuleCategory]->(rc:RuleCategory)<-[:UserRuleCategory]-(u)
  WHERE rs.currentStreak > 0 AND rs.isActive = true
  RETURN r, rc, rs
  ORDER BY rs.currentStreak DESC
  LIMIT 5
`;

const topCurrentResult = await args.session.run(topCurrentStreaksQuery, queryParams);

// STEP 3: Get category-wise streak performance
const categoryStreakQuery = `
  MATCH (u:User {uuid: $userUuid})-[:UserRuleStreak]->(rs:RuleStreak)-[:RuleStreakRule]->(r:Rule)<-[:UserRule]-(u)
  MATCH (r)-[:RuleCategory]->(rc:RuleCategory)<-[:UserRuleCategory]-(u)
  WHERE rs.isActive = true
  WITH rc, rs
  RETURN
    rc,
    COUNT(*) as totalRules,
    COUNT(CASE WHEN rs.currentStreak > 0 THEN 1 END) as activeStreaks,
    AVG(rs.currentStreak) as avgCurrentStreak,
    AVG(rs.longestStreak) as avgLongestStreak,
    MAX(rs.currentStreak) as maxCurrentStreak,
    MAX(rs.longestStreak) as maxLongestStreak,
    SUM(rs.totalCompletions) as totalCompletions
  ORDER BY avgCurrentStreak DESC
`;

const categoryStreakResult = await args.session.run(categoryStreakQuery, queryParams);

// Process results
const totalRules = args.neo4jConvert.js(overallStats.get('totalRules')) || 0;
const activeStreaks = args.neo4jConvert.js(overallStats.get('activeStreaks')) || 0;
const streakEngagementRate = totalRules > 0 ? (activeStreaks / totalRules) * 100 : 0;

// Process top current streaks using vertex format
const topCurrentStreaks = topCurrentResult.records.map(record => {
  const ruleNode = record.get('r');
  const categoryNode = record.get('rc');
  const streakNode = record.get('rs');

  const rule = args.convertNodeToJson(ruleNode);
  const category = categoryNode ? args.convertNodeToJson(categoryNode) : null;
  const streak = args.convertNodeToJson(streakNode);

  return {
    rule,     // Full vertex format
    category, // Full vertex format or null
    streak    // Full vertex format
  };
});

// Process category streaks using vertex format
const categoryAnalysis = categoryStreakResult.records.map(record => {
  const categoryNode = record.get('rc');
  const category = args.convertNodeToJson(categoryNode);

  const totalRules = args.neo4jConvert.js(record.get('totalRules')) || 0;
  const activeStreaks = args.neo4jConvert.js(record.get('activeStreaks')) || 0;
  const avgCurrentStreak = Math.round(record.get('avgCurrentStreak') || 0);
  const avgLongestStreak = Math.round(record.get('avgLongestStreak') || 0);
  const maxCurrentStreak = args.neo4jConvert.js(record.get('maxCurrentStreak')) || 0;
  const maxLongestStreak = args.neo4jConvert.js(record.get('maxLongestStreak')) || 0;
  const totalCompletions = args.neo4jConvert.js(record.get('totalCompletions')) || 0;
  const engagementRate = totalRules > 0 ?
    Math.round((activeStreaks / totalRules) * 100) : 0;

  return {
    category,           // Full vertex format
    stats: {
      totalRules,
      activeStreaks,
      avgCurrentStreak,
      avgLongestStreak,
      maxCurrentStreak,
      maxLongestStreak,
      totalCompletions,
      engagementRate
    }
  };
});

// Generate insights
const insights = [];

if (activeStreaks > 0) {
  insights.push(`🔥 You have ${activeStreaks} active streak${activeStreaks > 1 ? 's' : ''} running!`);
}

const maxCurrent = args.neo4jConvert.js(overallStats.get('maxCurrentStreak')) || 0;
if (maxCurrent >= 30) {
  insights.push(`🏆 Amazing! Your longest current streak is ${maxCurrent} days.`);
} else if (maxCurrent >= 7) {
  insights.push(`💪 Great momentum! Your longest current streak is ${maxCurrent} days.`);
}

if (streakEngagementRate >= 70) {
  insights.push(`⭐ High engagement! ${Math.round(streakEngagementRate)}% of your rules have active streaks.`);
} else if (streakEngagementRate < 30 && totalRules > 0) {
  insights.push('🎯 Focus on consistency to build more streaks and create lasting habits.');
}

if (categoryAnalysis.length > 0) {
  const topCategory = categoryAnalysis[0];
  if (topCategory.stats.avgCurrentStreak >= 5) {
    insights.push(`🌟 "${topCategory.category.P.name}" shows the strongest streak performance.`);
  }
}

if (insights.length === 0) {
  insights.push('Start tracking your habits to see personalized insights!');
}

return {
  timePeriod: 'all',
  period: {
    startDate,
    endDate: todayStr
  },
  summary: {
    totalRules,
    activeStreaks,
    streakEngagementRate: Math.round(streakEngagementRate),
    avgCurrentStreak: Math.round(overallStats.get('avgCurrentStreak') || 0),
    avgLongestStreak: Math.round(overallStats.get('avgLongestStreak') || 0),
    maxCurrentStreak: args.neo4jConvert.js(overallStats.get('maxCurrentStreak')) || 0,
    maxLongestStreak: args.neo4jConvert.js(overallStats.get('maxLongestStreak')) || 0,
    totalCompletions: args.neo4jConvert.js(overallStats.get('totalCompletions')) || 0
  },
  topCurrentStreaks,
  topLongestStreaks: topCurrentStreaks, // Same as current for now
  categoryAnalysis,
  streakDistribution: {
    noStreak: totalRules - activeStreaks,
    shortStreak: 0,
    weekStreak: 0,
    monthStreak: 0,
    longStreak: activeStreaks
  },
  milestoneAchievements: [],
  performanceTrends: [],
  insights,
  generatedAt: new Date().toISOString(),
  userId: user.P.uuid
};
        '''
        props: '''
return {
  as: "div"
};
        '''
        css: '''
