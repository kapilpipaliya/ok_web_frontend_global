        props: '''
const completeAllRemaining = args.contextData?.trackingData?.completeAllRemaining;
const progressStats = args.contextData?.trackingData?.progressStats?.();
const isLoading = args.contextData?.trackingData?.isLoading?.();
const groupedRules = args.contextData?.trackingData?.groupedRules?.();

const handleClick = async () => {
  if (completeAllRemaining) {
    await completeAllRemaining();
  }
};

return {
  as: "button",
  text: `Complete All Remaining${progressStats ? ` (${progressStats.total - progressStats.completed})` : ''}`,
  onClick: handleClick,
  disabled: isLoading || (progressStats && progressStats.completed === progressStats.total),
  hide: isLoading || !groupedRules || Object.keys(groupedRules).length === 0
};
''',
        css: '''
const progressStats = args.contextData?.trackingData?.progressStats?.();
const isLoading = args.contextData?.trackingData?.isLoading?.();
const isDisabled = isLoading || (progressStats && progressStats.completed === progressStats.total);

return `._id {
  width: 100%;
  background: ${isDisabled ? '${args.theme.var.color.muted}' : '${args.theme.var.color.primary}'};
  color: ${isDisabled ? '${args.theme.var.color.muted_text}' : '${args.theme.var.color.primary_text}'};
  border: none;
  padding: ${args.theme.var.spacing.lg};
  border-radius: ${args.theme.var.borderRadius.lg};
  font-size: ${args.theme.var.fontSize.lg};
  font-weight: 600;
  cursor: ${isDisabled ? 'not-allowed' : 'pointer'};
  margin-top: ${args.theme.var.spacing.xl};
  transition: all ${args.theme.var.animation.fast} ease;
  opacity: ${isDisabled ? '0.6' : '1'};

  ${!isDisabled ? `
  &:hover {
    background: ${args.theme.var.color.primary_dark_200};
    transform: translateY(-2px);
  }

  &:active {
    transform: translateY(0);
  }
  ` : ''}
}`;
'''
      }
