        props: '''
const ruleData = args.contextData?.categoryRules;
const rule = ruleData?.rule;
const ruleId = rule?.id;
const trackRuleAction = args.contextData?.trackingData?.trackRuleAction;

const handleClick = async () => {
  if (ruleId && trackRuleAction) {
    await trackRuleAction(ruleId, 'missed');
  } else {
    console.error('Missing data for tracking:', { ruleId, trackRuleAction: !!trackRuleAction });
    args.showErrorToast('Unable to track rule - missing data');
  }
};

return {
  as: "button",
  "aria-label": "Mark as missed",
  title: "Mark this rule as missed (0%). This will break your current streak.",
  onClick: handleClick
};
''',
        css: '''
const ruleData = args.contextData?.categoryRules;
