    args.showErrorToast('Unable to track rule - missing data');
  }
};

return {
  as: "button",
  "aria-label": "Mark as partial",
  title: "Mark this rule as partially completed. You'll be prompted to enter a completion percentage (0-100%).",
  onClick: handleClick
};
''',
        css: '''
const ruleData = args.contextData?.categoryRules;
const tracking = ruleData?.tracking?.[0];
const status = tracking?.P?.status;
const isActive = status === 'partial';

return `._id {
  background: ${args.theme.var.color.warning};
  color: ${args.theme.var.color.warning_text};
  border: none;
  padding: ${args.theme.var.spacing.md};
  border-radius: ${args.theme.var.borderRadius.md};
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: ${args.theme.var.spacing.xs};
  cursor: pointer;
  transition: all ${args.theme.var.animation.fast} ease;
  font-weight: 500;
  opacity: ${isActive ? '1' : '0.7'};

  &:hover {
    background: ${args.theme.var.color.warning_dark_200};
    opacity: 1;
  }

  &:active {
    transform: scale(0.95);
  }
}`;
'''
