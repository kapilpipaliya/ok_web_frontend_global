const tracking = ruleData?.tracking?.[0];
const status = tracking?.P?.status;
const isActive = status === 'completed';

return `._id {
  background: ${isActive ? '${args.theme.var.color.success}' : '${args.theme.var.color.success_light_200}'};
  color: ${isActive ? '${args.theme.var.color.success_text}' : '${args.theme.var.color.success_text}'};
  border: none;
  padding: ${args.theme.var.spacing.md};
  border-radius: ${args.theme.var.borderRadius.md};
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: ${args.theme.var.spacing.xs};
  cursor: pointer;
  transition: all ${args.theme.var.animation.fast} ease;
  font-weight: 500;
  opacity: ${isActive ? '1' : '0.7'};

  &:hover {
    background: ${args.theme.var.color.success_dark_200};
    opacity: 1;
  }

  &:active {
    transform: scale(0.95);
  }
}`;
'''
