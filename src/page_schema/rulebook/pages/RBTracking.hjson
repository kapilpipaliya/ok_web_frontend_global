{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "RBTracking",
        url: "/rb/tracking",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
// Data loading state
const [rules, setRules] = args.createSignal([]);
const [isLoading, setIsLoading] = args.createSignal(true);
const [error, setError] = args.createSignal(null);
const [selectedDate, setSelectedDate] = args.createSignal(new Date().toISOString().split('T')[0]);

// Load rules with today's tracking status
const loadRulesWithTracking = async (date, isInitialLoad = false) => {
  // Only show loading state on initial load
  if (isInitialLoad) {
    setIsLoading(true);
  }
  setError(null);

  try {
    const result = await args.executeNamedServerFunction({
      functionName: "getUserRules",
      contextData: {
        includeInactive: false,
        includeTracking: true,
        trackingDate: date
      }
    });

    if (result.error) {
      throw new Error(result.error);
    }

    if (result.result?.success) {
      setRules(result.result.data?.rules || []);
    } else {
      throw new Error(result.result?.message || "Failed to load rules");
    }
  } catch (err) {
    console.error("Error loading rules:", err);
    setError(err.message);
    args.showErrorToast(err.message);
  } finally {
    if (isInitialLoad) {
      setIsLoading(false);
    }
  }
};

// Track a rule with the given status
const trackRuleAction = async (ruleId, status, notes = "", completionPercentage = null) => {

  // Ensure date is in YYYY-MM-DD format
  const rawDate = selectedDate();
  const date = typeof rawDate === 'string' ? rawDate : new Date(rawDate).toISOString().split('T')[0];

  try {
    // For partial status, prompt for completion percentage if not provided
    if (status === 'partial' && completionPercentage === null) {
      completionPercentage = prompt("Enter completion percentage (0-100):");
      if (completionPercentage === null) return; // User cancelled
      completionPercentage = parseInt(completionPercentage);
      if (isNaN(completionPercentage) || completionPercentage < 0 || completionPercentage > 100) {
        args.showErrorToast("Please enter a valid percentage between 0 and 100");
        return;
      }
    }

    const contextData = {
      ruleId,
      date,
      status,
      notes
    };

    if (status === 'partial') {
      contextData.completionPercentage = completionPercentage;
    }

    const result = await args.executeNamedServerFunction({
      functionName: "trackRule",
      contextData
    });

    if (result.error) {
      throw new Error(result.error);
    }

    if (result.result?.success) {
      args.showSuccessToast(result.result.message);
      // Reload rules to update tracking status
      loadRulesWithTracking(date);
    } else {
      throw new Error(result.result?.message || "Failed to track rule");
    }
  } catch (error) {
    console.error("Error tracking rule:", error);
    args.showErrorToast(error.message);
  }
};

// Group rules by category
const groupedRules = args.createMemo(() => {
  const rulesData = rules();
  return rulesData.reduce((acc, ruleData) => {
    const category = ruleData.category;
    const categoryKey = category?.P?.key || 'uncategorized';
    const categoryName = category?.P?.name || 'Other';
    const categoryIcon = category?.P?.icon || '📝';

    if (!acc[categoryKey]) {
      acc[categoryKey] = {
        category,
        categoryName,
        categoryIcon,
        rules: []
      };
    }
    acc[categoryKey].rules.push(ruleData);
    return acc;
  }, {});
});

// Calculate progress
const progressStats = args.createMemo(() => {
  const rulesData = rules();
  if (rulesData.length === 0) return { completed: 0, total: 0, percentage: 0 };

  const completed = rulesData.filter(ruleData => {
    const tracking = ruleData.tracking?.[0]; // Today's tracking
    return tracking?.P?.status === 'completed';
  }).length;

  const total = rulesData.length;
  const percentage = total > 0 ? Math.round((completed / total) * 100) : 0;

  return { completed, total, percentage };
});

// Complete all remaining rules
const completeAllRemaining = async () => {
  const rulesData = rules();
  if (rulesData.length === 0) return;

  const date = typeof selectedDate() === 'string' ? selectedDate() : new Date(selectedDate()).toISOString().split('T')[0];

  // Find rules that are not completed yet
  const incompleteRules = rulesData.filter(ruleData => {
    try {
      const tracking = ruleData?.tracking?.[0];
      return !tracking || tracking?.P?.status !== 'completed';
    } catch (e) {
      console.warn('Error accessing tracking data for incomplete rules:', e);
      return true; // Include rule if we can't determine status
    }
  });

  if (incompleteRules.length === 0) {
    args.showSuccessToast("All rules are already completed!");
    return;
  }

  const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
  const confirmed = await rbConfirm({
    title: "Mark All Complete",
    message: `Mark ${incompleteRules.length} remaining rules as completed?`,
    confirmText: "Mark Complete",
    cancelText: "Cancel",
    variant: "primary"
  });
  if (!confirmed) return;

  let successCount = 0;
  let errorCount = 0;

  for (const ruleData of incompleteRules) {
    try {
      const ruleId = ruleData?.rule?.id;
      if (ruleId) {
        const result = await args.executeNamedServerFunction({
          functionName: "trackRule",
          contextData: {
            ruleId,
            date,
            status: 'completed'
          }
        });

        if (result.result?.success) {
          successCount++;
        } else {
          errorCount++;
        }
      }
    } catch (error) {
      console.error("Error completing rule:", error);
      errorCount++;
    }
  }

  // Show results and refresh data
  if (successCount > 0) {
    args.showSuccessToast(`Completed ${successCount} rules!${errorCount > 0 ? ` (${errorCount} failed)` : ''}`);
    loadRulesWithTracking(date).catch(refreshError => {
      console.error('Error refreshing data after bulk completion:', refreshError);
    });
  } else if (errorCount > 0) {
    args.showErrorToast(`Failed to complete rules. Please try again.`);
  }
};

// Load data on mount
const onMount = () => {
  loadRulesWithTracking(selectedDate(), true);
};

return {
  isNoPermissionCheck: true,
  contextName: "trackingData",
  onMount,
  data: () => ({
    rules,
    isLoading,
    error,
    selectedDate,
    setSelectedDate,
    groupedRules,
    progressStats,
    trackRuleAction,
    completeAllRemaining,
    refreshData: () => {
      const currentDate = selectedDate();
      return loadRulesWithTracking(currentDate, false);
    }
  })
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
        componentName: "RBLayout",
        displayOrder: 1
      }
    },
    {
