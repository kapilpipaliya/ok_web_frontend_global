const ruleData = args.contextData?.categoryRules;
const tracking = ruleData?.tracking?.[0];
const status = tracking?.P?.status;

let borderColor = '${args.theme.var.color.border}';
if (status === 'completed') {
  borderColor = '${args.theme.var.color.success}';
} else if (status === 'partial') {
  borderColor = '${args.theme.var.color.warning}';
} else if (status === 'missed') {
  borderColor = '${args.theme.var.color.error}';
} else if (status === 'skipped') {
  borderColor = '${args.theme.var.color.muted}';
}

return `._id {
  background: ${args.theme.var.color.background_light_100};
  border: 2px solid ${borderColor};
  border-radius: ${args.theme.var.borderRadius.lg};
  padding: ${args.theme.var.spacing.lg};
  transition: all ${args.theme.var.animation.fast} ease;

  &:hover {
    border-color: ${args.theme.var.color.primary};
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }
}`;
'''
