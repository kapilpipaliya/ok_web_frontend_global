  margin: 0 auto;
}

@media (max-width: 768px) {
  ._id {
    padding: ${args.theme.var.spacing.md};
  }
}`;
'''
      }
    },
    {
      id: "page_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RBHeader"
      }
    },
    {
      id: "page_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RBPageTitle",
        slot: "center",
        props: '''
const selectedDate = args.contextData?.trackingData?.selectedDate;
const currentDate = selectedDate?.() || new Date().toISOString().split('T')[0];
const today = new Date().toISOString().split('T')[0];
const isToday = currentDate === today;

const title = isToday ? "Daily Tracking" : "Rule Tracking";

return {
  text: title
};
'''
      }
    },
    {
      id: "date_subtitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        slot: "subtitle",
        props: '''
const selectedDate = args.contextData?.trackingData?.selectedDate;
const currentDate = selectedDate?.() || new Date().toISOString().split('T')[0];
const today = new Date().toISOString().split('T')[0];

const dateObj = new Date(currentDate + 'T00:00:00');
const formattedDate = dateObj.toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const isToday = currentDate === today;
const dateText = isToday ? formattedDate : `${formattedDate} (Selected Date)`;

return {
  as: "p",
  text: dateText
};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.lg};
  color: ${args.theme.var.color.muted};
  margin: 0;
}`;
'''
      }
    },
    {
      id: "calendar_button",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        slot: "right",
        props: '''
const selectedDate = args.contextData?.trackingData?.selectedDate;
const setSelectedDate = args.contextData?.trackingData?.setSelectedDate;
const refreshData = args.contextData?.trackingData?.refreshData;

const handleDateClick = () => {
  const currentDate = selectedDate?.() || new Date().toISOString().split('T')[0];
  const newDate = prompt("Select date (YYYY-MM-DD):", currentDate);

  if (newDate && newDate.match(/^\d{4}-\d{2}-\d{2}$/)) {
    const dateObj = new Date(newDate + 'T00:00:00');
    if (!isNaN(dateObj.getTime())) {
      setSelectedDate?.(newDate);
      try {
        refreshData?.();
      } catch (error) {
        console.error('Error in refreshData:', error);
      }
    } else {
      args.showErrorToast("Please enter a valid date");
    }
  } else if (newDate !== null) {
    args.showErrorToast("Please enter date in YYYY-MM-DD format");
  }
};

return {
  as: "button",
  "aria-label": "Select date",
  title: `Current date: ${selectedDate?.() || 'Today'}. Click to change date.`,
  onClick: handleDateClick
};
''',
        css: '''
return `._id {
  background: none;
  border: none;
  color: ${args.theme.var.color.muted};
  cursor: pointer;
  padding: ${args.theme.var.spacing.sm};
  border-radius: ${args.theme.var.borderRadius.sm};
  transition: all ${args.theme.var.animation.fast} ease;
  display: flex;
  align-items: center;

  &:hover {
    background: ${args.theme.var.color.background_light_200};
    color: ${args.theme.var.color.text};
  }
}`;
'''
      }
