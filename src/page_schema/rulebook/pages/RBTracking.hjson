  loop: true,
  data: () => {
    const groupedRules = args.contextData?.trackingData?.groupedRules?.();
    return Object.values(groupedRules || {});
  },
  hide: () => {
    const groupedRules = args.contextData?.trackingData?.groupedRules?.();
    return args.contextData?.trackingData?.isLoading?.() || !groupedRules || Object.keys(groupedRules).length === 0;
  }
};
''',
