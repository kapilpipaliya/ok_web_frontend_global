      id: "rule_form_modal",
      L: "Attr",
      P: {
        displayOrder: 999,
        componentName: "RBRuleFormModal",
        props: '''
const showRuleModal = args.contextData.ruleModal?.showRuleModal;
const modalMode = args.contextData.ruleModal?.modalMode;
const selectedRule = args.contextData.ruleModal?.selectedRule;
const setShowRuleModal = args.contextData.ruleModal?.setShowRuleModal;

return {
  isOpen: showRuleModal?.(),
  mode: modalMode?.(),
  ruleData: selectedRule?.(),
  onClose: () => {
    setShowRuleModal?.(false);
  },
  onSave: (result) => {
    // Refresh rules data after successful save
    const refreshData = args.contextData.ruleModal?.refreshData;
    if (refreshData) {
      refreshData();
    }
  },
  onDelete: (result) => {
    // Refresh rules data after successful delete
    const refreshData = args.contextData.ruleModal?.refreshData;
    if (refreshData) {
      refreshData();
    }
  }
};
'''
      }
