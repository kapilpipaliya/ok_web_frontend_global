    },
    {
      id: "rule_menu_edit",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RBMenuItem",
        slotName: "menu-items",
        props: '''
const ruleData = c.categoryRules;
const rule = ruleData?.rule;
const category = ruleData?.category;

return {
  icon: "carbon:edit",
  text: "Edit Rule",
  onClick: (e) => {
    e.preventDefault();
    e.stopPropagation();
    f.closeMenu?.();

    if (rule) {
      // Format rule data for modal (same pattern as rule detail page)
      const ruleForModal = {
        id: rule.id,
        P: {
          ...rule.P,
          categoryId: category?.id // Add categoryId to P properties where modal expects it
        }
      };

      f.setSelectedRule(ruleForModal);
      f.setModalMode("edit");
      f.setShowRuleModal(true);
    } else {
      _.showErrorToast("Rule data not available");
    }
  }
};
'''
      }
    },
    {
      id: "rule_menu_view",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "RBMenuItem",
        slotName: "menu-items",
        props: '''
const ruleData = c.categoryRules;
const rule = ruleData?.rule;
const ruleId = rule?.id;

return {
  icon: "carbon:view",
  text: "View Details",
  href: `/rb/rule-detail?ruleId=${ruleId}`,
  onClick: (e) => {
    e.stopPropagation();
    f.closeMenu?.();
  }
};
'''
      }
    },
    {
      id: "rule_menu_divider",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "RBMenuItem",
        slotName: "menu-items",
        props: '''
return {
  isDivider: true
};
'''
      }
    },
    {
      id: "rule_menu_delete",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "RBMenuItem",
        slotName: "menu-items",
        props: '''
const ruleData = c.categoryRules;
const rule = ruleData?.rule;
const ruleName = rule?.P?.title || "this rule";

return {
  icon: "carbon:trash-can",
  text: "Delete",
  type: "danger",
  onClick: async (e) => {
    e.preventDefault();
    e.stopPropagation();

    let warningMessage = `⚠️ WARNING: This will permanently delete:\n• The rule "${ruleName}"`;
    warningMessage += `\n• All tracking data for this rule`;
    warningMessage += `\n• All goals linked to this rule`;
    warningMessage += `\n• All streak data for this rule`;
    warningMessage += `\n\nThis action cannot be undone!`;

    // Use global confirm dialog
    const rbConfirm = c?.confirmContext?.rbConfirm;
    if (!rbConfirm) {
      _.showErrorToast("Confirmation dialog not available");
      return;
    }

    const confirmed = await rbConfirm({
      title: `Delete "${ruleName}"`,
      message: warningMessage,
      confirmText: "Delete Rule",
      cancelText: "Cancel",
      variant: "danger"
    });

    if (confirmed) {
      try {
        const result = await s({
          functionName: "deleteRule",
          contextData: {
            ruleId: rule?.id
          }
        });

        if (result.result?.success) {
          _.showSuccessToast("Rule deleted successfully");
          f.refreshData();
        } else {
          throw new Error(result.result?.message || "Failed to delete rule");
        }
      } catch (err) {
        _.showErrorToast(err.message);
      }
    }
    f.closeMenu?.();
  }
};
'''
      }
    },
    {
      id: "empty_state",
      L: "Attr",
      P: {
        displayOrder: 7,
        componentName: "Html",
        props: '''
const filteredData = f.filteredCategoriesWithRules() || [];
const isLoading = f.isLoading();
const error = f.error();

return {
  as: "div",
  hide: isLoading || error || filteredData.length > 0
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: ${t.var.spacing.xxxl};
  text-align: center;
  color: ${t.var.color.text_light_500};
}`;
'''
      }
    },
    {
      id: "empty_message",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const searchQuery = f.searchQuery();
const rules = f.rules() || [];
const activeTab = f.activeTab();

let emptyMessage = "No rules found. Create your first rule to get started!";
if (searchQuery) {
  emptyMessage = `No rules found matching "${searchQuery}"`;
} else if (activeTab === "active" && rules.length > 0) {
  emptyMessage = "No active rules found. You can create a new rule or activate an existing one.";
} else if (activeTab === "paused" && rules.length > 0) {
  emptyMessage = "No paused rules found.";
}

return {
  as: "div",
  text: emptyMessage
};
''',
        css: '''
return `._id {
  font-size: 1rem;
  margin-bottom: ${t.var.spacing.md};
}`;
'''
      }
    },
    {
      id: "empty_create_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "RBButton",
        props: '''
return {
  text: "Create Rule",
  variant: "primary",
  onClick: () => {
    f.setModalMode("create");
    f.setShowRuleModal(true);
  },
  hide: !!f.searchQuery() // Hide button when searching
};
'''
      }
    },
    {
      id: "rule_form_modal",
      L: "Attr",
      P: {
        displayOrder: 999,
        componentName: "RBRuleFormModal",
        props: '''
return {
  isOpen: f.showRuleModal(),
  mode: f.modalMode(),
  ruleData: f.selectedRule(),
  onClose: () => {
    f.setShowRuleModal(false);
  },
  onSave: (result) => {
    // Refresh rules data after successful save
    f.refreshData();
  },
  onDelete: (result) => {
    // Refresh rules data after successful delete
    f.refreshData();
  }
};
'''
      }
    }
  ],
