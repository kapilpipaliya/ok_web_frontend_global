      }
    },
    {
      id: "rule_menu_delete",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "RBMenuItem",
        slot: "menu-items",
        props: '''
const ruleData = args.contextData.categoryRules;
const rule = ruleData?.rule;
const ruleName = rule?.P?.title || "this rule";
const { refreshData } = args.contextData.ruleModal || {};

return {
  icon: "carbon:trash-can",
  text: "Delete",
  type: "danger",
  onClick: async (e) => {
    e.preventDefault();
    e.stopPropagation();

    let warningMessage = `⚠️ WARNING: This will permanently delete:\n• The rule "${ruleName}"`;
    warningMessage += `\n• All tracking data for this rule`;
    warningMessage += `\n• All goals linked to this rule`;
    warningMessage += `\n• All streak data for this rule`;
    warningMessage += `\n\nThis action cannot be undone!`;

    // Use global confirm dialog
    const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
    if (!rbConfirm) {
      args.showErrorToast("Confirmation dialog not available");
      return;
    }

    const confirmed = await rbConfirm({
      title: `Delete "${ruleName}"`,
      message: warningMessage,
      confirmText: "Delete Rule",
      cancelText: "Cancel",
      variant: "danger"
    });

    if (confirmed) {
      try {
        const result = await args.executeNamedServerFunction({
          functionName: "deleteRule",
          contextData: {
            ruleId: rule?.id
          }
        });

        if (result.result?.success) {
          args.showSuccessToast("Rule deleted successfully");
          refreshData?.();
        } else {
          throw new Error(result.result?.message || "Failed to delete rule");
        }
      } catch (err) {
        args.showErrorToast(err.message);
      }
    }
    args.fns.closeMenu?.();
  }
};
'''
      }
    },
    {
      id: "empty_state",
      L: "Attr",
      P: {
        displayOrder: 7,
        componentName: "Html",
        props: '''
