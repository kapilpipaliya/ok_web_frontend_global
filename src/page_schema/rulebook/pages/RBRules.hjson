{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "RBRules",
        url: "/rb/rules",
        fns: '''
// Modal state management
const [showRuleModal, setShowRuleModal] = _.createSignal(false);
const [modalMode, setModalMode] = _.createSignal("create");
const [selectedRule, setSelectedRule] = _.createSignal(null);

// Data loading state
const [rules, setRules] = _.createSignal([]);
const [categories, setCategories] = _.createSignal([]);
const [isLoading, setIsLoading] = _.createSignal(true);
const [error, setError] = _.createSignal(null);

// Tab filtering state
const [activeTab, setActiveTab] = _.createSignal("all");

// Search state
const [searchQuery, setSearchQuery] = _.createSignal("");
const [searchInput, setSearchInput] = _.createSignal("");

// Debounce timer for search optimization
let searchTimer = null;

// Debounced search function
const debouncedSearch = (value) => {
  if (searchTimer) {
    clearTimeout(searchTimer);
  }
  
  searchTimer = setTimeout(() => {
    setSearchQuery(value);
  }, 300);
};

// Derived signal for filtered categories with rules
const filteredCategoriesWithRules = _.createMemo(() => {
  const categoriesData = categories();
  const rulesData = rules();
  const currentTab = activeTab();
  const query = searchQuery().toLowerCase().trim();

  if (!Array.isArray(categoriesData) || !Array.isArray(rulesData)) {
    return [];
  }

  // Filter rules based on active tab and search query
  const filteredRules = rulesData.filter(ruleData => {
    const rule = ruleData.rule;
    const category = ruleData.category;

    // Filter by tab
    if (currentTab === "active") {
      if (rule?.P?.isActive === false) return false;
    } else if (currentTab === "paused") {
      if (rule?.P?.isActive !== false) return false;
    }

    // Filter by search query
    if (query) {
      const ruleTitle = (rule?.P?.title || "").toLowerCase();
      const ruleDescription = (rule?.P?.description || "").toLowerCase();
      const categoryName = (category?.P?.name || "").toLowerCase();
      const frequency = (rule?.P?.frequency || "").toLowerCase();
      const priority = (rule?.P?.priority || "").toLowerCase();
      
      // Search in multiple fields
      const matchesSearch = ruleTitle.includes(query) ||
                          ruleDescription.includes(query) ||
                          categoryName.includes(query) ||
                          frequency.includes(query) ||
                          priority.includes(query);
      
      if (!matchesSearch) return false;
    }

    return true;
  });

  // Group filtered rules by category
  const result = categoriesData.map(categoryData => {
    const category = categoryData.category;
    const categoryRules = filteredRules.filter(ruleData => {
      const ruleCategory = ruleData.category;
      return ruleCategory?.id === category?.id;
    });

    return {
      ...categoryData,
      rules: categoryRules
    };
  }).filter(categoryData => categoryData.rules.length > 0);

  return result;
});

// Load rules and categories on page mount
const loadData = async () => {
  setIsLoading(true);
  setError(null);

  try {
    // Load rules and categories in parallel
    const [rulesResult, categoriesResult] = await Promise.all([
      s({
        functionName: "getUserRules",
        contextData: { includeInactive: false }
      }),
      s({
        functionName: "getCategories",
        contextData: {}
      })
    ]);

    // Handle rules result
    if (rulesResult.error) {
      throw new Error(rulesResult.error);
    }
    if (rulesResult.result && rulesResult.result.success) {
      setRules(rulesResult.result.data.rules || []);
    } else {
      throw new Error(rulesResult.result?.message || "Failed to load rules");
    }

    // Handle categories result
    if (categoriesResult.error) {
      throw new Error(categoriesResult.error);
    }
    if (categoriesResult.result && categoriesResult.result.success) {
      setCategories(categoriesResult.result.data.categories || []);
    } else {
      throw new Error(categoriesResult.result?.message || "Failed to load categories");
    }

  } catch (err) {
    console.error("Error loading data:", err);
    setError(err.message);
    _.showErrorToast(err.message);
  } finally {
    setIsLoading(false);
  }
};

// Refresh data after save/delete operations
const refreshData = () => {
  loadData();
};

return {
  enabled: true,
  enabled: true,
  // Signals
  showRuleModal,
  setShowRuleModal,
  modalMode,
  setModalMode,
  selectedRule,
  setSelectedRule,
  rules,
  categories,
  isLoading,
  error,
  activeTab,
  setActiveTab,
  searchQuery,
  setSearchQuery,
  searchInput,
  setSearchInput,
  filteredCategoriesWithRules,
  // Functions
  loadData,
  refreshData,
  debouncedSearch
};
''',
        props: '''
return {
  isNoPermissionCheck: true,
  onMount: f.loadData
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
        componentName: "RBLayout",
        displayOrder: 1
      }
    },
