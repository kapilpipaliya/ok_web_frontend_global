    },
    {
      id: "rule_meta",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const ruleData = c?.categoryRules;
const rule = ruleData?.rule;
const frequency = rule?.P?.frequency || "daily";
const priority = rule?.P?.priority || "medium";

const frequencyText = frequency.charAt(0).toUpperCase() + frequency.slice(1);
const priorityText = priority.charAt(0).toUpperCase() + priority.slice(1);

return {
  as: "div",
  text: `${frequencyText} • ${priorityText} Priority`
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  color: ${t.var.color.text_light_500};
}`;
'''
      }
    },
    {
      id: "rule_status",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const ruleData = c?.categoryRules;
const rule = ruleData?.rule;
const stats = ruleData?.stats;
const streak = stats?.currentStreak || 0;
const isPaused = rule?.P?.isActive === false;

let statusText = "";
if (isPaused) {
  statusText = "⏸️ Paused";
} else if (streak > 0) {
  statusText = `🔥 ${streak} day streak`;
} else {
  statusText = "📝 Active";
}

return {
  as: "div",
  text: statusText
};
''',
        css: '''
const ruleData = c?.categoryRules;
const rule = ruleData?.rule;
const stats = ruleData?.stats;
const isPaused = rule?.P?.isActive === false;
const streak = stats?.currentStreak || 0;

let statusColor = t.var.color.primary;
if (isPaused) {
  statusColor = t.var.color.warning;
} else if (streak > 0) {
  statusColor = t.var.color.success;
}

return `._id {
  font-size: 0.875rem;
  color: ${statusColor};
  font-weight: 500;
}`;
'''
      }
    },
