    {
      id: "rule_meta",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const ruleData = args.contextData?.categoryRules;
const rule = ruleData?.rule;
const frequency = rule?.P?.frequency || "daily";
const priority = rule?.P?.priority || "medium";

const frequencyText = frequency.charAt(0).toUpperCase() + frequency.slice(1);
const priorityText = priority.charAt(0).toUpperCase() + priority.slice(1);

return {
  as: "div",
  text: `${frequencyText} • ${priorityText} Priority`
};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.sm};
  color: ${args.theme.var.color.muted};
}`;
'''
      }
    },
    {
      id: "rule_status",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const ruleData = args.contextData?.categoryRules;
const rule = ruleData?.rule;
const stats = ruleData?.stats;
const streak = stats?.currentStreak || 0;
const isPaused = rule?.P?.isActive === false;

let statusText = "";
if (isPaused) {
  statusText = "⏸️ Paused";
} else if (streak > 0) {
  statusText = `🔥 ${streak} day streak`;
} else {
  statusText = "📝 Active";
}

return {
  as: "div",
  text: statusText
};
''',
        css: '''
const ruleData = args.contextData?.categoryRules;
const rule = ruleData?.rule;
const stats = ruleData?.stats;
const isPaused = rule?.P?.isActive === false;
const streak = stats?.currentStreak || 0;

let statusColor = args.theme.var.color.primary;
if (isPaused) {
  statusColor = args.theme.var.color.warning;
} else if (streak > 0) {
  statusColor = args.theme.var.color.success;
}

return `._id {
  font-size: ${args.theme.var.fontSize.sm};
  color: ${statusColor};
  font-weight: 500;
}`;
'''
      }
    },
    {
      id: "rule_actions",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "RBFloatingMenu",
        props: '''
return {
  placement: "bottom-end",
  triggerIcon: "carbon:overflow-menu-vertical"
};
'''
      }
    },
    {
      id: "rule_menu_edit",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RBMenuItem",
        slot: "menu-items",
        props: '''
const ruleData = args.contextData.categoryRules;
const rule = ruleData?.rule;
const category = ruleData?.category;
const { setShowRuleModal, setModalMode, setSelectedRule } = args.contextData.ruleModal || {};

return {
  icon: "carbon:edit",
  text: "Edit Rule",
  onClick: (e) => {
    e.preventDefault();
    e.stopPropagation();
    args.fns.closeMenu?.();

    if (rule) {
      // Format rule data for modal (same pattern as rule detail page)
      const ruleForModal = {
        id: rule.id,
        P: {
          ...rule.P,
          categoryId: category?.id // Add categoryId to P properties where modal expects it
        }
      };

      setSelectedRule?.(ruleForModal);
      setModalMode?.("edit");
      setShowRuleModal?.(true);
    } else {
      args.showErrorToast("Rule data not available");
    }
  }
};
'''
      }
    },
    {
      id: "rule_menu_view",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "RBMenuItem",
        slot: "menu-items",
        props: '''
const ruleData = args.contextData.categoryRules;
const rule = ruleData?.rule;
const ruleId = rule?.id;

return {
  icon: "carbon:view",
  text: "View Details",
  href: `/rb/rule-detail?ruleId=${ruleId}`,
  onClick: (e) => {
    e.stopPropagation();
    args.fns.closeMenu?.();
  }
};
'''
      }
    },
    {
      id: "rule_menu_divider",
      L: "Attr",
      P: {
