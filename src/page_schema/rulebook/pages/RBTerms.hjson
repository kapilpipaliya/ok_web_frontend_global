{
  vertexes: [
    {
      id: "terms_page",
      L: "Page",
      P: {
        key: "RBTerms",
        url: "/terms",
        title: "Terms of Service - Personal Rulebook",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "terms_layout_1",
      L: "PageLayout",
      P: {
        componentName: "RBWebsiteLayout",
        displayOrder: 1
      }
    },
    {
      id: "terms_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 800px;
  margin: 0 auto;
  padding: ${args.theme.var.spacing.lg};
  color: ${args.theme.var.color.text};
}

@media (max-width: 768px) {
  ._id {
    padding: ${args.theme.var.spacing.md};
  }
}`;
'''
      }
    },
    {
      id: "page_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RBHeader"
      }
    },
    {
