return {
  as: "h1",
  text: "Terms of Service"
};
''',
        css: '''
return `._id {
  font-size: 2rem;
  font-weight: 700;
  color: ${args.theme.var.color.primary};
  margin: 0;
}

@media (max-width: 768px) {
  ._id {
    font-size: 1.75rem;
  }
}`;
'''
      }
    },
    {
      id: "header_date",
