        css: '''
return `._id {
  text-align: center;
  padding: ${t.var.spacing.xxl} ${t.var.spacing.xl};
  background: linear-gradient(135deg, ${t.var.color.primary}, ${t.var.color.info});
  border-radius: ${t.var.borderRadius.xl};
  color: ${t.var.color.primary_text};
  margin-bottom: ${t.var.spacing.xl};
}

._id h2 {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: ${t.var.spacing.lg};
  color: ${t.var.color.primary_text};
}

._id p {
  font-size: 1.125rem;
  margin-bottom: ${t.var.spacing.xl};
  opacity: 0.9;
  max-width: 500px;
  margin-left: auto;
  margin-right: auto;
}

._id button {
  background: ${t.var.color.background};
  color: ${t.var.color.primary};
  padding: ${t.var.spacing.md} ${t.var.spacing.xl};
  border: none;
  border-radius: ${t.var.borderRadius.full};
  font-size: 1.125rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}

._id button:hover {
  background: ${t.var.color.background_light_200};
  transform: translateY(-2px);
  box-shadow: 0 8px 20px ${t.var.color.primary_light_400};
}

@media (max-width: 768px) {
  ._id {
    padding: ${t.var.spacing.xl};
  }

  ._id h2 {
    font-size: 1.25rem;
  }

  ._id p {
    font-size: 1rem;
  }
}`;
'''
