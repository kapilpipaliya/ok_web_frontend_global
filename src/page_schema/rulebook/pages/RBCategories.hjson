const modalData = args.contextData.categoryModal || {};
return {
  isOpen: modalData.showCategoryModal?.(),
  mode: modalData.modalMode?.(),
  categoryData: modalData.selectedCategory?.(),
  onSave: (result) => {
    // Refresh categories after successful save
    modalData.refreshCategories?.();
  },
  onDelete: (result) => {
