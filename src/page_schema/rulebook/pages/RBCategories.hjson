{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "RBCategories",
        url: "/rb/categories",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
// Modal state management
const [showCategoryModal, setShowCategoryModal] = args.createSignal(false);
const [modalMode, setModalMode] = args.createSignal("create");
const [selectedCategory, setSelectedCategory] = args.createSignal(null);

// Dropdown menu state
const [openDropdownId, setOpenDropdownId] = args.createSignal(null);

// Data loading state
const [categories, setCategories] = args.createSignal([]);
const [isLoading, setIsLoading] = args.createSignal(true);
const [error, setError] = args.createSignal(null);

// Load categories on page mount
const loadCategories = async () => {
  setIsLoading(true);
  setError(null);

  try {
    const result = await args.executeNamedServerFunction({
      functionName: "getCategories",
      contextData: {}
    });

    if (result.error) {
      throw new Error(result.error);
    }

    if (result.result && result.result.success) {
      setCategories(result.result.data.categories || []);
    } else {
      throw new Error(result.result?.message || "Failed to load categories");
    }
  } catch (err) {
    console.error("Error loading categories:", err);
    setError(err.message);
    args.showErrorToast(err.message);
  } finally {
    setIsLoading(false);
  }
};

// Refresh categories after save/delete operations
const refreshCategories = () => {
  loadCategories();
};

// Close dropdown when clicking outside
const handleDocumentClick = (e) => {
  if (!e.target.closest('[data-dropdown-menu]')) {
    setOpenDropdownId(null);
  }
};

// Load categories on mount and setup document click handler
const onMount = () => {
  loadCategories();
  document.addEventListener('click', handleDocumentClick);
  return () => {
    document.removeEventListener('click', handleDocumentClick);
  };
};

return {
  isNoPermissionCheck: true,
  contextName: "categoryModal",
  onMount,
  data: {
    showCategoryModal,
    setShowCategoryModal,
    modalMode,
    setModalMode,
    selectedCategory,
    setSelectedCategory,
    categories,
    isLoading,
    error,
    refreshCategories,
    openDropdownId,
    setOpenDropdownId
  }
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
        componentName: "RBLayout",
        displayOrder: 1
      }
    },
