    {
      id: "dropdown_delete",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "RBMenuItem",
        slotName: "menu-items",
        props: '''
const categoryData = args.contextData.categoryLoop;
const category = categoryData?.category;
const { refreshCategories } = args.contextData.categoryModal || {};

return {
  icon: "carbon:trash-can",
  text: "Delete",
  type: "danger",
  onClick: async (e) => {
    e.preventDefault();
    e.stopPropagation();

    const ruleCount = categoryData?.ruleCount || 0;
    const categoryName = category?.P?.name || "this category";

    let warningMessage = `⚠️ WARNING: This will permanently delete:\n• The category "${categoryName}"`;

    if (ruleCount > 0) {
      warningMessage += `\n• ${ruleCount} rule${ruleCount !== 1 ? 's' : ''} in this category`;
      warningMessage += `\n• All tracking data for these rules`;
      warningMessage += `\n• All goals linked to these rules`;
      warningMessage += `\n• All streak data for these rules`;
    }

    warningMessage += `\n\nThis action cannot be undone!`;

    // Use global confirm dialog
    const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
    if (!rbConfirm) {
      args.showErrorToast("Confirmation dialog not available");
      return;
    }

    const confirmed = await rbConfirm({
      title: `Delete "${categoryName}"`,
      message: warningMessage,
      confirmText: "Delete Category",
      cancelText: "Cancel",
      variant: "danger"
    });

    if (confirmed) {
      try {
        const result = await args.executeNamedServerFunction({
          functionName: "deleteCategory",
          contextData: {
            categoryId: category?.id
          }
        });

        if (result.result?.success) {
          args.showSuccessToast("Category deleted successfully");
          refreshCategories?.();
        } else {
          throw new Error(result.result?.message || "Failed to delete category");
        }
      } catch (err) {
        args.showErrorToast(err.message);
      }
    }
    args.fns.closeMenu?.();
  }
};
'''
      }
    },
