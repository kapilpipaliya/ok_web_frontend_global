    {
      id: "category_color_bar",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const categoryData = args.contextData.categoryLoop;
const category = categoryData?.category;
const color = category?.P?.color || "blue";

// Helper function to get category color
const getCategoryColor = (color) => {
  const colorMap = {
    blue: args.theme.var.color.info,
    green: args.theme.var.color.success,
    yellow: args.theme.var.color.warning,
    red: args.theme.var.color.error,
    purple: args.theme.var.color.primary,
    orange: "#f97316",
    teal: "#14b8a6",
    pink: "#ec4899"
  };
  return colorMap[color] || args.theme.var.color.primary;
};

const categoryColor = getCategoryColor(color);

return {
  as: "div"
};
''',
        css: '''
const categoryData = args.contextData.categoryLoop;
const category = categoryData?.category;
const color = category?.P?.color || "blue";

// Helper function to get category color
const getCategoryColor = (color) => {
  const colorMap = {
    blue: args.theme.var.color.info,
    green: args.theme.var.color.success,
    yellow: args.theme.var.color.warning,
    red: args.theme.var.color.error,
    purple: args.theme.var.color.primary,
    orange: "#f97316",
    teal: "#14b8a6",
    pink: "#ec4899"
  };
  return colorMap[color] || args.theme.var.color.primary;
};

const categoryColor = getCategoryColor(color);

return `._id {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: ${categoryColor};
}`;
'''
