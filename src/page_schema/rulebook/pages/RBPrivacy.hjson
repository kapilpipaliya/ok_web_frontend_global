{
  vertexes: [
    {
      id: "privacy_page",
      L: "Page",
      P: {
        public: true
        key: "RBPrivacy",
        url: "/privacy",
        title: "Privacy Policy - Personal Rulebook",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
