{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        public: true
        key: "RBHome",
        url: "/rb",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
        componentName: "RBLayout",
        displayOrder: 1
      }
    },
    {
      id: "data_context",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
const [isDashboardLoading, setIsDashboardLoading] = args.createSignal(true);
const [dashboardError, setDashboardError] = args.createSignal(null);
const [dashboardData, setDashboardData] = args.createSignal(null);

// Function to fetch dashboard data
const fetchDashboardData = async () => {
  try {
    setIsDashboardLoading(true);
    setDashboardError(null);

    // Fetch all dashboard data with a single function call
    const result = await args.executeNamedServerFunction({
      functionName: 'getDashboardData',
      contextData: {}
    });

    if (result.error) {
      throw new Error(result.error);
    }

    const response = result.result;
    if (!response || !response.success) {
      throw new Error(response?.message || 'Failed to fetch dashboard data');
    }

    setDashboardData({
      ...response.data,
      loading: false,
      error: null
    });

  } catch (err) {
    console.error('Dashboard data fetch error:', err);
    setDashboardError(err.message || 'Failed to load dashboard data');
  } finally {
    setIsDashboardLoading(false);
  }
};

// Fetch data on mount
const onMount = () => {
  fetchDashboardData();
};

return {
  isDashboardLoading,
  setIsDashboardLoading,
  dashboardError,
  setDashboardError,
  dashboardData,
  setDashboardData,
  fetchDashboardData,
  onMount
};
''',
        props: '''
return {
  as: "div",
  onMount: args.fns.onMount
};
''',
        css: '''
return `._id {
  padding: ${args.theme.var.spacing.lg};
  max-width: 1200px;
  margin: 0 auto;
}

@media (max-width: 768px) {
  ._id {
    padding: ${args.theme.var.spacing.md};
  }
}`;
'''
      }
    },
    {
      id: "page_content",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const dashboardData = args.fns.dashboardData?.();
const isDashboardLoading = args.fns.isDashboardLoading?.();
const dashboardError = args.fns.dashboardError?.();

// Show loading state
if (isDashboardLoading) {
  return {
    as: "div"
  };
}

// Show error state
if (dashboardError) {
  return {
    as: "div"
  };
}

return {
  as: "div"
};
''',
        css: '''
return `._id {
  min-height: 200px;
}`;
'''
      }
    },
    {
      id: "loading_state",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: () => !args.fns.isDashboardLoading?.()
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: ${args.theme.var.spacing.xxl};
  text-align: center;
}`;
'''
      }
    },
