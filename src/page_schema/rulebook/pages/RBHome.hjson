    {
      id: "rule_action",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const ruleData = args.contextData.rulesList;
const todayTracking = ruleData?.todayTracking;

if (todayTracking?.P?.status === "completed") {
  return {
    as: "div",
    text: "✓ Done"
  };
} else if (todayTracking) {
  return {
    as: "a",
    text: "Update",
    href: "/rb/tracking"
  };
} else {
  return {
    as: "a",
    text: "Track",
    href: "/rb/tracking"
  };
}
''',
        css: '''
const ruleData = args.contextData.rulesList;
const todayTracking = ruleData?.todayTracking;
const isCompleted = todayTracking?.P?.status === "completed";

if (isCompleted) {
  return `._id {
    color: ${args.theme.var.color.completed};
    font-weight: 500;
    padding: ${args.theme.var.spacing.sm};
  }`;
} else {
  return `._id {
    background: ${args.theme.var.color.primary};
    color: ${args.theme.var.color.primary_text};
    border: none;
    padding: ${args.theme.var.spacing.sm} ${args.theme.var.spacing.md};
    border-radius: ${args.theme.var.borderRadius.sm};
    font-weight: 500;
    cursor: pointer;
    min-height: 44px;
    transition: all 150ms ease;
    text-decoration: none;
    display: inline-block;

    &:hover {
      background: ${args.theme.var.color.primary_dark_200};
    }

    &:active {
      transform: scale(0.95);
    }
  }`;
}
'''
      }
    }
