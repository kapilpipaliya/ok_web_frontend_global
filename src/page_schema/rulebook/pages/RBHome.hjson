  font-weight: 500;
  color: ${args.theme.var.color.text};
  margin-bottom: ${args.theme.var.spacing.xs};
}`;
'''
      }
    },
    {
      id: "rule_status",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const ruleData = args.contextData.rulesList;
const todayTracking = ruleData?.todayTracking;
const streak = ruleData?.streak;

let statusText = "⏱️ Not tracked yet";

if (todayTracking) {
  const status = todayTracking.P?.status || "";
  const completionPercentage = todayTracking.P?.completionPercentage || 0;

  switch (status) {
    case "completed":
      statusText = "✓ Completed today";
      break;
    case "partial":
      statusText = `⚡ ${completionPercentage}% completed`;
      break;
    case "missed":
      statusText = "❌ Missed today";
      break;
    case "skipped":
      statusText = "⏭️ Skipped today";
      break;
  }
} else if (streak?.P?.currentStreak > 0) {
  statusText = `🔥 ${streak.P.currentStreak} day streak`;
}

return {
  as: "div",
  text: statusText
};
''',
        css: '''
const ruleData = args.contextData.rulesList;
const todayTracking = ruleData?.todayTracking;

let colorKey = "muted";

if (todayTracking) {
  const status = todayTracking.P?.status || "";
  switch (status) {
    case "completed":
      colorKey = "completed";
      break;
    case "partial":
      colorKey = "partial";
      break;
    case "missed":
      colorKey = "missed";
      break;
    case "skipped":
      colorKey = "skipped";
      break;
  }
} else {
  colorKey = "streak";
}

return `._id {
  font-size: 0.875rem;
  color: ${args.theme.var.color[colorKey]};
}`;
'''
      }
