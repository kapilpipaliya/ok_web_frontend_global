      id: "progress_bar",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const dashboardData = args.fns.dashboardData?.();
const progressData = dashboardData?.progress;

// Calculate completion stats from real data
const totalTracking = progressData?.summary?.totalTracking || 0;
const completed = progressData?.summary?.completed || 0;
const partial = progressData?.summary?.partial || 0;

// Calculate effective completion percentage
const effectiveCompletions = completed + (partial * 0.7);
const percentage = totalTracking > 0 ? Math.round((effectiveCompletions / totalTracking) * 100) : 0;

return {
  as: "div"
};
''',
        css: '''
const dashboardData = args.fns.dashboardData?.();
const progress = dashboardData?.progress || {};

const percentage = progress.completionRate || 0;
const hasRules = progress.totalActiveRules > 0;

return `._id {
  width: ${Math.max(percentage, hasRules ? 2 : 0)}%;
  height: 12px;
  background: ${percentage === 0 ? args.theme.var.color.text_light_500 : args.theme.var.color.success};
  border-radius: ${args.theme.var.borderRadius.full};
  transition: width 500ms ease;
}`;
'''
      }
