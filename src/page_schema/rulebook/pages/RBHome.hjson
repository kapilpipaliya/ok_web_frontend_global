    },
    {
      id: "rule_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const ruleData = args.contextData.rulesList;
const rule = ruleData?.rule;
const category = ruleData?.category;

const title = rule?.P?.title || "Unknown Rule";
const icon = category?.P?.icon || "📝";

return {
  as: "div",
  text: `${icon} ${title}`
};
''',
        css: '''
