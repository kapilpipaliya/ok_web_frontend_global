};
''',
        css: '''
return `._id {
  font-size: 3.5rem;
  font-weight: 800;
  margin: 0 0 1.5rem 0;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

@media (max-width: 768px) {
  ._id {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
}

@media (max-width: 480px) {
