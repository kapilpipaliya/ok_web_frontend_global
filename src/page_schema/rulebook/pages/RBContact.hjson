{
  vertexes: [
    {
      id: "contact_page",
      L: "Page",
      P: {
        public: true
        key: "RBContact",
        url: "/contact",
        title: "Contact & Support - Personal Rulebook",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "contact_layout_1",
      L: "PageLayout",
      P: {
        componentName: "RBWebsiteLayout",
        displayOrder: 1
      }
    },
    {
      id: "contact_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1000px;
  margin: 0 auto;
  padding: ${args.theme.var.spacing.lg};
  color: ${args.theme.var.color.text};
}

@media (max-width: 768px) {
  ._id {
    padding: ${args.theme.var.spacing.md};
  }
}`;
'''
      }
    },
    {
      id: "page_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RBHeader"
      }
    },
    {
      id: "header_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        slotName: "center",
        props: '''
return {
  as: "h1",
  text: "Contact & Support"
};
''',
        css: '''
return `._id {
  font-size: 2rem;
  font-weight: 700;
  color: ${args.theme.var.color.primary};
  margin: 0;
}

@media (max-width: 768px) {
  ._id {
    font-size: 1.75rem;
  }
}`;
'''
      }
    },
    {
      id: "header_subtitle",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        slotName: "subtitle",
        props: '''
return {
  as: "p",
  text: "We're here to help you succeed on your personal growth journey. Reach out anytime!"
};
''',
        css: '''
return `._id {
  font-size: 1.1rem;
  line-height: 1.6;
  color: ${args.theme.var.color.text_light_500};
  margin: 0 auto;
  max-width: 600px;
}

@media (max-width: 768px) {
  ._id {
    font-size: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "contact_methods_section",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  margin-bottom: ${args.theme.var.spacing.xxl};
}`;
'''
      }
    },
    {
      id: "contact_methods_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h2",
  text: "Get in Touch"
};
''',
        css: '''
return `._id {
  font-size: 1.5rem;
  font-weight: 700;
  color: ${args.theme.var.color.primary};
  text-align: center;
  margin-bottom: ${args.theme.var.spacing.xl};
  position: relative;
}

._id::after {
  content: '';
  position: absolute;
  bottom: -${args.theme.var.spacing.md};
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 4px;
  background: ${args.theme.var.color.primary};
  border-radius: 2px;
}`;
'''
      }
    },
    {
      id: "contact_methods_grid",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: ${args.theme.var.spacing.xl};
}

@media (max-width: 768px) {
  ._id {
    grid-template-columns: 1fr;
    gap: ${args.theme.var.spacing.lg};
  }
}`;
'''
      }
    },
    {
      id: "method_email",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  padding: ${args.theme.var.spacing.xl};
  background: ${args.theme.var.color.background_light_100};
  border-radius: ${args.theme.var.borderRadius.xl};
  border: 2px solid ${args.theme.var.color.primary_light_200};
  text-align: center;
  transition: all 0.3s ease;
}

._id:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 25px ${args.theme.var.color.primary_light_300};
  border-color: ${args.theme.var.color.primary_light_300};
}

._id .icon {
  color: ${args.theme.var.color.primary};
  margin-bottom: ${args.theme.var.spacing.lg};
}

._id h3 {
  color: ${args.theme.var.color.primary};
  font-weight: 700;
  font-size: 1.25rem;
  margin-bottom: ${args.theme.var.spacing.md};
}

._id p {
  color: ${args.theme.var.color.text};
  line-height: 1.6;
  margin-bottom: ${args.theme.var.spacing.lg};
}

._id .email {
  color: ${args.theme.var.color.primary};
  font-weight: 600;
  font-size: 1.125rem;
  text-decoration: none;
  border-bottom: 2px solid ${args.theme.var.color.primary_light_200};
  transition: all 0.2s ease;
}

._id .email:hover {
  border-bottom-color: ${args.theme.var.color.primary};
}`;
'''
