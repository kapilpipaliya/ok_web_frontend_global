        slotName: "right",
        props: '''
return {
  as: "button",
  onClick: (e) => {
    e.preventDefault();
    e.stopPropagation();
    const { setShowCategoryModal, setModalMode, setSelectedCategory } = c.modals?.categoryModal || {};
    const categoryData = c.modals?.categoryData?.();

    if (categoryData) {
      setSelectedCategory?.(categoryData);
      setModalMode?.("edit");
      setShowCategoryModal?.(true);
    } else {
      _.showErrorToast("Category data not available");
    }
  },
  "aria-label": "Edit category"
};
''',
        css: '''
