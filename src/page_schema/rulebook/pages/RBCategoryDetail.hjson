{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "RBCategoryDetail",
        url: "/rb/category-detail",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
// Rule modal state
const [showRuleModal, setShowRuleModal] = _.createSignal(false);
const [ruleModalMode, setRuleModalMode] = _.createSignal("create");
const [selectedRule, setSelectedRule] = _.createSignal(null);

// Category modal state
const [showCategoryModal, setShowCategoryModal] = _.createSignal(false);
const [categoryModalMode, setCategoryModalMode] = _.createSignal("create");
const [selectedCategory, setSelectedCategory] = _.createSignal(null);

// Category data state
const [categoryData, setCategoryData] = _.createSignal(null);
const [rules, setRules] = _.createSignal([]);
const [isLoading, setIsLoading] = _.createSignal(true);
const [error, setError] = _.createSignal(null);

// Load category data
const loadCategoryData = async () => {
  const categoryId = _.searchParams?.categoryId;
  if (!categoryId) {
    setError("Category ID is required");
    setIsLoading(false);
    return;
  }

  setIsLoading(true);
  setError(null);

  try {
    // Use the specific getCategoryById function
    const categoryResult = await s({
      functionName: "getCategoryById",
      contextData: {
        categoryId
      }
    });

    if (categoryResult.error) {
      throw new Error(categoryResult.error);
    }

    if (categoryResult.result?.success) {
      const categoryData = categoryResult.result.data.category;
      setCategoryData(categoryData);
    } else {
      throw new Error(categoryResult.result?.message || "Failed to load category data");
    }

    // Load rules for this category
    const rulesResult = await s({
      functionName: "getRulesByCategory",
      contextData: {
        categoryId
      }
    });

    if (rulesResult.error) {
      console.warn("Failed to load rules:", rulesResult.error);
      // Don't throw error here, just log warning and continue with empty rules
      setRules([]);
    } else if (rulesResult.result?.success) {
      const rulesData = rulesResult.result.data.rules || [];
      setRules(rulesData);
    } else {
      console.warn("Failed to load rules:", rulesResult.result?.message);
      setRules([]);
    }

  } catch (err) {
    console.error("Error loading category data:", err);
    setError(err.message);
    _.showErrorToast(err.message);
  } finally {
    setIsLoading(false);
  }
};

// Load data on mount
const onMount = () => {
  loadCategoryData();
};

return {
  isNoPermissionCheck: true,
  contextName: "modals",
  onMount,
  data: {
    categoryData,
    rules,
    isLoading,
    error,
    refreshData: loadCategoryData,
    ruleModal: {
      showRuleModal,
      setShowRuleModal,
      modalMode: ruleModalMode,
      setModalMode: setRuleModalMode,
      selectedRule,
      setSelectedRule,
      refreshData: loadCategoryData
    },
    categoryModal: {
      showCategoryModal,
      setShowCategoryModal,
      modalMode: categoryModalMode,
      setModalMode: setCategoryModalMode,
      selectedCategory,
      setSelectedCategory
    }
  }
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
        componentName: "RBLayout",
        displayOrder: 1
      }
    },
