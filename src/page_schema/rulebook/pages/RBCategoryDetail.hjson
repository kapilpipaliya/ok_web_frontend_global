        css: '''
const isLoading = c.modals?.isLoading?.();

if (isLoading) {
  return `._id {
    background: ${t.var.color.background_light_100};
    border: 1px solid ${t.var.color.border};
    border-radius: ${t.var.borderRadius.lg};
    padding: ${t.var.spacing.xl};
    text-align: center;
    margin-bottom: ${t.var.spacing.xl};
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: ${t.var.spacing.md};
    min-height: 200px;

    &:before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: ${t.var.color.primary};
    }
  }`;
}

return `._id {
  background: ${t.var.color.background_light_100};
  border: 1px solid ${t.var.color.border};
  border-radius: ${t.var.borderRadius.lg};
  padding: ${t.var.spacing.xl};
  text-align: center;
  margin-bottom: ${t.var.spacing.xl};
  position: relative;
  overflow: hidden;

  &:before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: ${(() => {
      const categoryData = c.modals?.categoryData?.();
      const category = categoryData?.category;
      const color = category?.P?.color || "blue";

      // Helper function to get category color
      const getCategoryColor = (color) => {
        const colorMap = {
          blue: t.var.color.info,
          green: t.var.color.success,
          yellow: t.var.color.warning,
          red: t.var.color.error,
          purple: t.var.color.primary,
          orange: "#f97316",
          teal: "#14b8a6",
          pink: "#ec4899"
        };
        return colorMap[color] || t.var.color.primary;
      };

      return getCategoryColor(color);
    })()};
  }
}`;
'''
      }
