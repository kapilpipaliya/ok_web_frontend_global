  font-weight: 500;
  color: ${t.var.color.text};
  margin-bottom: ${t.var.spacing.xs};
}`;
'''
      }
    },
    {
      id: "rule_meta",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const ruleData = c.ruleLoop;
const rule = ruleData?.rule;
const stats = ruleData?.stats;

const frequency = rule?.P?.frequency || "Daily";
const priority = rule?.P?.priority || "Medium";
const bestStreak = stats?.bestStreak || 0;

const metaParts = [frequency, `${priority} Priority`];
if (bestStreak > 0) {
  metaParts.push(`🔥 ${bestStreak} day streak`);
}

return {
  as: "div",
  text: metaParts.join(" • ")
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  color: ${t.var.color.text_light_500};
}`;
'''
      }
    },
    {
      id: "rule_run_arrow",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:arrow-right",
  width: 16,
  height: 16
};
''',
        css: '''
return `._id {
  color: ${t.var.color.text_light_500};
}`;
'''
      }
    },
    {
      id: "empty_rules_state",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const rules = c.modals?.rules?.() || [];
const isLoading = c.modals?.isLoading?.();

return {
  as: "div",
  hide: rules.length > 0 || isLoading
};
''',
        css: '''
return `._id {
  text-align: center;
  padding: ${t.var.spacing.xl};
  color: ${t.var.color.text_light_500};
  border: 2px dashed ${t.var.color.border};
  border-radius: ${t.var.borderRadius.lg};
  background: ${t.var.color.background_light_50};
}`;
'''
      }
    },
    {
      id: "empty_rules_text",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  text: "No rules in this category yet. Add your first rule to get started!"
};
''',
        css: '''
return `._id {
  font-size: 1.125rem;
  margin-bottom: ${t.var.spacing.md};
  font-weight: 500;
}`;
'''
      }
    },
    {
      id: "empty_rules_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "RBButton",
        props: '''
return {
  text: "Add First Rule",
  variant: "primary",
  onClick: (e) => {
    e.preventDefault();
    e.stopPropagation();
    const { setShowRuleModal, setModalMode, setSelectedRule } = c.modals?.ruleModal || {};
    const categoryData = c.modals?.categoryData?.();
    const category = categoryData?.category;
    const categoryElementId = category?.id; // This is the Neo4j elementId

    // Set rule data with current category pre-selected
    setSelectedRule?.({
      categoryId: categoryElementId,
      categoryData: categoryData
    });
    setModalMode?.("create");
    setShowRuleModal?.(true);
  }
};
'''
      }
    },
    {
      id: "rule_form_modal",
      L: "Attr",
      P: {
        displayOrder: 999,
        componentName: "RBRuleFormModal",
        props: '''
const modalData = c.modals?.ruleModal || {};
const refreshData = c.modals?.refreshData;

return {
  isOpen: modalData.showRuleModal?.(),
  mode: modalData.modalMode?.(),
  ruleData: modalData.selectedRule?.(),
  onClose: () => {
    modalData.setShowRuleModal?.(false);
    modalData.setSelectedRule?.(null);
  },
  onSave: (result) => {
    // Refresh category data and rules after successful save
    if (refreshData) {
      refreshData();
    }
  },
  onDelete: (result) => {
    // Refresh category data and rules after successful delete
    if (refreshData) {
      refreshData();
    }
  }
};
'''
      }
    },
    {
      id: "category_form_modal",
      L: "Attr",
      P: {
        displayOrder: 999,
        componentName: "RBCategoryFormModal",
        props: '''
const modalData = c.modals?.categoryModal || {};
const refreshData = c.modals?.refreshData;

return {
  isOpen: modalData.showCategoryModal?.(),
  mode: modalData.modalMode?.(),
  categoryData: modalData.selectedCategory?.(),
  onClose: () => {
    modalData.setShowCategoryModal?.(false);
    modalData.setSelectedCategory?.(null);
  },
  onSave: (result) => {
    // Refresh category data after successful save
    if (refreshData) {
      refreshData();
    }
  },
  onDelete: (result) => {
    // Navigate back to categories page after successful delete
    _.navigate("/rb/categories");
  }
};
'''
      }
    }
  ],
