    {
      id: "rule_groups_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const goals = args.contextData?.goalsGrid?.goals || [];

// Group goals by rule for better organization
const groupedByRule = {};
goals.forEach(goalData => {
  const rule = goalData.rule;
  const ruleId = rule?.id || 'no-rule';
  const ruleTitle = rule?.P?.title || 'Unlinked Goals';
  
  if (!groupedByRule[ruleId]) {
    groupedByRule[ruleId] = {
      rule: rule,
      ruleTitle: ruleTitle,
      goals: []
    };
  }
  groupedByRule[ruleId].goals.push(goalData);
});

// Convert to array for looping
const ruleGroups = Object.values(groupedByRule);

return {
  as: "div",
  contextName: "ruleGroups",
  loop: true,
  data: ruleGroups
};
''',
        css: '''
return `._id {
  display: contents;
}`;
'''
      }
    },
    {
      id: "rule_group",
      L: "Attr",
      P: {
