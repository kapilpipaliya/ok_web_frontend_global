const goalItem = args.contextData?.goalCard;
const goal = goalItem?.goal;
const isCompleted = goal?.P?.isCompleted || false;

return {
  as: "span",
  text: "Completed",
  hide: !isCompleted
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.success};
  color: ${args.theme.var.color.success_text};
  padding: ${args.theme.var.spacing.xs} ${args.theme.var.spacing.sm};
  border-radius: ${args.theme.var.borderRadius.sm};
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-left: ${args.theme.var.spacing.sm};
}`;
'''
      }
    },
    {
      id: "goal_rule",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const goalItem = args.contextData?.goalCard;
const goal = goalItem?.goal;

const targetDate = goal?.P?.targetDate;
const formattedDate = targetDate ? new Date(targetDate).toLocaleDateString() : "No target date";

return {
  as: "p",
  text: `🎯 Target: ${formattedDate}`
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text_light_500};
  font-size: 0.875rem;
  margin: 0;
}`;
'''
      }
