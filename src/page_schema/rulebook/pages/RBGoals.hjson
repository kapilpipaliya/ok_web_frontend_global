    {
      id: "goal_form_modal",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "RBGoalFormModal",
        props: '''
const showGoalModal = args.contextData?.goalModal?.showGoalModal;
const modalMode = args.contextData?.goalModal?.modalMode;
const selectedGoal = args.contextData?.goalModal?.selectedGoal;
const setShowGoalModal = args.contextData?.goalModal?.setShowGoalModal;
return {
  isOpen: showGoalModal?.(),
  mode: modalMode?.(),
  goalData: selectedGoal?.(),
  onClose: () => {
    setShowGoalModal?.(false);
  },
  onSave: (result) => {
    // Refresh goals data after successful save
    const loadGoals = args.contextData?.goalModal?.loadGoals;
    if (loadGoals) {
      loadGoals();
    }
  },
  onDelete: (result) => {
    // Refresh goals data after successful delete
    const loadGoals = args.contextData?.goalModal?.loadGoals;
    if (loadGoals) {
      loadGoals();
    }
  }
};
'''
      }
    }
