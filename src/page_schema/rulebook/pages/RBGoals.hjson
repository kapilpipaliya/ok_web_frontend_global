{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "RBGoals",
        url: "/rb/goals",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
const [showGoalModal, setShowGoalModal] = args.createSignal(false);
const [modalMode, setModalMode] = args.createSignal("create");
const [selectedGoal, setSelectedGoal] = args.createSignal(null);
const [goals, setGoals] = args.createSignal([]);
const [isLoading, setIsLoading] = args.createSignal(true);
const [error, setError] = args.createSignal(null);

const loadGoals = async () => {
  setIsLoading(true);
  setError(null);

  try {
    const result = await args.executeNamedServerFunction({
      functionName: "getGoals",
      contextData: { includeCompleted: false }
    });

    if (result.error) {
      throw new Error(result.error);
    }

    if (result.result?.success) {
      setGoals(result.result.data?.goals || []);
    } else {
      setError(result.result?.message || "Failed to load goals");
    }
  } catch (err) {
    console.error("Error loading goals:", err);
    setError("Failed to load goals. Please try again.");
  } finally {
    setIsLoading(false);
  }
};

const onMount = () => {
  loadGoals();
};

return {
  isNoPermissionCheck: true,
  contextName: "goalModal",
  onMount,
  data: {
    showGoalModal,
    setShowGoalModal,
    modalMode,
    setModalMode,
    selectedGoal,
    setSelectedGoal,
    goals,
    setGoals,
    isLoading,
    error,
    loadGoals
  }
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
        componentName: "RBLayout",
        displayOrder: 1
      }
    },
    {
      id: "page_content",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  padding: ${args.theme.var.spacing.lg};
  max-width: 1200px;
  margin: 0 auto;
}

@media (max-width: 768px) {
  ._id {
    padding: ${args.theme.var.spacing.md};
  }
}`;
'''
      }
    },
    {
      id: "header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
return `._id {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: ${args.theme.var.spacing.xl};
}`;
'''
      }
    },
    {
      id: "page_title",
