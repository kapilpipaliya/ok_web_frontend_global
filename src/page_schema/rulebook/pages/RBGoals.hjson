{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "RBGoals",
        url: "/rb/goals",
        fns: '''
const [showGoalModal, setShowGoalModal] = args.createSignal(false);
const [modalMode, setModalMode] = args.createSignal("create");
const [selectedGoal, setSelectedGoal] = args.createSignal(null);
const [goals, setGoals] = args.createSignal([]);
const [isLoading, setIsLoading] = args.createSignal(true);
const [error, setError] = args.createSignal(null);
const [goalTypeOptions, setGoalTypeOptions] = args.createSignal([]);
const [includeCompleted, setIncludeCompleted] = args.createSignal(false);

// Fetch goal type options
const loadGoalTypeOptions = async () => {
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "getGoalSelectOptions",
      contextData: {}
    });

    if (result.result?.success && result.result?.data?.goalTypes) {
      setGoalTypeOptions(result.result.data.goalTypes);
    }
  } catch (err) {
    console.error("Error loading goal type options:", err);
  }
};

const loadGoals = async () => {
  setIsLoading(true);
  setError(null);

  try {
    const result = await args.executeNamedServerFunction({
      functionName: "getGoals",
      contextData: { includeCompleted: includeCompleted() }
    });

    if (result.error) {
      throw new Error(result.error);
    }

    if (result.result?.success) {
      setGoals(result.result.data?.goals || []);
    } else {
      setError(result.result?.message || "Failed to load goals");
    }
  } catch (err) {
    console.error("Error loading goals:", err);
    setError("Failed to load goals. Please try again.");
  } finally {
    setIsLoading(false);
  }
};

const onMount = () => {
  loadGoalTypeOptions();
  loadGoals();
};

return {
  enabled: true,
  showGoalModal,
  setShowGoalModal,
  modalMode,
  setModalMode,
  selectedGoal,
  setSelectedGoal,
  goals,
  setGoals,
  isLoading,
  error,
  loadGoals,
  goalTypeOptions,
  loadGoalTypeOptions,
  includeCompleted,
  setIncludeCompleted,
  onMount
};
''',
        props: '''
return {
  isNoPermissionCheck: true,
  onMount: args.fns.onMount
};
'''
      }
    },
