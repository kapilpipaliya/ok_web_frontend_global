    {
      id: "goal_text",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const goalItem = args.contextData?.goalCard;
const progress = goalItem?.progress;
const goal = goalItem?.goal;

const currentValue = progress?.currentValue || 0;
const targetValue = progress?.targetValue || 0;
const unit = goal?.P?.unit || 'units';
const remaining = Math.max(targetValue - currentValue, 0);

return {
  as: "div",
  text: `${currentValue}/${targetValue} ${unit} • ${remaining} ${unit} remaining`
};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.sm};
  font-weight: 500;
  color: ${args.theme.var.color.text};
}`;
'''
