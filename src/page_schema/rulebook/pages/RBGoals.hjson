        props: '''
if (args.fns.error()) {
  return {
    as: "div",
    text: `Error: ${args.fns.error()}`
  };
}

const goalsArray = args.fns.goals() || [];

if (goalsArray.length === 0 && !args.fns.isLoading()) {
  return {
    as: "div",
    contextName: "goalsGrid",
    data: { goals: goalsArray },
    text: "No goals found. Create your first goal to get started!"
  };
}

return {
  as: "div",
  contextName: "goalsGrid",
  data: { goals: goalsArray }
};
''',
        css: '''
if (args.fns.error()) {
  return `._id {
    text-align: center;
    padding: ${args.theme.var.spacing.xl};
    color: ${args.theme.var.color.error};
    font-size: 1.125rem;
  }`;
}

const goalsArray = args.fns.goals() || [];

if (goalsArray.length === 0 && !args.fns.isLoading()) {
  return `._id {
    text-align: center;
    padding: ${args.theme.var.spacing.xl};
    color: ${args.theme.var.color.text_light_500};
    font-size: 1.125rem;
  }`;
}

return `._id {
  display: flex;
  flex-direction: column;
  gap: ${args.theme.var.spacing.xxl};
}`;
'''
