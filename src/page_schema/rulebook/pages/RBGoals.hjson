  onClick: () => {
    args.fns.setModalMode("create");
    args.fns.setShowGoalModal(true);
  }
};
'''
      }
    },
    {
      id: "goal_form_modal",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "RBGoalFormModal",
        props: '''
return {
  isOpen: args.fns.showGoalModal(),
  mode: args.fns.modalMode(),
  goalData: args.fns.selectedGoal(),
  onClose: () => {
    args.fns.setShowGoalModal(false);
  },
  onSave: (result) => {
    // Refresh goals data after successful save
    args.fns.loadGoals();
  },
  onDelete: (result) => {
    // Refresh goals data after successful delete
    args.fns.loadGoals();
  }
};
'''
      }
    }
