return `._id > div {
  background: ${args.theme.var.color.background_light_100};
  border: 1px solid ${args.theme.var.color.border};
  border-radius: ${args.theme.var.borderRadius.lg};
  padding: ${args.theme.var.spacing.lg};
  position: relative;
  overflow: hidden;
  cursor: pointer;
  text-decoration: none;
  transition: all ${args.theme.var.animation.fast} ease;

  &:hover {
    border-color: ${args.theme.var.color.primary};
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  &:before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: ${args.theme.var.color.primary};
  }
}`;
'''
      }
    },
    {
      id: "goal_header",
      L: "Attr",
      P: {
        displayOrder: 1,
