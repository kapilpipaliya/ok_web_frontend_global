const goal = goalItem?.goal;
const goalType = goal?.P?.goalType || "streak";

const colorMap = {
  streak: args.theme.var.color.streak,
  completion: args.theme.var.color.success,
  time: args.theme.var.color.info,
  percentage: args.theme.var.color.primary
};
const bgColor = colorMap[goalType] || args.theme.var.color.primary;

return `._id {
  display: inline-flex;
  align-items: center;
  background: ${bgColor}_light_300;
  color: ${bgColor}_text;
  padding: ${args.theme.var.spacing.xs} ${args.theme.var.spacing.sm};
  border-radius: ${args.theme.var.borderRadius.full};
  font-size: 0.75rem;
  font-weight: 600;
  margin-bottom: ${args.theme.var.spacing.sm};
}`;
