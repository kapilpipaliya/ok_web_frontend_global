};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.title};
  font-weight: 700;
  color: ${args.theme.var.color.text};
  margin: 0;
}`;
'''
      }
    },
    {
      id: "add_goal_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "RBButton",
        props: '''
const setShowGoalModal = args.contextData?.goalModal?.setShowGoalModal;
const setModalMode = args.contextData?.goalModal?.setModalMode;

return {
  text: "Add Goal",
  variant: "primary",
  onClick: () => {
    setModalMode?.("create");
    setShowGoalModal?.(true);
  }
};
'''
      }
    },
    {
      id: "loading_container",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const isLoading = args.contextData?.goalModal?.isLoading?.();

return {
  as: "div",
  hide: !isLoading
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: ${args.theme.var.spacing.xl};
  gap: ${args.theme.var.spacing.md};
}`;
'''
      }
    },
    {
      id: "goals_grid",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const goals = args.contextData?.goalModal?.goals;
const isLoading = args.contextData?.goalModal?.isLoading;
const error = args.contextData?.goalModal?.error;

if (error?.()) {
  return {
    as: "div",
    text: `Error: ${error()}`
  };
}

const goalsArray = goals?.() || [];

if (goalsArray.length === 0 && !isLoading?.()) {
  return {
    as: "div",
    contextName: "goalsGrid",
    data: { goals: goalsArray },
    text: "No goals found. Create your first goal to get started!"
  };
}

return {
  as: "div",
  contextName: "goalsGrid",
  data: { goals: goalsArray }
};
''',
        css: '''
const goals = args.contextData?.goalModal?.goals;
const isLoading = args.contextData?.goalModal?.isLoading;
const error = args.contextData?.goalModal?.error;

if (error?.()) {
  return `._id {
    text-align: center;
    padding: ${args.theme.var.spacing.xl};
    color: ${args.theme.var.color.error};
    font-size: ${args.theme.var.fontSize.lg};
  }`;
}

const goalsArray = goals?.() || [];

if (goalsArray.length === 0 && !isLoading?.()) {
  return `._id {
    text-align: center;
    padding: ${args.theme.var.spacing.xl};
    color: ${args.theme.var.color.muted};
    font-size: ${args.theme.var.fontSize.lg};
  }`;
}

return `._id {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: ${args.theme.var.spacing.lg};
}`;
'''
      }
    },
