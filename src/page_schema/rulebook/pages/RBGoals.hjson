'''
      }
    },
    {
      id: "goal_menu_edit",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RBMenuItem",
        slot: "menu-items",
        props: '''
const setShowGoalModal = args.contextData?.goalModal?.setShowGoalModal;
const setModalMode = args.contextData?.goalModal?.setModalMode;
const setSelectedGoal = args.contextData?.goalModal?.setSelectedGoal;
const goalItem = args.contextData?.goalCard;

return {
  icon: "carbon:edit",
  text: "Edit Goal",
  onClick: (e) => {
    e.preventDefault();
    e.stopPropagation();

    const goal = goalItem?.goal;
    const rule = goalItem?.rule;

    if (goal) {
      const goalData = {
        id: goal.id,
        title: goal.P.title,
        description: goal.P.description,
        linkedRule: rule?.id,
        goalType: goal.P.goalType,
        targetValue: goal.P.targetValue,
        unit: goal.P.unit,
        targetDate: goal.P.targetDate,
        reward: goal.P.reward,
        currentValue: goal.P.currentValue
      };
      setSelectedGoal?.(goalData);
      setModalMode?.("edit");
      setShowGoalModal?.(true);
    }
  }
};
'''
      }
    },
    {
      id: "goal_menu_view",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "RBMenuItem",
        slot: "menu-items",
        props: '''
const goalItem = args.contextData?.goalCard;
const goal = goalItem?.goal;

return {
  icon: "carbon:view",
  text: "View Details",
  onClick: (e) => {
    e.preventDefault();
    e.stopPropagation();

    if (goal) {
      const goalId = goal.id;
      args.navigate(`/rb/goal-detail?goalId=${goalId}`);
    }
  }
};
'''
      }
    },
    {
      id: "goal_menu_duplicate",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "RBMenuItem",
        slot: "menu-items",
        props: '''
const setShowGoalModal = args.contextData?.goalModal?.setShowGoalModal;
const setModalMode = args.contextData?.goalModal?.setModalMode;
const setSelectedGoal = args.contextData?.goalModal?.setSelectedGoal;
const goalItem = args.contextData?.goalCard;

return {
  icon: "carbon:copy",
  text: "Duplicate Goal",
  onClick: (e) => {
    e.preventDefault();
    e.stopPropagation();

    const goal = goalItem?.goal;
    const rule = goalItem?.rule;

    if (goal) {
      const goalData = {
        title: `Copy of ${goal.P.title}`,
        description: goal.P.description,
        linkedRule: rule?.id,
        goalType: goal.P.goalType,
        targetValue: goal.P.targetValue,
        unit: goal.P.unit,
        targetDate: goal.P.targetDate,
        reward: goal.P.reward,
        currentValue: 0 // Reset progress for duplicate
      };
      setSelectedGoal?.(goalData);
      setModalMode?.("create");
      setShowGoalModal?.(true);
    }
  }
};
'''
      }
    },
    {
      id: "goal_menu_complete",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "RBMenuItem",
        slot: "menu-items",
        props: '''
const goalItem = args.contextData?.goalCard;
const loadGoals = args.contextData?.goalModal?.loadGoals;
const goal = goalItem?.goal;

return {
  icon: "carbon:checkmark-filled",
  text: "Mark Complete",
  onClick: async (e) => {
    e.preventDefault();
    e.stopPropagation();
    const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
    const confirmed = await rbConfirm({
      title: "Mark Goal Complete",
      message: "Are you sure you want to mark this goal as complete?",
      confirmText: "Mark Complete",
      cancelText: "Cancel",
      variant: "primary"
    });
    if (confirmed) {
      try {
        const result = await args.executeNamedServerFunction({
          functionName: "updateGoalProgress",
          contextData: {
            goalId: goal?.id,
            isCompleted: true
          }
        });

        if (result.error) {
          args.showErrorToast(result.error);
        } else if (result.result?.success) {
          args.showSuccessToast("Goal marked as complete! 🏆");
          if (loadGoals) loadGoals();
        } else {
          args.showErrorToast(result.result?.message || "Failed to complete goal");
        }
      } catch (error) {
        console.error("Error completing goal:", error);
        args.showErrorToast("Failed to complete goal. Please try again.");
      }
    }
  }
};
'''
      }
    },
    {
      id: "goal_menu_delete",
      L: "Attr",
      P: {
        displayOrder: 5,
        componentName: "RBMenuItem",
        slot: "menu-items",
        props: '''
const goalItem = args.contextData?.goalCard;
const loadGoals = args.contextData?.goalModal?.loadGoals;
const goal = goalItem?.goal;

return {
  icon: "carbon:trash-can",
  text: "Delete Goal",
  type: "danger",
  onClick: async (e) => {
    e.preventDefault();
    e.stopPropagation();
    const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
    const confirmed = await rbConfirm({
      title: "Delete Goal",
      message: "Are you sure you want to delete this goal? This action cannot be undone and will permanently remove all progress data.",
      confirmText: "Delete Goal",
      cancelText: "Cancel",
      variant: "danger"
    });
    if (confirmed) {
      try {
        const result = await args.executeNamedServerFunction({
          functionName: "deleteGoal",
          contextData: {
            goalId: goal?.id
          }
        });

        if (result.error) {
          args.showErrorToast(result.error);
        } else if (result.result?.success) {
          args.showSuccessToast("Goal deleted successfully");
          if (loadGoals) loadGoals();
        } else {
          args.showErrorToast(result.result?.message || "Failed to delete goal");
        }
      } catch (error) {
        console.error("Error deleting goal:", error);
        args.showErrorToast("Failed to delete goal. Please try again.");
      }
    }
  }
};
'''
      }
    },
