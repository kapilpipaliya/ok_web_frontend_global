    {
      id: "goal_menu_edit",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RBMenuItem",
        slotName: "menu-items",
        props: '''
const goalItem = args.contextData?.goalCard;

return {
  icon: "carbon:edit",
  text: "Edit Goal",
  onClick: (e) => {
    e.preventDefault();
    e.stopPropagation();

    const goal = goalItem?.goal;
    const rule = goalItem?.rule;
    const closeMenu = args.contextData?.floatingMenuContext?.closeMenu;

    if (goal) {
      const goalData = {
        id: goal.id,
        title: goal.P.title,
        description: goal.P.description,
        linkedRule: rule?.id,
        goalType: goal.P.goalType,
        targetValue: goal.P.targetValue,
        unit: goal.P.unit,
        targetDate: goal.P.targetDate,
        reward: goal.P.reward,
        currentValue: goal.P.currentValue
      };
      closeMenu?.();
      
      // Small delay to ensure menu closes before modal opens
      setTimeout(() => {
        args.fns.setSelectedGoal(goalData);
        args.fns.setModalMode("edit");
        args.fns.setShowGoalModal(true);
      }, 50);
    }
  }
};
'''
