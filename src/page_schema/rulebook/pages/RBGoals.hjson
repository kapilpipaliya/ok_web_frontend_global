      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const goalItem = args.contextData?.goalCard;
const goal = goalItem?.goal;
const goalType = goal?.P?.goalType || "streak";
const goalTypeOptions = args.fns.goalTypeOptions() || [];

// Find the matching goal type option
const matchingOption = goalTypeOptions.find(option => option.value === goalType);

let typeIcon = matchingOption?.icon || "🔥";
let typeLabel = matchingOption?.label || "Streak Goal";

return {
  as: "span",
  text: `${typeIcon} ${typeLabel}`
};
''',
        css: '''
