        props: '''
return {
  text: f.isDeleting() ? "Deleting..." : "🗑️ Delete Category",
  type: "button",
  variant: "danger",
  loading: f.isDeleting(),
  disabled: f.isDeleting(),
  onClick: async () => {
    const rbConfirm = c?.confirmContext?.rbConfirm;
    if (!rbConfirm) {
      _.showErrorToast("Confirmation dialog not available");
      return;
    }

    const confirmed = await rbConfirm({
      title: "Delete Category",
      message: "⚠️ WARNING: This will permanently delete:\n• This category\n• All rules in this category\n• All tracking data for those rules\n• All goals for those rules\n\nThis action cannot be undone!",
      confirmText: "Delete Category",
      cancelText: "Cancel",
      variant: "danger"
    });

    if (confirmed) {
      f.handleDelete();
    }
  }
};
'''
