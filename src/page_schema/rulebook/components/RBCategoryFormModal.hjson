{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "RBCategoryFormModal"
      }
    },
    {
      id: "variant_on_save",
      L: "ComponentVariant",
      P: {
        key: "onSave",
        type: "function",
        defValue: null
      }
    },
    {
      id: "variant_on_delete",
      L: "ComponentVariant",
      P: {
        key: "onDelete",
        type: "function",
        defValue: null
      }
    },
    {
      id: "modal_overlay",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
// Form state management
const [isSaving, setIsSaving] = _.createSignal(false);
const [isDeleting, setIsDeleting] = _.createSignal(false);
const [formData, setFormData] = _.createStore({
  name: "",
  description: "",
  color: "blue",
  icon: "📝"
});

// Initialize form data based on props
const initializeFormData = () => {
  const categoryData = c.props?.categoryData;
  const mode = c.props?.mode || "create";

  if (mode === "edit" && categoryData) {
    // CategoryData comes as { category: vertex, ruleCount: number }
    // We need to access the category vertex which has the .P properties
    const category = categoryData.category || categoryData; // Handle both formats

    setFormData({
      name: category.P?.name || "",
      description: category.P?.description || "",
      color: category.P?.color || "blue",
      icon: category.P?.icon || "📝"
    });
  } else {
    setFormData({
      name: "",
      description: "",
      color: "blue",
      icon: "📝"
    });
  }
};

// Initialize form data when component mounts or props change
const categoryData = c.props?.categoryData;
const mode = c.props?.mode;
initializeFormData();

// Handle form submission
const handleSave = async () => {
  const data = formData;
  const mode = c.props?.mode || "create";
  const categoryData = c.props?.categoryData;
  const onSaveCallback = c.props?.onSave;
  const onClose = c.props?.onClose || (() => {});

  // Validate required fields
  if (!data.name.trim()) {
    _.showErrorToast("Category name is required");
    return;
  }

  setIsSaving(true);

  try {
    // Prepare context data for server function
    const contextData = {
      name: data.name.trim(),
      description: data.description.trim() || null,
      color: data.color,
      icon: data.icon,
      isActive: true // Default to active
    };

    // Add categoryId for edit mode
    if (mode === "edit" && categoryData) {
      const category = categoryData.category || categoryData; // Handle both formats

      // Use category.id (Neo4j elementId)
      contextData.categoryId = category.id;

      // Preserve existing displayOrder in edit mode
      contextData.displayOrder = category.P?.displayOrder;
    }

    // Call the saveCategory server function
    const result = await s({
      functionName: "saveCategory",
      contextData
    });

    if (result.error) {
      _.showErrorToast(result.error);
    } else if (result.result && result.result.success) {
      _.showSuccessToast(result.result.message);

      // Call parent callback if provided
      if (onSaveCallback) {
        onSaveCallback({
          mode,
          data: contextData,
          result: result.result.data
        });
      }

      onClose();
    } else {
      _.showErrorToast(result.result?.message || "Failed to save category");
    }
  } catch (error) {
    console.error("Error saving category:", error);
    _.showErrorToast("An error occurred while saving the category. Please try again.");
  } finally {
    setIsSaving(false);
  }
};

// Handle delete
const handleDelete = async () => {
  const mode = c.props?.mode || "create";
  const categoryData = c.props?.categoryData;
  const onDeleteCallback = c.props?.onDelete;
  const onClose = c.props?.onClose || (() => {});

  if (mode !== "edit" || !categoryData) {
    return;
  }

  setIsDeleting(true);

  try {
    // Call the deleteCategory server function
    const category = categoryData.category || categoryData; // Handle both formats
    const result = await s({
      functionName: "deleteCategory",
      contextData: {
        categoryId: category.id
      }
    });

    if (result.error) {
      _.showErrorToast(result.error);
    } else if (result.result && result.result.success) {
      _.showSuccessToast(result.result.message);

      // Call parent callback if provided
      if (onDeleteCallback) {
        const category = categoryData.category || categoryData; // Handle both formats
        onDeleteCallback({
          categoryId: category.id,
          categoryData,
          result: result.result.data
        });
      }

      onClose();
    } else {
      _.showErrorToast(result.result?.message || "Failed to delete category");
    }
  } catch (error) {
    console.error("Error deleting category:", error);
    _.showErrorToast("An error occurred while deleting the category. Please try again.");
  } finally {
    setIsDeleting(false);
  }
};

// Update form field
const updateField = (field, value) => {
  setFormData(field, value);
};

// Helper function to check if any operation is in progress
const isSubmitting = () => isSaving() || isDeleting();

return {
  isSaving,
  isDeleting,
  isSubmitting,
  formData,
  handleSave,
  handleDelete,
  updateField
};
''',
        props: '''
const isOpen = c.props?.isOpen || false;
const mode = c.props?.mode || "create"; // "create" or "edit"
const categoryData = c.props?.categoryData;
const onClose = c.props?.onClose || (() => {});

return {
  as: "div",
  hide: !isOpen,
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      onClose();
    }
  }
};
''',
        css: '''
return `._id {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: ${t.var.spacing.md};
  animation: fadeIn 300ms ease;
}

@media (max-width: 768px) {
  ._id {
    padding: 0;
    align-items: flex-end;
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}`;
'''
