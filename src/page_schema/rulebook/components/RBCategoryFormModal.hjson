        componentName: "RBButton",
        props: '''
const mode = c.props?.mode || "create";
const isSaving = f.isSaving();

const buttonText = isSaving
  ? (mode === "edit" ? "Saving..." : "Creating...")
  : (mode === "edit" ? "Save Changes" : "Create Category");

return {
  text: buttonText,
  type: "submit",
  variant: "success",
  fullWidth: true,
  loading: isSaving,
  disabled: isSaving,
  onClick: (e) => {
    e.preventDefault();
    f.handleSave();
  }
};
''',
