{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "RBGoalFormModal"
      }
    },
    {
      id: "variant_on_save",
      L: "ComponentVariant",
      P: {
        key: "onSave",
        type: "function",
        defValue: null
      }
    },
    {
      id: "variant_on_delete",
      L: "ComponentVariant",
      P: {
        key: "onDelete",
        type: "function",
        defValue: null
      }
    },
    {
      id: "modal_overlay",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
// Form state management
const [isSubmitting, setIsSubmitting] = args.createSignal(false);

const [formData, setFormData] = args.createStore({
  title: "",
  description: "",
  ruleId: "",
  goalType: "streak",
  targetValue: "",
  unit: "",
  targetDate: "",
  reward: ""
});

// Load rules for the dropdown

// Initialize form data based on props
const initializeFormData = () => {
  const goalData = args.contextData.props?.goalData;
  const mode = args.contextData.props?.mode || "create";

  if (mode === "edit" && goalData) {
    setFormData({
      title: goalData.title || "",
      description: goalData.description || "",
      ruleId: goalData.linkedRule || "",
      goalType: goalData.goalType || "streak",
      targetValue: goalData.targetValue?.toString() || "",
      unit: goalData.unit || "",
      targetDate: goalData.targetDate || "",
      reward: goalData.reward || ""
    });
  } else {
    setFormData({
      title: "",
      description: "",
      ruleId: "",
      goalType: "streak",
      targetValue: "",
      unit: "",
      targetDate: "",
      reward: ""
    });
  }
};

// Initialize form data when component mounts or props change
const goalData = args.contextData.props?.goalData;
const mode = args.contextData.props?.mode;
initializeFormData();

// Handle form submission
const handleSave = async () => {
  const data = formData;
  const mode = args.contextData.props?.mode || "create";
  const goalData = args.contextData.props?.goalData;
  const onSaveCallback = args.contextData.props?.onSave;
  const onClose = args.contextData.props?.onClose || (() => {});

  // Validate required fields
  if (!data.title.trim()) {
    args.showErrorToast("Goal title is required");
    return;
  }

  if (!data.ruleId) {
    args.showErrorToast("Please select a rule");
    return;
  }

  if (!data.targetValue || parseInt(data.targetValue) <= 0) {
    args.showErrorToast("Target value must be a positive number");
    return;
  }

  if (!data.unit.trim()) {
    args.showErrorToast("Unit is required");
    return;
  }

  if (!data.targetDate) {
    args.showErrorToast("Target date is required");
    return;
  }

  setIsSubmitting(true);

  try {
    // Prepare context data for server function
    const contextData = {
      ruleId: data.ruleId,
      title: data.title.trim(),
      description: data.description.trim() || null,
      goalType: data.goalType,
      targetValue: parseInt(data.targetValue),
      unit: data.unit.trim(),
      targetDate: data.targetDate || null,
      reward: data.reward.trim() || null
    };

    // Add goalId for edit mode
    if (mode === "edit" && goalData) {
      contextData.goalId = goalData.id;
    }

    // Call the createRuleGoal server function
    const result = await args.executeNamedServerFunction({
      functionName: "createRuleGoal",
      contextData
    });

    if (result.error) {
      args.showErrorToast(result.error);
    } else if (result.result && result.result.success) {
      args.showSuccessToast(result.result.message);

      // Call parent callback if provided
      if (onSaveCallback) {
        onSaveCallback({
          mode,
          data: contextData,
          result: result.result.data
        });
      }

      onClose();
    } else {
      args.showErrorToast(result.result?.message || "Failed to save goal");
    }
  } catch (error) {
    console.error("Error saving goal:", error);
    args.showErrorToast("An error occurred while saving the goal. Please try again.");
  } finally {
    setIsSubmitting(false);
  }
};

// Handle delete
const handleDelete = async () => {
  const mode = args.contextData.props?.mode || "create";
  const goalData = args.contextData.props?.goalData;
  const onDeleteCallback = args.contextData.props?.onDelete;
  const onClose = args.contextData.props?.onClose || (() => {});

  if (mode !== "edit" || !goalData) {
    return;
  }

  setIsSubmitting(true);

  try {
    // Call the deleteGoal server function
    const result = await args.executeNamedServerFunction({
      functionName: "deleteGoal",
      contextData: {
        goalId: goalData.id
      }
    });

    if (result.error) {
      args.showErrorToast(result.error);
    } else if (result.result && result.result.success) {
      args.showSuccessToast(result.result.message);

      // Call parent callback if provided
      if (onDeleteCallback) {
        onDeleteCallback({
          goalId: goalData.id,
          goalData,
          result: result.result.data
        });
      }

      onClose();
    } else {
      args.showErrorToast(result.result?.message || "Failed to delete goal");
    }
  } catch (error) {
    console.error("Error deleting goal:", error);
    args.showErrorToast("An error occurred while deleting the goal. Please try again.");
  } finally {
    setIsSubmitting(false);
  }
};

// Update form field
const updateField = (field, value) => {
  if (field === 'goalType') {
    // Reset unit when goal type changes since available units will change
    setFormData('unit', '');
  }
  setFormData(field, value);
};

return {
  isSubmitting,
  formData,
  handleSave,
  handleDelete,
  updateField,
  initializeFormData
};
''',
        props: '''
const isOpen = args.contextData.props?.isOpen || false;
const mode = args.contextData.props?.mode || "create"; // "create" or "edit"
const goalData = args.contextData.props?.goalData;
const onClose = args.contextData.props?.onClose || (() => {});

return {
  as: "div",
  hide: !isOpen,
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      onClose();
    }
  }
};
''',
        css: '''
return `._id {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: ${args.theme.var.spacing.md};
  animation: fadeIn ${args.theme.var.animation.normal} ease;
}

@media (max-width: 768px) {
  ._id {
    padding: 0;
    align-items: flex-end;
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}`;
'''
