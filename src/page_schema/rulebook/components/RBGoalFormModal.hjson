const isSubmitting = args.fns.isSubmitting();

return {
  text: isSubmitting ? "Saving..." : buttonText,
  type: "submit",
  variant: "primary",
  fullWidth: true,
  loading: isSubmitting,
  disabled: isSubmitting,
  onClick: (e) => {
    e.preventDefault();
    args.fns.handleSave();
  }
};
