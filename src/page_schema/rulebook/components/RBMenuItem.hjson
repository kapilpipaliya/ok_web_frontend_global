{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "RBMenuItem"
      }
    },
    {
      id: "variant_type",
      L: "ComponentVariant",
      P: {
        key: "type",
        type: "string",
        defValue: "default"
      }
    },
    {
      id: "type_option_default",
      L: "ComponentVariantOption",
      P: {
        key: "default",
        value: "default",
        description: "Default menu item"
      }
    },
    {
      id: "type_option_danger",
      L: "ComponentVariantOption",
      P: {
        key: "danger",
        value: "danger",
        description: "Danger menu item (red)"
      }
    },
    {
      id: "variant_icon",
      L: "ComponentVariant",
      P: {
        key: "icon",
        type: "string",
        defValue: ""
      }
    },
    {
      id: "variant_text",
      L: "ComponentVariant",
      P: {
        key: "text",
        type: "string",
        defValue: "Menu Item"
      }
    },
    {
      id: "menu_item",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const text = c.props?.text || "Menu Item";
const onClick = c.props?.onClick;
const href = c.props?.href;
const type = c.props?.type || "default";
const isDivider = c.props?.isDivider;

// If it's a divider, render a simple div
if (isDivider) {
  return {
    as: "div"
  };
}

// If href is provided, render as link
if (href) {
  return {
    as: "a",
    href: href,
    onClick: onClick,
    role: "menuitem"
  };
}

// Default: render as button
return {
  as: "button",
  onClick: onClick,
  role: "menuitem"
};
''',
        css: '''
const type = c.props?.type || "default";
const isDivider = c.props?.isDivider;

// Divider styles
if (isDivider) {
  return `._id {
    height: 1px;
    background: ${t.var.color.border};
    margin: 0.25rem 0;
  }`;
}

// Regular menu item styles
return `._id {
  width: 100%;
  background: none;
  border: none;
  padding: 0.5rem 0.75rem;
  text-align: left;
  cursor: pointer;
  border-radius: 0.25rem;
  transition: all 150ms ease;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: ${type === 'danger' ? t.var.color.error : t.var.color.text};
  font-size: 0.875rem;
  font-weight: 500;
  text-decoration: none;
}

._id:hover {
  background: ${type === 'danger' ? t.var.color.error_light_100 : t.var.color.primary_light_200};
  color: ${type === 'danger' ? t.var.color.error_text : t.var.color.text};
}

._id:focus {
  outline: 2px solid ${t.var.color.primary};
  outline-offset: -2px;
}`;
'''
      }
    },
    {
      id: "item_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const icon = c.props?.icon;
const isDivider = c.props?.isDivider;

// Hide icon for dividers
if (isDivider || !icon) {
  return { as: "div", hide: true };
}

return {
  as: "icon",
  icon: icon,
  width: 16,
  height: 16
};
'''
      }
    },
    {
      id: "item_text",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const text = c.props?.text || "Menu Item";
const isDivider = c.props?.isDivider;

// Hide text for dividers
if (isDivider) {
  return { as: "div", hide: true };
}

return {
  as: "span",
  text: text
};
''',
        css: '''
return `._id {
  flex: 1;
}`;
'''
      }
    }
  ],
  edges: [
    { id: "e1", T: "ComponentVariant", S: "component_root", E: "variant_type" },
    { id: "e2", T: "ComponentVariantOption", S: "variant_type", E: "type_option_default" },
    { id: "e3", T: "ComponentVariantOption", S: "variant_type", E: "type_option_danger" },
    { id: "e4", T: "ComponentVariant", S: "component_root", E: "variant_icon" },
    { id: "e5", T: "ComponentVariant", S: "component_root", E: "variant_text" },
    { id: "e6", T: "Attr", S: "component_root", E: "menu_item" },
    { id: "e7", T: "Attr", S: "menu_item", E: "item_icon" },
    { id: "e8", T: "Attr", S: "menu_item", E: "item_text" }
  ]
}