        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: ${t.var.color.background};
}`;
'''
      }
    },
    {
      id: "header_section",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
return `._id {
  background: ${t.var.color.background};
  border-bottom: 1px solid ${t.var.color.border};
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(10px);
  background: ${t.var.color.background}CC;
}`;
'''
      }
    },
    {
      id: "header_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1200px;
  margin: 0 auto;
  padding: ${t.var.spacing.lg} ${t.var.spacing.xl};
  display: flex;
  justify-content: space-between;
  align-items: center;
}

@media (max-width: 768px) {
  ._id {
    padding: ${t.var.spacing.md};
  }
}`;
'''
      }
    },
    {
      id: "header_logo",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: ${t.var.spacing.md};
}

._id .icon {
  color: ${t.var.color.primary};
}

._id h1 {
  font-size: 1.25rem;
  font-weight: 700;
  color: ${t.var.color.primary};
  margin: 0;
  cursor: pointer;
  transition: all 0.2s ease;
}

._id h1:hover {
  color: ${t.var.color.primary_dark_200};
}

@media (max-width: 768px) {
  ._id h1 {
    font-size: 1.125rem;
  }
}`;
'''
      }
