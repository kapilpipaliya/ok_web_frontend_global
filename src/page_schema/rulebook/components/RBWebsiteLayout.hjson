        css: '''
return `._id {
  display: flex;
  gap: ${t.var.spacing.md};
  align-items: center;
}

._id button {
  padding: ${t.var.spacing.sm} ${t.var.spacing.lg};
  border-radius: ${t.var.borderRadius.md};
  font-weight: 600;
  font-size: 0.875rem;
  cursor: pointer;
  transition: all 0.2s ease;
  border: 1px solid transparent;
}

._id .login-btn {
  background: transparent;
  color: ${t.var.color.text};
  border-color: ${t.var.color.border};
}

._id .login-btn:hover {
  background: ${t.var.color.background_light_100};
  border-color: ${t.var.color.primary_light_200};
  color: ${t.var.color.primary};
}

._id .signup-btn {
  background: ${t.var.color.primary};
  color: ${t.var.color.primary_text};
  border-color: ${t.var.color.primary};
}

._id .signup-btn:hover {
  background: ${t.var.color.primary_dark_200};
  border-color: ${t.var.color.primary_dark_200};
  transform: translateY(-1px);
  box-shadow: 0 4px 12px ${t.var.color.primary_light_400};
}

@media (max-width: 768px) {
  ._id button {
    padding: ${t.var.spacing.xs} ${t.var.spacing.md};
    font-size: 0.75rem;
  }
}`;
