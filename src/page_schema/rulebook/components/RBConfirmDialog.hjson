  as: "footer"
};
''',
        css: '''
return `._id {
  display: flex;
  gap: ${t.var.spacing.md};
  padding: ${t.var.spacing.md} ${t.var.spacing.xl} ${t.var.spacing.xl};
  justify-content: flex-end;
}

@media (max-width: 768px) {
  ._id {
    flex-direction: column-reverse;
    gap: ${t.var.spacing.sm};
  }
}`;
'''
      }
    },
    {
      id: "cancel_button",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const cancelText = c.props?.cancelText || "Cancel";
const onCancel = c.props?.onCancel;
const loading = c.props?.loading || false;

return {
  as: "button",
  type: "button",
  text: cancelText,
  disabled: loading,
  onClick: () => {
    if (onCancel && !loading) {
      onCancel();
    }
  }
};
''',
        css: '''
return `._id {
  min-height: 48px;
  padding: ${t.var.spacing.sm} ${t.var.spacing.lg};
  font-size: 1rem;
  font-weight: 500;
  border: 1px solid ${t.var.color.border};
  border-radius: ${t.var.borderRadius.md};
  background: ${t.var.color.background};
  color: ${t.var.color.text};
  cursor: pointer;
  transition: all 150ms ease;
  flex: 1;

  &:hover:not(:disabled) {
    background: ${t.var.color.background_dark_100};
    border-color: ${t.var.color.border_dark_200};
  }

  &:focus {
    outline: none;
    border-color: ${t.var.color.primary};
    box-shadow: 0 0 0 3px ${t.var.color.primary_light_200};
  }

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
}

@media (max-width: 768px) {
  ._id {
    padding: ${t.var.spacing.md};
    font-size: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "confirm_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const confirmText = c.props?.confirmText || "Confirm";
const onConfirm = c.props?.onConfirm;
const loading = c.props?.loading || false;

return {
  as: "button",
  type: "button",
  text: loading ? "Please wait..." : confirmText,
  disabled: loading,
  onClick: async () => {
    if (onConfirm && !loading) {
      await onConfirm();
    }
  }
};
''',
        css: '''
const variant = c.props?.variant || "danger";

const variantStyles = {
  danger: {
    background: t.var.color.error,
    backgroundHover: t.var.color.error_dark_200,
    text: t.var.color.error_text,
    focus: t.var.color.error_light_200
  },
  warning: {
    background: t.var.color.warning,
    backgroundHover: t.var.color.warning_dark_200,
    text: t.var.color.warning_text,
    focus: t.var.color.warning_light_200
  },
  primary: {
    background: t.var.color.primary,
    backgroundHover: t.var.color.primary_dark_200,
    text: t.var.color.primary_text,
    focus: t.var.color.primary_light_200
  }
};

const style = variantStyles[variant] || variantStyles.danger;

return `._id {
  min-height: 48px;
  padding: ${t.var.spacing.sm} ${t.var.spacing.lg};
  font-size: 1rem;
  font-weight: 500;
  border: 1px solid transparent;
  border-radius: ${t.var.borderRadius.md};
  background: ${style.background};
  color: ${style.text};
  cursor: pointer;
  transition: all 150ms ease;
  flex: 1;

  &:hover:not(:disabled) {
    background: ${style.backgroundHover};
    transform: translateY(-1px);
  }

  &:focus {
    outline: none;
    box-shadow: 0 0 0 3px ${style.focus};
  }

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }
}

@media (max-width: 768px) {
  ._id {
    padding: ${t.var.spacing.md};
    font-size: 1rem;
  }
}`;
'''
      }
    }
