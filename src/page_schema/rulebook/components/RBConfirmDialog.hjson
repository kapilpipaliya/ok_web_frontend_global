    {
      id: "dialog_overlay",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const isOpen = c.props?.isOpen || false;
const onCancel = c.props?.onCancel;

return {
  as: "div",
  hide: !isOpen,
  onClick: (e) => {
    if (e.target === e.currentTarget && onCancel) {
      onCancel();
    }
  }
};
''',
        css: '''
return `._id {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: ${t.var.spacing.md};
  animation: fadeIn 150ms ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@media (max-width: 768px) {
  ._id {
    padding: ${t.var.spacing.sm};
    align-items: flex-end;
  }
}`;
'''
      }
    },
    {
      id: "dialog_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  onClick: (e) => {
    e.stopPropagation();
  }
};
''',
        css: '''
return `._id {
  background: ${t.var.color.background};
  border: 1px solid ${t.var.color.border};
  border-radius: ${t.var.borderRadius.lg};
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  max-width: 400px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  animation: slideIn 300ms ease-out;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: scale(0.95) translateY(-10px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

@media (max-width: 768px) {
  ._id {
    margin-bottom: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    animation: slideUp 300ms ease-out;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(100%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
}`;
'''
      }
    },
    {
      id: "dialog_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
return `._id {
  padding: ${t.var.spacing.xl} ${t.var.spacing.xl} ${t.var.spacing.md};
  border-bottom: 1px solid ${t.var.color.border};
}`;
'''
      }
    },
    {
      id: "dialog_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const variant = c.props?.variant || "danger";

const iconConfig = {
  danger: {
    icon: "carbon:warning-filled",
    color: t.var.color.error
  },
  warning: {
    icon: "carbon:warning-alt-filled",
    color: t.var.color.warning
  },
  primary: {
    icon: "carbon:help-filled",
    color: t.var.color.primary
  }
};

const config = iconConfig[variant] || iconConfig.danger;

return {
  as: "icon",
  icon: config.icon,
  width: 24,
  height: 24
};
''',
        css: '''
const variant = c.props?.variant || "danger";

const iconConfig = {
  danger: t.var.color.error,
  warning: t.var.color.warning,
  primary: t.var.color.primary
};

const iconColor = iconConfig[variant] || iconConfig.danger;

return `._id {
  color: ${iconColor};
  margin-bottom: ${t.var.spacing.sm};
  display: block;
}`;
'''
      }
    },
    {
      id: "dialog_title",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const title = c.props?.title || "Confirm Action";

return {
  as: "h2",
  text: title
};
''',
        css: '''
return `._id {
  font-size: 1.25rem;
  font-weight: 600;
  color: ${t.var.color.text};
  margin: 0;
  line-height: 1.4;
}`;
'''
      }
    },
    {
      id: "dialog_body",
      L: "Attr",
      P: {
        displayOrder: 2,
