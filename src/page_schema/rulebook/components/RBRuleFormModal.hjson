{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "RBRuleFormModal"
      }
    },
    {
      id: "variant_on_save",
      L: "ComponentVariant",
      P: {
        key: "onSave",
        type: "function",
        defValue: null
      }
    },
    {
      id: "variant_on_delete",
      L: "ComponentVariant",
      P: {
        key: "onDelete",
        type: "function",
        defValue: null
