    {
      id: "delete_button",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RBButton",
        props: '''
return {
  text: f.isSubmitting() ? "Deleting..." : "🗑️ Delete Rule",
  type: "button",
  variant: "danger",
  loading: f.isSubmitting(),
  disabled: f.isSubmitting(),
