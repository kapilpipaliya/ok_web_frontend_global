    {
      id: "modal_overlay",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
// Form state management
const [isSubmitting, setIsSubmitting] = _.createSignal(false);
const [formData, setFormData] = _.createStore({
  title: "",
  description: "",
  categoryId: "",
  frequency: "daily",
  priority: "medium",
  difficulty: "3",
  reminderTime: ""
});

// Categories state
const [categories, setCategories] = _.createSignal([]);
const [categoriesLoading, setCategoriesLoading] = _.createSignal(true);

// Load categories
const loadCategories = async () => {
  setCategoriesLoading(true);
  try {
    const result = await s({
      functionName: "getCategories",
      contextData: {}
    });

    if (result.error) {
      throw new Error(result.error);
    }

    if (result.result?.success) {
      const categoriesData = result.result.data.categories || [];
      setCategories(categoriesData);
    } else {
      throw new Error(result.result?.message || "Failed to load categories");
    }
  } catch (err) {
    console.error("Error loading categories:", err);
    _.showErrorToast("Failed to load categories. Please try again.");
    setCategories([]);
  } finally {
    setCategoriesLoading(false);
  }
};

// Initialize form data based on props
const initializeFormData = () => {
  const ruleData = c.props?.ruleData;
  const mode = c.props?.mode || "create";

  if (mode === "edit" && ruleData) {
    setFormData({
      title: ruleData.P?.title || "",
      description: ruleData.P?.description || "",
      categoryId: ruleData.P?.categoryId || "",
      frequency: ruleData.P?.frequency || "daily",
      priority: ruleData.P?.priority || "medium",
      difficulty: String(ruleData.P?.difficulty || 3),
      reminderTime: ruleData.P?.reminderTime || ""
    });
  } else {
    // For create mode, check if category is pre-selected
    const preSelectedCategoryId = ruleData?.categoryId || "";

    setFormData({
      title: "",
      description: "",
      categoryId: preSelectedCategoryId,
      frequency: "daily",
      priority: "medium",
      difficulty: "3",
      reminderTime: ""
    });
  }
};

// Handle form submission
const handleSave = async () => {
  const data = formData;
  const mode = c.props?.mode || "create";
  const ruleData = c.props?.ruleData;
  const onSaveCallback = c.props?.onSave;
  const onClose = c.props?.onClose || (() => {});

  // Validate required fields
  if (!data.title.trim()) {
    _.showErrorToast("Rule title is required");
    return;
  }

  if (!data.categoryId) {
    _.showErrorToast("Category is required");
    return;
  }

  setIsSubmitting(true);

  try {
    // Prepare context data for server function
    const contextData = {
      title: data.title.trim(),
      description: data.description.trim() || null,
      categoryId: data.categoryId,
      frequency: data.frequency,
      priority: data.priority,
      difficulty: parseInt(data.difficulty),
      reminderTime: data.reminderTime || null
    };

    // Add ruleId for edit mode
    if (mode === "edit" && ruleData) {
      contextData.ruleId = ruleData.id;
    }

    // Call the saveRule server function
    const result = await s({
      functionName: "saveRule",
      contextData
    });

    if (result.error) {
      _.showErrorToast(result.error);
    } else if (result.result && result.result.success) {
      _.showSuccessToast(result.result.message);

      // Call parent callback if provided
      if (onSaveCallback) {
        onSaveCallback({
          mode,
          data: contextData,
          result: result.result.data
        });
      }

      onClose();
    } else {
      _.showErrorToast(result.result?.message || "Failed to save rule");
    }
  } catch (error) {
    console.error("Error saving rule:", error);
    _.showErrorToast("An error occurred while saving the rule. Please try again.");
  } finally {
    setIsSubmitting(false);
  }
};

// Handle delete
const handleDelete = async () => {
  const mode = c.props?.mode || "create";
  const ruleData = c.props?.ruleData;
  const onDeleteCallback = c.props?.onDelete;
  const onClose = c.props?.onClose || (() => {});

  if (mode !== "edit" || !ruleData) {
    return;
  }

  setIsSubmitting(true);

  try {
    // Call the deleteRule server function
    const result = await s({
      functionName: "deleteRule",
      contextData: {
        ruleId: ruleData.id
      }
    });

    if (result.error) {
      _.showErrorToast(result.error);
    } else if (result.result && result.result.success) {
      _.showSuccessToast(result.result.message);

      // Call parent callback if provided
      if (onDeleteCallback) {
        onDeleteCallback({
          ruleId: ruleData.id,
          ruleData,
          result: result.result.data
        });
      }

      onClose();
    } else {
      _.showErrorToast(result.result?.message || "Failed to delete rule");
    }
  } catch (error) {
    console.error("Error deleting rule:", error);
    _.showErrorToast("An error occurred while deleting the rule. Please try again.");
  } finally {
    setIsSubmitting(false);
  }
};

// Update form field
const updateField = (field, value) => {
  setFormData(field, value);
};

return {
  isSubmitting,
  formData,
  handleSave,
  handleDelete,
  updateField,
  categories,
  categoriesLoading,
  initializeFormData,
  loadCategories
};
''',
        props: '''
const isOpen = c.props?.isOpen || false;
const mode = c.props?.mode || "create"; // "create" or "edit"
const ruleData = c.props?.ruleData;
const onClose = c.props?.onClose || (() => {});

return {
  as: "div",
  hide: !isOpen,
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      onClose();
    }
  },
  onMount: () => {
    f.initializeFormData();
    f.loadCategories();
  }
};
''',
        css: '''
