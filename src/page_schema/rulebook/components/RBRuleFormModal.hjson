  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: ${t.var.spacing.md};
  animation: fadeIn 300ms ease;
}

@media (max-width: 768px) {
  ._id {
    padding: 0;
    align-items: flex-end;
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}`;
'''
