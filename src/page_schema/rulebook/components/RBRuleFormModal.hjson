      P: {
        displayOrder: 2,
        componentName: "RBButton",
        props: '''
const mode = c.props?.mode || "create";
const isSubmitting = f.isSubmitting();

const buttonText = isSubmitting
  ? (mode === "edit" ? "Saving..." : "Creating...")
  : (mode === "edit" ? "Save Changes" : "Create Rule");

return {
  text: buttonText,
  type: "submit",
  variant: "primary",
  fullWidth: true,
  loading: isSubmitting,
  disabled: isSubmitting,
  onClick: (e) => {
    e.preventDefault();
    f.handleSave();
  }
};
''',
        css: '''
return `._id {
  flex: 1;
}`;
'''
