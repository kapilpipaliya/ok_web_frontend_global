return {
  as: "icon",
  icon: rightIcon,
  width: iconSize,
  height: iconSize,
  hide: !rightIcon
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.muted};
  flex-shrink: 0;
  margin-left: ${args.theme.var.spacing.sm};
  margin-right: ${args.theme.var.spacing.md};
}`;
'''
      }
