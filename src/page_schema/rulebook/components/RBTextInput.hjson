    {
      id: "input_wrapper",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
const hasLeftIcon = !!args.contextData.props?.leftIcon;
const hasRightIcon = !!args.contextData.props?.rightIcon;
const iconSize = args.contextData.props?.iconSize || 20;

return `._id {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  border: 1px solid ${args.theme.var.color.border};
  border-radius: ${args.theme.var.borderRadius.sm};
  background: ${args.theme.var.color.background};
  transition: all ${args.theme.var.animation.fast} ease;
  min-height: ${args.theme.var.touch.input};

  &:focus-within {
    border-color: ${args.theme.var.color.primary};
    box-shadow: 0 0 0 3px ${args.theme.var.color.primary_light_200};
  }

  &:hover:not(:focus-within) {
    border-color: ${args.theme.var.color.border_dark_200};
  }

  &.disabled {
    background: ${args.theme.var.color.background_light_100};
    opacity: 0.6;
    cursor: not-allowed;
  }
}`;
'''
      }
    },
    {
      id: "left_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const leftIcon = args.contextData.props?.leftIcon;
const iconSize = args.contextData.props?.iconSize || 20;

return {
  as: "icon",
  icon: leftIcon,
  width: iconSize,
  height: iconSize,
  hide: !leftIcon
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.muted};
  flex-shrink: 0;
  margin-left: ${args.theme.var.spacing.md};
  margin-right: ${args.theme.var.spacing.sm};
}`;
'''
      }
    },
    {
      id: "input_element",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "input",
  type: args.contextData.props?.type || "text",
  value: args.contextData.props?.value || "",
  placeholder: args.contextData.props?.placeholder || "",
  required: args.contextData.props?.required || false,
  disabled: args.contextData.props?.disabled || false,
  // readOnly: args.contextData.props?.readOnly || false, // not work on server
  maxLength: args.contextData.props?.maxLength || undefined,
  minLength: args.contextData.props?.minLength || undefined,
  autoFocus: args.contextData.props?.autoFocus || false,
  onChange: args.contextData.props?.onChange || null,
  onBlur: args.contextData.props?.onBlur || null,
  onFocus: args.contextData.props?.onFocus || null,
  onInput: args.contextData.props?.onInput || null
};
''',
        css: '''
const hasLeftIcon = !!args.contextData.props?.leftIcon;
const hasRightIcon = !!args.contextData.props?.rightIcon;

return `._id {
  flex: 1;
  width: 100%;
  padding: ${args.theme.var.spacing.sm} ${hasRightIcon ? '0' : args.theme.var.spacing.md} ${args.theme.var.spacing.sm} ${hasLeftIcon ? '0' : args.theme.var.spacing.md};
  border: none;
  outline: none;
  font-size: ${args.theme.var.fontSize.md};
  background: transparent;
  color: ${args.theme.var.color.text};
  line-height: 1.5;

  &::placeholder {
    color: ${args.theme.var.color.muted};
    opacity: 1;
  }

  &:disabled {
    cursor: not-allowed;
  }
}`;
'''
      }
    },
    {
      id: "right_icon",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
