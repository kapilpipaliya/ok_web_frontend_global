    {
      id: "textarea_element",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "textarea",
  value: c.props?.value || "",
  placeholder: c.props?.placeholder || "",
  required: c.props?.required || false,
  disabled: c.props?.disabled || false,
  readOnly: c.props?.readOnly || false,
  rows: c.props?.rows || 4,
  cols: c.props?.cols || undefined,
  maxLength: c.props?.maxLength || undefined,
  minLength: c.props?.minLength || undefined,
  autoFocus: c.props?.autoFocus || false,
  onChange: c.props?.onChange || null,
  onBlur: c.props?.onBlur || null,
  onFocus: c.props?.onFocus || null
};
''',
        css: '''
const resize = c.props?.resize || "vertical";

return `._id {
  width: 100%;
  padding: ${t.var.spacing.sm} ${t.var.spacing.md};
  border: 1px solid ${t.var.color.border};
  border-radius: ${t.var.borderRadius.sm};
  font-size: 1rem;
  background: ${t.var.color.background};
  color: ${t.var.color.text};
  transition: all 150ms ease;
  line-height: 1.6;
  font-family: inherit;
  resize: ${resize};
  min-height: calc(52px * 2);

  &:focus {
    outline: none;
    border-color: ${t.var.color.primary};
    box-shadow: 0 0 0 3px ${t.var.color.primary_light_200};
  }

  &:hover:not(:disabled):not(:focus) {
    border-color: ${t.var.color.border_dark_200};
  }

  &:disabled {
    background: ${t.var.color.background_light_100};
    opacity: 0.6;
    cursor: not-allowed;
    resize: none;
  }

  &:read-only {
    background: ${t.var.color.background_light_50};
    cursor: default;
  }

  &::placeholder {
    color: ${t.var.color.text_light_500};
    opacity: 1;
  }

  /* Mobile responsive adjustments */
  @media (max-width: 768px) {
    padding: ${t.var.spacing.sm} ${t.var.spacing.md};
    font-size: 1rem;
    resize: vertical;
  }
}`;
'''
      }
