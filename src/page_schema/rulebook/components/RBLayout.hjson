{
  vertexes: [
    {
      id: "layout_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RBConfirmProvider"
      }
    },
    {
      id: "favicon_link",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "link",
  rel: "icon",
  href: "/api/file/downloadCompanyFavicon"
};
'''
      }
    },
    {
      id: "layout_wrapper",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        fns: '''
// Define navigation items for both desktop and mobile menus
const navigationSections = [
  {
    id: "main",
    title: null, // No title for main section
    items: [
      {
        id: "home",
        href: "/rb",
        label: "Home",
        icon: "carbon:home",
        title: "Dashboard and overview",
        pathCheck: (pathname) => pathname === "/rb" || pathname === "/rb/"
      },
      {
        id: "track",
        href: "/rb/tracking",
        label: "Track",
        icon: "carbon:add-alt",
        title: "Daily habit tracking",
        pathCheck: (pathname) => pathname.startsWith("/rb/tracking")
      }
    ]
  },
  {
    id: "management",
    title: "Management",
    items: [
      {
        id: "rules",
        href: "/rb/rules",
        label: "Rules",
        icon: "carbon:list-checked",
        title: "View and manage all rules",
        pathCheck: (pathname) => pathname.startsWith("/rb/rules")
      },
      {
        id: "categories",
        href: "/rb/categories",
        label: "Categories",
        icon: "carbon:category",
        title: "Organize rules by category",
        pathCheck: (pathname) => pathname.startsWith("/rb/categories")
      },
      {
        id: "goals",
        href: "/rb/goals",
        label: "Goals",
        icon: "carbon:trophy",
        title: "Set and track achievement goals",
        pathCheck: (pathname) => pathname.startsWith("/rb/goals")
      }
    ]
  },
  {
    id: "insights",
    title: "Insights",
    items: [
      {
        id: "reports",
        href: "/rb/reports",
        label: "Reports",
        icon: "carbon:analytics",
        title: "View progress analytics and statistics",
        pathCheck: (pathname) => pathname.startsWith("/rb/reports")
      }
    ]
  },
  {
    id: "other",
    title: null, // No title for other section
    hasBorder: true,
    items: [
      {
        id: "settings",
        href: "/rb/settings",
        label: "Settings",
        icon: "carbon:settings",
        title: "App configuration and preferences",
        pathCheck: (pathname) => pathname.startsWith("/rb/settings")
      },
      {
        id: "logout",
        href: "/auth/logout",
        label: "Logout",
        icon: "carbon:logout",
        title: "Sign out of your account",
        isButton: true,
        isDanger: true
      }
    ]
  }
];

// Define mobile navigation items (subset of desktop items)
const mobileNavigationItems = [
  {
    id: "home",
    href: "/rb",
    label: "Home",
    icon: "carbon:home",
    title: "Dashboard and overview",
    pathCheck: (pathname) => pathname === "/rb" || pathname === "/rb/"
  },
  {
    id: "goals",
    href: "/rb/goals",
    label: "Goals",
    icon: "carbon:trophy",
    title: "Set and track achievement goals",
    pathCheck: (pathname) => pathname.startsWith("/rb/goals")
  },
  {
    id: "track",
    href: "/rb/tracking",
    label: "Track",
    icon: "carbon:add-alt",
    title: "Daily habit tracking",
    pathCheck: (pathname) => pathname.startsWith("/rb/tracking")
  },
  {
    id: "reports",
    href: "/rb/reports",
    label: "Reports",
    icon: "carbon:analytics",
    title: "View progress analytics and statistics",
    pathCheck: (pathname) => pathname.startsWith("/rb/reports")
  },
  {
    id: "settings",
    href: "/rb/settings",
    label: "Settings",
    icon: "carbon:settings",
    title: "App configuration and preferences",
    pathCheck: (pathname) => pathname.startsWith("/rb/settings")
  }
];

return {
  navigationSections,
  mobileNavigationItems
};
''',
        props: '''
return {
  as: "div"
};
'''
      }
    },
    {
      id: "layout_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: ${t.var.color.background};
  color: ${t.var.color.text};
}

@media (min-width: 768px) {
  ._id {
    flex-direction: row;
  }
}`;
'''
      }
    },
    {
      id: "main_content",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "main"
};
''',
        css: '''
return `._id {
  flex: 1;
  padding-bottom: 80px;
  overflow-y: auto;
  position: relative;
}

@media (min-width: 768px) {
  ._id {
    padding-bottom: 0;
    margin-left: 240px;
  }
}`;
'''
      }
    },
    {
      id: "slot_main",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Slot",
        slot: "1children"
      }
    },
    {
      id: "navigation_overlay",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
// Get navigation state from RBConfirmProvider context
// This controls when the overlay should be visible
const isNavigating = f.isNavigating?.();

return {
  as: "div",
  style: {
    // Show overlay during navigation, hide when complete
    // Uses flex to center the loading spinner
    display: isNavigating ? 'flex' : 'none'
  }
};
''',
        css: '''
return `._id {
  /* Full-screen overlay positioning */
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;

  /* Match theme background for seamless appearance */
  background: ${t.var.color.background};

  /* Position spinner at top instead of center */
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: ${t.var.spacing.xxl};

  /* High z-index to appear above all content */
  z-index: 1;

  /* Start invisible and fade in smoothly */
  opacity: 0;
  animation: fadeIn 0.2s ease-out forwards;
}

/* Smooth fade-in animation for overlay appearance */
@keyframes fadeIn {
  to {
    opacity: 1;
  }
}`;
'''
      }
    },
    {
      id: "navigation_spinner",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RBLoadingSpinner",
        props: '''
return {
  size: "medium",
  color: "primary"
};
'''
      }
    },
    {
      id: "left_nav",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "nav"
};
''',
        css: '''
return `._id {
  display: none;
}

@media (min-width: 768px) {
  ._id {
    display: flex;
    position: fixed;
    top: 0;
    left: 0;
    width: 240px;
    height: 100vh;
    background: ${t.var.color.background};
    border-right: 1px solid ${t.var.color.border};
    flex-direction: column;
    padding: ${t.var.spacing.xl} ${t.var.spacing.lg};
    z-index: 1;
    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.1);
  }
}`;
'''
      }
    },
    {
      id: "left_nav_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  margin-bottom: ${t.var.spacing.xl};
  padding-bottom: ${t.var.spacing.lg};
  border-bottom: 1px solid ${t.var.color.border};
}`;
'''
      }
    },
    {
      id: "left_nav_logo",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: "📝 Rulebook"
};
''',
        css: '''
return `._id {
  font-size: 1.25rem;
  font-weight: 700;
  color: ${t.var.color.text};
  margin: 0;
  display: flex;
  align-items: center;
  gap: ${t.var.spacing.sm};
}`;
'''
      }
    },
    {
      id: "left_nav_menu",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: ${t.var.spacing.lg};
}`;
'''
      }
    },
    {
      id: "nav_sections_loop",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "navSection",
        loop: true,
        props: '''
const sections = f.navigationSections;
return {
  as: "div",
  data: sections
};
''',
        css: '''
return `._id {
  display: contents;
}`;
'''
      }
    },
    {
      id: "nav_section",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const section = c.navSection;
const hasBorder = section.hasBorder;
return {
  as: "div"
};
'''
      }
    },
    {
      id: "nav_section_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const section = c.navSection;
const title = section.title;
return {
  as: "h3",
  text: title,
  hide: !title
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  font-weight: 600;
  color: ${t.var.color.text_light_500};
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin: 0 0 ${t.var.spacing.sm} 0;
  padding: 0 ${t.var.spacing.md};
}`;
'''
      }
    },
    {
      id: "nav_section_list",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const section = c.navSection;
return {
  as: "ul"
};
''',
        css: '''
const section = c.navSection;
const hasBorder = section.hasBorder;
return `._id {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: ${t.var.spacing.xs};
  ${hasBorder ? `padding-top: ${t.var.spacing.md}; border-top: 1px solid ${t.var.color.border};` : ''}
}`;
'''
      }
    },
    {
      id: "nav_items_loop",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "navItem",
        loop: true,
        props: '''
const section = c.navSection;
const items = section.items;
return {
  as: "li",
  data: items
};
''',
        css: '''
return `._id {
  margin: 0;
}`;
'''
      }
    },
    {
      id: "nav_item_link",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = c.navItem;
const isActive = item.pathCheck ? item.pathCheck(_.location.pathname) : false;
const isButton = item.isButton;
const isDanger = item.isDanger;

return {
  as: isButton ? "button" : "a",
  href: !isButton ? item.href : undefined,
  "aria-label": item.label,
  title: item.title,
  onClick: (e) => {
    e.preventDefault();
    f.navigateTo?.(item.href);
  }
};
''',
        css: '''
const item = c.navItem;
const isActive = item.pathCheck ? item.pathCheck(_.location.pathname) : false;
const isButton = item.isButton;
const isDanger = item.isDanger;

return `._id {
  display: flex;
  align-items: center;
  gap: ${t.var.spacing.md};
  padding: ${t.var.spacing.sm} ${t.var.spacing.md};
  border-radius: ${t.var.borderRadius.md};
  background: ${isActive ? t.var.color.background_light_200 : 'transparent'};
  color: ${isDanger ? t.var.color.error : (isActive ? t.var.color.primary : t.var.color.text)};
  text-decoration: none;
  font-weight: ${isActive ? '600' : '500'};
  transition: all 150ms ease;
  ${isButton ? `
    border: none;
    font-size: inherit;
    font-family: inherit;
    cursor: pointer;
    width: 100%;
    text-align: left;
  ` : ''}

  &:hover {
    background: ${isDanger ? t.var.color.error_light_100 : t.var.color.background_light_200};
    color: ${isDanger ? t.var.color.error_dark_200 : t.var.color.primary};
  }
  
  ${isButton ? `
    &:active {
      transform: scale(0.98);
    }
  ` : ''}
}`;
'''
      }
    },
    {
      id: "nav_item_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = c.navItem;
return {
  as: "icon",
  icon: item.icon,
  width: 20,
  height: 20
};
'''
      }
    },
    {
      id: "nav_item_text",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const item = c.navItem;
return {
  as: "span",
  text: item.label
};
'''
      }
    },
    {
      id: "bottom_nav",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "nav"
};
''',
        css: '''
return `._id {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 72px;
  background: ${t.var.color.background};
  border-top: 1px solid ${t.var.color.border};
  z-index: 1;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.1);
  padding: ${t.var.spacing.sm} 0;
}

._id .slider-container {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 ${t.var.spacing.sm};
  width: 100%;
}

/* Make each nav item equally distributed */
._id .slider-container > * {
  flex: 1;
  display: flex;
  justify-content: center;
  min-width: 0;
}

/* Responsive adjustment - hide on desktop */
@media (min-width: 768px) {
  ._id {
    display: none;
  }
}`;
'''
      }
    },
    {
      id: "nav_slider_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  className: "slider-container"
};
'''
      }
    },
    {
      id: "mobile_nav_loop",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "mobileNavItem",
        loop: true,
        props: '''
const items = f.mobileNavigationItems;
return {
  as: "div",
  data: items
};
''',
        css: '''
return `._id {
  display: contents;
}`;
'''
      }
    },
    {
      id: "mobile_nav_item",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = c.mobileNavItem;
const isActive = item.pathCheck ? item.pathCheck(_.location.pathname) : false;

return {
  as: "a",
  href: item.href,
  "aria-label": item.label,
  title: item.title,
  onClick: (e) => {
    e.preventDefault();
    f.navigateTo?.(item.href);
  }
};
''',
        css: '''
const item = c.mobileNavItem;
const isActive = item.pathCheck ? item.pathCheck(_.location.pathname) : false;

return `._id {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: ${t.var.spacing.xs};
  padding: ${t.var.spacing.xs};
  border-radius: ${t.var.borderRadius.sm};
  background: none;
  text-decoration: none;
  cursor: pointer;
  min-height: 44px;
  color: ${isActive ? t.var.color.primary : t.var.color.text_light_500};
  transition: all 150ms ease;
  width: 100%;
  position: relative;

  &:hover {
    background: ${t.var.color.background_light_200};
    color: ${t.var.color.primary};
  }

  &:active {
    transform: scale(0.95);
  }
}`;
'''
      }
    },
    {
      id: "mobile_nav_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = c.mobileNavItem;
const iconSize = item.iconSize || 24;
return {
  as: "icon",
  icon: item.icon,
  width: iconSize,
  height: iconSize
};
'''
      }
    },
    {
      id: "mobile_nav_text",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const item = c.mobileNavItem;
return {
  as: "span",
  text: item.label
};
''',
        css: '''
return `._id {
  font-size: 0.75rem;
  font-weight: 500;
  text-align: center;
}`;
'''
      }
    },
  ],
  edges: [
    { id: "e0", T: "Attr", S: "layout_root", E: "favicon_link" },
    { id: "e0a", T: "Attr", S: "layout_root", E: "layout_wrapper" },
