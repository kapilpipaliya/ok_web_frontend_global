{
  vertexes: [
    {
      id: "layout_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RBConfirmProvider",
      }
    },
    {
      id: "layout_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
}

@media (min-width: 768px) {
  ._id {
    flex-direction: row;
  }
}`;
'''
      }
    },
    {
      id: "main_content",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "main"
};
''',
        css: '''
return `._id {
  flex: 1;
  padding-bottom: 80px;
  overflow-y: auto;
  position: relative;
}

@media (min-width: 768px) {
  ._id {
    padding-bottom: 0;
    margin-left: 240px;
  }
}`;
'''
      }
    },
    {
      id: "slot_main",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Slot",
        slot: "1children"
      }
    },
    {
      id: "navigation_overlay",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
// Get navigation state from RBConfirmProvider context
// This controls when the overlay should be visible
const isNavigating = args.fns.isNavigating?.();

return {
  as: "div",
  style: {
    // Show overlay during navigation, hide when complete
    // Uses flex to center the loading spinner
    display: isNavigating ? 'flex' : 'none'
  }
};
''',
        css: '''
return `._id {
  /* Full-screen overlay positioning */
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;

  /* Match theme background for seamless appearance */
  background: ${args.theme.var.color.background};

  /* Position spinner at top instead of center */
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: ${args.theme.var.spacing.xxl};

  /* High z-index to appear above all content */
  z-index: 1000;

  /* Start invisible and fade in smoothly */
  opacity: 0;
  animation: fadeIn 0.2s ease-out forwards;
}

/* Smooth fade-in animation for overlay appearance */
@keyframes fadeIn {
  to {
    opacity: 1;
  }
}`;
'''
      }
    },
    {
      id: "navigation_spinner",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RBLoadingSpinner",
        props: '''
return {
  size: "medium",
  color: "primary"
};
'''
      }
    },
    {
      id: "left_nav",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "nav"
};
''',
        css: '''
return `._id {
  display: none;
}

@media (min-width: 768px) {
  ._id {
    display: flex;
    position: fixed;
    top: 0;
    left: 0;
    width: 240px;
    height: 100vh;
    background: ${args.theme.var.color.background};
    border-right: 1px solid ${args.theme.var.color.border};
    flex-direction: column;
    padding: ${args.theme.var.spacing.xl} ${args.theme.var.spacing.lg};
    z-index: ${args.theme.var.zIndex.dropdown};
    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.1);
  }
}`;
'''
      }
    },
    {
      id: "left_nav_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
