{
  vertexes: [
    {
      id: "get_rules_by_category_function",
      L: "Function",
      P: {
        key: "getRulesByCategory",
        description: "Retrieves all rules for a specific category with tracking data and statistics",
        body: '''
try {
  // Extract input parameters from the request
  const { categoryId } = c;

  // Validate required fields
  if (!categoryId) {
    throw new Error("Category ID is required");
  }

  // Get current authenticated user from session
  const user = await _.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // First verify the category exists and belongs to user
  const categoryCheckQuery = `
    MATCH (u:User {uuid: $userUuid})-[:UserRuleCategory]->(rc:RuleCategory)
    WHERE elementId(rc) = $categoryId
    RETURN rc
  `;

  const categoryResult = await _.session.run(categoryCheckQuery, {
    userUuid: user.P.uuid,
    categoryId
  });

  if (categoryResult.records.length === 0) {
    throw new Error("Category not found or does not belong to user");
  }

  // Query to get all rules for this category with tracking data
  const rulesQuery = `
    MATCH (u:User {uuid: $userUuid})-[:UserRuleCategory]->(rc:RuleCategory)
    WHERE elementId(rc) = $categoryId
    MATCH (rc)<-[:RuleCategory]-(r:Rule)<-[:UserRule]-(u)
    OPTIONAL MATCH (r)-[:RuleTracking]->(rt:RuleTracking)
    OPTIONAL MATCH (r)-[:RuleGoal]->(rg:RuleGoal)
    OPTIONAL MATCH (r)-[:RuleStreak]->(rs:RuleStreak)
    WITH r,
         collect(DISTINCT rt) as trackingRecords,
         collect(DISTINCT rg) as goals,
         collect(DISTINCT rs) as streaks
    RETURN r,
           trackingRecords,
           goals,
           streaks,
           size(trackingRecords) as trackingCount,
           size(goals) as goalCount,
           size(streaks) as streakCount
    ORDER BY r.displayOrder ASC, r.createdAt ASC
  `;

  const rulesResult = await _.session.run(rulesQuery, {
    userUuid: user.P.uuid,
    categoryId
  });

  // Format the results
  const rules = rulesResult.records.map(record => {
    const ruleNode = record.get('r');
    const trackingRecords = record.get('trackingRecords') || [];
    const goals = record.get('goals') || [];
    const streaks = record.get('streaks') || [];
    const trackingCount = _.neo4jConvert.js(record.get('trackingCount')) || 0;
    const goalCount = _.neo4jConvert.js(record.get('goalCount')) || 0;
    const streakCount = _.neo4jConvert.js(record.get('streakCount')) || 0;

    // Convert Neo4j node to proper Vertex format
    const rule = _.convertNodeToJson(ruleNode);

    // Calculate completion stats (example logic - can be enhanced)
    const completionRate = trackingCount > 0 ? Math.min(100, (trackingCount / 30) * 100) : 0;
    const bestStreak = streaks.length > 0 ?
      Math.max(...streaks.map(s => _.convertNodeToJson(s).P.currentStreak || 0)) : 0;

    return {
      rule,
      tracking: {
        records: trackingRecords.map(t => _.convertNodeToJson(t)),
        count: trackingCount
      },
      goals: {
        records: goals.map(g => _.convertNodeToJson(g)),
        count: goalCount
      },
      streaks: {
        records: streaks.map(s => _.convertNodeToJson(s)),
        count: streakCount,
        best: bestStreak
      },
      stats: {
        completionRate: Math.round(completionRate),
        bestStreak,
        totalTracking: trackingCount,
        totalGoals: goalCount,
        isActive: rule.P.isActive !== false
      }
    };
  });

  return {
    success: true,
    message: `Found ${rules.length} rules for category`,
    data: {
      rules,
      total: rules.length,
      categoryId,
      userId: user.P.uuid
    }
  };

} catch (error) {
  console.error("Error fetching rules by category:", error);

  // Handle specific errors
  let userMessage = "Failed to load rules. Please try again.";

  if (error.message.includes("Category ID is required")) {
    userMessage = "Category ID is required to fetch rules.";
  } else if (error.message.includes("Category not found")) {
    userMessage = "The specified category was not found or does not belong to you.";
  } else if (error.message.includes("User session not found")) {
    userMessage = "Your session has expired. Please log in and try again.";
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please contact support if this persists.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "RulesFetchError",
      details: error.message,
      code: error.code || null
    }
  };
}
'''
      }
    }
  ],
  edges: []
}