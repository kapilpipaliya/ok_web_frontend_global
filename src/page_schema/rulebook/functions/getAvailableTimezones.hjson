{
  vertexes: [
    {
      id: "get_available_timezones_function",
      L: "Function",
      P: {
        key: "getAvailableTimezones",
        description: "Fetches available timezones from the timeapi.io API and formats them for display",
        body: '''
try {
  // Get current authenticated user from session
  const user = await _.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Fetch available timezones from the API
  const response = await fetch('https://timeapi.io/api/timezone/availabletimezones', {
    method: 'GET',
    headers: {
      'accept': 'application/json'
    }
  });

  if (!response.ok) {
    throw new Error(`Failed to fetch timezones: ${response.status} ${response.statusText}`);
  }

  const timezones = await response.json();

  // Process all timezones from API
  const processedTimezones = timezones
    .filter(timezone => timezone.includes('/') || timezone === 'UTC')
    .map(timezone => ({
      value: timezone,
      label: timezone.replace(/_/g, ' ')
    }))
    .sort((a, b) => a.label.localeCompare(b.label));

  // Get user's current timezone from database
  const getUserQuery = `
    MATCH (u:User {uuid: $userUuid})
    RETURN u.timeZone as timeZone
  `;

  const getUserResult = await _.session.run(getUserQuery, {
    userUuid: user.P.uuid
  });

  const currentTimezone = getUserResult.records.length > 0
    ? getUserResult.records[0].get('timeZone') || 'UTC'
    : 'UTC';

  // Try to detect browser timezone (this will be done on frontend)
  // For now, we'll just return the data structure

  return {
    success: true,
    message: "Timezones fetched successfully",
    data: {
      currentTimezone,
      allTimezones: processedTimezones,
      totalCount: processedTimezones.length
    }
  };

} catch (error) {
  let userMessage = "Failed to fetch available timezones. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Your session has expired. Please log in and try again.";
  } else if (error.message.includes("Failed to fetch timezones")) {
    userMessage = "Unable to fetch timezone data. Please check your internet connection.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "TimezoneFetchError",
      details: error.message,
      code: error.code || null
    }
  };
}
'''
      }
    }
  ],
  edges: []
}