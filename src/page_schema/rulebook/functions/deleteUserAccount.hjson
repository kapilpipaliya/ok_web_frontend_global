{
  vertexes: [
    {
      id: "delete_user_account_function",
      L: "Function",
      P: {
        key: "deleteUserAccount",
        description: "Permanently deletes the user account and all associated data across the entire system",
        body: '''
try {
  // Extract confirmation parameter
  const { confirmed } = args.contextData;

  if (!confirmed) {
    throw new Error("Account deletion must be confirmed by setting confirmed: true");
  }

  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Get comprehensive count of all user data across the system
  const countQuery = `
    MATCH (u:User {uuid: $userUuid})
    OPTIONAL MATCH (u)-[:UserRuleCategory]->(rc:RuleCategory)
    OPTIONAL MATCH (u)-[:UserRule]->(r:Rule)
    OPTIONAL MATCH (r)-[:RuleTracking]->(rt:RuleTracking)
    OPTIONAL MATCH (r)-[:RuleGoal]->(rg:RuleGoal)
    OPTIONAL MATCH (r)-[:RuleStreak]->(rs:RuleStreak)
    OPTIONAL MATCH (u)-[]->(other) WHERE NOT other:RuleCategory AND NOT other:Rule AND NOT other:RuleTracking AND NOT other:RuleGoal AND NOT other:RuleStreak
    RETURN count(DISTINCT rc) as categoryCount,
           count(DISTINCT r) as ruleCount,
           count(DISTINCT rt) as trackingCount,
           count(DISTINCT rg) as goalCount,
           count(DISTINCT rs) as streakCount,
           count(DISTINCT other) as otherDataCount,
           u.email as userEmail,
           u.name as userName
  `;

  const countResult = await args.session.run(countQuery, {
    userUuid: user.P.uuid
  });

  const counts = countResult.records[0];
  const categoryCount = args.neo4jConvert.js(counts.get('categoryCount')) || 0;
  const ruleCount = args.neo4jConvert.js(counts.get('ruleCount')) || 0;
  const trackingCount = args.neo4jConvert.js(counts.get('trackingCount')) || 0;
  const goalCount = args.neo4jConvert.js(counts.get('goalCount')) || 0;
  const streakCount = args.neo4jConvert.js(counts.get('streakCount')) || 0;
  const otherDataCount = args.neo4jConvert.js(counts.get('otherDataCount')) || 0;
  const userEmail = counts.get('userEmail');
  const userName = counts.get('userName');

  const totalItems = categoryCount + ruleCount + trackingCount + goalCount + streakCount + otherDataCount;

  // Start transaction for atomic deletion
  const tx = args.session.beginTransaction();

  try {
    // Step 1: Delete all rulebook-specific data first
    if (goalCount > 0) {
      const deleteGoalsQuery = `
        MATCH (u:User {uuid: $userUuid})-[:UserRule]->(r:Rule)-[:RuleGoal]->(rg:RuleGoal)
        DETACH DELETE rg
      `;
      await tx.run(deleteGoalsQuery, { userUuid: user.P.uuid });
    }

    if (trackingCount > 0) {
      const deleteTrackingQuery = `
        MATCH (u:User {uuid: $userUuid})-[:UserRule]->(r:Rule)-[:RuleTracking]->(rt:RuleTracking)
        DETACH DELETE rt
      `;
      await tx.run(deleteTrackingQuery, { userUuid: user.P.uuid });
    }

    if (streakCount > 0) {
      const deleteStreaksQuery = `
        MATCH (u:User {uuid: $userUuid})-[:UserRule]->(r:Rule)-[:RuleStreak]->(rs:RuleStreak)
        DETACH DELETE rs
      `;
      await tx.run(deleteStreaksQuery, { userUuid: user.P.uuid });
    }

    if (ruleCount > 0) {
      const deleteRulesQuery = `
        MATCH (u:User {uuid: $userUuid})-[:UserRule]->(r:Rule)
        DETACH DELETE r
      `;
      await tx.run(deleteRulesQuery, { userUuid: user.P.uuid });
    }

    if (categoryCount > 0) {
      const deleteCategoriesQuery = `
        MATCH (u:User {uuid: $userUuid})-[:UserRuleCategory]->(rc:RuleCategory)
        DETACH DELETE rc
      `;
      await tx.run(deleteCategoriesQuery, { userUuid: user.P.uuid });
    }

    // Step 2: Delete all other user-related data
    if (otherDataCount > 0) {
      const deleteOtherDataQuery = `
        MATCH (u:User {uuid: $userUuid})-[]->(data)
        WHERE NOT data:RuleCategory AND NOT data:Rule AND NOT data:RuleTracking AND NOT data:RuleGoal AND NOT data:RuleStreak
        DETACH DELETE data
      `;
      await tx.run(deleteOtherDataQuery, { userUuid: user.P.uuid });
    }

    // Step 3: Finally delete the user account itself
    const deleteUserQuery = `
      MATCH (u:User {uuid: $userUuid})
      DETACH DELETE u
    `;
    await tx.run(deleteUserQuery, { userUuid: user.P.uuid });

    // Commit the transaction
    await tx.commit();

    // Build comprehensive deletion summary
    const deletedItems = [];
    if (categoryCount > 0) deletedItems.push(`${categoryCount} categories`);
    if (ruleCount > 0) deletedItems.push(`${ruleCount} rules`);
    if (trackingCount > 0) deletedItems.push(`${trackingCount} tracking records`);
    if (goalCount > 0) deletedItems.push(`${goalCount} goals`);
    if (streakCount > 0) deletedItems.push(`${streakCount} streaks`);
    if (otherDataCount > 0) deletedItems.push(`${otherDataCount} other data items`);

    let message = `User account "${userName}" (${userEmail}) has been permanently deleted.`;
    if (deletedItems.length > 0) {
      message += ` Also deleted: ${deletedItems.join(', ')}.`;
    }

    return {
      success: true,
      message,
      data: {
        deletedUser: {
          uuid: user.P.uuid,
          email: userEmail,
          name: userName
        },
        deletedData: {
          categories: categoryCount,
          rules: ruleCount,
          tracking: trackingCount,
          goals: goalCount,
          streaks: streakCount,
          otherData: otherDataCount,
          total: totalItems + 1 // +1 for the user account itself
        }
      }
    };

  } catch (txError) {
    // Rollback the transaction on error
    await tx.rollback();
    throw txError;
  }

} catch (error) {
  console.error("Error deleting user account:", error);

  let userMessage = "Failed to delete user account. Please try again.";

  if (error.message.includes("must be confirmed")) {
    userMessage = "Account deletion must be confirmed. Please check the confirmation checkbox and try again.";
  } else if (error.message.includes("User session not found")) {
    userMessage = "Your session has expired. Please log in and try again.";
  } else if (error.message.includes("constraint")) {
    userMessage = "Cannot delete account due to database constraints. Please contact support.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "AccountDeletionError",
      details: error.message,
      code: error.code || null
    }
  };
}
'''
      }
    }
  ],
  edges: []
}