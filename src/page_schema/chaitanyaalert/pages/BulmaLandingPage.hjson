{
  vertexes: [
    {
      id: "page",
      L: "Page",
      P: {
        public: true,
        key: "ChaitanyaAlertBulmaLanding",
        url: "/landing",
        title: "Chaitanya Alert",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
const words = ["MOM", "DAD", "BOSS", "FAMILY", "THE GROUP"];
const [wordIndex, setWordIndex] = _.createSignal(0);
const [menuOpen, setMenuOpen] = _.createSignal(false);
const [openFaq, setOpenFaq] = _.createSignal(0);
let wordTimer = null;

const ensureStylesheet = (id, href) => {
  if (document.getElementById(id)) return;
  const link = document.createElement("link");
  link.id = id;
  link.rel = "stylesheet";
  link.href = href;
  document.head.appendChild(link);
};

return {
  words,
  wordIndex,
  currentWord: () => words[wordIndex()],
  menuOpen,
  openFaq,
  loadFonts: () => {
    ensureStylesheet(
      "ca-landing-fonts",
      "https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter+Tight:wght@400;500;600;700&display=swap"
    );
  },
  startWordCycle: () => {
    wordTimer = window.setInterval(() => {
      setWordIndex((i) => (i + 1) % words.length);
    }, 2200);
  },
  stopWordCycle: () => {
    if (wordTimer) {
      window.clearInterval(wordTimer);
      wordTimer = null;
    }
  },
  toggleMenu: () => setMenuOpen((v) => !v),
  closeMenu: () => setMenuOpen(false),
  toggleFaq: (index) => {
    setOpenFaq((current) => (current === index ? -1 : index));
  }
};
''',
        props: '''
return {
  as: "div",
  onMount: () => {
    f.loadFonts();
    f.startWordCycle();
  },
  onCleanup: () => {
    f.stopWordCycle();
  }
};
''',
        css: '''
return [
  `._id {
  min-height: 100vh;
  background: ${t.var.color.background_dark_900};
  color: ${t.var.color.background_light_900};
  font-family: "Inter Tight", system-ui, sans-serif;
  overflow-x: hidden;
}`,
  `@media (prefers-reduced-motion: reduce) {
  ._id *,
  ._id *::before,
  ._id *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}`
];
'''
      }
    },
    {
      id: "header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
