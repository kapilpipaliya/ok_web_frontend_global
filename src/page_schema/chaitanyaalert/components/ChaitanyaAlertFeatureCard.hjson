''',
        css: '''
return `._id {
  background: ${args.theme.var.color.background};
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 1rem;
  padding: 2rem;
  text-align: center;
  transition: all 0.3s ease;
  height: 100%;
  display: flex;
  flex-direction: column;
  
  &:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px ${args.theme.var.color.primary}20;
    border-color: ${args.theme.var.color.primary}50;
  }
  
  @media (max-width: 768px) {
    padding: 1.5rem;
  }
}`;
'''
