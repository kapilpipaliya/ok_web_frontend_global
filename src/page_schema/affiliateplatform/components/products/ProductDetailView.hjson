    {
      id: "11d"
      L: Attr
      P: {
        css:
          '''const option = args.contextData.optionValue || {};
const compatible =
  args.fns.isOptionCompatible?.(option.axisKey, option.value) !== false;
const selected = !!args.fns.isOptionSelected?.(option.axisKey, option.value);
const isColor = !!option.isColor;
return `._id {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: ${isColor ? "2.25rem" : "2.75rem"};
  min-height: 2.25rem;
  padding: ${isColor ? "0.2rem" : "0.45rem 0.8rem"};
  border-radius: ${isColor ? "999px" : "0.5rem"};
  border: 2px solid ${selected ? args.theme.var.color.primary : args.theme.var.color.border};
  background: ${selected ? args.theme.var.color.primary_light_100 : args.theme.var.color.background};
  color: ${compatible ? args.theme.var.color.text : args.theme.var.color.text_light_400};
  font-size: 0.875rem;
  font-weight: ${selected ? 700 : 500};
  line-height: 1.2;
  cursor: pointer;
  opacity: ${compatible ? 1 : 0.55};
  text-decoration: ${compatible ? "none" : "line-through"};
  transition: border-color 0.15s ease, background 0.15s ease, opacity 0.15s ease, transform 0.15s ease;

  &:hover {
    border-color: ${args.theme.var.color.primary};
    transform: translateY(-1px);
  }

  &:focus-visible {
    outline: 2px solid ${args.theme.var.color.primary};
    outline-offset: 2px;
  }

  ${!compatible ? `
  &::after {
    content: "";
    position: absolute;
    inset: 45% -8%;
    height: 1.5px;
    background: ${args.theme.var.color.text_light_400};
    transform: rotate(-28deg);
    pointer-events: none;
  }
  ` : ""}
}`;'''
        displayOrder: 1
        componentName: Html
        props:
