    margin: 0 0 0.75rem;
  }

  ul, ol {
    margin: 0 0 0.75rem 1.25rem;
  }

  a {
    color: ${args.theme.var.color.primary};
  }
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const items = Array.isArray(args.contextData.props?.items) ? args.contextData.props.items : [];
const startIndex = Math.max(0, Number(args.contextData.props?.startIndex) || 0);
const item = items[startIndex] || {};
return {
  as: "div",
  text: item.description || "",
  textType: "markdown",
  hide: !item.description
};'''
      }
    }
    {
      id: "14"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Button
        props:
          '''const items = Array.isArray(args.contextData.props?.items) ? args.contextData.props.items : [];
const startIndex = Math.max(0, Number(args.contextData.props?.startIndex) || 0);
const item = items[startIndex] || {};
const url = item.amazonUrl || "";
return {
  text: "View on Amazon",
  variant: "primary",
  hide: !url,
  onClick: () => {
    if (url) window.open(url, "_blank", "noopener,noreferrer");
  }
};'''
      }
    }
