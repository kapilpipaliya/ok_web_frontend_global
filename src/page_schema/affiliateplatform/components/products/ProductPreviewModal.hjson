{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        description: Product detail modal with markdown description and Amazon link. Props: isOpen, items, startIndex, onClose.
        key: ProductPreviewModal
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(4px);
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "motionFragment",
  hide: args.contextData.props?.isOpen !== true,
  onClick: (e) => {
    if (e.target === e.currentTarget) args.contextData.props?.onClose?.();
  }
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  width: 100%;
  max-width: 900px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  background: ${args.theme.var.color.background};
  border-radius: 0.75rem;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "motionFragment",
  role: "dialog",
  "aria-modal": "true"
};'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.875rem 1rem;
  border-bottom: 1px solid ${args.theme.var.color.border};
  flex-shrink: 0;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id {
  margin: 0;
  font-size: 1.125rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const items = Array.isArray(args.contextData.props?.items) ? args.contextData.props.items : [];
const startIndex = Math.max(0, Number(args.contextData.props?.startIndex) || 0);
const item = items[startIndex] || {};
return {
  as: "h2",
  text: item.title || "Product"
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: inline-flex;
  align-items: center;
