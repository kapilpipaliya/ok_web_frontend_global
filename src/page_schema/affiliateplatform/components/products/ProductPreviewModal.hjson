};'''
      }
    }
    {
      id: "13"
      L: Attr
      P: {
        css:
          '''return `._id {
  color: ${args.theme.var.color.text};
  font-size: 0.95rem;
  line-height: 1.65;

  h1, h2, h3, h4 {
    margin: 1rem 0 0.5rem;
    color: ${args.theme.var.color.text};
  }

