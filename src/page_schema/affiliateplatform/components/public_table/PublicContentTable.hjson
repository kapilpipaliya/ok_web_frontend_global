    {
      id: "10"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''const rows = c.props?.rows || [];
const contextName = c.props?.contextName || "row";
const hasRows = Array.isArray(rows);
const sortedRows = hasRows ? f.getSortedRows(rows) : [];

return {
  as: "fragment",
  ...(hasRows
    ? {
        data: sortedRows,
        contextName,
        loop: true
      }
    : {})
};'''
      }
    }
