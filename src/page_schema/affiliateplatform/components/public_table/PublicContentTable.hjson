      L: Attr
      P: {
        css:
          '''const column = c.column || {};
const align = column.align || "left";
return `._id {
  text-align: ${align};
  font-weight: 600;
  color: ${t.var.color.text};
  cursor: ${column.sortable === false ? "default" : "pointer"};
  user-select: none;
  white-space: nowrap;
}

._id:focus-visible {
  outline: 2px solid ${t.var.color.primary};
  outline-offset: -2px;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const column = c.column || {};
const sortable = column.sortable !== false;
const isActiveSort = f.sortKey() === column.key;
const direction = f.sortDirection();
return {
  as: "th",
  text: `${column.label || ""}${isActiveSort ? (direction === "asc" ? " ▲" : " ▼") : ""}`,
  style: column.width ? { width: column.width } : undefined,
  tabIndex: sortable ? 0 : undefined,
  onClick: sortable ? () => f.toggleSort(column) : undefined,
  onKeyDown: sortable
    ? (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          f.toggleSort(column);
        }
      }
    : undefined,
  "attr:aria-sort": isActiveSort
    ? (direction === "asc" ? "ascending" : "descending")
    : undefined
};'''
      }
    }
    {
      id: "9"
