    {
      id: "2"
      L: Attr
      P: {
        fns:
          '''const columns = () => c.props?.columns || [];
const defaultSortKey = c.props?.defaultSortKey || "";
const defaultSortDirection = c.props?.defaultSortDirection === "desc" ? "desc" : "asc";
const [sortKey, setSortKey] = _.createSignal(defaultSortKey);
const [sortDirection, setSortDirection] = _.createSignal(defaultSortDirection);

const getSortValue = (row, column, rowIndex) => {
  if (typeof column?.sortValue === "function") {
    return column.sortValue(row, rowIndex);
  }
  if (column?.key === "number") return rowIndex + 1;
  return row?.P?.[column?.key] ?? row?.[column?.key];
};

const compareSortValues = (leftValue, rightValue, sortType) => {
  const leftIsEmpty = leftValue == null || leftValue === "";
  const rightIsEmpty = rightValue == null || rightValue === "";
  if (leftIsEmpty && rightIsEmpty) return 0;
  if (leftIsEmpty) return 1;
  if (rightIsEmpty) return -1;

  if (sortType === "date") {
    const leftDate = new Date(leftValue).getTime();
    const rightDate = new Date(rightValue).getTime();
    if (!Number.isNaN(leftDate) && !Number.isNaN(rightDate)) {
      return leftDate - rightDate;
    }
  }

  if (sortType === "number") {
    const leftNumber = Number(leftValue);
    const rightNumber = Number(rightValue);
    if (!Number.isNaN(leftNumber) && !Number.isNaN(rightNumber)) {
      return leftNumber - rightNumber;
    }
  }

  return String(leftValue).localeCompare(String(rightValue), undefined, {
    numeric: true,
    sensitivity: "base"
  });
};

const getSortedRows = (rows) => {
  const list = Array.isArray(rows) ? rows : [];
  const activeColumn = columns().find((column) => column?.key === sortKey());
  if (!activeColumn || activeColumn.sortable === false) return list;
  const directionMultiplier = sortDirection() === "desc" ? -1 : 1;

  return list
    .map((row, rowIndex) => ({ row, rowIndex }))
    .sort((left, right) => {
      const comparison = compareSortValues(
        getSortValue(left.row, activeColumn, left.rowIndex),
        getSortValue(right.row, activeColumn, right.rowIndex),
        activeColumn.sortType
      );
      return comparison === 0
        ? left.rowIndex - right.rowIndex
        : comparison * directionMultiplier;
    })
    .map((entry) => entry.row);
};

const toggleSort = (column) => {
  if (!column || column.sortable === false) return;
  if (sortKey() === column.key) {
    setSortDirection((currentDirection) => currentDirection === "asc" ? "desc" : "asc");
    return;
  }
  setSortKey(column.key);
  setSortDirection(column.defaultSortDirection === "desc" ? "desc" : "asc");
};

return {
  sortKey,
  sortDirection,
  getSortedRows,
  toggleSort
};'''
