        displayOrder: 2
        componentName: FormManagement
        props:
          '''const formConfig = c.props?.formConfig;
const mode = c.props?.mode || "add";
const tableVertexLabel = c.props?.tableVertexLabel;
const initialVertex = c.props?.initialVertex;
const onSave = c.props?.onSave;
const onClose = c.props?.onClose;

// Wrap onSave to track txnId and pass through return value for FormManagement cleanup
const wrappedOnSave = async (saveData) => {
  // Get txnId from FormManagement (will be set via onFnsReady)
  const txnId = f?.formTxnId?.();
  if (txnId && txnId > 0) {
    f.setFormTxnId(txnId);
  }

  // Call original onSave with vertex format and return result for FormManagement
  if (onSave) {
    return await onSave(saveData);
  }
  return false;
};

// Wrap onClose to cleanup transaction
const wrappedOnClose = () => {
  f.cleanup();
  if (onClose) {
    onClose();
  }
};

return {
  formConfig: formConfig,
  initialVertex: initialVertex,
  mode: mode,
  inModal: true,
  vertexLabel: tableVertexLabel,
  hide: () => !(c.props?.isOpen === true),
  onSave: wrappedOnSave,
  onClose: wrappedOnClose
};'''
      }
    }
