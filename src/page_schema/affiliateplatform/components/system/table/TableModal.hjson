        displayOrder: 1
        componentName: Html
        props:
          '''const mode = c.props?.mode || "add";
const label = c.props?.label;
const title = mode === "add"
  ? (label ? `Add New ${label}` : "Add New Item")
  : mode === "view"
  ? (label ? `View ${label}` : "View Item")
  : (label ? `Edit ${label}` : "Edit Item");

return {
  as: "div",
  text: title
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''const wrappedOnClose = () => {
  f.cleanup();
  const onClose = c.props?.onClose;
  if (onClose) onClose();
};

return {
  as: "s-button",
  "attr:variant": "plain",
  "attr:icon": "x",
  "attr:accessibilityLabel": "Close",
  onClick: wrappedOnClose,
  hide: f.getUsePolarisUI?.() !== true
};'''
      }
    }
