      P: {
        css:
          '''return `._id {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@media (max-width: 768px) {
  ._id {
    padding: 0;
    align-items: flex-end;
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const isOpen = c.props?.isOpen || false;

return {
  as: "div",
  hide: !isOpen,
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      c.props?.onClose();
    }
  },
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  background: ${t.var.color.background};
  border-radius: 0.75rem;
  width: 100%;
  max-width: 880px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  animation: slideUp 0.3s ease;
}

@media (max-width: 768px) {
  ._id {
    max-width: 100%;
    max-height: 100vh;
    height: 100vh;
    border-radius: 0;
    animation: slideUpMobile 0.3s ease;
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes slideUpMobile {
  from {
    opacity: 0;
    transform: translateY(100%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}`;'''
        displayOrder: 1
        fns:
          '''// Track form txnId for cleanup
const [formTxnId, setFormTxnId] = _.createSignal(0);

// Cleanup function to revert transaction
const cleanup = () => {
  const txnId = formTxnId();
  if (txnId && txnId > 0) {
    _.revertTransaction(txnId);
    setFormTxnId(0);
  }
};

return {
  formTxnId,
  setFormTxnId,
  cleanup,
  getUsePolarisUI: () => f.getUsePolarisUI?.() === true
};'''
        componentName: Html
        props:
          '''return {
  as: "div",
  onClick: (e) => e.stopPropagation(),
  onCleanup: () => {
    f.cleanup();
  }
};'''
      }
    }
