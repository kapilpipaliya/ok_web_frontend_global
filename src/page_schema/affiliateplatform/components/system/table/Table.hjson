        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  text: "Data Format: Paste CSV or JSON data. For CSV, first row should be headers. For JSON, provide an array of objects."
};'''
      }
    }
    {
      id: "80"
      L: Attr
      P: {
        css:
          '''return `._id {
  margin-top: ${args.theme.var.spacing.sm};
  font-weight: 600;
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "div",
  text: "Sample CSV header:"
};'''
      }
    }
    {
      id: "81"
      L: Attr
      P: {
        css:
          '''const columns = args.fns.getColumns();
const getSampleCSVHeader = () => {
  if (!columns || columns.length === 0) return "";
  const headers = columns.filter(col => args.fns.getColumnRenderer(col) !== "rowNumber").map(col => col.key);
  return headers.join(",");
};

const sampleHeader = getSampleCSVHeader();

return `._id {
  margin-top: ${args.theme.var.spacing.xs};
  background: rgba(0,0,0,0.1);
  padding: ${args.theme.var.spacing.sm};
  border-radius: ${args.theme.var.borderRadius.sm};
  font-family: monospace;
  font-size: 0.75rem;
  word-break: break-all;
}`;'''
        displayOrder: 3
        componentName: Html
        props:
          '''const columns = args.fns.getColumns();
const getSampleCSVHeader = () => {
  if (!columns || columns.length === 0) return "";
  const headers = columns.filter(col => args.fns.getColumnRenderer(col) !== "rowNumber").map(col => col.key);
  return headers.join(",");
};

return {
  as: "code",
  text: getSampleCSVHeader()
};'''
      }
    }
    {
      id: "82"
      L: Attr
      P: {
        displayOrder: 3
        componentName: TextArea
        props:
          '''return {
  value: args.graph.vertexes[args.fns.tableStateVertexId]?.P?.importData ?? "",
  onChange: (e) => args.mergeVertexProperties(0, args.fns.tableStateVertexId, args.graph, args.setGraph, { importData: e.target.value }),
  placeholder: "Paste your data here (CSV or JSON format)...",
  rows: 10,
  style: "font-family: monospace; font-size: 12px;"
};'''
      }
    }
    {
