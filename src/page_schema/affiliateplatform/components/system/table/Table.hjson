{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        dynamicComponent: TomSelect
        fns:
          '''

const isNestedLinesTable = () => args.contextData.props?.nestedLinesMode === true;

const getRowExpansionConfigs = () => {
  if (isNestedLinesTable()) return [];
  const tableConfig = args.fns.evaluateConfig?.() || {};
  const rawExpansion = tableConfig.rowExpansion;
  if (Array.isArray(rawExpansion)) {
    return rawExpansion.filter((cfg) => cfg && typeof cfg === 'object');
  }
  if (rawExpansion && typeof rawExpansion === 'object') return [rawExpansion];
  return [];
};

// rowExpansion.expansionPanelHeight; optional expansionPanelMaxHeight caps height. Default 280 when unset.
const parsePositiveNumber = (rawValue) => {
  if (typeof rawValue === 'number' && !Number.isNaN(rawValue) && rawValue > 0) return rawValue;
  if (typeof rawValue === 'string' && rawValue.trim() !== '') {
    const parsedNumber = parseFloat(String(rawValue).replace(/px$/i, '').trim());
    if (!Number.isNaN(parsedNumber) && parsedNumber > 0) return parsedNumber;
  }
  return null;
};

const getExpansionPanelHeight = (rowExpansions) => {
  const list = Array.isArray(rowExpansions) ? rowExpansions : [];
  if (list.length === 0) return 280;
  let totalHeight = 0;
  for (let i = 0; i < list.length; i++) {
    const rowExpansion = list[i];
    if (!rowExpansion || typeof rowExpansion !== 'object') continue;
    let panelHeightPx = parsePositiveNumber(rowExpansion.expansionPanelHeight);
    if (panelHeightPx == null) panelHeightPx = 280;
    const maxPanelHeightPx = parsePositiveNumber(rowExpansion.expansionPanelMaxHeight);
    if (maxPanelHeightPx != null && panelHeightPx > maxPanelHeightPx) panelHeightPx = maxPanelHeightPx;
    totalHeight += panelHeightPx;
  }
  return totalHeight > 0 ? totalHeight : 280;
};

const shouldExpandOneRowAtATime = (rowExpansion) => {
  if (!rowExpansion || typeof rowExpansion !== 'object') return false;
  if (rowExpansion.expandOneRowAtATime === true) return true;
  const accordionMaxWidthPx = rowExpansion.expandAccordionMaxWidth;
  if (
    typeof accordionMaxWidthPx === 'number' &&
    accordionMaxWidthPx > 0 &&
    typeof window !== 'undefined' &&
    window.innerWidth <= accordionMaxWidthPx
  ) {
    return true;
  }
  return false;
};

/** Structural columns use renderer only; data columns use dataType + renderer. */
const STRUCTURAL_COLUMN_RENDERERS = ["rowNumber", "expand", "iconAction", "actions"];

const getColumnRenderer = (col) => col?.renderer || "text";

const getColumnDataType = (col) => col?.dataType || "text";

const isStructuralColumn = (col) =>
  STRUCTURAL_COLUMN_RENDERERS.includes(getColumnRenderer(col));

/** Filter UI kind: text | select | checkbox | date | badge */
const getColumnFilterKind = (col) => {
  if (col?.filterType) return col.filterType;
  const renderer = getColumnRenderer(col);
  if (renderer === "badge") return "badge";
  const dataType = getColumnDataType(col);
  // Relation columns show a related label (name, email); filter by substring on that label.
  if (dataType === "relation" && col.selectConfig?.labelField) return "text";
  if (dataType === "relation" || dataType === "select") return "select";
  if (dataType === "boolean") return "checkbox";
  if (dataType === "date") return "date";
  return "text";
};

const getColumns = () => {
  if (isNestedLinesTable()) {
    return args.contextData.props?.nestedTableColumns || [];
  }
  // Do not pass contextData.props here: merged props often include columns: [] which
  // would override loadFromSetting config (empty array is !== undefined).
  const base = args.fns.prop('columns') || [];
  const groupBy = getGroupByConfig();
  if (groupBy) return [{ key: '__expand', renderer: 'expand', width: '32px', label: '' }, ...base];
  if (getRowExpansionConfigs().length > 0) return [{ key: '__expand', renderer: 'expand', width: '32px', label: '' }, ...base];
  return base;
};

const getRowHeight = () => {
  if (isNestedLinesTable()) return args.contextData.props?.nestedRowHeight ?? 36;
  return args.fns.prop('rowHeight', args.contextData.props) || 36;
};
const getTitle = () => {
  if (args.fns.isEmbeddedMode?.() === true && args.contextData.props?.hidePageChrome === true) return "";
  if (isNestedLinesTable()) return args.contextData.props?.nestedTableTitle ?? '';
  return args.fns.prop('title', args.contextData.props);
};
const getSubtitle = () => {
  if (args.fns.isEmbeddedMode?.() === true && args.contextData.props?.hidePageChrome === true) return "";
  if (isNestedLinesTable()) return args.contextData.props?.nestedTableSubtitle ?? '';
  return args.fns.prop('subtitle', args.contextData.props);
};
const getSearchPlaceholder = () => args.fns.prop('searchPlaceholder', args.contextData.props) || "Search...";
const getAdditionalFilters = () => args.fns.prop('additionalFilters', args.contextData.props) || [];
const getCustomActions = () => args.fns.prop('customActions', args.contextData.props) || [];
const getBatchActions = () => args.fns.prop('batchActions', args.contextData.props) || [];
const getShowRowNumber = () => {
  if (isNestedLinesTable()) return args.contextData.props?.showRowNumber !== false;
  // When loadFromSetting (DynamicPage), do not pass contextData.props: Table ComponentVariant
  // defValue is showRowNumber: false, so merged props would override saved config (same as getColumns).
  const loadFromSetting = args.fns.getLoadFromSetting?.() === true;
  if (loadFromSetting) {
    return args.fns.prop('showRowNumber') || false;
  }
  return args.fns.prop('showRowNumber', args.contextData.props) || false;
};
const getHideColumns = () => args.fns.prop('hideColumns', args.contextData.props) || [];

const getUniqueKeys = () => args.fns.prop('uniqueKeys', args.contextData.props) || [];
const getHideAddButton = () => {
  if (isNestedLinesTable()) {
    // Nested line tables hide Add unless explicitly enabled via hideAddButton: false
    return args.contextData.props?.hideAddButton !== false;
  }
  const loadFromSetting = args.fns.getLoadFromSetting?.() === true;
  if (loadFromSetting) {
    return args.fns.prop('hideAddButton') === true;
  }
  return args.fns.prop('hideAddButton', args.contextData.props) === true;
};
const getShowSelection = () => {
  if (isNestedLinesTable()) return args.contextData.props?.showSelection ?? false;
  return args.fns.prop('showSelection', args.contextData.props);
};
const DEFAULT_ACTION_META = {
  edit: { icon: "carbon:edit", variant: "ghost", title: "Edit", ariaLabel: "Edit" },
  delete: { icon: "carbon:trash-can", variant: "danger", title: "Delete", ariaLabel: "Delete" }
};

const getActionHandlers = () => {
  const handlers = args.fns.prop("actionHandlers", args.contextData.props);
  return handlers && typeof handlers === "object" ? handlers : {};
};

const normalizeAction = (action, index) => {
  if (!action || typeof action !== "object") return null;
  const type = action.type || "custom";
  const key = action.key || type || `action_${index ?? 0}`;
  const meta = DEFAULT_ACTION_META[type] || {};
  const group =
    action.group === "secondary" || action.display === "menu" ? "secondary" : "primary";
  return {
    key,
    type,
    group,
    label: action.label,
    icon: action.icon ?? meta.icon,
    variant: action.variant ?? meta.variant ?? "ghost",
    title: action.title ?? action.label ?? meta.title,
    ariaLabel: action.ariaLabel ?? action.title ?? action.label ?? meta.ariaLabel ?? key,
    confirm: action.confirm,
    visible: action.visible,
    disabled: action.disabled,
    disabledReason: action.disabledReason,
    reasonCode: action.reasonCode,
    reasonVariant: action.reasonVariant,
    loadingIcon: action.loadingIcon,
    onClick: action.onClick,
    href: action.href,
    target: action.target,
    rel: action.rel
  };
};

/** Row actions from settings `actions` array; handlers merged from props `actionHandlers`. */
const getActions = () => {
  const configured = args.fns.prop("actions", args.contextData.props);
  if (!Array.isArray(configured)) return [];
  const handlers = getActionHandlers();
  const out = [];
  for (let i = 0; i < configured.length; i++) {
    const normalized = normalizeAction(configured[i], i);
    if (!normalized) continue;
    if (!normalized.onClick && typeof handlers[normalized.key] === "function") {
      normalized.onClick = handlers[normalized.key];
    }
    out.push(normalized);
  }
  return out;
};

/** Actions column when `actions.length > 0`, or explicit `showActionsColumn` override. */
const getShowActionsColumn = () => {
  if (isNestedLinesTable()) return false;
  const configured = args.fns.prop("showActionsColumn", args.contextData.props);
  if (configured !== undefined) return configured === true;
  return getActions().length > 0;
};

/** Context for action predicates and confirm.message: `({ row, action, graph, ... }) => …` */
const buildActionContext = (action, row) => ({
  row,
  action,
  graph: args.graph,
  tableStateVertexId,
  getSelectedRows: () => getSelectedRows(),
  getDisplayData: () => getDisplayData()
});

const invokeActionPredicate = (fn, action, row, label) => {
  if (typeof fn !== "function") return undefined;
  try {
    return fn(buildActionContext(action, row));
  } catch (e) {
    console.error(`${label}:`, e);
    return undefined;
  }
};

/** `visible`: boolean | `({ row, action, … }) => boolean` — false hides; omitted => shown. */
const isActionVisible = (action, row) => {
  if (!action) return false;
  if (action.type === "edit" && !args.fns.getFormConfig?.()) {
    const handlers = getActionHandlers();
    if (typeof handlers[action.key] !== "function") return false;
  }
  if (action.visible === false) return false;
  if (action.visible === true) return true;
  if (typeof action.visible === "function") {
    const result = invokeActionPredicate(action.visible, action, row, "isActionVisible");
    if (result === false) return false;
    return true;
  }
  return true;
};

/** `disabled`: boolean | `({ row, action, … }) => boolean` — true disables; omitted => enabled. */
const isActionDisabled = (action, row) => {
  if (!action) return true;
  if (action.disabled === true) return true;
  if (action.disabled === false) return false;
  if (typeof action.disabled === "function") {
    return invokeActionPredicate(action.disabled, action, row, "isActionDisabled") === true;
  }
  return false;
};

/** `disabledReason`: string | `({ row, action, … }) => string` for automatic tooltips when disabled. */
const resolveActionReason = (action, row, reasonKey) => {
  if (!action || !reasonKey) return "";
  const raw = action[reasonKey];
  if (raw == null || raw === "") return "";
  if (typeof raw === "string") return raw;
  if (typeof raw === "function") {
    const result = invokeActionPredicate(raw, action, row, reasonKey);
    return result != null && String(result).trim() !== "" ? String(result) : "";
  }
  return "";
};

const resolveActionReasonCode = (action, row) => {
  if (!action) return "";
  const raw = action.reasonCode;
  if (raw == null || raw === "") return "";
  if (typeof raw === "string") return String(raw).trim();
  if (typeof raw === "function") {
    const result = invokeActionPredicate(raw, action, row, "reasonCode");
    return result != null && String(result).trim() !== "" ? String(result).trim() : "";
  }
  return "";
};

/** Table/settings map: reason code → display string (localization). */
const getActionReasonCodeMap = () => {
  const fromProps = args.fns.prop("reasonCodeMap", args.contextData.props);
  if (fromProps && typeof fromProps === "object" && !Array.isArray(fromProps)) return fromProps;
  const config = args.fns.evaluateConfig?.() || {};
  const fromConfig = config.reasonCodeMap;
  if (fromConfig && typeof fromConfig === "object" && !Array.isArray(fromConfig)) return fromConfig;
  return {};
};

const localizeReasonCode = (code) => {
  if (!code) return "";
  const mapped = getActionReasonCodeMap()[code];
  return typeof mapped === "string" && mapped.trim() !== "" ? mapped.trim() : "";
};

/** Explicit reason text, else `reasonCodeMap[reasonCode]`. */
const resolveActionReasonText = (action, row, reasonKey) => {
  const explicit = resolveActionReason(action, row, reasonKey);
  if (explicit) return explicit;
  return localizeReasonCode(resolveActionReasonCode(action, row));
};

const hasDisabledReasonHint = (action, row) =>
  resolveActionReason(action, row, "disabledReason") !== "" ||
  resolveActionReasonCode(action, row) !== "";

const filterVisibleActionsForRow = (actions, row) => {
  if (!Array.isArray(actions)) return [];
  const out = [];
  for (let i = 0; i < actions.length; i++) {
    if (isActionVisible(actions[i], row)) out.push(actions[i]);
  }
  return out;
};

const REASON_VARIANTS = ["info", "warning", "danger"];

const normalizeReasonVariant = (value) => {
  const v = value != null ? String(value).toLowerCase() : "";
  return REASON_VARIANTS.includes(v) ? v : "info";
};

/** `reasonVariant`: "info" | "warning" | "danger" | `({ row, action }) => variant` */
const resolveActionReasonVariant = (action, row) => {
  if (!action) return "info";
  const raw = action.reasonVariant;
  if (typeof raw === "function") {
    return normalizeReasonVariant(invokeActionPredicate(raw, action, row, "reasonVariant"));
  }
  return normalizeReasonVariant(raw);
};

/** Active reason metadata for tooltips, telemetry, and `data-reason-*` hooks. */
const getActionReasonState = (action, row) => {
  const fallbackTitle = action?.title || action?.label || action?.ariaLabel || action?.key || "";
  if (!action) {
    return { text: "", code: "", variant: "info", active: false, kind: null };
  }
  if (isActionDisabled(action, row) && hasDisabledReasonHint(action, row)) {
    const code = resolveActionReasonCode(action, row);
    const text = resolveActionReasonText(action, row, "disabledReason");
    return {
      text,
      code,
      variant: resolveActionReasonVariant(action, row),
      active: true,
      kind: "disabled"
    };
  }
  return { text: fallbackTitle, code: "", variant: "info", active: false, kind: null };
};

const getActionTooltip = (action, row) => getActionReasonState(action, row).text;

/** Spread onto action controls for popovers, i18n, analytics, audit. */
const getActionReasonDataAttrs = (action, row) => {
  const state = getActionReasonState(action, row);
  if (!state.active) return {};
  const attrs = {
    "data-reason-active": "true",
    "data-reason-variant": state.variant,
    "data-reason-kind": state.kind
  };
  if (state.code) attrs["data-reason-code"] = state.code;
  return attrs;
};

/** `href`: string | `({ row, action, … }) => string` — link for IconButton / open in new tab. */
const getActionHref = (action, row) => {
  if (!action) return undefined;
  const raw = action.href;
  if (raw == null || raw === "") return undefined;
  if (typeof raw === "string") return String(raw);
  if (typeof raw === "function") {
    const result = invokeActionPredicate(raw, action, row, "getActionHref");
    return result != null && result !== "" ? String(result) : undefined;
  }
  return undefined;
};

const getPrimaryActionsForRow = (row) =>
  filterVisibleActionsForRow(getActions(), row).filter((a) => a.group !== "secondary");

const getSecondaryActionsForRow = (row) =>
  filterVisibleActionsForRow(getActions(), row).filter((a) => a.group === "secondary");

const hasSecondaryActionsForRow = (row) => getSecondaryActionsForRow(row).length > 0;

/** Per-row async loading: runningAction[rowId][actionKey] */
const [runningAction, setRunningAction] = args.createSignal({});

const isActionRunning = (action, row) => {
  const rowId = row?.id != null ? String(row.id) : "";
  const key = action?.key;
  if (!rowId || !key) return false;
  return runningAction()[rowId]?.[key] === true;
};

const setActionRunning = (action, row, running) => {
  const rowId = row?.id != null ? String(row.id) : "";
  const key = action?.key;
  if (!rowId || !key) return;
  setRunningAction((prev) => {
    const next = { ...prev };
    const rowMap = { ...(next[rowId] || {}) };
    if (running) rowMap[key] = true;
    else delete rowMap[key];
    if (Object.keys(rowMap).length === 0) delete next[rowId];
    else next[rowId] = rowMap;
    return next;
  });
};

const confirmRowAction = async (confirmCfg, action, row) => {
  const title = confirmCfg?.title || "Confirm";
  const message =
    typeof confirmCfg?.message === "function"
      ? confirmCfg.message(buildActionContext(action, row))
      : confirmCfg?.message ?? "";
  const rbConfirm = args.contextData?.confirmContext?.rbConfirm || args.fns?.rbConfirm;
  if (rbConfirm) {
    return rbConfirm({
      title,
      message,
      confirmText: confirmCfg?.confirmText || "Confirm",
      cancelText: confirmCfg?.cancelText || "Cancel",
      variant: confirmCfg?.variant || (confirmCfg?.danger !== false && title.toLowerCase().includes("delete") ? "danger" : "default")
    });
  }
  return confirm(message ? `${title}\n\n${message}` : title);
};

const runRowAction = async (action, row) => {
  if (!action || !isActionVisible(action, row) || isActionDisabled(action, row)) return;
  if (isActionRunning(action, row)) return;

  if (action.confirm) {
    const ok = await confirmRowAction(action.confirm, action, row);
    if (!ok) return;
  }

  setActionRunning(action, row, true);
  try {
    if (typeof action.onClick === "function") {
      await action.onClick(row);
      return;
    }
    if (action.type === "edit") {
      const onEdit = getOnEdit();
      if (typeof onEdit === "function") {
        await onEdit(row);
        return;
      }
      await handleEdit(row);
      return;
    }
    if (action.type === "delete") {
      const handlers = getActionHandlers();
      const deleteHandler = handlers[action.key] || handlers.delete;
      if (typeof deleteHandler === "function") {
        await deleteHandler(row);
        return;
      }
      await handleDelete(row, { skipConfirm: !!action.confirm, confirm: action.confirm });
      return;
    }
    args.showErrorToast?.("Action handler not configured");
  } catch (error) {
    console.error("runRowAction:", error);
    args.showErrorToast?.(error?.message || "Action failed");
    throw error;
  } finally {
    setActionRunning(action, row, false);
  }
};

/** Bulk row actions (e.g. batch toolbar); skips hidden/disabled rows per action rules. */
const runBulkAction = async (action, rows) => {
  if (!action || !Array.isArray(rows) || rows.length === 0) return;
  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    if (!isActionVisible(action, row) || isActionDisabled(action, row)) continue;
    await runRowAction(action, row);
  }
};
const getResizableColumns = () => args.fns.prop('resizableColumns', args.contextData.props) ?? true;
const getHideExportButtons = () => {
  if (isNestedLinesTable()) return true;
  const loadFromSetting = args.fns.getLoadFromSetting?.() === true;
  return loadFromSetting
    ? (args.fns.prop('hideExportButtons') === true)
    : (args.fns.prop('hideExportButtons', args.contextData.props) ?? false);
};
const getHideImportButtons = () => {
  if (isNestedLinesTable()) return true;
  const loadFromSetting = args.fns.getLoadFromSetting?.() === true;
  return loadFromSetting
    ? (args.fns.prop('hideImportButtons') === true)
    : (args.fns.prop('hideImportButtons', args.contextData.props) ?? false);
};
const getHideSettingsButton = () => {
  if (isNestedLinesTable()) return true;
  const loadFromSetting = args.fns.getLoadFromSetting?.() === true;
  return loadFromSetting
    ? (args.fns.prop('hideSettingsButton') === true)
    : (args.fns.prop('hideSettingsButton', args.contextData.props) ?? false);
};
const getIcon = () => {
  if (isNestedLinesTable()) {
    const showNestedIcon = args.contextData.props?.nestedShowIcon === true;
    if (!showNestedIcon) return undefined;
    return args.contextData.props?.nestedIcon || args.fns.prop('icon', args.contextData.props);
  }
  return args.fns.prop('icon', args.contextData.props);
};
const getLabel = () => args.fns.prop('label', args.contextData.props);
const getAddButtonLabel = () => {
  const label = getLabel();
  return label ? `Add new ${label}` : "Add New Item";
};
const getOnEdit = () => args.fns.prop('onEdit', args.contextData.props);
const getOnAfterAdd = () => args.fns.prop('onAfterAdd', args.contextData.props);
const getOnAfterEdit = () => args.fns.prop('onAfterEdit', args.contextData.props);
const getOnAdd = () => args.fns.prop('onAdd', args.contextData.props);
const getOnAfterDelete = () => args.fns.prop('onAfterDelete', args.contextData.props);
const getRowClickable = () => args.fns.prop('rowClickable', args.contextData.props) === true;
const getOnRowClick = () => args.fns.prop('onRowClick', args.contextData.props);
const getSelectionMode = () => {
  const mode = args.fns.prop('selectionMode', args.contextData.props);
  return mode === 'single' ? 'single' : 'multiple';
};
const getOnSelectionChange = () => args.fns.prop('onSelectionChange', args.contextData.props);
const getInitialSelectedRowIds = () => {
  const raw = args.fns.prop('initialSelectedRowIds', args.contextData.props);
  return Array.isArray(raw) ? raw.map((id) => String(id)).filter(Boolean) : [];
};

const notifySelectionChange = () => {
  const onSelectionChange = getOnSelectionChange();
  if (typeof onSelectionChange !== 'function') return;
  const selectedIds = getSelectedRows();
  const displayed = getDisplayData() || [];
  const selectedItems = [];
  selectedIds.forEach((rowElementId) => {
    const rowData = displayed.find((row) => row?.id === rowElementId);
    const graphVertex = args.graph?.vertexes?.[rowElementId];
    if (graphVertex) {
      selectedItems.push({
        id: graphVertex.id,
        row: rowData,
        vertex: graphVertex
      });
    }
  });
  onSelectionChange(selectedIds, selectedItems, args);
};

const getColumnWidthsStorageKey = () => {
  const tableKey = args.fns.getTableKey?.() ?? args.contextData.props?.tableKey;
  const tableVertexLabel = args.fns.getTableVertexLabel?.() ?? args.contextData.props?.tableVertexLabel;
  const id = (tableKey != null && String(tableKey).trim() !== "")
    ? String(tableKey).trim()
    : (tableVertexLabel != null && String(tableVertexLabel).trim() !== "")
      ? String(tableVertexLabel).trim()
      : null;
  if (!id) return null;
  const nestedSuffix = isNestedLinesTable()
    ? `:nested:${args.contextData.props?.nestedTableTitle || "nested"}`
    : "";
  return `fulchand-table-column-widths:${id}${nestedSuffix}`;
};

const loadStoredColumnWidths = () => {
  if (typeof window === "undefined") return {};
  const key = getColumnWidthsStorageKey();
  if (!key) return {};
  try {
    const raw = window.localStorage.getItem(key);
    if (!raw) return {};
    const parsed = JSON.parse(raw);
    if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return {};
    return parsed;
  } catch (_) {
    return {};
  }
};

const persistColumnWidths = (widths) => {
  if (typeof window === "undefined") return;
  const key = getColumnWidthsStorageKey();
  if (!key) return;
  try {
    window.localStorage.setItem(key, JSON.stringify(widths && typeof widths === "object" ? widths : {}));
  } catch (_) {}
};

const propsTableStateVertexId = args.contextData.props?.tableStateVertexId;
let tableStateVertexId = propsTableStateVertexId;
let ownTableStateVertex = false;
if (!tableStateVertexId) {
  tableStateVertexId = args.generateNewVertexId(args.graph, args.setGraph);
  ownTableStateVertex = true;
  args.addNewVertex(0, {
    id: tableStateVertexId,
    L: ["TableUiState"],
    P: {
      data: [],
      filteredData: [],
      collapsedKeys: [],
      expansionOpen: [],
      expansionRows: [],
      expansionLoading: [],
      // Parent id → child line-item vertex ids (from main fetch); resolve bodies via args.graph.vertexes[id].
      expansionPrefetchIdsByParentId: null,
      activeRowId: null,
      searchTerm: "",
      columnFilters: {},
      sortConfig: { column: null, direction: null },
      isModalOpen: false,
      modalMode: "add", // "add" or "edit"
      editingRow: null,
      formData: null,
      isImportModalOpen: false,
      importData: "",
      columnWidths: loadStoredColumnWidths(),
      isResizing: false,
      iconActionActiveKey: null,
      selectionAnchorIndex: null
    },
    IN: {},
    OUT: {}
  }, args.graph, args.setGraph);
}

const patchTableP = (partial) => {
  args.mergeVertexProperties(0, tableStateVertexId, args.graph, args.setGraph, partial);
};
const tableP = () => args.graph.vertexes[tableStateVertexId]?.P;

// Restore persisted widths when reusing an existing table state with empty widths
if (!ownTableStateVertex) {
  const existingWidths = tableP()?.columnWidths;
  if (!existingWidths || typeof existingWidths !== "object" || Object.keys(existingWidths).length === 0) {
    const storedWidths = loadStoredColumnWidths();
    if (Object.keys(storedWidths).length > 0) {
      patchTableP({ columnWidths: storedWidths });
    }
  }
}

/** TableUiState: P.data / P.filteredData are string[] vertex ids only. Resolve bodies via args.graph.vertexes[id]. */
const normalizeRowIds = (entries) => {
  const seen = new Set();
  const out = [];
  if (!Array.isArray(entries)) return out;
  for (let i = 0; i < entries.length; i++) {
    const id = entries[i];
    if (typeof id !== 'string' || id === '') continue;
    if (!seen.has(id)) {
      seen.add(id);
      out.push(id);
    }
  }
  return out;
};

const rowIdsFromVertices = (rows) => {
  const raw = [];
  if (!Array.isArray(rows)) return normalizeRowIds(raw);
  for (let i = 0; i < rows.length; i++) {
    const r = rows[i];
    if (r?.id != null && r.id !== '') raw.push(String(r.id));
  }
  return normalizeRowIds(raw);
};

const vertexFromRowId = (id) => {
  if (typeof id !== 'string' || id === '') return null;
  return args.graph?.vertexes?.[id] || null;
};

const verticesFromRowIds = (ids) => {
  const normalized = normalizeRowIds(ids);
  const out = [];
  for (let i = 0; i < normalized.length; i++) {
    const vx = vertexFromRowId(normalized[i]);
    if (vx) out.push(vx);
  }
  return out;
};

const resolvedFilteredVertices = () => verticesFromRowIds(tableP()?.filteredData ?? []);

const getGroupByConfig = () => args.fns.prop('groupBy', args.contextData.props) || null;
const toggleExpanded = (key) => {
  const sk = String(key);
  const p = tableP();
  const cur = Array.isArray(p?.collapsedKeys) ? p.collapsedKeys : [];
  const idx = cur.indexOf(sk);
  const next = idx >= 0 ? cur.filter((k) => k !== sk) : [...cur, sk];
  patchTableP({ collapsedKeys: next });
};

const isExpansionOpen = (rowId) => {
  const open = tableP()?.expansionOpen;
  return Array.isArray(open) && open.includes(String(rowId));
};

const buildExpansionPrefetchIdMapFromGraph = (relatedVertexIds, rowExpansion, parentRows) => {
  if (!rowExpansion || !rowExpansion.childVertexLabel || !Array.isArray(relatedVertexIds)) return null;
  const childLabel = rowExpansion.childVertexLabel;
  const filterKey = rowExpansion.childParentFilterKey || 'orderId';
  const idField = rowExpansion.parentIdField || 'id';
  const idsByParentKey = {};
  for (const lineItemVertexId of relatedVertexIds) {
    if (lineItemVertexId == null || lineItemVertexId === '') continue;
    const lineItemVertex = args.graph?.vertexes?.[lineItemVertexId];
    if (!lineItemVertex?.L?.includes(childLabel)) continue;
    const parentFilterValue = lineItemVertex.P?.[filterKey];
    if (parentFilterValue == null) continue;
    const parentKey = String(parentFilterValue);
    if (!idsByParentKey[parentKey]) idsByParentKey[parentKey] = [];
    if (!idsByParentKey[parentKey].includes(lineItemVertexId)) idsByParentKey[parentKey].push(lineItemVertexId);
  }
  if (Array.isArray(parentRows)) {
    for (const row of parentRows) {
      const parentVal =
        typeof rowExpansion.getNestedParentFilterValue === 'function'
          ? rowExpansion.getNestedParentFilterValue(row)
          : (row.P?.[idField] ?? row[idField] ?? row.id);
      if (parentVal == null) continue;
      const parentKey = String(parentVal);
      if (idsByParentKey[parentKey] === undefined) idsByParentKey[parentKey] = [];
    }
  }
  return idsByParentKey;
};

const lineItemVerticesFromIds = (ids) => {
  if (!Array.isArray(ids)) return [];
  const out = [];
  for (const vertexId of ids) {
    const vertex = args.graph?.vertexes?.[vertexId];
    if (vertex) out.push(vertex);
  }
  return out;
};

const getNestedSortValue = (row, columnKey, nestedColumns) => {
  const nestedColumn = Array.isArray(nestedColumns) ? nestedColumns.find((column) => column.key === columnKey) : null;
  if (nestedColumn?.valueAccessor) return nestedColumn.valueAccessor(row);
  return row?.P?.[columnKey];
};

const sortExpansionPrefetchRows = (rows, nestedSort, nestedColumns) => {
  if (!Array.isArray(rows) || rows.length < 2) return rows ? rows.slice() : [];
  if (!nestedSort?.column) return rows.slice();
  const sortColumnKey = nestedSort.column;
  const directionSign = nestedSort.direction === 'desc' ? -1 : 1;
  const sorted = rows.slice();
  sorted.sort((a, b) => {
    const aVal = getNestedSortValue(a, sortColumnKey, nestedColumns);
    const bVal = getNestedSortValue(b, sortColumnKey, nestedColumns);
    if (aVal === bVal) return 0;
    const comparison = aVal > bVal ? 1 : -1;
    return comparison * directionSign;
  });
  return sorted;
};

const clearExpansionStoresForDataReload = () => {
  patchTableP({ expansionOpen: [], expansionRows: [], expansionLoading: [] });
};

const toggleRowExpansion = async (row) => {
  const rowExpansions = getRowExpansionConfigs();
  if (!Array.isArray(rowExpansions) || rowExpansions.length === 0 || !row?.id) return;
  const id = String(row.id);
  let p0 = tableP();
  let open = Array.isArray(p0?.expansionOpen) ? [...p0.expansionOpen] : [];
  const oidx = open.indexOf(id);
  if (oidx >= 0) {
    open.splice(oidx, 1);
    patchTableP({ expansionOpen: open });
    return;
  }
  if (shouldExpandOneRowAtATime(rowExpansions[0])) {
    open = [];
  }
  open.push(id);
  patchTableP({ expansionOpen: open });
  p0 = tableP();
  for (let idx = 0; idx < rowExpansions.length; idx++) {
    const rowExpansion = rowExpansions[idx];
    if (!rowExpansion?.childVertexLabel) continue;
    const expansionKey = "exp_" + idx;
    const idField = rowExpansion.parentIdField || 'id';
    const parentVal =
      typeof rowExpansion.getNestedParentFilterValue === 'function'
        ? rowExpansion.getNestedParentFilterValue(row)
        : (row.P?.[idField] ?? row[idField] ?? row.id);
    const loadingKey = id + "::" + expansionKey;
    const prefetchMap = p0?.expansionPrefetchIdsByParentId;
    if (prefetchMap != null) {
      const bucketIds = prefetchMap[String(parentVal)] ?? [];
      const rows = lineItemVerticesFromIds(bucketIds);
      const sortedRows = sortExpansionPrefetchRows(rows, rowExpansion.nestedSort, rowExpansion.nestedColumns);
      const erList = Array.isArray(p0?.expansionRows) ? p0.expansionRows.filter((e) => !(e && e.id === id && String(e.key || "") === expansionKey)) : [];
      erList.push({ id, key: expansionKey, rows: sortedRows });
      patchTableP({ expansionRows: erList });
      continue;
    }
    const erArr = Array.isArray(p0?.expansionRows) ? p0.expansionRows : [];
    const existing = erArr.find((e) => e && e.id === id && String(e.key || "") === expansionKey);
    const skipFetch = existing?.rows != null && rowExpansion.refetchOnExpand !== true;
    if (skipFetch) continue;
    let loading = Array.isArray(p0?.expansionLoading) ? [...p0.expansionLoading] : [];
    if (!loading.includes(loadingKey)) loading.push(loadingKey);
    patchTableP({ expansionLoading: loading });
    try {
      const childLabel = rowExpansion.childVertexLabel;
      const filterKey = rowExpansion.childParentFilterKey || 'orderId';
      const filters = { [filterKey]: parentVal };
      const sort = rowExpansion.nestedSort || null;
      const hooks = rowExpansion.nestedHooks;
      const fetchFn = args.fns.fetchUserContentRows;
      const fetchedRows = typeof fetchFn === 'function' ? await fetchFn({
        tableVertexLabel: childLabel,
        filters,
        sort,
        hooks
      }) : [];
      const p1 = tableP();
      const erPrev = Array.isArray(p1?.expansionRows) ? [...p1.expansionRows] : [];
      const loadPrev = Array.isArray(p1?.expansionLoading) ? p1.expansionLoading : [];
      const erNext = erPrev.filter((e) => !(e && e.id === id && String(e.key || "") === expansionKey));
      erNext.push({ id, key: expansionKey, rows: Array.isArray(fetchedRows) ? fetchedRows : [] });
      const loadNext = loadPrev.filter((lid) => lid !== loadingKey);
      patchTableP({ expansionRows: erNext, expansionLoading: loadNext });
    } catch (e) {
      const p1 = tableP();
      const loadPrev = Array.isArray(p1?.expansionLoading) ? p1.expansionLoading : [];
      patchTableP({ expansionLoading: loadPrev.filter((lid) => lid !== loadingKey) });
    }
  }
};

// Cache row objects by id so same row keeps same ref; cells then don't re-render when only expand/collapse changes
let displayRowCache = {};
const buildDisplayData = (filtered, groupByKey, collapsedList) => {
  if (!filtered || filtered.length === 0) return [];
  const collapsed = Array.isArray(collapsedList) ? collapsedList : [];
  const getKey = (row) => {
    const val = row?.P?.[groupByKey] ?? row?.[groupByKey];
    return val != null ? String(val) : '';
  };
  const groups = new Map();
  const keyOrder = [];
  for (const row of filtered) {
    const k = getKey(row);
    if (!groups.has(k)) {
      groups.set(k, []);
      keyOrder.push(k);
    }
    groups.get(k).push(row);
  }
  const result = [];
  const usedIds = new Set();
  for (const key of keyOrder) {
    const rows = groups.get(key) || [];
    const first = rows[0];
    const parentId = 'group-' + key;
    usedIds.add(parentId);
    let parentRow = displayRowCache[parentId];
    if (parentRow) {
      parentRow._isParent = true;
      parentRow._parentKey = key;
      parentRow.P = first?.P ? { ...first.P } : { [groupByKey]: key };
    } else {
      parentRow = { id: parentId, _isParent: true, _parentKey: key, P: first?.P ? { ...first.P } : { [groupByKey]: key } };
      displayRowCache[parentId] = parentRow;
    }
    result.push(parentRow);
    if (!collapsed.includes(key)) {
      for (const r of rows) {
        const id = r?.id ?? r?.P?.id;
        const rowId = id != null ? String(id) : 'row-' + key + '-' + result.length;
        usedIds.add(rowId);
        let childRow = displayRowCache[rowId];
        if (childRow) {
          Object.assign(childRow, { ...r, _isParent: false, _parentKey: key });
        } else {
          childRow = { ...r, _isParent: false, _parentKey: key };
          displayRowCache[rowId] = childRow;
        }
        result.push(childRow);
      }
    }
  }
  Object.keys(displayRowCache).forEach(k => { if (!usedIds.has(k)) delete displayRowCache[k]; });
  return result;
};
const getDisplayData = () => {
  const g = getGroupByConfig();
  const filtered = verticesFromRowIds(tableP()?.filteredData ?? []);
  if (!g) return filtered;
  const key = typeof g === 'string' ? g : (g.key || '');
  if (!key) return filtered;
  return buildDisplayData(filtered, key, tableP()?.collapsedKeys ?? []);
};

/** Row ids currently shown in the table body (excludes group-by parent rows). */
const getSelectableVisibleRowIds = () => {
  const displayed = getDisplayData();
  if (!Array.isArray(displayed) || displayed.length === 0) return [];
  const ids = [];
  for (let i = 0; i < displayed.length; i++) {
    const row = displayed[i];
    if (!row || row._isParent === true) continue;
    const id = row.id;
    if (id != null && id !== "") ids.push(String(id));
  }
  return ids;
};

let lastNestedLinesSyncKey = "";
const syncNestedLinesTableData = () => {
  if (!isNestedLinesTable()) return;
  const getRows = args.contextData.props?.getNestedLineRows;
  const rows = typeof getRows === "function" ? getRows() : [];
  const ids = rowIdsFromVertices(rows);
  const syncKey = ids.join("\0");
  if (syncKey === lastNestedLinesSyncKey) return;
  lastNestedLinesSyncKey = syncKey;
  patchTableP({ data: ids });
  const enableLocalFilters = args.fns.getConfigGeneralValue?.("enableLocalFilters") !== false;
  const enableLocalSort = args.fns.getConfigGeneralValue?.("enableLocalSort") !== false;
  if (enableLocalFilters || enableLocalSort) {
    applyLocalFilters();
  } else {
    patchTableP({ filteredData: ids });
  }
};

// Get selected rows functions from props (always provided by parent)
const getSelectedRows = () => {
  const propFn = args.contextData.props?.getSelectedRows;
  if (!propFn) {
    console.warn("getSelectedRows not provided to Table component");
    return new Set();
  }
  return propFn();
};

// Selection filtered to current display data - avoids stale selection (e.g. after move or category switch)
const getEffectiveSelectedRows = () => {
  const selected = getSelectedRows();
  const displayed = getDisplayData();
  const currentIds = new Set((displayed || []).map(r => r?.id).filter(Boolean));
  if (currentIds.size === 0) return new Set();
  return new Set([...selected].filter(id => currentIds.has(id)));
};
const setSelectedRows = (newSelected) => {
  const propFn = args.contextData.props?.setSelectedRows;
  if (!propFn) {
    console.warn("setSelectedRows not provided to Table component");
    return;
  }
  propFn(newSelected);
};
const clearSelectedRows = () => {
  const propFn = args.contextData.props?.clearSelectedRows;
  if (!propFn) {
    console.warn("clearSelectedRows not provided to Table component");
    return;
  }
  propFn();
};
const setIsResizing = (v) => patchTableP({ isResizing: v });
let iconActionResetTimer = null;
const iconActionActiveKey = () => tableP()?.iconActionActiveKey ?? null;
const setIconActionActiveKey = (v) => patchTableP({ iconActionActiveKey: v });
const activeRowId = () => tableP()?.activeRowId ?? null;
const getIconActionRowKey = (row, rowIndex) => {
  if (!row && rowIndex == null) return null;
  const id = row?.id ?? row?.P?.id;
  if (id != null) return String(id);
  if (rowIndex != null && rowIndex >= 0) return "idx-" + rowIndex;
  return null;
};
const writeTextToClipboard = async (text) => {
  if (navigator.clipboard && navigator.clipboard.writeText) {
    await navigator.clipboard.writeText(text);
  } else {
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.style.position = "fixed";
    ta.style.left = "-9999px";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    document.execCommand("copy");
    document.body.removeChild(ta);
  }
};
const scheduleIconActionReset = (ms) => {
  if (iconActionResetTimer) clearTimeout(iconActionResetTimer);
  if (ms == null || ms <= 0) return;
  iconActionResetTimer = setTimeout(() => {
    setIconActionActiveKey(null);
    iconActionResetTimer = null;
  }, ms);
};
const handleIconAction = async (column, row, rowIndex) => {
  const cfg = column.iconAction || {};
  const action = cfg.action || "clipboard";
  const rowKey = getIconActionRowKey(row, rowIndex);
  const stateKey = column.key + ":" + (rowKey != null ? rowKey : "idx-" + rowIndex);
  const getPayloadText = () => {
    if (typeof cfg.textAccessor === "function") return cfg.textAccessor(row);
    return getCellValue(row, column);
  };
  try {
    if (action === "clipboard") {
      const text = getPayloadText();
      if ((text === null || text === undefined || text === "") && !cfg.allowEmpty) return;
      await writeTextToClipboard(String(text));
      if (cfg.showFeedback !== false) {
        setIconActionActiveKey(stateKey);
        scheduleIconActionReset(cfg.activeDurationMs ?? 3000);
      }
      return;
    }
    if (action === "openUrl") {
      const url = getPayloadText();
      if (!url) return;
      const w = typeof window !== "undefined" ? window : null;
      if (w) w.open(String(url), cfg.openUrlTarget || "_blank", cfg.openUrlWindowFeatures || "noopener,noreferrer");
      if (cfg.activeDurationMs) {
        setIconActionActiveKey(stateKey);
        scheduleIconActionReset(cfg.activeDurationMs);
      }
      return;
    }
    if (action === "custom" && typeof cfg.onClick === "function") {
      await cfg.onClick(row, column, rowIndex, {
        getPayloadText,
        copyToClipboard: writeTextToClipboard,
        setFeedbackActive: () => {
          setIconActionActiveKey(stateKey);
          scheduleIconActionReset(cfg.activeDurationMs ?? 3000);
        },
        clearFeedback: () => {
          if (iconActionResetTimer) clearTimeout(iconActionResetTimer);
          iconActionResetTimer = null;
          setIconActionActiveKey(null);
        }
      });
      return;
    }
  } catch (e) {
    console.warn("iconAction failed", e);
  }
};
const pollRef = { id: null };
const rowRefs = {};
const setRowRef = (index, el) => {
  if (el) rowRefs[index] = el;
  else delete rowRefs[index];
};
const getRowRef = (index) => rowRefs[index];

// Initialize from query parameters
const useUrlQueryParams = () => args.contextData.props?.useUrlQueryParams !== false;

const initializeFromQueryParams = () => {
  if (!useUrlQueryParams()) return;
  const searchParams = args.searchParams || {};
  if (searchParams.search) {
    patchTableP({ searchTerm: searchParams.search });
  }
  if (searchParams.filters) {
    try {
      const filters = JSON.parse(searchParams.filters);
      args.setGraph("vertexes", tableStateVertexId, "P", { columnFilters: filters });
      // Apply filters after restoring from URL
      // Use setTimeout to ensure store update is complete
      setTimeout(() => {
        applyLocalFilters();
      }, 0);
    } catch (e) {
      console.error("Error parsing filters from query:", e);
    }
  }
  if (searchParams.sort) {
    try {
      const sort = JSON.parse(searchParams.sort);
      patchTableP({ sortConfig: sort });
    } catch (e) {
      console.error("Error parsing sort from query:", e);
    }
  }
};

// Update query parameters
const updateQueryParams = () => {
  if (!useUrlQueryParams()) return;
  const params = {};
  // Handle searchTerm
  const st = tableP()?.searchTerm ?? "";
  if (st) {
    params.search = st;
  } else {
    // Clear search param if searchTerm is empty
    params.search = undefined;
  }
  // Handle filters
  const cf = tableP()?.columnFilters ?? {};
  const filters = Object.keys(cf).length > 0 ? JSON.stringify(cf) : null;
  if (filters) {
    params.filters = filters;
  } else {
    // Clear filters param if no filters
    params.filters = undefined;
  }
  // Handle sort
  const sc = tableP()?.sortConfig ?? { column: null, direction: null };
  const sort = sc.column ? JSON.stringify(sc) : null;
  if (sort) {
    params.sort = sort;
  } else {
    // Clear sort param if no sort
    params.sort = undefined;
  }
  args.setSearchParams?.(params, { replace: true });
};



// Apply local filters (for table header row filters)
const applyLocalFilters = () => {
  const dataSource = verticesFromRowIds(tableP()?.data ?? []);
  let filtered = [...dataSource];

  // Apply search term
  const st = tableP()?.searchTerm ?? "";
  if (st) {
    const term = st.toLowerCase();
    const columns = getColumns().filter(col => !shouldHideColumn(col));

    filtered = filtered.filter(row => {
      // Only check values for visible columns, not keys
      for (const col of columns) {
        // Skip special/row number columns
        if (isStructuralColumn(col)) {
          continue;
        }
        const cellValue = getCellValue(row, col);
        if (
          cellValue !== null &&
          cellValue !== undefined &&
          String(cellValue).toLowerCase().includes(term)
        ) {
          return true;
        }
      }
      return false;
    });
  }

  // Apply column filters
  const columns = getColumns();
  filtered = filtered.filter(row => {
    for (const col of columns) {
      const filterValue = (tableP()?.columnFilters ?? {})[col.key];
      if (filterValue !== undefined && filterValue !== null && filterValue !== "") {
        // Skip rowNumber filter - it's calculated, not a property
        if (isStructuralColumn(col)) {
          continue;
        }
        const cellValue = getCellValue(row, col);
        if (getColumnFilterKind(col) === "text") {
          // Support both single value and array (for multiple select filters)
          if (Array.isArray(filterValue)) {
            if (filterValue.length === 0) {
              return true; // No filter applied
            }
            // Check if cell value matches any of the selected filter values
            const cellValueStr = String(cellValue || "").toLowerCase();
            const matches = filterValue.some(fv => 
              cellValueStr.includes(String(fv).toLowerCase())
            );
            if (!matches) {
              return false;
            }
          } else {
            // Single value filter
            if (!String(cellValue || "").toLowerCase().includes(String(filterValue).toLowerCase())) {
              return false;
            }
          }
        } else if (getColumnFilterKind(col) === "select") {
          // Support both single value and array (multiple select)
          if (Array.isArray(filterValue)) {
            if (filterValue.length === 0 || !filterValue.includes(cellValue)) {
              return false;
            }
          } else {
            if (cellValue !== filterValue) {
              return false;
            }
          }
        } else if (getColumnFilterKind(col) === "checkbox") {
          if (cellValue !== filterValue) {
            return false;
          }
        } else if (getColumnFilterKind(col) === "date") {
          // Date filtering logic
          const filterDate = new Date(filterValue);
          const cellDate = new Date(cellValue);
          if (isNaN(filterDate.getTime()) || isNaN(cellDate.getTime())) {
            return false;
          }
          // Simple date comparison - can be enhanced
          if (Math.abs(cellDate - filterDate) > 86400000) { // More than 1 day difference
            return false;
          }
        } else if (getColumnFilterKind(col) === "badge") {
          // Badge columns: partial match on raw value or display label (e.g. "Act" matches "Active")
          const cellVal = cellValue != null ? String(cellValue) : "";
          const cellKey = col.badgeKeyCase === "lower" ? cellVal.toLowerCase() : cellVal;
          const cellLabel = (col.badgeToneMap && col.badgeToneMap[cellValue] && Array.isArray(col.badgeToneMap[cellValue])) ? col.badgeToneMap[cellValue][0] : cellVal;
          const cellLabelNorm = col.badgeKeyCase === "lower" ? String(cellLabel).toLowerCase() : cellLabel;
          const matchOne = (fv) => {
            const fk = col.badgeKeyCase === "lower" ? String(fv).toLowerCase() : String(fv);
            if (!fk) return true;
            return cellKey.includes(fk) || cellLabelNorm.includes(fk);
          };
          if (Array.isArray(filterValue)) {
            if (filterValue.length === 0) return true;
            if (!filterValue.some(matchOne)) return false;
          } else {
            if (!matchOne(filterValue)) return false;
          }
        }
      }
    }
    return true;
  });

  // Apply sorting
  const sortCfg = tableP()?.sortConfig ?? { column: null, direction: null };
  if (sortCfg.column) {
    const sortColumn = columns.find(col => col.key === sortCfg.column);
    if (sortColumn) {
      filtered.sort((a, b) => {
        const aVal = getCellValue(a, sortColumn);
        const bVal = getCellValue(b, sortColumn);
        if (aVal === bVal) return 0;
        const comparison = aVal > bVal ? 1 : -1;
        return sortCfg.direction === "asc" ? comparison : -comparison;
      });
    }
  }

  patchTableP({ filteredData: normalizeRowIds(filtered.map((row) => String(row.id))) });
};

// Update category contentCount based on fetched data length when local filters are enabled
const updateCategoryCountFromFetchedData = (fetchedData, categoryItem) => {
  // Use the category item passed from fetchData, not the currently selected item
  // This ensures we update the count for the category that was actually fetched
  if (!categoryItem) return;

  const sidebarConfig = args.fns.getSidebarConfig?.() || (args.fns.evaluateConfig?.() || {}).sidebar;
  if (!sidebarConfig) return;

  const rootKeys = sidebarConfig.rootKeys || {};
  const rootKey = rootKeys.key;

  const tableLabel = args.fns.getTableVertexLabel?.();
  const uncategorizedVertexId = tableLabel ? '_' + tableLabel + '_uncategorized' : null;
  const isSyntheticUncat =
    uncategorizedVertexId &&
    (categoryItem.id === uncategorizedVertexId || categoryItem.P?.key === uncategorizedVertexId);
  const isUncategorized = categoryItem.P?.key === rootKey || isSyntheticUncat;
  if (isUncategorized && !uncategorizedVertexId) return;
  const categoryId = isUncategorized ? uncategorizedVertexId : categoryItem.id;

  if (!categoryId) return;

  let currentCount = 0;
  if (isUncategorized) {
    const uncategorizedVertex = args.graph?.vertexes?.[uncategorizedVertexId];
    currentCount = uncategorizedVertex?.P?.contentCount ?? 0;
  } else {
    const categoryVertex = args.graph?.vertexes?.[categoryId];
    currentCount = categoryVertex?.P?.contentCount ?? 0;
  }

  const fetchedLength = fetchedData?.length ?? 0;
  if (currentCount !== fetchedLength) {
    if (isUncategorized) {
      const uncategorizedVertex = args.graph?.vertexes?.[uncategorizedVertexId];
      if (uncategorizedVertex) {
        args.mergeVertexProperties(0, uncategorizedVertexId, args.graph, args.setGraph, {
          contentCount: fetchedLength
        });
      }
    } else {
      const categoryVertex = args.graph?.vertexes?.[categoryId];
      if (categoryVertex) {
        args.mergeVertexProperties(0, categoryId, args.graph, args.setGraph, {
          contentCount: fetchedLength
        });
      }
    }
  }
};

const debouncedSetSearchTerm = args.debounce(value => {
  patchTableP({ searchTerm: value });

  // Check if local filters are enabled
  const enableLocalFilters = args.fns.getConfigGeneralValue?.("enableLocalFilters") !== false;

  if (enableLocalFilters) {
    // Apply local filters only
    applyLocalFilters();
  } else {
    // Server-side search - trigger search
    handleSearch();
  }
  updateQueryParams();
}, 500);

// Get cell value from row
const getCellValue = (row, column) => {
  if (column.valueAccessor) {
    return column.valueAccessor(row);
  }
  if (getColumnDataType(column) === "relation" && column.selectConfig?.relationshipType && column.selectConfig?.labelField) {
    const sc = column.selectConfig;
    const rel = sc.relationshipType;
    const lf = sc.labelField;
    const vxMap = args.graph?.vertexes ?? {};
    const edgesMap = args.graph?.edges ?? {};
    let tid = null;
    if (row.OUT && rel) {
      const outArr = row.OUT[rel];
      if (Array.isArray(outArr) && outArr.length > 0) {
        const ed = edgesMap[outArr[0]];
        if (ed && ed.E != null) tid = ed.E;
      }
    }
    const resolveLabelFromVertexId = (vertexId) => {
      if (vertexId == null || String(vertexId).trim() === "") return "";
      const node = vxMap[String(vertexId).trim()];
      const lab = node?.P?.[lf];
      return lab != null && String(lab).trim() !== "" ? String(lab).trim() : "";
    };
    if (tid != null) {
      return resolveLabelFromVertexId(tid);
    }
    return "";
  }
  if (column.key.includes(".")) {
    const keys = column.key.split(".");
    let value = row;
    for (const key of keys) {
      value = value?.[key];
      if (value === undefined) return null;
    }
    return value;
  }
  if (row.P) {
    return row.P[column.key];
  }
  return row[column.key];
};

// Render cell content from column renderer (+ dataType for value semantics)
const renderCellContent = (row, column, rowIndex) => {
  const renderer = getColumnRenderer(column);
  const dataType = getColumnDataType(column);

  if (renderer === 'expand') {
    const gb = getGroupByConfig();
    if (gb) {
      const parentKey = row._parentKey;
      const isParent = row._isParent === true;
      const p = tableP();
      const ck = Array.isArray(p?.collapsedKeys) ? p.collapsedKeys : [];
      const isExpanded = parentKey != null && !ck.includes(String(parentKey));
      return { type: 'expand', isParent, isExpanded, parentKey, onToggle: () => toggleExpanded(parentKey) };
    }
    const rowExpansions = getRowExpansionConfigs();
    if (Array.isArray(rowExpansions) && rowExpansions.length > 0 && row?.id) {
      const rowId = String(row.id);
      return {
        type: 'expand',
        isParent: true,
        isExpanded: isExpansionOpen(rowId),
        parentKey: rowId,
        onToggle: () => toggleRowExpansion(row)
      };
    }
    return { type: 'expand', isParent: false, isExpanded: false, parentKey: null, onToggle: () => {} };
  }
  const value = getCellValue(row, column);

  if (renderer === "rowNumber") {
    return rowIndex + 1;
  }

  if (column.render) {
    return column.render(value, row, column);
  }

  if (dataType === "boolean" || renderer === "checkbox") {
    return value ? "✓" : "";
  }

  if (renderer === "image" || renderer === "imagePreview") {
    const imageUrl = value || column.defaultImage;
    return imageUrl ? { type: "image", url: imageUrl, alt: column.alt || "" } : "";
  }

  if (renderer === "youtubeLink") {
    const videoId = value || column.videoIdAccessor?.(row);
    if (!videoId) return "";
    return { type: "youtubeLink", videoId };
  }

  if (renderer === "downloadLink") {
    const url = value || column.urlAccessor?.(row);
    const icon = column.icon || "carbon:download";
    if (!url) return "";
    return { type: "downloadLink", url, icon };
  }

  if (renderer === "iconAction") {
    const cfg = column.iconAction || {};
    const action = cfg.action || "clipboard";
    const payload = typeof cfg.textAccessor === "function" ? cfg.textAccessor(row) : (value ?? getCellValue(row, column));
    if ((action === "clipboard" || action === "openUrl") && (payload === null || payload === undefined || payload === "") && !cfg.allowEmpty) {
      return "";
    }
    if (action === "custom" && typeof cfg.onClick !== "function") {
      return "";
    }
    return { type: "iconAction", actionColumn: column };
  }

  if (renderer === "duration") {
    if (!value) return "";
    const seconds = typeof value === "number" ? value : parseInt(value);
    if (isNaN(seconds)) return value;
    const hours = Math.floor(seconds / 3600);
    const minutes = Math.floor((seconds % 3600) / 60);
    const secs = seconds % 60;
    if (hours > 0) {
      return `${hours}:${String(minutes).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
    }
    return `${minutes}:${String(secs).padStart(2, "0")}`;
  }

  if (renderer === "date" || (dataType === "date" && renderer === "text")) {
    if (!value) return "";
    const date = new Date(value);
    if (isNaN(date.getTime())) return value;
    return date.toLocaleDateString();
  }

  if (renderer === "isoDateTime") {
    if (!value) return "";
    const date = new Date(value);
    if (isNaN(date.getTime())) return value;
    return date.toLocaleString();
  }

  if (renderer === "join") {
    if (!value || !Array.isArray(value)) return "";
    const separator = column.separator || ", ";
    const displayKey = column.displayKey || "name";
    return value.map(item => {
      if (typeof item === "string") return item;
      if (item.P) return item.P[displayKey] || item.P.name || "";
      return item[displayKey] || item.name || "";
    }).join(separator);
  }

  if (renderer === "actions") {
    return { type: "actions", row, column };
  }

  if (renderer === "badge") {
    const map = column.badgeToneMap || {};
    const v = (value || "").toString();
    const key = (column.badgeKeyCase === "lower" ? v.toLowerCase() : v);
    const entry = map[key];
    const [text, tone] = Array.isArray(entry) ? entry : [v || "", "neutral"];
    return { type: "badge", text, tone };
  }

  if (renderer === "link") {
    const text = value != null ? String(value) : "";
    const href =
      dataType === "email" && text
        ? `mailto:${text.trim()}`
        : typeof column.hrefAccessor === "function"
          ? column.hrefAccessor(row)
          : text;
    if (!href && !text) return "";
    return { type: "textLink", text: text || href, href: href || text, title: text || column.label };
  }

  if (renderer === "currency") {
    const n = typeof value === "number" ? value : parseFloat(value);
    if (value == null || value === "" || Number.isNaN(n)) return value != null ? String(value) : "";
    const currency = column.currency || "USD";
    try {
      return new Intl.NumberFormat(undefined, { style: "currency", currency }).format(n);
    } catch {
      return String(n);
    }
  }

  // Default: return as string
  return value !== null && value !== undefined ? String(value) : "";
};

// Handle sort
const handleSort = (column) => {
  // Don't allow sorting for rowNumber columns
  if (getColumnRenderer(column) === "rowNumber" || getColumnRenderer(column) === "iconAction") return;
  if (column.sortable === false) return;

  const sortConfig = tableP()?.sortConfig ?? { column: null, direction: null };
  // If clicking the same column that's already sorted
  if (sortConfig.column === column.key) {
    // If currently ascending, switch to descending
    if (sortConfig.direction === "asc") {
      patchTableP({ sortConfig: { column: column.key, direction: "desc" } });
    } 
    // If currently descending, clear the sort
    else if (sortConfig.direction === "desc") {
      patchTableP({ sortConfig: { column: null, direction: null } });
    }
  } else {
    // New column, start with ascending
    patchTableP({ sortConfig: { column: column.key, direction: "asc" } });
  }

  // Check if local sort is enabled
  const enableLocalSort = args.fns.getConfigGeneralValue?.("enableLocalSort") !== false;

  if (enableLocalSort) {
    // Apply local sort only
    applyLocalFilters();
  } else {
    // Server-side sort - trigger search
    handleSearch();
  }
  updateQueryParams();
};

// Get unique values for a column
const getUniqueColumnValues = (column) => {
  const allData = verticesFromRowIds(tableP()?.data ?? []);
  const uniqueValues = new Set();

  allData.forEach(row => {
    const value = getCellValue(row, column);
    if (value !== null && value !== undefined && value !== "") {
      uniqueValues.add(String(value));
    }
  });

  return Array.from(uniqueValues).sort();
};

// Common function to create select filter component props
const getSelectFilterProps = (columnKey, filterValue, options) => {
  // Normalize filterValue to array for multiple select
  // Ensure values match option values exactly
  // If "_All_VALUES_" is present, don't include it in the display value
  let normalizedValue = Array.isArray(filterValue) 
    ? filterValue.filter(v => v !== null && v !== undefined && v !== "" && v !== "_All_VALUES_")
    : (filterValue && filterValue !== "_All_VALUES_" ? [filterValue] : []);

  // If filter is cleared (undefined), pass empty array to clear TomSelect
  // TomSelect needs empty array for multiple mode to show as cleared
  const displayValue = filterValue === undefined ? [] : normalizedValue;

  // Check if filter is currently empty
  const isFilterEmpty = filterValue === undefined || 
    (Array.isArray(filterValue) && filterValue.length === 0) ||
    filterValue === null || filterValue === "";

  return {
    componentName: "TomSelect",
    value: displayValue,
    onChange: (newValue) => {
      // If "All" is selected
      if (Array.isArray(newValue) && newValue.includes("_All_VALUES_")) {
        // clear all filters
        handleColumnFilterChange(columnKey, ["_All_VALUES_"]);
      } else {
        handleColumnFilterChange(columnKey, newValue);
      }
    },
    options: options,
    search: options.length > 10, // Enable search if many options
    multiple: true
  };
};

// Handle column filter change
const handleColumnFilterChange = (columnKey, value) => {
  let filterValue;
  if (Array.isArray(value)) {
    // If "_All_VALUES_" is selected, clear all filters for this column
    if (value.includes("_All_VALUES_")) {
      filterValue = undefined;
    } else {
      // Remove "_All_VALUES_" if present and filter out empty values
      const filtered = value.filter(v => v !== "_All_VALUES_" && v !== "" && v !== null && v !== undefined);
      filterValue = filtered.length === 0 ? undefined : filtered;
    }
  } else {
    // Single value - clear if "All" or empty
    filterValue = value === "_All_VALUES_" || value === "" || value === null || value === undefined ? undefined : value;
  }

  args.setGraph(
    "vertexes",
    tableStateVertexId,
    "P",
    "columnFilters",
    columnKey,
    filterValue === undefined ? undefined : JSON.parse(JSON.stringify(filterValue)),
  );

  // Check if local filters are enabled
  const enableLocalFilters = args.fns.getConfigGeneralValue?.("enableLocalFilters") !== false;

  if (enableLocalFilters) {
    // Apply local filters only
    applyLocalFilters();
  } else {
    // Server-side filters - trigger search
    handleSearch();
  }
  updateQueryParams();
};

// Background poll: fetch only queued row ids and merge updates (no full reload, no loader)
const pollQueuedRows = async () => {
  const intervalMs = args.fns.getConfigGeneralValue?.("refetchIntervalWhenQueued");
  const ids = normalizeRowIds(tableP()?.data ?? []);
  const queuedIds = [];
  for (let i = 0; i < ids.length; i++) {
    const vx = vertexFromRowId(ids[i]);
    if (vx?.P?.syncStatus === 'queued') queuedIds.push(ids[i]);
  }
  if (queuedIds.length === 0 || !intervalMs) return;
  const refresh = args.fns.refreshQueuedRows;
  if (!refresh || typeof refresh !== 'function') return;
  try {
    const result = await refresh(queuedIds);
    const updated = result?.data;
    if (Array.isArray(updated) && updated.length > 0) {
      applyLocalFilters();
      const dataIds = normalizeRowIds(tableP()?.data ?? []);
      const stillQueued = dataIds.some((id) => vertexFromRowId(id)?.P?.syncStatus === 'queued');
      if (stillQueued && pollRef.id === null) {
        pollRef.id = setTimeout(() => {
          pollRef.id = null;
          pollQueuedRows();
        }, intervalMs);
      }
    } else {
      if (pollRef.id === null) {
        pollRef.id = setTimeout(() => {
          pollRef.id = null;
          pollQueuedRows();
        }, intervalMs);
      }
    }
  } catch (e) {
    console.error("pollQueuedRows:", e);
    if (pollRef.id === null) {
      pollRef.id = setTimeout(() => {
        pollRef.id = null;
        pollQueuedRows();
      }, intervalMs);
    }
  }
};

// Start background poll when any row has syncStatus 'queued'. Pass optional data array to check; if omitted, uses current data().
const startPollIfQueued = (dataToCheck) => {
  const rows =
    dataToCheck !== undefined ? dataToCheck : verticesFromRowIds(tableP()?.data ?? []);
  if (pollRef.id) {
    clearTimeout(pollRef.id);
    pollRef.id = null;
  }
  const intervalMs = args.fns.getConfigGeneralValue?.("refetchIntervalWhenQueued");
  const refresh = args.fns.refreshQueuedRows;
  const hasQueued = Array.isArray(rows) && rows.some(r => (r.P?.syncStatus) === 'queued');
  if (intervalMs && refresh && typeof refresh === 'function' && hasQueued) {
    pollRef.id = setTimeout(() => {
      pollRef.id = null;
      pollQueuedRows();
    }, intervalMs);
  }
};

// Handle search
const handleSearch = () => {
  if (isNestedLinesTable()) {
    syncNestedLinesTableData();
    return;
  }
  const enableLocalFilters = args.fns.getConfigGeneralValue?.("enableLocalFilters") !== false;
  const enableLocalSort = args.fns.getConfigGeneralValue?.("enableLocalSort") !== false;

  // If local filters/sort are enabled, fetch all data and apply locally
  // Otherwise, pass filters/sort to server
  args.fns.fetchData(
    enableLocalFilters ? undefined : (tableP()?.searchTerm ?? ""), 
    enableLocalFilters ? undefined : (tableP()?.columnFilters ?? {}), 
    enableLocalSort ? undefined : (tableP()?.sortConfig ?? { column: null, direction: null }), 
    (fetchedRows, categoryItem, relatedVertexIds) => {
      clearExpansionStoresForDataReload();
      const rowExpansionRaw = (args.fns.evaluateConfig?.() || {}).rowExpansion;
      const rowExpansion = Array.isArray(rowExpansionRaw) ? rowExpansionRaw.find((cfg) => cfg?.childVertexLabel) : rowExpansionRaw;
      if (rowExpansion && rowExpansion.childVertexLabel && Array.isArray(relatedVertexIds)) {
        patchTableP({
          expansionPrefetchIdsByParentId: buildExpansionPrefetchIdMapFromGraph(relatedVertexIds, rowExpansion, fetchedRows)
        });
      } else {
        patchTableP({ expansionPrefetchIdsByParentId: null });
      }
      const contentRowIds = rowIdsFromVertices(fetchedRows);
      patchTableP({ data: contentRowIds });

      // Update category count with fetched data length if local filters are enabled
      // Pass the categoryItem that was used for fetching, not the currently selected item
      if (enableLocalFilters) {
        updateCategoryCountFromFetchedData(fetchedRows, categoryItem);
      }

      // Always apply local filters if enabled, or if server didn't filter
      if (enableLocalFilters || enableLocalSort) {
        applyLocalFilters();
      } else {
        patchTableP({ filteredData: contentRowIds });
      }

      startPollIfQueued(fetchedRows);
    }
  );
};

// Handle row selection (using vertex IDs)
const toggleRowSelection = (vertexId) => {
  const rowElementId = vertexId != null ? String(vertexId).trim() : "";
  if (!rowElementId) return;
  const currentSelected = getSelectedRows();
  let newSelected;
  if (getSelectionMode() === 'single') {
    if (currentSelected.has(rowElementId) && currentSelected.size === 1) {
      newSelected = new Set();
    } else {
      newSelected = new Set([rowElementId]);
    }
  } else {
    newSelected = new Set(currentSelected);
    if (newSelected.has(rowElementId)) {
      newSelected.delete(rowElementId);
    } else {
      newSelected.add(rowElementId);
    }
  }
  setSelectedRows(newSelected);
  notifySelectionChange();
};

const selectAllRows = () => {
  const displayed = getDisplayData();
  if (getSelectionMode() === 'single') {
    const firstRow = (displayed || []).find((row) => row?.id != null);
    setSelectedRows(firstRow?.id ? new Set([String(firstRow.id)]) : new Set());
  } else {
    const allVertexIds = new Set(
      (displayed || []).map((row) => row.id).filter((id) => id !== undefined && id !== null)
    );
    setSelectedRows(allVertexIds);
  }
  notifySelectionChange();
};

const clearSelection = () => {
  clearSelectedRows();
  notifySelectionChange();
};

const applyInitialSelectedRowIds = () => {
  const initialIds = getInitialSelectedRowIds();
  if (initialIds.length === 0) {
    clearSelectedRows();
    return;
  }
  if (getSelectionMode() === 'single') {
    setSelectedRows(new Set([initialIds[initialIds.length - 1]]));
  } else {
    setSelectedRows(new Set(initialIds));
  }
};

const [initialSelectionAppliedKey, setInitialSelectionAppliedKey] = args.createSignal("");
args.createEffect(() => {
  const initialIds = getInitialSelectedRowIds();
  const nextKey = initialIds.join("|");
  if (initialSelectionAppliedKey() === nextKey) return;
  setInitialSelectionAppliedKey(nextKey);
  applyInitialSelectedRowIds();
  if (initialIds.length > 0) {
    notifySelectionChange();
  }
});

// Shift+Arrow: anchor index for range selection (null when not extending)
const selectionAnchorIndex = () => tableP()?.selectionAnchorIndex ?? null;
const setSelectionAnchorIndex = (v) => patchTableP({ selectionAnchorIndex: v });
const clearSelectionAnchor = () => patchTableP({ selectionAnchorIndex: null });
const selectRange = (fromIndex, toIndex) => {
  const displayed = getDisplayData();
  if (!displayed || displayed.length === 0) return;
  const lo = Math.max(0, Math.min(fromIndex, toIndex));
  const hi = Math.min(displayed.length - 1, Math.max(fromIndex, toIndex));
  const ids = [];
  for (let i = lo; i <= hi; i++) {
    const r = displayed[i];
    if (r?.id) ids.push(r.id);
  }
  setSelectedRows(new Set(ids));
  notifySelectionChange();
};
const handleShiftArrow = (currentIndex, nextIndex) => {
  if (!getShowSelection()) return;
  let anchor = selectionAnchorIndex();
  if (anchor == null) {
    anchor = currentIndex;
    setSelectionAnchorIndex(anchor);
  }
  selectRange(anchor, nextIndex);
  patchTableP({ activeRowId: getDisplayData()?.[nextIndex]?.id ?? null });
};

const getActiveRowIndex = () => {
  const id = activeRowId();
  if (id == null) return -1;
  const displayed = getDisplayData();
  const idx = (displayed && displayed.findIndex((r) => r && r.id === id)) ?? -1;
  return idx >= 0 ? idx : -1;
};

// Handle add/edit
const handleAdd = async () => {
  const onAdd = getOnAdd();

  // If onAdd function is provided, call it instead of opening modal
  if (onAdd && typeof onAdd === 'function') {
    try {
      await onAdd();
      return;
    } catch (error) {
      console.error("Error in onAdd function:", error);
      args.showErrorToast?.(error?.message || "Failed to execute add action");
      return;
    }
  }

  // Default behavior: open add modal
  patchTableP({ modalMode: "add", editingRow: null, formData: null, isModalOpen: true });
};

const handleEdit = async (row) => {
  const onEdit = getOnEdit();

  // If onEdit function is provided, call it instead of opening modal
  if (onEdit && typeof onEdit === 'function') {
    try {
      await onEdit(row, args);
      return;
    } catch (error) {
      console.error("Error in onEdit function:", error);
      args.showErrorToast?.(error?.message || "Failed to execute edit action");
      return;
    }
  }

  // Default behavior: open edit modal
  patchTableP({ modalMode: "edit", editingRow: row, formData: row, isModalOpen: true });
};

const handleViewRow = (row) => {
  patchTableP({ modalMode: "view", editingRow: row, formData: row, isModalOpen: true });
};

const handleSave = async (formDataToSave) => {
  const formConfig = args.fns.getFormConfig();
  if (!formConfig?.saveFunction) {
    args.showErrorToast?.("Save function not configured");
    return;
  }

  const appendRowIds = (ids) => {
    const toAdd = (Array.isArray(ids) ? ids : [])
      .map((id) => String(id || "").trim())
      .filter(Boolean);
    if (toAdd.length === 0) return;
    const cur = normalizeRowIds(tableP()?.data ?? []);
    const merged = [...cur];
    for (let i = 0; i < toAdd.length; i++) {
      if (!merged.includes(toAdd[i])) merged.push(toAdd[i]);
    }
    patchTableP({ data: normalizeRowIds(merged) });
  };

  try {
    args.mergeVertexProperties(0, args.fns.pageStateVertexId, args.graph, args.setGraph, { loading: true });
    const mode = tableP()?.modalMode ?? "add";
    const originalRow = tableP()?.editingRow ?? null;
    const result = await formConfig.saveFunction({
      mode,
      data: formDataToSave,
      originalRow
    });

    if (result?.success) {
      args.showSuccessToast?.(
        mode === "add" ? "Item added successfully" : "Item updated successfully"
      );
      patchTableP({ isModalOpen: false });
      appendRowIds([
        ...(Array.isArray(formDataToSave?.uploadedContentIds)
          ? formDataToSave.uploadedContentIds
          : []),
        result.data?.id
      ]);

      const afterHook = mode === "add" ? getOnAfterAdd() : getOnAfterEdit();
      if (typeof afterHook === "function") {
        try {
          await afterHook(result, args);
        } catch (error) {
          console.error(mode === "add" ? "Error in onAfterAdd function:" : "Error in onAfterEdit function:", error);
          args.showErrorToast?.(error?.message || "Failed to execute after save action");
        }
      }
      applyLocalFilters();
      startPollIfQueued();
      return true;
    } else {
      const errorMsg = result?.message || result?.error || "Failed to save";
      args.showErrorToast?.(errorMsg);
      return false;
    }
  } catch (error) {
    console.error("Error saving:", error);
    const errorMsg = error?.message || error?.error || "Failed to save item";
    args.showErrorToast?.(errorMsg);
    return false;
  } finally {
    args.mergeVertexProperties(0, args.fns.pageStateVertexId, args.graph, args.setGraph, { loading: false });
  }
};

// Built-in delete: actionHandlers[key] or default mutateUserContent via formConfig.saveFunction.
const handleDelete = async (row, options = {}) => {
  const handlers = getActionHandlers();
  const deleteHandler = handlers[options?.actionKey] || handlers.delete;

  if (deleteHandler && typeof deleteHandler === "function") {
    try {
      await deleteHandler(row);
      return;
    } catch (error) {
      console.error("Error in delete handler:", error);
      args.showErrorToast?.(error?.message || "Failed to execute delete action");
      return;
    }
  }

  const formConfig = args.fns.getFormConfig();
  if (!formConfig?.saveFunction) {
    args.showErrorToast?.("Delete function not configured");
    return;
  }

  if (!options.skipConfirm) {
    const confirmCfg = options.confirm || {
      title: "Delete Item",
      message: "Are you sure you want to delete this item? This action cannot be undone.",
      confirmText: "Delete",
      cancelText: "Cancel",
      variant: "danger"
    };
    const confirmed = await confirmRowAction(
      confirmCfg,
      { key: options?.actionKey || "delete", type: "delete" },
      row
    );
    if (!confirmed) return;
  }

  try {
    args.mergeVertexProperties(0, args.fns.pageStateVertexId, args.graph, args.setGraph, { loading: true });
    // For delete, pass the row as vertex in the new data format
    const deleteData = {
      vertex: row,
      relationships: {}
    };
    const result = await formConfig.saveFunction({
      mode: "delete",
      data: deleteData,
      originalRow: row
    });

    if (result?.success) {
      const label = getLabel();
      args.showSuccessToast?.(label ? `${label} deleted successfully` : "Item deleted successfully");
      const rid = String(row?.id ?? "");
      const updated = normalizeRowIds(tableP()?.data ?? []).filter((id) => id !== rid);
      patchTableP({ data: updated });
      applyLocalFilters();

      // Check if onAfterDelete function is provided
      const onAfterDelete = getOnAfterDelete();
      if (onAfterDelete && typeof onAfterDelete === 'function') {
        try {
          await onAfterDelete(result, row, args);
        } catch (error) {
          console.error("Error in onAfterDelete function:", error);
          args.showErrorToast?.(error?.message || "Failed to execute after delete action");
        }
      }
    } else {
      const errorMsg = result?.message || result?.error || "Failed to delete";
      args.showErrorToast?.(errorMsg);
    }
  } catch (error) {
    console.error("Error deleting:", error);
    const errorMsg = error?.message || error?.error || "Failed to delete item";
    args.showErrorToast?.(errorMsg);
  } finally {
    args.mergeVertexProperties(0, args.fns.pageStateVertexId, args.graph, args.setGraph, { loading: false });
  }
};





// Check if column should be hidden
const shouldHideColumn = (column) => {
  const hideColumns = getHideColumns();
  if (typeof hideColumns === "function") {
    return hideColumns(column);
  }
  return hideColumns.includes(column.key);
};

// Get column width (from state, config, or defaults)
const getColumnWidth = (columnKey) => {
  const storedWidth = (tableP()?.columnWidths ?? {})[columnKey];
  if (storedWidth) {
    return storedWidth;
  }
  const configWidths = args.fns.prop('columnWidths', args.contextData.props);
  if (configWidths && configWidths[columnKey]) {
    return configWidths[columnKey];
  }
  if (columnKey === "__selection" || columnKey === "__rowNumber") {
    return "36px";
  }
  if (columnKey === "__actions") {
    return "120px";
  }
  const columns = getColumns();
  const column = columns.find(col => col.key === columnKey);
  return column?.width || "100px";
};

// Get grid template columns
const getGridTemplateColumns = () => {
  const columns = getColumns();
  const showRowNumber = getShowRowNumber();
  const showSelection = getShowSelection();
  let template = "";

  // Add selection column if enabled
  if (showSelection) {
    template += `${getColumnWidth("__selection")} `;
  }

  if (getShowActionsColumn()) {
    template += `${getColumnWidth("__actions")} `;
  }

  if (showRowNumber) {
    template += `${getColumnWidth("__rowNumber")} `;
  }

  columns.forEach(col => {
    if (!shouldHideColumn(col)) {
      template += `${getColumnWidth(col.key)} `;
    }
  });

  return template.trim();
};

// Create resize handler for a column
const createResizeHandler = (columnKey) => {
  return (e) => {
    e.preventDefault();
    e.stopPropagation();

    // Get current width
    const currentWidth = getColumnWidth(columnKey);
    let startWidth = 50;
    if (currentWidth && currentWidth !== "1fr") {
      const match = currentWidth.match(/(\d+)px/);
      if (match) {
        startWidth = parseInt(match[1]);
      }
    }

    const startX = e.clientX || e.touches?.[0]?.clientX || 0;

    const minWidth = (columnKey === "__selection" || columnKey === "__rowNumber") ? 36 : 50;
    const handleMouseMove = (moveEvent) => {
      const clientX = moveEvent.clientX || moveEvent.touches?.[0]?.clientX || startX;
      const deltaX = clientX - startX;
      const newWidth = Math.max(minWidth, startWidth + deltaX);
      args.setGraph("vertexes", tableStateVertexId, "P", "columnWidths", columnKey, `${newWidth}px`);
    };

    const handleMouseUp = () => {
      document.removeEventListener('mousemove', handleMouseMove);
      document.removeEventListener('mouseup', handleMouseUp);
      document.removeEventListener('touchmove', handleMouseMove);
      document.removeEventListener('touchend', handleMouseUp);
      setIsResizing(false);
      persistColumnWidths(tableP()?.columnWidths ?? {});
      // Prevent the click from this gesture from bubbling and triggering column sort
      const preventResizeClick = (clickEvent) => {
        clickEvent.preventDefault();
        clickEvent.stopPropagation();
        document.removeEventListener('click', preventResizeClick, true);
      };
      document.addEventListener('click', preventResizeClick, true);
    };

    setIsResizing(true);
    document.addEventListener('mousemove', handleMouseMove);
    document.addEventListener('mouseup', handleMouseUp);
    document.addEventListener('touchmove', handleMouseMove);
    document.addEventListener('touchend', handleMouseUp);
  };
};
// Watch for sidebar selection changes and refresh table
const selectedSidebarItem = args.fns.selectedSidebarItem;
args.createEffect(() => {
  const item = selectedSidebarItem?.();
  patchTableP({ activeRowId: null });
  // When sidebar selection changes, refresh table data
  if (item) {
    handleSearch();
  }
});

// React to parent's rowsToRemove signal (parent-owned state, no reload after move-to-category)
const rowsToRemove = args.contextData.props?.rowsToRemove;
const setRowsToRemove = args.contextData.props?.setRowsToRemove;
if (rowsToRemove && setRowsToRemove) {
  args.createEffect(() => {
    const idsToRemove = rowsToRemove?.();
    if (!idsToRemove || !Array.isArray(idsToRemove) || idsToRemove.length === 0) return;
    const idSet = new Set(idsToRemove.map((x) => String(x)));
    const updated = normalizeRowIds(tableP()?.data ?? []).filter((id) => !idSet.has(id));
    patchTableP({ data: updated });
    applyLocalFilters();
    setRowsToRemove(null);
  });
}

const rowsToAdd = args.contextData.props?.rowsToAdd;
const setRowsToAdd = args.contextData.props?.setRowsToAdd;
if (rowsToAdd && setRowsToAdd) {
  args.createEffect(() => {
    const idsToAdd = rowsToAdd?.();
    if (!idsToAdd || !Array.isArray(idsToAdd) || idsToAdd.length === 0) return;
    const cur = normalizeRowIds(tableP()?.data ?? []);
    const merged = [...cur];
    for (let i = 0; i < idsToAdd.length; i++) {
      const id = String(idsToAdd[i] || "").trim();
      if (id && !merged.includes(id)) merged.push(id);
    }
    patchTableP({ data: normalizeRowIds(merged) });
    applyLocalFilters();
    setRowsToAdd(null);
  });
}

// Drag and drop functionality using @atlaskit/pragmatic-drag-and-drop
const tableDraggableCleanups = new Map();
const tableDraggableElements = new Map(); // Store elements by rowId

// Read current rowId from element's data attribute (row re-renders update it when sidebar/data changes)
const getRowIdFromElement = (element) => {
  const id = element?.getAttribute?.('data-row-id');
  return id != null && id !== '' ? id : undefined;
};

// Helper to check if a row can be dragged
const canDragRow = (rowId) => {
  if (!rowId) return false;
  const selected = getEffectiveSelectedRows();
  if (!selected.has(rowId)) return false;
  return selected.size > 0;
};

// Initialize draggable for table row - rowId read from element data-row-id
const initTableDraggable = (element) => {
  if (!element || !args.draggable) return;

  // Clean up existing draggable for this element if any
  const existingCleanup = tableDraggableCleanups.get(element);
  if (existingCleanup) {
    existingCleanup();
  }

  const cleanup = args.draggable({
    element,
    getInitialData: () => {
      const currentRowId = getRowIdFromElement(element);
      if (!currentRowId || !canDragRow(currentRowId)) {
        return { type: 'table-items', itemIds: [], count: 0 };
      }

      const selected = getEffectiveSelectedRows();
      const itemIds = Array.from(selected).filter(id => id !== undefined && id !== null);

      return {
        type: 'table-items',
        itemIds,
        count: itemIds.length,
        sourceTableVertexLabel:
          args.contextData.props?.sourceTableVertexLabel ||
          args.fns.getTableVertexLabel?.() ||
          null,
        sourceTableKey:
          args.contextData.props?.sourceTableKey ||
          args.fns.getTableKey?.() ||
          null
      };
    },
    onGenerateDragPreview: ({ nativeSetDragImage }) => {
      // Provide a stable custom preview (pragmatic disables default preview in some setups)
      if (!args.setCustomNativeDragPreview || !nativeSetDragImage) return;
      const currentRowId = getRowIdFromElement(element);
      if (!currentRowId || !canDragRow(currentRowId)) return;

      const selected = getEffectiveSelectedRows();
      const count = selected.size;

      if (!count) return;

      return args.setCustomNativeDragPreview({
        nativeSetDragImage,
        getOffset: args.pointerOutsideOfPreview
          ? args.pointerOutsideOfPreview({ x: "8px", y: "8px" })
          : undefined,
        render: ({ container }) => {
          container.style.boxSizing = "border-box";
          container.style.display = "flex";
          container.style.alignItems = "center";
          container.style.gap = "10px";
          container.style.padding = "10px 12px";
          container.style.borderRadius = "10px";
          container.style.border = `1px solid ${args.theme?.var?.color?.border ?? "rgba(0,0,0,0.2)"}`;
          container.style.background = `${args.theme?.var?.color?.background_light_200 ?? "#fff"}`;
          container.style.color = `${args.theme?.var?.color?.text ?? "#111"}`;
          container.style.boxShadow = "0 10px 28px rgba(0,0,0,0.18)";
          container.style.pointerEvents = "none";
          container.style.fontSize = "14px";
          container.style.fontWeight = "600";
          container.style.maxWidth = "320px";

          const badge = document.createElement("div");
          badge.style.flex = "0 0 auto";
          badge.style.padding = "2px 8px";
          badge.style.borderRadius = "9999px";
          badge.style.background = `${args.theme?.var?.color?.primary ?? "#4f46e5"}`;
          badge.style.color = `${args.theme?.var?.color?.primary_text ?? "#fff"}`;
          badge.style.fontSize = "12px";
          badge.style.fontWeight = "700";
          badge.textContent = String(count);

          const text = document.createElement("div");
          text.style.minWidth = "0";
          text.style.whiteSpace = "nowrap";
          text.style.overflow = "hidden";
          text.style.textOverflow = "ellipsis";
          text.textContent = count === 1 ? "Move 1 item" : `Move ${count} items`;

          container.appendChild(badge);
          container.appendChild(text);
        }
      });
    },
    onDragStart: () => {
      const currentRowId = getRowIdFromElement(element);
      if (!currentRowId || !canDragRow(currentRowId)) return;
      if (element) element.style.opacity = "0.5";
    },
    onDrop: () => {
      if (element) element.style.opacity = "1";
    }
  });

  tableDraggableCleanups.set(element, cleanup);
  const rowId = getRowIdFromElement(element);
  if (rowId) tableDraggableElements.set(rowId, element);
  return cleanup;
};

// Cleanup table draggable for a specific element
const cleanupTableDraggable = (element) => {
  if (element) {
    const cleanup = tableDraggableCleanups.get(element);
    if (cleanup) {
      cleanup();
      tableDraggableCleanups.delete(element);
    }
    // Remove from elements map
    tableDraggableElements.forEach((el, rowId) => {
      if (el === element) {
        tableDraggableElements.delete(rowId);
      }
    });
  } else {
    // Cleanup all draggables
    tableDraggableCleanups.forEach((cleanup) => cleanup());
    tableDraggableCleanups.clear();
    tableDraggableElements.clear();
  }
};

// Drop-create target (e.g. Files → Gallery): opens review modal via DynamicPage handler
const [dropCreateDragOver, setDropCreateDragOver] = args.createSignal(false);
let dropCreateTargetCleanup = null;

const getDropCreateFromConfig = () => {
  const fromProps = args.contextData.props?.dropCreateFrom;
  if (fromProps && typeof fromProps === "object") return fromProps;
  return args.fns.getConfigGeneralValue?.("dropCreateFrom") || null;
};

const isDropCreateEnabled = () => {
  const cfg = getDropCreateFromConfig();
  return !!(cfg && cfg.enabled !== false && typeof args.contextData.props?.onDropCreateFrom === "function");
};

const initDropCreateTarget = (element) => {
  if (!element || !args.dropTargetForElements) return;
  if (!isDropCreateEnabled()) {
    if (dropCreateTargetCleanup) {
      dropCreateTargetCleanup();
      dropCreateTargetCleanup = null;
    }
    setDropCreateDragOver(false);
    return;
  }
  if (dropCreateTargetCleanup) {
    dropCreateTargetCleanup();
    dropCreateTargetCleanup = null;
  }

  dropCreateTargetCleanup = args.dropTargetForElements({
    element,
    getData: () => ({ type: "drop-create-target" }),
    canDrop: ({ source }) => {
      const data = source?.data;
      if (!data || data.type !== "table-items") return false;
      if (!Array.isArray(data.itemIds) || data.itemIds.length === 0) return false;
      const cfg = getDropCreateFromConfig();
      if (!cfg || cfg.enabled === false) return false;
      const sourceLabels = Array.isArray(cfg.sourceTableVertexLabels)
        ? cfg.sourceTableVertexLabels
        : [];
      const sourceKeys = Array.isArray(cfg.sourceTableKeys) ? cfg.sourceTableKeys : [];
      const label = data.sourceTableVertexLabel != null
        ? String(data.sourceTableVertexLabel)
        : "";
      const key = data.sourceTableKey != null ? String(data.sourceTableKey) : "";
      if (sourceLabels.length > 0 && !sourceLabels.includes(label)) return false;
      if (sourceKeys.length > 0 && !sourceKeys.includes(key)) return false;
      return true;
    },
    onDragEnter: () => setDropCreateDragOver(true),
    onDrag: () => setDropCreateDragOver(true),
    onDragLeave: () => setDropCreateDragOver(false),
    onDrop: async ({ source }) => {
      setDropCreateDragOver(false);
      const data = source?.data;
      if (!data || data.type !== "table-items") return;
      const onDropCreateFrom = args.contextData.props?.onDropCreateFrom;
      if (typeof onDropCreateFrom !== "function") return;
      try {
        await onDropCreateFrom({
          type: data.type,
          itemIds: data.itemIds,
          count: data.count,
          sourceTableVertexLabel: data.sourceTableVertexLabel,
          sourceTableKey: data.sourceTableKey
        });
      } catch (error) {
        console.error("onDropCreateFrom failed:", error);
        args.showErrorToast?.(error?.message || "Drop failed");
      }
    }
  });
};

const cleanupDropCreateTarget = () => {
  if (dropCreateTargetCleanup) {
    dropCreateTargetCleanup();
    dropCreateTargetCleanup = null;
  }
  setDropCreateDragOver(false);
};

const getSelectedItems = () => {
  const selected = getEffectiveSelectedRows();
  const filteredRows = resolvedFilteredVertices();
  const selectedIds = Array.from(selected);
  return filteredRows.filter((row) => row?.id != null && selectedIds.includes(row.id));
};

const hasActiveFilters = () => {
  const filters = tableP()?.columnFilters ?? {};
  const keys = Object.keys(filters);
  for (const k of keys) {
    const v = filters[k];
    if (v !== undefined && v !== null && v !== "") {
      if (Array.isArray(v)) {
        if (v.length > 0 && !(v.length === 1 && v[0] === "_All_VALUES_")) return true;
      } else return true;
    }
  }
  return false;
};

// --- Table scroll layout (wide columns + virtualization) ---
// - Body scrolls in one viewport-sized box (40wrap): overflow:auto so vertical and horizontal scrollbars stay visible.
// - Header/filter strips wrap the same grid width; overflow-x:hidden hides scrollbars there; scrollLeft is synced from body on scroll.
// - tableBodyVScrollEl and tableBodyHScrollEl both point at 40wrap after mount (same element for VirtualList + scrollLeft sync).
const [tableBodyVScrollEl, setTableBodyVScrollEl] = args.createSignal(null);
let tableHeaderHScrollEl = null;
let tableFilterHScrollEl = null;
let tableBodyHScrollEl = null;

const syncTableHorizontalScroll = (sourceEl) => {
  if (!sourceEl) return;
  const sl = sourceEl.scrollLeft;
  // Copy scrollLeft to the other strips; skip sourceEl so we do not fight the user's scroll or loop.
  if (tableHeaderHScrollEl && tableHeaderHScrollEl !== sourceEl && tableHeaderHScrollEl.scrollLeft !== sl) {
    tableHeaderHScrollEl.scrollLeft = sl;
  }
  if (tableFilterHScrollEl && tableFilterHScrollEl !== sourceEl && tableFilterHScrollEl.scrollLeft !== sl) {
    tableFilterHScrollEl.scrollLeft = sl;
  }
  if (tableBodyHScrollEl && tableBodyHScrollEl !== sourceEl && tableBodyHScrollEl.scrollLeft !== sl) {
    tableBodyHScrollEl.scrollLeft = sl;
  }
};

const handleTableHorizontalScroll = (e) => {
  syncTableHorizontalScroll(e.currentTarget);
};

// Approximate min width of the table grid so the body horizontal scroll region gets scrollWidth.
const getTableBodyMinWidthPx = () => {
  const template = getGridTemplateColumns();
  const parts = template.trim().split(/\s+/).filter(Boolean);
  let sum = 0;
  for (const p of parts) {
    const px = p.match(/^(\d+(?:\.\d+)?)px$/i);
    if (px) {
      sum += parseFloat(px[1]);
      continue;
    }
    if (/\d*\.?\d+fr/.test(p)) {
      sum += 120;
      continue;
    }
    if (/minmax/i.test(p)) {
      sum += 80;
      continue;
    }
    sum += 100;
  }
  return Math.max(sum, 200);
};

return {
  tableStateVertexId,
  isEmbeddedMode: () => {
    const mode = args.contextData.props?.mode || args.contextData.props?.tableMode;
    return mode === "embedded" || args.contextData.props?.embeddedMode === true;
  },
