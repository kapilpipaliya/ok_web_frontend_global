        props:
          '''const column = args.contextData.column;
const virtualItem = args.contextData.virtualItem;
if (!virtualItem) return {};
const rowIndex = virtualItem.index;
const rowData = virtualItem.rowData;
const cellContent = args.fns.renderCellContent(rowData, column, rowIndex);

// Handle different content types
if (typeof cellContent === "object" && cellContent !== null) {
  if (cellContent.type === "expand") {
    const isParent = cellContent.isParent === true;
    const isExpanded = cellContent.isExpanded === true;
    const onToggle = cellContent.onToggle;
    if (!isParent) return { as: "div", style: "width: 16px; flex-shrink: 0;" };
    const spacingSm = args.theme.var.spacing.sm;
    const spacingMd = args.theme.var.spacing.md;
    const textColor = args.theme.var.color.text;
    return {
      as: "button",
      type: "button",
      style: `display: flex; align-items: center; justify-content: center; flex: 1 1 auto; align-self: stretch; width: calc(100% + 2 * ${spacingMd}); box-sizing: border-box; margin: calc(-1 * ${spacingSm}) calc(-1 * ${spacingMd}); padding: ${spacingSm} ${spacingMd}; min-height: 2.75rem; border: none; background: transparent; cursor: pointer; border-radius: 4px; color: ${textColor};`,
      "attr:aria-label": isExpanded ? "Collapse row" : "Expand row",
      "attr:aria-expanded": isExpanded ? "true" : "false",
      onClick: (e) => {
        e.stopPropagation();
        onToggle?.();
      },
      onMouseDown: (e) => {
        e.stopPropagation();
      },
      text: isExpanded ? "▼" : "▶"
    };
  }
  if (cellContent.type === "image") {
    return {
      as: "img",
      src: cellContent.url,
      alt: cellContent.alt,
      style: "max-width: 100px; max-height: 50px; object-fit: cover; border-radius: 4px;"
    };
  }
  if (cellContent.type === "youtubeLink") {
    return {
      as: "a",
      href: `https://www.youtube.com/watch?v=${cellContent.videoId}`,
      target: "_blank",
      rel: "noopener noreferrer",
      text: "Watch",
      style: "color: " + args.theme.var.color.primary + "; text-decoration: none;"
    };
  }
  if (cellContent.type === "downloadLink") {
    return {
      as: "a",
      href: cellContent.url,
      download: true,
      style: "color: " + args.theme.var.color.primary + "; text-decoration: none; display: flex; align-items: center; gap: 4px;"
    };
  }
  if (cellContent.type === "textLink") {
    const displayText = (cellContent.text ?? "").toString();
    const hrefCandidate = cellContent.href;
    const resolvedHref =
      hrefCandidate != null && hrefCandidate !== "" ? String(hrefCandidate) : "";
    const themeColors = args.theme.var.color;
    const useEllipsis = column.overflowEllipsis === true;
    const ellipsisStyle =
      "min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;";
    if (!resolvedHref) {
      return {
        as: "span",
        text: displayText,
        title: cellContent.title,
        style: useEllipsis ? ellipsisStyle : undefined
      };
    }
    const linkStyle =
      "color: " +
      themeColors.primary +
      "; text-decoration: underline; cursor: pointer; " +
      (useEllipsis ? ellipsisStyle : "");
    return {
      as: "a",
      href: resolvedHref,
      target: "_blank",
      rel: "noopener noreferrer",
      text: displayText,
      title: cellContent.title,
      style: linkStyle,
      onClick: (event) => {
        event.stopPropagation();
      }
    };
  }
  if (cellContent.type === "iconAction") {
    const col = cellContent.actionColumn;
    const cfg = col.iconAction || {};
    const rowKey = args.fns.getIconActionRowKey(rowData, rowIndex);
    const stateKey = col.key + ":" + (rowKey != null ? rowKey : "idx-" + rowIndex);
    const isActive = args.fns.iconActionActiveKey() === stateKey;
    const isCarbonStr = (s) => typeof s === "string" && s.trim().length > 0 && !/\s/.test(s) && s.includes(":");
    const iconIdle = cfg.icon;
    const iconBusy = cfg.activeIcon;
    const useIconButton = isCarbonStr(iconIdle) || isCarbonStr(iconBusy);
    const title = isActive ? (cfg.activeTitle ?? "") : (cfg.title ?? "");
    const ariaLabel = title || col.label || col.key || "Action";
    const onAct = (e) => {
      e.stopPropagation();
      args.fns.handleIconAction(col, rowData, rowIndex);
    };
    if (useIconButton) {
      const iconName = isActive && isCarbonStr(iconBusy) ? iconBusy : (isCarbonStr(iconIdle) ? iconIdle : "carbon:link");
      return {
        componentName: "IconButton",
        icon: iconName,
        variant: cfg.variant ?? "ghost",
        size: cfg.size ?? "sm",
        title: title || ariaLabel,
        ariaLabel: ariaLabel,
        onClick: onAct
      };
    }
    const t = args.theme.var.color;
    const br = args.theme.var.borderRadius.md;
    const border = t.border_light_400;
    const bg = isActive ? (cfg.activeButtonBg || t.success_light_200) : (cfg.buttonBg || t.background);
    const fg = isActive ? (cfg.activeButtonFg || t.success_dark_300) : (cfg.buttonFg || t.primary);
    const style = typeof cfg.htmlButtonStyle === "string" ? cfg.htmlButtonStyle : ("min-width: 32px; height: 32px; padding: 0 8px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid " + border + "; border-radius: " + br + "; background: " + bg + "; color: " + fg + "; cursor: pointer; flex-shrink: 0; font-size: 1rem; line-height: 1;");
    const fallbackText = isActive ? (cfg.activeIconText ?? cfg.iconText ?? "✓") : (cfg.iconText ?? "·");
    return {
      componentName: "Html",
      as: "button",
      type: "button",
      title: title || ariaLabel,
      "attr:aria-label": ariaLabel,
      text: fallbackText,
      style,
      onClick: onAct
    };
  }
  if (cellContent.type === "actions") {
    return {
      as: "div",
      style: "display: flex; gap: 8px; align-items: center;"
    };
  }
  if (cellContent.type === "badge") {
    const text = (cellContent.text ?? "").toString().trim();
    if (!text) {
      return { as: "div", text: "", hide: true };
    }
    const usePolaris = args.fns.getUsePolarisUI?.() === true;
    const tone = cellContent.tone || "neutral";
    const title = column.badgeTitleAccessor ? column.badgeTitleAccessor(rowData) : undefined;
    if (usePolaris) {
      return {
        as: "s-badge",
        "attr:tone": tone,
        text,
        title
      };
    }
    const t = args.theme.var.color;
    const br = args.theme.var.borderRadius.full;
    const fs = "0.75rem";
    const tones = {
      success: { bg: t.success_light_200, fg: t.success_dark_300 },
      info: { bg: t.info_light_200, fg: t.info_dark_300 },
      warning: { bg: t.warning_light_200, fg: t.warning_dark_300 },
      critical: { bg: t.error_light_200, fg: t.error_dark_300 },
      caution: { bg: t.warning_light_200, fg: t.warning_dark_300 },
      neutral: { bg: t.background_light_300, fg: t.text }
    };
    const { bg, fg } = tones[tone] || tones.neutral;
    const style = `display: inline-flex; align-items: center; padding: 2px 8px; border-radius: ${br}; font-size: ${fs}; font-weight: 500; background: ${bg}; color: ${fg}; white-space: nowrap;`;
    return {
      as: "span",
      text,
      style,
      title
    };
  }
}

if (args.fns.getColumnRenderer(column) === "actions" && args.fns.getActions().some((a) => a.type === "edit")) {
  return {
    as: "div",
    style: "display: flex; gap: 8px; align-items: center;"
  };
}

// Default text rendering
const cellTitle = column.titleAccessor ? column.titleAccessor(rowData) : undefined;
const textStr = typeof cellContent === "string" || typeof cellContent === "number" ? String(cellContent) : "";
const out = {
  as: "div",
  text: textStr,
  title: cellTitle
};
if (column.overflowEllipsis) {
  out.style = "min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;";
}
return out;'''
      }
    }
