      P: {
        displayOrder: 1
        componentName: IconButton
        props:
          '''const action = args.contextData.tableAction;
const virtualItem = args.contextData.virtualItem;
if (!virtualItem || !action) return { hide: true };
const rowData = virtualItem.rowData;
const disabled = args.fns.isActionDisabled(action, rowData);
const loading = args.fns.isActionRunning(action, rowData);
const reason = args.fns.getActionReasonState(action, rowData);
const reasonAttrs = args.fns.getActionReasonDataAttrs(action, rowData);
const hrefValue = args.fns.getActionHref(action, rowData);
return {
  icon: loading ? (action.loadingIcon || "carbon:renew") : (action.icon || "carbon:overflow-menu-horizontal"),
  variant: action.variant || "ghost",
  size: "sm",
  href: hrefValue,
  target: action.target,
  rel: action.rel,
  title: reason.text,
  ariaLabel: reason.text,
  reasonVariant: reason.active ? reason.variant : undefined,
  loading,
  disabled: disabled || loading,
  ...reasonAttrs,
  onClick: (e) => {
    e.stopPropagation();
    // Modifier or middle-click: keep native <a> behavior (open href in new tab/window).
    if (hrefValue && (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button === 1)) return;
    // Plain click: do not navigate; run configured row action (e.g. open modal).
    if (hrefValue) e.preventDefault();
