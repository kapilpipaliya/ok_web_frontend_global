  getDisplayData,
  getSelectableVisibleRowIds,
  syncNestedLinesTableData,
  getGroupByConfig,
  getRowExpansionConfigs,
  getExpansionPanelHeight,
  toggleRowExpansion,
  isExpansionOpen,
  isNestedLinesTable,
  toggleExpanded,
  setCollapsedKeys: (key, val) => {
    const sk = String(key);
    const p = tableP();
    const cur = Array.isArray(p?.collapsedKeys) ? [...p.collapsedKeys] : [];
    if (val === undefined || val === false) {
      patchTableP({ collapsedKeys: cur.filter((k) => k !== sk) });
    } else {
      if (!cur.includes(sk)) cur.push(sk);
      patchTableP({ collapsedKeys: cur });
    }
  },
  iconActionActiveKey,
  handleIconAction,
  getIconActionRowKey,
  setTableBodyVScrollEl,
  getTableBodyVScrollEl: () => tableBodyVScrollEl(),
  setTableHeaderHScrollEl: (el) => {
    tableHeaderHScrollEl = el;
  },
  setTableFilterHScrollEl: (el) => {
    tableFilterHScrollEl = el;
  },
  setTableBodyHScrollEl: (el) => {
    tableBodyHScrollEl = el;
  },
  handleTableHorizontalScroll,
  getScrollContainerElementForVirtualList: () => tableBodyVScrollEl(),
  getTableBodyMinWidthPx
};
