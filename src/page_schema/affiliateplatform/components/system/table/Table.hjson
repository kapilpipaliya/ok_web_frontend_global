        displayOrder: 1
        componentName: Html
        props:
          '''const column = args.contextData.column;
const columnFilters = args.graph.vertexes[args.fns.tableStateVertexId]?.P?.columnFilters ?? {};
// Access store reactively - ensure we get the current value
const getFilterValue = () => {
  const value = columnFilters[column.key];
  if (value !== undefined) {
    return value;
  }
  // Default to empty array for select filters, empty string for others
  return args.fns.getColumnFilterKind(column) === "select" ? [] : "";
};
const filterValue = getFilterValue();

// Skip filter for rowNumber
if (args.fns.getColumnRenderer(column) === "rowNumber") {
  return { as: "div", hide: true };
}

// Skip filter for preview / image columns
if (column.key === "preview" || args.fns.getColumnRenderer(column) === "imagePreview" || args.fns.getColumnRenderer(column) === "image") {
  return { as: "div", hide: true };
}

// Skip filter for iconAction column
if (args.fns.getColumnRenderer(column) === "iconAction") {
  return { as: "div", hide: true };
}

// Skip filter for expand column
if (args.fns.getColumnRenderer(column) === "expand") {
  return { as: "div", hide: true };
}

// Render appropriate filter component based on column type
if (args.fns.getColumnFilterKind(column) === "select" && column.options) {
  const usePolaris = args.fns.getUsePolarisUI?.() === true;
  if (usePolaris) {
    const displayValue = Array.isArray(filterValue) ? filterValue.join(", ") : (filterValue || "");
    return {
      componentName: "Html",
      as: "s-search-field",
      "attr:label": column.label || "Filter",
      "attr:labelAccessibilityVisibility": "exclusive",
      value: displayValue,
      onInput: (e) => {
        const v = e?.target?.value ?? e?.detail?.value ?? "";
        const arr = v ? v.split(",").map(s => s.trim()).filter(Boolean) : undefined;
        args.fns.handleColumnFilterChange(column.key, arr && arr.length ? arr : undefined);
      }
    };
  }
  return args.fns.getSelectFilterProps(
    column.key,
    filterValue,
    [{ value: "_All_VALUES_", label: "All" }, ...column.options]
  );
}

if (args.fns.getColumnFilterKind(column) === "checkbox") {
  // const usePolaris = args.fns.getUsePolarisUI?.() === true;
  const usePolaris = false;
  const isChecked = filterValue === true || filterValue === "true";
  return {
    componentName: "Html",
    as: usePolaris ? "s-checkbox" : "input",
    type: usePolaris ? undefined : "checkbox",
    "attr:checked": usePolaris && isChecked ? true : undefined,
    "attr:accessibilityLabel": usePolaris ? `Filter ${column.label || column.key}` : undefined,
    checked: usePolaris ? undefined : isChecked,
    onChange: (e) => {
      const checked = usePolaris ? (e.target?.checked ?? e.detail?.checked ?? !isChecked) : e.target.checked;
      args.fns.handleColumnFilterChange(column.key, checked);
    },
    css: usePolaris ? undefined : "return `._id { pointer-events: auto; cursor: pointer; width: 1rem; height: 1rem; accent-color: ${args.theme?.var?.color?.text ?? 'inherit'}; flex-shrink: 0; }`;"
  };
}

if (args.fns.getColumnFilterKind(column) === "date") {
  const usePolaris = args.fns.getUsePolarisUI?.() === true;
  if (usePolaris) {
    return {
      componentName: "Html",
      as: "s-search-field",
      "attr:label": column.label || "Filter",
      "attr:labelAccessibilityVisibility": "exclusive",
      value: filterValue || "",
      onInput: (e) => args.fns.handleColumnFilterChange(column.key, e?.target?.value ?? e?.detail?.value ?? "")
    };
  }
  return {
    componentName: "TextInput",
    type: "date",
    value: filterValue || "",
    onChange: (e) => args.fns.handleColumnFilterChange(column.key, e.target.value)
  };
}

// Badge columns: show select from badgeToneMap when available, so filter works by raw value
if (args.fns.getColumnRenderer(column) === "badge" && column.badgeToneMap) {
  const options = [{ value: "_All_VALUES_", label: "All" }, ...Object.entries(column.badgeToneMap).map(([val, arr]) => ({ value: val, label: Array.isArray(arr) ? arr[0] : String(arr) }))];
  const usePolaris = args.fns.getUsePolarisUI?.() === true;
  if (usePolaris) {
    const displayValue = Array.isArray(filterValue) ? filterValue.join(", ") : (filterValue || "");
    return {
      componentName: "Html",
      as: "s-search-field",
      "attr:label": column.label || "Filter",
      "attr:labelAccessibilityVisibility": "exclusive",
      value: displayValue,
      onInput: (e) => {
        const v = e?.target?.value ?? e?.detail?.value ?? "";
        const arr = v ? v.split(",").map(s => s.trim()).filter(Boolean) : undefined;
        args.fns.handleColumnFilterChange(column.key, arr && arr.length ? arr : undefined);
      }
    };
  }
  return args.fns.getSelectFilterProps(column.key, filterValue, options);
}

// Determine filter type (default: "select" for text columns)
const filterType = column.filterType || (args.fns.getColumnFilterKind(column) === "text" ? "text" : "select");

// If filterType is "select", show select with unique values
if (filterType === "select") {
  const usePolaris = args.fns.getUsePolarisUI?.() === true;
  if (usePolaris) {
    const displayValue = Array.isArray(filterValue) ? filterValue.join(", ") : (filterValue || "");
    return {
      componentName: "Html",
      as: "s-search-field",
      "attr:label": column.label || "Filter",
      "attr:labelAccessibilityVisibility": "exclusive",
      value: displayValue,
      onInput: (e) => {
        const v = e?.target?.value ?? e?.detail?.value ?? "";
        const arr = v ? v.split(",").map(s => s.trim()).filter(Boolean) : undefined;
        args.fns.handleColumnFilterChange(column.key, arr && arr.length ? arr : undefined);
      }
    };
  }
  const uniqueValues = args.fns.getUniqueColumnValues(column);
  const options = [{ value: "_All_VALUES_", label: "All" }, ...uniqueValues.map(val => ({ value: val, label: val }))];
  return args.fns.getSelectFilterProps(
    column.key,
    filterValue,
    options
  );
}

// Default: text input (applies filter immediately on change)
const usePolaris = args.fns.getUsePolarisUI?.() === true;
if (usePolaris) {
  return {
    componentName: "Html",
    as: "s-search-field",
    "attr:label": column.label || "Filter",
    "attr:labelAccessibilityVisibility": "exclusive",
    value: filterValue || "",
    onInput: (e) => args.fns.handleColumnFilterChange(column.key, e?.target?.value ?? e?.detail?.value ?? "")
  };
}
return {
  componentName: "TextInput",
  type: "text",
  value: filterValue || "",
  onChange: (e) => args.fns.handleColumnFilterChange(column.key, e.target.value)
};'''
      }
    }
