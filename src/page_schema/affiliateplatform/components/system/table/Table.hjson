    {
      id: "88"
      L: Attr
      P: {
        displayOrder: 8
        componentName: TableSettingsModal
        props:
          '''const vid = args.fns.pageStateVertexId;
const pageDp = () => args.graph.vertexes[vid]?.P;
const tableKey = args.fns.getTableKey?.() ?? args.contextData.props?.tableKey;
const tableVertexLabel = args.fns.getTableVertexLabel?.();

return {
  isOpen: pageDp()?.isSettingsModalOpen === true,
  onClose: () => {
    args.mergeVertexProperties(0, vid, args.graph, args.setGraph, {
      isSettingsModalOpen: false
    });
  },
  tableKey,
  tableVertexLabel,
  onSaved: () => {
    args.mergeVertexProperties(0, vid, args.graph, args.setGraph, {
      isSettingsModalOpen: false
    });
  }
};'''
      }
    }
