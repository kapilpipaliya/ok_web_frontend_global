          '''const virtualItem = args.contextData.virtualItem;
if (!virtualItem) return { hide: true };
const rowData = virtualItem.rowData;
const rowId = rowData?.id;
const rowExpansion = args.contextData.expansionTable || {};
if (!rowId || !rowExpansion || typeof rowExpansion !== "object") return { hide: true };
const expansionRowKey = String(rowId);
const outerArgs = args;
const tableVid = outerArgs.fns.tableStateVertexId;
const expansionIndex = rowExpansion._expansionIndex != null ? Number(rowExpansion._expansionIndex) : 0;
const expansionKey = "exp_" + expansionIndex;
let rows = [];
let loading = false;

if (rowExpansion.childVertexLabel) {
  const expP = args.graph.vertexes[tableVid]?.P;
  const expRows = expP?.expansionRows;
  if (Array.isArray(expRows)) {
    for (let i = 0; i < expRows.length; i++) {
      const e = expRows[i];
      if (
        e &&
        e.id != null &&
        String(e.id) === expansionRowKey &&
        e.key != null &&
        String(e.key) === expansionKey
      ) {
        rows = Array.isArray(e.rows) ? e.rows : [];
        break;
      }
    }
  }
  const expLoading = expP?.expansionLoading;
  if (Array.isArray(expLoading)) {
    for (let i = 0; i < expLoading.length; i++) {
      const lid = expLoading[i];
      if (lid != null && String(lid) === expansionRowKey + "::" + expansionKey) {
        loading = true;
        break;
      }
    }
  }
} else if (typeof rowExpansion.getNestedRows === "function") {
  try {
    const computedRows = rowExpansion.getNestedRows(rowData, args);
    rows = Array.isArray(computedRows) ? computedRows : [];
  } catch (e) {
    rows = [];
  }
}

if (loading || !Array.isArray(rows) || rows.length === 0) return { hide: true };
return {
  hide: false,
  nestedLinesMode: true,
  nestedTableTitle: rowExpansion.nestedTitle || 'Nested',
  nestedTableColumns: rowExpansion.nestedColumns || [],
  nestedRowHeight: rowExpansion.nestedRowHeight || 36,
  nestedShowIcon: rowExpansion.nestedShowIcon === true,
  nestedIcon: rowExpansion.nestedIcon,
  nestedLinesContainerHeight: rowExpansion.expansionPanelHeight ?? 280,
  nestedLinesContainerMaxHeight: rowExpansion.expansionPanelMaxHeight ?? rowExpansion.expansionPanelHeight ?? 280,
  showRowNumber: rowExpansion.nestedShowRowNumber !== false,
  usePolarisUI: rowExpansion.usePolarisUI !== false,
  loadFromSetting: false,
  getNestedLineRows: () => rows,
  getNestedLinesLoading: () => loading,
  getSelectedRows: () => new Set(),
  setSelectedRows: () => {},
  clearSelectedRows: () => {},
  rowClickable: rowExpansion.rowClickable ?? false,
  onRowClick: rowExpansion.onRowClick ?? function () {}
};'''
