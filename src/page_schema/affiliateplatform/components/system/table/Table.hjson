      P: {
        slotName: children
        css:
          '''const virtualItem = args.contextData.virtualItem;
if (!virtualItem) return {};
const rowIndex = virtualItem.index;
const rowData = virtualItem.rowData;
const selectedRows = args.fns.getSelectedRows();
const isSelected = rowData?.id ? selectedRows.has(rowData.id) : false;
const isActive = args.fns.activeRowId?.() === rowData?.id;
const rowHeightPx = args.fns.getRowHeight();

return [
`._id {
  width: max-content;
  min-width: 100%;
  height: ${rowHeightPx}px;
  max-height: ${rowHeightPx}px;
  min-height: ${rowHeightPx}px;
  box-sizing: border-box;
  overflow: hidden;
}`,
`._id {
  display: grid;
  grid-template-columns: ${args.fns.getGridTemplateColumns()};
  grid-template-rows: ${rowHeightPx}px;
  grid-column: 1 / -1;
  border-bottom: 1px solid ${args.theme.var.color.border};
  background: ${isSelected ? args.theme.var.color.background_light_200 : "transparent"};
  transition: background 0.2s ease;
  ${isActive ? `outline: 2px solid ${args.theme.var.color.primary}; outline-offset: -2px;` : ""}

  &:hover {
    background: ${isSelected ? args.theme.var.color.background_light_200 : args.theme.var.color.background_light_100};
  }
}`];'''
        displayOrder: 2
        componentName: Html
        props:
          '''const virtualItem = args.contextData.virtualItem;
if (!virtualItem) return {};
const rowIndex = virtualItem.index;
const rowData = virtualItem.rowData;

const showSelection = args.fns.getShowSelection();
const rowClickable = args.fns.getRowClickable?.();
const onRowClick = args.fns.getOnRowClick?.();

const selected = args.fns.getSelectedRows();
const hasSelection = selected.size > 0;

const handleRowClick = (e) => {
  if (onRowClick && typeof onRowClick === "function") {
    onRowClick(rowData, args);
  } else if (rowClickable) {
    args.fns.handleEdit?.(rowData);
  } else {
    args.fns.handleViewRow?.(rowData);
  }
};

const isRowClickable = rowClickable || (typeof onRowClick === "function");
const cursorStyle = isRowClickable ? "cursor: pointer;" : (hasSelection ? "cursor: move;" : undefined);

return {
  as: "div",
  role: "option",
  tabIndex: -1,
  "attr:aria-selected": args.fns.activeRowId?.() === rowData?.id,
  "data-row-id": rowData?.id ?? undefined,
  ref: (el) => {
    args.fns.setRowRef?.(rowIndex, el ?? null);
    if (el && args.fns.initTableDraggable) {
      args.fns.initTableDraggable(el);
    }
  },
  onCleanup: () => {
    const el = args.fns.getRowRef?.(rowIndex) ?? args.ref?.();
    args.fns.setRowRef?.(rowIndex, null);
    if (args.fns.cleanupTableDraggable && el) {
      args.fns.cleanupTableDraggable(el);
    }
  },
  onClick: (event) => {
    args.mergeVertexProperties(0, args.fns.tableStateVertexId, args.graph, args.setGraph, { activeRowId: rowData?.id ?? null });
    if (isRowClickable) handleRowClick(event);
  },
  style: cursorStyle
};'''
