const rowId = rowData?.id;
const rowExpansions = args.fns.getRowExpansionConfigs?.() || [];
const rowExpansion = Array.isArray(rowExpansions) && rowExpansions.length > 0 ? rowExpansions[0] : null;
if (!rowExpansion || !rowId) return { as: 'div', hide: true };
const expansionRowKey = String(rowId);
const expansionKey = "exp_0";
const isRowExpansionOpen = args.fns.isExpansionOpen?.(expansionRowKey);
if (!isRowExpansionOpen) return { as: 'div', hide: true };
const expP = args.graph.vertexes[args.fns.tableStateVertexId]?.P;
let rows;
const expRows = expP?.expansionRows;
if (Array.isArray(expRows)) {
  for (let i = 0; i < expRows.length; i++) {
    const e = expRows[i];
    if (e && e.id != null && String(e.id) === expansionRowKey && String(e.key || "") === expansionKey && e.rows !== undefined) {
      rows = e.rows;
      break;
    }
  }
}
let loading = false;
const expLoading = expP?.expansionLoading;
if (Array.isArray(expLoading)) {
  for (let i = 0; i < expLoading.length; i++) {
    const lid = expLoading[i];
    if (lid != null && lid !== '' && String(lid) === expansionRowKey + "::" + expansionKey) {
      loading = true;
      break;
    }
  }
}
const hasRows = Array.isArray(rows) && rows.length > 0;
const show = loading || !hasRows;
return {
  as: 'div',
  text: loading
    ? (rowExpansion.nestedLoadingText || 'Loading…')
    : (rowExpansion.emptyNestedText || 'No line items'),
  hide: !show,
  onClick: (e) => e.stopPropagation()
};'''
