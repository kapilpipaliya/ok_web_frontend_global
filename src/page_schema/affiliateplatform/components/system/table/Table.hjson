  type: isDanger ? "danger" : "default",
  title: reason.text,
  reasonVariant: reason.active ? reason.variant : undefined,
  disabled: disabled || loading,
  ...reasonAttrs,
  onClick: (e) => {
    e?.stopPropagation();
