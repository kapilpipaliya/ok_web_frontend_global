{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        dynamicComponent: TextInput, TextArea, Button, FormLocalizedText
        key: FormFieldArray
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id.fm-field-array {
  display: flex;
  flex-direction: column;
  gap: ${args.theme.var.spacing.md};
  width: 100%;
}`;'''
        displayOrder: 1
        fns:
          '''const getProps = () => args.contextData.props || {};
const getField = () => getProps().field || {};
const getConfig = () => getField().fieldArrayConfig || {};

const getItemFields = () => {
  const itemFields = getConfig().itemFields;
  return Array.isArray(itemFields) ? itemFields : [];
};

const parseItems = (value) => {
  if (Array.isArray(value)) return value.map((item) => ({ ...(item || {}) }));
  if (typeof value === "string" && value.trim() !== "") {
    try {
      const parsed = JSON.parse(value);
      return Array.isArray(parsed) ? parsed.map((item) => ({ ...(item || {}) })) : [];
    } catch {
      return [];
    }
  }
  return [];
};

const getItems = () => parseItems(getProps().value);

const commitItems = (items) => {
  getProps().onChange?.(items);
};

const buildDefaultItem = () => {
  const item = {};
  const itemFields = getItemFields();
  for (let fieldIndex = 0; fieldIndex < itemFields.length; fieldIndex++) {
    const itemField = itemFields[fieldIndex];
    if (!itemField?.key) continue;
    if (itemField.defaultValue !== undefined) {
      item[itemField.key] = itemField.defaultValue;
    } else if (itemField.dataType === "boolean" || itemField.renderer === "checkbox") {
      item[itemField.key] = false;
    } else if (itemField.translatable === true) {
      item[itemField.key] = {};
    } else {
      item[itemField.key] = "";
    }
  }
  return item;
};

const updateItemField = (itemIndex, fieldKey, fieldValue) => {
  const items = getItems();
  if (!items[itemIndex]) return;
  const nextItems = items.map((item, index) =>
    index === itemIndex ? { ...item, [fieldKey]: fieldValue } : item
  );
  commitItems(nextItems);
};

const addItem = () => {
  const config = getConfig();
  const items = getItems();
  if (config.maxItems != null && items.length >= Number(config.maxItems)) return;
  commitItems([...items, buildDefaultItem()]);
};

const removeItem = (itemIndex) => {
  const config = getConfig();
  const items = getItems();
  if (config.minItems != null && items.length <= Number(config.minItems)) return;
  commitItems(items.filter((_, index) => index !== itemIndex));
};

const reorderItems = (fromIndex, toIndex) => {
  const items = getItems();
  if (fromIndex === toIndex || fromIndex < 0 || toIndex < 0) return;
  if (fromIndex >= items.length || toIndex >= items.length) return;
  const nextItems = [...items];
  const [moved] = nextItems.splice(fromIndex, 1);
  nextItems.splice(toIndex, 0, moved);
  commitItems(nextItems);
};

const fieldArrayDraggableCleanups = new Map();
const [draggedItemIndex, setDraggedItemIndex] = args.createSignal(null);
const [dragOverItemIndex, setDragOverItemIndex] = args.createSignal(null);

const initFieldArrayDraggable = (element, itemIndex) => {
  if (!element || !args.draggable || args.fns.isDisabled?.()) return;

  const existingCleanup = fieldArrayDraggableCleanups.get(element);
  if (existingCleanup) existingCleanup();

  const cleanup = args.draggable({
    element,
    getInitialData: () => ({
      type: "field-array-item",
      index: itemIndex
    }),
    onDragStart: () => setDraggedItemIndex(itemIndex),
    onDrop: () => {
      setDraggedItemIndex(null);
      setDragOverItemIndex(null);
    }
  });

  fieldArrayDraggableCleanups.set(element, cleanup);
};

const initFieldArrayDropTarget = (element, itemIndex) => {
  if (!element || !args.dropTargetForElements || args.fns.isDisabled?.()) return null;

  return args.dropTargetForElements({
    element,
    canDrop: ({ source }) => source.data?.type === "field-array-item",
    onDragEnter: ({ source }) => {
      if (typeof source.data?.index === "number") {
        setDragOverItemIndex(itemIndex);
      }
    },
    onDragLeave: () => setDragOverItemIndex(null),
    onDrop: ({ source }) => {
      const fromIndex = source.data?.index;
      if (typeof fromIndex === "number") {
        reorderItems(fromIndex, itemIndex);
      }
      setDraggedItemIndex(null);
      setDragOverItemIndex(null);
    }
  });
};

const cleanupFieldArrayDraggable = (element) => {
  const cleanup = fieldArrayDraggableCleanups.get(element);
  if (cleanup) {
    cleanup();
    fieldArrayDraggableCleanups.delete(element);
  }
};

const isItemDragging = (itemIndex) => draggedItemIndex() === itemIndex;
const isItemDragOver = (itemIndex) => dragOverItemIndex() === itemIndex;

// Use stable numeric indices for loop data so Solid <For> does not remount rows on each keystroke.
const getItemIndices = () => {
  const items = getItems();
  const indices = [];
  for (let index = 0; index < items.length; index++) {
    indices.push(index);
  }
  return indices;
};

const getItemAt = (itemIndex) => getItems()[itemIndex] || {};

const getItemLabel = (itemIndex) =>
  `${getConfig().itemLabel || "Item"} ${itemIndex + 1}`;

const getItemFieldValue = (item, itemField) => {
  if (!itemField?.key) return "";
  const value = item?.[itemField.key];
  if (value == null) {
    return itemField.translatable === true ? {} : "";
  }
  return value;
};

const isItemFieldTranslatable = (itemField) => itemField?.translatable === true;

const DEFAULT_SITE_LANGUAGES = [
  { code: "en", label: "English", isDefault: true },
  { code: "hi", label: "Hindi", isDefault: false },
  { code: "gu", label: "Gujarati", isDefault: false }
];

const getSiteLanguages = () => {
  const languages = getProps().siteLanguages;
  if (Array.isArray(languages) && languages.length > 0) return languages;
  return DEFAULT_SITE_LANGUAGES;
};

const isDisabled = () => getProps().disabled === true;

return {
  getField,
  getConfig,
  getItemFields,
  getItemIndices,
  getItemAt,
  getItemLabel,
  addItem,
  removeItem,
  reorderItems,
  updateItemField,
  getItemFieldValue,
  isItemFieldTranslatable,
  getSiteLanguages,
  isDisabled,
  initFieldArrayDraggable,
  initFieldArrayDropTarget,
  cleanupFieldArrayDraggable,
  isItemDragging,
  isItemDragOver
};'''
        componentName: Html
        props:
          '''return {
  as: "div",
  class: "fm-field-array"
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        contextName: fieldArrayItem
        loop: true
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  data: args.fns.getItemIndices()
};'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''const itemIndex = args.contextData.fieldArrayItem;
const dragOver = args.fns.isItemDragOver?.(itemIndex);
const dragging = args.fns.isItemDragging?.(itemIndex);
return `._id.fm-field-array-item {
  display: flex;
  flex-direction: column;
  gap: ${args.theme.var.spacing.sm};
  padding: ${args.theme.var.spacing.md};
  border: 1px solid ${dragOver ? args.theme.var.color.primary : args.theme.var.color.border};
  border-radius: 0.5rem;
  background: ${args.theme.var.color.background_light_50};
  ${dragging ? "opacity: 0.55;" : ""}
  ${dragOver ? `outline: 2px dashed ${args.theme.var.color.primary};` : ""}
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const itemIndex = args.contextData.fieldArrayItem;
return {
  as: "div",
  class: "fm-field-array-item",
  ref: (element) => {
    if (element && args.fns.initFieldArrayDropTarget) {
      const dropCleanup = args.fns.initFieldArrayDropTarget(element, itemIndex);
      element.__fmFieldArrayDropCleanup = dropCleanup;
    } else if (element?.__fmFieldArrayDropCleanup) {
      element.__fmFieldArrayDropCleanup();
      element.__fmFieldArrayDropCleanup = null;
    }
  }
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id.fm-field-array-item-header {
  display: flex;
  align-items: flex-start;
  gap: ${args.theme.var.spacing.sm};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  class: "fm-field-array-item-header"
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          '''return `._id.fm-field-array-drag-handle {
  flex-shrink: 0;
  color: ${args.theme.var.color.text_light_500};
  cursor: grab;
}`;'''
        displayOrder: 0
        componentName: Html
        props:
          '''const itemIndex = args.contextData.fieldArrayItem;
return {
  as: "icon",
  icon: "ph:dots-six-vertical",
  height: 16,
  width: 16,
  class: "fm-field-array-drag-handle",
  hide: args.fns.isDisabled?.(),
  ref: (element) => {
    const index = args.contextData.fieldArrayItem;
    if (element && args.fns.initFieldArrayDraggable) {
      args.fns.initFieldArrayDraggable(element, index);
    } else if (element === null && args.fns.cleanupFieldArrayDraggable) {
      args.fns.cleanupFieldArrayDraggable(element);
    }
  }
};'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''return `._id.fm-field-array-item-header-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: ${args.theme.var.spacing.sm};
  flex: 1;
  min-width: 0;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  class: "fm-field-array-item-header-main"
};'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        css:
          '''return `._id.fm-field-array-item-title {
  font-size: 0.875rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const itemIndex = args.contextData.fieldArrayItem;
return {
  as: "div",
  text: args.fns.getItemLabel(itemIndex),
  class: "fm-field-array-item-title"
};'''
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Button
        props:
          '''const itemIndex = args.contextData.fieldArrayItem;
return {
  variant: "danger",
  size: "sm",
  text: "Remove",
  type: "button",
  disabled: args.fns.isDisabled(),
  onClick: () => args.fns.removeItem(itemIndex)
};'''
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        contextName: fieldArrayField
        css:
          '''return `._id.fm-field-array-field {
  display: flex;
  flex-direction: column;
  gap: ${args.theme.var.spacing.xs};
  width: 100%;
}`;'''
        loop: true
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "div",
  class: "fm-field-array-field",
  data: args.fns.getItemFields()
};'''
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        css:
          '''return `._id.fm-field-array-field-label {
  font-size: 0.875rem;
  font-weight: 500;
  color: ${args.theme.var.color.text};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const itemField = args.contextData.fieldArrayField || {};
return {
  as: "label",
  text: itemField.label || itemField.key || "Field",
  class: "fm-field-array-field-label"
};'''
      }
    }
    {
      id: "12"
      L: Attr
      P: {
        displayOrder: 2
        componentName: FormLocalizedText
        props:
          '''const itemField = args.contextData.fieldArrayField || {};
const itemIndex = args.contextData.fieldArrayItem;
const isTranslatable = args.fns.isItemFieldTranslatable?.(itemField);
const isTextArea = itemField.renderer === "textArea";
const hide = !isTranslatable;
const value = args.fns.getItemFieldValue(args.fns.getItemAt(itemIndex), itemField);
return {
  hide,
  languages: args.fns.getSiteLanguages?.(),
  value: typeof value === "object" && value != null ? value : {},
  multiline: isTextArea,
  onChange: (nextValue) => args.fns.updateItemField(itemIndex, itemField.key, nextValue),
  required: itemField.required === true,
  disabled: args.fns.isDisabled()
};'''
      }
    }
    {
      id: "13"
      L: Attr
      P: {
        displayOrder: 2
        componentName: TextArea
        props:
          '''const itemField = args.contextData.fieldArrayField || {};
const itemIndex = args.contextData.fieldArrayItem;
const hide = itemField.renderer !== "textArea" || args.fns.isItemFieldTranslatable?.(itemField);
const value = args.fns.getItemFieldValue(args.fns.getItemAt(itemIndex), itemField);
return {
  hide,
  value: typeof value === "string" ? value : "",
  onChange: (e) => args.fns.updateItemField(itemIndex, itemField.key, e.target.value),
  placeholder: itemField.placeholder || "",
  required: itemField.required === true,
  disabled: args.fns.isDisabled()
};'''
      }
    }
    {
      id: "14"
      L: Attr
      P: {
        displayOrder: 3
        componentName: TextInput
        props:
          '''const itemField = args.contextData.fieldArrayField || {};
const itemIndex = args.contextData.fieldArrayItem;
const hide = itemField.renderer === "textArea" || args.fns.isItemFieldTranslatable?.(itemField);
const value = args.fns.getItemFieldValue(args.fns.getItemAt(itemIndex), itemField);
return {
  hide,
  value: typeof value === "string" ? value : "",
  onChange: (e) => args.fns.updateItemField(itemIndex, itemField.key, e.target.value),
  placeholder: itemField.placeholder || "",
  required: itemField.required === true,
  disabled: args.fns.isDisabled(),
  type: itemField.dataType === "number" ? "number" : "text"
};'''
      }
    }
    {
      id: "15"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Button
        props:
          '''return {
  variant: "secondary",
  text: args.fns.getConfig()?.addButtonLabel || "Add item",
  type: "button",
  disabled: args.fns.isDisabled(),
  onClick: () => args.fns.addItem()
};'''
      }
    }
  ]
