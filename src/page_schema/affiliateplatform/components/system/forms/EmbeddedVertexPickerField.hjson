{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        title: Embedded vertex picker field
        key: EmbeddedVertexPickerField
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  width: 100%;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 1rem;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''return `._id {
  width: 88px;
  height: 88px;
  border-radius: 0.5rem;
  border: 1px solid ${t.var.color.border};
  background: ${t.var.color.background_light_100};
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const previewUrl = String(c.props?.previewUrl || "").trim();
const showImage = c.props?.showImagePreview !== false;
const hasImg = showImage && previewUrl && /\.(png|jpe?g|gif|webp|svg)$/i.test(previewUrl);
const multiValues = c.props?.values;
const isMulti =
  Array.isArray(multiValues) ||
  c.props?.pickerConfiguration?.selectionMode === "multiple";
return {
  as: "div",
  hide: () => !showImage || (isMulti && !hasImg)
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''const previewUrl = String(c.props?.previewUrl || "").trim();
const showImage = c.props?.showImagePreview !== false;
const hasImg = showImage && previewUrl && /\.(png|jpe?g|gif|webp|svg)$/i.test(previewUrl);
return {
  as: "img",
  src: hasImg ? previewUrl : "",
  alt: "",
  hide: () => !hasImg,
  style: "width:100%;height:100%;object-fit:cover;"
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css: "return `._id { color: ${t.var.color.text_dark_400}; }`;"
        displayOrder: 2
        componentName: Html
        props:
          '''const previewUrl = String(c.props?.previewUrl || "").trim();
const showImage = c.props?.showImagePreview !== false;
const hasImg = showImage && previewUrl && /\.(png|jpe?g|gif|webp|svg)$/i.test(previewUrl);
return {
  as: "icon",
  icon: "ph:image-square",
  width: 40,
  height: 40,
  hide: () => !!hasImg
};'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''return `._id {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}`;'''
        displayOrder: 2
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 0.8rem;
  font-weight: 600;
  color: ${t.var.color.text};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const fieldLabel = c.props?.label;
const labelText =
  fieldLabel != null && String(fieldLabel).trim() !== "" ? String(fieldLabel).trim() : "";
return {
  as: "div",
  hide: labelText === "",
  text: labelText
};'''
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 0.85rem;
  color: ${t.var.color.text_dark_400};
  word-break: break-word;
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const secondaryLabel = c.props?.secondaryLabel;
const secondaryText =
  secondaryLabel != null && String(secondaryLabel).trim() !== ""
    ? String(secondaryLabel).trim()
    : "";
return {
  as: "div",
  hide: secondaryText === "",
  text: secondaryText
};'''
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 0.5rem;
}`;'''
        displayOrder: 2
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''const disabled = !!c.props?.disabled;
const usePolaris = c.props?.usePolarisUI === true;
if (usePolaris) {
  return {
    as: "s-button",
    "attr:variant": "primary",
    text:
      c.props?.chooseButtonLabel != null
        ? String(c.props.chooseButtonLabel)
        : "",
    disabled,
    onClick: () => c.props?.onOpenPicker?.()
  };
}
return {
  as: "button",
  type: "button",
  disabled,
  text: String(c.props?.chooseButtonLabel || "Select…"),
  onClick: () => c.props?.onOpenPicker?.()
};'''
      }
    }
    {
      id: "12"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''const disabled = !!c.props?.disabled;
const multiValues = c.props?.values;
const hasMulti = Array.isArray(multiValues) && multiValues.length > 0;
const hasSingle = !!(
  c.props?.value != null && String(c.props?.value).trim() !== ""
);
const hasValue = hasMulti || hasSingle;
const usePolaris = c.props?.usePolarisUI === true;
if (usePolaris) {
  return {
    as: "s-button",
    "attr:variant": "tertiary",
    text:
    c.props?.clearButtonLabel != null
      ? String(c.props.clearButtonLabel)
      : "",
    disabled: disabled || !hasValue,
    onClick: () => c.props?.onClear?.()
  };
}
return {
  as: "button",
  type: "button",
  disabled: disabled || !hasValue,
  text:
    c.props?.clearButtonLabel != null
      ? String(c.props.clearButtonLabel)
      : "",
  onClick: () => c.props?.onClear?.()
};'''
      }
    }
  ]
