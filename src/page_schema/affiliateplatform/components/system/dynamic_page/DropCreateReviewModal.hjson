        props:
          '''const draftRow = c.draftRow;
const url = f.getPreviewUrl(draftRow);
const mime = String(draftRow?.mimeType || draftRow?.fileType || "");
let icon = "ph:file";
if (mime.startsWith("video/")) icon = "ph:video";
else if (mime === "application/pdf" || mime.includes("pdf")) icon = "ph:file-pdf";
return {
  as: "icon",
  icon,
  width: 22,
  height: 22,
  hide: !!url
};'''
      }
    }
