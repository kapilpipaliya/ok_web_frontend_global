    {
      id: "14"
      L: Attr
      P: {
        displayOrder: 2
        componentName: FormManagement
        props:
          '''const p = f.getProps();
const draftRow = c.draftRow;
const rowIndex = c.draftRow_index;
return {
  formConfig: p.formConfig,
  mode: "add",
  inModal: true,
  hideActionsBar: true,
  vertexLabel: p.tableVertexLabel || "GalleryItem",
  onSave: f.buildRowSaveHandler(draftRow, rowIndex),
  onFnsReady: (formApi) => f.registerFormApi(draftRow, rowIndex, formApi),
  hide: !p.formConfig
};'''
      }
