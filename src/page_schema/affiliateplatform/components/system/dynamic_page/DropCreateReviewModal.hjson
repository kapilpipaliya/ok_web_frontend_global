        displayOrder: 3
        componentName: Html
        props:
          '''const rowIndex = c.draftRow_index;
const draftRow = c.draftRow;
const label = f.getProps()?.removeRowLabel || "Remove";
return {
  as: "button",
  type: "button",
  text: label,
  disabled: f.isConfirming(),
  onClick: () => f.removeRow(draftRow, rowIndex),
  "attr:aria-label": label
};'''
      }
