{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        description: Review modal for drag-drop create using FormManagement per draft row.
        fns:
          '''
const getProps = () => c.props || {};

const [formApisByKey, setFormApisByKey] = _.createStore({});

const getRows = () => {
  const rows = getProps().rows;
  return Array.isArray(rows) ? rows : [];
};

const rowKey = (row, rowIndex) => {
  if (row?.fileId) return String(row.fileId);
  return `idx-${rowIndex}`;
};

const isConfirming = () => getProps().confirming === true;

const getPreviewUrl = (row) => {
  if (!row) return "";
  if (row.previewUrl) return String(row.previewUrl);
  const fileName = row.fileName != null ? String(row.fileName).trim() : "";
  if (!fileName) return "";
  const mime = String(row.mimeType || row.fileType || "");
  if (mime && !mime.startsWith("image/")) return "";
  const prefix = getProps().fileDownloadUrlPrefix || "/api/file/download";
  return `${prefix}/${encodeURIComponent(fileName)}`;
};

const registerFormApi = (row, rowIndex, formApi) => {
  const key = rowKey(row, rowIndex);
  setFormApisByKey(key, formApi);
  if (!row || !formApi?.setFieldValue) return;

  // Prefill editable fields + file relationship after FormManagement initializes.
  if (row.title != null) formApi.setFieldValue("title", row.title);
  if (row.mediaType != null) formApi.setFieldValue("mediaType", row.mediaType);
  if (row.description != null) formApi.setFieldValue("description", row.description);
  if (row.fileId) {
    formApi.setFieldValue("file", row.fileId);
    const mime = String(row.mimeType || row.fileType || "").toLowerCase();
    if (mime.startsWith("image/")) {
      formApi.setFieldValue("thumbnail", row.fileId);
    }
  }
};

const removeRow = (row, rowIndex) => {
  const key = rowKey(row, rowIndex);
  const api = formApisByKey[key];
  if (api?.formTxnId) {
    const txnId = typeof api.formTxnId === "function" ? api.formTxnId() : api.formTxnId;
    if (txnId && txnId > 0) {
      _.revertTransaction(txnId);
    }
  }
  setFormApisByKey(key, undefined);
  getProps().onRemoveRow?.(rowIndex);
};

const handleConfirm = async () => {
  if (isConfirming()) return;
  const rows = getRows();
  if (rows.length === 0) {
    _.showErrorToast?.(getProps().emptyHint || "No rows to create");
    return;
  }

  const onSaveRow = getProps().onSaveRow;
  if (typeof onSaveRow !== "function") {
    _.showErrorToast?.("Save handler missing");
    return;
  }

  getProps().onConfirmStart?.();

  const createdIds = [];
  try {
    for (let i = 0; i < rows.length; i++) {
      const draft = rows[i];
      const api = formApisByKey[rowKey(draft, i)];
      if (!api?.handleSave) {
        _.showErrorToast?.("Form not ready for row " + (i + 1));
        getProps().onConfirmEnd?.(createdIds);
        return;
      }
      const result = await api.handleSave();
      if (!result) {
        getProps().onConfirmEnd?.(createdIds);
        return;
      }
      const id =
        result?.data?.id ||
        result?.result?.data?.id ||
        result?.id ||
        null;
      if (id) createdIds.push(String(id));
    }
    getProps().onConfirmSuccess?.(createdIds);
  } catch (error) {
    console.error("DropCreateReviewModal confirm:", error);
    _.showErrorToast?.(error?.message || "Failed to create items");
    getProps().onConfirmEnd?.(createdIds);
  }
};

const handleCancel = () => {
  if (isConfirming()) return;
  Object.keys(formApisByKey).forEach((key) => {
    const api = formApisByKey[key];
    if (api?.formTxnId) {
      const txnId = typeof api.formTxnId === "function" ? api.formTxnId() : api.formTxnId;
      if (txnId && txnId > 0) _.revertTransaction(txnId);
    }
  });
  setFormApisByKey(_.reconcile({}));
  getProps().onCancel?.();
};

const buildRowSaveHandler = (row, rowIndex) => {
  return async (saveData) => {
    const draft = getRows().find((r, i) => rowKey(r, i) === rowKey(row, rowIndex)) || row;
    const onSaveRow = getProps().onSaveRow;
    if (typeof onSaveRow !== "function") return false;
    return await onSaveRow(draft, saveData, rowIndex);
  };
};

return {
  getProps,
  getRows,
  rowKey,
  isConfirming,
  getPreviewUrl,
  registerFormApi,
  removeRow,
  handleConfirm,
  handleCancel,
  buildRowSaveHandler
};
'''
        key: DropCreateReviewModal
        updatedAt: 2026-07-16T18:05:54.558Z
      }
    }
