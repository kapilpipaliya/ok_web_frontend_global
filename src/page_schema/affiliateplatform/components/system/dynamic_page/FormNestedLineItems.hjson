{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: FormNestedLineItems
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return [
  `._id.fm-nested-line-items {
  display: flex;
  flex-direction: column;
  gap: ${t.var.spacing.sm};
  width: 100%;
}`,
  `._id.fm-nested-line-items .fm-nested-line-header-row,
._id.fm-nested-line-items .fm-nested-line-row {
  display: grid;
  grid-template-columns: var(--fm-nl-cols, minmax(4rem, 1fr));
  gap: ${t.var.spacing.sm};
}`,
  `._id.fm-nested-line-items .fm-nested-line-header-row {
  align-items: center;
}`,
  `._id.fm-nested-line-items .fm-nested-line-row {
  align-items: start;
}`,
  `._id.fm-nested-line-items .fm-nested-line-cell {
  min-width: 0;
  width: 100%;
}`,
  `._id.fm-nested-line-items .fm-nested-line-cell textarea {
  min-height: 4.5rem;
  width: 100%;
  resize: vertical;
}`,
  `._id.fm-nested-line-items .fm-nested-line-cell-label {
  display: none;
  font-size: 0.75rem;
  font-weight: 600;
  color: ${t.var.color.text_light_500};
  margin-bottom: 0.25rem;
}`,
  `._id.fm-nested-line-items.is-stack .fm-nested-line-header-row {
  display: none;
}`,
  `._id.fm-nested-line-items.is-stack .fm-nested-line-row {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: ${t.var.spacing.sm};
  border: 1px solid ${t.var.color.border};
  border-radius: 0.375rem;
  padding: ${t.var.spacing.md};
  margin-bottom: ${t.var.spacing.sm};
}`,
  `._id.fm-nested-line-items.is-stack .fm-nested-line-cell-label {
  display: block;
}`,
  `._id.fm-nested-line-items .fm-nested-line-row:focus-within {
  position: relative;
  z-index: 4;
}`,
  `._id.fm-nested-line-items .ts-dropdown .ts-dropdown-content {
  max-height: min(50vh, 20rem);
}`
];'''
        displayOrder: 1
        fns:
          '''const getProps = () => c.props || {};
const getField = () => getProps().field || {};
const getNestedLineItemsConfig = () => getField().nestedLineItemsConfig || {};

const getColumns = () => {
  const nestedLineItemsConfig = getNestedLineItemsConfig();
  const lineColumns = nestedLineItemsConfig.lineColumns;
  return Array.isArray(lineColumns) ? lineColumns : [];
};

const isStackLayout = () => getNestedLineItemsConfig().rowLayout === "stack";

const gridTemplateColumns = () => {
  if (isStackLayout()) return "minmax(4rem, 1fr)";
  const columnDefinitions = getColumns();
  if (columnDefinitions.length === 0) return "minmax(4rem, 1fr)";
  return columnDefinitions
    .map((columnDef) =>
      columnDef.gridMinmax != null && String(columnDef.gridMinmax).trim() !== ""
        ? String(columnDef.gridMinmax).trim()
        : "minmax(5rem, 1fr)",
    )
    .join(" ");
};

const getColumnSelectOptions = (columnDef) => {
  if (!columnDef || columnDef.columnType !== "select") return [];
  const nestedLineItemsConfig = getNestedLineItemsConfig();
  const optionsSourceKey = columnDef.optionsKey || "options";
  const optionsFromConfig =
    nestedLineItemsConfig[optionsSourceKey] != null
      ? nestedLineItemsConfig[optionsSourceKey]
      : columnDef.options;
  return Array.isArray(optionsFromConfig) ? optionsFromConfig : [];
};

const showInventoryColumn = (columnDef, rowVertex) => {
  if (!columnDef || columnDef.columnType !== "inventory") return false;
  const nestedLineItemsConfig = getNestedLineItemsConfig();
  if (!nestedLineItemsConfig.childToInventoryRelationshipType) return false;
  const visibilityFieldKey = columnDef.showWhenField;
  const visibilityValues = columnDef.showWhenValues;
  if (
    visibilityFieldKey != null &&
    String(visibilityFieldKey).trim() !== "" &&
    Array.isArray(visibilityValues) &&
    visibilityValues.length > 0
  ) {
    const propertyValue = rowVertex?.P?.[visibilityFieldKey];
    const normalizedPropertyValue = String(propertyValue ?? "").trim().toLowerCase();
    return visibilityValues.some(
      (allowedValue) => String(allowedValue).trim().toLowerCase() === normalizedPropertyValue,
    );
  }
  return true;
};

const resolveLineRowVertex = (lineEntryContext) => {
  const lineVertexId = lineEntryContext?.row?.id;
  if (lineVertexId && g.vertexes[lineVertexId]) return g.vertexes[lineVertexId];
  return lineEntryContext?.row;
};

const sortedLineVertices = () => getProps().getRows?.() || [];

const rowEntries = () => {
  const lineVertices = sortedLineVertices();
  return lineVertices.map((lineVertex, lineIndex) => ({ row: lineVertex, index: lineIndex }));
};

const ensureTxn = () => getProps().ensureTxn?.();

const parseJsonArrayValue = (raw) => {
  if (Array.isArray(raw)) return raw;
  if (typeof raw === "string" && raw.trim() !== "") {
    try {
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }
  return [];
};

const RESERVED_VARIANT_PROPERTY_KEYS = new Set([
  "id",
  "title",
  "sku",
  "price",
  "amazonUrl",
  "description",
  "displayOrder",
  "createdAt",
  "updatedAt",
  "images",
  "imageFileIds",
  "fileIds",
  "inventoryItemId",
  "inventoryId",
  "_key",
  "_draft"
]);

const getOptionAxesFromSibling = (columnDef) => {
  const axesFieldKey =
    columnDef?.optionAxesFieldKey != null && String(columnDef.optionAxesFieldKey).trim() !== ""
      ? String(columnDef.optionAxesFieldKey).trim()
      : "optionAxes";
  return parseJsonArrayValue(getProps().getSiblingFieldValue?.(axesFieldKey));
};

const getOptionPairsValue = (rowVertex, columnDef) => {
  const axes = getOptionAxesFromSibling(columnDef);
  if (axes.length > 0) {
    return axes
      .map((axis) => {
        const key = axis?.key != null ? String(axis.key).trim() : "";
        if (!key || RESERVED_VARIANT_PROPERTY_KEYS.has(key)) return null;
        const rawValue = rowVertex?.P?.[key];
        return {
          key,
          value: rawValue != null ? String(rawValue) : ""
        };
      })
      .filter(Boolean);
  }
  return [];
};

const patchOptionPairs = (lineIndex, columnDef, nextItems) => {
  const lines = sortedLineVertices();
  const lineVertex = lines[lineIndex];
  if (!lineVertex?.id) return;
  const txnId = ensureTxn();
  if (!txnId) return;
  const pairs = Array.isArray(nextItems) ? nextItems : [];
  const nextKeys = new Set();
  const patch = {};
  for (let i = 0; i < pairs.length; i++) {
    const item = pairs[i] || {};
    const key = item.key != null ? String(item.key).trim() : "";
    if (!key || RESERVED_VARIANT_PROPERTY_KEYS.has(key) || String(key).startsWith("_")) continue;
    nextKeys.add(key);
    patch[key] = item.value != null ? String(item.value) : "";
  }
  const axes = getOptionAxesFromSibling(columnDef);
  for (let i = 0; i < axes.length; i++) {
    const key = axes[i]?.key != null ? String(axes[i].key).trim() : "";
    if (!key || RESERVED_VARIANT_PROPERTY_KEYS.has(key)) continue;
    if (!nextKeys.has(key) && patch[key] === undefined) patch[key] = "";
  }
  _.mergeVertexProperties(txnId, lineVertex.id, g, sg, patch);
};

const getFilesValue = (rowVertex, columnDef) => {
  const nestedLineItemsConfig = getNestedLineItemsConfig();
  const filesRelationshipType = nestedLineItemsConfig.childToFilesRelationshipType;
  const filesTargetLabel = nestedLineItemsConfig.filesTargetLabel || "File";
  if (!filesRelationshipType || !rowVertex?.id) return [];
  const lineVertexFromGraph = g.vertexes[rowVertex.id] || rowVertex;
  const fileEdgeIds = lineVertexFromGraph.OUT?.[filesRelationshipType];
  if (!Array.isArray(fileEdgeIds) || fileEdgeIds.length === 0) return [];
  const ids = [];
  const seen = new Set();
  for (let edgeIndex = 0; edgeIndex < fileEdgeIds.length; edgeIndex++) {
    const edge = g.edges[fileEdgeIds[edgeIndex]];
    if (!edge?.E) continue;
    const targetVertex = g.vertexes[edge.E];
    if (targetVertex && !targetVertex.L?.includes(filesTargetLabel)) continue;
    const id = String(edge.E).trim();
    if (!id || seen.has(id)) continue;
    seen.add(id);
    ids.push(id);
  }
  return ids;
};

const getFilePreviewEntries = (rowVertex, columnDef) => {
  const ids = getFilesValue(rowVertex, columnDef);
  const pickerConfiguration =
    (columnDef?.pickerConfiguration != null && typeof columnDef.pickerConfiguration === "object"
      ? columnDef.pickerConfiguration
      : null) ||
    getNestedLineItemsConfig().filesPickerConfiguration ||
    {};
  const fileDownloadUrlPrefix =
    pickerConfiguration.fileDownloadUrlPrefix != null
      ? String(pickerConfiguration.fileDownloadUrlPrefix).trim()
      : "/api/file/download";
  const previewFileNamePropertyKey =
    pickerConfiguration.previewFileNameProperty != null
      ? String(pickerConfiguration.previewFileNameProperty)
      : "fileName";
  return ids.map((fileId) => {
    const fileVertex = g.vertexes[fileId];
    const fileName =
      fileVertex?.P?.[previewFileNamePropertyKey] != null
        ? String(fileVertex.P[previewFileNamePropertyKey]).trim()
        : "";
    const url =
      fileName !== "" && fileDownloadUrlPrefix !== ""
        ? `${fileDownloadUrlPrefix}/${encodeURIComponent(fileName)}`
        : "";
    const hasImage = !!(url && /\.(png|jpe?g|gif|webp|svg)$/i.test(fileName));
    return {
      id: fileId,
      fileId,
      fileName: fileName || fileId,
      url,
      hasImage
    };
  });
};

const removeFileId = (lineIndex, columnDef, fileIdToRemove) => {
  const lines = sortedLineVertices();
  const lineVertex = lines[lineIndex];
  if (!lineVertex?.id) return;
  const trimmedRemoveId = fileIdToRemove != null ? String(fileIdToRemove).trim() : "";
  if (!trimmedRemoveId) return;
  const nextIds = getFilesValue(lineVertex, columnDef).filter((id) => id !== trimmedRemoveId);
  patchCell(lineIndex, columnDef, nextIds);
};

const setFileIds = (lineVertex, fileVertexIds) => {
  const txnId = ensureTxn();
  if (!txnId || !lineVertex?.id) return;
  const nestedLineItemsConfig = getNestedLineItemsConfig();
  const filesRelationshipType = nestedLineItemsConfig.childToFilesRelationshipType;
  if (!filesRelationshipType) return;
  const lineVertexFresh = g.vertexes[lineVertex.id] || lineVertex;
  const existingFileEdgeIds = lineVertexFresh.OUT?.[filesRelationshipType];
  if (Array.isArray(existingFileEdgeIds)) {
    for (const existingEdgeId of [...existingFileEdgeIds]) {
      _.deleteEdge(txnId, existingEdgeId, g, sg);
    }
  }
  const ids = Array.isArray(fileVertexIds) ? fileVertexIds : [];
  for (let fileIndex = 0; fileIndex < ids.length; fileIndex++) {
    const trimmedFileId = ids[fileIndex] != null ? String(ids[fileIndex]).trim() : "";
    if (!trimmedFileId) continue;
    if (!g.vertexes[trimmedFileId]) continue;
    const newFileEdgeId = _.generateNewVertexId(g, sg);
    const newFileEdge = _.newEdge(
      newFileEdgeId,
      filesRelationshipType,
      { displayOrder: fileIndex },
      lineVertexFresh.id,
      trimmedFileId,
    );
    _.addNewEdge(txnId, newFileEdge, g, sg);
  }
};

const getFilesPickerProps = (lineIndex, columnDef, rowVertex) => {
  const pickerConfiguration =
    (columnDef?.pickerConfiguration != null && typeof columnDef.pickerConfiguration === "object"
      ? { ...columnDef.pickerConfiguration }
      : null) ||
    (getNestedLineItemsConfig().filesPickerConfiguration
      ? { ...getNestedLineItemsConfig().filesPickerConfiguration }
      : null);
  if (!pickerConfiguration) return null;
  if (pickerConfiguration.usePolarisUI === undefined) {
    pickerConfiguration.usePolarisUI = true;
  }
  pickerConfiguration.selectionMode = "multiple";
  pickerConfiguration.appendMode = true;
  if (!pickerConfiguration.chooseButtonLabel) {
    pickerConfiguration.chooseButtonLabel = "Add images…";
  }
  if (!pickerConfiguration.clearButtonLabel) {
    pickerConfiguration.clearButtonLabel = "Clear all";
  }
  const selectedValues = getFilesValue(rowVertex, columnDef);
  return {
    value: "",
    values: selectedValues,
    label: "",
    secondaryLabel:
      selectedValues.length > 0
        ? `${selectedValues.length} image${selectedValues.length === 1 ? "" : "s"} selected`
        : "No images yet — add one or more files",
    previewUrl: "",
    showImagePreview: false,
    disabled: isDisabled(),
    pickerConfiguration,
    chooseButtonLabel: pickerConfiguration.chooseButtonLabel,
    clearButtonLabel: pickerConfiguration.clearButtonLabel,
    onSelect: () => {},
    onSelectMultiple: (vertexElementIds, selectedVertexPayloads) => {
      if (Array.isArray(selectedVertexPayloads)) {
        const vertexMap = {};
        for (const selectedVertexPayload of selectedVertexPayloads) {
          if (selectedVertexPayload?.id && !g.vertexes[selectedVertexPayload.id]) {
            vertexMap[selectedVertexPayload.id] = selectedVertexPayload;
          }
        }
        if (Object.keys(vertexMap).length > 0) {
          _.setGraphData(0, { vertexes: vertexMap }, {});
        }
      }
      const incomingIds = Array.isArray(vertexElementIds)
        ? vertexElementIds.map((id) => String(id)).filter((id) => id.trim() !== "")
        : [];
      const existingIds = getFilesValue(
        g.vertexes[rowVertex?.id] || rowVertex,
        columnDef,
      );
      const mergedIds = [...existingIds];
      const seen = new Set(existingIds);
      for (let i = 0; i < incomingIds.length; i++) {
        const id = incomingIds[i];
        if (seen.has(id)) continue;
        seen.add(id);
        mergedIds.push(id);
      }
      patchCell(lineIndex, columnDef, mergedIds);
    },
    onClear: () => patchCell(lineIndex, columnDef, [])
  };
};

const detachAndDeleteLineVertex = (lineVertex) => {
  const txnId = ensureTxn();
  if (!txnId || !lineVertex?.id) return;
  const lineVertexId = lineVertex.id;
  const collectEdgeIds = (vertex) => {
    const allEdgeIds = [];
    if (vertex?.OUT) {
      for (const relationshipType of Object.keys(vertex.OUT)) {
        const outgoingEdgeIds = vertex.OUT[relationshipType];
        if (Array.isArray(outgoingEdgeIds)) allEdgeIds.push(...outgoingEdgeIds);
      }
    }
    if (vertex?.IN) {
      for (const relationshipType of Object.keys(vertex.IN)) {
        const incomingEdgeIds = vertex.IN[relationshipType];
        if (Array.isArray(incomingEdgeIds)) allEdgeIds.push(...incomingEdgeIds);
      }
    }
    return allEdgeIds;
  };
  let detachPassCount = 0;
  while (detachPassCount++ < 80) {
    const vertexFromGraph = g.vertexes[lineVertexId];
    if (!vertexFromGraph) return;
    const edgeIdsToRemove = collectEdgeIds(vertexFromGraph);
    if (edgeIdsToRemove.length === 0) break;
    for (let edgeIndex = 0; edgeIndex < edgeIdsToRemove.length; edgeIndex++) {
      _.deleteEdge(txnId, edgeIdsToRemove[edgeIndex], g, sg);
    }
  }
  _.deleteVertex(txnId, lineVertexId, g, sg);
};

const setInventoryItemId = (lineVertex, inventoryItemVertexId) => {
  const txnId = ensureTxn();
  if (!txnId || !lineVertex?.id) return;
  const nestedLineItemsConfig = getNestedLineItemsConfig();
  const inventoryRelationshipType = nestedLineItemsConfig.childToInventoryRelationshipType;
  if (!inventoryRelationshipType) return;
  const lineVertexFresh = g.vertexes[lineVertex.id] || lineVertex;
  const existingInventoryEdgeIds = lineVertexFresh.OUT?.[inventoryRelationshipType];
  if (Array.isArray(existingInventoryEdgeIds)) {
    for (const existingEdgeId of [...existingInventoryEdgeIds]) {
      _.deleteEdge(txnId, existingEdgeId, g, sg);
    }
  }
  const trimmedInventoryId = inventoryItemVertexId != null ? String(inventoryItemVertexId).trim() : "";
  if (trimmedInventoryId && g.vertexes[trimmedInventoryId]) {
    const newInventoryEdgeId = _.generateNewVertexId(g, sg);
    const newInventoryEdge = _.newEdge(
      newInventoryEdgeId,
      inventoryRelationshipType,
      {},
      lineVertexFresh.id,
      trimmedInventoryId,
    );
    _.addNewEdge(txnId, newInventoryEdge, g, sg);
  }
};

const patchLineP = (lineIndex, patch) => {
  const lines = sortedLineVertices();
  const lineVertex = lines[lineIndex];
  if (!lineVertex?.id) return;
  const txnId = ensureTxn();
  if (!txnId) return;
  if (patch && typeof patch === "object" && Object.keys(patch).length > 0) {
    _.mergeVertexProperties(txnId, lineVertex.id, g, sg, patch);
  }
};

const patchCell = (lineIndex, columnDef, cellValue) => {
  if (!columnDef) return;
  if (columnDef.columnType === "inventory") {
    const lines = sortedLineVertices();
    const lineVertex = lines[lineIndex];
    if (!lineVertex?.id) return;
    const txnId = ensureTxn();
    if (!txnId) return;
    const lineVertexForInventory = g.vertexes[lineVertex.id] || lineVertex;
    setInventoryItemId(lineVertexForInventory, cellValue);
    return;
  }
  if (columnDef.columnType === "files") {
    const lines = sortedLineVertices();
    const lineVertex = lines[lineIndex];
    if (!lineVertex?.id) return;
    const txnId = ensureTxn();
    if (!txnId) return;
    const lineVertexForFiles = g.vertexes[lineVertex.id] || lineVertex;
    setFileIds(lineVertexForFiles, cellValue);
    return;
  }
  if (columnDef.columnType === "actions") return;
  if (!columnDef.key || String(columnDef.key).startsWith("_")) return;
  const propertyPatch = { [columnDef.key]: cellValue };
  patchLineP(lineIndex, propertyPatch);
};

const inventoryValueForLine = (rowVertex) => {
  if (!rowVertex?.id) return "";
  const lineVertexFromGraph = g.vertexes[rowVertex.id] || rowVertex;
  const nestedLineItemsConfig = getNestedLineItemsConfig();
  const inventoryRelationshipType = nestedLineItemsConfig.childToInventoryRelationshipType;
  const inventoryTargetLabel = nestedLineItemsConfig.inventoryTargetLabel || "InventoryItem";
  if (!inventoryRelationshipType || !lineVertexFromGraph.OUT?.[inventoryRelationshipType]) return "";
  const inventoryEdgeIds = lineVertexFromGraph.OUT[inventoryRelationshipType];
  for (let edgeIndex = 0; edgeIndex < inventoryEdgeIds.length; edgeIndex++) {
    const edge = g.edges[inventoryEdgeIds[edgeIndex]];
    if (!edge) continue;
    const targetVertex = g.vertexes[edge.E];
    if (targetVertex?.L?.includes(inventoryTargetLabel)) return edge.E;
  }
  return "";
};

const addRow = () => {
  const parentVertex = getProps().getParentVertex?.();
  if (!parentVertex?.id) return;
  const txnId = ensureTxn();
  if (!txnId) return;
  const nestedLineItemsConfig = getNestedLineItemsConfig();
  const childLabel = nestedLineItemsConfig.childLabel;
  const parentToChildRelationshipType = nestedLineItemsConfig.parentToChildRelationshipType;
  if (!childLabel || !parentToChildRelationshipType) return;
  const displayOrder = Date.now();
  const newLineProperties = { displayOrder };
  const columnDefinitions = getColumns();
  for (let columnIndex = 0; columnIndex < columnDefinitions.length; columnIndex++) {
    const columnDef = columnDefinitions[columnIndex];
    if (
      !columnDef ||
      columnDef.columnType === "actions" ||
      columnDef.columnType === "inventory" ||
      columnDef.columnType === "files" ||
      columnDef.columnType === "optionPairs"
    ) {
      continue;
    }
    if (!columnDef.key || String(columnDef.key).startsWith("_")) continue;
    if (columnDef.defaultValue !== undefined) newLineProperties[columnDef.key] = columnDef.defaultValue;
  }
  // Seed option axis keys as empty properties on the variant vertex.
  for (let columnIndex = 0; columnIndex < columnDefinitions.length; columnIndex++) {
    const columnDef = columnDefinitions[columnIndex];
    if (!columnDef || columnDef.columnType !== "optionPairs") continue;
    const axes = getOptionAxesFromSibling(columnDef);
    for (let axisIndex = 0; axisIndex < axes.length; axisIndex++) {
      const key = axes[axisIndex]?.key != null ? String(axes[axisIndex].key).trim() : "";
      if (!key || RESERVED_VARIANT_PROPERTY_KEYS.has(key)) continue;
      if (newLineProperties[key] === undefined) newLineProperties[key] = "";
    }
  }
  const defaultNewLinePropertiesOverlay = nestedLineItemsConfig.defaultNewLineProperties;
  if (defaultNewLinePropertiesOverlay && typeof defaultNewLinePropertiesOverlay === "object") {
    for (const propertyKey of Object.keys(defaultNewLinePropertiesOverlay)) {
      newLineProperties[propertyKey] = defaultNewLinePropertiesOverlay[propertyKey];
    }
  }
  const newLineVertexId = _.generateNewVertexId(g, sg);
  const newLineVertex = _.newVertex(newLineVertexId, [childLabel], newLineProperties);
  _.addNewVertex(txnId, newLineVertex, g, sg);
  const newParentToChildEdgeId = _.generateNewVertexId(g, sg);
  const parentToChildEdge = _.newEdge(
    newParentToChildEdgeId,
    parentToChildRelationshipType,
    {},
    parentVertex.id,
    newLineVertexId,
  );
  _.addNewEdge(txnId, parentToChildEdge, g, sg);
};

const removeRow = (lineIndex) => {
  const lines = sortedLineVertices();
  const lineVertexToRemove = lines[lineIndex];
  if (!lineVertexToRemove) return;
  if (lineVertexToRemove.id) getProps().markDeleted?.(lineVertexToRemove.id);
  detachAndDeleteLineVertex(lineVertexToRemove);
};

const selectFallback = (columnDef, selectedValueRaw) => {
  if (selectedValueRaw != null && String(selectedValueRaw).trim() !== "") return String(selectedValueRaw).trim();
  if (
    columnDef.selectFallbackValue != null &&
    String(columnDef.selectFallbackValue).trim() !== ""
  ) {
    return String(columnDef.selectFallbackValue).trim();
  }
  if (columnDef.defaultValue !== undefined) return String(columnDef.defaultValue);
  return "";
};

const isDisabled = () => getProps().disabled === true;

return {
  getField,
  getNestedLineItemsConfig,
  getColumns,
  isStackLayout,
  gridTemplateColumns,
  getColumnSelectOptions,
  showInventoryColumn,
  rowEntries,
  patchCell,
  patchLineP,
  inventoryValueForLine,
  getOptionPairsValue,
  patchOptionPairs,
  getFilesValue,
  getFilePreviewEntries,
  getFilesPickerProps,
  removeFileId,
  addRow,
  removeRow,
  selectFallback,
  resolveLineRowVertex,
  isDisabled
};'''
        componentName: Html
        props:
          '''return {
  as: "div",
  class: f.isStackLayout() ? "fm-nested-line-items is-stack" : "fm-nested-line-items"
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Button
        props:
          '''return {
  variant: "secondary",
  text: f.getNestedLineItemsConfig().addButtonLabel || "Add line",
  type: "button",
  disabled: f.isDisabled(),
  onClick: () => f.addRow()
};'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''return `._id.fm-nested-line-table {
  width: 100%;
  border: 1px solid ${t.var.color.border};
  border-radius: 0.375rem;
  overflow: visible;
  display: flex;
  flex-direction: column;
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "div",
  class: "fm-nested-line-table",
  style: { "--fm-nl-cols": f.gridTemplateColumns() }
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id.fm-nested-line-header-row {
  padding: ${t.var.spacing.sm};
  background: ${t.var.color.background_light_100};
  border-bottom: 1px solid ${t.var.color.border};
  font-size: 0.75rem;
  font-weight: 600;
  color: ${t.var.color.text_light_500};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  class: "fm-nested-line-header-row",
  role: "row"
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  loop: true,
  contextName: "nestedLineColumn",
  data: () => f.getColumns()
};'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''const columnDef = c.nestedLineColumn;
const isActionsColumn = columnDef && columnDef.columnType === "actions";
const headerText = columnDef && columnDef.label != null ? String(columnDef.label) : "";
const headerLabelProps = { as: "span", text: headerText };
if (isActionsColumn && headerText === "") headerLabelProps["aria-hidden"] = true;
return headerLabelProps;'''
      }
    }
    {
      id: "8"
