    {
      id: "12"
      L: Attr
      P: {
        displayOrder: 1
        componentName: TomSelect
        props:
          '''const columnDef = c.nestedLineColumn;
const lineEntryContext = c.lineEntry;
const resolvedLineVertex = f.resolveLineRowVertex(lineEntryContext);
const lineIndex = lineEntryContext?.index ?? 0;
return {
  options: f.getColumnSelectOptions(columnDef),
  value: resolvedLineVertex?.P?.[columnDef.key] != null ? String(resolvedLineVertex.P[columnDef.key]) : "",
  onChange: (nextValue) =>
    f.patchCell(lineIndex, columnDef, f.selectFallback(columnDef, nextValue)),
  placeholder: columnDef.placeholder || columnDef.label || "",
  disabled: f.isDisabled(),
  hide: !columnDef || columnDef.columnType !== "select"
};'''
      }
    }
