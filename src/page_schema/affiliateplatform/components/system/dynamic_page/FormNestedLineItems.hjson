  width: 100%;
}`,
  `._id.fm-nested-files .fm-nested-files-gallery {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}`,
  `._id.fm-nested-files .fm-nested-files-thumb {
  position: relative;
  width: 4.5rem;
  height: 4.5rem;
  border-radius: 0.375rem;
  border: 1px solid ${t.var.color.border};
  background: ${t.var.color.background_light_100};
  overflow: hidden;
  flex-shrink: 0;
}`,
  `._id.fm-nested-files .fm-nested-files-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}`,
  `._id.fm-nested-files .fm-nested-files-thumb-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: ${t.var.color.text_light_500};
  font-size: 0.65rem;
  padding: 0.25rem;
  text-align: center;
  word-break: break-word;
}`,
  `._id.fm-nested-files .fm-nested-files-remove {
  position: absolute;
  top: 0.15rem;
  right: 0.15rem;
  z-index: 2;
}`
];'''
