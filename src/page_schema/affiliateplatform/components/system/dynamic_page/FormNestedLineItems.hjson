        displayOrder: 3
        componentName: TextInput
        props:
          '''const columnDef = c.nestedLineColumn;
const lineEntryContext = c.lineEntry;
const resolvedLineVertex = f.resolveLineRowVertex(lineEntryContext);
const lineIndex = lineEntryContext?.index ?? 0;
return {
  type: "number",
  value: resolvedLineVertex?.P?.[columnDef.key] != null ? resolvedLineVertex.P[columnDef.key] : "",
  placeholder: columnDef.placeholder || columnDef.label || "",
  min: columnDef.min != null ? columnDef.min : 0,
  step: columnDef.step != null ? columnDef.step : 0.01,
  disabled: f.isDisabled(),
  hide: !columnDef || columnDef.columnType !== "number",
  onChange: (inputEvent) =>
    f.patchCell(
      lineIndex,
      columnDef,
      inputEvent.target.value === "" ? "" : Number(inputEvent.target.value),
    )
};'''
      }
    }
    {
      id: "15"
      L: Attr
      P: {
        displayOrder: 4
        componentName: TomSelect
        props:
          '''const columnDef = c.nestedLineColumn;
const lineEntryContext = c.lineEntry;
const resolvedLineVertex = f.resolveLineRowVertex(lineEntryContext);
const lineIndex = lineEntryContext?.index ?? 0;
const inventorySelectConfig = f.getNestedLineItemsConfig().inventorySelectConfig || {};
const labelFieldName = inventorySelectConfig.labelField || "partNo";
const tomSelectLabelKey = String(labelFieldName).includes(".")
  ? String(labelFieldName)
  : "P." + labelFieldName;
const linkedInventoryVertexId = resolvedLineVertex
  ? f.inventoryValueForLine(resolvedLineVertex)
  : "";
return {
  functionName: "getUserVertices",
  value: linkedInventoryVertexId ? String(linkedInventoryVertexId) : "",
  onChange: (nextInventoryId) => f.patchCell(lineIndex, columnDef, nextInventoryId || ""),
  singularName: inventorySelectConfig.singularName || "Part",
  pluralName: inventorySelectConfig.pluralName || "Parts",
  valueKey: "id",
  labelKey: tomSelectLabelKey,
  functionContext: {
    label: inventorySelectConfig.label || "InventoryItem",
    search: inventorySelectConfig.search || "",
    limit: inventorySelectConfig.limit || 200,
    relationshipType: inventorySelectConfig.relationshipType,
    enableUserScoping: inventorySelectConfig.enableUserScoping === true
  },
  placeholder: columnDef.placeholder || inventorySelectConfig.singularName || "Inventory",
  disabled: f.isDisabled(),
  hide: (functionArguments) => {
    const columnDefFromContext = functionArguments.contextData.nestedLineColumn;
    const lineEntryFromContext = functionArguments.contextData.lineEntry;
    if (!columnDefFromContext || columnDefFromContext.columnType !== "inventory") return true;
    const resolvedLineVertexForVisibility =
      functionArguments.fns.resolveLineRowVertex(lineEntryFromContext);
    return !functionArguments.fns.showInventoryColumn(columnDefFromContext, resolvedLineVertexForVisibility);
  }
};'''
      }
    }
    {
      id: "16"
      L: Attr
      P: {
        displayOrder: 5
        componentName: Button
        props:
          '''const columnDef = c.nestedLineColumn;
const lineEntryContext = c.lineEntry;
const lineIndex = lineEntryContext?.index ?? 0;
return {
  variant: "danger",
  text: "Remove",
  type: "button",
  disabled: f.isDisabled(),
  hide: !columnDef || columnDef.columnType !== "actions",
  onClick: () => f.removeRow(lineIndex)
};'''
      }
    }
