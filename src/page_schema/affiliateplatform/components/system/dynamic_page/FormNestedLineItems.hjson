    {
      id: "18"
      L: Attr
      P: {
        displayOrder: 7
        componentName: FormFieldArray
        props:
          '''const columnDef = c.nestedLineColumn;
const lineEntryContext = c.lineEntry;
const resolvedLineVertex = f.resolveLineRowVertex(lineEntryContext);
const lineIndex = lineEntryContext?.index ?? 0;
const optionPairs = f.getOptionPairsValue(resolvedLineVertex, columnDef);
return {
  hide: !columnDef || columnDef.columnType !== "optionPairs" || !columnDef.fieldArrayConfig,
  field: {
    key: columnDef?.key || "_options",
    fieldArrayConfig: columnDef?.fieldArrayConfig
  },
  value: optionPairs,
  disabled: f.isDisabled(),
  onChange: (nextItems) =>
    f.patchOptionPairs(lineIndex, columnDef, Array.isArray(nextItems) ? nextItems : [])
};'''
      }
    }
    {
