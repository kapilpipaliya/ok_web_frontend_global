    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Button
        props:
          '''return {
  variant: args.fns.isJsonMode?.() ? "primary" : "secondary", size: "sm", text: "JSON", type: "button",
  onClick: () => args.fns.setEditorMode?.("json")
};'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Button
        props:
          '''return {
  variant: "primary", size: "sm", text: args.fns.saving?.() ? "Saving..." : "Save", type: "button",
  disabled: args.fns.saving?.() === true, onClick: () => { void args.fns.saveSchema?.(); }
};'''
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        displayOrder: 2
        componentName: LoadingSpinner
        props: return { hide: args.fns.loading?.() !== true };
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        css: return `._id { flex: 1; min-height: 0; overflow: hidden; display: flex; flex-direction: column; }`;
        displayOrder: 3
        componentName: Html
        props: return { as: "div", hide: args.fns.loading?.() === true };
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        css:
          '''return `._id {
  flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 0.625rem;
  padding: 0.75rem 1rem; overflow: hidden;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div", hide: args.fns.isJsonMode?.() === true };
      }
    }
    {
      id: "12"
      L: Attr
      P: {
        displayOrder: 1
        componentName: TextInput
        props:
          '''const data = args.fns.schemaData?.() || {};
return {
  label: "Grid columns",
  type: "number",
  value: data.gridColumns != null ? String(data.gridColumns) : "2",
  onChange: (e) => args.fns.patchFormConfig?.({ gridColumns: Number(e.target.value) || 1 })
};'''
      }
    }
    {
      id: "13"
      L: Attr
      P: {
        displayOrder: 2
        componentName: FormConfigGroupsSchemaEditor
        props:
          '''return {
  groups: args.fns.getGroups?.() || [],
  siteLanguages: args.contextData.props?.siteLanguages,
  onChange: (patch) => args.fns.onGroupsChange?.(patch)
};'''
      }
    }
    {
      id: "14"
