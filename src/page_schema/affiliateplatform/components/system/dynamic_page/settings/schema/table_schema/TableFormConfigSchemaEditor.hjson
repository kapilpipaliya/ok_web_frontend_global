{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        dynamicComponent: Button, TextInput, TextArea, LoadingSpinner, FormConfigGroupsSchemaEditor, Html
        description: Dedicated editor for table formConfig schema with groups visual editor.
        fns:
          '''
const getProps = () => args.contextData.props || {};
const getTableKey = () => {
  const v = getProps().tableKey;
  return v != null && String(v).trim() !== "" ? String(v).trim() : null;
};
const getSchemaKey = () => {
  const v = getProps().schemaKey;
  return v != null && String(v).trim() !== "" ? String(v).trim() : null;
};
const executeYTOFunction = (fn, ctx) => args.executeNamedServerFunction({ functionName: fn, contextData: ctx || {} });

const [resolvedTableKey, setResolvedTableKey] = args.createSignal(null);
const [resolvedSchemaKey, setResolvedSchemaKey] = args.createSignal(null);

const resolveContext = async () => {
  let tableKey = getTableKey();
  let schemaKey = getSchemaKey();
  if (schemaKey) {
    setResolvedTableKey(tableKey);
    setResolvedSchemaKey(schemaKey);
    return { tableKey, schemaKey };
  }
  if (tableKey) {
    const result = await executeYTOFunction("getTableIds", { tableKey });
    schemaKey = result?.result?.data?.schemaKeys?.formConfig || null;
    tableKey = result?.result?.data?.tableKey || tableKey;
    setResolvedTableKey(tableKey);
    setResolvedSchemaKey(schemaKey);
    return { tableKey, schemaKey };
  }
  const label = getProps().tableVertexLabel;
  if (label) {
    const result = await executeYTOFunction("getTableIds", { tableVertexLabel: label });
    const ids = result?.result?.data;
    if (ids) {
      tableKey = ids.tableKey || null;
      schemaKey = ids.schemaKeys?.formConfig || null;
      setResolvedTableKey(tableKey);
      setResolvedSchemaKey(schemaKey);
      return { tableKey, schemaKey };
    }
  }
  setResolvedTableKey(null);
  setResolvedSchemaKey(null);
  return { tableKey: null, schemaKey: null };
};

const getEffectiveTableKey = () => resolvedTableKey() || getTableKey();
const getEffectiveSchemaKey = () => resolvedSchemaKey() || getSchemaKey();

const defaultFormConfig = () => ({
  part: "formConfig",
  gridColumns: 2,
  groups: []
});

const [loading, setLoading] = args.createSignal(false);
const [saving, setSaving] = args.createSignal(false);
const [schemaData, setSchemaData] = args.createSignal(defaultFormConfig());
const [configJsonText, setConfigJsonText] = args.createSignal("");
const [jsonError, setJsonError] = args.createSignal("");
const [editorMode, setEditorMode] = args.createSignal("visual");

const isJsonMode = () => editorMode() === "json";
const syncJsonFromData = (data) => {
  setConfigJsonText(JSON.stringify(data && typeof data === "object" ? { ...data } : defaultFormConfig(), null, 2));
  setJsonError("");
};

const applyLoadedSetting = (setting) => {
  if (!setting?.P?.config) {
    setSchemaData(defaultFormConfig());
    syncJsonFromData(defaultFormConfig());
    return;
  }
  try {
    const data = new Function(setting.P.config)();
    const merged = {
      ...defaultFormConfig(),
      ...(data || {}),
      part: "formConfig",
      groups: Array.isArray(data?.groups) ? data.groups : []
    };
    setSchemaData(merged);
    syncJsonFromData(merged);
  } catch (error) {
    setSchemaData(defaultFormConfig());
    setConfigJsonText(String(setting.P.config || ""));
    setJsonError("Failed to parse stored config");
  }
};

const loadSchema = async () => {
  const { schemaKey } = await resolveContext();
  if (!schemaKey) {
    args.showErrorToast?.("Schema key could not be resolved");
    return;
  }
  setLoading(true);
  try {
    const result = await executeYTOFunction("getTableSchema", { key: schemaKey });
    if (!result?.result?.success) {
      args.showErrorToast?.(result?.result?.message || "Failed to load table schema");
      return;
    }
    applyLoadedSetting(result.result.data?.setting);
  } catch (error) {
    args.showErrorToast?.("Failed to load table schema");
  } finally {
    setLoading(false);
  }
};

const patchFormConfig = (partial) => {
  const next = { ...(schemaData() || defaultFormConfig()), ...partial, part: "formConfig" };
  setSchemaData(next);
  syncJsonFromData(next);
};

const getGroups = () => schemaData()?.groups || [];

const onGroupsChange = (patch) => {
  patchFormConfig({ groups: patch?.groups || [] });
};

const saveSchema = async () => {
  const schemaKey = getEffectiveSchemaKey();
  if (!schemaKey) {
    args.showErrorToast?.("Schema key is missing");
    return;
  }
  setSaving(true);
  try {
    const configObj = isJsonMode() ? JSON.parse(configJsonText()) : schemaData();
    const configBody = `return ${JSON.stringify(configObj, null, 2)};`;
    const result = await executeYTOFunction("saveTableSchema", {
      key: schemaKey,
      tableKey: getEffectiveTableKey(),
      part: "formConfig",
      config: configBody,
      name: getProps().title || "Table form config schema"
    });
    if (!result?.result?.success) {
      args.showErrorToast?.(result?.result?.message || "Failed to save");
      return;
    }
    args.showSuccessToast?.(result.result.message || "Table schema saved");
    applyLoadedSetting(result.result.data?.setting);
    getProps().onSaved?.();
  } catch (error) {
    args.showErrorToast?.(isJsonMode() ? "Invalid JSON" : "Failed to save table schema");
  } finally {
    setSaving(false);
  }
};

const setEditorModeSafe = (mode) => {
  if (mode === "json") syncJsonFromData(schemaData());
  setEditorMode(mode);
};

return {
  loading, saving, isJsonMode, configJsonText, setConfigJsonText, jsonError,
  loadSchema, saveSchema, setEditorMode: setEditorModeSafe,
  schemaData, patchFormConfig, getGroups, onGroupsChange
};
'''
        key: TableFormConfigSchemaEditor
      }
    }
