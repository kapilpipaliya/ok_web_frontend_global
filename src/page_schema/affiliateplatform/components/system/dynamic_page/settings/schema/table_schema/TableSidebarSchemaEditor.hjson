      L: Attr
      P: {
        css: return `._id { margin: 0; font-size: 0.9375rem; font-weight: 700; }`;
        displayOrder: 1
        componentName: Html
        props: return { as: "h3", text: args.contextData.props?.title || "Table sidebar" };
      }
    }
    {
      id: "5"
