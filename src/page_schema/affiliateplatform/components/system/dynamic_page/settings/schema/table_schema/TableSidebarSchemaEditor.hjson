        css: return `._id { flex: 1; min-height: 0; overflow: hidden; display: flex; flex-direction: column; }`;
        displayOrder: 3
        componentName: Html
        props: return { as: "div", hide: args.fns.loading?.() === true };
      }
    }
    {
