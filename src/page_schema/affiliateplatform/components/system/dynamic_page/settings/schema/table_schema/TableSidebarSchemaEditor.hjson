  padding: 0.75rem 1rem; overflow: auto;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div", hide: args.fns.isJsonMode?.() === true };
      }
    }
    {
      id: "12"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem;
  padding: 0.625rem; border: 1px solid ${args.theme.var.color.border}; border-radius: 0.5rem;
  @media (max-width: 768px) { grid-template-columns: 1fr; }
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div" };
      }
