  variant: "primary", size: "sm", text: args.fns.saving?.() ? "Saving..." : "Save", type: "button",
  disabled: args.fns.saving?.() === true, onClick: () => { void args.fns.saveSchema?.(); }
};'''
      }
    }
    {
      id: "9"
