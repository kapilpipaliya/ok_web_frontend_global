{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        dynamicComponent: Button, TextInput, TextArea, LoadingSpinner, FormConfigGroupsSchemaEditor, Html
        description: Visual editor for table sidebar schema with nested formConfig groups.
        fns:
          '''
const getProps = () => args.contextData.props || {};
const getTableKey = () => {
  const v = getProps().tableKey;
  return v != null && String(v).trim() !== "" ? String(v).trim() : null;
};
const getSchemaKey = () => {
  const v = getProps().schemaKey;
  return v != null && String(v).trim() !== "" ? String(v).trim() : null;
};
const executeYTOFunction = (fn, ctx) => args.executeNamedServerFunction({ functionName: fn, contextData: ctx || {} });

const defaultSidebar = () => ({
  part: "sidebar",
  enabled: true,
  label: "",
  parentVertexLabel: "",
  toParentEdgeType: "",
  formConfig: { gridColumns: 1, groups: [] }
});

const [loading, setLoading] = args.createSignal(false);
const [saving, setSaving] = args.createSignal(false);
const [schemaData, setSchemaData] = args.createSignal(defaultSidebar());
const [configJsonText, setConfigJsonText] = args.createSignal("");
const [jsonError, setJsonError] = args.createSignal("");
const [editorMode, setEditorMode] = args.createSignal("visual");

const isJsonMode = () => editorMode() === "json";
const syncJsonFromData = (data) => {
  setConfigJsonText(JSON.stringify(data && typeof data === "object" ? { ...data } : defaultSidebar(), null, 2));
  setJsonError("");
};

const applyLoadedSetting = (setting) => {
  if (!setting?.P?.config) {
    setSchemaData(defaultSidebar());
    syncJsonFromData(defaultSidebar());
    return;
  }
  try {
    const data = new Function(setting.P.config)();
    const base = defaultSidebar();
    const merged = {
      ...base,
      ...(data || {}),
      part: "sidebar",
      formConfig: {
        ...base.formConfig,
        ...(data?.formConfig || {}),
        groups: Array.isArray(data?.formConfig?.groups) ? data.formConfig.groups : []
      }
    };
    setSchemaData(merged);
    syncJsonFromData(merged);
  } catch (error) {
    setSchemaData(defaultSidebar());
    setConfigJsonText(String(setting.P.config || ""));
    setJsonError("Failed to parse stored config");
  }
};

const loadSchema = async () => {
  const schemaKey = getSchemaKey();
  if (!schemaKey) return;
  setLoading(true);
  try {
    const result = await executeYTOFunction("getTableSchema", { key: schemaKey });
    if (!result?.result?.success) {
      args.showErrorToast?.(result?.result?.message || "Failed to load table schema");
      return;
    }
    applyLoadedSetting(result.result.data?.setting);
  } catch (error) {
    args.showErrorToast?.("Failed to load table schema");
  } finally {
    setLoading(false);
  }
};

const patchSidebar = (partial) => {
  const next = { ...(schemaData() || defaultSidebar()), ...partial, part: "sidebar" };
  setSchemaData(next);
  syncJsonFromData(next);
};

const getSidebarValue = (key) => schemaData()?.[key];
const getFormConfigGroups = () => schemaData()?.formConfig?.groups || [];

const onFormConfigGroupsChange = (patch) => {
  const current = schemaData() || defaultSidebar();
  patchSidebar({
    formConfig: {
      ...(current.formConfig || {}),
      groups: patch?.groups || []
    }
  });
};

const saveSchema = async () => {
  const schemaKey = getSchemaKey();
  if (!schemaKey) {
    args.showErrorToast?.("Schema key is missing");
    return;
  }
  setSaving(true);
  try {
    const configObj = isJsonMode() ? JSON.parse(configJsonText()) : schemaData();
    const configBody = `return ${JSON.stringify(configObj, null, 2)};`;
    const result = await executeYTOFunction("saveTableSchema", {
      key: schemaKey,
      tableKey: getTableKey(),
      part: "sidebar",
      config: configBody,
      name: getProps().title || "Table sidebar schema"
    });
    if (!result?.result?.success) {
      args.showErrorToast?.(result?.result?.message || "Failed to save");
      return;
    }
    args.showSuccessToast?.(result.result.message || "Table schema saved");
    applyLoadedSetting(result.result.data?.setting);
    getProps().onSaved?.();
  } catch (error) {
    args.showErrorToast?.(isJsonMode() ? "Invalid JSON" : "Failed to save table schema");
  } finally {
    setSaving(false);
  }
};

const setEditorModeSafe = (mode) => {
  if (mode === "json") syncJsonFromData(schemaData());
  setEditorMode(mode);
};

return {
  loading, saving, isJsonMode, configJsonText, setConfigJsonText, jsonError,
  loadSchema, saveSchema, setEditorMode: setEditorModeSafe,
  patchSidebar, getSidebarValue, getFormConfigGroups, onFormConfigGroupsChange
};
'''
        key: TableSidebarSchemaEditor
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden; height: 100%;
  background: ${args.theme.var.color.background};
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div", hide: args.contextData.props?.hide === true, onMount: () => { void args.fns.loadSchema?.(); } };
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
  padding: 0.75rem 1rem; border-bottom: 1px solid ${args.theme.var.color.border};
  background: ${args.theme.var.color.background_light_100}; flex-shrink: 0;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "header" };
      }
    }
    {
