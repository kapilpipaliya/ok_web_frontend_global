{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        dynamicComponent: Button, DynamicPage, SettingsPageSchemaEditor
        description: Content/Fields tab split with DynamicPage content editor and SettingsPageSchemaEditor.
        key: SettingsEditorShell
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  height: 100%;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  hide: args.contextData.props?.hide === true
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  gap: 0.25rem;
  padding: 0.5rem 0.75rem;
  border-bottom: 1px solid ${args.theme.var.color.border};
  background: ${args.theme.var.color.background_light_100};
  flex-shrink: 0;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Button
        props:
          '''const isSchemaMode = args.contextData.props?.isSchemaMode;
const active = typeof isSchemaMode === "function" ? !isSchemaMode() : isSchemaMode !== true;
return {
  variant: active ? "primary" : "secondary",
  size: "sm",
  text: args.contextData.props?.contentTabLabel || "Content",
  type: "button",
  onClick: () => args.contextData.props?.onSetContentMode?.()
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Button
        props:
          '''const isSchemaMode = args.contextData.props?.isSchemaMode;
const active = typeof isSchemaMode === "function" ? isSchemaMode() === true : isSchemaMode === true;
return {
  variant: active ? "primary" : "secondary",
  size: "sm",
  text: args.contextData.props?.schemaTabLabel || "Field schema",
  type: "button",
  onClick: () => args.contextData.props?.onSetSchemaMode?.()
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          '''return `._id {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const isSchemaMode = args.contextData.props?.isSchemaMode;
const hide = typeof isSchemaMode === "function" ? isSchemaMode() === true : isSchemaMode === true;
return { as: "div", hide };'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''return `._id {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  height: 100%;
  position: relative;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        displayOrder: 1
        componentName: DynamicPage
        props:
          '''const settingsPageId = args.contextData.props?.settingsPageId;
return {
  key: args.contextData.props?.dynamicPageKey || "settings_editor_dynamic_page",
  pageMode: "settings",
  settingsPageId,
  loadFromSetting: true,
  embeddedMode: args.contextData.props?.embeddedMode !== false,
  hideSettingsSidebar: args.contextData.props?.hideSettingsSidebar === true,
  scopeId: args.contextData.props?.scopeId || "Default",
  siteLanguages: args.contextData.props?.siteLanguages || [],
  scope: args.contextData.props?.scope || {
    vertexLabel: "GlobalSetting",
    matchProperty: "key",
    idParam: "scopeId"
  },
  hide: !settingsPageId
};'''
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        css:
          '''return `._id {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}`;'''
        displayOrder: 3
        componentName: Html
        props:
          '''const isSchemaMode = args.contextData.props?.isSchemaMode;
const show = typeof isSchemaMode === "function" ? isSchemaMode() === true : isSchemaMode === true;
return { as: "div", hide: !show };'''
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        displayOrder: 1
        componentName: SettingsPageSchemaEditor
        props:
          '''const settingsPageId = args.contextData.props?.settingsPageId;
return {
  settingsPageId,
  embeddedMode: true,
  siteLanguages: args.contextData.props?.siteLanguages || [],
  onSaved: () => args.contextData.props?.onSchemaSaved?.()
};'''
      }
    }
  ]
  edges: [
