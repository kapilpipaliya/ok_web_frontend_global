{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''
const getSidebarConfig = () => args.contextData.props?.sidebarConfig || args.fns.getSettingsSidebarConfig?.() || null;

const checkPermissions = (permissionConfig) => {
  if (!permissionConfig) return true;
  if (args.isNoPermissionCheck === true) return true;
  if (args.hasFullPermission || args.hasEditPermission || args.hasViewPermission) return true;
  return false;
};

const getVisibleGroups = () => {
  const sidebarConfig = getSidebarConfig();
  if (!sidebarConfig || !Array.isArray(sidebarConfig.groups)) return [];
  return sidebarConfig.groups.filter((group) => {
    if (!checkPermissions(group.permissions)) return false;
    return true;
  }).map((group) => ({
    ...group,
    items: (group.items || []).filter((item) => checkPermissions(item.permissions))
  })).filter((group) => (group.items || []).length > 0);
};

const parseNavPath = (itemPath) => {
  if (!itemPath) return { pathname: "", sectionId: null };
  const qIndex = itemPath.indexOf("?");
  if (qIndex === -1) return { pathname: itemPath, sectionId: null };
  const pathname = itemPath.slice(0, qIndex);
  const params = new URLSearchParams(itemPath.slice(qIndex + 1));
  return {
    pathname,
    sectionId: params.get("section")
  };
};

const isActivePath = (itemPath) => {
  const currentPath = args.location?.pathname || "";
  if (!itemPath) return false;

  const parsed = parseNavPath(itemPath);
  if (parsed.sectionId) {
    return currentPath === parsed.pathname && args.searchParams?.section === parsed.sectionId;
  }

  if (itemPath === currentPath) return true;
  return currentPath.startsWith(itemPath + "/");
};

const handleNavigate = (item) => {
  if (!item?.path) return;
  args.navigate(item.path);
};

return {
  getSidebarConfig,
  getVisibleGroups,
  isActivePath,
  handleNavigate,
  sidebarTitle: () => getSidebarConfig()?.title || "Settings"
};
'''
        key: SettingsSidebar
      }
    }
