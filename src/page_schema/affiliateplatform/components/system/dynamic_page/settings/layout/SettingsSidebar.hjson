      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  width: 240px;
  flex-shrink: 0;
  border-right: 1px solid ${args.theme.var.color.border};
  padding: ${args.theme.var.spacing.md};
  background: ${args.theme.var.color.background_light_100};
  min-height: 100%;
  overflow-y: auto;
}

@media (max-width: 768px) {
  ._id {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid ${args.theme.var.color.border};
    max-height: 240px;
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
