    {
      id: "7"
      L: Attr
      P: {
        css:
          '''const item = args.contextData.navItem;
const active = args.fns.isActivePath(item.path);
return active
  ? `._id {
  display: block;
  padding: ${args.theme.var.spacing.sm} ${args.theme.var.spacing.md};
  border-radius: ${args.theme.var.borderRadius.md};
  color: ${args.theme.var.color.primary_text};
  background: ${args.theme.var.color.primary};
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  transition: background 150ms ease;
}`
  : `._id {
  display: block;
  padding: ${args.theme.var.spacing.sm} ${args.theme.var.spacing.md};
  border-radius: ${args.theme.var.borderRadius.md};
  color: ${args.theme.var.color.text};
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  transition: background 150ms ease;
}
._id:hover {
  background: ${args.theme.var.color.background_light_200};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const item = args.contextData.navItem;
return {
  as: "a",
