{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        description: Horizontal section navigation for embedded Fulchand settings editor with drag-and-drop reordering.
        fns:
          '''
const getSections = () => {
  const sections = c.props?.sections;
  return Array.isArray(sections) ? sections : [];
};

const getActiveSectionId = () => c.props?.activeSectionId || null;

const [orderedSections, setOrderedSections] = _.createSignal([]);
const [draggedIndex, setDraggedIndex] = _.createSignal(null);
const [dragOverIndex, setDragOverIndex] = _.createSignal(null);
const draggableCleanups = new Map();

const syncSections = () => {
  const sections = getSections();
  setOrderedSections(sections.map((section) => ({ ...section })));
};

_.createEffect(() => {
  syncSections();
});

const handleSectionClick = (sectionId) => {
  const onSectionClick = c.props?.onSectionClick;
  if (typeof onSectionClick === "function") {
    onSectionClick(sectionId);
  }
};

const reorderSections = (fromIndex, toIndex) => {
  const sections = [...orderedSections()];
  if (fromIndex === toIndex || fromIndex < 0 || toIndex < 0) return;
  if (fromIndex >= sections.length || toIndex >= sections.length) return;
  const [moved] = sections.splice(fromIndex, 1);
  sections.splice(toIndex, 0, moved);
  setOrderedSections(sections);
};

const initDraggable = (element, index) => {
  if (!element || !_.draggable) return;

  const existingCleanup = draggableCleanups.get(element);
  if (existingCleanup) existingCleanup();

  const cleanup = _.draggable({
    element,
    getInitialData: () => ({
      type: "settings-section-nav",
      index
    }),
    onDragStart: () => {
      setDraggedIndex(index);
    },
    onDrop: () => {
      setDraggedIndex(null);
      setDragOverIndex(null);
    }
  });

  draggableCleanups.set(element, cleanup);
};

const initDropTarget = (element, index) => {
  if (!element || !_.dropTargetForElements) return;

  const cleanup = _.dropTargetForElements({
    element,
    canDrop: ({ source }) => source.data?.type === "settings-section-nav",
    onDragEnter: ({ source }) => {
      const fromIndex = source.data?.index;
      if (typeof fromIndex === "number") {
        setDragOverIndex(index);
      }
    },
    onDragLeave: () => {
      setDragOverIndex(null);
    },
    onDrop: ({ source }) => {
      const fromIndex = source.data?.index;
      if (typeof fromIndex === "number") {
        reorderSections(fromIndex, index);
      }
      setDraggedIndex(null);
      setDragOverIndex(null);
    }
  });

  return cleanup;
};

const cleanupDraggable = (element) => {
  const cleanup = draggableCleanups.get(element);
  if (cleanup) {
    cleanup();
    draggableCleanups.delete(element);
  }
};

const isActive = (sectionId) => getActiveSectionId() === sectionId;

const isDragOver = (index) => dragOverIndex() === index;
const isDragging = (index) => draggedIndex() === index;

return {
  getSections,
  orderedSections,
  handleSectionClick,
  initDraggable,
  initDropTarget,
  cleanupDraggable,
  isActive,
  isDragOver,
  isDragging
};
'''
        key: SettingsSectionNav
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const sections = f.orderedSections?.() || [];
const hideFromProps = c.props?.hide === true;
return {
  as: "nav",
  "aria-label": "Settings sections",
  hide: hideFromProps || sections.length === 0
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        contextName: sectionNavItem
        css:
          '''const item = c.sectionNavItem || {};
const index = item.index;
const active = f.isActive?.(item.section?.id);
const dragOver = f.isDragOver?.(index);
const dragging = f.isDragging?.(index);

return `._id.fulchand-section-nav-item {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.25rem 0.5rem;
  border-radius: 0.375rem;
  border: 1px solid ${active ? t.var.color.primary : t.var.color.border};
  background: ${active ? t.var.color.primary_light_100 : t.var.color.background};
  color: ${active ? t.var.color.primary : t.var.color.text};
  font-size: 0.75rem;
  font-weight: 500;
  cursor: grab;
  user-select: none;
  transition: all 0.15s ease;
  ${dragOver ? `outline: 2px dashed ${t.var.color.primary};` : ""}
  ${dragging ? "opacity: 0.5;" : ""}

  &:hover {
    border-color: ${t.var.color.primary};
  }
}`;'''
        loop: true
        displayOrder: 1
        componentName: Html
        props:
          '''const sections = f.orderedSections?.() || [];
return {
  as: "div",
  class: "fulchand-section-nav-item",
  data: sections.map((section, index) => ({ section, index }))
};'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "icon",
  icon: "ph:dots-six-vertical",
  height: 14,
  width: 14,
  class: "fulchand-section-nav-handle",
  ref: (element) => {
    const item = c.sectionNavItem || {};
    const index = item.index;
    if (element && f.initDraggable) {
      f.initDraggable(element, index);
      const dropCleanup = f.initDropTarget?.(element, index);
      element.__fssnDropCleanup = dropCleanup;
    } else if (element === null && f.cleanupDraggable) {
      f.cleanupDraggable(element);
      if (element?.__fssnDropCleanup) {
        element.__fssnDropCleanup();
        element.__fssnDropCleanup = null;
      }
    }
  }
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id {
  border: none;
  background: transparent;
  color: inherit;
  font: inherit;
  cursor: pointer;
  padding: 0;
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const item = c.sectionNavItem || {};
const section = item.section || {};
return {
  as: "button",
  type: "button",
  text: section.title || section.id || "Section",
  onClick: () => f.handleSectionClick?.(section.id)
};'''
      }
    }
  ]
  edges: [
    {
      id: e1
      T: Attr
      S: "1"
      E: "2"
    }
    {
      id: e2
      T: Attr
      S: "2"
      E: "3"
    }
    {
      id: e3
      T: Attr
      S: "3"
      E: "4"
    }
    {
      id: e4
      T: Attr
      S: "3"
      E: "5"
    }
  ]
}