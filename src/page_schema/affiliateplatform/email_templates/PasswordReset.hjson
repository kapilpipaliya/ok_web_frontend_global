{
  vertexes: [
    {
      id: "1"
      L: EmailTemplate
      P: {
        description: Sent when users request a password reset, containing a verification code valid for 10 minutes
        title: Reset Your Password
        key: PasswordReset
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        as: div
        css:
          '''return `._id {
  min-height: 100vh;
  background-color: ${t.var.color.background_hex};
  color: ${t.var.color.text_hex};
  padding: 32px;
}`;'''
        displayOrder: 1
        componentName: Html
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        as: div
        css:
          '''return `._id {
  max-width: 600px;
  margin: auto;
  padding: 32px;
  background-color: ${t.var.color.background_light_100_hex};
  color: ${t.var.color.text_hex};
}`;'''
        displayOrder: 3
        componentName: Html
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        as: div
        css: ""
        displayOrder: 1
        componentName: Html
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        as: a
        displayOrder: 1
        componentName: Html
        href: /
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          '''return `._id {
  height:80px; margin-bottom:24px;
}`;'''
        as: img
        displayOrder: 1
        componentName: Html
        props:
          '''return {
            alt: "Logo",
            src: "/api/file/downloadCompanyRectangularLogo"
            }'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        as: hr
        css:
          '''return `._id {
  border: none;
  border-top: 1px solid ${t.var.color.border_hex};
  margin-top:24px; margin-bottom:24px;
}`;'''
        displayOrder: 2
        componentName: Html
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        as: div
        css:
          '''return `._id {
  color: ${t.var.color.text_hex};
}`;'''
        displayOrder: 2
        componentName: Html
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        css:
          '''return `._id {
      color: ${t.var.color.text_hex};
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 16px;
    }`;'''
        as: h1
        displayOrder: 1
        componentName: Html
        text: Reset Your Password
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        css:
          '''return `._id {
      color: ${t.var.color.text_hex};
      margin-bottom: 16px;
    }`;'''
        as: p
        displayOrder: 2
        componentName: Html
        text: We received a request to reset your password. Please use the following verification code to complete the process:
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        as: div
        css:
          '''return `._id {
      background-color: ${t.var.color.background_light_100_hex};
      border: 2px solid ${t.var.color.primary_hex};
      border-radius: 8px;
      margin: 24px 0;
      padding: 24px 16px;
      text-align: center;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }`;'''
        displayOrder: 3
        componentName: Html
      }
    }
    {
      id: "12"
      L: Attr
      P: {
        css:
          '''return `._id {
          color: ${t.var.color.primary_hex};
          font-size: 36px;
          font-weight: 900;
          letter-spacing: 8px;
          margin: 0;
          font-family: 'Courier New', monospace;
        }`;'''
        as: p
        displayOrder: 1
        componentName: Html
        props:
          '''return {
            text: _.searchParams.otp,
          }'''
      }
    }
    {
      id: "13"
      L: Attr
      P: {
        css:
          '''return `._id {
      color: ${t.var.color.text_hex};
    }`;'''
        as: p
        displayOrder: 4
        componentName: Html
        text: This code will expire in 10 minutes. If you didn't request this password reset, please ignore this email or contact support if you have concerns.
      }
    }
    {
      id: "14"
      L: Attr
      P: {
        as: div
        css:
          '''return `._id {
  margin-top: 32px;
  text-align: center;
}`;'''
        displayOrder: 3
        componentName: Html
      }
    }
    {
      id: "15"
      L: Attr
      P: {
        css:
          '''return `._id {
  color: ${t.var.color.text_light_200_hex};
  font-size: 12px;
}`;'''
        as: p
        displayOrder: 1
        componentName: Html
        text: © 2025 ${_.globalSetting?.P.appName}. All rights reserved.
      }
    }
  ]
  edges: [
