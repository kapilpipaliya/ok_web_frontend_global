{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Generic function to fetch children vertices of a parent vertex using parentVertexLabel and toParentEdgeType. Returns vertices in Vertex format using convertNodeToJSON.
        body:
          '''
// Get current authenticated user from session
const actualUser = await _.getUserFromSession();
if (!actualUser) {
  return {
    success: false,
    message: "User session not found. Please log in and try again.",
    data: []
  };
}

// Extract parameters
const { parentVertexLabel, toParentEdgeType, parentId, rootKeys, tableVertexLabel, relationshipType, enableUserScoping, hooks, imageRelationshipType } = c;

if (!parentVertexLabel || !toParentEdgeType) {
  return {
    success: false,
    message: "parentVertexLabel and toParentEdgeType are required",
    data: []
  };
}

// Get effective user for count queries (only if user scoping is enabled)
let user = null;
let userUuid = null;
if (enableUserScoping) {
  user = await _.getEffectiveUser(_.session, actualUser, c);
  userUuid = user.P.uuid;
}

// Execute beforeGetVertexChildren hooks
await _.executeHooks(hooks?.beforeGetVertexChildren, {
  parentVertexLabel,
  toParentEdgeType,
  parentId,
  rootKeys,
  tableVertexLabel,
  relationshipType,
  enableUserScoping
});

// If parentId is provided, fetch children of that parent
// Relationship direction: child-[toParentEdgeType]->parent
if (parentId) {
  // Build query with or without user scoping
  let query;
  if (!enableUserScoping) {
    query = `
      MATCH (child:${parentVertexLabel})-[r:${toParentEdgeType}]->(parent:${parentVertexLabel})
      WHERE elementId(parent) = $parentId
      RETURN child, parent, r
      ORDER BY COALESCE(child.displayOrder, 0), COALESCE(child.key, '') ASC
    `;
  } else {
    const userRelationshipType = `User${parentVertexLabel}`;
    query = `
      MATCH (u:User {uuid: $userUuid})-[:${userRelationshipType}]->(child:${parentVertexLabel})-[r:${toParentEdgeType}]->(parent:${parentVertexLabel})
      WHERE elementId(parent) = $parentId
      RETURN child, parent, r
      ORDER BY COALESCE(child.displayOrder, 0), COALESCE(child.key, '') ASC
    `;
  }

  const queryParams = !enableUserScoping ? { parentId } : { parentId, userUuid };
  const result = await _.session.run(query, queryParams);

  // Use processResult to populate graph structure (process both child and parent vertices)
  // This will set up IN/OUT relationships correctly:
  // - child.OUT[toParentEdgeType] = [edge.id] (child points to parent)
  // - parent.IN[toParentEdgeType] = [edge.id] (parent receives from children)
  const vertices = _.processResult(result.records, _.context, ['child', 'parent'], 'r');

  // Add count to each vertex if tableVertexLabel and relationshipType are provided
  if (tableVertexLabel && relationshipType) {
    for (const vertex of vertices) {
      // Count content items related to this category
      // Relationship: content-[toParentEdgeType]->category
      // User relationship: User-[relationshipType]->content (if user scoping enabled)
      let countQuery;
      let countParams;
      if (!enableUserScoping) {
        countQuery = `
          MATCH (content:${tableVertexLabel})-[r:${toParentEdgeType}]->(cat:${parentVertexLabel})
          WHERE elementId(cat) = $categoryId
          RETURN count(DISTINCT content) as contentCount
        `;
        countParams = { categoryId: vertex.id };
      } else {
        countQuery = `
          MATCH (u:User {uuid: $userUuid})-[:${relationshipType}]->(content:${tableVertexLabel})
          MATCH (content)-[:${toParentEdgeType}]->(cat:${parentVertexLabel})
          WHERE elementId(cat) = $categoryId
          RETURN count(DISTINCT content) as contentCount
        `;
        countParams = { userUuid, categoryId: vertex.id };
      }
      const countResult = await _.session.run(countQuery, countParams);
      const contentCount = countResult.records[0]?.get('contentCount') || 0;

      // Update vertex in context with count
      if (_.context.nodes[vertex.id]) {
        _.context.nodes[vertex.id].P.contentCount = contentCount;
      }
      // Also update in the returned vertex
      vertex.P.contentCount = contentCount;
    }
  }

  const resultData = {
    success: true,
    data: vertices,
    message: `Found ${vertices.length} children`
  };

  const imageRelType =
    imageRelationshipType != null && String(imageRelationshipType).trim() !== ""
      ? String(imageRelationshipType).trim()
      : null;
  if (imageRelType && Array.isArray(vertices) && vertices.length > 0) {
    try {
      const imageResult = await _.session.run(
        `
        MATCH (v:${parentVertexLabel})-[r:${imageRelType}]->(file:File)
        WHERE elementId(v) IN $ids
        RETURN v, r, file
        `,
        { ids: vertices.map((v) => v.id).filter(Boolean) }
      );
      _.processResult(imageResult.records, _.context, ["v", "file"], "r");
    } catch (imageError) {
      console.warn("getVertexChildren image relation load failed:", imageError);
    }
  }

  // Execute afterGetVertexChildren hooks
  await _.executeHooks(hooks?.afterGetVertexChildren, {
    parentVertexLabel,
    toParentEdgeType,
    parentId,
    rootKeys,
    tableVertexLabel,
    relationshipType,
    enableUserScoping,
    result: resultData
  });

  return resultData;
}

// If rootKeys is provided, fetch root vertices
if (rootKeys) {
  // Build filter conditions from rootKeys
  const filterConditions = [];
  const params = {};
  let paramIndex = 0;

  for (const [key, value] of Object.entries(rootKeys)) {
    paramIndex++;
    const paramName = `filter${paramIndex}`;
    filterConditions.push(`v.${key} = $${paramName}`);
    params[paramName] = value;
  }

  const filterClause = filterConditions.length > 0 
    ? ` AND ${filterConditions.join(' AND ')}`
    : '';

  // Build query with or without user scoping
  let query;
  if (!enableUserScoping) {
    query = `
      MATCH (v:${parentVertexLabel})
      WHERE NOT EXISTS {
        MATCH (v)-[:${toParentEdgeType}]->(:${parentVertexLabel})
      }${filterClause}
      RETURN v
      ORDER BY COALESCE(v.displayOrder, 0), COALESCE(v.key, '') ASC
    `;
  } else {
    const userRelationshipType = `User${parentVertexLabel}`;
    query = `
      MATCH (u:User {uuid: $userUuid})-[:${userRelationshipType}]->(v:${parentVertexLabel})
      WHERE NOT EXISTS {
        MATCH (v)-[:${toParentEdgeType}]->(:${parentVertexLabel})
      }${filterClause}
      RETURN v
      ORDER BY COALESCE(v.displayOrder, 0), COALESCE(v.key, '') ASC
    `;
    params.userUuid = userUuid;
  }

  const result = await _.session.run(query, params);

  // Use processResult to populate graph structure
  const vertices = _.processResult(result.records, _.context, 'v');

  // Create 'uncategorized' item as first item (only if tableVertexLabel and relationshipType are provided)
  let uncategorizedVertex = null;
  if (tableVertexLabel && relationshipType) {
    // Count items without any category relationship
    let uncategorizedCountQuery;
    let uncategorizedCountParams;
    if (!enableUserScoping) {
      uncategorizedCountQuery = `
        MATCH (content:${tableVertexLabel})
        WHERE NOT EXISTS {
          MATCH (content)-[:${toParentEdgeType}]->(:${parentVertexLabel})
        }
        RETURN count(DISTINCT content) as contentCount
      `;
      uncategorizedCountParams = {};
    } else {
      uncategorizedCountQuery = `
        MATCH (u:User {uuid: $userUuid})-[:${relationshipType}]->(content:${tableVertexLabel})
        WHERE NOT EXISTS {
          MATCH (content)-[:${toParentEdgeType}]->(:${parentVertexLabel})
        }
        RETURN count(DISTINCT content) as contentCount
      `;
      uncategorizedCountParams = { userUuid };
    }

    const uncategorizedCountResult = await _.session.run(uncategorizedCountQuery, uncategorizedCountParams);
    const uncategorizedCount = uncategorizedCountResult.records[0]?.get('contentCount') || 0;

    // Create virtual uncategorized vertex (id is namespaced by content table label)
    const uncategorizedId = '_' + tableVertexLabel + '_uncategorized';
    uncategorizedVertex = {
      id: uncategorizedId,
      L: [parentVertexLabel],
      P: {
        key: uncategorizedId,
        name: 'Uncategorized',
        contentCount: uncategorizedCount,
        tableVertexLabel: tableVertexLabel
      },
      IN: {},
      OUT: {}
    };

    // Add to context graph
    if (!_.context.nodes) {
      _.context.nodes = {};
    }
    _.context.nodes[uncategorizedId] = uncategorizedVertex;
  }

  // Add count to each vertex if tableVertexLabel and relationshipType are provided
  if (tableVertexLabel && relationshipType) {
    for (const vertex of vertices) {
      // For root items, count items without any category relationship or items in this root
      const rootKeys = c.rootKeys || {};
      const rootKey = rootKeys.key;

      let countQuery;
      let countParams;
      if (!enableUserScoping) {
        if (vertex.P?.key === rootKey) {
          // Root key: count items without any category relationship
          countQuery = `
            MATCH (content:${tableVertexLabel})
            WHERE NOT EXISTS {
              MATCH (content)-[:${toParentEdgeType}]->(:${parentVertexLabel})
            }
            RETURN count(DISTINCT content) as contentCount
          `;
          countParams = {};
        } else {
          // Regular root item: count items related to this category
          countQuery = `
            MATCH (content:${tableVertexLabel})-[r:${toParentEdgeType}]->(cat:${parentVertexLabel})
            WHERE elementId(cat) = $categoryId
            RETURN count(DISTINCT content) as contentCount
          `;
          countParams = { categoryId: vertex.id };
        }
      } else {
        if (vertex.P?.key === rootKey) {
          // Root key: count items without any category relationship
          countQuery = `
            MATCH (u:User {uuid: $userUuid})-[:${relationshipType}]->(content:${tableVertexLabel})
            WHERE NOT EXISTS {
              MATCH (content)-[:${toParentEdgeType}]->(:${parentVertexLabel})
            }
            RETURN count(DISTINCT content) as contentCount
          `;
          countParams = { userUuid };
        } else {
          // Regular root item: count items related to this category
          countQuery = `
            MATCH (u:User {uuid: $userUuid})-[:${relationshipType}]->(content:${tableVertexLabel})
            MATCH (content)-[:${toParentEdgeType}]->(cat:${parentVertexLabel})
            WHERE elementId(cat) = $categoryId
            RETURN count(DISTINCT content) as contentCount
          `;
          countParams = { userUuid, categoryId: vertex.id };
        }
      }

      const countResult = await _.session.run(countQuery, countParams);
      const contentCount = countResult.records[0]?.get('contentCount') || 0;

      // Update vertex in context with count
      if (_.context.nodes[vertex.id]) {
        _.context.nodes[vertex.id].P.contentCount = contentCount;
      }
      // Also update in the returned vertex
      vertex.P.contentCount = contentCount;
    }
  }

  // Prepend 'uncategorized' item as first item if it exists
  const finalVertices = uncategorizedVertex 
    ? [uncategorizedVertex, ...vertices]
    : vertices;

  const resultData = {
    success: true,
    data: finalVertices,
    message: `Found ${finalVertices.length} root vertices`
  };

  // Execute afterGetVertexChildren hooks
  await _.executeHooks(hooks?.afterGetVertexChildren, {
    parentVertexLabel,
    toParentEdgeType,
    parentId: null,
    rootKeys,
    tableVertexLabel,
    relationshipType,
    enableUserScoping,
    result: resultData
  });

  return resultData;
}

// Default: return empty array
const defaultResult = {
  success: true,
  data: [],
  message: "No parentId or rootKeys provided"
};

// Execute afterGetVertexChildren hooks even for default case
await _.executeHooks(hooks?.afterGetVertexChildren, {
  parentVertexLabel,
  toParentEdgeType,
  parentId: null,
  rootKeys: null,
  tableVertexLabel,
  relationshipType,
  enableUserScoping,
  result: defaultResult
});

return defaultResult;
'''
        key: getVertexChildren
      }
    }
  ]
  edges: []
}