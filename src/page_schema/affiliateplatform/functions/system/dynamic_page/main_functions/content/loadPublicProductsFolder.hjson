{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Public product category browser. Returns breadcrumb, child categories, and affiliate products. Identify categories by key (URL /products/:category), not internal id.
        body:
          '''
const {
  tableKey = "products",
  tableVertexLabel = "Product",
  categoryKey,
  locale
} = args.contextData || {};

const resolvedTableKey = tableKey && String(tableKey).trim() !== "" ? String(tableKey).trim() : "products";
const resolvedTableVertexLabel =
  tableVertexLabel && String(tableVertexLabel).trim() !== ""
    ? String(tableVertexLabel).trim()
    : "Product";

const configResult = await args.executeNamedServerFunction({
  functionName: "loadTableConfigByKey",
  contextData: { tableKey: resolvedTableKey }
});

if (!configResult?.result?.success) {
  return configResult?.result || { success: false, message: "Failed to load products table schema" };
}

const schemaGraph = configResult.graph || configResult?.result?.graph || { vertexes: {}, edges: {} };
const partVertexIds = configResult.result.data?.partVertexIds || {};

const evalConfigBody = (cfgStr) => {
  if (cfgStr == null || String(cfgStr).trim() === "") return null;
  try {
    const configFn = new Function(String(cfgStr));
    const value = configFn();
    return value && typeof value === "object" ? value : null;
  } catch (e) {
    console.warn("loadPublicProductsFolder: config eval failed", e);
    return null;
  }
};

const stripPartMeta = (value) => {
  if (!value || typeof value !== "object" || Array.isArray(value)) return {};
  const { part: _part, ...rest } = value;
  return rest;
};

const evalPartFromGraph = (graph, partIds, part) => {
  const vertexId = partIds?.[part];
  const vertex = graph?.vertexes?.[vertexId];
  if (!vertex?.P?.config) return null;
  return evalConfigBody(vertex.P.config);
};

const generalRaw = evalPartFromGraph(schemaGraph, partVertexIds, "general");
const general = generalRaw ? stripPartMeta(generalRaw) : {};
if (general.publicRead !== true) {
  return { success: false, message: "Products table is not publicly readable" };
}

const sidebarRaw = evalPartFromGraph(schemaGraph, partVertexIds, "sidebar");
const sidebar = sidebarRaw ? stripPartMeta(sidebarRaw) : {};
const parentVertexLabel = sidebar.parentVertexLabel || "ProductCategory";
const toParentEdgeType = sidebar.toParentEdgeType || "ParentProductCategory";

if (!args.context.nodes) args.context.nodes = {};
if (!args.context.relationships) args.context.relationships = {};

const currentCategoryKey =
  categoryKey != null && String(categoryKey).trim() !== ""
    ? String(categoryKey).trim()
    : null;
const isRootView = !currentCategoryKey;

let currentCategory = null;
let currentCategoryId = null;
if (currentCategoryKey) {
  const catResult = await args.session.run(
    `
    MATCH (v:${parentVertexLabel})
    WHERE v.key = $categoryKey
    RETURN v
    LIMIT 1
    `,
    { categoryKey: currentCategoryKey }
  );
  const cats = args.processResult(catResult.records, args.context, "v") || [];
  currentCategory = cats[0] || null;
  if (!currentCategory) {
    return { success: false, message: "Product category not found" };
  }
  currentCategoryId = currentCategory.id;
}

const buildFolderEntry = async (child) => {
  if (!child?.id) return null;
  const childCountResult = await args.session.run(
    `
    MATCH (content:${resolvedTableVertexLabel})-[:${toParentEdgeType}]->(cat:${parentVertexLabel})
    WHERE elementId(cat) = $categoryId
    RETURN count(DISTINCT content) AS contentCount
    `,
    { categoryId: child.id }
  );
  const folderCountResult = await args.session.run(
    `
    MATCH (nested:${parentVertexLabel})-[:${toParentEdgeType}]->(parent:${parentVertexLabel})
    WHERE elementId(parent) = $categoryId
    RETURN count(DISTINCT nested) AS folderCount
    `,
    { categoryId: child.id }
  );
  const imageRelationshipType =
    sidebar.imageRelationshipType != null && String(sidebar.imageRelationshipType).trim() !== ""
      ? String(sidebar.imageRelationshipType).trim()
      : "ProductCategoryImage";
  let imageUrl = "";
  try {
    const imageResult = await args.session.run(
      `
      MATCH (cat:${parentVertexLabel})-[:${imageRelationshipType}]->(file:File)
      WHERE elementId(cat) = $categoryId
      RETURN file
      LIMIT 1
      `,
      { categoryId: child.id }
    );
    const files = args.processResult(imageResult.records, args.context, "file") || [];
    const fileVertex = files[0] || null;
    const fileName =
      fileVertex?.P?.fileName != null ? String(fileVertex.P.fileName).trim() : "";
    if (fileName) {
      imageUrl = "/api/file/download/" + encodeURIComponent(fileName);
    }
  } catch (imageError) {
    console.warn("loadPublicProductsFolder category image load failed:", imageError);
  }
  return {
    id: child.id,
    name: child.P?.name || child.P?.key || "Folder",
    key: child.P?.key || "",
    contentCount: Number(childCountResult.records[0]?.get("contentCount") || 0),
    folderCount: Number(folderCountResult.records[0]?.get("folderCount") || 0),
    imageUrl,
    kind: "folder"
  };
};

const folders = [];
if (isRootView) {
  // Top-level folders = categories with no parent
  const topResult = await args.session.run(
    `
    MATCH (v:${parentVertexLabel})
    WHERE NOT EXISTS { MATCH (v)-[:${toParentEdgeType}]->(:${parentVertexLabel}) }
    RETURN v
    ORDER BY COALESCE(v.displayOrder, 0), COALESCE(v.name, v.key, '') ASC
    `
  );
  const topFolders = args.processResult(topResult.records, args.context, "v") || [];
  for (const child of topFolders) {
    const entry = await buildFolderEntry(child);
    if (entry) folders.push(entry);
  }
} else {
  const childrenResult = await args.session.run(
    `
    MATCH (child:${parentVertexLabel})-[r:${toParentEdgeType}]->(parent:${parentVertexLabel})
    WHERE elementId(parent) = $parentId
    RETURN child, parent, r
    ORDER BY COALESCE(child.displayOrder, 0), COALESCE(child.name, child.key, '') ASC
    `,
    { parentId: currentCategoryId }
  );
  const childVertices = args.processResult(childrenResult.records, args.context, ["child", "parent"], "r") || [];
  for (const child of childVertices) {
    const entry = await buildFolderEntry(child);
    if (entry) folders.push(entry);
  }
}

const contentResult = await args.executeNamedServerFunction({
  functionName: "getUserContent",
  contextData: {
    tableKey: resolvedTableKey,
    tableVertexLabel: resolvedTableVertexLabel,
    parentVertexLabel,
    toParentEdgeType,
    ...(locale != null ? { locale } : {}),
    ...(currentCategoryId
      ? { categoryId: currentCategoryId }
      : { showUnassigned: true })
  }
});

if (!contentResult?.result?.success) {
  return contentResult?.result || { success: false, message: "Failed to load products" };
}

const contentGraph = contentResult.graph || contentResult?.result?.graph || { vertexes: {}, edges: {} };
const rows = Array.isArray(contentResult.result.data) ? contentResult.result.data : [];

const resolveFileFromRelation = (item, relationshipType, graph) => {
  const edgeIds = item?.OUT?.[relationshipType] || [];
  if (!Array.isArray(edgeIds) || edgeIds.length === 0) return null;
  const edge = graph.edges?.[edgeIds[0]];
  const file = edge?.E != null ? graph.vertexes?.[edge.E] : null;
  if (!file) return null;
  const fileName = file?.P?.fileName != null ? String(file.P.fileName).trim() : "";
  if (!fileName) return null;
  return {
    id: file.id,
    fileName,
    mimeType: file.P?.mimeType || file.P?.fileType || "",
    url: "/api/file/download/" + encodeURIComponent(fileName)
  };
};

const parseJsonArray = (raw) => {
  if (Array.isArray(raw)) return raw;
  if (typeof raw === "string" && raw.trim() !== "") {
    try {
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }
  return [];
};

const collectVariantImageFileIds = (variantVertices, graph) => {
  const ids = [];
  const seen = new Set();
  for (const variantVertex of variantVertices) {
    const edgeIds = variantVertex?.OUT?.ProductVariantImage || [];
    for (const edgeId of edgeIds) {
      const edge = graph.edges?.[edgeId];
      const fileId = edge?.E != null ? String(edge.E).trim() : "";
      if (!fileId || seen.has(fileId)) continue;
      seen.add(fileId);
      ids.push(fileId);
    }
  }
  return ids;
};

const resolveImageUrlMap = async (imageIds) => {
  const urlById = {};
  if (!Array.isArray(imageIds) || imageIds.length === 0) return urlById;
  const fileResult = await args.session.run(
    `
    MATCH (file:File)
    WHERE elementId(file) IN $imageIds
    RETURN file
    `,
    { imageIds }
  );
  const files = args.processResult(fileResult.records, args.context, "file") || [];
  for (const file of files) {
    if (!file?.id) continue;
    const fileName = file?.P?.fileName != null ? String(file.P.fileName).trim() : "";
    if (!fileName) continue;
    urlById[file.id] = "/api/file/download/" + encodeURIComponent(fileName);
  }
  return urlById;
};

const firstVariantPreviewUrl = (variantVertex, urlById, graph) => {
  const edgeIds = variantVertex?.OUT?.ProductVariantImage || [];
  const sortedEdgeIds = [...edgeIds].sort((leftId, rightId) => {
    const leftOrder = Number(graph.edges?.[leftId]?.P?.displayOrder) || 0;
    const rightOrder = Number(graph.edges?.[rightId]?.P?.displayOrder) || 0;
    return leftOrder - rightOrder;
  });
  for (const edgeId of sortedEdgeIds) {
    const edge = graph.edges?.[edgeId];
    const fileId = edge?.E != null ? String(edge.E).trim() : "";
    if (fileId && urlById[fileId]) return urlById[fileId];
  }
  return "";
};

const getProductVariantVertices = (item, graph) => {
  const edgeIds = item?.OUT?.ProductProductVariant || [];
  const variants = [];
  const seen = new Set();
  for (const edgeId of edgeIds) {
    const edge = graph.edges?.[edgeId];
    const variantId = edge?.E;
    if (!variantId || seen.has(variantId)) continue;
    const variantVertex = graph.vertexes?.[variantId];
    if (!variantVertex?.L?.includes("ProductVariant")) continue;
    seen.add(variantId);
    variants.push(variantVertex);
  }
  variants.sort(
    (left, right) => (Number(left.P?.displayOrder) || 0) - (Number(right.P?.displayOrder) || 0)
  );
  return variants;
};

const allVariantVertices = [];
for (const item of rows) {
  if (!item?.id) continue;
  allVariantVertices.push(...getProductVariantVertices(item, contentGraph));
}
const imageUrlById = await resolveImageUrlMap(
  collectVariantImageFileIds(allVariantVertices, contentGraph)
);

const items = rows
  .map((item) => {
    if (!item?.id) return null;
    const thumbnail = resolveFileFromRelation(item, "ProductThumbnail", contentGraph);
    const variants = getProductVariantVertices(item, contentGraph);
    const firstVariant = variants[0] || null;
    const previewUrl =
      thumbnail?.url || firstVariantPreviewUrl(firstVariant, imageUrlById, contentGraph) || "";
    return {
      id: item.id,
      key: item.P?.key != null ? String(item.P.key).trim() : "",
      title: item.P?.title || "Untitled",
      shortDescription: item.P?.shortDescription || "",
      price: firstVariant?.P?.price != null ? String(firstVariant.P.price).trim() : "",
      icon: "ph:shopping-bag",
      previewUrl,
      kind: "product"
    };
  })
  .filter(Boolean);

const breadcrumb = [
  {
    id: null,
    name: "Products",
    key: "",
    isRoot: true
  }
];

if (currentCategoryId) {
  const ancestors = [];
  let walkId = currentCategoryId;
  const seen = new Set();
  for (let depth = 0; depth < 24 && walkId; depth++) {
    if (seen.has(walkId)) break;
    seen.add(walkId);

    let walkVertex = args.context.nodes[walkId];
    if (!walkVertex) {
      const walkResult = await args.session.run(
        `
        MATCH (v:${parentVertexLabel})
        WHERE elementId(v) = $id
        RETURN v
        LIMIT 1
        `,
        { id: walkId }
      );
      const walked = args.processResult(walkResult.records, args.context, "v") || [];
      walkVertex = walked[0] || null;
    }
    if (!walkVertex) break;

    ancestors.unshift({
      id: walkVertex.id,
      name: walkVertex.P?.name || walkVertex.P?.key || "Folder",
      key: walkVertex.P?.key || "",
      isRoot: false
    });

    const parentResult = await args.session.run(
      `
      MATCH (child:${parentVertexLabel})-[:${toParentEdgeType}]->(parent:${parentVertexLabel})
      WHERE elementId(child) = $id
      RETURN parent
      LIMIT 1
      `,
      { id: walkId }
    );
    const parents = args.processResult(parentResult.records, args.context, "parent") || [];
    walkId = parents[0]?.id || null;
  }
  for (const node of ancestors) {
    breadcrumb.push(node);
  }
}

const mergedVertexes = Object.assign({}, contentGraph.vertexes || {}, schemaGraph.vertexes || {}, args.context.nodes || {});
const mergedEdges = Object.assign({}, contentGraph.edges || {}, schemaGraph.edges || {}, args.context.relationships || {});

return {
  success: true,
  data: {
    tableKey: resolvedTableKey,
    tableVertexLabel: resolvedTableVertexLabel,
    parentVertexLabel,
    toParentEdgeType,
    rootCategoryId: null,
    currentCategoryId,
    currentCategoryKey,
    currentCategory: currentCategory
      ? {
          id: currentCategory.id,
          name: currentCategory.P?.name || currentCategory.P?.key || "Folder",
          key: currentCategory.P?.key || ""
        }
      : null,
    isRootView,
    breadcrumb,
    folders,
    items,
    graph: {
      vertexes: mergedVertexes,
      edges: mergedEdges,
      deleted_vertexes: [],
      deleted_edges: []
    }
  },
  message: `Loaded ${folders.length} folder(s) and ${items.length} item(s)`
};
'''
        key: loadPublicProductsFolder
      }
    }
  ]
  edges: []
}