{
  vertexes: [
    {
      id: "tsbse_root",
      L: "Component",
      P: {
        key: "TableSidebarSchemaEditor",
        description: "Visual editor for table sidebar schema with nested formConfig groups.",
        dynamicComponent: "Button, TextInput, TextArea, LoadingSpinner, FormConfigGroupsSchemaEditor, Html",
        fns: '''
const getProps = () => c.props || {};
const getTableKey = () => {
  const v = getProps().tableKey;
  return v != null && String(v).trim() !== "" ? String(v).trim() : null;
};
const getSchemaKey = () => {
  const v = getProps().schemaKey;
  return v != null && String(v).trim() !== "" ? String(v).trim() : null;
};
const executeYTOFunction = (fn, ctx) => s({ functionName: fn, contextData: ctx || {} });

const defaultSidebar = () => ({
  part: "sidebar",
  enabled: true,
  label: "",
  parentVertexLabel: "",
  toParentEdgeType: "",
  formConfig: { gridColumns: 1, groups: [] }
});

const [loading, setLoading] = _.createSignal(false);
const [saving, setSaving] = _.createSignal(false);
const [schemaData, setSchemaData] = _.createSignal(defaultSidebar());
const [configJsonText, setConfigJsonText] = _.createSignal("");
const [jsonError, setJsonError] = _.createSignal("");
const [editorMode, setEditorMode] = _.createSignal("visual");

const isJsonMode = () => editorMode() === "json";
const syncJsonFromData = (data) => {
  setConfigJsonText(JSON.stringify(data && typeof data === "object" ? { ...data } : defaultSidebar(), null, 2));
  setJsonError("");
};

const applyLoadedSetting = (setting) => {
  if (!setting?.P?.config) {
    setSchemaData(defaultSidebar());
    syncJsonFromData(defaultSidebar());
    return;
  }
  try {
    const data = new Function(setting.P.config)();
    const base = defaultSidebar();
    const merged = {
      ...base,
      ...(data || {}),
      part: "sidebar",
      formConfig: {
        ...base.formConfig,
        ...(data?.formConfig || {}),
        groups: Array.isArray(data?.formConfig?.groups) ? data.formConfig.groups : []
      }
    };
    setSchemaData(merged);
    syncJsonFromData(merged);
  } catch (error) {
    setSchemaData(defaultSidebar());
    setConfigJsonText(String(setting.P.config || ""));
    setJsonError("Failed to parse stored config");
  }
};

const loadSchema = async () => {
  const schemaKey = getSchemaKey();
  if (!schemaKey) return;
  setLoading(true);
  try {
    const result = await executeYTOFunction("getTableSchema", { key: schemaKey });
    if (!result?.result?.success) {
      _.showErrorToast?.(result?.result?.message || "Failed to load table schema");
      return;
    }
    applyLoadedSetting(result.result.data?.setting);
  } catch (error) {
    _.showErrorToast?.("Failed to load table schema");
  } finally {
    setLoading(false);
  }
};

const patchSidebar = (partial) => {
  const next = { ...(schemaData() || defaultSidebar()), ...partial, part: "sidebar" };
  setSchemaData(next);
  syncJsonFromData(next);
};

const getSidebarValue = (key) => schemaData()?.[key];
const getFormConfigGroups = () => schemaData()?.formConfig?.groups || [];

const onFormConfigGroupsChange = (patch) => {
  const current = schemaData() || defaultSidebar();
  patchSidebar({
    formConfig: {
      ...(current.formConfig || {}),
      groups: patch?.groups || []
    }
  });
};

const saveSchema = async () => {
  const schemaKey = getSchemaKey();
  if (!schemaKey) {
    _.showErrorToast?.("Schema key is missing");
    return;
  }
  setSaving(true);
  try {
    const configObj = isJsonMode() ? JSON.parse(configJsonText()) : schemaData();
    const configBody = `return ${JSON.stringify(configObj, null, 2)};`;
    const result = await executeYTOFunction("saveTableSchema", {
      key: schemaKey,
      tableKey: getTableKey(),
      part: "sidebar",
      config: configBody,
      name: getProps().title || "Table sidebar schema"
    });
    if (!result?.result?.success) {
      _.showErrorToast?.(result?.result?.message || "Failed to save");
      return;
    }
    _.showSuccessToast?.(result.result.message || "Table schema saved");
    applyLoadedSetting(result.result.data?.setting);
    getProps().onSaved?.();
  } catch (error) {
    _.showErrorToast?.(isJsonMode() ? "Invalid JSON" : "Failed to save table schema");
  } finally {
    setSaving(false);
  }
};

const setEditorModeSafe = (mode) => {
  if (mode === "json") syncJsonFromData(schemaData());
  setEditorMode(mode);
};

return {
  loading, saving, isJsonMode, configJsonText, setConfigJsonText, jsonError,
  loadSchema, saveSchema, setEditorMode: setEditorModeSafe,
  patchSidebar, getSidebarValue, getFormConfigGroups, onFormConfigGroupsChange
};
'''
      }
    },
    {
      id: "tsbse_shell",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''return { as: "div", hide: c.props?.hide === true, onMount: () => { void f.loadSchema?.(); } };''',
        css: '''
return `._id {
  display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden; height: 100%;
  background: ${t.var.color.background};
}`;
'''
      }
    },
    {
      id: "tsbse_toolbar",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''return { as: "header" };''',
        css: '''
return `._id {
  display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
  padding: 0.75rem 1rem; border-bottom: 1px solid ${t.var.color.border};
  background: ${t.var.color.background_light_100}; flex-shrink: 0;
}`;
'''
      }
    },
    {
      id: "tsbse_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''return { as: "h3", text: c.props?.title || "Table sidebar" };''',
        css: '''return `._id { margin: 0; font-size: 0.9375rem; font-weight: 700; }`;'''
      }
    },
    {
      id: "tsbse_actions",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''return { as: "div" };''',
        css: '''return `._id { display: flex; gap: 0.5rem; }`;'''
      }
    },
    {
      id: "tsbse_visual_tab",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Button",
        props: '''
return {
  variant: f.isJsonMode?.() ? "secondary" : "primary", size: "sm", text: "Visual", type: "button",
  onClick: () => f.setEditorMode?.("visual")
};
'''
      }
    },
    {
      id: "tsbse_json_tab",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Button",
        props: '''
return {
  variant: f.isJsonMode?.() ? "primary" : "secondary", size: "sm", text: "JSON", type: "button",
  onClick: () => f.setEditorMode?.("json")
};
'''
      }
    },
    {
      id: "tsbse_save",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Button",
        props: '''
return {
  variant: "primary", size: "sm", text: f.saving?.() ? "Saving..." : "Save", type: "button",
  disabled: f.saving?.() === true, onClick: () => { void f.saveSchema?.(); }
};
'''
      }
    },
    {
      id: "tsbse_loading",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "LoadingSpinner",
        props: '''return { hide: f.loading?.() !== true };'''
      }
    },
    {
      id: "tsbse_body",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''return { as: "div", hide: f.loading?.() === true };''',
        css: '''return `._id { flex: 1; min-height: 0; overflow: hidden; display: flex; flex-direction: column; }`;'''
      }
    },
    {
      id: "tsbse_visual",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''return { as: "div", hide: f.isJsonMode?.() === true };''',
        css: '''
return `._id {
  flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 0.75rem;
  padding: 0.75rem 1rem; overflow: auto;
}`;
'''
      }
    },
    {
      id: "tsbse_meta",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''return { as: "div" };''',
        css: '''
return `._id {
  display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem;
  padding: 0.625rem; border: 1px solid ${t.var.color.border}; border-radius: 0.5rem;
  @media (max-width: 768px) { grid-template-columns: 1fr; }
}`;
'''
      }
    },
    {
      id: "tsbse_enabled_wrap",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''return { as: "label" };''',
        css: '''return `._id { display: flex; align-items: center; gap: 0.375rem; font-size: 0.8125rem; grid-column: 1 / -1; }`;'''
      }
    },
    {
      id: "tsbse_enabled",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "input", type: "checkbox", checked: f.getSidebarValue?.("enabled") !== false,
  onChange: (e) => f.patchSidebar?.({ enabled: e.target.checked })
};
'''
      }
    },
    {
      id: "tsbse_enabled_text",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''return { as: "span", text: "Enabled" };'''
      }
    },
    {
      id: "tsbse_label_input",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "TextInput",
        props: '''
return {
  label: "Label", value: f.getSidebarValue?.("label") || "",
  onChange: (e) => f.patchSidebar?.({ label: e.target.value })
};
'''
      }
    },
    {
      id: "tsbse_parent_label",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "TextInput",
        props: '''
return {
  label: "Parent vertex label", value: f.getSidebarValue?.("parentVertexLabel") || "",
  onChange: (e) => f.patchSidebar?.({ parentVertexLabel: e.target.value })
};
'''
      }
    },
    {
      id: "tsbse_edge_type",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "TextInput",
        props: '''
return {
  label: "To parent edge type", value: f.getSidebarValue?.("toParentEdgeType") || "",
  onChange: (e) => f.patchSidebar?.({ toParentEdgeType: e.target.value })
};
'''
      }
    },
    {
      id: "tsbse_form_config",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "FormConfigGroupsSchemaEditor",
        props: '''
return {
  groups: f.getFormConfigGroups?.() || [],
  siteLanguages: c.props?.siteLanguages,
  onChange: (patch) => f.onFormConfigGroupsChange?.(patch)
};
'''
      }
    },
    {
      id: "tsbse_json_panel",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''return { as: "div", hide: f.isJsonMode?.() !== true };''',
        css: '''return `._id { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 0.75rem 1rem; }`;'''
      }
    },
    {
      id: "tsbse_json_area",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "TextArea",
        props: '''
return {
  value: f.configJsonText?.() || "",
  onInput: (e) => f.setConfigJsonText?.(e.target.value),
  rows: 24,
  style: { flex: "1", "min-height": "200px", "font-family": "monospace", "font-size": "0.8125rem" }
};
'''
      }
    }
  ],
  edges: [
    { id: "tsbse_e1", T: "Attr", S: "tsbse_root", E: "tsbse_shell" },
    { id: "tsbse_e2", T: "Attr", S: "tsbse_shell", E: "tsbse_toolbar" },
    { id: "tsbse_e3", T: "Attr", S: "tsbse_shell", E: "tsbse_loading" },
    { id: "tsbse_e4", T: "Attr", S: "tsbse_shell", E: "tsbse_body" },
    { id: "tsbse_e5", T: "Attr", S: "tsbse_toolbar", E: "tsbse_title" },
    { id: "tsbse_e6", T: "Attr", S: "tsbse_toolbar", E: "tsbse_actions" },
    { id: "tsbse_e7", T: "Attr", S: "tsbse_actions", E: "tsbse_visual_tab" },
    { id: "tsbse_e8", T: "Attr", S: "tsbse_actions", E: "tsbse_json_tab" },
    { id: "tsbse_e9", T: "Attr", S: "tsbse_actions", E: "tsbse_save" },
    { id: "tsbse_e10", T: "Attr", S: "tsbse_body", E: "tsbse_visual" },
    { id: "tsbse_e11", T: "Attr", S: "tsbse_body", E: "tsbse_json_panel" },
    { id: "tsbse_e12", T: "Attr", S: "tsbse_visual", E: "tsbse_meta" },
    { id: "tsbse_e13", T: "Attr", S: "tsbse_visual", E: "tsbse_form_config" },
    { id: "tsbse_e14", T: "Attr", S: "tsbse_meta", E: "tsbse_enabled_wrap" },
    { id: "tsbse_e15", T: "Attr", S: "tsbse_meta", E: "tsbse_label_input" },
    { id: "tsbse_e16", T: "Attr", S: "tsbse_meta", E: "tsbse_parent_label" },
    { id: "tsbse_e17", T: "Attr", S: "tsbse_meta", E: "tsbse_edge_type" },
    { id: "tsbse_e18", T: "Attr", S: "tsbse_enabled_wrap", E: "tsbse_enabled" },
    { id: "tsbse_e19", T: "Attr", S: "tsbse_enabled_wrap", E: "tsbse_enabled_text" },
    { id: "tsbse_e20", T: "Attr", S: "tsbse_json_panel", E: "tsbse_json_area" }
  ]
}
