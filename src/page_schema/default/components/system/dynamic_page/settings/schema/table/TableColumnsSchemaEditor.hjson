''',
        css: '''
return `._id { margin: 0; font-size: 0.9375rem; font-weight: 700; }`;
'''
      }
    },
    {
      id: "tcse_actions",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''return { as: "div" };''',
        css: '''return `._id { display: flex; gap: 0.5rem; }`;'''
