    },
    {
      id: "tcse_col_loop",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        contextName: "tcseColIndex",
        loop: true,
        props: '''return { data: args.fns.getColumnIndices?.() || [] };'''
      }
    },
    {
      id: "tcse_col_card",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const index = args.contextData.tcseColIndex;
const col = args.fns.getColumnAt?.(index) || {};
const selected = args.fns.selectedColumnIndex?.() === index;
return {
  as: "button", type: "button",
  class: selected ? "tcse-col-card tcse-col-card-selected" : "tcse-col-card",
  onClick: () => args.fns.setSelectedColumnIndex?.(index),
  text: `${col.label || col.key || "Column"} (${col.key || "?"})`
};
''',
        css: '''
return `._id.tcse-col-card {
  display: block; width: 100%; padding: 0.5rem; text-align: left;
  border: 1px solid ${args.theme.var.color.border}; border-radius: 0.375rem;
  background: ${args.theme.var.color.background}; font-size: 0.75rem; cursor: pointer;
}
._id.tcse-col-card-selected {
  border-color: ${args.theme.var.color.primary};
  background: ${args.theme.var.color.primary_light_100};
}`;
'''
      }
    },
    {
      id: "tcse_col_detail",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return { as: "div", hide: args.fns.selectedColumnIndex?.() == null };
''',
        css: '''
return `._id {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.5rem;
  padding: 0.625rem;
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.5rem;
  background: ${args.theme.var.color.background_light_50};
  overflow: auto;
  align-content: start;
}`;
'''
      }
    },
