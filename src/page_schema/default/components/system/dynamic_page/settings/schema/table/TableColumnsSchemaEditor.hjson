  ],
  edges: [
    { id: "tcse_e1", T: "Attr", S: "tcse_root", E: "tcse_shell" },
    { id: "tcse_e2", T: "Attr", S: "tcse_shell", E: "tcse_toolbar" },
    { id: "tcse_e3", T: "Attr", S: "tcse_shell", E: "tcse_loading" },
    { id: "tcse_e4", T: "Attr", S: "tcse_shell", E: "tcse_body" },
    { id: "tcse_e5", T: "Attr", S: "tcse_toolbar", E: "tcse_title" },
    { id: "tcse_e6", T: "Attr", S: "tcse_toolbar", E: "tcse_actions" },
    { id: "tcse_e7", T: "Attr", S: "tcse_actions", E: "tcse_visual_tab" },
    { id: "tcse_e8", T: "Attr", S: "tcse_actions", E: "tcse_json_tab" },
    { id: "tcse_e9", T: "Attr", S: "tcse_actions", E: "tcse_save" },
    { id: "tcse_e10", T: "Attr", S: "tcse_body", E: "tcse_visual" },
