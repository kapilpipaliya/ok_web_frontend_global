  size: "sm", text: "Visual", type: "button",
  onClick: () => args.fns.setEditorMode?.("visual")
};
'''
      }
    },
    {
      id: "tcse_json_tab",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Button",
        props: '''
return {
  variant: args.fns.isJsonMode?.() ? "primary" : "secondary",
  size: "sm", text: "JSON", type: "button",
  onClick: () => args.fns.setEditorMode?.("json")
};
'''
      }
    },
    {
      id: "tcse_save",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Button",
        props: '''
return {
  variant: "primary", size: "sm",
  text: args.fns.saving?.() ? "Saving..." : "Save",
  type: "button", disabled: args.fns.saving?.() === true,
  onClick: () => { void args.fns.saveSchema?.(); }
};
'''
      }
    },
    {
      id: "tcse_loading",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "LoadingSpinner",
        props: '''return { hide: args.fns.loading?.() !== true };'''
      }
    },
    {
      id: "tcse_body",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return { as: "div", hide: args.fns.loading?.() === true };
''',
        css: '''
return `._id { flex: 1; min-height: 0; display: flex; flex-direction: column; overflow: hidden; }`;
'''
      }
    },
    {
      id: "tcse_visual",
      L: "Attr",
      P: {
