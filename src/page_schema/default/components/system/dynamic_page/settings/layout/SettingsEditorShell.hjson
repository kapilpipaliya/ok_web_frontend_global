{
  vertexes: [
    {
      id: "ses_root",
      L: "Component",
      P: {
        key: "SettingsEditorShell",
        description: "Content/Fields tab split with DynamicPage content editor and SettingsPageSchemaEditor.",
        dynamicComponent: "Button, DynamicPage, SettingsPageSchemaEditor"
      }
    },
    {
      id: "ses_shell",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: c.props?.hide === true
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  height: 100%;
}`;
'''
      }
    },
    {
      id: "ses_tabs",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return { as: "div" };
''',
        css: '''
return `._id {
  display: flex;
  gap: 0.25rem;
  padding: 0.5rem 0.75rem;
  border-bottom: 1px solid ${t.var.color.border};
  background: ${t.var.color.background_light_100};
  flex-shrink: 0;
}`;
'''
      }
    },
    {
      id: "ses_content_tab",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Button",
        props: '''
const isSchemaMode = c.props?.isSchemaMode;
const active = typeof isSchemaMode === "function" ? !isSchemaMode() : isSchemaMode !== true;
return {
  variant: active ? "primary" : "secondary",
  size: "sm",
  text: c.props?.contentTabLabel || "Content",
  type: "button",
  onClick: () => c.props?.onSetContentMode?.()
};
'''
      }
    },
    {
      id: "ses_schema_tab",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Button",
        props: '''
const isSchemaMode = c.props?.isSchemaMode;
const active = typeof isSchemaMode === "function" ? isSchemaMode() === true : isSchemaMode === true;
return {
  variant: active ? "primary" : "secondary",
  size: "sm",
  text: c.props?.schemaTabLabel || "Field schema",
  type: "button",
  onClick: () => c.props?.onSetSchemaMode?.()
};
'''
      }
    },
    {
      id: "ses_content_pane",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const isSchemaMode = c.props?.isSchemaMode;
const hide = typeof isSchemaMode === "function" ? isSchemaMode() === true : isSchemaMode === true;
return { as: "div", hide };
''',
        css: '''
return `._id {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}`;
'''
      }
    },
    {
      id: "ses_content_inner",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return { as: "div" };
''',
        css: '''
return `._id {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  height: 100%;
  position: relative;
}`;
'''
      }
    },
    {
      id: "ses_dynamic_page",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "DynamicPage",
        props: '''
const settingsPageId = c.props?.settingsPageId;
return {
  key: c.props?.dynamicPageKey || "settings_editor_dynamic_page",
  pageMode: "settings",
  settingsPageId,
  loadFromSetting: true,
  embeddedMode: c.props?.embeddedMode !== false,
  hideSettingsSidebar: c.props?.hideSettingsSidebar === true,
  scopeId: c.props?.scopeId || "Default",
  siteLanguages: c.props?.siteLanguages || [],
  scope: c.props?.scope || {
    vertexLabel: "GlobalSetting",
    matchProperty: "key",
    idParam: "scopeId"
  },
  hide: !settingsPageId
};
'''
      }
    },
    {
      id: "ses_schema_pane",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const isSchemaMode = c.props?.isSchemaMode;
const show = typeof isSchemaMode === "function" ? isSchemaMode() === true : isSchemaMode === true;
return { as: "div", hide: !show };
''',
        css: '''
return `._id {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}`;
'''
      }
    },
    {
      id: "ses_schema_editor",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "SettingsPageSchemaEditor",
        props: '''
const settingsPageId = c.props?.settingsPageId;
return {
  settingsPageId,
  embeddedMode: true,
  siteLanguages: c.props?.siteLanguages || [],
  onSaved: () => c.props?.onSchemaSaved?.()
};
'''
      }
    }
  ],
  edges: [
    { id: "ses_e1", T: "Attr", S: "ses_root", E: "ses_shell" },
    { id: "ses_e2", T: "Attr", S: "ses_shell", E: "ses_tabs" },
    { id: "ses_e3", T: "Attr", S: "ses_shell", E: "ses_content_pane" },
    { id: "ses_e4", T: "Attr", S: "ses_shell", E: "ses_schema_pane" },
    { id: "ses_e5", T: "Attr", S: "ses_tabs", E: "ses_content_tab" },
    { id: "ses_e6", T: "Attr", S: "ses_tabs", E: "ses_schema_tab" },
    { id: "ses_e7", T: "Attr", S: "ses_content_pane", E: "ses_content_inner" },
    { id: "ses_e8", T: "Attr", S: "ses_content_inner", E: "ses_dynamic_page" },
    { id: "ses_e9", T: "Attr", S: "ses_schema_pane", E: "ses_schema_editor" }
  ]
}
