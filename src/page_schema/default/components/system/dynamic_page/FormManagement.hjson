        displayOrder: 3
        componentName: Html
        props:
          '''
const field = args.contextData.field;
const value = args.fns.getFieldValue(field.key);
const setFieldValue = args.fns.setFieldValue;
const fieldDisabled = args.fns.isFieldDisabled(field);
const fieldRequired = args.fns.isFieldRequired(field);
const tooltipMeta = args.fns.getFieldTooltipMeta(field);
const hintId = `fm-field-hint-${field.key}`;
const accessibility = tooltipMeta.showBelow && tooltipMeta.body ? { "aria-describedby": hintId } : {};

// Render appropriate input from field renderer (+ dataType for validation/input kind)
if (args.fns.getFieldRenderer(field) === "graphFileUpload") {
  const baseUploadConfiguration =
    field.uploadConfiguration != null &&
    typeof field.uploadConfiguration === "object" &&
    !Array.isArray(field.uploadConfiguration)
      ? field.uploadConfiguration
      : null;
  if (!baseUploadConfiguration) {
    return { as: "motionFragment", hide: true };
  }
  return {
    componentName: "FileUploader",
    disabled: fieldDisabled,
    uploadConfiguration: baseUploadConfiguration,
    uploadCallbacks: {
      setFieldValue,
      assignFormVertex: args.fns.assignFormVertex,
      setFormVertexId: args.fns.setFormVertexId,
      formVertexId: args.fns.formVertexId,
      setFormTxnId: args.fns.setFormTxnId,
      formTxnId: args.fns.formTxnId,
      revertTransaction: args.revertTransaction,
    },
    ...accessibility
  };
}

if (args.fns.getFieldRenderer(field) === "embeddedVertexPicker") {
  const pickerConfiguration =
    field.pickerConfiguration != null && typeof field.pickerConfiguration === "object"
      ? field.pickerConfiguration
      : null;
  if (!pickerConfiguration) {
    return { as: "motionFragment", hide: true };
  }
  if (pickerConfiguration.usePolarisUI === undefined) {
    pickerConfiguration.usePolarisUI = args.fns.getUsePolarisUI?.() === true;
  }
  const selectedElementId = value != null && String(value).trim() !== "" ? String(value).trim() : "";
  const selectedVertex =
    selectedElementId && args.graph.vertexes[selectedElementId]
      ? args.graph.vertexes[selectedElementId]
      : null;
  const previewFileNamePropertyKey =
    pickerConfiguration.previewFileNameProperty != null
      ? String(pickerConfiguration.previewFileNameProperty)
      : "fileName";
  const fileDownloadUrlPrefix =
    pickerConfiguration.fileDownloadUrlPrefix != null
      ? String(pickerConfiguration.fileDownloadUrlPrefix).trim()
      : "";
  let previewUrl = "";
  if (fileDownloadUrlPrefix !== "" && selectedVertex?.P?.[previewFileNamePropertyKey] != null) {
    const previewFileName = String(selectedVertex.P[previewFileNamePropertyKey]).trim();
    if (previewFileName !== "") {
      previewUrl = `${fileDownloadUrlPrefix}/${encodeURIComponent(previewFileName)}`;
    }
  }
  let secondaryLabel = "";
  if (pickerConfiguration.secondaryLabel != null) {
    secondaryLabel = String(pickerConfiguration.secondaryLabel).trim();
  } else if (pickerConfiguration.buildSecondaryLabelFromVertex === true && selectedVertex) {
    const label = selectedVertex.P?.[previewFileNamePropertyKey];
    if (label != null && String(label).trim() !== "") {
      secondaryLabel = String(label).trim();
    }
  }
  const showImagePreview =
    pickerConfiguration.showImagePreview === true && previewUrl !== "";
  const selectionMode =
    pickerConfiguration.selectionMode === "multiple" ? "multiple" : "single";
  const selectedValues =
    selectionMode === "multiple" && Array.isArray(value)
      ? value.map((id) => String(id)).filter((id) => id.trim() !== "")
      : selectionMode === "multiple" && value != null && String(value).trim() !== ""
        ? [String(value).trim()]
        : [];
  return {
    componentName: "VertexPicker",
    value: selectionMode === "single" ? selectedElementId : "",
    values: selectionMode === "multiple" ? selectedValues : undefined,
    secondaryLabel,
    previewUrl,
    showImagePreview,
    disabled: fieldDisabled,
    pickerConfiguration,
    onSelect: (vertexElementId, selectedVertexPayload) => {
      setFieldValue(field.key, vertexElementId);
      if (selectedVertexPayload && !args.graph.vertexes[vertexElementId]) {
        args.setGraphData(0, { vertexes: { [vertexElementId]: selectedVertexPayload } }, {});
      }
    },
    onSelectMultiple: (vertexElementIds, selectedVertexPayloads) => {
      setFieldValue(field.key, vertexElementIds);
      if (Array.isArray(selectedVertexPayloads)) {
        const vertexMap = {};
        for (const selectedVertexPayload of selectedVertexPayloads) {
          if (selectedVertexPayload?.id && !args.graph.vertexes[selectedVertexPayload.id]) {
            vertexMap[selectedVertexPayload.id] = selectedVertexPayload;
          }
        }
        if (Object.keys(vertexMap).length > 0) {
          args.setGraphData(0, { vertexes: vertexMap }, {});
        }
      }
    },
    onClear: () => setFieldValue(field.key, selectionMode === "multiple" ? [] : ""),
    ...accessibility
  };
}

if (args.fns.getFieldRenderer(field) === "fieldArray" && field.fieldArrayConfig) {
  return {
    componentName: "FormFieldArray",
    field,
    value: args.fns.getFieldValue(field.key),
    disabled: fieldDisabled,
    siteLanguages: args.fns.getSiteLanguages?.(),
    onChange: (nextItems) => args.fns.setFieldValue(field.key, nextItems)
  };
}

if (args.fns.getFieldRenderer(field) === "nestedLineItems" && field.nestedLineItemsConfig) {
  return {
    componentName: "FormNestedLineItems",
    field,
    disabled: fieldDisabled,
    getRows: () => args.fns.getNestedLineVerticesForField(field),
    getParentVertex: () => args.fns.getFormVertex(),
    ensureTxn: () => args.fns.ensureFormTxn(),
    markDeleted: (lineId) => args.fns.markNestedLineDeleted(field.key, lineId)
  };
}

if (args.fns.getFieldRenderer(field) === "textArea") {
  if (args.fns.isTranslatableTextField(field)) {
    return {
      componentName: "FormLocalizedText",
      languages: args.fns.getSiteLanguages?.(),
      value: value,
      multiline: true,
      onChange: (nextValue) => setFieldValue(field.key, nextValue),
      required: fieldRequired,
      disabled: fieldDisabled
    };
  }
  return {
    componentName: "TextArea",
    value: value,
    onChange: (e) => setFieldValue(field.key, e.target.value),
    placeholder: field.placeholder || "",
    required: fieldRequired,
    maxLength: field.maxLength,
    disabled: fieldDisabled,
    ...accessibility
  };
}

if (
  (args.fns.getFieldRenderer(field) === "multiSelect" || field.multiSelect === true) &&
  field.selectConfig &&
  !field.selectConfig.propertyOnly
) {
  const labelFieldName = field.selectConfig.labelField || "name";
  const labelKey = String(labelFieldName).includes(".")
    ? String(labelFieldName)
    : `P.${labelFieldName}`;
  const enableUserScoping =
    field.selectConfig.enableUserScoping !== undefined
      ? field.selectConfig.enableUserScoping
      : false;
  const rawVal = value;
  const arrVal = Array.isArray(rawVal) ? rawVal : rawVal ? [rawVal] : [];
  return {
    componentName: "TomSelect",
    multiple: true,
    value: arrVal,
    onChange: (newValue) => {
      const arr = Array.isArray(newValue)
        ? newValue.filter((option) => option != null && String(option).trim() !== "")
        : newValue != null && String(newValue).trim() !== ""
          ? [String(newValue).trim()]
          : [];
      setFieldValue(field.key, arr);
    },
    functionName: "getUserVertices",
    singularName: field.label || field.key,
    pluralName: field.label || field.key,
    valueKey: "id",
    labelKey,
    functionContext: {
      label: field.selectConfig.label,
      search: field.selectConfig.search || "",
      limit: field.selectConfig.limit,
      relationshipType: field.selectConfig.relationshipType,
      enableUserScoping
    },
    placeholder: field.placeholder || `Select ${field.label || field.key}...`,
    required: fieldRequired,
    disabled: fieldDisabled,
    ...accessibility
  };
}

if (args.fns.isRelationField(field) && field.optionsPicklist?.picklistKey) {
  const picklistKey = String(field.optionsPicklist.picklistKey || "").trim();
  return {
    componentName: "TomSelect",
    value: value,
    onChange: (newValue) => {
      setFieldValue(field.key, newValue);
    },
    functionName: "getWorkshopPicklist",
    singularName: field.label || field.key,
    pluralName: field.label || field.key,
    valueKey: "P.value",
    labelKey: "P.label",
    dataKey: "options",
    functionContext: { picklistKey },
    placeholder: field.placeholder || `Select ${field.label || field.key}...`,
    required: fieldRequired,
    disabled: fieldDisabled,
    ...accessibility
  };
}

if (args.fns.isRelationField(field) && field.selectConfig) {
  const labelFieldName = field.selectConfig.labelField || "name";
  const labelKey = String(labelFieldName).includes(".")
    ? String(labelFieldName)
    : `P.${labelFieldName}`;
  const enableUserScoping =
    field.selectConfig.enableUserScoping !== undefined
      ? field.selectConfig.enableUserScoping
      : false;

  return {
    componentName: "TomSelect",
    value: value,
    onChange: (newValue) => {
      setFieldValue(field.key, newValue);
    },
    functionName: "getUserVertices",
    singularName: field.label || field.key,
    pluralName: field.label || field.key,
    valueKey: "id",
    labelKey,
    functionContext: {
      label: field.selectConfig.label,
      search: field.selectConfig.search || "",
      limit: field.selectConfig.limit,
      relationshipType: field.selectConfig.relationshipType,
      enableUserScoping
    },
    placeholder: field.placeholder || `Select ${field.label || field.key}...`,
    required: fieldRequired,
    disabled: fieldDisabled,
    ...accessibility
  };
}

if (args.fns.isRelationField(field) && Array.isArray(field.options)) {
  return {
    componentName: "TomSelect",
    value: value,
    onChange: (newValue) => {
      setFieldValue(field.key, newValue);
    },
    options: field.options,
    placeholder: field.placeholder || `Select ${field.label || field.key}...`,
    required: fieldRequired,
    disabled: fieldDisabled,
    ...accessibility
  };
}

if (args.fns.getFieldDataType(field) === "boolean" || args.fns.getFieldRenderer(field) === "checkbox") {
  return {
    as: "input",
    type: "checkbox",
    checked: value === true || value === "true",
    onChange: (e) => {
      setFieldValue(field.key, e.target.checked);
    },
    disabled: fieldDisabled,
    ...accessibility
  };
}

if (args.fns.getFieldDataType(field) === "date") {
  let dateValue = value;
  if (typeof dateValue === "string") {
    if (dateValue.includes("T")) {
      dateValue = dateValue.split("T")[0];
    } else if (dateValue.length > 10) {
      dateValue = dateValue.slice(0, 10);
    }
  }
  return {
    componentName: "TextInput",
    type: "date",
    value: dateValue || "",
    placeholder: field.placeholder || "",
    required: fieldRequired,
    disabled: fieldDisabled || args.fns.isSubmitting(),
    onChange: (e) => {
      setFieldValue(field.key, e.target.value);
    },
    ...accessibility
  };
}

if (args.fns.getFieldDataType(field) === "number") {
  return {
    componentName: "TextInput",
    type: "number",
    value: value,
    onChange: (e) => {
      setFieldValue(field.key, e.target.value);
    },
    placeholder: field.placeholder || "",
    required: fieldRequired,
    min: field.min,
    max: field.max,
    disabled: fieldDisabled,
    ...accessibility
  };
}

// Default: text input
if (args.fns.isTranslatableTextField(field) && args.fns.getFieldRenderer(field) === "text") {
  return {
    componentName: "FormLocalizedText",
    languages: args.fns.getSiteLanguages?.(),
    value: value,
    multiline: false,
    onChange: (nextValue) => setFieldValue(field.key, nextValue),
    required: fieldRequired,
    disabled: fieldDisabled
  };
}

return {
  componentName: "TextInput",
  type: args.fns.getFieldDataType(field) === "email" ? "email" : "text",
  value: value,
  onChange: (e) => {
    setFieldValue(field.key, e.target.value);
  },
  placeholder: field.placeholder || "",
  required: fieldRequired,
  maxLength: field.maxLength,
  minLength: field.minLength,
  disabled: fieldDisabled,
  ...accessibility
};
