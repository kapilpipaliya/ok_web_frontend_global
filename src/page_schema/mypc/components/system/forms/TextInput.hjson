{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: TextInput
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''
const hasLeftIcon = !!c.props?.leftIcon;
const hasRightIcon = !!c.props?.rightIcon;
const iconSize = c.props?.iconSize || 20;

return `._id {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  border: 1px solid ${t.var.color.border};
  border-radius: ${t.var.borderRadius.sm};
  background: ${t.var.color.background};
  transition: all 150ms ease;

  &:focus-within {
    border-color: ${t.var.color.primary};
    box-shadow: 0 0 0 3px ${t.var.color.primary_light_200};
  }

  &:hover:not(:focus-within) {
    border-color: ${t.var.color.border_dark_200};
  }

  &.disabled {
    background: ${t.var.color.background_light_100};
    opacity: 0.6;
    cursor: not-allowed;
  }
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div"
};
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''
return `._id {
  color: ${t.var.color.text_light_500};
  flex-shrink: 0;
  margin-left: ${t.var.spacing.md};
  margin-right: ${t.var.spacing.sm};
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const leftIcon = c.props?.leftIcon;
const iconSize = c.props?.iconSize || 20;

return {
  as: "icon",
  icon: leftIcon,
  width: iconSize,
  height: iconSize,
  hide: !leftIcon
};
'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''
const hasLeftIcon = !!c.props?.leftIcon;
const hasRightIcon = !!c.props?.rightIcon;

return `._id {
  flex: 1;
  width: 100%;
  padding: ${t.var.spacing.sm} ${hasRightIcon ? '0' : t.var.spacing.md} ${t.var.spacing.sm} ${hasLeftIcon ? '0' : t.var.spacing.md};
  border: none;
  outline: none;
  font-size: 1rem;
  background: transparent;
  color: ${t.var.color.text};
  // line-height: 1.5;

  &::placeholder {
    color: ${t.var.color.text_light_500};
    opacity: 1;
    font-size: 0.875rem;
  }

  &:disabled {
    cursor: not-allowed;
  }
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''
return {
  as: "input",
  type: c.props?.type || "text",
  value: c.props?.value || "",
  placeholder: c.props?.placeholder || "",
  required: c.props?.required || false,
  disabled: c.props?.disabled || false,
  title: c.props?.title || undefined,
  "aria-describedby": c.props?.["aria-describedby"] || undefined,
  // readOnly: c.props?.readOnly || false, // not work on server
  maxLength: c.props?.maxLength || undefined,
  minLength: c.props?.minLength || undefined,
  autoFocus: c.props?.autoFocus || false,
  onChange: c.props?.onChange || null,
  onBlur: c.props?.onBlur || null,
  onFocus: c.props?.onFocus || null,
  onInput: c.props?.onInput || null,
  onKeyDown: c.props?.onKeyDown || null,
  onMount: c.props?.onMount || null
};
'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''
return `._id {
  color: ${t.var.color.text_light_500};
  flex-shrink: 0;
  margin-left: ${t.var.spacing.sm};
  margin-right: ${t.var.spacing.md};
}`;
'''
        displayOrder: 3
        componentName: Html
        props:
          '''
const rightIcon = c.props?.rightIcon;
const iconSize = c.props?.iconSize || 20;

return {
  as: "icon",
  icon: rightIcon,
  width: iconSize,
  height: iconSize,
  hide: !rightIcon
};
'''
      }
    }
