{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: VirtualList
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        fns:
          '''
// Get props from context reactively
const getItems = () => c.props?.items || [];
const getItemHeight = () => c.props?.itemHeight || 90;
const getOverscan = () => c.props?.overscan || 5;
const getOnScrollCallback = () => c.props?.onScroll;

// Virtualization state
const [scrollTop, setScrollTop] = _.createSignal(0);
const [scrollElement, setScrollElement] = _.createSignal(null);

// Calculate visible range
const getVisibleRange = () => {
  const el = scrollElement();
  const scroll = scrollTop();
  const items = getItems();
  const itemHeight = getItemHeight();
  const overscan = getOverscan();
  const height = typeof itemHeight === 'function' ? itemHeight() : itemHeight;

  // Use default container height if element not yet available
  const containerHeight = el?.clientHeight || 600;

  const startIndex = Math.max(0, Math.floor(scroll / height) - overscan);
  const endIndex = Math.min(
    items.length - 1,
    Math.ceil((scroll + containerHeight) / height) + overscan
  );

  return { start: startIndex, end: endIndex };
};

// Get virtual items to render
const getVirtualItems = () => {
  const { start, end } = getVisibleRange();
  const virtualItems = [];
  const itemHeight = getItemHeight();
  const height = typeof itemHeight === 'function' ? itemHeight() : itemHeight;

  for (let i = start; i <= end; i++) {
    virtualItems.push({
      index: i,
      start: i * height,
      size: height
    });
  }

  return virtualItems;
};

// Total height of all items
const getTotalSize = () => {
  const items = getItems();
  const itemHeight = getItemHeight();
  const height = typeof itemHeight === 'function' ? itemHeight() : itemHeight;
  return items.length * height;
};

// Handle scroll
const handleScroll = (e) => {
  setScrollTop(e.target.scrollTop);

  // Call custom onScroll callback if provided
  const onScrollCallback = getOnScrollCallback();
  if (onScrollCallback) {
    onScrollCallback(e);
  }
};

return {
  scrollTop,
  setScrollTop,
  scrollElement,
  setScrollElement,
  getVisibleRange,
  getVirtualItems,
  getTotalSize,
  handleScroll,
  getItems
};
'''
        componentName: Html
        props:
          '''
const containerClass = c.props?.class || "";

return {
  as: "div",
  class: containerClass,
  ref: f.setScrollElement,
  onScroll: f.handleScroll
};
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''
return `._id {
  position: relative;
  width: 100%;
  height: ${f.getTotalSize()}px;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div"
};
'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        contextName: virtualItem
        loop: true
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  data: f.getVirtualItems()
};
'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        contextName: item
        css:
          '''
const virtualItem = c.virtualItem;

return `._id {
  position: absolute;
  top: ${virtualItem.start}px;
  left: 0;
  width: 100%;
  height: ${virtualItem.size}px;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const virtualItem = c.virtualItem;
const item = f.getItems()[virtualItem.index];

return {
  as: "div",
  data: {
    item: item,
    virtualItem: virtualItem,
    index: virtualItem.index
  }
};
'''
      }
    }
