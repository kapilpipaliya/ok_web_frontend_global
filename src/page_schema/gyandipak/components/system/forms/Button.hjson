      P: {
        css:
          '''
// Access props reactively
const variant = c.props?.variant || "primary";
const fullWidth = c.props?.fullWidth || false;

// Base styles
let baseStyles = `
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: ${t.var.spacing.sm};
  padding: ${t.var.spacing.md};
  border-radius: ${t.var.borderRadius.md};
  font-weight: 500;
  font-size: 1rem;
  cursor: pointer;
  transition: all 150ms ease;
  border: none;
  ${fullWidth ? 'width: 100%;' : ''}
  min-height: 44px;

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  &:not(:disabled):active {
    transform: scale(0.95);
  }
`;

// Variant-specific styles
let variantStyles = '';

if (variant === 'primary') {
  variantStyles = `
    background: ${t.var.color.primary};
    color: ${t.var.color.primary_text};

    &:not(:disabled):hover {
      background: ${t.var.color.primary_dark_200};
    }
  `;
} else if (variant === 'success') {
  variantStyles = `
    background: ${t.var.color.success};
    color: ${t.var.color.success_text};

    &:not(:disabled):hover {
      background: ${t.var.color.success_dark_200};
      color: ${t.var.color.success_dark_200_text};
    }
  `;
} else if (variant === 'secondary') {
  variantStyles = `
    background: none;
    color: ${t.var.color.text_light_500};
    border: 1px solid ${t.var.color.border};

    &:not(:disabled):hover {
      background: ${t.var.color.background_dark_200};
      color: ${t.var.color.text};
    }
  `;
} else if (variant === 'danger') {
  variantStyles = `
    background: ${t.var.color.background};
    color: ${t.var.color.error};
    border: 1px solid ${t.var.color.error};

    &:not(:disabled):hover {
      background: ${t.var.color.error};
      color: ${t.var.color.error_text};
    }
  `;
}

return `._id {
  ${baseStyles}
  ${variantStyles}
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
// Access props reactively
const text = c.props?.text || "Button";
const type = c.props?.type || "button";
const disabled = c.props?.disabled || c.props?.loading || false;
const onClick = c.props?.onClick || (() => {});
const loading = c.props?.loading || false;
const className = c.props?.class

return {
  as: "button",
  class: className,
  text: text,
  type: type,
  disabled: disabled,
  onClick: onClick,
  "aria-busy": loading ? "true" : "false"
};
'''
      }
