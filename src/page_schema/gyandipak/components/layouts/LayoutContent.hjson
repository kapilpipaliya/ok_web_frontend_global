    {
      id: "17"
      L: Attr
      P: {
        css:
          '''
const item = c.navItem;
const isActive = item.pathCheck ? item.pathCheck(_.location.pathname) : false;
const isButton = item.isButton;
const isDanger = item.isDanger;
const isCollapsed = f.isSidebarCollapsed?.();

return `._id {
  display: flex;
  align-items: center;
  gap: ${t.var.spacing.md};
  padding: ${t.var.spacing.sm} ${isCollapsed ? t.var.spacing.sm : t.var.spacing.md};
  border-radius: ${t.var.borderRadius.md};
  background: ${isActive ? t.var.color.background_light_200 : 'transparent'};
  color: ${isDanger ? t.var.color.error : (isActive ? t.var.color.primary : t.var.color.text)};
  text-decoration: none;
  font-weight: ${isActive ? '600' : '500'};
  transition: all 150ms ease;
  ${isCollapsed ? 'justify-content: center;' : ''}
  ${isButton ? `
    border: none;
    font-size: inherit;
    font-family: inherit;
    cursor: pointer;
    width: 100%;
    text-align: left;
  ` : ''}

  &:hover {
    background: ${isDanger ? t.var.color.error_light_100 : t.var.color.background_light_200};
    color: ${isDanger ? t.var.color.error_light_100_text : t.var.color.primary};
  }

  ${isButton ? `
    &:active {
      transform: scale(0.98);
    }
  ` : ''}
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const item = c.navItem;
const isActive = item.pathCheck ? item.pathCheck(_.location.pathname) : false;
const isButton = item.isButton;
const isDanger = item.isDanger;
const openInNewTab = item.openInNewTab;

return {
  as: isButton ? "button" : "a",
  href: !isButton ? item.href : undefined,
  target: openInNewTab ? "_blank" : undefined,
  rel: openInNewTab ? "noopener noreferrer" : undefined,
  "aria-label": item.label,
  title: item.title,
  onClick: (e) => {
    if (openInNewTab) {
      // Let the browser handle the new tab opening
      return;
    }
    e.preventDefault();
    f.navigateTo?.(item.href);
  }
};
'''
      }
    }
