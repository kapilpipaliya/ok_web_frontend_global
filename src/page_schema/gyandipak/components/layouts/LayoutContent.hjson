{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''
// Define navigation items for both desktop and mobile menus
// Using createSignal for reactive state management
const navigationSectionsData = [
  {
    id: "main",
    title: null, // No title for main section
    items: [
      {
        id: "home",
        href: "/home",
        label: "Home",
        icon: "carbon:home",
        title: "Dashboard and overview",
        pathCheck: (pathname) => pathname === "/" || pathname === ""
      },
      {
        id: "contacts",
        href: "/gyandipak/admin/contacts",
        label: "Contacts",
        icon: "carbon:user-multiple",
        title: "Manage contacts",
        pathCheck: (pathname) => pathname.startsWith("/gyandipak/admin/contacts")
      },
    ]
  },
  {
    id: "other",
    title: null, // No title for other section
    hasBorder: true,
    items: [
      {
        id: "import",
        href: "/import",
        label: "Import",
        icon: "carbon:cloud-upload",
        title: "Import Contacts",
        pathCheck: (pathname) => pathname.startsWith("/import")
      },
      {
        id: "logout",
        href: "/auth/logout",
        label: "Logout",
        icon: "carbon:logout",
        title: "Sign out of your account",
        isButton: true,
        isDanger: true
      }
    ]
  }
];

// Filter navigation sections based on showIf condition
const filteredNavigationSections = navigationSectionsData.filter(section => {
  if (section.showIf && typeof section.showIf === 'function') {
    return section.showIf();
  }
  return true; // Show by default if no showIf condition
});

// Create signal for navigation sections
const [navigationSections, setNavigationSections] = _.createSignal(filteredNavigationSections);

// Define mobile navigation items (subset of desktop items)
const mobileNavigationItemsData = [
  {
    id: "home",
    href: "/home",
    label: "Home",
    icon: "carbon:home",
    title: "Dashboard and overview",
    pathCheck: (pathname) => pathname === "/" || pathname === ""
  },
  {
    id: "contacts",
    href: "/gyandipak/admin/contacts",
    label: "Contacts",
    icon: "carbon:user-multiple",
    title: "Manage contacts",
    pathCheck: (pathname) => pathname.startsWith("/gyandipak/admin/contacts")
  },
  {
    id: "import",
    href: "/import",
    label: "Import",
    icon: "carbon:cloud-upload",
    title: "Import Contacts",
    pathCheck: (pathname) => pathname.startsWith("/import")
  },
];

// Create reactive memo for mobile navigation items
// Automatically updates when isInIframe changes
const mobileNavigationItems = _.createMemo(() => {
  return mobileNavigationItemsData.filter(item => {
    if (item.showIf && typeof item.showIf === 'function') {
      return item.showIf();
    }
    return true; // Show by default if no showIf condition
  });
});
// Sidebar collapse state management
const [isSidebarCollapsed, setIsSidebarCollapsed] = _.createSignal(false);

const toggleSidebar = async () => {
  const newState = !isSidebarCollapsed();
  setIsSidebarCollapsed(newState);

  // Save to database
  try {
    await _.executeServerFunction('saveSidebarPreference', {
      isCollapsed: newState
    });
  } catch (error) {
    console.error('Failed to save sidebar preference:', error);
  }
};

const loadSidebarState = async () => {
  try {
    const result = await _.executeServerFunction('getSidebarPreference', {});

    if (result.success && result.data) {
      setIsSidebarCollapsed(result.data.isCollapsed);
    }
  } catch (error) {
    console.error('Failed to load sidebar preference:', error);
  }
};

return {
  // Navigation
  navigationSections,
  setNavigationSections,
  mobileNavigationItems,
  // Sidebar
  isSidebarCollapsed,
  toggleSidebar,
  loadSidebarState,


};
'''
        key: LayoutContent
        props:
          '''
return {
  onMount: async () => {
    // Load sidebar state from database
    await f.loadSidebarState();
  }
};
'''
      }
    }
