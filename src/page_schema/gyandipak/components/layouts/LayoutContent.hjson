    width: ${sidebarWidth};
    height: 100vh;
    background: ${t.var.color.background};
    border-right: 1px solid ${t.var.color.border};
    flex-direction: column;
    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.1);
    transition: width 300ms ease;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10;
  }
}`;
'''
