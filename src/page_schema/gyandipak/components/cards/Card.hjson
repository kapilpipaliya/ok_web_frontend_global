        displayOrder: 2
        componentName: Html
        props:
          '''
// Get effective setting (prefers live polling data)
const effectiveSetting = args.fns.getEffectiveSetting();

// Get queueStatus and progress from effective setting
const queueStatus = effectiveSetting?.P?.queueStatus || '';
const progress = effectiveSetting?.P?.progress || 0;
const processedCount = effectiveSetting?.P?.processedPlaylists || effectiveSetting?.P?.processedVideos || 0;
const totalCount = effectiveSetting?.P?.totalPlaylists || effectiveSetting?.P?.totalVideos || 0;

// Get queueStatus info from constants
const statusInfo = args.fns.getStatusInfo?.(queueStatus);

let statusText = '';

if (statusInfo) {
  // Use label from queueStatus info
  statusText = statusInfo.label;

  // Add progress percentage for processing queueStatus
  if (queueStatus === 'processing' && progress > 0) {
    statusText += ` ${progress}%`;
  }

  // Add processed/total counts if available
  if (queueStatus === 'processing' && totalCount > 0) {
    statusText += ` (${processedCount}/${totalCount})`;
  }
} else {
  // Fallback to basic queueStatus display
  statusText = queueStatus || 'Unknown';
}

return {
  as: "span",
  text: statusText
};
'''
      }
    }
