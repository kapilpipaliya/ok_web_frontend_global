  text: "Delete",
  type: "danger",
  hide: notSaved || isHidden,
  onClick: (e) => {
    e?.stopPropagation();
    args.fns.deleteItem?.(args.contextData.props?.itemData);
    args.contextData.floatingMenuContext?.closeMenu?.();
  }
};
'''
      }
    }
