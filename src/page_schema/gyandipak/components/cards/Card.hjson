    {
      id: "29"
      L: Attr
      P: {
        css:
          '''
return `._id {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.25rem;
}`;
'''
        displayOrder: 4
        componentName: Html
        props:
          '''
const item = args.contextData.props?.item;
const itemSetting = args.contextData.props?.itemSetting;
const itemType = args.contextData.props?.itemType;

// Get configured fields from layout setting
const cardFieldSetting = args.fns.cardFieldSetting?.() || {
  video: [],
  playlist: [],
  channel: []
};

// Determine which fields to show based on item type
let fieldsToShow = [];
if (itemType === "video") {
  fieldsToShow = cardFieldSetting.video || [];
} else if (itemType === "playlist") {
  fieldsToShow = cardFieldSetting.playlist || [];
} else if (itemType === "channel") {
  fieldsToShow = cardFieldSetting.channel || [];
}

// If no fields configured, hide this section
if (fieldsToShow.length === 0) {
  return { hide: true };
}

// Helper function to format values
const formatValue = (field) => {
  let value;

  // Fields from itemSetting (user-specific or relationship-specific)
  if (field === "note") {
    value = itemSetting?.P?.note;
  } else if (field === "position") {
    value = itemSetting?.P?.position;
  } else if (field === "itemCount") {
    value = itemSetting?.P?.itemCount ?? item?.P?.itemCount ?? 0;
  } else if (field === "videoCount") {
    // For channels: use videoCount from setting
    value = item?.P?.videoCount;
  } else {
    // All other fields come directly from the item (YouTube API fields)
    value = item?.P?.[field];
  }

  // Handle different field types
  if (field === "duration" && value) {
    // Convert Neo4j duration to readable format
    try {
      if (typeof value === 'object' && value.months !== undefined) {
        const hours = Math.floor(value.seconds / 3600);
        const minutes = Math.floor((value.seconds % 3600) / 60);
        const seconds = value.seconds % 60;
        if (hours > 0) {
          return `${hours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        }
        return `${minutes}:${String(seconds).padStart(2, '0')}`;
      }
      return value;
    } catch (e) {
      return value;
    }
  } else if (field.includes("Count") && value !== null && value !== undefined) {
    // Format counts with commas
    return Number(value).toLocaleString();
  } else if (field === "position" && value !== null && value !== undefined) {
    // Format position with # prefix
    return `#${value}`;
  } else if (field.includes("Date") || field === "publishedAt" || field === "updatedAt") {
    // Format dates
    if (value) {
      try {
        return new Date(value).toLocaleDateString();
      } catch (e) {
        return value;
      }
    }
    return "";
  }

  return value || "";
};

// Helper function to get field label
const getFieldLabel = (field) => {
  const labels = {
    description: "Description",
    channelTitle: "Channel",
    publishedAt: "Published",
    duration: "Duration",
    viewCount: "Views",
    likeCount: "Likes",
    commentCount: "Comments",
    position: "Position",
    note: "Notes",
    videoCount: "Videos",
    itemCount: "Videos",
    updatedAt: "Updated",
    subscriberCount: "Subscribers"
  };
  return labels[field] || field;
};

// Build field data array
const fieldData = fieldsToShow
  .map(field => {
    const value = formatValue(field);
    return {
      label: getFieldLabel(field),
      value: value,
      field: field
    };
  })
  .filter(f => f.value); // Only show fields with values

// If no fields with values, hide this section
if (fieldData.length === 0) {
  return { hide: true };
}

return {
  as: "div",
  loop: true,
  contextName: "fieldData",
  data: fieldData
};
'''
      }
    }
    {
