// Common function to get effective setting (prefers live polling data over stale itemSetting)
const getEffectiveSetting = () => {
  const item = args.contextData.props?.item;
  const itemType = args.contextData.props?.itemType;
  const processingStatus = args.contextData.props?.processingStatus;

  // Prefer processing queueStatus (live updates from polling) over item (stale data)
  return (itemType === "playlist" && processingStatus?.playlist) ||
         (itemType === "channel" && processingStatus?.channel) ||
         item;
};

return {
  getEffectiveSetting
};
'''
        componentName: Html
        props:
          '''
const containerClass = args.contextData.props?.class || "";
return {
  as: "div",
  class: containerClass,
};
'''
      }
    }
