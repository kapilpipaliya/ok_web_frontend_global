const item = args.contextData.props?.item;
const itemType = args.contextData.props?.itemType;

// Check if this is an unsaved extension item
const isExtensionItem = item?.P?.extensionExists !== undefined;
const notSaved = isExtensionItem && !item?.P?.extensionExists;

return {
  as: "button",
  hide: itemType === "channel" || notSaved,
  onClick: async (e) => {
    e.stopPropagation();
    if (item) {
      if (itemType === "video") {
        args.fns.addToQueue?.(item);
      } else if (itemType === "playlist") {
        args.fns.addPlaylistToQueue?.(item);
      }
    }
  },
