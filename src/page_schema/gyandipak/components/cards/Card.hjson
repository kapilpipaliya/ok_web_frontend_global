    {
      id: "40"
      L: Attr
      P: {
        slotName: menu-items
        displayOrder: 7
        componentName: MenuItem
        props:
          '''
const item = args.contextData.props?.item;
const itemType = args.contextData.props?.itemType;
const hideMenuItems = args.contextData.props?.hideMenuItems || [];

// Check if this is an unsaved extension item
const isExtensionItem = item?.P?.extensionExists !== undefined;
const notSaved = isExtensionItem && !item?.P?.extensionExists;

// Get effective setting (prefers live polling data)
const effectiveSetting = args.fns.getEffectiveSetting();

const queueStatus = effectiveSetting?.P?.queueStatus;
const youtubeId = item?.P?.youtubeId;
const ownershipId = args.fns.getSelectedOwnershipId?.();

// Only show for channels and playlists with failed or completed_with_errors queueStatus
const canRetry = (itemType === "channel" || itemType === "playlist") &&
                 (queueStatus === "failed" || queueStatus === "completed_with_errors");

// Hide if specified in hideMenuItems prop
const isHidden = hideMenuItems.includes("retry");

return {
  icon: "carbon:restart",
  text: "Retry Processing",
  hide: !canRetry || notSaved || isHidden,
  onClick: async (e) => {
    e?.stopPropagation();

    try {
      const functionName = itemType === "channel" ? "retryChannel" : "retryPlaylist";
      const contextData = itemType === "channel"
        ? { channelId: youtubeId, ownershipId }
        : { playlistId: youtubeId, ownershipId };

      const response = await args.fns.executeYTOFunction(functionName, contextData);

      if (response.result?.success) {
        args.showSuccessToast(response.result.message || "Processing retry queued successfully");
      } else {
        args.showErrorToast(response.result?.message || response?.error || "Failed to retry processing");
      }
    } catch (error) {
      args.showErrorToast("Error retrying processing: " + error.message);
    }

    args.contextData.floatingMenuContext?.closeMenu?.();
  }
};
'''
      }
    }
    {
      id: "41"
      L: Attr
      P: {
        slotName: menu-items
        displayOrder: 8
        componentName: MenuItem
        props:
          '''
