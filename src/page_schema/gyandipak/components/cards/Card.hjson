const fieldData = args.contextData.fieldData;

// Safety check
if (!fieldData || !fieldData.field) {
  return `._id { display: none; }`;
}

// Different styling for description vs other fields
if (fieldData.field === "description") {
  return `._id {
    font-size: 0.75rem;
    color: ${args.theme.var.color.text_light_200};
    line-height: 1.4;
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }`;
}

return `._id {
  font-size: 0.75rem;
  color: ${args.theme.var.color.text_light_500};
  padding: 0.125rem 0.375rem;
  background: ${args.theme.var.color.background_light_100};
  border-radius: 0.25rem;
  white-space: nowrap;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const fieldData = args.contextData.fieldData;

// Safety check
if (!fieldData || !fieldData.field) {
  return { hide: true };
}

// For description field, show full text
if (fieldData.field === "description") {
  return {
    as: "div",
    text: fieldData.value,
    title: fieldData.value
  };
}

// For other fields, show label: value format
return {
  as: "span",
  text: `${fieldData.label}: ${fieldData.value}`
};
'''
