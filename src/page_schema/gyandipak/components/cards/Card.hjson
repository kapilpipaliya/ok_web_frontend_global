          '''
const item = args.contextData.props?.item;
const itemType = args.contextData.props?.itemType;

// Check if this is an extension item (has extensionExists property)
const isExtensionItem = item?.P?.extensionExists !== undefined;

// Hide for extension items (we show existence badge instead)
if (isExtensionItem) {
  return { hide: true };
}

// Get effective setting (prefers live polling data)
const effectiveSetting = args.fns.getEffectiveSetting();

// Get queueStatus from effective setting
const queueStatus = effectiveSetting?.P?.queueStatus;

// Hide for videos (they don't have processing queueStatus)
if (itemType === "video") {
  return { hide: true };
}

// Hide if no queueStatus
if (!queueStatus) {
  return { hide: true };
}

// Hide if queueStatus is "completed" (only show non-completed statuses)
if (queueStatus === "completed") {
  return { hide: true };
}

// Get queueStatus info from constants
const statusInfo = args.fns.getStatusInfo?.(queueStatus);

// Only show if we have valid queueStatus info
if (!statusInfo) {
  return { hide: true };
}

// Map color names to theme colors
const colorMap = {
  blue: args.theme.var.color.info,
  yellow: args.theme.var.color.warning,
  orange: args.theme.var.color.warning,
  gray: args.theme.var.color.text_light_500,
  green: args.theme.var.color.success,
  red: args.theme.var.color.error
};

const borderColor = colorMap[statusInfo.color] || args.theme.var.color.info;

return {
  as: "div",
  "data-color": statusInfo.color
};
'''
      }
    }
