          '''
const item = args.contextData.props?.item;

// Check if this is an extension item
const isExtensionItem = item?.P?.extensionExists !== undefined || item?.P?.extensionIsCurrentPage !== undefined;

// Only show for extension items
if (!isExtensionItem) {
  return { hide: true };
}

const exists = item?.P?.extensionExists || false;

// Only show button for items not already added
if (exists) {
  return { hide: true };
}

const youtubeId = item?.P?.youtubeId;
const itemType = args.contextData.props?.itemType;

return {
  as: "button",
  text: "Add",
  onClick: (e) => {
    e.stopPropagation();
    e.preventDefault();

    if (itemType === 'video') {
      // For videos, open add video to playlist modal
      const videoTitle = item?.P?.title || '';

      args.fns?.setAddVideoToPlaylistData?.({
        videoId: youtubeId,
        videoTitle: videoTitle
      });
      args.fns?.isAddVideoToPlaylistModalOpen?.(true);
      return;
    }

    // For channels and playlists, open add modal with prefilled URL
    // Use getYouTubeUrl function to generate proper URL (handles @handle, channel IDs, etc)
    const url = args.fns?.getYouTubeUrl?.(item, itemType);
    const contentType = itemType === 'channel' ? 'channels' : 'playlists';

    // Set modal data with content type and initial URL
    args.fns?.setModalData?.({
      editMode: false,
      itemData: null,
      contentType: contentType,
      initialUrl: url
    });

    // Open the modal
    args.fns?.isModalOpen?.(true);
  }
};
'''
