        displayOrder: 1
        componentName: Html
        props:
          '''
const item = args.contextData.props?.item;
const existingNote = args.contextData.props?.existingNote || "";
const hasNote = existingNote.length > 0;
const action = hasNote ? "Edit" : "Add";

// Infer item type from the item labels
let itemType = "item";
if (item?.L?.includes('Video')) {
  itemType = "video";
} else if (item?.L?.includes('Channel')) {
  itemType = "channel";
} else if (item?.L?.includes('Playlist')) {
  itemType = "playlist";
}

const title = `${action} note for ${itemType}`;

return {
  as: "h2",
  text: title
};
'''
      }
    }
