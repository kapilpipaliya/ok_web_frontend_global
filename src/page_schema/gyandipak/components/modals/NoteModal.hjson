        css:
          '''
return `._id {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}`;
'''
        displayOrder: 1
        fns:
          '''
const [note, setNote] = args.createSignal("");
const [isSubmitting, setIsSubmitting] = args.createSignal(false);

const initializeNote = () => {
  const existingNote = args.contextData.props?.existingNote || "";
  setNote(existingNote);
  setIsSubmitting(false);
};

const handleSave = async () => {
  const noteValue = note().trim();
  const item = args.contextData.props?.item;
  const onSave = args.contextData.props?.onSave;
  const onClose = args.contextData.props?.onClose;

  setIsSubmitting(true);

  try {
    // Call save callback with note data (itemType is inferred server-side)
    if (onSave) {
      await onSave({
        item,
        note: noteValue
      });
    }

    onClose?.();
  } catch (error) {
    console.error("Error saving note:", error);
    // Error toast already shown by the onSave function
  } finally {
    setIsSubmitting(false);
  }
};

return {
  note,
  setNote,
  isSubmitting,
  initializeNote,
  handleSave
};
'''
        componentName: Html
        props:
          '''
const isOpen = args.contextData.props?.isOpen;
const getIsOpen = isOpen?.() || false;
const onClose = args.contextData.props?.onClose;

return {
  as: "div",
  hide: !getIsOpen,
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      onClose?.();
    }
  },
  onMount: () => {
    args.fns.initializeNote();
  }
};
'''
      }
    }
