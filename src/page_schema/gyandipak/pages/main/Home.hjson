{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        signinRequired: true
        fns:
          '''const isLoading = _.atom(false);

const onMount = () => undefined;
return {
  enabled: true,
  isLoading,
  onMount
};
'''
        key: Home
        url: /home
        props:
          '''
return {
  isNoPermissionCheck: true
};
'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''
return `._id {
  padding: 1.5rem;
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

@media (max-width: 768px) {
  ._id {
    padding: 1rem;
  }
}`;
'''
        displayOrder: 1
        fns:
          '''
return {
  enabled: true
}'''
        componentName: Html
        props:
          '''
return {
  as: "div",
  onMount: f.onMount
};
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''
return `._id {
  min-height: 200px;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div"
};
'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''
return `._id {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 3rem 2rem;
  text-align: center;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div",
  hide: () => !f.isLoading?.()
};
'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 1
        componentName: LoadingSpinner
        props:
          '''
return {
  size: "medium",
  color: "primary",
  text: "Loading..."
};
'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 4
        componentName: Html
        props:
          '''
return {
  as: "div",
