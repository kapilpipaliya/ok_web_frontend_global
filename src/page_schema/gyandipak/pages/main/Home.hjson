};
'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''
return `._id {
  text-align: center;
  margin-bottom: 2rem;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div"
};
'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        displayOrder: 1
        componentName: PageTitle
        props:
          '''
const currentTime = new Date();
const hour = currentTime.getHours();
let greeting = "Good Evening";
if (hour < 12) greeting = "Good Morning";
else if (hour < 18) greeting = "Good Afternoon";

return {
  text: `${greeting} ${_.user.P.username}!`
};
'''
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        css:
          '''
return `._id {
  font-size: 1.125rem;
  color: ${t.var.color.text_light_500};
  margin: 0.5rem 0 0 0;
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''
return {
  as: "p",
  text: ""
};
'''
      }
    }
