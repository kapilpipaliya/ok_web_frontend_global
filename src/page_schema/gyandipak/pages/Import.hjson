  background: ${t.var.color.primary_dark_200};
  transform: translateY(-1px);
  box-shadow: 0 4px 12px ${t.var.color.primary_light_600};
}

._id:active:not(:disabled) {
  transform: translateY(0);
}

._id:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}`;
