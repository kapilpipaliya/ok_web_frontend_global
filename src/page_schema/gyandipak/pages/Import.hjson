        signinRequired: true
        fns:
          '''const contacts = _.atom("");
const isSubmitting = _.atom(false);
const importContacts = async () => {
  const response = await s({
    functionName: "importContacts",
    contextData: { contacts: contacts() }
  });
  if (response?.error) {
    _.showErrorToast(response.error);
  } else if (response?.result?.success) {
    location.href = response.result.success;
  } else {
    const msg = response?.result?.message || "Operation failed";
    _.showErrorToast(msg);
  }
}
return {
  enabled: () => true,
  contacts,
  importContacts,
  isSubmitting
}'''
