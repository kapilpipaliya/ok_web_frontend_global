        displayOrder: 4
        fns:
          '''
const [isSubmitting, setIsSubmitting] = _.createSignal(false);
const [isSubmitted, setIsSubmitted] = _.createSignal(false);

async function handleSubmit(e) {
  e.preventDefault();

  if (!f.contacts()) {
    _.showErrorToast('Please fill in all fields');
    return;
  }

  setIsSubmitting(true);

  try {
    const response = await s({
      functionName: 'importContacts',
      contextData: {
        contacts: f.contacts()
      }
    });

    if (response?.error) {
      _.showErrorToast(response.error);
    } else if (response?.result?.success) {
      _.showSuccessToast('Message sent successfully! We will get back to you soon.');
      setIsSubmitted(true);
    } else {
      const msg = response?.result?.message || "Operation failed";
      _.showErrorToast(msg);
    }
  } catch (error) {
    console.error('Import form error:', error);
    _.showErrorToast('An error occurred. Please try again.');
  } finally {
    setIsSubmitting(false);
  }
}

return { handleSubmit, isSubmitting, isSubmitted };
'''
        componentName: Html
        key: unique_5
        props:
