        displayOrder: 1
        fns:
          '''
// State management
const [store, setStore] = args.createStore({
  contacts: [],
  usernames: [],
  countries: [],
  loading: true,
  error: null,
  searchQuery: '',
  selectedContacts: [],
  sortBy: 'createdAt',
  sortOrder: 'desc',
  filterUsername: '',
  filterCountry: '',
  currentPage: 1,
  pageSize: 100,
  totalCount: 0,
  totalPages: 0,
  stats: {
    totalContacts: 0,
    totalCalled: 0,
    totalJoined: 0
  },
  showAssignModal: false,
  assignUsername: '',
  assignLoading: false,
  showContactModal: false,
  isEditMode: false,
  editingContact: null,
  showSelectModal: false,
  selectCount: 10
});

// Execute server function helper
const executeFunction = async (functionName, contextData) => {
  try {
    const result = await args.executeNamedServerFunction({
      functionName,
      contextData
    });

    if (result.error) {
      args.showErrorToast(result.error);
      return null;
    }

    return result.result;
  } catch (error) {
    args.showErrorToast(error.message || "An error occurred");
    return null;
  }
};

// Load contacts
const loadContacts = async (page = store.currentPage) => {
  setStore('loading', true);
  setStore('error', null);

  const offset = (page - 1) * store.pageSize;

  const result = await executeFunction("getContactsWithUsers", {
    searchQuery: store.searchQuery,
    filterUsername: store.filterUsername,
    filterCountry: store.filterCountry,
    sortBy: store.sortBy,
    sortOrder: store.sortOrder,
    limit: store.pageSize,
    offset: offset
  });

  if (result?.success) {
    setStore('contacts', result.data.contacts || []);
    setStore('totalCount', result.data.totalCount || 0);
    setStore('totalPages', Math.ceil((result.data.totalCount || 0) / store.pageSize));
    setStore('currentPage', page);
    setStore('stats', result.data.stats || { totalContacts: 0, totalCalled: 0, totalJoined: 0 });
  } else {
    setStore('error', result?.message || "Failed to load contacts");
  }
  setStore('loading', false);
};

// Load usernames for filter
const loadUsernames = async () => {
  const result = await executeFunction("getAllUsernames", {});
  if (result?.success) {
    setStore('usernames', result.data.usernames || []);
  }
};

// Load countries for filter
const loadCountries = async () => {
  const result = await executeFunction("getAllCountries", {});
  if (result?.success) {
    setStore('countries', result.data.countries || []);
  }
};

// Toggle contact selection
const toggleContactSelection = (contactId) => {
  const selected = store.selectedContacts;
  if (selected.includes(contactId)) {
    setStore('selectedContacts', selected.filter(id => id !== contactId));
  } else {
    setStore('selectedContacts', [...selected, contactId]);
  }
};

// Select all contacts
const selectAllContacts = () => {
  setStore('selectedContacts', store.contacts.map(cd => cd.contact?.id));
};

// Clear selection
const clearSelection = () => {
  setStore('selectedContacts', []);
};

// Select first X contacts
const selectFirstX = (count) => {
  const firstX = store.contacts.slice(0, count).map(cd => cd.contact?.id);
  setStore('selectedContacts', firstX);
};

// Show select X modal
const showSelectXModal = () => {
  setStore('showSelectModal', true);
  setStore('selectCount', 10);
};

// Hide select X modal
const hideSelectXModal = () => {
  setStore('showSelectModal', false);
};

// Search handler - no debounce, triggered by button
const handleSearch = () => {
  setStore('currentPage', 1);
  loadContacts(1);
};

// Sort handler
const handleSort = (column) => {
  if (store.sortBy === column) {
    setStore('sortOrder', store.sortOrder === 'asc' ? 'desc' : 'asc');
  } else {
    setStore('sortBy', column);
    setStore('sortOrder', 'desc');
  }
  loadContacts(1);
};

// Filter handler
const handleFilterChange = (username) => {
  setStore('filterUsername', username);
  setStore('currentPage', 1);
  loadContacts(1);
};

// Country filter handler
const handleCountryFilterChange = (country) => {
  setStore('filterCountry', country);
  setStore('currentPage', 1);
  loadContacts(1);
};

// Page size handler
const handlePageSizeChange = (newPageSize) => {
  setStore('pageSize', newPageSize);
  setStore('currentPage', 1);
  loadContacts(1);
};

// Pagination handlers
const goToPage = (page) => {
  if (page < 1 || page > store.totalPages) return;
  loadContacts(page);
};

const goToNextPage = () => {
  if (store.currentPage < store.totalPages) {
    loadContacts(store.currentPage + 1);
  }
};

const goToPreviousPage = () => {
  if (store.currentPage > 1) {
    loadContacts(store.currentPage - 1);
  }
};

// Get visible page numbers
const getVisiblePages = () => {
  const pages = [];
  const totalPages = store.totalPages;
  const currentPage = store.currentPage;

  if (totalPages <= 7) {
    for (let i = 1; i <= totalPages; i++) {
      pages.push(i);
    }
  } else {
    pages.push(1);

    if (currentPage > 3) {
      pages.push('...');
    }

    const start = Math.max(2, currentPage - 1);
    const end = Math.min(totalPages - 1, currentPage + 1);

    for (let i = start; i <= end; i++) {
      pages.push(i);
    }

    if (currentPage < totalPages - 2) {
      pages.push('...');
    }

    if (totalPages > 1) {
      pages.push(totalPages);
    }
  }

  return pages;
};

// Show assign modal
const showAssignModal = () => {
  if (store.selectedContacts.length === 0) {
    args.showWarningToast("Please select at least one contact");
    return;
  }
  setStore('showAssignModal', true);
  setStore('assignUsername', '');
};

// Hide assign modal
const hideAssignModal = () => {
  setStore('showAssignModal', false);
  setStore('assignUsername', '');
};

// Assign contacts to user
const assignContacts = async () => {
  if (!store.assignUsername.trim()) {
    args.showWarningToast("Please enter a username");
    return;
  }

  setStore('assignLoading', true);

  const result = await executeFunction("assignContactsToUser", {
    username: store.assignUsername,
    contactIds: store.selectedContacts
  });

  setStore('assignLoading', false);

  if (result?.success) {
    args.showSuccessToast(result.message || "Contacts assigned successfully");
    hideAssignModal();
    clearSelection();
    await loadContacts(store.currentPage);
    await loadUsernames();
  }
};

// Toggle contact field (called, isUnavailable, notInterested)
const toggleContactField = async (contactId, field, currentValue) => {
  const result = await executeFunction("updateContactField", {
    contactId,
    field,
    value: !currentValue
  });

  if (result?.success) {
    // Update contact in store
    const updatedContact = result.data.contact;
    setStore('contacts', (contacts) =>
      contacts.map(cd =>
        cd.contact?.id === contactId
          ? { ...cd, contact: updatedContact }
          : cd
      )
    );
  }
};

// Delete contact
const handleDeleteContact = async (contactId, contactName) => {
  const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
  if (!rbConfirm) {
    args.showErrorToast("Confirmation dialog not available");
    return;
  }

  const confirmed = await rbConfirm({
    title: "Delete Contact",
    message: `Are you sure you want to permanently delete contact "${contactName}"?`,
    confirmText: "Delete",
    cancelText: "Cancel",
    variant: "danger"
  });

  if (!confirmed) {
    return;
  }

  const result = await executeFunction("deleteContact", {
    contactId
  });

  if (result?.success) {
    args.showSuccessToast(result.message || "Contact deleted successfully");
    await loadContacts(store.currentPage);
  }
};

// Show add modal
const showAddModal = () => {
  setStore('isEditMode', false);
  setStore('editingContact', {
    id: null,
    name: '',
    phoneNumber: '',
    country: '',
    countryCode: '',
    remark: '',
    called: false,
    isUnavailable: false,
    notInterested: false
  });
  setStore('showContactModal', true);
};

// Show edit modal
const showEditModal = (contactData) => {
  setStore('isEditMode', true);
  setStore('editingContact', {
    id: contactData.contact?.id,
    name: contactData.contact?.P?.name || '',
    phoneNumber: contactData.contact?.P?.phoneNumber || '',
    country: contactData.contact?.P?.country || '',
    countryCode: contactData.contact?.P?.countryCode || '',
    remark: contactData.contact?.P?.remark || '',
    called: contactData.contact?.P?.called || false,
    isUnavailable: contactData.contact?.P?.isUnavailable || false,
    notInterested: contactData.contact?.P?.notInterested || false
  });
  setStore('showContactModal', true);
};

// Hide contact modal
const hideContactModal = () => {
  setStore('showContactModal', false);
  setStore('editingContact', null);
};

// Save contact (create or update)
const saveContact = async () => {
  if (!store.editingContact?.name?.trim()) {
    args.showWarningToast("Name is required");
    return;
  }
  if (!store.editingContact?.phoneNumber?.trim()) {
    args.showWarningToast("Phone number is required");
    return;
  }

  const isEdit = store.isEditMode;
  const functionName = isEdit ? "updateContact" : "createContact";
  const payload = {
    name: store.editingContact.name,
    phoneNumber: store.editingContact.phoneNumber,
    country: store.editingContact.country,
    countryCode: store.editingContact.countryCode,
    remark: store.editingContact.remark,
    called: store.editingContact.called,
    isUnavailable: store.editingContact.isUnavailable,
    notInterested: store.editingContact.notInterested
  };

  if (isEdit) {
    payload.contactId = store.editingContact.id;
  }

  const result = await executeFunction(functionName, payload);

  if (result?.success) {
    args.showSuccessToast(result.message || (isEdit ? "Contact updated successfully" : "Contact created successfully"));

    if (isEdit) {
      // Update contact in store
      const updatedContact = result.data.contact;
      setStore('contacts', (contacts) =>
        contacts.map(cd =>
          cd.contact?.id === store.editingContact.id
            ? { ...cd, contact: updatedContact }
            : cd
        )
      );
    } else {
      // Reload contacts and countries for new contact
      await loadContacts(store.currentPage);
      await loadCountries();
    }

    hideContactModal();
  }
};

// Export PDF
const exportPDF = () => {
  if (store.selectedContacts.length === 0) {
    args.showWarningToast("Please select at least one contact to export");
    return;
  }

  // Get selected contacts data
  const selectedData = store.contacts.filter(cd => 
    store.selectedContacts.includes(cd.contact?.id)
  );

  // Create CSV content
  let csvContent = "Name,Phone Number,Country,Country Code,Called,Unavailable,Not Interested,Assigned Users,Remark\n";

  selectedData.forEach(cd => {
    const contact = cd.contact?.P || {};
    const users = cd.users?.map(u => u?.P?.username).join('; ') || 'None';

    csvContent += `"${contact.name || ''}","${contact.phoneNumber || ''}","${contact.country || ''}","${contact.countryCode || ''}","${contact.called ? 'Yes' : 'No'}","${contact.isUnavailable ? 'Yes' : 'No'}","${contact.notInterested ? 'Yes' : 'No'}","${users}","${contact.remark || ''}"\n`;
  });

  // Create download link
  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  const url = URL.createObjectURL(blob);
  link.setAttribute('href', url);
  link.setAttribute('download', `contacts_export_${new Date().toISOString().split('T')[0]}.csv`);
  link.style.visibility = 'hidden';
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);

  args.showSuccessToast("Contacts exported successfully");
};

// Initialize
const initialize = async () => {
  await Promise.all([loadContacts(1), loadUsernames(), loadCountries()]);
};

return {
  store,
  setStore,
  loadContacts,
  toggleContactSelection,
  selectAllContacts,
  clearSelection,
  selectFirstX,
  showSelectXModal,
  hideSelectXModal,
  handleSearch,
  handleSort,
  handleFilterChange,
  handleCountryFilterChange,
  handlePageSizeChange,
  goToPage,
  goToNextPage,
  goToPreviousPage,
  getVisiblePages,
  showAssignModal,
  hideAssignModal,
  assignContacts,
  toggleContactField,
  handleDeleteContact,
  showEditModal,
  showAddModal,
  hideContactModal,
  saveContact,
  exportPDF,
  initialize
};
'''
        componentName: Html
        props:
          '''
return {
  as: "div",
  onMount: args.fns.initialize
};
'''
      }
