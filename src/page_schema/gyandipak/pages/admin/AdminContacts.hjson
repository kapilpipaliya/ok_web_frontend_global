const isEditMode = args.fns.store.isEditMode;

return `._id {
  padding: ${args.theme.var.spacing.sm} ${args.theme.var.spacing.md};
  background: ${isEditMode ? args.theme.var.color.primary : args.theme.var.color.success};
  border: none;
  border-radius: ${args.theme.var.borderRadius.sm};
  color: ${isEditMode ? args.theme.var.color.primary_text : args.theme.var.color.success_text};
  font-size: ${args.theme.var.fontSize.sm};
  cursor: pointer;
  transition: all 0.2s ease;

  &:hover {
    background: ${isEditMode ? args.theme.var.color.primary_dark_200 : args.theme.var.color.success_dark_200};
  }
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''
const isEditMode = args.fns.store.isEditMode;

return {
  as: "button",
  text: isEditMode ? "Save Changes" : "Create Contact",
  onClick: args.fns.saveContact
};
'''
