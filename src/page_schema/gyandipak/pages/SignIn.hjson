      L: Page
      P: {
        fns:
          '''const isLoading = _.atom(false);
const username = _.atom("");
const password = _.atom("");
const login = async () => {
  const response = await s({
    functionName: "signin",
    contextData: { username: username(), password: password() }
  });
  if (response?.error) {
    _.showErrorToast(response.error);
  } else if (response?.result?.url) {
    location.href = response.result.url;
  } else {
    const msg = response?.result?.message || "Operation failed";
    _.showErrorToast(msg);
  }
}
return {
  enabled: () => true,
  isLoading,
  username,
  password,
  login
}'''
        key: SignIn
        url: /signin
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
