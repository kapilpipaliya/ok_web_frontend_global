{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Update all details of a contact
        body:
          '''const { contactId, name, phoneNumber, country, countryCode, remark, called, isUnavailable, notInterested } = args.contextData;

if (!contactId) {
  throw new Error("Contact ID is required");
}

if (!name || !name.trim()) {
  throw new Error("Name is required");
}

if (!phoneNumber || !phoneNumber.trim()) {
  throw new Error("Phone number is required");
}

const result = await args.session.executeWrite(async (tx) => {
  // Check if phone number is being changed and if it already exists
  if (phoneNumber) {
    const existingResult = await tx.run(
      `MATCH (c:Contact {phoneNumber: $phoneNumber})
       WHERE elementId(c) <> $contactId
       RETURN c`,
      {
        phoneNumber: phoneNumber.trim(),
        contactId: contactId
      }
    );

    if (existingResult.records.length > 0) {
      throw new Error("A contact with this phone number already exists");
    }
  }

  // Update the contact
  const query = `
    MATCH (c:Contact)
    WHERE elementId(c) = $contactId
    SET c.name = $name,
        c.phoneNumber = $phoneNumber,
        c.country = $country,
        c.countryCode = $countryCode,
        c.remark = $remark,
        c.called = $called,
        c.isUnavailable = $isUnavailable,
        c.notInterested = $notInterested,
        c.updatedAt = datetime()
    RETURN c
  `;

  const updateResult = await tx.run(query, {
    contactId: contactId,
    name: name.trim(),
    phoneNumber: phoneNumber.trim(),
    country: country?.trim() || '',
    countryCode: countryCode?.trim() || '',
    remark: remark?.trim() || '',
    called: Boolean(called),
    isUnavailable: Boolean(isUnavailable),
    notInterested: Boolean(notInterested)
  });

  if (updateResult.records.length === 0) {
    throw new Error("Contact not found");
  }

  const node = updateResult.records[0].get('c');
  const contact = args.convertNodeToJson(node);

  return contact;
});

return {
  success: true,
  data: { contact: result },
  message: "Contact updated successfully"
};
'''
        key: updateContact
      }
    }
  ]
  edges: []
}