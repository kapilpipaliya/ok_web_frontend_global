    },
    {
      id: "fcg_field_down",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Button",
        props: '''
const index = f.selectedFieldIndex?.();
const count = f.getFieldIndices?.().length || 0;
return {
  variant: "secondary",
  size: "sm",
  text: "Move down",
  type: "button",
  disabled: index == null || index >= count - 1,
  onClick: () => f.moveField?.(index, 1)
};
'''
      }
    },
    {
      id: "fcg_field_delete",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Button",
        props: '''
const index = f.selectedFieldIndex?.();
return {
  variant: "danger",
  size: "sm",
  text: "Delete field",
