  onClick: () => f.selectGroup?.(index),
  text: group.title || group.key || `Group ${index + 1}`
};
''',
        css: '''
return `._id.fcg-group-card {
  display: block;
  width: 100%;
  padding: 0.5rem 0.625rem;
  text-align: left;
  border: 1px solid ${t.var.color.border};
  border-radius: 0.375rem;
  background: ${t.var.color.background};
  color: ${t.var.color.text};
  font-size: 0.8125rem;
