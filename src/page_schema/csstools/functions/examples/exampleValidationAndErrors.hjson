{
  vertexes: [
    {
      id: "function_validation_errors"
      L: "Function"
      P: {
        key: "exampleValidationAndErrors"
        description: "Example: Schema validation and structured error handling"
        body: '''
// Example 1: Schema Validation with Zod
// =====================================

// Define schema using built-in patterns
const createUserSchema = _.schema.object({
  email: _.schema.email(),
  name: _.schema.string().min(2).max(100),
  age: _.schema.number().int().positive().optional()
});

// Get data from request
const userData = c;

// Validate data
const validation = _.validate(userData, createUserSchema);

if (!validation.success) {
  // Return validation error with details
  return _.responses.badRequest(
    validation.error,
    { errors: validation.errors }
  );
}

// Or use validateOrThrow (automatically throws ValidationError)
try {
  const validData = _.validateOrThrow(userData, createUserSchema);
  // validData is now type-safe and validated
} catch (error) {
  if (_.isAppError(error)) {
    return error.toJSON();
  }
}

// Example 2: Using Schema Builders
// =================================

// Common patterns built-in
const paginationSchema = _.commonSchemas.pagination;
const idParamSchema = _.commonSchemas.idParam;

// Custom schema patterns
const customSchema = _.createSchema({
  userId: _.schema.uuid(),
  status: _.schema.enum(["active", "inactive", "pending"]),
  tags: _.schema.array(_.schema.string()),
  metadata: _.schema.record(_.schema.string(), _.schema.any())
});

// Example 3: Structured Error Classes
// ====================================

// Throw specific errors
if (!userData.email) {
  throw _.errors.Validation("Email is required");
}

// Authentication error
const user = await _.getUserFromSession();
if (!user) {
  throw _.errors.Authentication("Please log in");
}

// Authorization error
if (!_.hasRole(user, "admin")) {
  throw _.errors.Forbidden("Admin access required");
}

// Not found error
const resource = await _.session.run(
  "MATCH (n:User {id: $id}) RETURN n",
  { id: userData.userId }
);

if (resource.records.length === 0) {
  throw _.errors.NotFound("User", userData.userId);
}

// Business logic error
if (user.P.balance < 100) {
  throw _.errors.BusinessLogic(
    "Insufficient balance",
    { required: 100, current: user.P.balance }
  );
}

// Example 4: Response Formatters
// ===============================

// Success response
return _.responses.ok({
  user: validation.data,
  message: "User validated successfully"
});

// Created response (201)
return _.responses.created({
  id: "new-user-123",
  email: validation.data.email
});

// Paginated response
return _.responses.paginated(
  [{ id: 1 }, { id: 2 }],  // data
  1,                        // page
  10,                       // limit
  25                        // total
);

// Example 5: Error Response Conversion
// ====================================

try {
  // Some operation that might fail
  throw new Error("Something went wrong");
} catch (error) {
  // Convert any error to standardized response
  return _.errorToResponse(error);
}
'''
      }
    }
  ]
  edges: []
}
