      P: {
        fns: "return { enabled: () => true }"
        title: NetSuite eXtendFiles — Organize files in categories
        key: EXtendFilesHome
        url: /
        props:
          "return {\n  isNoPermissionCheck: true\n}"
      }
    }
    {
      id: "17"
      L: Attr
      P: {
        displayOrder: 0
        componentName: Html
        props: "return { as: \"title\", text: \"NetSuite eXtendFiles — Organize files in categories\" }"
      }
    }
    {
      id: "18"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props: "return { as: \"meta\", name: \"title\", content: \"NetSuite eXtendFiles — Organize files in categories\" }"
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          "return {\n  as: \"meta\",\n  name: \"description\",\n  content: \"NetSuite eXtendFiles is a standalone app to browse NetSuite eXtendFiles in nested categories, with search, filters, and table options you can tune from Settings.\"\n}"
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          "return `._id {\n  max-width: 800px;\n  margin: 0 auto;\n  padding: ${args.theme.var.spacing?.lg || \"2rem\"};\n  color: ${args.theme.var.color.text};\n}\n\n@media (max-width: 768px) {\n  ._id {\n    padding: ${args.theme.var.spacing?.md || \"1rem\"};\n  }\n}`;"
        displayOrder: 3
        componentName: Html
        props: "return { as: \"main\" }"
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          "return `._id {\n  font-size: 2rem;\n  font-weight: 700;\n  color: ${args.theme.var.color.text};\n  margin: 0 0 0.5rem 0;\n}\n\n@media (max-width: 768px) {\n  ._id { font-size: 1.75rem; }\n}`;"
        displayOrder: 1
        componentName: Html
        props: "return { as: \"h1\", text: \"NetSuite eXtendFiles\" }"
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          "return `._id {\n  font-size: 1.125rem;\n  line-height: 1.6;\n  color: ${args.theme.var.color.text_light_500};\n  margin: 0 0 1rem 0;\n}`;"
        displayOrder: 2
        componentName: Html
        props:
          "return { as: \"p\", text: \"Manage NetSuite eXtendFiles in one place: category trees, search, and a simple table workspace.\" }"
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          "return `._id { font-size: 1rem; line-height: 1.6; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; }`;"
        displayOrder: 3
        textType: markdown
        componentName: Html
        text: "**NetSuite eXtendFiles** helps you manage **NetSuite eXtendFiles** with nested **categories**. Connect with **NetSuite OAuth**, then open **NetSuite eXtendFiles** from the navigation to work inside categories."
        props: "return { as: \"div\" }"
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css: "return `._id { margin-top: 2rem; }`;"
        displayOrder: 4
        componentName: Html
        props: "return { as: \"section\" }"
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        css:
          "return `._id { font-size: 1.25rem; font-weight: 600; color: ${args.theme.var.color.text}; margin: 0 0 0.75rem 0; }`;"
        displayOrder: 1
        componentName: Html
        props: "return { as: \"h2\", text: \"Key features\" }"
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        css:
          "return `._id { font-size: 1rem; line-height: 1.6; color: ${args.theme.var.color.text}; margin: 0; }`;"
        displayOrder: 2
        textType: markdown
        componentName: Html
        text: "- **NetSuite eXtendFiles** — Table of eXtendFiles linked to categories, with filters and sort.\n- **NetSuite OAuth** — Secure connection to your NetSuite account from **Settings** or the OAuth screen.\n- **Settings** — Column visibility and layout preferences for your workspace."
        props: "return { as: \"div\" }"
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        css: "return `._id { margin-top: 2rem; }`;"
        displayOrder: 5
        componentName: Html
        props: "return { as: \"section\" }"
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        css:
          "return `._id { font-size: 1.25rem; font-weight: 600; color: ${args.theme.var.color.text}; margin: 0 0 0.75rem 0; }`;"
        displayOrder: 1
        componentName: Html
        props: "return { as: \"h2\", text: \"How it works\" }"
      }
    }
    {
      id: "12"
      L: Attr
      P: {
        css:
          "return `._id { font-size: 1rem; line-height: 1.6; color: ${args.theme.var.color.text}; margin: 0; }`;"
        displayOrder: 2
        textType: markdown
        componentName: Html
        text: "1. Sign in and complete **NetSuite OAuth** when prompted.\n2. Open **NetSuite eXtendFiles** from the navigation to load your eXtendFiles table.\n3. Use the **category** sidebar to organize and find eXtendFiles.\n4. Adjust **Settings** as needed."
        props: "return { as: \"div\" }"
      }
    }
    {
      id: "13"
