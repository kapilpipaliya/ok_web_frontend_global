        displayOrder: 1
        componentName: Html
        props:
          '''const connecting = args.fns.isConnecting?.();
const loading = args.fns.isLoading?.();
return {
  as: "s-button",
  "attr:variant": "primary",
  "attr:disabled": connecting || loading ? true : undefined,
  text: connecting ? "Connecting..." : "Connect NetSuite",
  onClick: async () => {
    await args.fns.startConnect?.();
  }
};'''
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''const disconnecting = args.fns.isDisconnecting?.();
const loading = args.fns.isLoading?.();
const connected = !!args.fns.status?.()?.connected;
return {
  as: "s-button",
  "attr:variant": "secondary",
  "attr:disabled": disconnecting || loading || !connected ? true : undefined,
  text: disconnecting ? "Disconnecting..." : "Disconnect",
  onClick: async () => {
    await args.fns.disconnect?.();
  }
};'''
      }
    }
    {
      id: "12"
      L: PageLayout
      P: {
        componentName: ShopifyLayout
      }
    }
  ]
