{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns: "return { enabled: () => true }"
        title: NetSuite OAuth
        key: DecodeNetSuiteOAuth
        url: /netsuite-oauth
        props: "return { isNoPermissionCheck: true };"
      }
    }
    {
      id: "13"
      L: Attr
      P: {
        displayOrder: 0
        componentName: Html
        key: netsuite_oauth_doc_title
        props: '''return { as: "title", text: "NetSuite OAuth" };'''
      }
    }
    {
      id: "14"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: netsuite_oauth_meta_title
        props: '''return { as: "meta", name: "title", content: "NetSuite OAuth" };'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        key: netsuite_oauth_root
        css:
          '''return `._id {
  max-width: 900px;
  margin: 0 auto;
  padding: 2rem 1rem;
  color: ${args.theme.var.color.text};
}`;'''
        fns:
          '''
const [isLoading, setIsLoading] = args.createSignal(false);
const [isConnecting, setIsConnecting] = args.createSignal(false);
const [isDisconnecting, setIsDisconnecting] = args.createSignal(false);
const [status, setStatus] = args.createSignal(null);
const [errorMessage, setErrorMessage] = args.createSignal("");

const getOAuthQuery = () => {
  const search = args.searchParams || {};
  return {
    code: (search.code || "").toString(),
    state: (search.state || "").toString(),
    error: (search.error || "").toString(),
    error_description: (search.error_description || "").toString()
  };
};

const loadStatus = async () => {
  setIsLoading(true);
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "netsuiteGetOAuthStatus",
      contextData: {}
    });

    if (result?.error || result?.result?.success === false) {
      const message = result?.error || result?.result?.message || "Failed to load NetSuite connection status.";
      setErrorMessage(message);
      return;
    }

    setStatus(result?.result || null);
  } catch (error) {
    setErrorMessage(error?.message || "Failed to load NetSuite connection status.");
  } finally {
    setIsLoading(false);
  }
};

const startConnect = async () => {
  setIsConnecting(true);
  setErrorMessage("");
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "netsuiteGetOAuthAuthorizationUrl",
      contextData: {}
    });

    if (result?.error || result?.result?.success === false) {
      const message = result?.error || result?.result?.message || "Failed to start NetSuite OAuth flow.";
      setErrorMessage(message);
      args.showErrorToast?.(message);
      return;
    }

    const authorizationUrl = result?.result?.data?.authorizationUrl;
    if (!authorizationUrl) {
      const message = "Authorization URL not returned.";
      setErrorMessage(message);
      args.showErrorToast?.(message);
      return;
    }

    window.location.href = authorizationUrl;
  } catch (error) {
    const message = error?.message || "Failed to start NetSuite OAuth flow.";
    setErrorMessage(message);
    args.showErrorToast?.(message);
  } finally {
    setIsConnecting(false);
  }
};

const disconnect = async () => {
  setIsDisconnecting(true);
  setErrorMessage("");
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "netsuiteDisconnectOAuth",
      contextData: {}
    });

    if (result?.error || result?.result?.success === false) {
      const message = result?.error || result?.result?.message || "Failed to disconnect NetSuite OAuth.";
      setErrorMessage(message);
      args.showErrorToast?.(message);
      return;
    }

    args.showSuccessToast?.("NetSuite OAuth disconnected.");
    await loadStatus();
  } catch (error) {
    const message = error?.message || "Failed to disconnect NetSuite OAuth.";
    setErrorMessage(message);
    args.showErrorToast?.(message);
  } finally {
    setIsDisconnecting(false);
  }
};

const handleCallbackIfPresent = async () => {
  const q = getOAuthQuery();
  if (!q.code && !q.error) {
    return false;
  }

  setIsLoading(true);
  setErrorMessage("");

  try {
    const result = await args.executeNamedServerFunction({
      functionName: "netsuiteHandleOAuthCallback",
      contextData: q
    });

    if (result?.error || result?.result?.success === false) {
      const message = result?.error || result?.result?.message || "NetSuite OAuth callback failed.";
      setErrorMessage(message);
      args.showErrorToast?.(message);
    } else {
      args.showSuccessToast?.("NetSuite OAuth connected successfully.");
    }

    if (args.setSearchParams) {
      const current = { ...(args.searchParams || {}) };
      delete current.code;
      delete current.state;
      delete current.error;
      delete current.error_description;
      args.setSearchParams(current, { replace: true });
    }
  } catch (error) {
    const message = error?.message || "NetSuite OAuth callback failed.";
    setErrorMessage(message);
    args.showErrorToast?.(message);
  } finally {
    setIsLoading(false);
  }

  return true;
};

const initialize = async () => {
  const handled = await handleCallbackIfPresent();
  if (handled) {
    await loadStatus();
    return;
  }
  await loadStatus();
};

return {
  isLoading,
  isConnecting,
  isDisconnecting,
  status,
  errorMessage,
  startConnect,
  disconnect,
  initialize
};
'''
        props:
          '''return {
  as: "div",
  onMount: async () => {
    await args.fns.initialize?.();
  },
  hide: false
}'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props: '''return { as: "h1", text: "NetSuite OAuth Integration" };'''
        css: '''return `._id { font-size: 1.8rem; margin: 0 0 0.5rem 0; }`;'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props: '''return { as: "p", text: "Connect your NetSuite account to enable server-side NetSuite API integration for this app." };'''
        css: '''return `._id { margin: 0 0 1.5rem 0; color: ${args.theme.var.color.text_light_500}; }`;'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        props:
          '''const _s = args.fns.status?.();
const connected = !!_s?.connected;
const data = _s?.data || {};

const formatTimeLeft = (ms) => {
  if (ms <= 0) return "0 minutes";
  const secTotal = Math.floor(ms / 1000);
  if (secTotal < 60) {
    return secTotal <= 1 ? "less than a minute" : `${secTotal} seconds`;
  }
  const minutesTotal = Math.floor(secTotal / 60);
  const days = Math.floor(minutesTotal / (60 * 24));
  const hours = Math.floor((minutesTotal % (60 * 24)) / 60);
  const minutes = minutesTotal % 60;
  const parts = [];
  if (days > 0) parts.push(`${days} day${days === 1 ? "" : "s"}`);
  if (hours > 0) parts.push(`${hours} hour${hours === 1 ? "" : "s"}`);
  if (minutes > 0 || parts.length === 0) parts.push(`${minutes} minute${minutes === 1 ? "" : "s"}`);
  return parts.join(", ");
};

let tokenLine = "";
if (connected) {
  const raw = data.expiresAt;
  const expMs = raw != null && raw !== "" ? new Date(raw).getTime() : NaN;
  if (raw == null || raw === "" || Number.isNaN(expMs)) {
    tokenLine = " Token expiry time is not available.";
  } else if (expMs <= Date.now()) {
    tokenLine = " Token expired.";
  } else {
    tokenLine = ` Time left until token expires: ${formatTimeLeft(expMs - Date.now())} (expires ${new Date(expMs).toLocaleString()}).`;
  }
}

const statusText = connected
  ? `Connected to account ${data.accountId || "N/A"} (${data.environment || "N/A"}).${tokenLine}`
  : "Not connected.";
return {
  as: "p",
  text: statusText
};'''
        css: '''return `._id { margin: 0 0 1rem 0; font-weight: 500; }`;'''
      }
