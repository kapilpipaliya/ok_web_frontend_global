{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns: "return { enabled: () => true }"
        title: NetSuite integration settings
        key: ExtendfilesNetSuiteIntegrationSettings
        url: /settings
        props: "return { isNoPermissionCheck: true };"
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: netsuite_settings_root
        css:
          '''return `._id {
  max-width: 640px;
  margin: 0 auto;
  padding: 2rem 1rem;
  color: ${args.theme.var.color.text};
}`;'''
        fns:
          '''
const [accountId, setAccountId] = args.createSignal("");
const [clientId, setClientId] = args.createSignal("");
const [clientSecret, setClientSecret] = args.createSignal("");
const [redirectUri, setRedirectUri] = args.createSignal("");
const [scope, setScope] = args.createSignal("rest_webservices");
const [environment, setEnvironment] = args.createSignal("production");
const [hasClientSecret, setHasClientSecret] = args.createSignal(false);
const [loading, setLoading] = args.createSignal(true);
const [saving, setSaving] = args.createSignal(false);
const [formError, setFormError] = args.createSignal("");

const loadSettings = async () => {
  setLoading(true);
  setFormError("");
  try {
    const res = await args.executeNamedServerFunction({
      functionName: "getNetSuiteIntegrationSettings",
      contextData: {}
    });
    if (res?.error || res?.result?.success === false) {
      setFormError(res?.error || res?.result?.message || "Failed to load settings.");
      return;
    }
    const d = res?.result?.data || {};
    setAccountId(d.accountId || "");
    setClientId(d.clientId || "");
    setRedirectUri(d.redirectUri || "");
    setScope(d.scope || "rest_webservices");
    setEnvironment(d.environment || "production");
    setHasClientSecret(!!d.hasClientSecret);
    setClientSecret("");
  } catch (e) {
    setFormError(e?.message || "Failed to load settings.");
  } finally {
    setLoading(false);
  }
};

const saveSettings = async () => {
  setSaving(true);
  setFormError("");
  try {
    const payload = {
      accountId: accountId(),
      clientId: clientId(),
      redirectUri: redirectUri(),
      scope: scope(),
      environment: environment()
    };
    const secretTrim = (clientSecret() || "").trim();
    if (secretTrim) {
      payload.clientSecret = secretTrim;
    }
    const res = await args.executeNamedServerFunction({
      functionName: "saveNetSuiteIntegrationSettings",
      contextData: payload
    });
    if (res?.error || res?.result?.success === false) {
      const msg = res?.error || res?.result?.message || "Save failed.";
      setFormError(msg);
      args.showErrorToast?.(msg);
      return;
    }
    args.showSuccessToast?.(res?.result?.message || "Saved.");
    setClientSecret("");
    await loadSettings();
  } catch (e) {
    const msg = e?.message || "Save failed.";
    setFormError(msg);
    args.showErrorToast?.(msg);
  } finally {
    setSaving(false);
  }
};

return {
  accountId,
  setAccountId,
  clientId,
  setClientId,
  clientSecret,
  setClientSecret,
  redirectUri,
  setRedirectUri,
  scope,
  setScope,
  environment,
  setEnvironment,
  hasClientSecret,
  loading,
  saving,
  formError,
  loadSettings,
  saveSettings
};
'''
        props:
          '''return {
  as: "div",
  onMount: async () => {
    await args.fns.loadSettings?.();
  }
};'''
      }
    }
