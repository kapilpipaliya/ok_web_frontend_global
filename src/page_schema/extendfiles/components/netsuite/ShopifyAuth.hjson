          '''
const label =
  _.user?.P?.username ||
  _.user?.P?.email ||
  "";

const welcomeText = label ? `Welcome, ${label}` : "";

const out = {
  as: "span",
  text: welcomeText,
  title: welcomeText,
  hide: !label
};
if (label) {
  out["attr:aria-label"] = `Signed in as ${label}`;
}
return out;
'''
