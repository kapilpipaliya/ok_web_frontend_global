{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: SettingsSidebar
        fns:
          '''
const getSidebarConfig = () => c.props?.sidebarConfig || f.getSettingsSidebarConfig?.() || null;

const checkPermissions = (permissionConfig) => {
  if (!permissionConfig) return true;
  if (_.isNoPermissionCheck === true) return true;
  if (_.hasFullPermission || _.hasEditPermission || _.hasViewPermission) return true;
  return false;
};

const getVisibleGroups = () => {
  const sidebarConfig = getSidebarConfig();
  if (!sidebarConfig || !Array.isArray(sidebarConfig.groups)) return [];
  return sidebarConfig.groups.filter((group) => {
    if (!checkPermissions(group.permissions)) return false;
    return true;
  }).map((group) => ({
    ...group,
    items: (group.items || []).filter((item) => checkPermissions(item.permissions))
  })).filter((group) => (group.items || []).length > 0);
};

const parseNavPath = (itemPath) => {
  if (!itemPath) return { pathname: "", pageId: null };
  const qIndex = itemPath.indexOf("?");
  if (qIndex === -1) return { pathname: itemPath, pageId: null };
  const pathname = itemPath.slice(0, qIndex);
  const params = new URLSearchParams(itemPath.slice(qIndex + 1));
  return { pathname, pageId: params.get("page") };
};

const isActivePath = (itemPath) => {
  const currentPath = _.location?.pathname || "";
  if (!itemPath) return false;

  const parsed = parseNavPath(itemPath);
  if (parsed.pageId) {
    const onPath = currentPath === parsed.pathname;
    if (!onPath) return false;
    const currentPage = _.searchParams?.page || "general";
    return currentPage === parsed.pageId;
  }

  if (itemPath === currentPath) return true;
  return currentPath.startsWith(itemPath + "/");
};

const handleNavigate = (item) => {
  if (!item?.path) return;
  _.navigate(item.path);
};

return {
  getSidebarConfig,
  getVisibleGroups,
  isActivePath,
  handleNavigate,
  sidebarTitle: () => getSidebarConfig()?.title || "Settings"
};
'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        css:
          '''
return `._id {
  width: 240px;
