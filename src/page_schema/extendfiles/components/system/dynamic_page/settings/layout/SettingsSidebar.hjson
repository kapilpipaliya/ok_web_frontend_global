  padding: ${t.var.spacing.md};
  background: ${t.var.color.background_light_100};
  min-height: 100%;
  overflow-y: auto;
}

@media (max-width: 768px) {
  ._id {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid ${t.var.color.border};
    max-height: 240px;
  }
}`;
'''
        componentName: Html
