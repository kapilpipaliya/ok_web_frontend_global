const item = c.navItem;
const active = f.isActivePath(item.path);
return active
  ? `._id {
  display: block;
  padding: ${t.var.spacing.sm} ${t.var.spacing.md};
  border-radius: ${t.var.borderRadius.md};
  color: ${t.var.color.primary_text};
  background: ${t.var.color.primary};
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  transition: background 150ms ease;
}`
  : `._id {
  display: block;
  padding: ${t.var.spacing.sm} ${t.var.spacing.md};
  border-radius: ${t.var.borderRadius.md};
  color: ${t.var.color.text};
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  transition: background 150ms ease;
}
._id:hover {
  background: ${t.var.color.background_light_200};
}`;
'''
        componentName: Html
        props:
