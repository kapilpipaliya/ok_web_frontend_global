  padding-bottom: ${args.theme.var.spacing.sm};
  margin-bottom: ${args.theme.var.spacing.sm};
  border-bottom: 2px solid ${args.theme.var.color.border};
  grid-column: 1 / -1;
}`;
'''
        displayOrder: 1
