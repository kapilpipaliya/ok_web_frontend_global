const field = args.contextData.field;
const group = args.contextData.fieldGroup;
const fieldSpan = field?.colSpan || 1;
const gridColumns = group?.gridColumns || 1;
const startNewLine = field?.startNewLine;

return `._id {
  display: flex;
  flex-direction: column;
  gap: ${args.theme.var.spacing.xs};
  grid-column: ${startNewLine ? "1 / -1" : `span ${Math.min(fieldSpan, gridColumns)}`};
}`;
'''
