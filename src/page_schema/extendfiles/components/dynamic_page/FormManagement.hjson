const onClose = args.contextData.props?.onClose;

const handleCancel = () => {
  const txnId = args.fns.formTxnId();
  if (txnId && txnId > 0) {
    args.revertTransaction(txnId);
    args.fns.setFormTxnId(0);
  }
  if (onClose) onClose();
};

return {
  as: "s-button",
  "attr:variant": "secondary",
  text: "Cancel",
  onClick: handleCancel,
  disabled: args.fns.isSubmitting(),
  hide: args.fns.getUsePolarisUI?.() !== true
};
'''
