    {
      id: "11"
      L: Attr
      P: {
        css:
          '''
return `._id {
  width: 100%;
}`;
'''
        displayOrder: 3
        componentName: Html
        props:
          '''
const field = args.contextData.field;
const value = args.fns.getFieldValue(field.key);
const setFieldValue = args.fns.setFieldValue;
const isViewMode = args.fns.getMode?.() === "view";
const isAddLocked = args.fns.getMode?.() === "add" && field.readOnlyInAddMode === true;
const tm = args.fns.getFieldTooltipMeta(field);
const hintId = `fm-field-hint-${field.key}`;
const a11y = tm.showBelow && tm.body ? { "aria-describedby": hintId } : {};

// Render appropriate input based on field type
if (field.type === "nestedLineItems" && field.nestedLineItemsConfig) {
  return {
    componentName: "FormNestedLineItems",
    field,
    disabled: isViewMode || isAddLocked,
    getRows: () => args.fns.getNestedLineVerticesForField(field),
    getParentVertex: () => args.fns.getFormVertex(),
    ensureTxn: () => args.fns.ensureFormTxn(),
    markDeleted: (lineId) => args.fns.markNestedLineDeleted(field.key, lineId)
  };
}

if (field.type === "textArea" || field.type === "textarea") {
  return {
    componentName: "TextArea",
    value: value,
    onChange: (e) => setFieldValue(field.key, e.target.value),
    placeholder: field.placeholder || "",
    required: field.required || false,
    maxLength: field.maxLength,
    disabled: isViewMode || isAddLocked,
    ...a11y
  };
}

if (field.type === "select" && field.optionsPicklist?.picklistKey) {
  const pk = String(field.optionsPicklist.picklistKey || "").trim();
  return {
    componentName: "TomSelect",
    value: value,
    onChange: (newValue) => {
      setFieldValue(field.key, newValue);
    },
    functionName: "getWorkshopPicklist",
    singularName: field.label || field.key,
    pluralName: field.label || field.key,
    valueKey: "P.value",
    labelKey: "P.label",
    dataKey: "options",
    functionContext: { picklistKey: pk },
    placeholder: field.placeholder || `Select ${field.label || field.key}...`,
    required: field.required || false,
    disabled: isViewMode || isAddLocked,
    ...a11y
  };
}

if (field.type === "select" && field.selectConfig) {
  const lf = field.selectConfig.labelField || "name";
  const labelKey = String(lf).includes(".") ? String(lf) : `P.${lf}`;
  const enableUserScoping =
    field.selectConfig.enableUserScoping !== undefined
      ? field.selectConfig.enableUserScoping
      : false;

  return {
    componentName: "TomSelect",
    value: value,
    onChange: (newValue) => {
      setFieldValue(field.key, newValue);
    },
    functionName: "getUserVertices",
    singularName: field.label || field.key,
    pluralName: field.label || field.key,
    valueKey: "id",
    labelKey,
    functionContext: {
      label: field.selectConfig.label,
      search: field.selectConfig.search || "",
      limit: field.selectConfig.limit,
      relationshipType: field.selectConfig.relationshipType,
      enableUserScoping
    },
    placeholder: field.placeholder || `Select ${field.label || field.key}...`,
    required: field.required || false,
    disabled: isViewMode || isAddLocked,
    ...a11y
  };
}

if (field.type === "select" && Array.isArray(field.options)) {
  return {
    componentName: "TomSelect",
    value: value,
    onChange: (newValue) => {
      setFieldValue(field.key, newValue);
    },
    options: field.options,
    placeholder: field.placeholder || `Select ${field.label || field.key}...`,
    required: field.required || false,
    disabled: isViewMode || isAddLocked,
    ...a11y
  };
}

if (field.type === "checkbox") {
  return {
    as: "input",
    type: "checkbox",
    checked: value === true || value === "true",
    onChange: (e) => {
      setFieldValue(field.key, e.target.checked);
    },
    disabled: isViewMode || isAddLocked,
    ...a11y
  };
}

if (field.type === "date") {
  let dateValue = value;
  if (typeof dateValue === "string") {
    if (dateValue.includes("T")) {
      dateValue = dateValue.split("T")[0];
    } else if (dateValue.length > 10) {
      dateValue = dateValue.slice(0, 10);
    }
  }
  return {
    componentName: "TextInput",
    type: "date",
    value: dateValue || "",
    placeholder: field.placeholder || "",
    required: field.required || false,
    disabled: isViewMode || args.fns.isSubmitting() || isAddLocked,
    onChange: (e) => {
      setFieldValue(field.key, e.target.value);
    },
    ...a11y
  };
}

if (field.type === "number") {
  return {
    componentName: "TextInput",
    type: "number",
    value: value,
    onChange: (e) => {
      setFieldValue(field.key, e.target.value);
    },
    placeholder: field.placeholder || "",
    required: field.required || false,
    min: field.min,
    max: field.max,
    disabled: isViewMode || isAddLocked,
    ...a11y
  };
}

// Default: text input
return {
  componentName: "TextInput",
  type: field.type === "email" ? "email" : "text",
  value: value,
  onChange: (e) => {
    setFieldValue(field.key, e.target.value);
  },
  placeholder: field.placeholder || "",
  required: field.required || false,
  maxLength: field.maxLength,
  minLength: field.minLength,
  disabled: isViewMode || isAddLocked,
  ...a11y
};
'''
      }
    }
    {
      id: "12"
      L: Attr
      P: {
        css:
