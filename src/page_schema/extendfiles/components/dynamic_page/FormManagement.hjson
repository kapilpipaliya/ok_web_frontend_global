        displayOrder: 2
        componentName: Html
        props:
          '''
const field = args.contextData.field;
const tm = args.fns.getFieldTooltipMeta(field);

return {
  componentName: "FloatingHelpTooltip",
  text: tm.showFloatingHelp ? tm.floatingHelpText : "",
  fieldLabel: field.label || field.key,
  placement: tm.placement,
