return `._id {
  width: 100%;
  height: 1px;
  background: ${args.theme.var.color.border};
  margin: ${args.theme.var.spacing.md} 0;
  grid-column: 1 / -1;
}`;
'''
        displayOrder: 0
        componentName: Html
        props:
          '''
const group = args.contextData.fieldGroup;
const fieldIndex = args.contextData.fieldIndex || 0;
const field = args.contextData.field;

// Show horizontal line if field has startNewLine (but not for first field if there's a title)
const showLine = field?.startNewLine && !(fieldIndex === 0 && group?.title);

return {
  as: "hr",
  hide: !showLine
};
'''
      }
