{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: FormManagement
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''
return `._id {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: ${args.theme.var.spacing.md};
  height: 100%;
}`;
'''
        displayOrder: 1
        fns:
          '''
// Form state management using Vertex format
const getFormConfig = () => args.contextData.props?.formConfig;
const getInitialVertex = () => args.contextData.props?.initialVertex;
const getMode = () => args.contextData.props?.mode || "add";
const getVertexLabel = () => {
  return args.contextData.props?.vertexLabel || "FormData";
};

// Form vertex ID - vertex will be read from graph
const [formVertexId, setFormVertexId] = args.createSignal(null);
const [formTxnId, setFormTxnId] = args.createSignal(0);
const [errors, setErrors] = args.createStore({});
const [isSubmitting, setIsSubmitting] = args.createSignal(false);
const [nestedLineMeta, setNestedLineMeta] = args.createSignal({ deletedIdsByField: {} });

const resetNestedLineMeta = () => setNestedLineMeta({ deletedIdsByField: {} });

const markNestedLineDeleted = (fieldKey, lineId) => {
  if (!fieldKey || !lineId) return;
  setNestedLineMeta((m) => {
    const d = { ...(m.deletedIdsByField || {}) };
    const cur = d[fieldKey] || [];
    if (cur.includes(lineId)) return m;
    d[fieldKey] = [...cur, lineId];
    return { deletedIdsByField: d };
  });
};

const getNestedDeletedIdsForField = (fieldKey) =>
  nestedLineMeta().deletedIdsByField[fieldKey] || [];

// Nested line rows live only as child vertices + edges (see nestedLineItemsConfig.parentToChildRelationshipType).
// Listed via args.evalExpression(rowsExpression or `->${relationshipType}`, { graph, vertexes: [parent] }).
const hydrateNestedLineFields = () => {};

// Nested lines are not stored on the parent vertex P[fieldKey]; no placeholder arrays.
const ensureNestedLineEmptyArrays = () => {};

// Helper to get form vertex from graph (or initialVertex for view mode)
const getFormVertex = () => {
  const mode = getMode();
  const initialVertex = getInitialVertex();
  if (mode === "view" && initialVertex) {
    return initialVertex;
  }
  const vertexId = formVertexId();
  if (!vertexId) return null;
  return args.graph.vertexes[vertexId] || null;
};

const ensureFormTxn = () => {
  let txnId = formTxnId();
  if (!txnId || txnId === 0) {
    txnId = args.generateNewTxnId(args.graph, args.setGraph);
    setFormTxnId(txnId);
  }
  return txnId;
};

const getNestedLineVerticesForField = (field) => {
  const cfg = field?.nestedLineItemsConfig;
  const parent = getFormVertex();
  if (!field || field.type !== "nestedLineItems" || !cfg?.parentToChildRelationshipType || !parent) {
    return [];
  }
  const expr = cfg.rowsExpression || `->${cfg.parentToChildRelationshipType}`;
  const raw = args.evalExpression(expr, { graph: args.graph, vertexes: [parent] }) || [];
  const arr = Array.isArray(raw) ? raw : [];
  const verts = arr.filter((v) => v && typeof v.id === "string");
  verts.sort((a, b) => (Number(a.P?.displayOrder) || 0) - (Number(b.P?.displayOrder) || 0));
  return verts;
};

const buildNestedLineRowPayload = (v, cfg) => {
  const fk = cfg.parentElementIdPropOnChild;
  const invRel = cfg.childToInventoryRelationshipType;
  const invLab = cfg.inventoryTargetLabel || "InventoryItem";
  let inventoryItemId = "";
  if (invRel && v.OUT && v.OUT[invRel]) {
    const eids = v.OUT[invRel];
    for (let ei = 0; ei < eids.length; ei++) {
      const edge = args.graph.edges[eids[ei]];
      if (!edge) continue;
      const tgt = args.graph.vertexes[edge.E];
      if (tgt?.L?.includes(invLab)) {
        inventoryItemId = edge.E;
        break;
      }
    }
  }
  const row = { id: v.id, ...args.klona(v.P || {}), inventoryItemId };
  if (fk) delete row[fk];
  return row;
};

// Helper to get all fields in flat format from nested or flat structure
const getAllFields = () => {
  const formConfig = getFormConfig();
  if (!formConfig) return [];

  if (formConfig.groups && Array.isArray(formConfig.groups)) {
    // New nested structure
    const allFields = [];
    for (const group of formConfig.groups) {
      if (group.fields && Array.isArray(group.fields)) {
        allFields.push(...group.fields);
      }
    }
    return allFields;
  } else if (formConfig.fields && Array.isArray(formConfig.fields)) {
    // Legacy flat structure
    return formConfig.fields;
  }

  return [];
};

// Initialize form from vertex
const initializeForm = () => {
  const formConfig = getFormConfig();
  const initialVertex = getInitialVertex();
  const mode = getMode();
  const vertexLabel = getVertexLabel();
  resetNestedLineMeta();

  // Check if formConfig has groups or fields
  const hasFields = formConfig?.groups?.length > 0 || formConfig?.fields?.length > 0;
  if (!hasFields) {
    setFormVertexId(null);
    return;
  }

  // View mode: no graph mutation, just display initialVertex
  if (mode === "view" && initialVertex) {
    setFormVertexId(null);
    setErrors({});
    return;
  }

  if (mode === "edit" && initialVertex) {
    // Check if vertex exists in graph
    const existingVertex = args.graph.vertexes[initialVertex.id];

    if (existingVertex) {
      // Clone vertex before editing so edits don't mutate the original until save
      const txnId = args.generateNewTxnId(args.graph, args.setGraph);
      setFormTxnId(txnId);
      const clonedVertex = args.cloneVertexWithEdges(txnId, existingVertex, {}, args.graph, args.setGraph);
      setFormVertexId(clonedVertex.id);
      hydrateNestedLineFields();
    } else {
      // Vertex doesn't exist in graph, create new vertex with initialVertex properties
      const txnId = args.generateNewTxnId(args.graph, args.setGraph);
      setFormTxnId(txnId);

      const vertexId = args.generateNewVertexId(args.graph, args.setGraph);

      // Use properties from initialVertex, or initialize with default values
      /*const initialProperties = {};

      formConfig.fields.forEach(field => {
        if (initialVertex.P && initialVertex.P[field.key] !== undefined) {
          initialProperties[field.key] = initialVertex.P[field.key];
        } else if (field.defaultValue !== undefined) {
          initialProperties[field.key] = field.defaultValue;
        } else {
          initialProperties[field.key] = "";
        }
      });*/

      const createdVertex = args.newVertex(vertexId, initialVertex.L || [vertexLabel], args.klona(initialVertex.P));

      // Add vertex to graph using addNewVertex
      args.addNewVertex(txnId, createdVertex, args.graph, args.setGraph);

      // Store vertex ID instead of vertex object
      setFormVertexId(vertexId);
      hydrateNestedLineFields();
    }
  } else {
    // Create new vertex using newVertex and generateNewVertexId
    // Generate a new transaction ID (separate from vertex properties)
    const txnId = args.generateNewTxnId(args.graph, args.setGraph);
    setFormTxnId(txnId);

    const vertexId = args.generateNewVertexId(args.graph, args.setGraph);
    const initialProperties = {};

    // Initialize with default values from all fields
    const allFields = getAllFields();

    for (const field of allFields) {
      if (field.defaultValue !== undefined) {
        initialProperties[field.key] = field.defaultValue;
      } else {
        initialProperties[field.key] = "";
      }
    }

    const createdVertex = args.newVertex(vertexId, [vertexLabel], initialProperties);

    // Add vertex to graph using addNewVertex
    args.addNewVertex(txnId, createdVertex, args.graph, args.setGraph);

    // Store vertex ID instead of vertex object
    setFormVertexId(vertexId);
    ensureNestedLineEmptyArrays();
  }

  setErrors({});
};

const applyAutoReferenceSequencesAfterAdd = async () => {
  if (getMode() !== "add") return;
  const vertexId = formVertexId();
  if (!vertexId) return;
  const allFields = getAllFields();
  const bySeqKey = new Map();
  for (let fi = 0; fi < allFields.length; fi++) {
    const field = allFields[fi];
    const sk = field?.autoReferenceSequenceKey;
    if (!sk || typeof sk !== "string" || !field.key) continue;
    const seqKey = String(sk).trim();
    if (!seqKey) continue;
    if (!bySeqKey.has(seqKey)) bySeqKey.set(seqKey, []);
    bySeqKey.get(seqKey).push(field.key);
  }
  if (bySeqKey.size === 0) return;

  for (const [seqKey, fieldKeys] of bySeqKey.entries()) {
    try {
      const res = await args.executeNamedServerFunction({
        functionName: "reserveWorkshopReferenceNumber",
        contextData: { sequenceKey: seqKey }
      });
      if (res?.error) {
        args.showErrorToast?.(String(res.error));
        continue;
      }
      const inner = res?.result;
      if (!inner?.success) {
        args.showErrorToast?.(inner?.message || "Failed to reserve reference number");
        continue;
      }
      const val = inner.data?.value;
      if (val == null) continue;
      const sval = String(val);
      for (let ki = 0; ki < fieldKeys.length; ki++) {
        setFieldValue(fieldKeys[ki], sval);
      }
    } catch (e) {
      args.showErrorToast?.(e?.message || "Failed to reserve reference number");
    }
  }
};

// Get form field value from vertex
const getFieldValue = (fieldKey) => {
  const vertex = getFormVertex();
  return vertex?.P?.[fieldKey] || "";
};

// Set form field value in vertex using mergeVertexProperties
const setFieldValue = (fieldKey, value) => {
  const nestedField = getAllFields().find((f) => f.key === fieldKey);
  if (nestedField?.type === "nestedLineItems") return;
  const vertexId = formVertexId();
  if (!vertexId) return;

  // Get or generate txnId (separate variable, not stored in vertex)
  let txnId = formTxnId();
  if (!txnId || txnId === 0) {
    txnId = args.generateNewTxnId(args.graph, args.setGraph);
    setFormTxnId(txnId);
  }

  // Use mergeVertexProperties to update vertex in graph
  // The vertex will be automatically updated in the graph
  args.mergeVertexProperties(txnId, vertexId, args.graph, args.setGraph, { [fieldKey]: value });
};

// Validate form
const validate = () => {
  const vertex = getFormVertex();
  const allFields = getAllFields();

  if (allFields.length === 0 || !vertex) return true;

  const newErrors = {};
  for (const field of allFields) {
    const value = vertex.P[field.key];

    if (field.type === "nestedLineItems" && field.required) {
      const rows = getNestedLineVerticesForField(field);
      if (rows.length === 0) {
        newErrors[field.key] = `${field.label || field.key}: add at least one line`;
      }
      continue;
    }

    if (field.required && (value === undefined || value === null || value === "")) {
      newErrors[field.key] = `${field.label || field.key} is required`;
    }

    if (field.type === "email" && value && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(value)) {
      newErrors[field.key] = "Invalid email format";
    }

    if (field.minLength && value && String(value).length < field.minLength) {
      newErrors[field.key] = `Must be at least ${field.minLength} characters`;
    }

    if (field.maxLength && value && String(value).length > field.maxLength) {
      newErrors[field.key] = `Must be at most ${field.maxLength} characters`;
    }
  };

  setErrors(newErrors);
  return Object.keys(newErrors).length === 0;
};

// Handle save
const handleSave = async () => {
  if (!validate()) {
    args.showErrorToast?.("Please fix form errors");
    return;
  }

  const onSave = args.contextData.props?.onSave;
  if (!onSave) {
    args.showErrorToast?.("Save function not provided");
    return;
  }

  const vertex = getFormVertex();
  if (!vertex) {
    args.showErrorToast?.("Form data not initialized");
    return;
  }

  setIsSubmitting(true);
  try {
    // Use vertex directly instead of converting
    const relationshipData = {};
    const allFields = getAllFields();

    if (allFields.length > 0) {
      for (const field of allFields) {
        if (field.type === "select" && field.selectConfig) {
          const selectedId = vertex.P[field.key];
          const trimmedId =
            selectedId != null && String(selectedId).trim() !== ""
              ? String(selectedId).trim()
              : null;
          relationshipData[field.key] = {
            relationshipType: field.selectConfig.relationshipType,
            targetLabel: field.selectConfig.label,
            targetId: trimmedId
          };
        }
      }
    }

    const nestedLineSync = {};
    const nMeta = nestedLineMeta();
    for (const field of allFields) {
      if (field.type !== "nestedLineItems" || !field.nestedLineItemsConfig) continue;
      const cfg = field.nestedLineItemsConfig;
      nestedLineSync[field.key] = {
        childLabel: cfg.childLabel,
        parentToChildRelationshipType: cfg.parentToChildRelationshipType,
        childToInventoryRelationshipType: cfg.childToInventoryRelationshipType || null,
        inventoryTargetLabel: cfg.inventoryTargetLabel || "InventoryItem",
        parentElementIdPropOnChild: cfg.parentElementIdPropOnChild,
        nestedLineItemsSyncRules: cfg.nestedLineItemsSyncRules || null,
        rows: getNestedLineVerticesForField(field).map((v) => buildNestedLineRowPayload(v, cfg)),
        deletedLineIds: nMeta.deletedIdsByField[field.key] || []
      };
    }

    const result = await onSave({
      vertex: vertex,
      relationships: relationshipData,
      nestedLineSync
    });

    // Clean up only after successful save (when onSave returns truthy)
    if (result) {
      const txnId = formTxnId();
      if (txnId && txnId > 0) {
        args.revertTransaction(txnId);
        setFormTxnId(0);
      }
      setFormVertexId(null);
    }
  } catch (error) {
    console.error("Error saving:", error);
    args.showErrorToast?.("Failed to save");
  } finally {
    setIsSubmitting(false);
  }
};

// Check if field should be visible (dependent fields)
const isFieldVisible = (field) => {
  if (!field.dependsOn) return true;

  const vertex = getFormVertex();
  if (!vertex) return false;

  const dependsOnValue = vertex.P[field.dependsOn.field];

  if (field.dependsOn.operator === "equals") {
    return dependsOnValue === field.dependsOn.value;
  } else if (field.dependsOn.operator === "notEquals") {
    return dependsOnValue !== field.dependsOn.value;
  } else if (field.dependsOn.operator === "contains") {
    return String(dependsOnValue || "").includes(field.dependsOn.value);
  }

  return true;
};

// Tooltip / help: tooltip | helpText | description (first non-empty string wins)
// Floating panel (ⓘ hover): tooltipDisplay "native" | "both" (default native); tooltipIcon: false disables ⓘ
// tooltipTitle overrides body text in the floating panel; tooltipShortcut appended as (shortcut)
// tooltipDisplay "below" | "both": extra muted line under label; tooltipPlacement passed to Floating UI (e.g. top, bottom-start)
// tooltipDelay reserved; showTooltip: false disables all help UI
const pickHelpString = (...vals) => {
  for (const v of vals) {
    if (typeof v === "string" && v.trim()) return v.trim();
  }
  return "";
};

const getFieldTooltipMeta = (field) => {
  const empty = {
    body: "",
    floatingHelpText: "",
    showFloatingHelp: false,
    ariaDescription: "",
    showBelow: false,
    placement: "top",
    delayMs: null,
    shortcut: ""
  };
  if (!field || field.showTooltip === false) return empty;

  const body = pickHelpString(field.tooltip, field.helpText, field.description);
  if (!body) return empty;

  const titleOverride = pickHelpString(field.tooltipTitle);
  const panelBase = titleOverride || body;
  const ariaDescription = pickHelpString(field.ariaDescription) || body;
  const shortcut = pickHelpString(field.tooltipShortcut);
  const floatingHelpText = shortcut ? `${panelBase} (${shortcut})` : panelBase;
  const placement = typeof field.tooltipPlacement === "string" ? field.tooltipPlacement : "top";
  const delayMs = typeof field.tooltipDelay === "number" ? field.tooltipDelay : null;
  const mode = field.tooltipDisplay || "native";
  const showBelow = mode === "below" || mode === "both";
  const showFloatingPanel = mode === "native" || mode === "both";
  const showFloatingHelp = showFloatingPanel && field.tooltipIcon !== false;

  return {
    body,
    floatingHelpText,
    showFloatingHelp,
    ariaDescription,
    showBelow,
    placement,
    delayMs,
    shortcut
  };
};

// Expose fns to parent if onFnsReady callback is provided
const onFnsReady = args.contextData.props?.onFnsReady;
if (onFnsReady && typeof onFnsReady === "function") {
  // Call onFnsReady with the fns object after form is initialized
  args.createEffect(() => {
    const vertexId = formVertexId();
    if (vertexId !== null) {
      onFnsReady({
        handleSave,
        isSubmitting,
        formTxnId,
        validate
      });
    }
  });
}

return {
  getFormConfig,
  getInitialVertex,
  getMode,
  getVertexLabel,
  getFormVertex,
  getAllFields,
  formVertexId,
  setFormVertexId,
  formTxnId,
  setFormTxnId,
  errors,
  setErrors,
  isSubmitting,
  setIsSubmitting,
  initializeForm,
  getFieldValue,
  setFieldValue,
  validate,
  handleSave,
  isFieldVisible,
  getFieldTooltipMeta,
  getUsePolarisUI: () => args.fns.getUsePolarisUI?.() === true,
  markNestedLineDeleted,
  getNestedDeletedIdsForField,
  ensureFormTxn,
  getNestedLineVerticesForField,
  applyAutoReferenceSequencesAfterAdd
};
'''
        componentName: Html
        props:
          '''
const containerClass = args.contextData.props?.class || "";
return {
  as: "div",
  class: containerClass,
  onMount: () => {
    args.fns.initializeForm();
    void args.fns.applyAutoReferenceSequencesAfterAdd();
  }
};
'''
      }
    }
