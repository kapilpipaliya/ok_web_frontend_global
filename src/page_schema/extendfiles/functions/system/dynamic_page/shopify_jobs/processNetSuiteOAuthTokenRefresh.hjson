{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: processNetSuiteOAuthTokenRefresh
        description: Background worker (BullMQ) — repeatable job refreshes NetSuite OAuth access tokens per shop DB using the stored refresh token
        body:
          '''
if (c?.action !== "start") {
  return;
}

const readNetSuiteIntegrationFromDb = async (neoSession) => {
  let accountId = "";
  let clientId = "";
  let clientSecret = "";
  let redirectUri = "";
  let scope = "rest_webservices";
  let environment = "production";
  try {
    const r = await neoSession.run(
      `MATCH (s:Setting {type: $t}) RETURN s LIMIT 1`,
      { t: "netsuite_integration" }
    );
    if (r.records.length) {
      const j = _.convertNodeToJson(r.records[0].get("s"));
      const P = j?.P || {};
      accountId = String(P.accountId || "").trim();
      clientId = String(P.clientId || "").trim();
      redirectUri = String(P.redirectUri || "").trim();
      scope = String(P.scope || "rest_webservices").trim();
      environment = String(P.environment || "production").trim().toLowerCase();
      if (P.clientSecret) {
        try {
          clientSecret = _.decryptToken(String(P.clientSecret));
        } catch (e) {
          clientSecret = "";
        }
      }
    }
  } catch (e) {
    console.warn("[processNetSuiteOAuthTokenRefresh] readNetSuiteIntegrationFromDb:", e?.message || e);
  }
  return { accountId, clientId, clientSecret, redirectUri, scope, environment };
};

const cfgBootstrap = await readNetSuiteIntegrationFromDb(_.session);
if (!cfgBootstrap.clientId || !cfgBootstrap.clientSecret) {
  console.warn(
    "[processNetSuiteOAuthTokenRefresh] No NetSuite app credentials in database; refreshes will skip until Settings are saved."
  );
}

const intervalMs = Number(c?.intervalMs) > 0
  ? Number(c.intervalMs)
  : 5 * 60 * 1000;

const refreshSkewMs = Number(c?.refreshSkewMs) > 0
  ? Number(c.refreshSkewMs)
  : 120 * 1000;

const QUEUE_NAME = "processNetSuiteOAuthTokenRefresh";
const REPEATABLE_JOB_ID = "netsuite-oauth-refresh-repeatable";

const helpers = await s(
  { functionName: "shopifyQueueHelpers", contextData: {} },
  { functionLookupSubDomain: _.subDomain }
);

if (!helpers.result?.success) {
  console.error("[processNetSuiteOAuthTokenRefresh] shopifyQueueHelpers init failed", helpers.result?.error);
  throw new Error("shopifyQueueHelpers initialization failed");
}

const h = helpers.result.data;
const connection = h.getRedisConnection();

if (!connection || !connection.host) {
  throw new Error("Invalid Redis connection for NetSuite token refresh worker");
}

const { Worker, Queue } = _.bullmq;
const tokenQueue = new Queue(QUEUE_NAME, { connection });

await tokenQueue.add(
  "netsuite-oauth-refresh",
  { scheduledRun: true, description: "NetSuite OAuth access token refresh check" },
  {
    repeat: { every: intervalMs },
    jobId: REPEATABLE_JOB_ID
  }
);

await new Promise((r) => setTimeout(r, 100));

await tokenQueue.add(
  "netsuite-oauth-refresh",
  { bootstrap: true },
  { removeOnComplete: 20, removeOnFail: 5 }
);

const appSubDomain = _.rawSubDomain;

const parseExpiresMs = (p) => {
  const raw = p?.expiresAt;
  if (raw == null || raw === "") return 0;
  if (typeof raw === "object" && raw != null && typeof raw.toString === "function") {
    const t = new Date(raw.toString()).getTime();
    return Number.isNaN(t) ? 0 : t;
  }
  const t = new Date(raw).getTime();
  return Number.isNaN(t) ? 0 : t;
};

const refreshTokensInSession = async (shopLabel, dbSession) => {
  const cfg = await readNetSuiteIntegrationFromDb(dbSession);
  const clientId = cfg.clientId;
  const clientSecret = cfg.clientSecret;
  if (!clientId || !clientSecret) {
    return { skipped: true, reason: "no_app_credentials" };
  }

  const oauthResult = await dbSession.run(
    `MATCH (n:OAuthConnection {integrationKey: "netsuite"})
     RETURN n
     LIMIT 1`
  );

  if (!oauthResult.records.length) {
    return { skipped: true, reason: "no_connection" };
  }

  const oauthNode = oauthResult.records[0].get("n");
  const oauthData = _.convertNodeToJson(oauthNode);
  const P = oauthData?.P || {};

  const accountId = String(P.accountId || "").trim();
  const refreshEnc = P.refreshTokenEncrypted;

  if (!accountId) {
    console.warn(
      `[processNetSuiteOAuthTokenRefresh] ${shopLabel || "session"}: missing accountId on OAuthConnection`
    );
    return { skipped: true, reason: "no_account" };
  }

  if (!refreshEnc) {
    console.warn(
      `[processNetSuiteOAuthTokenRefresh] ${shopLabel || "session"}: no refresh token; reconnect NetSuite OAuth.`
    );
    return { skipped: true, reason: "no_refresh_token" };
  }

  let refreshToken;
  try {
    refreshToken = _.decryptToken(refreshEnc);
  } catch (e) {
    console.warn(
      `[processNetSuiteOAuthTokenRefresh] ${shopLabel || "session"}: decrypt refresh token failed`
    );
    return { skipped: true, reason: "decrypt_refresh_failed" };
  }

  if (!refreshToken) {
    return { skipped: true, reason: "empty_refresh_token" };
  }

  const expiresMs = parseExpiresMs(P);
  const now = Date.now();
  if (expiresMs > 0 && expiresMs > now + refreshSkewMs) {
    return { skipped: true, reason: "still_valid" };
  }

  const tokenHost = `${accountId}.suitetalk.api.netsuite.com`;
  const tokenUrl = `https://${tokenHost}/services/rest/auth/oauth2/v1/token`;

  const authHeader = Buffer.from(`${clientId}:${clientSecret}`).toString("base64");
  const payload = new URLSearchParams({
    grant_type: "refresh_token",
    refresh_token: refreshToken
  });

  const tokenResponse = await fetch(tokenUrl, {
    method: "POST",
    headers: {
      Authorization: `Basic ${authHeader}`,
      "Content-Type": "application/x-www-form-urlencoded",
      Accept: "application/json"
    },
    body: payload.toString()
  });

  let tokenJson;
  try {
    tokenJson = await tokenResponse.json();
  } catch (err) {
    tokenJson = null;
  }

  if (!tokenResponse.ok || !tokenJson?.access_token) {
    const msg =
      tokenJson?.error_description ||
      tokenJson?.error ||
      `HTTP ${tokenResponse.status}`;
    console.warn(
      `[processNetSuiteOAuthTokenRefresh] ${shopLabel || "session"}: refresh failed:`,
      msg
    );
    return { success: false, error: msg };
  }

  const accessToken = tokenJson.access_token;
  const newRefresh = tokenJson.refresh_token || null;
  const tokenType = tokenJson.token_type || P.tokenType || "Bearer";
  const scope = tokenJson.scope != null ? tokenJson.scope : P.scope;
  const expiresIn = Number(tokenJson.expires_in || 0);
  const expiresAtIso =
    expiresIn > 0 ? new Date(Date.now() + expiresIn * 1000).toISOString() : null;

  const encryptedAccessToken = _.encryptToken(accessToken);
  const encryptedRefreshToken = newRefresh
    ? _.encryptToken(newRefresh)
    : refreshEnc;

  const nowIso = new Date().toISOString();

  await dbSession.run(
    `MATCH (n:OAuthConnection {integrationKey: "netsuite"})
     SET n.updatedAt = datetime($nowIso),
         n.tokenType = $tokenType,
         n.scope = $scope,
         n.expiresAt = CASE WHEN $expiresAtIso IS NULL THEN null ELSE datetime($expiresAtIso) END,
         n.accessTokenEncrypted = $encryptedAccessToken,
         n.refreshTokenEncrypted = $encryptedRefreshToken`,
    {
      nowIso,
      tokenType,
      scope,
      expiresAtIso,
      encryptedAccessToken,
      encryptedRefreshToken
    }
  );

  console.log(
    `[processNetSuiteOAuthTokenRefresh] ${shopLabel || "session"}: access token refreshed`
  );
  return { success: true };
};

const runCycle = async (mainSession) => {
  if (!mainSession) {
    console.warn("[processNetSuiteOAuthTokenRefresh] No db session for job");
    return;
  }

  let shops = [];
  try {
    const shopsResult = await mainSession.run(
      `MATCH (s:ShopifyShop) RETURN s.shop AS shop`
    );
    shops = shopsResult.records
      .map((rec) => rec.get("shop"))
      .filter((s) => s != null && String(s).trim() !== "");
  } catch (e) {
    console.warn("[processNetSuiteOAuthTokenRefresh] Could not list ShopifyShop:", e?.message || e);
  }

  const driver = _.getDriver();

  for (const shop of shops) {
    const shopStr = String(shop).trim();
    let dbName;
    try {
      dbName = _.getDatabaseNameForShop(shopStr, appSubDomain);
    } catch (e) {
      console.warn("[processNetSuiteOAuthTokenRefresh] getDatabaseNameForShop failed:", shopStr, e);
      continue;
    }

    const shopSession = driver.session({ database: dbName });
    try {
      await refreshTokensInSession(shopStr, shopSession);
    } finally {
      await shopSession.close();
    }
  }

  if (shops.length === 0) {
    await refreshTokensInSession("default_db", mainSession);
  }
};

let workerInstance;

try {
  workerInstance = new Worker(
    QUEUE_NAME,
    async () => {
      const mainSession = await _.getSession();
      try {
        await runCycle(mainSession);
      } finally {
        await mainSession.close();
      }
    },
    { connection, concurrency: 1, lockDuration: 120000 }
  );

  workerInstance.on("failed", (job, err) =>
    console.error("[processNetSuiteOAuthTokenRefresh] Job failed", job?.id, err?.message)
  );
  workerInstance.on("error", (err) =>
    console.error("[processNetSuiteOAuthTokenRefresh] Worker error", err?.message)
  );

  return {
    stop: async (force = false) => {
      try {
        const repeatables = await tokenQueue.getRepeatableJobs(0, 200, true);
        for (const r of repeatables || []) {
          if (r.key) {
            try {
              await tokenQueue.removeRepeatableByKey(r.key);
            } catch (e) {
              console.warn("[processNetSuiteOAuthTokenRefresh] removeRepeatableByKey:", e?.message);
            }
          }
        }
      } catch (e) {
        console.warn("[processNetSuiteOAuthTokenRefresh] cleanup repeatables:", e?.message);
      }
      if (workerInstance) {
        await workerInstance.close(force);
      }
      await tokenQueue.close(force);
    }
  };
} catch (error) {
  console.error("[processNetSuiteOAuthTokenRefresh] Failed to create worker", error);
  if (workerInstance) {
    try {
      await workerInstance.close();
    } catch (e) {}
  }
  try {
    await tokenQueue.close();
  } catch (e) {}
  throw error;
}
'''
      }
    }
  ]
  edges: []
}
