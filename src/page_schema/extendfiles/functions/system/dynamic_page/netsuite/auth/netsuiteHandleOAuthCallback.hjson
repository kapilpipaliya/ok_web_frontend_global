{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: netsuiteHandleOAuthCallback
        description: Exchange NetSuite OAuth code for tokens and persist encrypted credentials
        body:
          '''
const readNetSuiteIntegrationFromDb = async (neoSession) => {
  let accountId = "";
  let clientId = "";
  let clientSecret = "";
  let redirectUri = "";
  let scope = "rest_webservices";
  let environment = "production";
  try {
    const r = await neoSession.run(
      `MATCH (s:Setting {type: $t}) RETURN s LIMIT 1`,
      { t: "netsuite_integration" }
    );
    if (r.records.length) {
      const j = _.convertNodeToJson(r.records[0].get("s"));
      const P = j?.P || {};
      accountId = String(P.accountId || "").trim();
      clientId = String(P.clientId || "").trim();
      redirectUri = String(P.redirectUri || "").trim();
      scope = String(P.scope || "rest_webservices").trim();
      environment = String(P.environment || "production").trim().toLowerCase();
      if (P.clientSecret) {
        try {
          clientSecret = _.decryptToken(String(P.clientSecret));
        } catch (e) {
          clientSecret = "";
        }
      }
    }
  } catch (e) {
    console.warn("[netsuiteHandleOAuthCallback] readNetSuiteIntegrationFromDb:", e?.message || e);
  }
  return { accountId, clientId, clientSecret, redirectUri, scope, environment };
};

const cfg = await readNetSuiteIntegrationFromDb(_.session);
const accountId = cfg.accountId;
const clientId = cfg.clientId;
const clientSecret = cfg.clientSecret;
const redirectUri = cfg.redirectUri;
const environment = cfg.environment;

if (!accountId || !clientId || !clientSecret || !redirectUri) {
  return {
    success: false,
    message:
      "Missing NetSuite OAuth configuration. An administrator must save Account ID, Client ID, Client Secret, and Redirect URI under app Settings."
  };
}

const code = (c?.code || "").trim();
const state = (c?.state || "").trim();
const oauthError = (c?.error || "").trim();
const oauthErrorDescription = (c?.error_description || "").trim();

if (oauthError) {
  return {
    success: false,
    message: oauthErrorDescription || oauthError
  };
}

if (!code || !state) {
  return {
    success: false,
    message: "Missing OAuth callback parameters (code/state)."
  };
}

const stateResult = await _.session.run(
  `MATCH (s:OAuthState {provider: "netsuite", state: $state})
   RETURN s
   LIMIT 1`,
  { state }
);

if (!stateResult.records.length) {
  return {
    success: false,
    message: "Invalid or expired OAuth state."
  };
}

const stateNode = stateResult.records[0].get("s");
const stateJson = _.convertNodeToJson(stateNode);
const expiresAt = stateJson?.P?.expiresAt ? new Date(stateJson.P.expiresAt).getTime() : 0;

if (!expiresAt || Number.isNaN(expiresAt) || expiresAt < Date.now()) {
  await _.session.run(
    `MATCH (s:OAuthState {provider: "netsuite", state: $state}) DELETE s`,
    { state }
  );
  return {
    success: false,
    message: "OAuth state expired. Please try connecting again."
  };
}

const tokenHost =
  environment === "sandbox"
    ? `${accountId}.suitetalk.api.netsuite.com`
    : `${accountId}.suitetalk.api.netsuite.com`;
const tokenUrl = `https://${tokenHost}/services/rest/auth/oauth2/v1/token`;

const authHeader = Buffer.from(`${clientId}:${clientSecret}`).toString("base64");
const payload = new URLSearchParams({
  grant_type: "authorization_code",
  code,
  redirect_uri: redirectUri
});

const tokenResponse = await fetch(tokenUrl, {
  method: "POST",
  headers: {
    Authorization: `Basic ${authHeader}`,
    "Content-Type": "application/x-www-form-urlencoded",
    Accept: "application/json"
  },
  body: payload.toString()
});

let tokenJson;
try {
  tokenJson = await tokenResponse.json();
} catch (error) {
  tokenJson = null;
}

if (!tokenResponse.ok || !tokenJson?.access_token) {
  return {
    success: false,
    message:
      tokenJson?.error_description ||
      tokenJson?.error ||
      `Token exchange failed with status ${tokenResponse.status}.`
  };
}

const accessToken = tokenJson.access_token;
const refreshToken = tokenJson.refresh_token || null;
const tokenType = tokenJson.token_type || "Bearer";
const scope = tokenJson.scope || null;
const expiresIn = Number(tokenJson.expires_in || 0);
const now = Date.now();
const expiresAtIso = expiresIn > 0 ? new Date(now + expiresIn * 1000).toISOString() : null;
const encryptedAccessToken = _.encryptToken(accessToken);
const encryptedRefreshToken = refreshToken ? _.encryptToken(refreshToken) : null;
const nowIso = new Date(now).toISOString();

await _.session.run(
  `MERGE (n:OAuthConnection {integrationKey: "netsuite"})
   ON CREATE SET n.createdAt = datetime($nowIso)
   SET n.updatedAt = datetime($nowIso),
       n.accountId = $accountId,
       n.environment = $environment,
       n.tokenType = $tokenType,
       n.scope = $scope,
       n.expiresAt = CASE WHEN $expiresAtIso IS NULL THEN null ELSE datetime($expiresAtIso) END,
       n.accessTokenEncrypted = $encryptedAccessToken,
       n.refreshTokenEncrypted = $encryptedRefreshToken`,
  {
    nowIso,
    accountId,
    environment,
    tokenType,
    scope,
    expiresAtIso,
    encryptedAccessToken,
    encryptedRefreshToken
  }
);

await _.session.run(
  `MATCH (s:OAuthState {provider: "netsuite", state: $state}) DELETE s`,
  { state }
);

return {
  success: true,
  message: "NetSuite OAuth connected successfully.",
  data: {
    connected: true,
    accountId,
    environment,
    tokenType,
    scope,
    expiresAt: expiresAtIso
  }
};
'''
      }
    }
  ]
  edges: []
}
