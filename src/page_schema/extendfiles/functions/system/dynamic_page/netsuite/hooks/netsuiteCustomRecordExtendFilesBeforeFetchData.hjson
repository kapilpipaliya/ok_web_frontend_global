{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: netsuiteExtendFilesBeforeFetchData
        description: Sync NetSuite customrecord_extend_files_aut records into Neo4j before DynamicPage fetch
        body:
          '''
const {
  tableVertexLabel,
  filters = {},
  categoryId,
  showUnassigned,
  parentVertexLabel,
  toParentEdgeType,
} = c || {};
if (tableVertexLabel !== "NetSuiteExtendFile") return;

// Match getUserContent: synthetic uncategorized category id is "_" + tableVertexLabel + "_uncategorized"
const vertexLabel = tableVertexLabel;
const uncategorizedVertexId = "_" + vertexLabel + "_uncategorized";

// When sidebar root "Uncategorized" is selected, we sync only the uncategorized ids.
// When a specific category is selected, we sync only the ids connected to that category.
const isUncategorized =
  showUnassigned === true ||
  !categoryId ||
  categoryId === uncategorizedVertexId;

const oauthResult = await _.session.run(
  `MATCH (n:OAuthConnection {integrationKey: "netsuite"})
   RETURN n
   LIMIT 1`
);

if (!oauthResult.records.length) {
  console.warn("[netsuiteExtendFilesBeforeFetchData] NetSuite OAuth is not connected.");
  return;
}

const oauthNode = oauthResult.records[0].get("n");
const oauthData = _.convertNodeToJson(oauthNode);
const accountId = String(oauthData?.P?.accountId || "").trim();
const accessTokenEncrypted = oauthData?.P?.accessTokenEncrypted;

if (!accountId || !accessTokenEncrypted) {
  console.warn("[netsuiteExtendFilesBeforeFetchData] Missing NetSuite account/token.");
  return;
}

let accessToken = "";
try {
  accessToken = _.decryptToken(accessTokenEncrypted);
} catch (error) {
  console.warn("[netsuiteExtendFilesBeforeFetchData] Unable to decrypt NetSuite access token.");
  return;
}

if (!accessToken) {
  console.warn("[netsuiteExtendFilesBeforeFetchData] Empty NetSuite access token.");
  return;
}

const baseUrl = `https://${accountId}.suitetalk.api.netsuite.com/services/rest/query/v1/suiteql`;
const escaped = (value) => String(value || "").replace(/'/g, "''");
const nameLike = String(filters?.name || "").trim();
// Track fetched ids only when we are not filtering by search term.
// This allows safe stale-deletion (otherwise we'd delete records that don't match the search).
const shouldTrackFetchedIds = !nameLike;
const fetchedIds = shouldTrackFetchedIds ? new Set() : null;

// Build id filter list from Neo4j graph relationships.
// Content ids are stored as `P.id` on NetSuiteExtendFile vertices.
let contentIdsToSync = [];
if (parentVertexLabel && toParentEdgeType) {
  if (!isUncategorized && categoryId) {
    // Categorized: content linked to selected category
    const rs = await _.session.run(
      `MATCH (c:${tableVertexLabel})-[:${toParentEdgeType}]->(cat:${parentVertexLabel})
       WHERE elementId(cat) = $categoryId
       RETURN DISTINCT c.id AS id`,
      { categoryId },
    );
    contentIdsToSync = rs.records
      .map((r) => r.get("id"))
      .filter((v) => v != null && String(v) !== "")
      .map((v) => String(v));
  } else {
    // Uncategorized: content with no category relationship
    const rs = await _.session.run(
      `MATCH (c:${tableVertexLabel})
       WHERE NOT EXISTS {
         MATCH (c)-[:${toParentEdgeType}]->(:${parentVertexLabel})
       }
       RETURN DISTINCT c.id AS id`,
    );
    contentIdsToSync = rs.records
      .map((r) => r.get("id"))
      .filter((v) => v != null && String(v) !== "")
      .map((v) => String(v));
  }
}

// Sync rules:
// - `uncategorized` => always sync everything (no id filtering)
// - categorized with no ids => do not fetch at all
// - if we can't determine category ids for a categorized view, also do not fetch
let shouldSyncAll = isUncategorized === true;

if (!shouldSyncAll) {
  // Categorized path
  if (!parentVertexLabel || !toParentEdgeType) return;
  if (!contentIdsToSync.length) return;
}

const toSuiteQlId = (id) => {
  const s = String(id);
  return /^\d+$/.test(s) ? s : `'${escaped(s)}'`;
};

const conditions = [];
if (nameLike) {
  conditions.push(`LOWER(name) LIKE LOWER('%${escaped(nameLike)}%')`);
}
if (!shouldSyncAll) {
  conditions.push(`id IN (${contentIdsToSync.map(toSuiteQlId).join(",")})`);
}

const whereClause = conditions.length
  ? ` WHERE ${conditions.join(" AND ")}`
  : "";

const suiteQl = `SELECT * FROM customrecord_extend_files_aut${whereClause}`;

const headers = {
  Authorization: `Bearer ${accessToken}`,
  "Content-Type": "application/json",
  Accept: "application/json",
  Prefer: "transient"
};

let offset = 0;
const limit = 1000;
let hasMore = true;
let total = 0;
const session = _.session;

const BATCH_SIZE = 150;
const pendingRows = [];
const flagTrue = (v) => {
  const s = String(v ?? "").toLowerCase();
  return s === "t" || s === "true" || s === "1" || s === "yes";
};

const runMergeChunk = async (rows) => {
  if (!rows || rows.length === 0) return;
  await session.run(
    `UNWIND $rows AS row
     MERGE (n:NetSuiteExtendFile {id: row.id})
     SET n += row.props`,
    { rows }
  );
};

const queueRow = async (id, props) => {
  pendingRows.push({ id, props });
  total++;
  if (pendingRows.length >= BATCH_SIZE) {
    await runMergeChunk(pendingRows.splice(0, BATCH_SIZE));
  }
};

/** SuiteQL row keys fully mapped onto vertex props — remainder goes into extraJson only */
const MAPPED_ROW_KEYS = new Set([
  "id",
  "internalid",
  "name",
  "isinactive",
  "lastmodified",
  "lastmodifieddate",
  "lastmodifiedbydate",
  "custrecord_extfile_filename",
  "custrecord_extfile_foldername",
  "custrecord_extend_preview_image",
  "custrecord_extfile_link",
  "custrecord_extend_preview_file_format",
  "custrecord_extfile_type_system",
  "custrecord_extfile_file_size",
  "custrecord_extfile_approval_id",
  "custrecord_extfile_approved",
  "custrecord_extfile_rejected",
  "custrecord_extend_files_private_url",
  "custrecord_extend_files_original_transac",
  "custrecord_extfile_so_pref",
  "created",
  "lastmodifiedby",
  "owner",
  "scriptid",
  "custrecord_extend_files_thumbnail_error"
]);

const str = (v) => {
  if (v == null) return "";
  const s = String(v).trim();
  if (s === "" || s === "undefined" || s === "null") return "";
  return s;
};

const buildExtraJson = (row) => {
  const extra = {};
  for (const k of Object.keys(row)) {
    if (!MAPPED_ROW_KEYS.has(k)) {
      extra[k] = row[k];
    }
  }
  const keys = Object.keys(extra);
  return keys.length ? JSON.stringify(extra) : "";
};

while (hasMore) {
  const url = `${baseUrl}?limit=${limit}&offset=${offset}`;
  const response = await fetch(url, {
    method: "POST",
    headers,
    body: JSON.stringify({ q: suiteQl })
  });

  let payload;
  try {
    payload = await response.json();
  } catch (error) {
    payload = null;
  }

  if (!response.ok) {
    await runMergeChunk(pendingRows.splice(0, pendingRows.length));
    console.warn(
      "[netsuiteCustomRecordExtendFilesBeforeFetchData] SuiteQL request failed:",
      payload?.oerrorDetails?.[0]?.detail || payload?.error || response.status
    );
    return;
  }

  const items = Array.isArray(payload?.items) ? payload.items : [];
  for (let i = 0; i < items.length; i++) {
    const row = items[i] || {};
    const sourceId = row.id ?? row.internalid ?? `${offset + i + 1}`;
    const id = String(sourceId);
    if (fetchedIds) fetchedIds.add(id);
    const name = str(row.name);
    const isInactive = flagTrue(row.isinactive);
    const lastModified = str(
      row.lastmodified || row.lastmodifieddate || row.lastmodifiedbydate || ""
    );

    const fileName = str(row.custrecord_extfile_filename);
    const folderName = str(row.custrecord_extfile_foldername);
    const previewImageUrl = str(row.custrecord_extend_preview_image);
    const fileLink = str(row.custrecord_extfile_link);
    const fileUrl = fileLink || previewImageUrl;
    const mimeFromPreview = str(row.custrecord_extend_preview_file_format);
    const mimeFromSystem = str(row.custrecord_extfile_type_system);
    const mimeType = mimeFromPreview || mimeFromSystem;
    const fileSize = str(row.custrecord_extfile_file_size);
    const approvalId = str(row.custrecord_extfile_approval_id);
    const approved = flagTrue(row.custrecord_extfile_approved);
    const rejected = flagTrue(row.custrecord_extfile_rejected);
    const privateUrl = flagTrue(row.custrecord_extend_files_private_url);
    const originalTransaction = str(row.custrecord_extend_files_original_transac);
    const soPref = str(row.custrecord_extfile_so_pref);
    const created = str(row.created);
    const lastModifiedBy = str(row.lastmodifiedby);
    const owner = str(row.owner);
    const scriptId = str(row.scriptid);
    const thumbnailError = str(row.custrecord_extend_files_thumbnail_error);

    const extraJson = buildExtraJson(row);

    const props = {
      id,
      name: name || fileName,
      fileName,
      folderName,
      previewImageUrl,
      fileUrl,
      mimeType,
      fileSize,
      approvalId,
      approved,
      rejected,
      privateUrl,
      originalTransaction,
      soPref,
      created,
      lastModifiedBy,
      owner,
      scriptId,
      thumbnailError,
      isInactive,
      lastModified,
      recordType: "customrecord_extend_files_aut",
      extraJson,
      updatedAt: new Date().toISOString()
    };

    await queueRow(id, props);
  }

  hasMore = payload?.hasMore === true;
  if (!hasMore) break;
  offset += limit;
}

await runMergeChunk(pendingRows.splice(0, pendingRows.length));

// Delete stale DB records when we performed an id-complete fetch.
// - uncategorized: compare against all fetched ids and delete stale globally
// - categorized: compare against fetched ids for the selected category and delete stale within that set
let deletedCount = 0;
if (fetchedIds && fetchedIds.size > 0) {
  if (shouldSyncAll) {
    // uncategorized full sync: delete any db ids not returned by NetSuite
    const existingResult = await session.run(
      `MATCH (n:NetSuiteExtendFile) RETURN n.id as id`,
      {},
    );
    const existingIds = existingResult.records
      .map((r) => r.get("id"))
      .filter((v) => v != null && String(v) !== "")
      .map((v) => String(v));

    const toDelete = [];
    for (const existingId of existingIds) {
      if (!fetchedIds.has(existingId)) toDelete.push(existingId);
    }

    if (toDelete.length > 0) {
      await session.run(
        `MATCH (n:NetSuiteExtendFile) WHERE n.id IN $ids DETACH DELETE n`,
        { ids: toDelete },
      );
      deletedCount = toDelete.length;
    }
  } else {
    // categorized sync: delete only within the selected category's id set
    const toDelete = contentIdsToSync
      .map((id) => String(id))
      .filter((id) => id && !fetchedIds.has(id));

    if (toDelete.length > 0) {
      await session.run(
        `MATCH (n:NetSuiteExtendFile) WHERE n.id IN $ids DETACH DELETE n`,
        { ids: toDelete },
      );
      deletedCount = toDelete.length;
    }
  }
}

console.log(
  "[netsuiteExtendFilesBeforeFetchData] synced rows:",
  total,
  "deleted stale rows:",
  deletedCount,
  "syncMode:",
  shouldSyncAll ? "uncategorized" : "categorized",
  "searchFilterApplied:",
  !!nameLike,
);
'''
      }
    }
  ]
  edges: []
}
