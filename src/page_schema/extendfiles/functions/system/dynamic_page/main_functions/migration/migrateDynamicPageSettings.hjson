            { key: "name", label: "Name", dataType: "text", renderer: "text", required: true, maxLength: 255, colSpan: 2 }
          ]
        }
      ]
    }
  },
  hooks: { beforeFetchData: "netsuiteExtendFilesBeforeFetchData" }
};`
  },
  {
    key: 'Support_settings_default',
    tableVertexLabel: 'Support',
    icon: '💬',
    name: 'Support',
    config: `return {
  title: "Support Tickets",
  label: "Support Ticket",
  icon: "carbon:chat",
  hideExportButtons: false,
  hideImportButtons: true,
  hideSettingsButton: false,
  columns: [
    {
      key: "shop",
      label: "Shop",
      dataType: "text", renderer: "text",
      width: "220px"
    },
    {
      key: "subject",
      label: "Subject",
      dataType: "text", renderer: "text",
      width: "260px",
      required: false
    },
    {
      key: "email",
      label: "Email",
      dataType: "text", renderer: "text",
      width: "220px"
    },
    {
      key: "unreadForAdmin",
      label: "Unread",
      dataType: "number", renderer: "number",
      width: "90px"
    },
    {
      key: "createdAt",
      label: "Created",
      dataType: "date", renderer: "date",
      width: "160px",
      valueAccessor: (row) => row.P?.createdAt || row.createdAt
    }
  ],
  rowHeight: 60,
  showRowNumber: true,
  showSelection: false,
  actions: [],
  rowClickable: true,
  resizableColumns: true,
  columnWidths: { __rowNumber: "40px" },
  formConfig: null,
  uniqueKeys: [],
  usePolarisUI: false,
  enableUserScopingForSidebar: false,
  enableUserScopingForContent: false,
  enableLocalFilters: true,
  enableLocalSort: true,
  hooks: {},
  sidebar: {
    enabled: false
  },
  onRowClick: (row, args) => {
    if (!row?.id) return;
    const ticketId = row.id;
    const basePath = "/ShopifySupportConversation";
    const searchParams = args.searchParams || {};
    const nextParams = { ...searchParams, supportId: ticketId };
    const query = Object.entries(nextParams)
      .filter(([, value]) => value != null && value !== "")
      .map(([key, value]) => \`\${encodeURIComponent(key)}=\${encodeURIComponent(String(value))}\`)
      .join("&");
    const href = query ? \`\${basePath}?\${query}\` : basePath;

    if (args.navigate) {
      args.navigate(href);
    } else if (typeof window !== "undefined") {
      window.location.href = href;
    }
  }
};`
  },
];

// Helper function to process a single setting
async function processSetting(setting) {
  const { key, tableVertexLabel, icon, name, config } = setting;

  console.log(`\n${icon} Processing ${name} settings...`);

  // Check if setting exists
  const checkResult = await args.session.run(
    `MATCH (s:Setting {key: $key}) RETURN s`,
    { key }
  );

  const exists = checkResult.records.length > 0;

  if (!dryRun) {
    if (exists) {
      // Update existing
      await args.session.run(
        `MATCH (s:Setting {key: $key})
         SET s.config = $config,
             s.type = 'table_config',
             s.tableVertexLabel = $tableVertexLabel,
             s.updatedAt = datetime()
         RETURN s`,
        { key, config, tableVertexLabel }
      );
      console.log(`✅ Updated existing ${name} settings`);
      return { created: 0, updated: 1 };
    } else {
      // Create new
      await args.session.run(
        `CREATE (s:Setting {
          key: $key,
          type: 'table_config',
          tableVertexLabel: $tableVertexLabel,
          config: $config,
          createdAt: datetime(),
          updatedAt: datetime()
        })
        RETURN s`,
        { key, config, tableVertexLabel }
      );
      console.log(`✅ Created new ${name} settings`);
      return { created: 1, updated: 0 };
    }
  } else {
    // Dry run - just report
    if (exists) {
      console.log(`📋 Would update existing ${name} settings`);
      return { created: 0, updated: 1 };
    } else {
      console.log(`📋 Would create new ${name} settings`);
      return { created: 1, updated: 0 };
    }
  }
}

// Process all settings
const stats = {
  bookSettingsCreated: 0,
  bookSettingsUpdated: 0,
  audioVideoSettingsCreated: 0,
  audioVideoSettingsUpdated: 0,
  categorySettingsCreated: 0,
  categorySettingsUpdated: 0,
  shopifyProductSettingsCreated: 0,
  shopifyProductSettingsUpdated: 0,
  shopifyProductCategorySettingsCreated: 0,
  shopifyProductCategorySettingsUpdated: 0,
  shopifyShopSettingsCreated: 0,
  shopifyShopSettingsUpdated: 0
};

for (let i = 0; i < settingsConfigs.length; i++) {
  const setting = settingsConfigs[i];
  const result = await processSetting(setting);

  // Update stats based on setting type
  if (setting.tableVertexLabel === 'Book') {
    stats.bookSettingsCreated += result.created;
    stats.bookSettingsUpdated += result.updated;
  } else if (setting.tableVertexLabel === 'AudioVideo') {
    stats.audioVideoSettingsCreated += result.created;
    stats.audioVideoSettingsUpdated += result.updated;
  } else if (setting.tableVertexLabel === 'Category') {
    stats.categorySettingsCreated += result.created;
    stats.categorySettingsUpdated += result.updated;
  } else if (setting.tableVertexLabel === 'ShopifyProduct') {
    stats.shopifyProductSettingsCreated += result.created;
    stats.shopifyProductSettingsUpdated += result.updated;
  } else if (setting.tableVertexLabel === 'ShopifyProductCategory') {
    stats.shopifyProductCategorySettingsCreated += result.created;
    stats.shopifyProductCategorySettingsUpdated += result.updated;
  } else if (setting.tableVertexLabel === 'ShopifyShop') {
    stats.shopifyShopSettingsCreated += result.created;
    stats.shopifyShopSettingsUpdated += result.updated;
  }
}

// ==========================================
// Summary
// ==========================================
console.log('\n📊 Migration Summary:');
console.log('==========================================');
console.log(`Book settings - Created: ${stats.bookSettingsCreated}, Updated: ${stats.bookSettingsUpdated}`);
console.log(`AudioVideo settings - Created: ${stats.audioVideoSettingsCreated}, Updated: ${stats.audioVideoSettingsUpdated}`);
console.log(`Category settings - Created: ${stats.categorySettingsCreated}, Updated: ${stats.categorySettingsUpdated}`);
console.log(`ShopifyProduct settings - Created: ${stats.shopifyProductSettingsCreated}, Updated: ${stats.shopifyProductSettingsUpdated}`);
console.log(`ShopifyProductCategory settings - Created: ${stats.shopifyProductCategorySettingsCreated}, Updated: ${stats.shopifyProductCategorySettingsUpdated}`);
console.log(`ShopifyShop settings - Created: ${stats.shopifyShopSettingsCreated}, Updated: ${stats.shopifyShopSettingsUpdated}`);
console.log('==========================================');

return {
  success: true,
  message: dryRun
    ? "Dry run completed - no changes made"
    : "Content table settings migration completed successfully",
  data: {
    ...stats,
    dryRun
  }
};
'''
        key: migrateDynamicPageSettings
      }
    }
  ]
  edges: []
}