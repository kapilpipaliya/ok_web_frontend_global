    { key: "mimeType", label: "MIME", dataType: "text", renderer: "text", width: "120px", valueAccessor: (row) => { const v = row.P?.mimeType; if (v == null || v === "") return ""; const s = String(v); return s === "undefined" || s === "null" ? "" : s; }, overflowEllipsis: true },
    { key: "fileSize", label: "Size (bytes)", dataType: "text", renderer: "text", width: "110px", valueAccessor: (row) => row.P?.fileSize },
    { key: "id", label: "Internal ID", dataType: "text", renderer: "text", width: "110px", valueAccessor: (row) => row.P?.id },
    { key: "approved", label: "Approved", dataType: "text", renderer: "badge", width: "90px", valueAccessor: (row) => (row.P?.approved ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "success"], no: ["No", "neutral"] } },
    { key: "rejected", label: "Rejected", dataType: "text", renderer: "badge", width: "90px", valueAccessor: (row) => (row.P?.rejected ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "critical"], no: ["No", "neutral"] } },
    { key: "privateUrl", label: "Private URL", dataType: "text", renderer: "badge", width: "100px", valueAccessor: (row) => (row.P?.privateUrl ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "info"], no: ["No", "neutral"] } },
    { key: "approvalId", label: "Approval UUID", dataType: "text", renderer: "text", width: "200px", valueAccessor: (row) => row.P?.approvalId, overflowEllipsis: true },
    { key: "originalTransaction", label: "Orig. trans.", dataType: "text", renderer: "text", width: "110px", valueAccessor: (row) => row.P?.originalTransaction },
    { key: "soPref", label: "SO pref", dataType: "text", renderer: "text", width: "100px", valueAccessor: (row) => row.P?.soPref },
    { key: "created", label: "Created", dataType: "text", renderer: "text", width: "120px", valueAccessor: (row) => row.P?.created },
    { key: "lastModified", label: "Last modified", dataType: "text", renderer: "text", width: "120px", valueAccessor: (row) => row.P?.lastModified },
    { key: "scriptId", label: "Script ID", dataType: "text", renderer: "text", width: "200px", valueAccessor: (row) => row.P?.scriptId, overflowEllipsis: true },
    { key: "isInactive", label: "Inactive", dataType: "text", renderer: "badge", width: "90px", valueAccessor: (row) => (row.P?.isInactive ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "neutral"], no: ["No", "success"] } },
    { key: "recordType", label: "Record type", dataType: "text", renderer: "text", width: "200px", valueAccessor: (row) => row.P?.recordType, overflowEllipsis: true },
    { key: "extraJson", label: "Extra fields", dataType: "text", renderer: "text", width: "240px", valueAccessor: (row) => row.P?.extraJson || row.P?.rawJson || "", overflowEllipsis: true }
  ],
  rowHeight: 80,
  showSelection: true,
  resizableColumns: true,
  columnWidths: { __selection: "36px", __rowNumber: "36px" },
  enableLocalFilters: true,
  enableLocalSort: true,
  usePolarisUI: true,
  sidebar: {
    enabled: true,
    parentVertexLabel: "NetSuiteExtendFileCategory",
    toParentEdgeType: "ExtendFileCategory",
    rootKeys: {},
