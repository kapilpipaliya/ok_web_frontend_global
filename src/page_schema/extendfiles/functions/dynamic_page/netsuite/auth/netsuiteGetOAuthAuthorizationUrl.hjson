{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: netsuiteGetOAuthAuthorizationUrl
        description: Build NetSuite OAuth authorization URL and persist state
        body:
          '''
const readNetSuiteIntegrationFromDb = async (neoSession) => {
  let accountId = "";
  let clientId = "";
  let clientSecret = "";
  let redirectUri = "";
  let scope = "rest_webservices";
  let environment = "production";
  try {
    const r = await neoSession.run(
      `MATCH (s:Setting {type: $t}) RETURN s LIMIT 1`,
      { t: "netsuite_integration" }
    );
    if (r.records.length) {
      const j = args.convertNodeToJson(r.records[0].get("s"));
      const P = j?.P || {};
      accountId = String(P.accountId || "").trim();
      clientId = String(P.clientId || "").trim();
      redirectUri = String(P.redirectUri || "").trim();
      scope = String(P.scope || "rest_webservices").trim();
      environment = String(P.environment || "production").trim().toLowerCase();
      if (P.clientSecret) {
        try {
          clientSecret = args.decryptToken(String(P.clientSecret));
        } catch (e) {
          clientSecret = "";
        }
      }
    }
  } catch (e) {
    console.warn("[netsuiteGetOAuthAuthorizationUrl] readNetSuiteIntegrationFromDb:", e?.message || e);
  }
  return { accountId, clientId, clientSecret, redirectUri, scope, environment };
};

const cfg = await readNetSuiteIntegrationFromDb(args.session);
const accountId = cfg.accountId;
const clientId = cfg.clientId;
const redirectUri = cfg.redirectUri;
const scope = cfg.scope;
const environment = cfg.environment;

if (!accountId || !clientId || !redirectUri) {
  return {
    success: false,
    message:
      "Missing NetSuite OAuth configuration. An administrator must save Account ID, Client ID, and Redirect URI under app Settings."
  };
}

const state = args.crypto.randomBytes(24).toString("hex");
const nowIso = new Date().toISOString();
const expiresAtIso = new Date(Date.now() + 10 * 60 * 1000).toISOString();

await args.session.run(
  `MERGE (s:OAuthState {provider: "netsuite", state: $state})
   SET s.createdAt = datetime($nowIso),
       s.expiresAt = datetime($expiresAtIso),
       s.accountId = $accountId,
       s.environment = $environment`,
  {
    state,
    nowIso,
    expiresAtIso,
    accountId,
    environment
  }
);

const encodedRedirectUri = encodeURIComponent(redirectUri);
const encodedScope = encodeURIComponent(scope);
const encodedState = encodeURIComponent(state);
const baseHost =
  environment === "sandbox"
    ? `${accountId}.app.netsuitesandbox.com`
    : `${accountId}.app.netsuite.com`;
const authorizationUrl =
  `https://${baseHost}/app/login/oauth2/authorize.nl` +
  `?response_type=code&client_id=${encodeURIComponent(clientId)}` +
  `&redirect_uri=${encodedRedirectUri}` +
  `&scope=${encodedScope}` +
  `&state=${encodedState}`;

return {
  success: true,
  data: {
    authorizationUrl,
    state,
    environment,
    accountId
  }
};
'''
      }
    }
  ]
  edges: []
}
