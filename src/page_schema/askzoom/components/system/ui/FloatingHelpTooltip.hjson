'''
        displayOrder: 1
        fns:
          '''
const [isOpen, setIsOpen] = _.createSignal(false);
const [triggerRef, setTriggerRef] = _.createSignal(null);
const [floatingRef, setFloatingRef] = _.createSignal(null);
let cleanup = null;
let hideTimer = null;

const getPlacement = () => c.props?.placement || "top";

const clearHideTimer = () => {
  if (hideTimer != null) {
    clearTimeout(hideTimer);
    hideTimer = null;
  }
};

const tearDownFloating = () => {
  clearHideTimer();
  if (cleanup) {
    cleanup();
    cleanup = null;
  }
};

const setupFloatingUI = async () => {
  const trigger = triggerRef();
  const floating = floatingRef();
  if (!trigger || !floating || !_.floatingUI) return;

  try {
    const { computePosition, flip, shift, offset, autoUpdate } = _.floatingUI;

    const updatePosition = async () => {
      const { x, y } = await computePosition(trigger, floating, {
        placement: getPlacement(),
        strategy: "fixed",
        middleware: [
          offset(6),
          flip(),
          shift({ padding: 8 })
        ]
      });
      Object.assign(floating.style, {
        left: String(x) + "px",
        top: String(y) + "px"
      });
    };

    if (cleanup) {
      cleanup();
      cleanup = null;
    }

    await updatePosition();

    cleanup = autoUpdate(trigger, floating, updatePosition, {
      ancestorScroll: true,
      ancestorResize: true,
      elementResize: true,
      layoutShift: true,
      animationFrame: false
    });
  } catch (e) {
    console.error("FloatingHelpTooltip:", e);
  }
};

const openTooltip = () => {
  clearHideTimer();
  setIsOpen(true);
  requestAnimationFrame(() => setupFloatingUI());
};

const scheduleClose = () => {
  clearHideTimer();
  hideTimer = window.setTimeout(() => {
    setIsOpen(false);
    tearDownFloating();
    hideTimer = null;
  }, 100);
};

return {
  isOpen,
  setTriggerRef,
  setFloatingRef,
  openTooltip,
  scheduleClose,
  clearHideTimer,
  tearDownFloating
};
'''
        componentName: Html
        props:
          '''
const p = c.props || {};
const rawText = p.text;
const textNonEmpty =
  typeof rawText === "string"
    ? rawText.replace(/\\n/g, "\n").trim() !== ""
    : Boolean(rawText);
const hasPolicy = typeof p.policyRows === "function";
const policyCount = hasPolicy ? (p.policyRows() || []).length : 0;
const hasText = textNonEmpty || (hasPolicy && policyCount > 0);
return {
  as: "span",
  hide: p.hide === true || !hasText,
  onCleanup: () => {
    f.tearDownFloating();
  }
};
'''
      }
    }
