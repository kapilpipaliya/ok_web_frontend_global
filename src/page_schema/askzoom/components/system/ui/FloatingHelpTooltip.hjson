        displayOrder: 1
        componentName: Html
        props:
          '''
const p = c.props || {};
const rawText = p.text || "";
const textTrim =
  typeof rawText === "string" &&
  rawText.replace(/\\n/g, "\n").trim() !== "";
const hasPolicy = typeof p.policyRows === "function";
const policyCount = hasPolicy ? (p.policyRows() || []).length : 0;
const hasContent = textTrim || (hasPolicy && policyCount > 0);
const fieldLabel = p.fieldLabel || "";
const aria =
  fieldLabel && hasContent
    ? `Password requirements for ${fieldLabel}`
    : "Help";

return {
  as: "span",
  ref: f.setTriggerRef,
  onMouseEnter: () => f.openTooltip(),
  onMouseLeave: () => f.scheduleClose(),
  hide: !hasContent,
  "aria-label": aria,
  tabIndex: 0
};
'''
      }
    }
