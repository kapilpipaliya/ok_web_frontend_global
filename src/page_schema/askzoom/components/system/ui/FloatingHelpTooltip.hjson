  return {
    as: "icon",
    icon: "ph:question",
    width: 20,
    height: 20,
    hide: true
  };
}
const iconRaw = typeof trig === "function" ? trig() : trig;
const icon = String(iconRaw || "").trim() || "ph:question";
return {
  as: "icon",
  icon,
  width: 20,
  height: 20,
  hide: false
};
'''
