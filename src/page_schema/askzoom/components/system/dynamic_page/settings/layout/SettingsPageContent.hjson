{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: SettingsPageContent
        dynamicComponent: SettingsSectionRenderer, SettingsSaveBar
        fns:
          '''
const getPageConfig = () => f.getEvaluatedSettingsConfig?.() || f.evaluateConfig?.() || null;

const DEFAULT_SITE_LANGUAGES = [
  { code: "en", label: "English", isDefault: true },
  { code: "hi", label: "Hindi", isDefault: false },
  { code: "gu", label: "Gujarati", isDefault: false }
];

const getSiteLanguages = () => {
  const languages = c.props?.siteLanguages;
  if (Array.isArray(languages) && languages.length > 0) return languages;
  return DEFAULT_SITE_LANGUAGES;
};

const getVisibleSections = () => {
  const pageConfig = getPageConfig();
  const sections = pageConfig?.sections;
  if (!Array.isArray(sections)) return [];
  return sections.filter((section) => {
    if (!section.permissions?.anyOf) return true;
    if (_.isNoPermissionCheck === true) return true;
    if (_.hasFullPermission || _.hasEditPermission || _.hasViewPermission) return true;
    return false;
  });
};

const filterSectionsForUrl = () => {
  const urlSection = _.searchParams?.section;
  const sections = getVisibleSections();
  if (urlSection) {
    const matched = sections.filter((section) => section.id === urlSection);
    if (matched.length > 0) return matched;
  }
  return sections;
};

return {
  getPageConfig,
  getVisibleSections,
  filterSectionsForUrl,
  getSiteLanguages
};
'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        css:
          '''
return `._id {
  flex: 1;
  min-width: 0;
  min-height: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}`;
'''
        componentName: Html
        props:
          '''
return {
  as: "main"
};
'''
      }
    }
