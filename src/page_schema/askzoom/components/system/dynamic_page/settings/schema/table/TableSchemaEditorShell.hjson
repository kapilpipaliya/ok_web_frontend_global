{
  vertexes: [
    {
      id: "tses_root",
      L: "Component",
      P: {
        key: "TableSchemaEditorShell",
        description: "Tabbed shell for editing all table schema parts (general, columns, formConfig, sidebar).",
        dynamicComponent: "Button, LoadingSpinner, TableGeneralSchemaEditor, TableColumnsSchemaEditor, TableFormConfigSchemaEditor, TableSidebarSchemaEditor, Html",
        fns: '''
const getProps = () => c.props || {};
const getTableKey = () => {
  const v = getProps().tableKey;
  return v != null && String(v).trim() !== "" ? String(v).trim() : null;
};
const isEmbeddedMode = () => getProps().embeddedMode === true;

const executeYTOFunction = (fn, ctx) =>
  s({ functionName: fn, contextData: ctx || {} });

const TABS = [
  { id: "general", label: "General" },
  { id: "columns", label: "Columns" },
  { id: "formConfig", label: "Form config" },
  { id: "sidebar", label: "Sidebar" }
];

const [loading, setLoading] = _.createSignal(true);
const [tableIds, setTableIds] = _.createSignal(null);
const [activeTab, setActiveTab] = _.createSignal("general");

const loadTableIds = async () => {
  const tableKey = getTableKey();
  if (!tableKey) {
    setTableIds(null);
    setLoading(false);
    return;
  }
  setLoading(true);
  try {
    const result = await executeYTOFunction("getTableIds", { tableKey });
    if (!result?.result?.success) {
      _.showErrorToast?.(result?.result?.message || "Failed to resolve table");
      setTableIds(null);
      return;
    }
    setTableIds(result.result.data);
  } catch (error) {
    _.showErrorToast?.("Failed to resolve table");
    setTableIds(null);
  } finally {
    setLoading(false);
  }
};

const getSchemaKeyForTab = (tabId) => {
  const ids = tableIds();
  return ids?.schemaKeys?.[tabId] || null;
};

const isTabActive = (tabId) => activeTab() === tabId;

const onSaved = () => {
  const cb = getProps().onSaved;
  if (typeof cb === "function") cb();
};

return {
  TABS, loading, tableIds, activeTab, setActiveTab,
  loadTableIds, getTableKey, getSchemaKeyForTab, isTabActive,
  isEmbeddedMode, onSaved
};
'''
      }
    },
    {
      id: "tses_shell",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  onMount: () => { void f.loadTableIds?.(); }
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  height: 100%;
  background: ${t.var.color.background};
}`;
'''
      }
    },
    {
      id: "tses_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''return { as: "header" };''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.625rem 1rem;
  border-bottom: 1px solid ${t.var.color.border};
  background: ${t.var.color.background_light_100};
  flex-shrink: 0;
}`;
'''
      }
    },
    {
      id: "tses_heading",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const ids = f.tableIds?.();
const tableKey = f.getTableKey?.();
return {
  as: "h2",
  text: ids?.name ? `Table schema — ${ids.name}` : `Table schema — ${tableKey || ""}`
};
''',
        css: '''
return `._id {
  margin: 0;
  font-size: 1rem;
  font-weight: 700;
  color: ${t.var.color.text};
}`;
'''
      }
    },
    {
      id: "tses_tabs",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''return { as: "nav" };''',
        css: '''
return `._id {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
}`;
'''
      }
    },
    {
      id: "tses_tab_loop",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "tsesTab",
        loop: true,
        props: '''return { data: f.TABS || [] };'''
      }
    },
    {
      id: "tses_tab_btn",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Button",
        props: '''
const tab = c.tsesTab;
const active = f.isTabActive?.(tab.id);
return {
  variant: active ? "primary" : "secondary",
  size: "sm",
  text: tab.label,
  type: "button",
  onClick: () => f.setActiveTab?.(tab.id)
};
'''
      }
    },
    {
      id: "tses_loading",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "LoadingSpinner",
        props: '''return { hide: f.loading?.() !== true };'''
      }
    },
    {
      id: "tses_content",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: f.loading?.() === true || !f.tableIds?.()
};
''',
        css: '''
return `._id {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}`;
'''
      }
    },
    {
      id: "tses_general_editor",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "TableGeneralSchemaEditor",
        props: '''
return {
  hide: f.isTabActive?.("general") !== true,
  tableKey: f.getTableKey?.(),
  schemaKey: f.getSchemaKeyForTab?.("general"),
  title: "General",
  embeddedMode: f.isEmbeddedMode?.(),
  onSaved: () => f.onSaved?.()
};
'''
      }
    },
    {
      id: "tses_columns_editor",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "TableColumnsSchemaEditor",
        props: '''
return {
  hide: f.isTabActive?.("columns") !== true,
  tableKey: f.getTableKey?.(),
  schemaKey: f.getSchemaKeyForTab?.("columns"),
  title: "Columns",
  onSaved: () => f.onSaved?.()
};
'''
      }
    },
    {
      id: "tses_form_editor",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "TableFormConfigSchemaEditor",
        props: '''
return {
  hide: f.isTabActive?.("formConfig") !== true,
  isOpen: f.isTabActive?.("formConfig") === true,
  tableKey: f.getTableKey?.(),
  schemaKey: f.getSchemaKeyForTab?.("formConfig"),
  title: "Form config",
  embeddedMode: f.isEmbeddedMode?.(),
  siteLanguages: c.props?.siteLanguages,
  onSaved: () => f.onSaved?.()
};
'''
      }
    },
    {
      id: "tses_sidebar_editor",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "TableSidebarSchemaEditor",
        props: '''
return {
  hide: f.isTabActive?.("sidebar") !== true,
  tableKey: f.getTableKey?.(),
  schemaKey: f.getSchemaKeyForTab?.("sidebar"),
  title: "Sidebar",
  siteLanguages: c.props?.siteLanguages,
  onSaved: () => f.onSaved?.()
};
'''
      }
    }
  ],
  edges: [
    { id: "tses_e1", T: "Attr", S: "tses_root", E: "tses_shell" },
    { id: "tses_e2", T: "Attr", S: "tses_shell", E: "tses_header" },
    { id: "tses_e3", T: "Attr", S: "tses_shell", E: "tses_loading" },
    { id: "tses_e4", T: "Attr", S: "tses_shell", E: "tses_content" },
    { id: "tses_e5", T: "Attr", S: "tses_header", E: "tses_heading" },
    { id: "tses_e6", T: "Attr", S: "tses_header", E: "tses_tabs" },
    { id: "tses_e7", T: "Attr", S: "tses_tabs", E: "tses_tab_loop" },
    { id: "tses_e8", T: "Attr", S: "tses_tab_loop", E: "tses_tab_btn" },
    { id: "tses_e9", T: "Attr", S: "tses_content", E: "tses_general_editor" },
    { id: "tses_e10", T: "Attr", S: "tses_content", E: "tses_columns_editor" },
    { id: "tses_e11", T: "Attr", S: "tses_content", E: "tses_form_editor" },
    { id: "tses_e12", T: "Attr", S: "tses_content", E: "tses_sidebar_editor" }
  ]
}
