    {
      id: "16b"
      L: Attr
      P: {
        displayOrder: 14
        componentName: Html
        css: "return `._id { margin-top: 1rem; font-weight: 600; }`;"
        props: "return { as: 'h3', text: 'Recording history (click to cycle)', hide: () => !(f.status()?.recordingHistory || []).length };"
      }
    }
    {
      id: "16c"
      L: Attr
      P: {
        displayOrder: 15
        componentName: Html
        css:
          '''
return `._id {
  margin-top: 0.5rem;
  padding: 0.75rem 1rem;
  border: 1px solid ${t.var.color.border};
  border-radius: 0.5rem;
  white-space: pre-wrap;
  font-size: 0.85rem;
  cursor: pointer;
}`;
'''
        props:
          '''
const history = f.status()?.recordingHistory || [];
const selected = f.selectedRecordingId() || f.status()?.lastRecordingId || '';
const text = history.map((item, index) => {
  const mark = item.id === selected ? '>' : ' ';
  return `${mark} ${index + 1}. ${item.action || 'zoom'} · ${f.formatBytes(item.size || 0)} · ${item.at || '-'} · ${item.id || '-'}`;
}).join('\\n');
return {
  as: 'pre',
  text: text || 'No history',
  title: 'Click to cycle selected recording',
  onClick: () => {
    const list = f.status()?.recordingHistory || [];
    if (!list.length) return;
    const current = f.selectedRecordingId() || list[0].id;
    const idx = Math.max(0, list.findIndex((entry) => entry.id === current));
    const next = list[(idx + 1) % list.length];
    f.setSelectedRecordingId(next.id);
    _.showSuccessToast('Playing ' + (next.action || 'recording'));
  },
  hide: () => !history.length
};
'''
      }
