    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 5
        componentName: Html
        css: "return `._id { font-weight: 600; margin: 1rem 0 0.35rem; display: block; }`;"
        props: "return { as: 'label', text: 'Display name (optional — skipped when logged in)' };"
      }
