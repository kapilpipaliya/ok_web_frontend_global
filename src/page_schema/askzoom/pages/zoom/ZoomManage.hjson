{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        key: ZoomManage
        url: /zoom/manage
        signinRequired: true
        fns:
          '''
const [form, setForm] = _.createStore({
  meetingUrl: '',
  displayName: ''
});
const [busy, setBusy] = _.createSignal(false);
const [status, setStatus] = _.createSignal(null);
const [selectedRecordingId, setSelectedRecordingId] = _.createSignal('');

const loadStatus = async () => {
  const res = await s({ functionName: 'getZoomWorkerStatus', contextData: {} });
  const data = res.result?.data;
  if (res.result?.success && data) {
    const prev = status();
    setStatus(data);
    if (!form.meetingUrl && data.meetingUrl) setForm('meetingUrl', data.meetingUrl);
    if (!form.displayName && data.displayName) setForm('displayName', data.displayName);
    if (!selectedRecordingId() && data.lastRecordingId) setSelectedRecordingId(data.lastRecordingId);
    const event = data?.alertEvent || '';
    if (event && event !== prev?.alertEvent) {
      if (event === 'session_expired') _.showErrorToast(data.message || 'Zoom session expired');
      else if (event === 'manage_stale') _.showErrorToast(data.message || 'Manage session cleared (stale)');
      else if (event === 'manage_error' || event === 'job_error') {
        _.showErrorToast(data.lastError || data.message || 'Zoom manage failed');
      }
      s({ functionName: 'zoomSettingStore', contextData: { action: 'clearAlert' } }).catch(() => {});
    }
  }
};

const runJob = async (action) => {
  setBusy(true);
  try {
    const res = await s({
      functionName: 'enqueueZoomJob',
      contextData: {
        action,
        meetingUrl: form.meetingUrl,
        displayName: form.displayName
      }
    });
    if (res.result?.success) {
      _.showSuccessToast(res.result.message || `${action} queued`);
      await loadStatus();
    } else {
      _.showErrorToast(res.result?.error || res.error || `${action} failed`);
    }
  } finally {
    setBusy(false);
  }
};

let statusTimer = null;
const formatBytes = (bytes) => {
  const n = Number(bytes || 0);
  if (!n) return '0 B';
  if (n < 1024) return `${n} B`;
  if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
  return `${(n / (1024 * 1024)).toFixed(1)} MB`;
};
return {
  form,
  setForm,
  busy,
  status,
  selectedRecordingId,
  setSelectedRecordingId,
  loadStatus,
  formatBytes,
  recordingSrc: () => {
    const current = status();
    const id = selectedRecordingId() || current?.lastRecordingId || '';
    const history = current?.recordingHistory || [];
    const item = history.find((entry) => entry.id === id);
    const stamp = item?.at || current?.lastRecordingAt || '';
    const qs = new URLSearchParams({ t: stamp });
    if (id) qs.set('id', id);
    return current?.hasRecording ? `/api/zoom/recording?${qs.toString()}` : '';
  },
  startManage: () => runJob('manage'),
  leave: () => runJob('leave'),
  cancelJob: () => runJob('cancel'),
  checkSession: () => runJob('checkSession'),
  deleteSelectedRecording: async () => {
    const id = selectedRecordingId() || status()?.lastRecordingId;
    if (!id) {
      _.showErrorToast('No recording selected');
      return;
    }
    setBusy(true);
    try {
      const res = await s({
        functionName: 'deleteZoomRecording',
        contextData: { recordingId: id }
      });
      if (res.result?.success) {
        _.showSuccessToast('Recording deleted');
        setSelectedRecordingId('');
        await loadStatus();
      } else {
        _.showErrorToast(res.result?.error || res.error || 'Delete failed');
      }
    } finally {
      setBusy(false);
    }
  },
  startPolling: () => {
    loadStatus();
    if (statusTimer) clearInterval(statusTimer);
    statusTimer = setInterval(() => loadStatus(), 2500);
  },
  stopPolling: () => {
    if (statusTimer) clearInterval(statusTimer);
    statusTimer = null;
  }
};
'''
        props:
          '''
return {
  isNoPermissionCheck: true,
  onMount: () => f.startPolling(),
  onCleanup: () => f.stopPolling()
};
'''
      }
    }
    {
