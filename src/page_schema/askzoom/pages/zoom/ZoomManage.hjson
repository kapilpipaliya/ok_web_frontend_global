};
'''
      }
    }
    {
      id: "11c"
      L: Attr
      P: {
        displayOrder: 4
        componentName: Button
        props:
          '''
return {
  text: 'Force stop / cancel',
  variant: 'danger',
  disabled: f.busy(),
  onClick: f.cancelJob
};
'''
      }
    }
    {
      id: "12"
      L: Attr
      P: {
        displayOrder: 8
        componentName: Html
        css:
          '''
return `._id {
  margin-top: 1.5rem;
  padding: 1rem;
  border: 1px solid ${t.var.color.border};
  border-radius: 0.5rem;
  white-space: pre-wrap;
  font-size: 0.9rem;
}`;
'''
        props:
          '''
const status = f.status();
const text = status
  ? `Worker: processZoomPlaywright
Phase: ${status.phase || 'idle'}
Message: ${status.message || '-'}
Logged in: ${status.loggedIn ? 'yes' : 'no'}
Managing: ${status.managing ? 'yes' : 'no'}
Admitted clicks: ${status.admittedCount || 0}
Screenshot at: ${status.lastScreenshotAt || '-'}
Recording: ${status.hasRecording
  ? `${status.lastRecordingAction || 'saved'} (${f.formatBytes(status.lastRecordingSize || 0)})`
  : 'none'}
Disk: ${f.formatBytes(status.recordingUsedBytes || 0)} / ${f.formatBytes(status.recordingQuotaBytes || 0)} used (${f.formatBytes(status.recordingRemainingBytes || 0)} free)
Last meeting: ${status.lastMeetingId || '-'} joined ${status.lastMeetingJoinedAt || '-'} left ${status.lastMeetingLeftAt || '-'} admits ${status.lastMeetingAdmittedCount || 0}
Heartbeat: ${status.lastHeartbeatAt || '-'}
Last job: ${status.lastJobMetrics
  ? `${status.lastJobMetrics.action || '-'} ${status.lastJobMetrics.ok === false ? 'fail' : 'ok'} ${status.lastJobMetrics.durationMs || 0}ms admits=${status.lastJobMetrics.admittedCount || 0} rec=${f.formatBytes(status.lastJobMetrics.recordingBytes || 0)} slots=${status.lastJobMetrics.busySlots || 0}/${status.lastJobMetrics.maxSlots || status.runtime?.maxSlots || 0}`
  : '-'}
Record video: ${status.recordVideo === false ? 'off' : 'on'}
Browser busy: ${status.runtime?.busy ? `yes (${status.runtime?.ownerUserId || '-'})` : 'no'} slots ${status.runtime?.busySlots || 0}/${status.runtime?.maxSlots || 0}
Error: ${status.lastError || '-'}
Queue active/waiting/failed: ${status.queueCounts?.active || 0}/${status.queueCounts?.waiting || 0}/${status.queueCounts?.failed || 0}
${status.workerHint || ''}`
  : 'Loading worker status...';
return { as: 'pre', text };
'''
      }
    }
    {
      id: "12b"
      L: Attr
      P: {
        displayOrder: 8.5
        componentName: Html
        css:
          '''
return `._id {
  margin-top: 0.75rem;
  padding: 0.75rem 1rem;
  border: 1px solid ${t.var.color.border};
  border-radius: 0.5rem;
  white-space: pre-wrap;
  font-size: 0.8rem;
  max-height: 12rem;
  overflow: auto;
}`;
'''
        props:
          '''
const logs = f.status()?.workerLogs || [];
const text = logs.length
  ? logs.map((entry) => `${entry.level || 'info'}: ${entry.message || ''}`).join('\\n')
  : 'No worker logs yet';
return { as: 'pre', text };
'''
      }
    }
