        props:
          '''
const status = f.status();
return {
  as: 'h2',
  text: status?.hasRecording
    ? `Playwright recording (${status.lastRecordingAction || 'last run'} · ${f.formatBytes(status.lastRecordingSize || 0)})`
    : 'Playwright recording',
  hide: () => !f.status()?.hasRecording
};
'''
      }
    }
    {
      id: "15b"
      L: Attr
      P: {
        displayOrder: 12
        componentName: Button
        props:
          '''
const status = f.status();
return {
  text: 'Download recording',
  variant: 'secondary',
  hide: () => !status?.hasRecording,
  onClick: () => {
    const stamp = status?.lastRecordingAt || '';
    const id = status?.lastRecordingId || '';
    const qs = new URLSearchParams({ download: '1', t: stamp });
    if (id) qs.set('id', id);
    window.open(`/api/zoom/recording?${qs.toString()}`, '_blank');
  }
};
'''
      }
    }
    {
      id: "16"
      L: Attr
      P: {
        displayOrder: 13
        componentName: Html
        css:
          '''
return `._id {
  margin-top: 0.75rem;
  width: 100%;
  max-width: 880px;
  border: 1px solid ${t.var.color.border};
  border-radius: 0.5rem;
  background: ${t.var.color.background_light_100};
}`;
'''
        props:
          '''
const status = f.status();
const stamp = status?.lastRecordingAt || '';
const id = status?.lastRecordingId || '';
const qs = new URLSearchParams({ t: stamp });
if (id) qs.set('id', id);
return {
  as: 'video',
  src: status?.hasRecording ? `/api/zoom/recording?${qs.toString()}` : '',
  controls: true,
  playsinline: true,
  hide: () => !f.status()?.hasRecording
};
'''
      }
    }
    {
      id: "16b"
      L: Attr
      P: {
        displayOrder: 14
        componentName: Html
        css: "return `._id { margin-top: 1rem; font-weight: 600; }`;"
        props: "return { as: 'h3', text: 'Recording history', hide: () => !(f.status()?.recordingHistory || []).length };"
      }
    }
    {
      id: "16c"
      L: Attr
      P: {
        displayOrder: 15
        componentName: Html
        css:
          '''
return `._id {
  margin-top: 0.5rem;
  padding: 0.75rem 1rem;
  border: 1px solid ${t.var.color.border};
  border-radius: 0.5rem;
  white-space: pre-wrap;
  font-size: 0.85rem;
}`;
'''
        props:
          '''
const history = f.status()?.recordingHistory || [];
const text = history.map((item, index) => {
  const label = item.action || 'zoom';
  const when = item.at || '-';
  const size = f.formatBytes(item.size || 0);
  return `${index + 1}. ${label} · ${size} · ${when} · id=${item.id || '-'}`;
}).join('\\n');
return {
  as: 'pre',
  text: text || 'No history',
  hide: () => !history.length
};
'''
      }
