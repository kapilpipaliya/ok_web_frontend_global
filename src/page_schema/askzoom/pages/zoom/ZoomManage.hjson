{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        key: ZoomManage
        url: /zoom/manage
        signinRequired: true
        fns:
          '''
const [form, setForm] = _.createStore({
  meetingUrl: '',
  displayName: ''
});
const [busy, setBusy] = _.createSignal(false);
const [status, setStatus] = _.createSignal(null);

const loadStatus = async () => {
  const res = await s({ functionName: 'getZoomWorkerStatus', contextData: {} });
  const data = res.result?.data;
  if (res.result?.success && data) {
    setStatus(data);
    if (!form.meetingUrl && data.meetingUrl) setForm('meetingUrl', data.meetingUrl);
    if (!form.displayName && data.displayName) setForm('displayName', data.displayName);
  }
};

const runJob = async (action) => {
  setBusy(true);
  try {
    const res = await s({
      functionName: 'enqueueZoomJob',
      contextData: {
        action,
        meetingUrl: form.meetingUrl,
        displayName: form.displayName
      }
    });
    if (res.result?.success) {
      _.showSuccessToast(res.result.message || `${action} queued`);
      await loadStatus();
    } else {
      _.showErrorToast(res.result?.error || res.error || `${action} failed`);
    }
  } finally {
    setBusy(false);
  }
};

let statusTimer = null;
const formatBytes = (bytes) => {
  const n = Number(bytes || 0);
  if (!n) return '0 B';
  if (n < 1024) return `${n} B`;
  if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
  return `${(n / (1024 * 1024)).toFixed(1)} MB`;
};
return {
  form,
  setForm,
  busy,
  status,
  loadStatus,
  formatBytes,
  startManage: () => runJob('manage'),
  leave: () => runJob('leave'),
  startPolling: () => {
    loadStatus();
    if (statusTimer) clearInterval(statusTimer);
    statusTimer = setInterval(() => loadStatus(), 2500);
  },
  stopPolling: () => {
    if (statusTimer) clearInterval(statusTimer);
    statusTimer = null;
  }
};
'''
        props:
          '''
return {
  isNoPermissionCheck: true,
  onMount: () => f.startPolling(),
  onCleanup: () => f.stopPolling()
};
'''
      }
    }
