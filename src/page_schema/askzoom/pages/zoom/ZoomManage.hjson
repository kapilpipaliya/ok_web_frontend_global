        componentName: Button
        props:
          '''
return {
  text: f.busy() ? 'Queueing...' : 'Start managing',
  loading: f.busy(),
  disabled: f.busy() || (f.status()?.managing && !f.status()?.leaveRequested && f.status()?.phase !== 'leaving'),
  onClick: f.startManage
};
'''
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        displayOrder: 2
