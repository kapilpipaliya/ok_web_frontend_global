        props:
          '''
const status = f.status();
const text = status
  ? `Worker: processZoomPlaywright
Phase: ${status.phase || 'idle'}
Message: ${status.message || '-'}
Logged in: ${status.loggedIn ? 'yes' : 'no'}
Managing: ${status.managing ? 'yes' : 'no'}
Admitted clicks: ${status.admittedCount || 0}
Screenshot at: ${status.lastScreenshotAt || '-'}
Recording: ${status.hasRecording
  ? `${status.lastRecordingAction || 'saved'} (${f.formatBytes(status.lastRecordingSize || 0)})`
  : 'none'}
Error: ${status.lastError || '-'}
Queue active/waiting/failed: ${status.queueCounts?.active || 0}/${status.queueCounts?.waiting || 0}/${status.queueCounts?.failed || 0}
${status.workerHint || ''}`
  : 'Loading worker status...';
return { as: 'pre', text };
'''
      }
    }
