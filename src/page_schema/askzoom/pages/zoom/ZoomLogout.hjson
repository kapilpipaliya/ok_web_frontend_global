{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        key: ZoomLogout
        url: /zoom/logout
        signinRequired: true
        fns:
          '''
const [busy, setBusy] = _.createSignal(false);
const [status, setStatus] = _.createSignal(null);

const loadStatus = async () => {
  const res = await s({ functionName: 'getZoomWorkerStatus', contextData: {} });
  if (res.result?.success) setStatus(res.result.data);
};

const logout = async () => {
  setBusy(true);
  try {
    const res = await s({
      functionName: 'enqueueZoomJob',
      contextData: { action: 'logout' }
    });
    if (res.result?.success) {
      _.showSuccessToast(res.result.message || 'Logout queued');
      await loadStatus();
    } else {
      _.showErrorToast(res.result?.error || res.error || 'Logout queue failed');
    }
  } finally {
    setBusy(false);
  }
};

let statusTimer = null;
const formatBytes = (bytes) => {
  const n = Number(bytes || 0);
  if (!n) return '0 B';
  if (n < 1024) return `${n} B`;
  if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
  return `${(n / (1024 * 1024)).toFixed(1)} MB`;
};
return {
  busy,
  status,
  loadStatus,
  logout,
  formatBytes,
  startPolling: () => {
    loadStatus();
    if (statusTimer) clearInterval(statusTimer);
    statusTimer = setInterval(() => loadStatus(), 2500);
  },
  stopPolling: () => {
    if (statusTimer) clearInterval(statusTimer);
    statusTimer = null;
  }
};
'''
        props:
          '''
return {
  isNoPermissionCheck: true,
  onMount: () => f.startPolling(),
  onCleanup: () => f.stopPolling()
};
'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props: "return { as: 'div' };"
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        css: "return `._id { font-size: 1.75rem; font-weight: 700; margin: 0 0 0.5rem; }`;"
        props: "return { as: 'h1', text: 'Zoom logout' };"
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        css: "return `._id { color: ${t.var.color.text_light_400}; margin: 0 0 1.25rem; line-height: 1.5; }`;"
        props: "return { as: 'p', text: 'Queues Playwright to sign out of Zoom and clears the saved login session on ZoomUserSetting.' };"
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Button
        props:
          '''
return {
  text: f.busy() ? 'Queueing...' : 'Logout with Playwright',
  variant: 'danger',
  loading: f.busy(),
  disabled: f.busy() || !f.status()?.loggedIn,
  onClick: f.logout
};
'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 4
        componentName: Html
        css:
          '''
return `._id {
  margin-top: 1.5rem;
  padding: 1rem;
  border: 1px solid ${t.var.color.border};
  border-radius: 0.5rem;
  white-space: pre-wrap;
  font-size: 0.9rem;
}`;
'''
        props:
          '''
const status = f.status();
const text = status
  ? `Phase: ${status.phase || 'idle'}
Message: ${status.message || '-'}
Logged in: ${status.loggedIn ? 'yes' : 'no'}
Managing: ${status.managing ? 'yes' : 'no'}
Error: ${status.lastError || '-'}
Recording: ${status.hasRecording
  ? `${status.lastRecordingAction || 'saved'} (${f.formatBytes(status.lastRecordingSize || 0)})`
  : 'none'}
Queue active/waiting: ${status.queueCounts?.active || 0}/${status.queueCounts?.waiting || 0}`
  : 'Loading status...';
return { as: 'pre', text };
'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 5
        componentName: Html
        css: "return `._id { margin-top: 1.25rem; font-weight: 600; }`;"
        props:
          '''
const status = f.status();
return {
  as: 'h2',
  text: status?.hasRecording
    ? `Playwright recording (${status.lastRecordingAction || 'last run'} · ${f.formatBytes(status.lastRecordingSize || 0)})`
    : 'Playwright recording',
  hide: () => !f.status()?.hasRecording
};
'''
      }
    }
    {
      id: "7b"
      L: Attr
      P: {
        displayOrder: 6
        componentName: Button
        props:
          '''
const status = f.status();
return {
  text: 'Download recording',
  variant: 'secondary',
  hide: () => !status?.hasRecording,
  onClick: () => {
    const stamp = status?.lastRecordingAt || '';
    const id = status?.lastRecordingId || '';
    const qs = new URLSearchParams({ download: '1', t: stamp });
    if (id) qs.set('id', id);
    window.open(`/api/zoom/recording?${qs.toString()}`, '_blank');
  }
};
'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        displayOrder: 7
        componentName: Html
        css:
          '''
return `._id {
  margin-top: 0.75rem;
  width: 100%;
  max-width: 880px;
  border: 1px solid ${t.var.color.border};
  border-radius: 0.5rem;
  background: ${t.var.color.background_light_100};
}`;
'''
        props:
          '''
const status = f.status();
const stamp = status?.lastRecordingAt || '';
const id = status?.lastRecordingId || '';
const qs = new URLSearchParams({ t: stamp });
if (id) qs.set('id', id);
return {
  as: 'video',
  src: status?.hasRecording ? `/api/zoom/recording?${qs.toString()}` : '',
  controls: true,
  playsinline: true,
  hide: () => !f.status()?.hasRecording
};
'''
      }
    }
    {
      id: "8b"
      L: Attr
      P: {
        displayOrder: 8
        componentName: Html
        css: "return `._id { margin-top: 1rem; font-weight: 600; }`;"
        props: "return { as: 'h3', text: 'Recording history', hide: () => !(f.status()?.recordingHistory || []).length };"
      }
    }
    {
      id: "8c"
      L: Attr
      P: {
        displayOrder: 9
        componentName: Html
        css:
          '''
return `._id {
  margin-top: 0.5rem;
  padding: 0.75rem 1rem;
  border: 1px solid ${t.var.color.border};
  border-radius: 0.5rem;
  white-space: pre-wrap;
  font-size: 0.85rem;
}`;
'''
        props:
          '''
const history = f.status()?.recordingHistory || [];
const text = history.map((item, index) => {
  const label = item.action || 'zoom';
  const when = item.at || '-';
  const size = f.formatBytes(item.size || 0);
  return `${index + 1}. ${label} · ${size} · ${when} · id=${item.id || '-'}`;
}).join('\\n');
return {
  as: 'pre',
  text: text || 'No history',
  hide: () => !history.length
};
'''
      }
    }
    {
      id: "layout"
      L: PageLayout
      P: {
        componentName: ZoomLayout
        displayOrder: 1
      }
    }
