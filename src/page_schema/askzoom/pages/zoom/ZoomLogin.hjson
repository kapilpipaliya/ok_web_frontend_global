{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        key: ZoomLogin
        url: /zoom/login
        signinRequired: true
        fns:
          '''
const [busy, setBusy] = _.createSignal(false);
const [transferBusy, setTransferBusy] = _.createSignal(false);
const [status, setStatus] = _.createSignal(null);
const [importJson, setImportJson] = _.createSignal('');
const [selectedRecordingId, setSelectedRecordingId] = _.createSignal('');

const loadStatus = async () => {
  const res = await s({ functionName: 'getZoomWorkerStatus', contextData: {} });
  if (res.result?.success) {
    const data = res.result.data;
    const prev = status();
    setStatus(data);
    if (!selectedRecordingId() && data?.lastRecordingId) {
      setSelectedRecordingId(data.lastRecordingId);
    }
    const event = data?.alertEvent || '';
    if (event && event !== prev?.alertEvent) {
      if (event === 'session_expired') _.showErrorToast(data.message || 'Zoom session expired');
      else if (event === 'manage_error' || event === 'job_error' || event === 'login_failed') {
        _.showErrorToast(data.lastError || data.message || 'Zoom job failed');
      } else if (event === 'logged_in') {
        _.showSuccessToast(data.message || 'Logged in');
      }
      s({ functionName: 'zoomSettingStore', contextData: { action: 'clearAlert' } }).catch(() => {});
    }
  }
};

const login = async () => {
  setBusy(true);
  try {
    const res = await s({
      functionName: 'enqueueZoomJob',
      contextData: { action: 'login' }
    });
    if (res.result?.success) {
      _.showSuccessToast(res.result.message || 'Login queued');
      await loadStatus();
    } else {
      _.showErrorToast(res.result?.error || res.error || 'Login queue failed');
    }
  } finally {
    setBusy(false);
  }
};

const cancelJob = async () => {
  setBusy(true);
  try {
    const res = await s({
      functionName: 'enqueueZoomJob',
      contextData: { action: 'cancel' }
    });
    if (res.result?.success) {
      _.showSuccessToast(res.result.message || 'Cancel requested');
      await loadStatus();
    } else {
      _.showErrorToast(res.result?.error || res.error || 'Cancel failed');
    }
  } finally {
    setBusy(false);
  }
};

const deleteSelectedRecording = async () => {
  const id = selectedRecordingId() || status()?.lastRecordingId;
  if (!id) {
    _.showErrorToast('No recording selected');
    return;
  }
  setTransferBusy(true);
  try {
    const res = await s({
      functionName: 'deleteZoomRecording',
      contextData: { recordingId: id }
    });
    if (res.result?.success) {
      _.showSuccessToast('Recording deleted');
      setSelectedRecordingId('');
      await loadStatus();
    } else {
      _.showErrorToast(res.result?.error || res.error || 'Delete failed');
    }
  } finally {
    setTransferBusy(false);
  }
};

const downloadText = (text, fileName) => {
  const blob = new Blob([text], { type: 'application/json;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = fileName || 'askzoom-session.json';
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
};

const exportSession = async () => {
  setTransferBusy(true);
  try {
    const res = await s({ functionName: 'exportZoomSession', contextData: {} });
    if (!res.result?.success) {
      _.showErrorToast(res.result?.error || res.error || 'Export failed');
      return;
    }
    const data = res.result.data || {};
    downloadText(data.json || JSON.stringify(data.payload, null, 2), data.fileName);
    _.showSuccessToast(res.result.message || 'Session exported');
  } finally {
    setTransferBusy(false);
  }
};

const importSession = async () => {
  const json = String(importJson() || '').trim();
  if (!json) {
    _.showErrorToast('Paste an exported session JSON first');
    return;
  }
  setTransferBusy(true);
  try {
    const res = await s({
      functionName: 'importZoomSession',
      contextData: { json }
    });
    if (res.result?.success) {
      setImportJson('');
      _.showSuccessToast(res.result.message || 'Session imported');
      await loadStatus();
    } else {
      _.showErrorToast(res.result?.error || res.error || 'Import failed');
    }
  } finally {
    setTransferBusy(false);
  }
};

const onImportFile = async (event) => {
  const file = event?.target?.files?.[0];
  if (!file) return;
  try {
    const text = await file.text();
    setImportJson(text);
    _.showSuccessToast(`Loaded ${file.name}`);
  } catch (error) {
    _.showErrorToast(error?.message || 'Could not read file');
  } finally {
    if (event?.target) event.target.value = '';
  }
};

let statusTimer = null;
const formatBytes = (bytes) => {
  const n = Number(bytes || 0);
  if (!n) return '0 B';
  if (n < 1024) return `${n} B`;
  if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
  return `${(n / (1024 * 1024)).toFixed(1)} MB`;
};
return {
  busy,
  transferBusy,
  status,
  importJson,
  setImportJson,
  selectedRecordingId,
  setSelectedRecordingId,
  loadStatus,
  login,
  cancelJob,
  deleteSelectedRecording,
  exportSession,
  importSession,
  onImportFile,
  formatBytes,
  recordingSrc: () => {
    const current = status();
    const history = current?.recordingHistory || [];
    const id = selectedRecordingId() || current?.lastRecordingId || '';
    const item = history.find((entry) => entry.id === id);
    const stamp = item?.at || current?.lastRecordingAt || '';
    const qs = new URLSearchParams({ t: stamp });
    if (id) qs.set('id', id);
    return current?.hasRecording ? `/api/zoom/recording?${qs.toString()}` : '';
  },
  startPolling: () => {
    loadStatus();
    if (statusTimer) clearInterval(statusTimer);
    statusTimer = setInterval(() => loadStatus(), 2500);
  },
  stopPolling: () => {
    if (statusTimer) clearInterval(statusTimer);
    statusTimer = null;
  }
};
'''
        props:
          '''
return {
  isNoPermissionCheck: true,
  onMount: () => f.startPolling(),
  onCleanup: () => f.stopPolling()
};
'''
