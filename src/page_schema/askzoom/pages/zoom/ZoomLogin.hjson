        props:
          '''
const status = f.status();
const stamp = status?.lastRecordingAt || '';
return {
  as: 'video',
  src: status?.hasRecording ? `/api/zoom/recording?t=${encodeURIComponent(stamp)}` : '',
  controls: true,
  playsinline: true,
  hide: () => !f.status()?.hasRecording
};
'''
      }
