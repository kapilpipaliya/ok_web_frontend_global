        props:
          '''
const status = f.status();
const text = status
  ? `Phase: ${status.phase || 'idle'}
Logged in: ${status.loggedIn ? 'yes' : 'no'}
Managing: ${status.managing ? 'yes' : 'no'}
Queue active/waiting: ${status.queueCounts?.active || 0}/${status.queueCounts?.waiting || 0}
Cluster: acq ${status.clusterMetrics?.acquireOk || 0}/${status.clusterMetrics?.acquireFail || 0} reclaim ${status.clusterMetrics?.reclaimOk || 0}/${status.clusterMetrics?.reclaimFail || 0} ctrl ok/timeout/fail ${status.clusterMetrics?.publishAndWaitOk || 0}/${status.clusterMetrics?.publishAndWaitTimeout || 0}/${status.clusterMetrics?.publishAndWaitFail || 0}
${status.workerHint || ''}`
  : 'Loading worker status...';
return { as: 'pre', text };
'''
      }
