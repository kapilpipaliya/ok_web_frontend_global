{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        key: ZoomCredentials
        url: /zoom/credentials
        signinRequired: true
        fns:
          '''
const [form, setForm] = _.createStore({
  email: '',
  password: '',
  meetingPassword: '',
  displayName: '',
  meetingUrl: '',
  recordVideo: true
});
const [busy, setBusy] = _.createSignal(false);
const [status, setStatus] = _.createSignal(null);
const [meta, setMeta] = _.createSignal({ hasPassword: false, hasMeetingPassword: false });

const load = async () => {
  const res = await s({ functionName: 'getZoomSettings', contextData: {} });
  const data = res.result?.data;
  if (res.result?.success && data) {
    setForm({
      email: data.email || '',
      password: '',
      meetingPassword: '',
      displayName: data.displayName || '',
      meetingUrl: data.meetingUrl || '',
      recordVideo: data.recordVideo !== false
    });
    setMeta({
      hasPassword: !!data.hasPassword,
      hasMeetingPassword: !!data.hasMeetingPassword
    });
  }
};

const save = async () => {
  setBusy(true);
  try {
    const res = await s({
      functionName: 'saveZoomCredentials',
      contextData: {
        email: form.email,
        password: form.password,
        meetingPassword: form.meetingPassword,
        displayName: form.displayName,
        meetingUrl: form.meetingUrl,
        recordVideo: form.recordVideo === true
      }
    });
    if (res.result?.success) {
      setForm('password', '');
      setForm('meetingPassword', '');
      _.showSuccessToast(res.result.message || 'Saved');
      await load();
    } else {
      _.showErrorToast(res.result?.error || res.error || 'Save failed');
    }
  } finally {
    setBusy(false);
  }
};

const loadStatus = async () => {
  const res = await s({ functionName: 'getZoomWorkerStatus', contextData: {} });
  if (res.result?.success) setStatus(res.result.data);
};

return { form, setForm, busy, save, load, status, loadStatus, meta };
'''
        props:
          '''
return {
  isNoPermissionCheck: true,
  onMount: () => {
    f.load();
    f.loadStatus();
  }
};
'''
      }
