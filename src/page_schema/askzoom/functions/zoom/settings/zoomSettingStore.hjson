{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: zoomSettingStore
        description: Read and write per-user Zoom credentials, session, and worker status on ZoomUserSetting
        body:
          '''
const action = c.action || 'get';
const HISTORY_LIMIT = 5;

const encryptSecret = (value) => {
  if (!value) return '';
  try {
    return _.encryptToken(value);
  } catch (error) {
    return `plain:${value}`;
  }
};

const decryptSecret = (value) => {
  if (!value) return '';
  if (String(value).startsWith('plain:')) return String(value).slice(6);
  try {
    return _.decryptToken(value);
  } catch (error) {
    return '';
  }
};

const parseHistory = (raw) => {
  try {
    const parsed = typeof raw === 'string' ? JSON.parse(raw || '[]') : raw;
    return Array.isArray(parsed) ? parsed : [];
  } catch (error) {
    return [];
  }
};

const resolveOwnerUserId = async () => {
  if (c.userId) return String(c.userId).trim();
  try {
    const user = await _.getUserFromSession();
    if (user?.P?.uuid) return String(user.P.uuid).trim();
  } catch (error) {
    // worker / no HTTP session
  }
  return '';
};

const ensureUserSetting = async (session, userId) => {
  const result = await session.run(`
    MATCH (u:User {uuid: $userId})
    MERGE (u)-[:HasZoomSetting]->(z:ZoomUserSetting)
    ON CREATE SET z.createdAt = datetime()
    SET z.updatedAt = datetime()
    RETURN z
  `, { userId });
  const node = result.records[0]?.get('z');
  if (!node) {
    throw new Error('User not found for Zoom settings');
  }
  return _.convertNodeToJson(node);
};

const OWNER_MATCH = `MATCH (u:User {uuid: $userId})-[:HasZoomSetting]->(z:ZoomUserSetting)`;

const fileSizeIfExists = (filePath) => {
  try {
    if (!filePath || !_.fs.existsSync(filePath)) return 0;
    return Number(_.fs.statSync(filePath).size || 0);
  } catch (error) {
    return 0;
  }
};

const buildPublicData = (p, { includeScreenshot = false, userId = '' } = {}) => {
  const history = parseHistory(p.zoomRecordingHistoryJson)
    .filter((item) => item && item.path)
    .map((item) => ({
      id: item.id || '',
      action: item.action || '',
      at: item.at || '',
      size: Number(item.size || 0),
      path: item.path
    }))
    .filter((item) => item.size > 0 || fileSizeIfExists(item.path) > 0);

  const lastPath = p.zoomLastRecordingPath || history[0]?.path || '';
  const lastSize = Number(p.zoomLastRecordingSize || 0) || fileSizeIfExists(lastPath) || history[0]?.size || 0;
  const hasRecording = lastSize > 0 && !!lastPath;

  const usedBytes = history.reduce((sum, item) => sum + Number(item.size || 0), 0);
  const quotaBytes = Number(process.env.ZOOM_PW_RECORDING_QUOTA_MB || 10240) * 1024 * 1024;
  let meetingAudit = [];
  try {
    const parsed = JSON.parse(p.zoomMeetingAuditJson || '[]');
    meetingAudit = Array.isArray(parsed) ? parsed.slice(0, 20) : [];
  } catch (error) {
    meetingAudit = [];
  }

  return {
    userId: userId || '',
    email: p.zoomEmail || '',
    hasPassword: !!p.zoomPasswordEncrypted,
    hasMeetingPassword: !!p.zoomMeetingPasswordEncrypted,
    displayName: p.zoomDisplayName || '',
    meetingUrl: p.zoomMeetingUrl || '',
    loggedIn: p.zoomLoggedIn === true || p.zoomLoggedIn === 'true',
    managing: p.zoomManaging === true || p.zoomManaging === 'true',
    leaveRequested: p.zoomLeaveRequested === true || p.zoomLeaveRequested === 'true',
    cancelRequested: p.zoomCancelRequested === true || p.zoomCancelRequested === 'true',
    recordVideo: p.zoomRecordVideo !== false && p.zoomRecordVideo !== 'false',
    phase: p.zoomPhase || 'idle',
    message: p.zoomMessage || '',
    lastError: p.zoomLastError || '',
    alertEvent: p.zoomAlertEvent || '',
    lastScreenshot: includeScreenshot ? (p.zoomLastScreenshot || '') : '',
    lastScreenshotAt: p.zoomLastScreenshotAt || '',
    hasRecording,
    lastRecordingAt: p.zoomLastRecordingAt || history[0]?.at || '',
    lastRecordingAction: p.zoomLastRecordingAction || history[0]?.action || '',
    lastRecordingPath: hasRecording ? lastPath : '',
    lastRecordingSize: hasRecording ? lastSize : 0,
    lastRecordingId: hasRecording ? (p.zoomLastRecordingId || history[0]?.id || '') : '',
    recordingHistory: history.slice(0, HISTORY_LIMIT).map(({ path, ...rest }) => rest),
    recordingQuotaBytes: quotaBytes,
    recordingUsedBytes: usedBytes,
    recordingRemainingBytes: Math.max(0, quotaBytes - usedBytes),
    admittedCount: Number(p.zoomAdmittedCount || 0),
    lastMeetingId: p.zoomLastMeetingId || '',
    lastMeetingJoinedAt: p.zoomLastMeetingJoinedAt || '',
    lastMeetingLeftAt: p.zoomLastMeetingLeftAt || '',
    lastMeetingAdmittedCount: Number(p.zoomLastMeetingAdmittedCount || 0),
    meetingAudit,
    lastHeartbeatAt: p.zoomLastHeartbeatAt || '',
    autoManageEnabled: p.zoomAutoManageEnabled === true || p.zoomAutoManageEnabled === 'true',
    autoManageTime: p.zoomAutoManageTime || '09:00',
    autoManageTimezone: p.zoomAutoManageTimezone || 'UTC',
    autoManageDays: (() => {
      try {
        const parsed = JSON.parse(p.zoomAutoManageDaysJson || '[0,1,2,3,4,5,6]');
        return Array.isArray(parsed) ? parsed.map((d) => Number(d)).filter((d) => d >= 0 && d <= 6) : [0, 1, 2, 3, 4, 5, 6];
      } catch (error) {
        return [0, 1, 2, 3, 4, 5, 6];
      }
    })(),
    autoManageLastTriggeredAt: p.zoomAutoManageLastTriggeredAt || '',
    autoManageLastTriggeredDate: p.zoomAutoManageLastTriggeredDate || '',
    autoManageLastTriggeredTime: p.zoomAutoManageLastTriggeredTime || '',
    autoManageLastTickAt: p.zoomAutoManageLastTickAt || '',
    autoManageLastTickReason: p.zoomAutoManageLastTickReason || '',
    autoManageLastTickDetail: (() => {
      try {
        return JSON.parse(p.zoomAutoManageLastTickDetailJson || 'null');
      } catch (error) {
        return null;
      }
    })(),
    lastJobMetrics: (() => {
      try {
        const parsed = JSON.parse(p.zoomLastJobMetricsJson || 'null');
        return parsed && typeof parsed === 'object' ? parsed : null;
      } catch (error) {
        return null;
      }
    })(),
    hasSession: !!p.zoomStorageState,
    updatedAt: p.zoomUpdatedAt || p.updatedAt || ''
  };
};

if (action === 'listAutoManageCandidates') {
  const result = await _.session.run(`
    MATCH (u:User)-[:HasZoomSetting]->(z:ZoomUserSetting)
    WHERE z.zoomAutoManageEnabled = true OR z.zoomAutoManageEnabled = 'true'
    RETURN u.uuid AS userId, z
  `);
  const rows = result.records.map((record) => {
    const node = _.convertNodeToJson(record.get('z'));
    const p = node?.P || {};
    return {
      userId: String(record.get('userId') || '').trim(),
      settings: buildPublicData(p, { userId: String(record.get('userId') || '').trim() })
    };
  }).filter((row) => row.userId);
  return { success: true, data: { candidates: rows } };
}

const ownerUserId = await resolveOwnerUserId();
if (!ownerUserId) {
  return { success: false, error: 'Sign in required for Zoom settings' };
}

const setting = await ensureUserSetting(_.session, ownerUserId);
const p = setting?.P || {};

if (action === 'get') {
  return {
    success: true,
    data: buildPublicData(p, {
      includeScreenshot: c.includeScreenshot === true,
      userId: ownerUserId
    })
  };
}

if (action === 'getSecrets') {
  return {
    success: true,
    data: {
      userId: ownerUserId,
      email: p.zoomEmail || '',
      password: decryptSecret(p.zoomPasswordEncrypted),
      meetingPassword: decryptSecret(p.zoomMeetingPasswordEncrypted),
      displayName: p.zoomDisplayName || '',
      meetingUrl: p.zoomMeetingUrl || '',
      storageState: p.zoomStorageState || '',
      leaveRequested: p.zoomLeaveRequested === true || p.zoomLeaveRequested === 'true',
      cancelRequested: p.zoomCancelRequested === true || p.zoomCancelRequested === 'true',
      recordVideo: p.zoomRecordVideo !== false && p.zoomRecordVideo !== 'false'
    }
  };
}

if (action === 'saveCredentials') {
  const email = String(c.email || '').trim();
  const password = c.password;
  const meetingPassword = c.meetingPassword;
  const displayName = String(c.displayName || '').trim();
  const meetingUrl = String(c.meetingUrl || '').trim();

  if (!email) {
    return { success: false, error: 'Zoom email is required' };
  }

  const sets = [
    'z.zoomEmail = $email',
    'z.zoomDisplayName = $displayName',
    'z.zoomMeetingUrl = $meetingUrl',
    'z.updatedAt = datetime()'
  ];
  const params = { userId: ownerUserId, email, displayName, meetingUrl };

  if (c.recordVideo !== undefined) {
    sets.push('z.zoomRecordVideo = $recordVideo');
    params.recordVideo = c.recordVideo === true;
  }

  if (password !== undefined && password !== null && String(password).length > 0) {
    sets.push('z.zoomPasswordEncrypted = $passwordEncrypted');
    params.passwordEncrypted = encryptSecret(String(password));
  }

  if (meetingPassword !== undefined && meetingPassword !== null) {
    sets.push('z.zoomMeetingPasswordEncrypted = $meetingPasswordEncrypted');
    params.meetingPasswordEncrypted = String(meetingPassword).length > 0
      ? encryptSecret(String(meetingPassword))
      : '';
  }

  await _.session.run(`
    ${OWNER_MATCH}
    SET ${sets.join(', ')}
    RETURN z
  `, params);

  return { success: true, message: 'Zoom credentials saved' };
}

if (action === 'saveSession') {
  await _.session.run(`
    ${OWNER_MATCH}
    SET z.zoomStorageState = $storageState,
        z.zoomLoggedIn = $loggedIn,
        z.updatedAt = datetime()
    RETURN z
  `, {
    userId: ownerUserId,
    storageState: c.storageState || '',
    loggedIn: c.loggedIn === true
  });
  return { success: true };
}

if (action === 'saveStatus') {
  let historyJson = undefined;
  if (c.recordingHistory !== undefined) {
    historyJson = JSON.stringify(
      (Array.isArray(c.recordingHistory) ? c.recordingHistory : [])
        .slice(0, HISTORY_LIMIT)
    );
  } else if (c.lastRecordingPath && Number(c.lastRecordingSize || 0) > 0) {
    const current = parseHistory(p.zoomRecordingHistoryJson);
    const entry = {
      id: c.lastRecordingId || `rec_${Date.now()}`,
      path: c.lastRecordingPath,
      action: c.lastRecordingAction || '',
      at: c.lastRecordingAt || new Date().toISOString(),
      size: Number(c.lastRecordingSize || 0)
    };
    historyJson = JSON.stringify(
      [entry, ...current.filter((item) => item.path !== entry.path)].slice(0, HISTORY_LIMIT)
    );
  }

  let meetingAuditJson = undefined;
  if (c.appendMeetingAudit === true) {
    let audit = [];
    try {
      audit = JSON.parse(p.zoomMeetingAuditJson || '[]');
      if (!Array.isArray(audit)) audit = [];
    } catch (error) {
      audit = [];
    }
    const entry = {
      meetingId: c.lastMeetingId || p.zoomLastMeetingId || '',
      joinedAt: c.lastMeetingJoinedAt || p.zoomLastMeetingJoinedAt || '',
      leftAt: c.lastMeetingLeftAt || new Date().toISOString(),
      admittedCount: Number(
        c.lastMeetingAdmittedCount !== undefined
          ? c.lastMeetingAdmittedCount
          : (c.admittedCount !== undefined ? c.admittedCount : p.zoomAdmittedCount || 0)
      )
    };
    meetingAuditJson = JSON.stringify([entry, ...audit].slice(0, 20));
  }

  const fields = {
    zoomPhase: c.phase,
    zoomMessage: c.message,
    zoomLastError: c.lastError,
    zoomAlertEvent: c.alertEvent,
    zoomManaging: c.managing,
    zoomLeaveRequested: c.leaveRequested,
    zoomCancelRequested: c.cancelRequested,
    zoomLoggedIn: c.loggedIn,
    zoomRecordVideo: c.recordVideo,
    zoomLastScreenshot: c.lastScreenshot,
    zoomLastScreenshotAt: c.lastScreenshotAt,
    zoomHasRecording: c.hasRecording,
    zoomLastRecordingAt: c.lastRecordingAt,
    zoomLastRecordingAction: c.lastRecordingAction,
    zoomLastRecordingPath: c.lastRecordingPath,
    zoomLastRecordingSize: c.lastRecordingSize,
    zoomLastRecordingId: c.lastRecordingId,
    zoomRecordingHistoryJson: historyJson,
    zoomAdmittedCount: c.admittedCount,
    zoomLastMeetingId: c.lastMeetingId,
    zoomLastMeetingJoinedAt: c.lastMeetingJoinedAt,
    zoomLastMeetingLeftAt: c.lastMeetingLeftAt,
    zoomLastMeetingAdmittedCount: c.lastMeetingAdmittedCount,
    zoomMeetingAuditJson: meetingAuditJson,
    zoomLastHeartbeatAt: c.lastHeartbeatAt,
    zoomLastJobMetricsJson: c.lastJobMetrics !== undefined
      ? JSON.stringify(c.lastJobMetrics || null)
      : undefined,
    zoomAutoManageLastTickAt: c.autoManageLastTickAt,
    zoomAutoManageLastTickReason: c.autoManageLastTickReason,
    zoomAutoManageLastTickDetailJson: c.autoManageLastTickDetail !== undefined
      ? (typeof c.autoManageLastTickDetail === 'string'
        ? c.autoManageLastTickDetail
        : JSON.stringify(c.autoManageLastTickDetail || null))
      : undefined
  };

  const sets = ['z.updatedAt = datetime()'];
  const params = { userId: ownerUserId };
  for (const [key, value] of Object.entries(fields)) {
    if (value === undefined) continue;
    sets.push(`z.${key} = $${key}`);
    params[key] = value;
  }

  await _.session.run(`
    ${OWNER_MATCH}
    SET ${sets.join(', ')}
    RETURN z
  `, params);

  return { success: true };
}

if (action === 'requestLeave') {
  await _.session.run(`
    ${OWNER_MATCH}
    SET z.zoomLeaveRequested = true,
        z.zoomManaging = false,
        z.zoomPhase = 'leaving',
        z.zoomMessage = 'Leaving meeting...',
        z.updatedAt = datetime()
    RETURN z
  `, { userId: ownerUserId });
  return { success: true, message: 'Leave requested. Session will stay logged in.' };
}

if (action === 'requestCancel') {
  await _.session.run(`
    ${OWNER_MATCH}
    SET z.zoomCancelRequested = true,
        z.zoomLeaveRequested = true,
        z.zoomManaging = false,
        z.zoomPhase = 'cancelling',
        z.zoomMessage = 'Cancel requested...',
        z.updatedAt = datetime()
    RETURN z
  `, { userId: ownerUserId });
  return { success: true, message: 'Cancel requested' };
}

if (action === 'clearCancel') {
  await _.session.run(`
    ${OWNER_MATCH}
    SET z.zoomCancelRequested = false,
        z.updatedAt = datetime()
    RETURN z
  `, { userId: ownerUserId });
  return { success: true };
}

if (action === 'resetIdle') {
  await _.session.run(`
    ${OWNER_MATCH}
    SET z.zoomPhase = 'idle',
        z.zoomMessage = $message,
        z.zoomManaging = false,
        z.zoomLeaveRequested = false,
        z.zoomCancelRequested = false,
        z.zoomLastError = '',
        z.updatedAt = datetime()
    RETURN z
  `, {
    userId: ownerUserId,
    message: String(c.message || 'Ready')
  });
  return { success: true, message: 'Reset to idle' };
}

if (action === 'setPreferences') {
  if (c.recordVideo === undefined) {
    return { success: false, error: 'recordVideo is required' };
  }
  await _.session.run(`
    ${OWNER_MATCH}
    SET z.zoomRecordVideo = $recordVideo,
        z.updatedAt = datetime()
    RETURN z
  `, {
    userId: ownerUserId,
    recordVideo: c.recordVideo === true
  });
  return { success: true, message: 'Preferences saved', data: { recordVideo: c.recordVideo === true } };
}

if (action === 'clearSession') {
  await _.session.run(`
    ${OWNER_MATCH}
    SET z.zoomStorageState = '',
        z.zoomLoggedIn = false,
        z.zoomManaging = false,
        z.zoomLeaveRequested = false,
        z.zoomPhase = 'logged_out',
        z.zoomMessage = 'Logged out',
        z.zoomLastScreenshot = '',
        z.updatedAt = datetime()
    RETURN z
  `, { userId: ownerUserId });
  return { success: true };
}

if (action === 'getRecordingPath') {
  const data = buildPublicData(p, { userId: ownerUserId });
  const recordingId = String(c.recordingId || '').trim();
  const history = parseHistory(p.zoomRecordingHistoryJson);
  let item = null;
  if (recordingId) {
    item = history.find((entry) => entry.id === recordingId) || null;
  }
  if (!item && data.lastRecordingPath) {
    item = {
      id: data.lastRecordingId,
      path: data.lastRecordingPath,
      action: data.lastRecordingAction,
      at: data.lastRecordingAt,
      size: data.lastRecordingSize
    };
  }
  if (!item?.path || !(Number(item.size || 0) > 0 || fileSizeIfExists(item.path) > 0)) {
    return { success: false, error: 'No Playwright recording found' };
  }
  return {
    success: true,
    data: {
      path: item.path,
      action: item.action || '',
      at: item.at || '',
      size: Number(item.size || fileSizeIfExists(item.path) || 0),
      id: item.id || ''
    }
  };
}

if (action === 'deleteRecording') {
  const recordingId = String(c.recordingId || '').trim();
  if (!recordingId) return { success: false, error: 'recordingId is required' };
  const history = parseHistory(p.zoomRecordingHistoryJson);
  const item = history.find((entry) => entry.id === recordingId);
  if (!item) return { success: false, error: 'Recording not found' };
  if (item.path) {
    try { _.fs.unlinkSync(item.path); } catch (error) {}
  }
  const next = history.filter((entry) => entry.id !== recordingId);
  const top = next[0];
  await _.session.run(`
    ${OWNER_MATCH}
    SET z.zoomRecordingHistoryJson = $historyJson,
        z.zoomHasRecording = $hasRecording,
        z.zoomLastRecordingPath = $lastRecordingPath,
        z.zoomLastRecordingSize = $lastRecordingSize,
        z.zoomLastRecordingAt = $lastRecordingAt,
        z.zoomLastRecordingAction = $lastRecordingAction,
        z.zoomLastRecordingId = $lastRecordingId,
        z.updatedAt = datetime()
    RETURN z
  `, {
    userId: ownerUserId,
    historyJson: JSON.stringify(next),
    hasRecording: !!top,
    lastRecordingPath: top?.path || '',
    lastRecordingSize: Number(top?.size || 0),
    lastRecordingAt: top?.at || '',
    lastRecordingAction: top?.action || '',
    lastRecordingId: top?.id || ''
  });
  return {
    success: true,
    message: 'Recording deleted',
    data: buildPublicData(
      {
        ...p,
        zoomRecordingHistoryJson: JSON.stringify(next),
        zoomHasRecording: !!top,
        zoomLastRecordingPath: top?.path || '',
        zoomLastRecordingSize: Number(top?.size || 0),
        zoomLastRecordingAt: top?.at || '',
        zoomLastRecordingAction: top?.action || '',
        zoomLastRecordingId: top?.id || ''
      },
      { userId: ownerUserId }
    )
  };
}

if (action === 'clearAlert') {
  await _.session.run(`
    ${OWNER_MATCH}
    SET z.zoomAlertEvent = '',
        z.updatedAt = datetime()
    RETURN z
  `, { userId: ownerUserId });
  return { success: true };
}

if (action === 'saveAutoManageSchedule') {
  const enabled = c.enabled === true;
  const time = String(c.time || '09:00').trim();
  let timezone = String(c.timezone || 'UTC').trim();
  const daysRaw = Array.isArray(c.days) ? c.days : [];

  const TIMEZONE_ALIASES = {
    'Asia/Calcutta': 'Asia/Kolkata',
    'Asia/Katmandu': 'Asia/Kathmandu',
    'Asia/Saigon': 'Asia/Ho_Chi_Minh',
    'Europe/Kiev': 'Europe/Kyiv'
  };
  timezone = TIMEZONE_ALIASES[timezone] || timezone;

  if (!/^\d{2}:\d{2}$/.test(time)) {
    return { success: false, error: 'Time must be HH:mm (24-hour)' };
  }
  const [hh, mm] = time.split(':').map((part) => Number(part));
  if (hh < 0 || hh > 23 || mm < 0 || mm > 59) {
    return { success: false, error: 'Invalid time of day' };
  }

  const validTimezonePattern = /^[A-Za-z]+\/[A-Za-z_]+(?:\/[A-Za-z_]+)?$/;
  if (!validTimezonePattern.test(timezone) && timezone !== 'UTC' && !timezone.startsWith('Etc/')) {
    return { success: false, error: `Invalid timezone: ${timezone}` };
  }

  const days = [...new Set(daysRaw.map((d) => Number(d)).filter((d) => d >= 0 && d <= 6))].sort((a, b) => a - b);
  if (enabled && days.length === 0) {
    return { success: false, error: 'Select at least one day when auto-manage is enabled' };
  }

  const prevDays = (() => {
    try {
      const parsed = JSON.parse(p.zoomAutoManageDaysJson || '[]');
      return Array.isArray(parsed)
        ? [...new Set(parsed.map((d) => Number(d)).filter((d) => d >= 0 && d <= 6))].sort((a, b) => a - b)
        : [];
    } catch (error) {
      return [];
    }
  })();
  const prevEnabled = p.zoomAutoManageEnabled === true || p.zoomAutoManageEnabled === 'true';
  const prevTime = String(p.zoomAutoManageTime || '').trim();
  const prevTimezone = String(p.zoomAutoManageTimezone || '').trim();
  const scheduleChanged =
    prevEnabled !== enabled ||
    prevTime !== time ||
    prevTimezone !== timezone ||
    JSON.stringify(prevDays) !== JSON.stringify(days);

  // Resaving a new time/day/timezone must allow another start today.
  // Otherwise already_triggered_today blocks future times after one run.
  const sets = [
    'z.zoomAutoManageEnabled = $enabled',
    'z.zoomAutoManageTime = $time',
    'z.zoomAutoManageTimezone = $timezone',
    'z.zoomAutoManageDaysJson = $daysJson',
    'z.updatedAt = datetime()'
  ];
  const params = {
    userId: ownerUserId,
    enabled,
    time,
    timezone,
    daysJson: JSON.stringify(days.length ? days : [0, 1, 2, 3, 4, 5, 6])
  };
  if (scheduleChanged) {
    sets.push('z.zoomAutoManageLastTriggeredAt = $lastTriggeredAt');
    sets.push('z.zoomAutoManageLastTriggeredDate = $lastTriggeredDate');
    sets.push('z.zoomAutoManageLastTriggeredTime = $lastTriggeredTime');
    sets.push('z.zoomAutoManageLastTickAt = $lastTickAt');
    sets.push('z.zoomAutoManageLastTickReason = $lastTickReason');
    sets.push('z.zoomAutoManageLastTickDetailJson = $lastTickDetail');
    params.lastTriggeredAt = '';
    params.lastTriggeredDate = '';
    params.lastTriggeredTime = '';
    params.lastTickAt = '';
    params.lastTickReason = '';
    params.lastTickDetail = '';
  }

  await _.session.run(`
    ${OWNER_MATCH}
    SET ${sets.join(', ')}
    RETURN z
  `, params);

  const refreshed = await ensureUserSetting(_.session, ownerUserId);
  return {
    success: true,
    message: enabled
      ? (scheduleChanged
        ? 'Auto-manage schedule saved (will run again at the next matching time)'
        : 'Auto-manage schedule saved')
      : 'Auto-manage disabled',
    data: buildPublicData(refreshed?.P || {}, { userId: ownerUserId })
  };
}

if (action === 'markAutoManageTriggered') {
  const triggeredAt = String(c.triggeredAt || new Date().toISOString());
  const triggeredDate = String(c.triggeredDate || '').trim();
  const triggeredTime = String(c.triggeredTime || '').trim();
  if (!triggeredDate) {
    return { success: false, error: 'triggeredDate is required' };
  }
  await _.session.run(`
    ${OWNER_MATCH}
    SET z.zoomAutoManageLastTriggeredAt = $triggeredAt,
        z.zoomAutoManageLastTriggeredDate = $triggeredDate,
        z.zoomAutoManageLastTriggeredTime = $triggeredTime,
        z.updatedAt = datetime()
    RETURN z
  `, {
    userId: ownerUserId,
    triggeredAt,
    triggeredDate,
    triggeredTime
  });
  return { success: true };
}

return { success: false, error: `Unknown action: ${action}` };
'''
      }
    }
  ]
  edges: []
}
