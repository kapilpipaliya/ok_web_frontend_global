{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: getZoomWorkerStatus
        description: Zoom worker phase, queue counts, session flags, logs, and latest manage screenshot
        body:
          '''
const HEARTBEAT_STALE_MS = Math.max(
  15000,
  Number(process.env.ZOOM_PW_HEARTBEAT_STALE_MS || 90000)
);

const settingsResult = await s({
  functionName: 'zoomSettingStore',
  contextData: { action: 'get', includeScreenshot: true }
});
let settings = settingsResult.result?.data || settingsResult.data || {};
const userId = String(settings.userId || '').trim();

let queueCounts = { waiting: 0, active: 0, delayed: 0, failed: 0, completed: 0 };
try {
  const helpers = await s({
    functionName: 'zoomQueueHelpers',
    contextData: {}
  }, { functionLookupSubDomain: _.subDomain });

  if (helpers.result?.success) {
    const queue = helpers.result.data.createZoomQueue();
    queueCounts = await queue.getJobCounts('waiting', 'active', 'delayed', 'failed', 'completed');
    await queue.close();
  }
} catch (error) {
  // Redis may be down; still return DB status
}

let runtime = {};
const runtimeRes = await s({
  functionName: 'zoomPlaywrightRuntime',
  contextData: { action: 'get', userId }
}, { functionLookupSubDomain: _.subDomain });
if (runtimeRes.error) throw new Error(runtimeRes.error);
runtime = runtimeRes.result?.data || {};

let staleManageRecovered = false;
const looksManaging =
  settings.managing === true ||
  settings.phase === 'managing' ||
  settings.phase === 'joining';
const lease = userId ? await _.askzoomPlaywright.getLease(userId) : null;
if (userId && looksManaging && !lease) {
  const hbMs = settings.lastHeartbeatAt
    ? Date.parse(settings.lastHeartbeatAt)
    : 0;
  const age = hbMs ? Date.now() - hbMs : Number.POSITIVE_INFINITY;
  if (age > HEARTBEAT_STALE_MS) {
    await s({
      functionName: 'zoomSettingStore',
      contextData: {
        action: 'saveStatus',
        userId,
        managing: false,
        leaveRequested: false,
        phase: 'idle',
        message: 'Manage session cleared (stale heartbeat / worker restart)',
        alertEvent: 'manage_stale',
        lastHeartbeatAt: ''
      }
    }, { functionLookupSubDomain: _.subDomain });
    staleManageRecovered = true;
    const refreshed = await s({
      functionName: 'zoomSettingStore',
      contextData: { action: 'get', includeScreenshot: true, userId }
    });
    if (refreshed?.result?.data) settings = refreshed.result.data;
  }
}

const clusterSlots = await _.askzoomPlaywright.listClusterSlots();

let workerLogs = [];
try {
  const logResult = await _.session.run(`
    MATCH (log:WorkerLog {workerName: 'processZoomPlaywright'})
    RETURN log
    ORDER BY log.createdAt DESC
    LIMIT 80
  `);
  workerLogs = logResult.records
    .map((record) => {
      const node = record.get('log');
      const vertex = node ? _.convertNodeToJson(node) : null;
      const p = vertex?.P || {};
      let metadata = {};
      try {
        metadata = typeof p.metadata === 'string' ? JSON.parse(p.metadata || '{}') : (p.metadata || {});
      } catch (error) {
        metadata = {};
      }
      return {
        level: p.level || 'info',
        message: p.message || '',
        createdAt: p.createdAt || '',
        metadata
      };
    })
    .filter((entry) => {
      if (!userId) return true;
      const metaUser = String(entry.metadata?.userId || '');
      return !metaUser || metaUser === userId;
    })
    .slice(0, 30);
} catch (error) {
  workerLogs = [];
}

const metricsLog = workerLogs.find((entry) =>
  String(entry.message || '').startsWith('Zoom job metrics:')
);

return {
  success: true,
  data: {
    ...settings,
    staleManageRecovered,
    heartbeatStaleMs: HEARTBEAT_STALE_MS,
    queueCounts,
    runtime: {
      busy: !!(runtime.busy || lease),
      ownerUserId: runtime.ownerUserId || lease?.userId || '',
      jobAction: runtime.jobAction || lease?.jobAction || '',
      hasBrowser: !!runtime.hasBrowser || !!lease,
      managing: !!runtime.managing || !!lease?.managing,
      busySlots: Number(
        runtime.busySlots != null ? runtime.busySlots : clusterSlots.length
      ),
      maxSlots: Number(runtime.maxSlots || 0),
      nodeId: runtime.nodeId || _.askzoomPlaywright.nodeId(),
      leaseNodeId: runtime.leaseNodeId || lease?.nodeId || '',
      leaseLocal:
        runtime.leaseLocal === true ||
        (lease ? _.askzoomPlaywright.isLeaseOwner(lease) : false),
      clusterSlots
    },
    lastMetricsFromLog: metricsLog?.metadata || null,
    workerLogs,
    workerKey: 'processZoomPlaywright',
    workerHint: 'Start processZoomPlaywright from Worker Management so Playwright runs in a background worker.'
  }
};
'''
      }
    }
  ]
  edges: []
}
