{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: processZoomPlaywright
        description: Background worker that runs Playwright Zoom jobs via small action functions
        body:
          '''
if (c.action !== 'start') {
  return { success: false, error: 'Use action start to run this worker' };
}

const logMessage = async (level, message, metadata = {}) => {
  try {
    await s({
      functionName: 'logWorkerMessage',
      contextData: {
        workerName: 'processZoomPlaywright',
        level,
        message,
        metadata
      }
    }, { functionLookupSubDomain: _.subDomain });
  } catch (error) {
    console.error('[processZoomPlaywright] log failed', error);
  }
};

await logMessage('info', 'Starting Zoom Playwright worker');

const helpers = await s({
  functionName: 'zoomQueueHelpers',
  contextData: {}
}, { functionLookupSubDomain: _.subDomain });

if (!helpers.result?.success) {
  await logMessage('error', 'Failed to initialize Zoom queue helpers', { error: helpers.result?.error });
  throw new Error('Queue helpers initialization failed');
}

const { Worker } = _.bullmq;
const connection = helpers.result.data.getRedisConnection();
const queueName = helpers.result.data.QUEUE_NAME;

const runAction = async (functionName, contextData = {}) => {
  const res = await s({
    functionName,
    contextData
  }, { functionLookupSubDomain: _.subDomain });
  if (res.error) throw new Error(res.error);
  if (res.result?.success === false) {
    throw new Error(res.result.error || `${functionName} failed`);
  }
  return res.result || res;
};

const notifyWebhook = async (payload) => {
  const url = String(process.env.ZOOM_PW_WEBHOOK_URL || '').trim();
  if (!url) return;
  try {
    await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        source: 'askzoom-playwright',
        subdomain: _.subDomain,
        at: new Date().toISOString(),
        ...payload
      })
    });
  } catch (error) {
    console.warn('[processZoomPlaywright] webhook failed', error.message);
  }
};

let worker;
const concurrency = Math.max(1, Number(process.env.ZOOM_PW_CONCURRENCY || 2));

try {
  worker = new Worker(queueName, async (job) => {
    const action = job.data?.action || job.name;
    const userId = String(job.data?.userId || '').trim();
    if (!userId) throw new Error('Zoom job missing userId');

    await runAction('zoomPlaywrightRuntime', { action: 'setOwnerUserId', userId });
    await logMessage('info', `Zoom job started: ${action}`, { jobId: job.id, userId });
    try {
      if (action === 'cancel') {
        await runAction('zoomPlaywrightRuntime', {
          action: 'forceClose',
          userId,
          phase: 'cancelled',
          message: 'Cancelled by user'
        });
        await s({
          functionName: 'zoomSettingStore',
          contextData: { action: 'clearCancel', userId }
        }, { functionLookupSubDomain: _.subDomain });
      } else if (action === 'login') {
        await runAction('zoomPlaywrightLogin', { userId });
      } else if (action === 'logout') {
        await runAction('zoomPlaywrightLogout', { userId });
      } else if (action === 'checkSession') {
        await runAction('zoomPlaywrightCheckSession', { userId });
      } else if (action === 'manage') {
        await runAction('zoomPlaywrightManage', {
          userId,
          meetingUrl: job.data?.meetingUrl,
          displayName: job.data?.displayName
        });
      } else if (action === 'leave') {
        await runAction('zoomPlaywrightLeave', { userId });
      } else {
        throw new Error(`Unknown Zoom job action: ${action}`);
      }
      if (action === 'checkSession') {
        const snap = await s({
          functionName: 'zoomSettingStore',
          contextData: { action: 'get', userId }
        }, { functionLookupSubDomain: _.subDomain }).catch(() => null);
        if (snap?.result?.data?.alertEvent === 'session_expired') {
          await notifyWebhook({
            event: 'session_expired',
            action,
            userId,
            jobId: job.id
          });
        }
      }
      await logMessage('info', `Zoom job finished: ${action}`, { jobId: job.id, userId });
    } catch (error) {
      const isSessionExpired = /session expired/i.test(error.message || '');
      const alertEvent = isSessionExpired
        ? 'session_expired'
        : (action === 'manage' ? 'manage_error' : 'job_error');
      await s({
        functionName: 'zoomSettingStore',
        contextData: {
          action: 'saveStatus',
          userId,
          phase: isSessionExpired ? 'session_expired' : 'error',
          lastError: error.message,
          message: error.message,
          alertEvent
        }
      }, { functionLookupSubDomain: _.subDomain });
      await notifyWebhook({
        event: alertEvent,
        action,
        userId,
        error: error.message,
        jobId: job.id
      });
      await s({
        functionName: 'zoomPlaywrightRuntime',
        contextData: { action: 'captureScreenshot', userId }
      }, { functionLookupSubDomain: _.subDomain }).catch(() => {});
      await s({
        functionName: 'zoomPlaywrightRuntime',
        contextData: { action: 'close', userId }
      }, { functionLookupSubDomain: _.subDomain }).catch(() => {});
      throw error;
    }
  }, {
    connection,
    concurrency,
    lockDuration: 10 * 60 * 1000
  });

  worker.on('failed', async (job, err) => {
    await logMessage('error', 'Zoom Playwright job failed', {
      jobId: job?.id,
      userId: job?.data?.userId,
      error: err.message
    });
  });

  worker.on('error', async (err) => {
    await logMessage('error', 'Zoom Playwright worker error', { error: err.message });
  });

  await logMessage('info', 'Zoom Playwright worker created', { concurrency });

  return {
    stop: async (force = false) => {
      await logMessage('info', `Stopping Zoom Playwright worker${force ? ' (force)' : ''}`);
      await s({
        functionName: 'zoomPlaywrightRuntime',
        contextData: { action: 'closeAll' }
      }, { functionLookupSubDomain: _.subDomain }).catch(() => {});
      await worker.close(force);
    }
  };
} catch (error) {
  await logMessage('error', 'Failed to create Zoom Playwright worker', { error: error.message });
  if (worker) {
    try { await worker.close(); } catch (closeError) {}
  }
  throw error;
}
'''
      }
    }
  ]
  edges: []
}
