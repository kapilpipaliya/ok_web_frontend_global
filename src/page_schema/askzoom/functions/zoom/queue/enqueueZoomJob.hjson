{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: enqueueZoomJob
        description: Queue a Zoom Playwright job (login, logout, manage, leave, cancel, checkSession)
        body:
          '''
const action = String(c.action || '').trim();
const allowed = ['login', 'logout', 'manage', 'leave', 'cancel', 'checkSession'];

if (!allowed.includes(action)) {
  return { success: false, error: 'action must be login, logout, manage, leave, cancel, or checkSession' };
}

const sessionUser = await _.getUserFromSession();
const userId = String(sessionUser?.P?.uuid || c.userId || '').trim();
if (!userId) {
  return { success: false, error: 'Sign in required to queue Zoom jobs' };
}

const settingsResult = await s({
  functionName: 'zoomSettingStore',
  contextData: { action: 'get', userId }
});
const settings = settingsResult.result?.data || settingsResult.data || {};

const helpers = await s({
  functionName: 'zoomQueueHelpers',
  contextData: {}
}, { functionLookupSubDomain: _.subDomain });
if (!helpers.result?.success) {
  return { success: false, error: helpers.result?.error || 'Failed to initialize Zoom queue' };
}

const pwHelpers = await s({
  functionName: 'zoomPlaywrightHelpers',
  contextData: {}
}, { functionLookupSubDomain: _.subDomain });
const { getLiveSession, resetToIdle, forceStopSession } = pwHelpers.result?.data || {};

const queue = helpers.result.data.createZoomQueue();

const removeUserJobs = async () => {
  const jobs = await queue.getJobs(['active', 'waiting', 'delayed']);
  for (const job of jobs) {
    if (String(job.data?.userId || '') !== userId) continue;
    try { await job.remove(); } catch (error) {}
  }
};

const { live, lease } = await getLiveSession(userId);

// Cancel / leave with no live browser (e.g. after restart) → clear and return
if (action === 'cancel') {
  await removeUserJobs();
  await forceStopSession(userId, 'Ready');
  await queue.close();
  return { success: true, message: 'Stopped. Ready to start again.' };
}

if (action === 'leave' && !live) {
  await removeUserJobs();
  await resetToIdle(userId, 'Ready');
  try { await _.askzoomPlaywright.releaseLease(userId); } catch (e) {}
  await queue.close();
  return { success: true, message: 'No active manage session. Ready.' };
}

if (!lease) {
  await removeUserJobs();
}

const myJobs = await queue.getJobs(['active', 'waiting', 'delayed']);
const mineActive = myJobs.find((job) => {
  if (String(job.data?.userId || '') !== userId) return false;
  const otherAction = String(job.data?.action || job.name || '');
  if (otherAction === 'cancel' || otherAction === action) return false;
  return ['login', 'logout', 'manage', 'checkSession'].includes(otherAction);
});
if (mineActive && action !== 'leave') {
  await queue.close();
  return {
    success: false,
    error: `You already have an active Zoom ${mineActive.data?.action || mineActive.name} job`
  };
}

if ((action === 'login' || action === 'logout' || action === 'manage' || action === 'checkSession') && !settings.email) {
  await queue.close();
  return { success: false, error: 'Save Zoom credentials first' };
}

if (action === 'login' && !settings.hasPassword) {
  await queue.close();
  return { success: false, error: 'Save a Zoom password first' };
}

if ((action === 'logout' || action === 'manage' || action === 'checkSession') && !settings.hasSession && !settings.loggedIn) {
  await queue.close();
  return { success: false, error: 'Not logged in. Run Zoom login first.' };
}

let meetingUrl = String(c.meetingUrl || settings.meetingUrl || '').trim();
if (action === 'manage' && !meetingUrl) {
  await queue.close();
  return { success: false, error: 'Meeting URL is required to start managing' };
}

if (action === 'leave') {
  await s({
    functionName: 'zoomSettingStore',
    contextData: { action: 'requestLeave', userId }
  });
}

if (action === 'manage' || action === 'login' || action === 'checkSession') {
  await s({
    functionName: 'zoomSettingStore',
    contextData: {
      action: 'saveStatus',
      userId,
      phase: 'queued',
      message: `${action} job queued`,
      lastError: '',
      managing: false,
      leaveRequested: false,
      cancelRequested: false
    }
  });
}

const jobId = `zoom-${action}-${userId}`;
const existing = await queue.getJob(jobId);
if (existing) {
  const state = await existing.getState();
  if (state === 'active' || state === 'waiting' || state === 'delayed') {
    if (action === 'leave') {
      await queue.close();
      return { success: true, message: 'Leave requested.' };
    }
    await queue.close();
    return { success: false, error: `A ${action} job is already ${state}` };
  }
  try { await existing.remove(); } catch (error) {}
}

const meetingPassword = c.meetingPassword !== undefined && c.meetingPassword !== null
  ? String(c.meetingPassword)
  : undefined;

const job = await queue.add(
  action,
  {
    action,
    userId,
    meetingUrl,
    displayName: String(c.displayName || settings.displayName || '').trim(),
    ...(meetingPassword !== undefined ? { meetingPassword } : {})
  },
  {
    jobId,
    attempts: 1,
    removeOnComplete: 20,
    removeOnFail: 50
  }
);

await queue.close();

return {
  success: true,
  message: `Queued Zoom ${action}`,
  data: { jobId: job.id, action }
};
'''
      }
    }
  ]
  edges: []
}
