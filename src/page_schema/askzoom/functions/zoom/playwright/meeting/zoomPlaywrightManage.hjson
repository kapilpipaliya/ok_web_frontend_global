{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: zoomPlaywrightManage
        description: Join Zoom meeting and keep admitting waiting-room participants
        body:
          '''
const helpersRes = await s({
  functionName: 'zoomPlaywrightHelpers',
  contextData: {}
}, { functionLookupSubDomain: _.subDomain });
const {
  sleep,
  clickNamed,
  dismissNoise,
  parseMeetingJoinUrl
} = helpersRes.result?.data || {};

const storeRes = await s({
  functionName: 'zoomSettingStore',
  contextData: { action: 'getSecrets', userId: c.userId }
}, { functionLookupSubDomain: _.subDomain });
const secrets = storeRes.result?.data;
const meetingUrl = String(c.meetingUrl || secrets?.meetingUrl || '').trim();
if (!meetingUrl) throw new Error('Meeting URL is required');
if (!secrets?.storageState) throw new Error('Login session missing. Run Zoom login first.');

const { meetingId } = parseMeetingJoinUrl(meetingUrl);
if (!meetingId) throw new Error('Invalid meeting URL or meeting ID');

const userId = String(c.userId || secrets.userId || '').trim();

const assertNotCancelled = async () => {
  const slot = _.askzoomPlaywright.getSlot(userId, { create: false });
  if (slot?.cancelRequested) {
    throw new Error('Cancelled by user');
  }
};

// Redis lease TTL is ~90s (ZOOM_PW_LEASE_TTL_SEC). Join can take minutes
// (waiting room / footer retries) before the manage heartbeat starts — refresh
// during long waits or Redis expires the lease ("lease timeout" / lease_lost).
const keepLeaseAlive = async (jobAction = 'manage') => {
  await assertNotCancelled();
  await _.askzoomPlaywright.refreshLease(userId, {
    jobAction,
    managing: false
  });
};

await s({
  functionName: 'zoomPlaywrightRuntime',
  contextData: { action: 'setJobAction', jobAction: 'manage', userId }
}, { functionLookupSubDomain: _.subDomain });

await s({
  functionName: 'zoomPlaywrightRuntime',
  contextData: { action: 'setAdmittedCount', admittedCount: 0, userId }
}, { functionLookupSubDomain: _.subDomain });

const joinedAt = new Date().toISOString();
await s({
  functionName: 'zoomSettingStore',
  contextData: {
    action: 'saveStatus',
    userId,
    phase: 'joining',
    message: 'Joining Zoom meeting',
    lastError: '',
    managing: false,
    leaveRequested: false,
    admittedCount: 0,
    lastMeetingId: meetingId,
    lastMeetingJoinedAt: joinedAt,
    lastMeetingLeftAt: '',
    alertEvent: ''
  }
}, { functionLookupSubDomain: _.subDomain });

await s({
  functionName: 'zoomPlaywrightRuntime',
  contextData: { action: 'launch', storageState: secrets.storageState, userId }
}, { functionLookupSubDomain: _.subDomain });

const runtime = _.askzoomPlaywright.getSlot(userId);
const page = runtime?.page;
if (!page) throw new Error('Failed to launch Playwright browser');

// Inline session health check on the same browser (no second launch)
await page.goto('https://zoom.us/profile', { waitUntil: 'domcontentloaded', timeout: 45000 });
await sleep(1000);
await assertNotCancelled();
let sessionOk = !/signin|login|signup/i.test(page.url());
if (!sessionOk) {
  await s({
    functionName: 'zoomSettingStore',
    contextData: {
      action: 'saveSession',
      userId,
      storageState: '',
      loggedIn: false
    }
  }, { functionLookupSubDomain: _.subDomain });
  await s({
    functionName: 'zoomSettingStore',
    contextData: {
      action: 'saveStatus',
      userId,
      phase: 'session_expired',
      message: 'Zoom session expired. Run login again.',
      loggedIn: false,
      lastError: 'Session expired',
      alertEvent: 'session_expired'
    }
  }, { functionLookupSubDomain: _.subDomain });
  throw new Error('Zoom session expired. Run login again.');
}

const openWebClientJoin = async (page, meetingId) => {
  const wcUrl = `https://app.zoom.us/wc/join/${meetingId}?ref_from=launch&fromPWA=1&from=join`;
  await page.goto(wcUrl, { waitUntil: 'domcontentloaded', timeout: 60000 });
  await dismissNoise(page);
};

const waitAndClickContinueWithoutMic = async (page, timeoutMs = 5 * 60 * 1000) => {
  const started = Date.now();
  await s({
    functionName: 'zoomSettingStore',
    contextData: {
      action: 'saveStatus',
      phase: 'joining',
      message: 'Waiting for join UI.',
      managing: false
    }
  }, { functionLookupSubDomain: _.subDomain });

  while (Date.now() - started < timeoutMs) {
    await keepLeaseAlive('manage');

    try {
      const webclient = page.locator('#webclient').contentFrame();
      const continueBtn = webclient.getByRole('button', { name: /Continue without microphone/i }).first();
      if (await continueBtn.isVisible({ timeout: 1500 }).catch(() => false)) {
        await continueBtn.click({ timeout: 10000 });
        // Zoom sometimes shows the same control twice.
        await sleep(400);
        const again = webclient.getByRole('button', { name: /Continue without microphone/i }).first();
        if (await again.isVisible({ timeout: 2000 }).catch(() => false)) {
          await again.click({ timeout: 5000 }).catch(() => {});
        }
        return;
      }
    } catch (error) {
      // frame may not be ready yet
    }
    await sleep(1000);
  }

  throw new Error('Timed out waiting for "Continue without microphone".');
};

const continueWithoutMicrophoneAndJoin = async (page, displayName, meetingPassword) => {
  await waitAndClickContinueWithoutMic(page);
  const webclient = page.locator('#webclient').contentFrame();
  await fillDisplayNameAndPassword(webclient, displayName, meetingPassword);

  const joinStarted = Date.now();
  while (Date.now() - joinStarted < 60000) {
    await keepLeaseAlive('manage');
    await dismissNoise(page);
    try {
      const joinBtn = webclient.getByRole('button', { name: 'Join', exact: true }).first();
      if (await joinBtn.isVisible({ timeout: 1500 }).catch(() => false)) {
        await joinBtn.click({ timeout: 10000 });
        return;
      }
    } catch (error) {
      // keep waiting
    }
    await sleep(1000);
  }
  throw new Error('Timed out waiting for Join button after microphone prompt');
};

const fillDisplayNameAndPassword = async (webclient, displayName, meetingPassword) => {
  const name = String(displayName || '').trim();
  const passcode = String(meetingPassword || '').trim();

  if (name) {
    const nameInput = webclient.getByRole('textbox', { name: /name/i }).first();
    if (await nameInput.count()) {
      await nameInput.fill(name).catch(async () => {
        await webclient.locator('input[type="text"]').first().fill(name).catch(() => {});
      });
    } else {
      await webclient.locator('input#input-for-name, input[placeholder*="name" i]').first().fill(name).catch(() => {});
    }
  }

  if (passcode) {
    const passInput = webclient.getByRole('textbox', { name: /passcode|password/i }).first();
    if (await passInput.count()) {
      await passInput.fill(passcode).catch(async () => {
        await webclient.locator('input[type="password"]').first().fill(passcode).catch(() => {});
      });
    } else {
      await webclient.locator('input[type="password"], input[placeholder*="pass" i]').first().fill(passcode).catch(() => {});
    }
  }

  await sleep(300);
};

const dismissRecordingNotice = async (page) => {
  const roots = [page];
  try {
    const webclient = page.locator('#webclient').contentFrame();
    if (webclient) roots.push(webclient);
  } catch (error) {
    // ignore
  }

  for (const root of roots) {
    try {
      const modal = root.locator('.ReactModalPortal, .zm-modal').filter({
        hasText: /This meeting is being recorded/i
      }).first();
      if (!(await modal.count())) continue;
      if (!(await modal.isVisible().catch(() => false))) continue;
      const okBtn = modal.getByRole('button', { name: /^OK$/i }).first();
      if (await okBtn.count()) {
        await okBtn.click({ timeout: 5000 });
        await sleep(300);
        return true;
      }
    } catch (error) {
      // try next root
    }
  }
  return false;
};

const getJoinRoots = (page) => {
  const roots = [page];
  try {
    const webclient = page.locator('#webclient').contentFrame();
    if (webclient) roots.push(webclient);
  } catch (error) {
    // ignore
  }
  return roots;
};

const isWaitingRoomVisible = async (page) => {
  for (const root of getJoinRoots(page)) {
    try {
      const waitingRoom = root.locator('.wr-information, .wr-tip, .wr-loading-icon').first();
      if (await waitingRoom.count() && await waitingRoom.isVisible().catch(() => false)) {
        return true;
      }
      const tip = root.getByText(/We've let them know you're here|Please wait|waiting for the host/i).first();
      if (await tip.count() && await tip.isVisible().catch(() => false)) {
        return true;
      }
    } catch (error) {
      // try next root
    }
  }
  return false;
};

const waitForHostAdmit = async (page, timeoutMs = 10 * 60 * 1000) => {
  const started = Date.now();

  // Waiting room can appear a few seconds after Join.
  for (let i = 0; i < 15; i++) {
    if (await isWaitingRoomVisible(page)) break;
    await sleep(1000);
  }

  if (!(await isWaitingRoomVisible(page))) {
    return true;
  }

  await s({
    functionName: 'zoomSettingStore',
    contextData: {
      action: 'saveStatus',
      phase: 'waiting',
      message: 'In waiting room. Waiting for host to admit...',
      managing: false
    }
  }, { functionLookupSubDomain: _.subDomain });

  while (Date.now() - started < timeoutMs) {
    await keepLeaseAlive('manage');
    if (!(await isWaitingRoomVisible(page))) {
      await sleep(1000);
      if (!(await isWaitingRoomVisible(page))) {
        await s({
          functionName: 'zoomSettingStore',
          contextData: {
            action: 'saveStatus',
            phase: 'joining',
            message: 'Admitted to meeting',
            managing: false
          }
        }, { functionLookupSubDomain: _.subDomain });
        return true;
      }
    }
    await sleep(2000);
  }

  throw new Error('Timed out waiting for host to admit from waiting room');
};

const openParticipants = async (page) => {
  await sleep(2500);
  const webclient = page.locator('#webclient').contentFrame();
  const participantsBtn = webclient.locator('button[aria-label*="open the participants list" i]');
  const box = page.viewportSize() || { width: 1280, height: 720 };
  const maxAttempts = 5;
  // Zoom hides the meeting footer until the mouse is near the bottom.
  // If the mouse drifts away, the button times out — re-move and retry.
  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
    await keepLeaseAlive('manage');
    await page.mouse.move(box.width / 2, box.height - 20);
    await sleep(800);
    try {
      // Single click focuses the footer control; Space opens the participants pane.
      await participantsBtn.click({ timeout: 10000 });
      await participantsBtn.press('Space');
      await sleep(500);
      return;
    } catch (err) {
      if (attempt === maxAttempts) throw err;
      console.log(`openParticipants: click timed out (attempt ${attempt}/${maxAttempts}), re-moving mouse`);
    }
  }
};

const joinMeeting = async (page, meetingId, displayName, meetingPassword) => {
  await openWebClientJoin(page, meetingId);
  await continueWithoutMicrophoneAndJoin(page, displayName, meetingPassword);
  await sleep(1500);
  await waitForHostAdmit(page);
  await dismissRecordingNotice(page);
  await openParticipants(page);
};

const displayName = String(c.displayName || secrets?.displayName || '').trim();
const meetingPassword = String(c.meetingPassword || secrets?.meetingPassword || '').trim();
await joinMeeting(page, meetingId, displayName, meetingPassword);

await s({
  functionName: 'zoomPlaywrightRuntime',
  contextData: { action: 'persistSession', loggedIn: true }
}, { functionLookupSubDomain: _.subDomain });

await s({
  functionName: 'zoomPlaywrightRuntime',
  contextData: { action: 'captureScreenshot' }
}, { functionLookupSubDomain: _.subDomain });

await s({
  functionName: 'zoomSettingStore',
  contextData: {
    action: 'saveStatus',
    userId,
    phase: 'managing',
    message: 'Managing waiting room',
    managing: true,
    loggedIn: true,
    lastMeetingId: meetingId,
    lastMeetingJoinedAt: joinedAt
  }
}, { functionLookupSubDomain: _.subDomain });

const clickAdmitButtons = async () => {
  const admitAll = await clickNamed(page, [/^admit all$/i, /admit all/i]);
  if (admitAll) {
    const bump = await s({
      functionName: 'zoomPlaywrightRuntime',
      contextData: { action: 'bumpAdmitted', userId }
    }, { functionLookupSubDomain: _.subDomain });
    return { kind: 'admit_all', admittedCount: bump.result?.data?.admittedCount };
  }
  const admit = await clickNamed(page, [/^admit$/i]);
  if (admit) {
    const bump = await s({
      functionName: 'zoomPlaywrightRuntime',
      contextData: { action: 'bumpAdmitted', userId }
    }, { functionLookupSubDomain: _.subDomain });
    return { kind: 'admit', admittedCount: bump.result?.data?.admittedCount };
  }
  return null;
};

const isMeetingEndedByHost = async (page) => {
  const roots = [page, ...page.frames()];
  for (const root of roots) {
    try {
      const modal = root.locator(
        '[aria-label="Meeting is end now"], .zm-modal-body-title'
      ).filter({ hasText: /meeting has been ended by host|meeting is end/i }).first();
      if (await modal.count() && await modal.isVisible().catch(() => false)) {
        return true;
      }
      const byText = root.getByText(/This meeting has been ended by host/i).first();
      if (await byText.count() && await byText.isVisible().catch(() => false)) {
        return true;
      }
    } catch (error) {
      // frame may be detached
    }
  }
  return false;
};

const handleMeetingEndedByHost = async () => {
  if (runtime.leaving || runtime.closing) return;
  runtime.leaving = true;
  try {
    await clickNamed(runtime.page, [/^ok$/i]);
    await sleep(500);
    await s({
      functionName: 'zoomPlaywrightRuntime',
      contextData: { action: 'stopManageLoops', userId }
    }, { functionLookupSubDomain: _.subDomain });
    await s({
      functionName: 'zoomPlaywrightRuntime',
      contextData: { action: 'persistSession', loggedIn: true, userId }
    }, { functionLookupSubDomain: _.subDomain });
    await s({
      functionName: 'zoomPlaywrightRuntime',
      contextData: { action: 'close', userId }
    }, { functionLookupSubDomain: _.subDomain });
    const leftAt = new Date().toISOString();
    await s({
      functionName: 'zoomSettingStore',
      contextData: {
        action: 'saveStatus',
        userId,
        phase: 'idle',
        message: 'Meeting ended by host',
        managing: false,
        leaveRequested: false,
        loggedIn: true,
        admittedCount: runtime.admittedCount || 0,
        lastMeetingLeftAt: leftAt,
        lastMeetingAdmittedCount: runtime.admittedCount || 0,
        appendMeetingAudit: true,
        alertEvent: 'meeting_ended'
      }
    }, { functionLookupSubDomain: _.subDomain });
  } finally {
    runtime.leaving = false;
  }
};

await clickAdmitButtons();

await s({
  functionName: 'zoomPlaywrightRuntime',
  contextData: { action: 'stopManageLoops', userId }
}, { functionLookupSubDomain: _.subDomain });

runtime.managing = true;
await s({
  functionName: 'zoomSettingStore',
  contextData: {
    action: 'saveStatus',
    userId,
    phase: 'managing',
    message: 'Managing waiting room',
    managing: true,
    lastHeartbeatAt: new Date().toISOString()
  }
}, { functionLookupSubDomain: _.subDomain });
await _.askzoomPlaywright.refreshLease(userId, {
  jobAction: 'manage',
  managing: true
});
_.askzoomPlaywright.registerControlHandler(userId, async (msg) => {
  const slot = _.askzoomPlaywright.getSlot(userId, { create: false });
  if (msg.type === 'leave') {
    if (slot?.leaving || slot?.closing) return;
    await s({
      functionName: 'zoomPlaywrightLeave',
      contextData: { userId }
    }, { functionLookupSubDomain: _.subDomain });
    return;
  }
  if (msg.type === 'cancel' || msg.type === 'forceClose') {
    if (slot?.closing || slot?.leaving) return;
    await s({
      functionName: 'zoomPlaywrightRuntime',
      contextData: {
        action: 'forceClose',
        userId,
        phase: msg.phase || 'cancelled',
        message: msg.message || 'Cancelled by user',
        localOnly: true
      }
    }, { functionLookupSubDomain: _.subDomain });
  }
});

runtime.manageTimer = setInterval(async () => {
  if (!runtime.managing || !runtime.page) return;
  try {
    await s({
      functionName: 'zoomSettingStore',
      contextData: {
        action: 'saveStatus',
        userId,
        lastHeartbeatAt: new Date().toISOString(),
        managing: true,
        admittedCount: runtime.admittedCount
      }
    }, { functionLookupSubDomain: _.subDomain });
    const refreshed = await _.askzoomPlaywright.refreshLease(userId, {
      jobAction: 'manage',
      managing: true
    });
    if (!refreshed) {
      const lease = await _.askzoomPlaywright.getLease(userId);
      if (!lease || !_.askzoomPlaywright.isLeaseOwner(lease)) {
        _.askzoomPlaywright.emitLeaseRefreshLost({
          userId,
          reason: 'manage heartbeat refresh failed; lease owned elsewhere or missing'
        });
        await s({
          functionName: 'zoomSettingStore',
          contextData: {
            action: 'saveStatus',
            userId,
            managing: false,
            leaveRequested: false,
            phase: 'cancelled',
            message: 'Manage stopped: Playwright lease lost to another worker',
            alertEvent: 'lease_lost',
            lastHeartbeatAt: new Date().toISOString()
          }
        }, { functionLookupSubDomain: _.subDomain });
        await s({
          functionName: 'zoomPlaywrightRuntime',
          contextData: {
            action: 'forceClose',
            userId,
            phase: 'cancelled',
            message: 'Lease lost during manage heartbeat',
            localOnly: true
          }
        }, { functionLookupSubDomain: _.subDomain });
        return;
      }
    }

    if (runtime.cancelRequested) {
      await s({
        functionName: 'zoomPlaywrightRuntime',
        contextData: {
          action: 'forceClose',
          userId,
          phase: 'cancelled',
          message: 'Cancelled by user',
          localOnly: true
        }
      }, { functionLookupSubDomain: _.subDomain });
      return;
    }
    if (runtime.leaving) return;

    if (await isMeetingEndedByHost(runtime.page)) {
      await handleMeetingEndedByHost();
      return;
    }

    await dismissNoise(runtime.page);
    const clicked = await clickAdmitButtons();
    if (clicked) {
      await s({
        functionName: 'zoomSettingStore',
        contextData: {
          action: 'saveStatus',
          userId,
          phase: 'managing',
          message: `Clicked ${clicked.kind}`,
          managing: true,
          admittedCount: clicked.admittedCount,
          lastHeartbeatAt: new Date().toISOString()
        }
      }, { functionLookupSubDomain: _.subDomain });
    }
  } catch (error) {
    console.warn('[zoomPlaywrightManage] Admit loop error', error.message);
  }
}, 4000);

runtime.screenshotTimer = setInterval(async () => {
  if (!runtime.managing) return;
  await s({
    functionName: 'zoomPlaywrightRuntime',
    contextData: { action: 'captureScreenshot', userId }
  }, { functionLookupSubDomain: _.subDomain });
}, 5000);

return { success: true, message: 'Managing Zoom meeting' };
'''
      }
    }
  ]
  edges: []
}
