{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: zoomPlaywrightLogout
        description: Playwright Zoom logout; clears saved session
        body:
          '''
const helpersRes = await s({
  functionName: 'zoomPlaywrightHelpers',
  contextData: {}
}, { functionLookupSubDomain: _.subDomain });
const { sleep } = helpersRes.result?.data || {};

const userId = String(c.userId || '').trim();

const storeRes = await s({
  functionName: 'zoomSettingStore',
  contextData: { action: 'getSecrets', userId }
}, { functionLookupSubDomain: _.subDomain });
const secrets = storeRes.result?.data;
const ownerUserId = String(userId || secrets?.userId || '').trim();
if (!ownerUserId) throw new Error('userId is required for Zoom logout');

await s({
  functionName: 'zoomSettingStore',
  contextData: {
    action: 'saveStatus',
    userId: ownerUserId,
    phase: 'logging_out',
    message: 'Signing out of Zoom',
    managing: false
  }
}, { functionLookupSubDomain: _.subDomain });

await s({
  functionName: 'zoomPlaywrightRuntime',
  contextData: { action: 'setJobAction', jobAction: 'logout', userId: ownerUserId }
}, { functionLookupSubDomain: _.subDomain });

await s({
  functionName: 'zoomPlaywrightRuntime',
  contextData: {
    action: 'launch',
    userId: ownerUserId,
    storageState: secrets?.storageState || ''
  }
}, { functionLookupSubDomain: _.subDomain });

const page = _.askzoomPlaywright.getSlot(ownerUserId)?.page;
if (!page) throw new Error('Failed to launch Playwright browser');

await page.goto('https://zoom.us/myhome', { waitUntil: 'domcontentloaded', timeout: 60000 });
await page.getByRole('button', { name: /profile options/i }).click();
await page.locator('#btnLogout').click();
await sleep(1500);

await s({
  functionName: 'zoomSettingStore',
  contextData: { action: 'clearSession', userId: ownerUserId }
}, { functionLookupSubDomain: _.subDomain });

await s({
  functionName: 'zoomPlaywrightRuntime',
  contextData: { action: 'close', userId: ownerUserId }
}, { functionLookupSubDomain: _.subDomain });

await s({
  functionName: 'zoomSettingStore',
  contextData: {
    action: 'saveStatus',
    userId: ownerUserId,
    phase: 'logged_out',
    message: 'Logged out',
    loggedIn: false,
    managing: false,
    lastError: ''
  }
}, { functionLookupSubDomain: _.subDomain });

return { success: true, message: 'Zoom logout complete' };
'''
      }
    }
  ]
  edges: []
}
