{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: seedTableContent
        description: Seeds default content vertices for a table (generic). Currently supports Book.
        body:
          '''
const { tableVertexLabel, dryRun = false, replaceExisting = false } = c || {};

if (!tableVertexLabel) {
  return { success: false, message: "tableVertexLabel is required" };
}

const SEED_DATA = {
  Book: [
    {
      title: "Atma Siddhi Shastra",
      description: "A profound spiritual text offering deep insights into self-realization and the path to liberation. This masterpiece contains 142 verses that guide seekers on their spiritual journey.",
      language: "English",
      pages: 200,
      price: "Free",
      coverImageUrl: "https://www.fulchandshastri.com/wp-content/uploads/2018/01/Atma-Siddhi-Shastra-Cover-page-Eng-e1548072132279.png",
      originalFileUrl: "https://www.fulchandshastri.com/books/atma-siddhi-shastra-english.pdf"
    },
    {
      title: "आत्मसिद्धि शास्त्र",
      description: "श्रीमद् राजचंद्र द्वारा रचित यह महान ग्रंथ आत्म-साक्षात्कार और मोक्ष के मार्ग को प्रकाशित करता है। १४२ श्लोकों में आध्यात्मिक ज्ञान का सार।",
      language: "Hindi",
      pages: 200,
      price: "Free",
      coverImageUrl: "https://www.fulchandshastri.com/wp-content/uploads/2018/01/Atma-Siddhi-Shastra-Cover-Page-Hin-e1548072172353.jpg",
      originalFileUrl: "https://www.fulchandshastri.com/books/atma-siddhi-shastra-hindi.pdf"
    },
    {
      title: "આત્મસિદ્ધિ શાસ્ત્ર",
      description: "શ્રીમદ્ રાજચંદ્ર દ્વારા રચાયેલ આ મહાન ગ્રંથ આત્મ-સાક્ષાત્કાર અને મોક્ષના માર્ગને પ્રકાશિત કરે છે.",
      language: "Gujarati",
      pages: 200,
      price: "Free",
      coverImageUrl: "https://www.fulchandshastri.com/wp-content/uploads/2018/01/Atma-Siddhi-Shastra-Cover-Page-Guj-e1548072148982.jpg",
      originalFileUrl: "https://www.fulchandshastri.com/books/atma-siddhi-shastra-gujarati.pdf"
    },
    {
      title: "Self Realization - A Deep Study",
      description: "An in-depth exploration of the concept of self-realization, examining various aspects of spiritual awakening and the journey towards enlightenment.",
      language: "English",
      pages: 350,
      price: "Free",
      coverImageUrl: "https://www.fulchandshastri.com/wp-content/uploads/2018/01/21-Self-Realization-A-Deep-Study-e1548072029235.jpg",
      originalFileUrl: "https://www.fulchandshastri.com/books/self-realization-deep-study.pdf"
    },
    {
      title: "ज्ञान से ज्ञायक तक",
      description: "ज्ञान की यात्रा से लेकर ज्ञाता बनने तक का मार्ग। यह पुस्तक साधकों को आत्म-बोध की गहराइयों में ले जाती है।",
      language: "Hindi",
      pages: 280,
      price: "Free",
      coverImageUrl: "https://www.fulchandshastri.com/wp-content/uploads/2018/01/11-Gyaan-se-Gyaayak-tak-e1548071848682.jpg",
      originalFileUrl: "https://www.fulchandshastri.com/books/gyan-se-gyayak-tak.pdf"
    },
    {
      title: "મારણ નો હરણ",
      description: "મૃત્યુના ભયને કેવી રીતે દૂર કરવો અને આત્માની અમરતાને સમજવી તેના પર આધારિત આધ્યાત્મિક માર્ગદર્શન.",
      language: "Gujarati",
      pages: 150,
      price: "Free",
      coverImageUrl: "https://www.fulchandshastri.com/wp-content/uploads/2018/01/14-Maran-ka-Haran-e1548071966275.jpg",
      originalFileUrl: "https://www.fulchandshastri.com/books/maran-no-haran.pdf"
    },
    {
      title: "Multiple Viewpoints on Terrorism",
      description: "A unique spiritual perspective on terrorism and violence, exploring the roots of hatred and the path to universal compassion and understanding.",
      language: "English",
      pages: 180,
      price: "Free",
      coverImageUrl: "https://www.fulchandshastri.com/wp-content/uploads/2018/01/23-Multiple-Viewpoints-on-Terrorism-e1548072092336.jpg",
      originalFileUrl: "https://www.fulchandshastri.com/books/multiple-viewpoints-terrorism.pdf"
    },
    {
      title: "वर्धमान से महावीर",
      description: "भगवान महावीर के जीवन की यात्रा - एक राजकुमार से तीर्थंकर बनने तक की प्रेरणादायक कहानी।",
      language: "Hindi",
      pages: 250,
      price: "Free",
      coverImageUrl: "https://www.fulchandshastri.com/wp-content/uploads/2018/01/16-Vardhamaan-se-Mahavira-e1546934165272.jpg",
      originalFileUrl: "https://www.fulchandshastri.com/books/vardhaman-se-mahavir.pdf"
    }
  ]
};

const rows = SEED_DATA[tableVertexLabel];
if (!Array.isArray(rows)) {
  return { success: false, message: `No seed data defined for table ${tableVertexLabel}` };
}

const countResult = await _.session.run(
  `MATCH (c:${tableVertexLabel}) RETURN count(c) AS cnt`
);
const existingCount = countResult.records[0]?.get("cnt")?.toNumber?.() ?? Number(countResult.records[0]?.get("cnt")) ?? 0;

if (existingCount > 0 && !replaceExisting) {
  return {
    success: true,
    message: `Skipped seed — ${existingCount} ${tableVertexLabel} row(s) already exist`,
    data: { created: 0, skipped: true, existingCount }
  };
}

if (dryRun) {
  return {
    success: true,
    message: `Dry run — would seed ${rows.length} ${tableVertexLabel} row(s)`,
    data: { created: rows.length, dryRun: true }
  };
}

if (replaceExisting && existingCount > 0) {
  await _.session.run(`MATCH (c:${tableVertexLabel}) DETACH DELETE c`);
}

const now = new Date().toISOString();
let created = 0;

for (let i = 0; i < rows.length; i++) {
  const row = rows[i];
  await _.session.run(
    `
    CREATE (c:${tableVertexLabel})
    SET c += $props,
        c.createdAt = $now,
        c.updatedAt = $now
    `,
    {
      props: {
        title: row.title || "",
        description: row.description || "",
        language: row.language || "",
        pages: row.pages ?? null,
        price: row.price || "",
        coverImageUrl: row.coverImageUrl || "",
        originalFileUrl: row.originalFileUrl || ""
      },
      now
    }
  );
  created += 1;
}

return {
  success: true,
  message: `Seeded ${created} ${tableVertexLabel} row(s)`,
  data: { created }
};
'''
      }
    }
  ]
  edges: []
}
