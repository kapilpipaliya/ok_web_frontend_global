const variant = args.contextData.props?.variant || "primary";
const size = args.contextData.props?.size || "medium";
const fullWidth = args.contextData.props?.fullWidth || false;
const text = args.contextData.props?.text || "Button";
const icon = args.contextData.props?.icon;
const onClick = args.contextData.props?.onClick;
const disabled = args.contextData.props?.disabled || false;

return {
