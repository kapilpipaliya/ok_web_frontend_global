{
  vertexes: [
    {
      id: "1",
      L: "Page",
      P: {
        key: "RealAssistantHomePage",
        url: "/",
        title: "RealAssistant - Real Human Help for Real Problems"
      }
    },
    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "userStore",
        fns: '''
const [store, setStore] = args.createStore({
  isLoggedIn: false,
  balance: 0,
  userName: ""
});

return {
  loadUserData: async () => {
    // This would load actual user data from database
    // For now, using demo data
    setStore({
      isLoggedIn: args.userSetting?.isLoggedIn || false,
      balance: args.userSetting?.balance || 0,
      userName: args.userSetting?.userName || ""
    });
  }
};
''',
        props: '''
const fns = args.fns;
// Load user data on mount
if (args.mounted()) {
  fns.loadUserData();
}

return {
  as: "div",
  data: args.contextData.userStore
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${args.theme.var.color.background};
}`;
'''
      }
    },
