{
  vertexes: [
    {
      id: "1",
      L: "Page",
      P: {
        key: "RealAssistantProblemSubmission",
        url: "/problem/new",
        title: "Submit New Problem - RealAssistant"
      }
    },
    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "formStore",
        fns: '''
const [store, setStore] = args.createStore({
  userBalance: 50.00,
  formData: {
    title: "",
    category: "",
    description: "",
    urgency: "normal",
    attachments: [],
    estimatedCost: 0
  },
  categories: [
    { id: "tech", name: "Technology & Computer", basePrice: 8 },
    { id: "education", name: "Education & Learning", basePrice: 10 },
    { id: "business", name: "Business & Finance", basePrice: 12 },
    { id: "personal", name: "Personal & Lifestyle", basePrice: 6 },
    { id: "other", name: "Other", basePrice: 8 }
  ],
  isSubmitting: false,
  errors: {}
});

return {
  calculateEstimate: () => {
    const category = store.categories.find(c => c.id === store.formData.category);
    const basePrice = category?.basePrice || 8;
    const urgencyMultiplier = store.formData.urgency === "urgent" ? 1.5 : 1;
    const estimated = basePrice * urgencyMultiplier;
    setStore("formData", "estimatedCost", estimated);
  },
  
  validateForm: () => {
    const errors = {};
    if (!store.formData.title.trim()) errors.title = "Title is required";
    if (!store.formData.category) errors.category = "Please select a category";
    if (!store.formData.description.trim()) errors.description = "Description is required";
    if (store.formData.description.length < 50) errors.description = "Please provide more details (at least 50 characters)";
    
    setStore("errors", errors);
    return Object.keys(errors).length === 0;
  },
  
  submitProblem: async () => {
    if (!args.fns.validateForm()) return;
    
    setStore("isSubmitting", true);
    
    // Simulate API call
    await new Promise(resolve => setTimeout(resolve, 1500));
    
    args.showSuccessToast("Problem submitted successfully!");
    args.navigate("/dashboard");
  },
  
  updateField: (field, value) => {
    setStore("formData", field, value);
    setStore("errors", field, undefined);
    
    if (field === "category" || field === "urgency") {
      args.fns.calculateEstimate();
    }
  }
};
''',
        props: '''
const fns = args.fns;
if (args.mounted()) {
  fns.calculateEstimate();
}

return {
  as: "div",
  data: args.contextData.formStore
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${args.theme.var.color.background_dark_50};
}`;
'''
      }
    },
