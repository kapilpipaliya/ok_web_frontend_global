      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const showDialog = c.solutionStore?.showMessageDialog;
if (!showDialog) return { as: "span" };

return {
  as: "portal"
};
'''
      }
    },
    {
      id: "61",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      c.solutionStore.setStore("showMessageDialog", false);
    }
  }
};
''',
        css: '''
return `._id {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 1rem;
}`;
'''
      }
    },
