    {
      id: "65",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const newMessage = c.solutionStore?.newMessage || "";
const setStore = c.solutionStore?.setStore;

return {
  as: "textarea",
  placeholder: "Ask for clarification or additional information...",
  value: newMessage,
  onInput: (e) => setStore("newMessage", e.target.value),
  rows: 4
};
''',
        css: '''
return `._id {
  width: 100%;
  padding: 0.75rem;
  border: 1px solid ${t.var.color.border};
  border-radius: 0.5rem;
  font-size: 1rem;
  font-family: inherit;
  background: ${t.var.color.background};
  color: ${t.var.color.text};
  resize: vertical;
  
  &:focus {
    outline: none;
    border-color: ${t.var.color.primary};
  }
  
  &::placeholder {
    color: ${t.var.color.text_light_500};
  }
}`;
'''
      }
    },
