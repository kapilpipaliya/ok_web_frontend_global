{
  vertexes: [
    {
      id: "1",
      L: "Page",
      P: {
        key: "RealAssistantAssistantSolution",
        url: "/assistant/problem/:id",
        title: "Submit Solution - RealAssistant"
      }
    },
    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "solutionStore",
        fns: '''
const [store, setStore] = _.createStore({
  problem: {
    id: "1",
    title: "Help with Excel Formula",
    category: "Technology & Computer",
    description: "I need help creating a complex Excel formula that calculates commission based on multiple tiers. I have a sales spreadsheet where commission rates change based on total sales volume. The tiers are: 0-10k = 5%, 10k-25k = 7%, 25k-50k = 9%, above 50k = 11%. I need a single formula that can calculate the total commission correctly.",
    urgency: "normal",
    submittedAt: "2024-01-15 10:30 AM",
    estimatedEarning: 8.00,
    user: {
      name: "John Doe",
      rating: 4.5,
      problemsSubmitted: 15
    },
    messages: [
      {
        sender: "user",
        text: "I've tried using nested IFs but it's not calculating correctly for the middle tiers.",
        time: "10:35 AM"
      }
    ]
  },
  solution: {
    content: "",
    attachments: []
  },
  isSubmitting: false,
  showMessageDialog: false,
  newMessage: "",
  errors: {}
});

return {
  loadProblemData: async (problemId) => {
    // Load problem data from database
    // For demo, using sample data
  },
  
  updateSolution: (content) => {
    setStore("solution", "content", content);
    setStore("errors", "solution", undefined);
  },
  
  sendMessage: () => {
    if (!store.newMessage.trim()) return;
    
    const message = {
      sender: "assistant",
      text: store.newMessage,
      time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    };
    
    setStore("problem", "messages", msgs => [...msgs, message]);
    setStore("newMessage", "");
    setStore("showMessageDialog", false);
    
    _.showSuccessToast("Message sent to user");
  },
  
  validateSolution: () => {
    const errors = {};
    if (!store.solution.content.trim()) {
      errors.solution = "Please provide a solution";
    }
    if (store.solution.content.length < 50) {
      errors.solution = "Please provide a more detailed solution (at least 50 characters)";
    }
    
    setStore("errors", errors);
    return Object.keys(errors).length === 0;
  },
  
  submitSolution: async () => {
    if (!f.validateSolution()) return;
    
    setStore("isSubmitting", true);
    
    // Submit solution to database
    await new Promise(resolve => setTimeout(resolve, 1500));
    
    _.showSuccessToast("Solution submitted successfully!");
    _.navigate("/assistant/dashboard");
  },
  
  skipProblem: () => {
    if (confirm("Are you sure you want to skip this problem? It will be reassigned to another assistant.")) {
      _.showWarningToast("Problem skipped");
      _.navigate("/assistant/dashboard");
    }
  }
};
''',
        props: '''
const fns = f;
const problemId = _.location.pathname.split("/").pop();

if (_.mounted()) {
  fns.loadProblemData(problemId);
}

return {
  as: "div",
  data: c.solutionStore
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${t.var.color.background_dark_50};
}`;
'''
