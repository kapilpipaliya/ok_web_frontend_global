const updateSolution = c.solutionStore?.fns?.updateSolution;

return {
  as: "textarea",
  placeholder: "Provide a detailed solution to the user's problem. Include step-by-step instructions if applicable.",
  value: content,
  onInput: (e) => updateSolution(e.target.value),
  rows: 10
};
''',
        css: '''
const hasError = c.solutionStore?.errors?.solution;
return `._id {
  padding: 0.75rem;
  border: 1px solid ${hasError ? t.var.color.error : t.var.color.border};
  border-radius: 0.5rem;
  font-size: 1rem;
  font-family: inherit;
  background: ${t.var.color.background};
  color: ${t.var.color.text};
  resize: vertical;
  min-height: 200px;
  transition: border-color 0.2s ease;
  
  &:focus {
    outline: none;
    border-color: ${t.var.color.primary};
  }
  
  &::placeholder {
    color: ${t.var.color.text_light_500};
  }
}`;
'''
