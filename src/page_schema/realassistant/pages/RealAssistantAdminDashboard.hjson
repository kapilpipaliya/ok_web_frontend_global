        displayOrder: 1,
        componentName: "Html",
        props: '''
const problem = args.contextData.problemRows;
const statusColors = {
  pending: { bg: "warning", text: "Pending" },
  in_progress: { bg: "info", text: "In Progress" },
  disputed: { bg: "error", text: "Disputed" }
};
const status = statusColors[problem.status];

return {
  as: "span",
  text: status.text
};
''',
        css: '''
const problem = args.contextData.problemRows;
const statusColors = {
  pending: args.theme.var.color.warning,
  in_progress: args.theme.var.color.info,
  disputed: args.theme.var.color.error
};

return `._id {
  padding: 0.25rem 0.5rem;
  background: ${statusColors[problem.status]}_light_100;
  color: ${statusColors[problem.status]};
  border-radius: 0.25rem;
  font-size: 0.75rem;
  font-weight: 500;
}`;
'''
      }
