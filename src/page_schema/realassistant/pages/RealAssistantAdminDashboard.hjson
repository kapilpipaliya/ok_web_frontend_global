{
  vertexes: [
    {
      id: "1",
      L: "Page",
      P: {
        key: "RealAssistantAdminDashboard",
        url: "/admin",
        title: "Admin Dashboard - RealAssistant"
      }
    },
    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "adminStore",
        fns: '''
const [store, setStore] = args.createStore({
  metrics: {
    totalUsers: 1243,
    activeUsers: 847,
    totalAssistants: 89,
    activeAssistants: 62,
    totalProblems: 4521,
    solvedProblems: 4102,
    pendingProblems: 419,
    totalRevenue: 52840.50,
    monthlyRevenue: 8420.00,
    platformFee: 1684.00
  },
  recentProblems: [],
  topAssistants: [],
  revenueChart: [],
  alerts: []
});

return {
  loadDashboardData: async () => {
    // Load admin dashboard data
    setStore("recentProblems", [
      {
        id: "1",
        title: "Excel Formula Help",
        user: "John Doe",
        assistant: "Sarah K.",
        status: "in_progress",
        value: 8.00,
        createdAt: "10 mins ago"
      },
      {
        id: "2",
        title: "Website Navigation Issue",
        user: "Jane Smith",
        assistant: "Unassigned",
        status: "pending",
        value: 12.00,
        createdAt: "25 mins ago"
      },
      {
        id: "3",
        title: "Tax Calculation Help",
        user: "Bob Wilson",
        assistant: "Mike R.",
        status: "disputed",
        value: 15.00,
        createdAt: "1 hour ago"
      }
    ]);
    
    setStore("topAssistants", [
      {
        id: "1",
        name: "Sarah K.",
        solved: 148,
        rating: 4.8,
        earnings: 1280.00,
        successRate: 94.8
      },
      {
        id: "2",
        name: "Mike R.",
        solved: 132,
        rating: 4.7,
        earnings: 1150.00,
        successRate: 92.3
      },
      {
        id: "3",
        name: "Lisa T.",
        solved: 98,
        rating: 4.9,
        earnings: 890.00,
        successRate: 96.1
      }
    ]);
    
    setStore("revenueChart", [
      { month: "Jan", revenue: 6200, problems: 720 },
      { month: "Feb", revenue: 6800, problems: 810 },
      { month: "Mar", revenue: 7400, problems: 890 },
      { month: "Apr", revenue: 7100, problems: 850 },
      { month: "May", revenue: 8200, problems: 980 },
      { month: "Jun", revenue: 8420, problems: 1010 }
    ]);
    
    setStore("alerts", [
      {
        type: "warning",
        message: "3 problems have been disputed in the last hour",
        time: "5 mins ago"
      },
      {
        type: "info",
        message: "5 new assistants registered today",
        time: "2 hours ago"
      },
      {
        type: "success",
        message: "Platform revenue increased by 15% this month",
        time: "Today"
      }
    ]);
  },
  
  refreshData: () => {
    args.fns.loadDashboardData();
    args.showSuccessToast("Dashboard data refreshed");
  }
};
''',
        props: '''
const fns = args.fns;
if (args.mounted()) {
  fns.loadDashboardData();
}

return {
  as: "div",
  data: args.contextData.adminStore
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${args.theme.var.color.background_dark_50};
}`;
'''
      }
