        componentName: "Html",
        props: '''
const alert = args.contextData.alertItems;
const colors = {
  warning: { bg: "warning_light_100", border: "warning", icon: "warning" },
  info: { bg: "info_light_100", border: "info", icon: "information" },
  success: { bg: "success_light_100", border: "success", icon: "checkmark-filled" }
};
const alertColor = colors[alert.type];

return {
  as: "div"
};
''',
        css: '''
const alert = args.contextData.alertItems;
const colors = {
  warning: args.theme.var.color.warning,
  info: args.theme.var.color.info,
  success: args.theme.var.color.success
};
const alertColor = colors[alert.type];

return `._id {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  background: ${alertColor}_light_50;
  border-left: 4px solid ${alertColor};
  border-radius: 0.5rem;
}`;
'''
      }
    },
