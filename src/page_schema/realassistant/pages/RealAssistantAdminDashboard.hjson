        contextName: "navItems",
        loop: true,
        props: '''
const items = [
  { key: "dashboard", label: "Overview", icon: "carbon:dashboard", path: "/admin" },
  { key: "users", label: "Users", icon: "carbon:user-multiple", path: "/admin/users" },
  { key: "problems", label: "Problems", icon: "carbon:task", path: "/admin/problems" },
  { key: "transactions", label: "Transactions", icon: "carbon:currency", path: "/admin/transactions" },
  { key: "settings", label: "Settings", icon: "carbon:settings", path: "/admin/settings" }
];
return {
  data: items
};
'''
      }
    },
    {
      id: "14",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.navItems;
const isActive = item.key === "dashboard";

return {
  as: "div",
  onClick: () => args.navigate(item.path)
};
''',
        css: '''
const item = args.contextData.navItems;
const isActive = item.key === "dashboard";

return `._id {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 1rem 0;
  border-bottom: 2px solid ${isActive ? args.theme.var.color.primary : "transparent"};
  color: ${isActive ? args.theme.var.color.primary : args.theme.var.color.muted};
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s ease;
  
  &:hover {
    color: ${args.theme.var.color.primary};
  }
}`;
'''
