{
  vertexes: [
    {
      id: "1",
      L: "Page",
      P: {
        key: "RealAssistantUserDashboard",
        url: "/dashboard",
        title: "Dashboard - RealAssistant"
      }
    },
    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "userStore",
        fns: '''
const [store, setStore] = _.createStore({
  isLoggedIn: true,
  balance: 45.50,
  userName: "John Doe",
  activeProblems: [],
  recentTransactions: [],
  stats: {
    totalProblems: 0,
    solvedProblems: 0,
    pendingProblems: 0,
    totalSpent: 0
  }
});

return {
  loadDashboardData: async () => {
    // Load user data from database
    // For demo, using sample data
    setStore({
      activeProblems: [
        {
          id: "1",
          title: "Help with Excel Formula",
          status: "in_progress",
          assignedTo: "Sarah K.",
          createdAt: "2024-01-15",
          estimatedCost: 5.00
        },
        {
          id: "2",
          title: "Website Navigation Issue",
          status: "pending",
          assignedTo: null,
          createdAt: "2024-01-16",
          estimatedCost: 8.00
        }
      ],
      recentTransactions: [
        {
          id: "t1",
          type: "payment",
          amount: -12.00,
          description: "Solution: Tax Form Help",
          date: "2024-01-14"
        },
        {
          id: "t2",
          type: "recharge",
          amount: 50.00,
          description: "Balance Recharge",
          date: "2024-01-10"
        }
      ],
      stats: {
        totalProblems: 15,
        solvedProblems: 13,
        pendingProblems: 2,
        totalSpent: 125.50
      }
    });
  }
};
''',
        props: '''
const fns = f;
if (_.mounted()) {
  fns.loadDashboardData();
}

return {
  as: "div",
  data: c.userStore
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${t.var.color.background_dark_50};
}`;
'''
      }
    },
