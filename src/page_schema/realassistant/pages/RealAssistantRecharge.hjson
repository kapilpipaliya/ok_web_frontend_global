{
  vertexes: [
    {
      id: "1",
      L: "Page",
      P: {
        key: "RealAssistantRecharge",
        url: "/recharge",
        title: "Recharge Balance - RealAssistant"
      }
    },
    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "rechargeStore",
        fns: '''
const [store, setStore] = args.createStore({
  currentBalance: 45.50,
  selectedAmount: 0,
  customAmount: "",
  paymentMethod: "",
  rechargeOptions: [
    { amount: 10, bonus: 0 },
    { amount: 25, bonus: 2 },
    { amount: 50, bonus: 5 },
    { amount: 100, bonus: 15 },
    { amount: 200, bonus: 40 }
  ],
  paymentMethods: [
    { id: "card", name: "Credit/Debit Card", icon: "carbon:credit-card" },
    { id: "paypal", name: "PayPal", icon: "carbon:logo-paypal" },
    { id: "apple", name: "Apple Pay", icon: "carbon:logo-apple" },
    { id: "google", name: "Google Pay", icon: "carbon:logo-google" }
  ],
  isProcessing: false,
  errors: {}
});

return {
  selectAmount: (amount, bonus = 0) => {
    setStore("selectedAmount", amount + bonus);
    setStore("customAmount", "");
    setStore("errors", "amount", undefined);
  },
  
  setCustomAmount: (value) => {
    const amount = parseFloat(value) || 0;
    setStore("customAmount", value);
    setStore("selectedAmount", amount);
    setStore("errors", "amount", undefined);
  },
  
  selectPaymentMethod: (method) => {
    setStore("paymentMethod", method);
    setStore("errors", "payment", undefined);
  },
  
  validateForm: () => {
    const errors = {};
    if (store.selectedAmount <= 0) {
      errors.amount = "Please select or enter an amount";
    }
    if (store.selectedAmount < 5) {
      errors.amount = "Minimum recharge amount is $5";
    }
    if (!store.paymentMethod) {
      errors.payment = "Please select a payment method";
    }
    
    setStore("errors", errors);
    return Object.keys(errors).length === 0;
  },
  
  processRecharge: async () => {
    if (!args.fns.validateForm()) return;
    
    setStore("isProcessing", true);
    
    // Simulate payment processing
    await new Promise(resolve => setTimeout(resolve, 2000));
    
    // Update balance
    const newBalance = store.currentBalance + store.selectedAmount;
    args.saveUserSetting({ balance: newBalance });
    
    args.showSuccessToast(`Successfully added $${store.selectedAmount.toFixed(2)} to your balance!`);
    args.navigate("/dashboard");
  }
};
''',
        props: '''
const fns = args.fns;

return {
  as: "div",
  data: args.contextData.rechargeStore
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${args.theme.var.color.background_dark_50};
}`;
'''
      }
