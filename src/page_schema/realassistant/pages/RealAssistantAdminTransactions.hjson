    {
      id: "transactions_data",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "transaction",
        loop: true,
        props: '''
const store = args.contextData.store;
const filteredTransactions = store.transactions.filter(t => {
  const matchesSearch = !store.searchTerm || 
    t.user.toLowerCase().includes(store.searchTerm.toLowerCase()) ||
    t.reference.toLowerCase().includes(store.searchTerm.toLowerCase());
  const matchesType = store.filterType === "all" || t.type === store.filterType;
  const matchesStatus = store.filterStatus === "all" || t.status === store.filterStatus;
  return matchesSearch && matchesType && matchesStatus;
});
return {
  data: filteredTransactions
};
'''
      }
    },
    
