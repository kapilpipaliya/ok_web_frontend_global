{
  vertexes: [
    {
      id: "root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const store = args.createStore({
  filterType: "all",
  filterStatus: "all", 
  dateRange: "7days",
  searchTerm: "",
  transactions: [
    { id: 1, user: "John Doe", type: "recharge", amount: 100, method: "Credit Card", status: "completed", date: "2024-03-15 14:30", reference: "TXN-001234" },
    { id: 2, user: "Jane Smith", type: "withdrawal", amount: 450, method: "Bank Transfer", status: "pending", date: "2024-03-15 12:15", reference: "TXN-001235" },
    { id: 3, user: "Mike Johnson", type: "payment", amount: 35, method: "Balance", status: "completed", date: "2024-03-15 11:45", problem: "#245", reference: "TXN-001236" },
    { id: 4, user: "Sarah Wilson", type: "withdrawal", amount: 1200, method: "PayPal", status: "completed", date: "2024-03-14 16:20", reference: "TXN-001237" },
    { id: 5, user: "Tom Brown", type: "recharge", amount: 50, method: "Debit Card", status: "completed", date: "2024-03-14 10:30", reference: "TXN-001238" },
    { id: 6, user: "Emily Davis", type: "refund", amount: 60, method: "Balance", status: "completed", date: "2024-03-14 09:15", problem: "#198", reference: "TXN-001239" },
    { id: 7, user: "Lisa Anderson", type: "payment", amount: 75, method: "Balance", status: "completed", date: "2024-03-13 15:40", problem: "#201", reference: "TXN-001240" },
    { id: 8, user: "Robert Chen", type: "bonus", amount: 25, method: "System", status: "completed", date: "2024-03-13 12:00", reference: "TXN-001241" }
  ],
  stats: {
    totalVolume: 25840.50,
    pendingAmount: 1850.00,
    todayVolume: 3450.00,
    weekVolume: 12500.00,
    monthVolume: 45000.00,
    avgTransaction: 125.50
  }
});

args.contextData.store = store;
return { as: "div" };
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    
    // Header
    {
      id: "header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RealAssistantHeader",
        props: '''
return {
  showBalance: false
};
'''
      }
    },
    
    // Main Container
    {
      id: "container",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return { as: "div" };
''',
        css: '''
return `._id {
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem;
  
  @media (max-width: 768px) {
    padding: 1rem;
  }
}`;
'''
      }
    },
    
    // Page Header
