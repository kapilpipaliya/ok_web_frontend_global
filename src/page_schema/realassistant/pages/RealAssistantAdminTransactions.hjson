    {
      id: "process_btn",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const transaction = args.contextData.transaction;
if (transaction.status === 'pending') {
  return {
    as: "button",
    title: "Process Transaction",
    onClick: () => {
      args.showSuccessToast(`Processing ${transaction.reference}...`);
    }
  };
}
return null;
''',
        css: '''
return `._id {
  padding: 0.5rem;
  background: ${args.theme.var.color.success_light_100};
  color: ${args.theme.var.color.success};
  border: none;
  border-radius: 0.375rem;
  cursor: pointer;
  transition: all 0.2s ease;
  
  &:hover {
    background: ${args.theme.var.color.success_light_200};
  }
  
  &::before {
    content: "✓";
  }
}`;
'''
