  border: none;
  border-radius: 0.375rem;
  cursor: pointer;
  transition: all 0.2s ease;
  
  &:hover {
    background: ${args.theme.var.color.primary_light_200};
  }
  
  &::before {
    content: "👁";
  }
}`;
'''
