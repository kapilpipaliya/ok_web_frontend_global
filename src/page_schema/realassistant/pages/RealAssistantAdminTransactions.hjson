        displayOrder: 1,
        componentName: "Html",
        props: '''
const transaction = args.contextData.transaction;
const icons = {
  recharge: "➕",
  payment: "💳",
  withdrawal: "💰",
  refund: "↩️",
  bonus: "🎁"
};
return {
  as: "span",
  text: `${icons[transaction.type] || ""} ${transaction.type.charAt(0).toUpperCase() + transaction.type.slice(1)}`
};
''',
        css: '''
const transaction = args.contextData.transaction;
const colors = {
  recharge: args.theme.var.color.success,
  payment: args.theme.var.color.primary,
  withdrawal: args.theme.var.color.warning,
  refund: args.theme.var.color.info,
  bonus: args.theme.var.color.success
};
return `._id {
  padding: 0.25rem 0.75rem;
  border-radius: 1rem;
  font-size: 0.75rem;
  font-weight: 600;
  background: ${colors[transaction.type] || args.theme.var.color.background_light_200};
  color: white;
}`;
'''
      }
    },
    
    {
      id: "td_amount",
      L: "Attr",
      P: {
