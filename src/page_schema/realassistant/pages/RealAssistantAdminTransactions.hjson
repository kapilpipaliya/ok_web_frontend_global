        props: '''
const transaction = args.contextData.transaction;
const isCredit = ['recharge', 'refund', 'bonus'].includes(transaction.type);
return {
  as: "td",
  text: `${isCredit ? '+' : '-'}$${transaction.amount.toFixed(2)}`
};
''',
        css: '''
const transaction = args.contextData.transaction;
const isCredit = ['recharge', 'refund', 'bonus'].includes(transaction.type);
return `._id {
  padding: 1rem;
  font-size: 0.875rem;
  font-weight: 600;
  color: ${isCredit ? args.theme.var.color.success : args.theme.var.color.text};
}`;
'''
