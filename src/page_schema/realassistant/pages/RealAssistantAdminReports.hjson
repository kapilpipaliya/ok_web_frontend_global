    {
      id: "chart_bars",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "bar",
        loop: true,
        props: '''
const store = c.store;
const maxValue = Math.max(...store.chartData.revenue);
const data = store.chartData.revenue.map((value, index) => ({
  value,
  label: store.chartData.dates[index],
  height: (value / maxValue) * 100
}));
return {
  data
};
'''
      }
