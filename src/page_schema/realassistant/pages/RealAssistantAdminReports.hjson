{
  vertexes: [
    {
      id: "root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const store = _.createStore({
  dateRange: "7days",
  reportType: "overview",
  chartData: {
    revenue: [2800, 3200, 2900, 3500, 4200, 3800, 4500],
    problems: [45, 52, 48, 58, 65, 61, 72],
    users: [120, 135, 128, 142, 158, 165, 178],
    dates: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
  },
  topCategories: [
    { name: "Technology", count: 245, revenue: 12500 },
    { name: "Education", count: 189, revenue: 8900 },
    { name: "Legal", count: 156, revenue: 15600 },
    { name: "Finance", count: 134, revenue: 10200 },
    { name: "Health", count: 98, revenue: 7800 }
  ],
  performanceMetrics: {
    avgResolutionTime: "3.2 hours",
    satisfactionRate: "94.5%",
    disputeRate: "2.3%",
    completionRate: "89.7%",
    avgProblemValue: "$85.50",
    returnUserRate: "67%"
  },
  assistantPerformance: [
    { name: "Sarah Wilson", solved: 145, rating: 4.9, earnings: 12500, responseTime: "45 min" },
    { name: "Jane Smith", solved: 132, rating: 4.8, earnings: 10800, responseTime: "1.2 hours" },
    { name: "Robert Chen", solved: 118, rating: 4.7, earnings: 9500, responseTime: "2.1 hours" },
    { name: "Michael Lee", solved: 98, rating: 4.6, earnings: 7800, responseTime: "1.5 hours" },
    { name: "Emily Davis", solved: 87, rating: 4.8, earnings: 6900, responseTime: "55 min" }
  ],
  revenueBreakdown: {
    recharges: 45000,
    platformFees: 6750,
    withdrawals: 38250,
    pending: 1850,
    refunds: 450
  }
});

c.store = store;
return { as: "div" };
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${t.var.color.background};
  color: ${t.var.color.text};
}`;
'''
      }
