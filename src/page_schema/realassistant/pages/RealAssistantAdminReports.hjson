''',
        css: '''
const category = c.category;
const store = c.store;
const maxRevenue = Math.max(...store.topCategories.map(c => c.revenue));
const width = (category.revenue / maxRevenue) * 100;
return `._id {
  height: 100%;
  width: ${width}%;
  background: ${t.var.color.primary};
  transition: width 0.3s ease;
}`;
