    {
      id: "status_available",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const store = c.store;
return {
  as: "button",
  onClick: () => {
    store.availability.status = "available";
  }
};
''',
        css: '''
const store = c.store;
const isActive = store.availability.status === "available";
return `._id {
  padding: 0.5rem 1rem;
  background: ${isActive ? t.var.color.success : t.var.color.background_light_200};
  color: ${isActive ? 'white' : t.var.color.text};
  border: none;
  border-radius: 0.375rem;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  
  &:hover {
    opacity: 0.9;
  }
  
  &::before {
    content: "🟢 ";
  }
  
  &::after {
    content: "Available";
  }
}`;
'''
      }
    },
    
    {
      id: "status_busy",
