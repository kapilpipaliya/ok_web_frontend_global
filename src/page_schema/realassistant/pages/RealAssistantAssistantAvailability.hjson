};
''',
        css: '''
const day = c.day;
const store = c.store;
return `._id {
  font-weight: ${store.schedule[day.key].enabled ? '600' : '400'};
  color: ${store.schedule[day.key].enabled ? t.var.color.text : t.var.color.text_light_600};
}`;
'''
      }
