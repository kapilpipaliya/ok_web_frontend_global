{
  vertexes: [
    {
      id: "root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const store = _.createStore({
  availability: {
    status: "available", // available, busy, offline
    autoAccept: false,
    maxActiveProblems: 3,
    currentActive: 2,
    preferredCategories: ["Technology", "Programming", "Education"],
    responseCommitment: "1hour" // 30min, 1hour, 2hours, 4hours, 24hours
  },
  schedule: {
    monday: { enabled: true, start: "09:00", end: "17:00", breaks: [{start: "12:00", end: "13:00"}] },
    tuesday: { enabled: true, start: "09:00", end: "17:00", breaks: [{start: "12:00", end: "13:00"}] },
    wednesday: { enabled: true, start: "09:00", end: "17:00", breaks: [{start: "12:00", end: "13:00"}] },
    thursday: { enabled: true, start: "09:00", end: "17:00", breaks: [{start: "12:00", end: "13:00"}] },
    friday: { enabled: true, start: "09:00", end: "18:00", breaks: [{start: "12:00", end: "13:00"}] },
    saturday: { enabled: false, start: "10:00", end: "14:00", breaks: [] },
    sunday: { enabled: false, start: "", end: "", breaks: [] }
  },
  timeOff: [
    { id: 1, startDate: "2024-03-25", endDate: "2024-03-27", reason: "Personal", status: "approved" },
    { id: 2, startDate: "2024-04-15", endDate: "2024-04-15", reason: "Medical appointment", status: "pending" }
  ],
  notifications: {
    newProblemAlert: true,
    urgentProblemAlert: true,
    categoryMatchAlert: true,
    reminderBeforeDeadline: true,
    dailySummary: false,
    weeklyReport: true
  },
  timezone: "America/Los_Angeles",
  editingDay: null,
  showTimeOffModal: false,
  newTimeOff: {
    startDate: "",
    endDate: "",
    reason: ""
  }
});

// Helper to get current day
const days = ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"];
const currentDay = days[new Date().getDay()];
store.currentDay = currentDay;

c.store = store;
return { as: "div" };
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${t.var.color.background};
  color: ${t.var.color.text};
}`;
'''
      }
    },
    
    // Header
    {
      id: "header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RealAssistantHeader",
        props: '''
return {
  showBalance: false
};
'''
      }
    },
    
    // Main Container
    {
      id: "container",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return { as: "div" };
''',
        css: '''
return `._id {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem;
  
  @media (max-width: 768px) {
    padding: 1rem;
  }
}`;
'''
      }
    },
    
    // Page Header
    {
      id: "page_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return { as: "div" };
''',
        css: '''
return `._id {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  flex-wrap: wrap;
  gap: 1rem;
}`;
'''
      }
    },
    
    {
