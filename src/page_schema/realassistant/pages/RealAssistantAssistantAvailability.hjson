      id: "notif_checkbox",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const notification = c.notification;
const store = c.store;
return {
  as: "input",
  type: "checkbox",
  checked: store.notifications[notification.key],
  onChange: (e) => {
    store.notifications[notification.key] = e.target.checked;
  }
};
''',
        css: '''
return `._id {
  width: 1.25rem;
  height: 1.25rem;
  cursor: pointer;
}`;
'''
      }
