      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const day = c.day;
const store = c.store;
const schedule = store.schedule[day.key];
if (schedule.enabled) {
  return { as: "div" };
}
return null;
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
