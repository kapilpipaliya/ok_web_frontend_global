        props: '''
const notifications = [
  { key: "newProblemAlert", label: "New Problem Alerts", icon: "🔔" },
  { key: "urgentProblemAlert", label: "Urgent Problem Alerts", icon: "🚨" },
  { key: "categoryMatchAlert", label: "Category Match Alerts", icon: "🎯" },
  { key: "reminderBeforeDeadline", label: "Deadline Reminders", icon: "⏰" },
  { key: "dailySummary", label: "Daily Summary", icon: "📊" },
  { key: "weeklyReport", label: "Weekly Report", icon: "📈" }
];
return {
  data: notifications
};
'''
