    {
      id: "day_item",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return { as: "div" };
''',
        css: '''
const day = c.day;
const store = c.store;
const isToday = store.currentDay === day.key;
return `._id {
  padding: 0.75rem;
  background: ${isToday ? t.var.color.primary_light_100 : t.var.color.background_light_50};
  border-radius: 0.5rem;
  margin-bottom: 0.5rem;
  border: 1px solid ${isToday ? t.var.color.primary_light_300 : 'transparent'};
  
  &:last-child {
    margin-bottom: 0;
  }
}`;
'''
