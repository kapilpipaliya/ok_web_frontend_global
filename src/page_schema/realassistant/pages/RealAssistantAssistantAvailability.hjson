  text: timeoff.status.charAt(0).toUpperCase() + timeoff.status.slice(1)
};
''',
        css: '''
const timeoff = c.timeoff;
const colors = {
  approved: t.var.color.success,
  pending: t.var.color.warning,
  rejected: t.var.color.error
};
return `._id {
  padding: 0.25rem 0.75rem;
  background: ${colors[timeoff.status] || t.var.color.background_light_200};
  color: white;
  border-radius: 1rem;
  font-size: 0.75rem;
  font-weight: 600;
}`;
'''
