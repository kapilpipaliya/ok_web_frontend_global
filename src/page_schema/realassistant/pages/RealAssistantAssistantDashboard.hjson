return {
  as: "button",
  onClick: toggleAvailability
};
''',
        css: '''
const isAvailable = args.contextData.assistantStore?.assistant?.isAvailable;
return `._id {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  background: ${isAvailable ? args.theme.var.color.success_light_100 : args.theme.var.color.background_dark_100};
  color: ${isAvailable ? args.theme.var.color.success : args.theme.var.color.muted};
  border: 1px solid ${isAvailable ? args.theme.var.color.success : args.theme.var.color.border};
  border-radius: 2rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  
  &:hover {
    background: ${isAvailable ? args.theme.var.color.success_light_200 : args.theme.var.color.background_dark_200};
  }
  
  @media (max-width: 768px) {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
  }
}`;
'''
      }
