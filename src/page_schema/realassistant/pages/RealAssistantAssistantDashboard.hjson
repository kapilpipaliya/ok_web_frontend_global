{
  vertexes: [
    {
      id: "1",
      L: "Page",
      P: {
        key: "RealAssistantAssistantDashboard",
        url: "/assistant/dashboard",
        title: "Assistant Dashboard - RealAssistant"
      }
    },
    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "assistantStore",
        fns: '''
const [store, setStore] = args.createStore({
  assistant: {
    name: "Sarah K.",
    rating: 4.8,
    totalProblems: 156,
    completedProblems: 148,
    earnings: {
      today: 45.00,
      thisWeek: 320.00,
      thisMonth: 1280.00,
      pending: 85.00,
      available: 1195.00
    },
    expertise: ["Excel & Data Analysis", "Technology Support", "Business Tools"],
    isAvailable: true
  },
  assignedProblems: [],
  recentActivity: [],
  stats: {
    avgResponseTime: "1.5 hours",
    successRate: "94.8%",
    avgRating: 4.8,
    totalReviews: 148
  }
});

return {
  loadDashboardData: async () => {
    // Load assistant data from database
    setStore("assignedProblems", [
      {
        id: "1",
        title: "Excel Formula Help",
        category: "Technology",
        urgency: "normal",
        status: "assigned",
        assignedAt: "2 hours ago",
        estimatedEarning: 8.00,
        userRating: 4.5
      },
      {
        id: "2",
        title: "PowerPoint Presentation Issue",
        category: "Business",
        urgency: "urgent",
        status: "in_progress",
        assignedAt: "4 hours ago",
        estimatedEarning: 18.00,
        userRating: 4.2
      },
      {
        id: "3",
        title: "Database Query Optimization",
        category: "Technology",
        urgency: "normal",
        status: "awaiting_approval",
        assignedAt: "Yesterday",
        estimatedEarning: 12.00,
        userRating: 4.8
      }
    ]);
    
    setStore("recentActivity", [
      {
        type: "solution_approved",
        problem: "Tax Calculation Spreadsheet",
        amount: 15.00,
        time: "2 hours ago"
      },
      {
        type: "new_assignment",
        problem: "Excel Formula Help",
        time: "4 hours ago"
      },
      {
        type: "rating_received",
        rating: 5,
        problem: "Website Navigation Help",
        time: "Yesterday"
      }
    ]);
  },
  
  toggleAvailability: () => {
    setStore("assistant", "isAvailable", !store.assistant.isAvailable);
    args.saveUserSetting({ isAvailable: store.assistant.isAvailable });
    args.showSuccessToast(store.assistant.isAvailable ? "You are now available" : "You are now unavailable");
  },
  
  acceptProblem: (problemId) => {
    // Accept problem assignment
    args.navigate(`/assistant/problem/${problemId}`);
  }
};
''',
        props: '''
const fns = args.fns;
if (args.mounted()) {
  fns.loadDashboardData();
}

return {
  as: "div",
  data: args.contextData.assistantStore
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${args.theme.var.color.background_dark_50};
}`;
'''
      }
    },
    {
      id: "3",
