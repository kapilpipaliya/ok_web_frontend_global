      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const problem = args.contextData.problems;
const statusMap = {
  assigned: { text: "New", color: "info" },
  in_progress: { text: "In Progress", color: "primary" },
  awaiting_approval: { text: "Awaiting Approval", color: "warning" }
};
const status = statusMap[problem.status];

return {
  as: "span",
  text: status.text
};
''',
        css: '''
const problem = args.contextData.problems;
const statusColors = {
  assigned: args.theme.var.color.info,
  in_progress: args.theme.var.color.primary,
  awaiting_approval: args.theme.var.color.warning
};
return `._id {
  font-size: 0.875rem;
  color: ${statusColors[problem.status] || args.theme.var.color.text};
  font-weight: 500;
}`;
'''
      }
    },
