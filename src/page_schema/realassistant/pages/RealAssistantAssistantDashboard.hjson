    {
      id: "63",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const activity = args.contextData.activities;
const iconMap = {
  solution_approved: { icon: "carbon:checkmark-filled", color: "success" },
  new_assignment: { icon: "carbon:task", color: "info" },
  rating_received: { icon: "carbon:star-filled", color: "warning" }
};
const iconInfo = iconMap[activity.type];

return {
  as: "icon",
  icon: iconInfo.icon,
  width: 20,
  height: 20
};
''',
        css: '''
const activity = args.contextData.activities;
const colorMap = {
  solution_approved: args.theme.var.color.success,
  new_assignment: args.theme.var.color.info,
  rating_received: args.theme.var.color.warning
};
return `._id {
  color: ${colorMap[activity.type] || args.theme.var.color.muted};
  margin-top: 0.125rem;
}`;
'''
      }
    },
