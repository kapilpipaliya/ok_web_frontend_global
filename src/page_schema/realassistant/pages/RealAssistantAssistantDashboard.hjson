        displayOrder: 2,
        componentName: "Html",
        props: '''
const problem = args.contextData.problems;
const urgencyColor = problem.urgency === "urgent" ? args.theme.var.color.error : args.theme.var.color.info;
return {
  as: "span",
  text: problem.urgency === "urgent" ? "URGENT" : "Normal"
};
''',
        css: '''
const problem = args.contextData.problems;
const urgencyColor = problem.urgency === "urgent" ? args.theme.var.color.error : args.theme.var.color.info;
return `._id {
  padding: 0.25rem 0.5rem;
  background: ${urgencyColor}_light_100;
  color: ${urgencyColor};
  border-radius: 0.25rem;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
}`;
'''
      }
    },
