'''
      }
    },
    {
      id: "65",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const activity = args.contextData.activities;
let text = "";
if (activity.type === "solution_approved") {
  text = `Solution approved: ${activity.problem}`;
} else if (activity.type === "new_assignment") {
  text = `New problem assigned: ${activity.problem}`;
} else if (activity.type === "rating_received") {
  text = `Received ${activity.rating} star rating for: ${activity.problem}`;
}

return {
  as: "p",
  text: text
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  color: ${args.theme.var.color.text};
  margin: 0 0 0.25rem 0;
}`;
'''
      }
    },
