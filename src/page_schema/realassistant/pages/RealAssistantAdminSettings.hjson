{
  vertexes: [
    {
      id: "root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const store = _.createStore({
  activeTab: "general",
  settings: {
    general: {
      siteName: "RealAssistant",
      siteUrl: "https://realassistant.com",
      supportEmail: "support@realassistant.com",
      timezone: "America/New_York",
      language: "en",
      maintenanceMode: false,
      registrationEnabled: true,
      emailVerification: true
    },
    pricing: {
      minRecharge: 10,
      maxRecharge: 1000,
      bonusPercentage: 10,
      bonusThreshold: 100,
      platformFee: 15,
      minProblemCost: 5,
      maxProblemCost: 500,
      urgentMultiplier: 1.5
    },
    payments: {
      stripeEnabled: true,
      paypalEnabled: true,
      bankTransferEnabled: false,
      cryptoEnabled: false,
      autoWithdrawal: false,
      minWithdrawal: 50,
      withdrawalFee: 2.5,
      payoutSchedule: "weekly"
    },
    assistants: {
      approvalRequired: true,
      minRating: 4.0,
      maxActiveProblems: 5,
      responseTime: 24,
      trainingRequired: true,
      backgroundCheck: true,
      commissionRate: 85,
      bonusEnabled: true
    },
    notifications: {
      emailNotifications: true,
      smsNotifications: false,
      pushNotifications: true,
      newProblemAlert: true,
      solutionAlert: true,
      paymentAlert: true,
      disputeAlert: true,
      systemAlert: true
    },
    security: {
      twoFactorAuth: false,
      sessionTimeout: 30,
      maxLoginAttempts: 5,
      passwordMinLength: 8,
      passwordRequireSpecial: true,
      passwordRequireNumber: true,
      passwordRequireUpper: true,
      ipWhitelist: false
    }
  },
  unsavedChanges: false
});

c.store = store;
return { as: "div" };
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${t.var.color.background};
  color: ${t.var.color.text};
}`;
'''
      }
    },
    
    // Header
    {
      id: "header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RealAssistantHeader",
        props: '''
return {
  showBalance: false
};
'''
      }
    },
    
    // Main Container
    {
      id: "container",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return { as: "div" };
''',
        css: '''
return `._id {
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem;
  
  @media (max-width: 768px) {
    padding: 1rem;
  }
}`;
'''
      }
    },
    
    // Page Header
    {
      id: "page_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return { as: "div" };
''',
        css: '''
return `._id {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  flex-wrap: wrap;
  gap: 1rem;
}`;
'''
      }
    },
    
    {
      id: "title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: "Platform Settings"
};
''',
        css: '''
return `._id {
  font-size: 2rem;
  font-weight: 700;
  color: ${t.var.color.text};
  margin: 0;
}`;
'''
      }
    },
    
    {
      id: "save_btn",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "RealAssistantButton",
        props: '''
const store = c.store;
return {
  text: store.unsavedChanges ? "Save Changes" : "All Saved",
  variant: store.unsavedChanges ? "primary" : "secondary",
  icon: "carbon:save",
  disabled: !store.unsavedChanges,
  onClick: () => {
    store.unsavedChanges = false;
    _.showSuccessToast("Settings saved successfully!");
  }
};
'''
      }
    },
    
    // Settings Layout
    {
      id: "settings_layout",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return { as: "div" };
''',
        css: '''
return `._id {
  display: grid;
  grid-template-columns: 250px 1fr;
  gap: 2rem;
  
  @media (max-width: 768px) {
    grid-template-columns: 1fr;
  }
}`;
'''
      }
    },
    
    // Sidebar Navigation
    {
      id: "sidebar",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return { as: "nav" };
''',
        css: '''
return `._id {
  background: ${t.var.color.background};
  border: 1px solid ${t.var.color.background_light_200};
  border-radius: 0.75rem;
  padding: 1rem;
  height: fit-content;
  position: sticky;
  top: 1rem;
  
  @media (max-width: 768px) {
    position: static;
  }
}`;
'''
      }
    },
    
    {
      id: "nav_items",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "navItem",
        loop: true,
        props: '''
const items = [
  { id: "general", label: "General", icon: "⚙️" },
  { id: "pricing", label: "Pricing", icon: "💰" },
  { id: "payments", label: "Payments", icon: "💳" },
  { id: "assistants", label: "Assistants", icon: "👥" },
  { id: "notifications", label: "Notifications", icon: "🔔" },
  { id: "security", label: "Security", icon: "🔐" }
];
return {
  data: items
};
'''
      }
    },
    
    {
      id: "nav_item",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = c.navItem;
const store = c.store;
return {
  as: "button",
  onClick: () => {
    store.activeTab = item.id;
  }
};
''',
        css: '''
const item = c.navItem;
const store = c.store;
const isActive = store.activeTab === item.id;
return `._id {
  width: 100%;
  padding: 0.75rem 1rem;
  border: none;
  background: ${isActive ? t.var.color.primary_light_100 : 'transparent'};
  color: ${isActive ? t.var.color.primary : t.var.color.text};
  border-radius: 0.5rem;
  text-align: left;
  font-size: 0.875rem;
  font-weight: ${isActive ? '600' : '400'};
  cursor: pointer;
  transition: all 0.2s ease;
  margin-bottom: 0.25rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  
  &:hover {
    background: ${isActive ? t.var.color.primary_light_100 : t.var.color.background_light_100};
  }
}`;
'''
      }
    },
    
    {
      id: "nav_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
