  { label: "Problems Solved", value: store.stats.totalSolved, icon: "✅" },
  { label: "Average Rating", value: `${store.stats.avgRating} ⭐`, icon: "⭐" },
  { label: "Response Time", value: store.stats.responseTime, icon: "⏱" },
  { label: "Success Rate", value: store.stats.successRate, icon: "📈" },
  { label: "Total Earnings", value: `$${store.stats.totalEarnings.toLocaleString()}`, icon: "💰" }
];
return {
  data: stats
};
'''
