{
  vertexes: [
    {
      id: "root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const store = _.createStore({
  profile: {
    name: "Jane Smith",
    email: "jane.smith@example.com",
    phone: "+1 234 567 8900",
    bio: "Experienced software developer with 8+ years in web development, specializing in React, Node.js, and cloud architecture. I love helping people solve technical challenges and sharing my knowledge.",
    avatar: null,
    location: "San Francisco, CA",
    languages: ["English", "Spanish"],
    timezone: "America/Los_Angeles",
    yearsExperience: 8,
    profileComplete: 85
  },
  expertise: [
    { id: 1, category: "Technology", skills: ["Web Development", "Mobile Apps", "Cloud Computing", "Database Design"], level: "Expert", certified: true },
    { id: 2, category: "Programming", skills: ["JavaScript", "Python", "Java", "SQL"], level: "Expert", certified: true },
    { id: 3, category: "Education", skills: ["Computer Science", "Mathematics"], level: "Intermediate", certified: false }
  ],
  certifications: [
    { id: 1, name: "AWS Solutions Architect", issuer: "Amazon", date: "2023-06-15", verified: true },
    { id: 2, name: "Google Cloud Professional", issuer: "Google", date: "2023-03-20", verified: true },
    { id: 3, name: "React Expert", issuer: "Meta", date: "2022-11-10", verified: true }
  ],
  stats: {
    totalSolved: 145,
    avgRating: 4.8,
    responseTime: "45 min",
    successRate: "94%",
    totalEarnings: 12500
  },
  editMode: false,
  newSkill: "",
  newLanguage: ""
});

c.store = store;
return { as: "div" };
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${t.var.color.background};
  color: ${t.var.color.text};
}`;
'''
      }
    },
    
    // Header
    {
      id: "header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "RealAssistantHeader",
        props: '''
return {
  showBalance: false
};
'''
      }
    },
    
    // Main Container
    {
      id: "container",
