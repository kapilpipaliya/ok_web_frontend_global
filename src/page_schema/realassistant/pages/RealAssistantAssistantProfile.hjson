      P: {
        displayOrder: 2,
        componentName: "RealAssistantButton",
        props: '''
const store = c.store;
return {
  text: store.editMode ? "Save Changes" : "Edit Profile",
  variant: "primary",
  icon: store.editMode ? "carbon:save" : "carbon:edit",
  onClick: () => {
    if (store.editMode) {
      _.showSuccessToast("Profile updated successfully!");
    }
    store.editMode = !store.editMode;
  }
};
'''
