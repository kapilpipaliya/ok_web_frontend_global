{
  vertexes: [
    {
      id: "1",
      L: "Page",
      P: {
        key: "RealAssistantProblemDetails",
        url: "/problem/:id",
        title: "Problem Details - RealAssistant"
      }
    },
    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "problemStore",
        fns: '''
const [store, setStore] = _.createStore({
  problem: {
    id: "1",
    title: "Help with Excel Formula",
    category: "Technology & Computer",
    description: "I need help creating a complex Excel formula that calculates commission based on multiple tiers. I have a sales spreadsheet where commission rates change based on total sales volume.",
    status: "solution_provided",
    urgency: "normal",
    createdAt: "2024-01-15 10:30 AM",
    estimatedCost: 8.00,
    actualCost: 8.00,
    assistant: {
      name: "Sarah K.",
      rating: 4.8,
      expertise: "Excel & Data Analysis",
      assignedAt: "2024-01-15 11:00 AM"
    },
    solution: {
      providedAt: "2024-01-15 2:30 PM",
      content: "I've created a nested IF formula that handles your commission tiers:\\n\\n=IF(A2<=10000, A2*0.05, IF(A2<=25000, 500+(A2-10000)*0.07, IF(A2<=50000, 1550+(A2-25000)*0.09, 3800+(A2-50000)*0.11)))\\n\\nThis formula assumes your sales amount is in cell A2.",
      attachments: ["commission_calculator.xlsx"],
      approved: false
    },
    messages: [
      {
        sender: "assistant",
        text: "Hi! I see you need help with Excel formulas. Can you share more details about your commission structure?",
        time: "11:05 AM"
      },
      {
        sender: "user",
        text: "Sure! Commission is 5% for sales up to $10k, 7% for $10k-25k, 9% for $25k-50k, and 11% above $50k",
        time: "11:10 AM"
      }
    ]
  },
  showApproveDialog: false,
  showRejectDialog: false,
  rejectReason: ""
});

return {
  loadProblemData: async (problemId) => {
    // Load problem data from database
    // For demo, using sample data
  },
  
  approveSolution: async () => {
    setStore("showApproveDialog", false);
    setStore("problem", "solution", "approved", true);
    setStore("problem", "status", "completed");
    
    // Process payment
    _.showSuccessToast("Solution approved! Payment processed.");
    
    // Navigate to dashboard after delay
    setTimeout(() => _.navigate("/dashboard"), 2000);
  },
  
  rejectSolution: async () => {
    if (!store.rejectReason.trim()) {
      _.showErrorToast("Please provide a reason for rejection");
      return;
    }
    
    setStore("showRejectDialog", false);
    setStore("problem", "status", "disputed");
    
    _.showWarningToast("Solution rejected. The assistant will be notified.");
  },
  
  sendMessage: (message) => {
    const newMessage = {
      sender: "user",
      text: message,
      time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    };
    setStore("problem", "messages", msgs => [...msgs, newMessage]);
  }
};
''',
        props: '''
const fns = f;
const problemId = _.location.pathname.split("/").pop();

if (_.mounted()) {
  fns.loadProblemData(problemId);
}

return {
  as: "div",
  data: c.problemStore
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${t.var.color.background_dark_50};
}`;
'''
      }
