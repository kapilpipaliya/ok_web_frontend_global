    {
      id: "8",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const status = c.problemStore?.problem?.status || "pending";
const statusMap = {
  pending: { text: "Pending", color: "warning" },
  in_progress: { text: "In Progress", color: "info" },
  solution_provided: { text: "Solution Provided", color: "primary" },
  completed: { text: "Completed", color: "success" },
  disputed: { text: "Disputed", color: "error" }
};
const statusInfo = statusMap[status];

return {
  as: "span",
  text: statusInfo.text
};
''',
        css: '''
const status = c.problemStore?.problem?.status || "pending";
const statusColors = {
  pending: t.var.color.warning,
  in_progress: t.var.color.info,
  solution_provided: t.var.color.primary,
  completed: t.var.color.success,
  disputed: t.var.color.error
};

return `._id {
  padding: 0.375rem 0.75rem;
  background: ${statusColors[status] || t.var.color.text_light_500};
  color: ${t.var.color.background};
  border-radius: 0.375rem;
  font-size: 0.875rem;
  font-weight: 600;
}`;
'''
      }
    },
