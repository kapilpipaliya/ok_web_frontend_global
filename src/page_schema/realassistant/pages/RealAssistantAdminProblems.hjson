{
  vertexes: [
    {
      id: "root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const store = args.createStore({
  filterStatus: "all",
  filterCategory: "all",
  searchTerm: "",
  sortBy: "recent",
  selectedProblems: [],
  problems: [
    { 
      id: 1, 
      title: "Website not loading properly", 
      user: "John Doe",
      assistant: "Jane Smith",
      category: "tech",
      status: "in_progress",
      urgency: "urgent",
      estimatedCost: 50,
      actualCost: null,
      created: "2024-03-15 10:30",
      updated: "2024-03-15 14:45"
    },
    { 
      id: 2, 
      title: "Math homework help - Calculus", 
      user: "Mike Johnson",
      assistant: "Sarah Wilson",
      category: "education",
      status: "solution_provided",
      urgency: "normal",
      estimatedCost: 30,
      actualCost: 35,
      created: "2024-03-14 09:15",
      updated: "2024-03-15 11:20"
    },
    { 
      id: 3, 
      title: "Legal document review", 
      user: "Emily Davis",
      assistant: null,
      category: "legal",
      status: "pending",
      urgency: "normal",
      estimatedCost: 100,
      actualCost: null,
      created: "2024-03-15 16:00",
      updated: "2024-03-15 16:00"
    },
    { 
      id: 4, 
      title: "Fix database connection issue", 
      user: "Tom Brown",
      assistant: "Jane Smith",
      category: "tech",
      status: "completed",
      urgency: "urgent",
      estimatedCost: 75,
      actualCost: 80,
      created: "2024-03-13 08:00",
      updated: "2024-03-14 17:30"
    },
    { 
      id: 5, 
      title: "Investment portfolio advice", 
      user: "Lisa Anderson",
      assistant: "Robert Chen",
      category: "finance",
      status: "disputed",
      urgency: "normal",
      estimatedCost: 60,
      actualCost: 60,
      created: "2024-03-12 14:20",
      updated: "2024-03-15 09:10"
    }
  ]
});

args.contextData.store = store;
return { as: "div" };
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    
