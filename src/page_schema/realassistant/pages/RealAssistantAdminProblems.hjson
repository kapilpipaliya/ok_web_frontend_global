    {
      id: "select_all",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const store = args.contextData.store;
const filteredProblems = store.problems.filter(p => {
  const matchesSearch = !store.searchTerm || 
    p.title.toLowerCase().includes(store.searchTerm.toLowerCase()) ||
    p.user.toLowerCase().includes(store.searchTerm.toLowerCase());
  const matchesStatus = store.filterStatus === "all" || p.status === store.filterStatus;
  const matchesCategory = store.filterCategory === "all" || p.category === store.filterCategory;
  return matchesSearch && matchesStatus && matchesCategory;
});

return {
  as: "input",
  type: "checkbox",
  checked: filteredProblems.length > 0 && filteredProblems.every(p => store.selectedProblems.includes(p.id)),
  onChange: (e) => {
    if (e.target.checked) {
      store.selectedProblems = filteredProblems.map(p => p.id);
    } else {
      store.selectedProblems = [];
    }
  }
};
''',
        css: '''
return `._id {
  width: 1.25rem;
  height: 1.25rem;
  cursor: pointer;
}`;
'''
      }
    },
    
