    {
      id: "problems_data",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "problem",
        loop: true,
        props: '''
const store = args.contextData.store;
let filteredProblems = store.problems.filter(p => {
  const matchesSearch = !store.searchTerm || 
    p.title.toLowerCase().includes(store.searchTerm.toLowerCase()) ||
    p.user.toLowerCase().includes(store.searchTerm.toLowerCase());
  const matchesStatus = store.filterStatus === "all" || p.status === store.filterStatus;
  const matchesCategory = store.filterCategory === "all" || p.category === store.filterCategory;
  return matchesSearch && matchesStatus && matchesCategory;
});

// Sort problems
if (store.sortBy === "urgent") {
  filteredProblems = filteredProblems.sort((a, b) => {
    if (a.urgency === "urgent" && b.urgency !== "urgent") return -1;
    if (a.urgency !== "urgent" && b.urgency === "urgent") return 1;
    return 0;
  });
} else if (store.sortBy === "cost") {
  filteredProblems = filteredProblems.sort((a, b) => b.estimatedCost - a.estimatedCost);
}

return {
  data: filteredProblems
};
'''
      }
    },
    
    {
      id: "problem_row",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return { as: "tr" };
''',
        css: '''
return `._id {
  border-bottom: 1px solid ${args.theme.var.color.background_light_200};
  transition: background 0.2s ease;
  
  &:hover {
    background: ${args.theme.var.color.background_light_50};
  }
  
  &:last-child {
    border-bottom: none;
  }
}`;
'''
      }
