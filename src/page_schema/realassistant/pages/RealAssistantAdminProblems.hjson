    {
      id: "problem_checkbox",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const problem = args.contextData.problem;
const store = args.contextData.store;
return {
  as: "input",
  type: "checkbox",
  checked: store.selectedProblems.includes(problem.id),
  onChange: (e) => {
    if (e.target.checked) {
      store.selectedProblems = [...store.selectedProblems, problem.id];
    } else {
      store.selectedProblems = store.selectedProblems.filter(id => id !== problem.id);
    }
  }
};
''',
        css: '''
return `._id {
  width: 1.25rem;
  height: 1.25rem;
  cursor: pointer;
}`;
'''
      }
