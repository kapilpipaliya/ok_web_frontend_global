    {
      id: "user_checkbox",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const user = args.contextData.user;
const store = args.contextData.store;
return {
  as: "input",
  type: "checkbox",
  checked: store.selectedUsers.includes(user.id),
  onChange: (e) => {
    if (e.target.checked) {
      store.selectedUsers = [...store.selectedUsers, user.id];
    } else {
      store.selectedUsers = store.selectedUsers.filter(id => id !== user.id);
    }
  }
};
''',
        css: '''
return `._id {
  width: 1.25rem;
  height: 1.25rem;
  cursor: pointer;
}`;
'''
