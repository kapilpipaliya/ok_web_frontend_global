    {
      id: "users_data",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "user",
        loop: true,
        props: '''
const store = args.contextData.store;
const filteredUsers = store.users.filter(user => {
  const matchesSearch = !store.searchTerm || 
    user.name.toLowerCase().includes(store.searchTerm.toLowerCase()) ||
    user.email.toLowerCase().includes(store.searchTerm.toLowerCase());
  const matchesRole = store.filterRole === "all" || user.role === store.filterRole;
  const matchesStatus = store.filterStatus === "all" || user.status === store.filterStatus;
  return matchesSearch && matchesRole && matchesStatus;
});
return {
  data: filteredUsers
};
'''
