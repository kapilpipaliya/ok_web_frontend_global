{
  vertexes: [
    {
      id: "root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const store = args.createStore({
  searchTerm: "",
  filterRole: "all",
  filterStatus: "all",
  selectedUsers: [],
  users: [
    { id: 1, name: "John Doe", email: "john@example.com", role: "user", status: "active", balance: 245.50, problems: 12, joined: "2024-01-15" },
    { id: 2, name: "Jane Smith", email: "jane@example.com", role: "assistant", status: "active", earnings: 1850.00, solved: 28, rating: 4.8, joined: "2024-01-10" },
    { id: 3, name: "Mike Johnson", email: "mike@example.com", role: "user", status: "suspended", balance: 0, problems: 3, joined: "2024-02-01" },
    { id: 4, name: "Sarah Wilson", email: "sarah@example.com", role: "assistant", status: "active", earnings: 3200.00, solved: 45, rating: 4.9, joined: "2023-12-20" },
    { id: 5, name: "Tom Brown", email: "tom@example.com", role: "user", status: "inactive", balance: 50.00, problems: 1, joined: "2024-02-10" },
    { id: 6, name: "Emily Davis", email: "emily@example.com", role: "assistant", status: "pending", earnings: 0, solved: 0, rating: 0, joined: "2024-03-01" }
  ]
});

args.contextData.store = store;
return { as: "div" };
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    
