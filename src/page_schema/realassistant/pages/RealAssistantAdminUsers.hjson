  justify-content: flex-end;
}`;
'''
      }
    },
    
    {
      id: "view_btn",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const user = args.contextData.user;
return {
  as: "button",
  title: "View Details",
  onClick: () => {
    args.showSuccessToast(`View details for ${user.name}`);
  }
};
''',
        css: '''
return `._id {
  padding: 0.5rem;
  background: ${args.theme.var.color.primary_light_100};
  color: ${args.theme.var.color.primary};
  border: none;
  border-radius: 0.375rem;
  cursor: pointer;
  transition: all 0.2s ease;
  
  &:hover {
    background: ${args.theme.var.color.primary_light_200};
  }
  
  &::before {
    content: "👁";
  }
}`;
'''
      }
    },
    
    {
      id: "edit_btn",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const user = args.contextData.user;
return {
  as: "button",
  title: "Edit User",
  onClick: () => {
    args.showSuccessToast(`Edit ${user.name}`);
  }
};
''',
        css: '''
return `._id {
  padding: 0.5rem;
  background: ${args.theme.var.color.background_light_200};
  color: ${args.theme.var.color.text};
  border: none;
  border-radius: 0.375rem;
  cursor: pointer;
  transition: all 0.2s ease;
  
  &:hover {
    background: ${args.theme.var.color.background_light_300};
  }
  
  &::before {
    content: "✏";
  }
}`;
'''
      }
    },
    
    {
      id: "suspend_btn",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const user = args.contextData.user;
return {
  as: "button",
  title: user.status === 'suspended' ? "Activate User" : "Suspend User",
  onClick: () => {
    const action = user.status === 'suspended' ? 'Activated' : 'Suspended';
    args.showSuccessToast(`${action} ${user.name}`);
  }
};
''',
        css: '''
const user = args.contextData.user;
return `._id {
  padding: 0.5rem;
  background: ${user.status === 'suspended' ? args.theme.var.color.success_light_100 : args.theme.var.color.error_light_100};
  color: ${user.status === 'suspended' ? args.theme.var.color.success : args.theme.var.color.error};
  border: none;
  border-radius: 0.375rem;
  cursor: pointer;
  transition: all 0.2s ease;
  
  &:hover {
    background: ${user.status === 'suspended' ? args.theme.var.color.success_light_200 : args.theme.var.color.error_light_200};
  }
  
  &::before {
    content: "${user.status === 'suspended' ? '✓' : '⛔'}";
  }
}`;
'''
      }
    }
