        css: '''
return `._id {
  padding: 1rem;
  font-size: 0.875rem;
  color: ${args.theme.var.color.text_light_700};
}`;
'''
      }
    },
    
    {
      id: "user_detail_text",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const user = args.contextData.user;
if (user.role === 'assistant') {
  return {
    as: "div",
    text: `💰 $${user.earnings?.toFixed(2) || '0.00'} | ✅ ${user.solved || 0} solved | ⭐ ${user.rating || 0}`
  };
} else {
  return {
    as: "div",
    text: `💳 $${user.balance?.toFixed(2) || '0.00'} | 📝 ${user.problems || 0} problems`
  };
}
'''
      }
    },
    
    {
      id: "td_joined",
      L: "Attr",
      P: {
        displayOrder: 6,
        componentName: "Html",
        props: '''
const user = args.contextData.user;
return {
  as: "td",
  text: user.joined
};
''',
        css: '''
return `._id {
  padding: 1rem;
  font-size: 0.875rem;
  color: ${args.theme.var.color.text_light_600};
}`;
'''
      }
    },
    
