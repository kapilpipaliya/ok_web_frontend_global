        css: '''
const bar = args.contextData.chartBars;
return `._id {
  width: 100%;
  height: ${bar.height}%;
  background: ${args.theme.var.color.primary};
  border-radius: 0.25rem 0.25rem 0 0;
  transition: all 0.3s ease;
  cursor: pointer;
  position: relative;
  
  &:hover {
    background: ${args.theme.var.color.primary_dark_200};
    
    &::after {
      content: "$${bar.earnings}";
      position: absolute;
      top: -1.5rem;
      left: 50%;
      transform: translateX(-50%);
      background: ${args.theme.var.color.text};
      color: ${args.theme.var.color.background};
      padding: 0.25rem 0.5rem;
      border-radius: 0.25rem;
      font-size: 0.75rem;
      font-weight: 600;
      white-space: nowrap;
    }
  }
}`;
'''
