return `._id {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem;
  border: 2px solid ${isSelected ? args.theme.var.color.primary : args.theme.var.color.border};
  background: ${isSelected ? args.theme.var.color.primary_light_50 : args.theme.var.color.background};
  border-radius: 0.5rem;
  cursor: pointer;
  transition: all 0.2s ease;
  
  &:hover {
    border-color: ${args.theme.var.color.primary};
  }
}`;
'''
