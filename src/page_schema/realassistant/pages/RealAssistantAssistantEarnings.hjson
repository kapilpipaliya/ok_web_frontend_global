{
  vertexes: [
    {
      id: "1",
      L: "Page",
      P: {
        key: "RealAssistantAssistantEarnings",
        url: "/assistant/earnings",
        title: "Earnings - RealAssistant"
      }
    },
    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "earningsStore",
        fns: '''
const [store, setStore] = args.createStore({
  earnings: {
    available: 1195.00,
    pending: 85.00,
    lifetime: 8420.00,
    thisMonth: 1280.00,
    lastMonth: 1450.00,
    monthlyGrowth: -11.7
  },
  withdrawalMethods: [
    {
      id: "bank1",
      type: "bank",
      name: "Chase Bank ****4582",
      isDefault: true
    },
    {
      id: "paypal1",
      type: "paypal",
      name: "sarah.k@email.com",
      isDefault: false
    }
  ],
  selectedMethod: "bank1",
  withdrawAmount: "",
  transactions: [],
  chartData: [],
  filters: {
    period: "month",
    type: "all"
  },
  isWithdrawing: false,
  showWithdrawDialog: false
});

return {
  loadEarningsData: async () => {
    // Load earnings data from database
    setStore("transactions", [
      {
        id: "t1",
        date: "2024-01-15",
        type: "earning",
        problem: "Excel Formula Help",
        amount: 8.00,
        status: "completed"
      },
      {
        id: "t2",
        date: "2024-01-15",
        type: "earning",
        problem: "PowerPoint Issue",
        amount: 18.00,
        status: "completed"
      },
      {
        id: "t3",
        date: "2024-01-14",
        type: "earning",
        problem: "Database Query",
        amount: 12.00,
        status: "pending"
      },
      {
        id: "t4",
        date: "2024-01-10",
        type: "withdrawal",
        description: "Bank Transfer",
        amount: -500.00,
        status: "completed"
      }
    ]);
    
    // Chart data for last 7 days
    setStore("chartData", [
      { day: "Mon", earnings: 45 },
      { day: "Tue", earnings: 82 },
      { day: "Wed", earnings: 35 },
      { day: "Thu", earnings: 68 },
      { day: "Fri", earnings: 92 },
      { day: "Sat", earnings: 120 },
      { day: "Sun", earnings: 58 }
    ]);
  },
  
  setWithdrawAmount: (value) => {
    const amount = parseFloat(value) || 0;
    if (amount <= store.earnings.available) {
      setStore("withdrawAmount", value);
    }
  },
  
  selectWithdrawMethod: (methodId) => {
    setStore("selectedMethod", methodId);
  },
  
  processWithdrawal: async () => {
    const amount = parseFloat(store.withdrawAmount) || 0;
    if (amount <= 0 || amount > store.earnings.available) {
      args.showErrorToast("Invalid withdrawal amount");
      return;
    }
    
    setStore("isWithdrawing", true);
    
    // Process withdrawal
    await new Promise(resolve => setTimeout(resolve, 2000));
    
    setStore("earnings", "available", store.earnings.available - amount);
    setStore("withdrawAmount", "");
    setStore("showWithdrawDialog", false);
    setStore("isWithdrawing", false);
    
    args.showSuccessToast(`Successfully withdrew $${amount.toFixed(2)}`);
  },
  
  filterTransactions: (period) => {
    setStore("filters", "period", period);
    // Re-fetch filtered data
  }
};
''',
        props: '''
const fns = args.fns;
if (args.mounted()) {
  fns.loadEarningsData();
}

return {
  as: "div",
  data: args.contextData.earningsStore
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${args.theme.var.color.background_dark_50};
}`;
'''
      }
