        contextName: "chartBars",
        loop: true,
        props: '''
const chartData = args.contextData.earningsStore?.chartData || [];
const maxValue = Math.max(...chartData.map(d => d.earnings));
return {
  data: chartData.map(d => ({ ...d, height: (d.earnings / maxValue) * 100 }))
};
'''
