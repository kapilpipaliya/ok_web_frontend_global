        css: '''
const transaction = args.contextData.transactionRows;
const statusColors = {
  completed: args.theme.var.color.success,
  pending: args.theme.var.color.warning
};
return `._id {
  padding: 0.25rem 0.5rem;
  background: ${statusColors[transaction.status]}_light_100;
  color: ${statusColors[transaction.status]};
  border-radius: 0.25rem;
  font-size: 0.875rem;
  font-weight: 500;
  text-transform: capitalize;
}`;
'''
