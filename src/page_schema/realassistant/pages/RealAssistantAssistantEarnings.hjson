  as: "button",
  text: filter.label,
  onClick: () => args.contextData.earningsStore.setStore("filters", "type", filter.key)
};
''',
        css: '''
const filter = args.contextData.filterButtons;
const currentFilter = args.contextData.earningsStore?.filters?.type || "all";
const isActive = filter.key === currentFilter;

return `._id {
  padding: 0.375rem 0.75rem;
  background: ${isActive ? args.theme.var.color.primary : args.theme.var.color.background_dark_100};
  color: ${isActive ? args.theme.var.color.primary_text : args.theme.var.color.text};
  border: 1px solid ${isActive ? args.theme.var.color.primary : args.theme.var.color.border};
  border-radius: 0.375rem;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  
  &:hover {
    background: ${isActive ? args.theme.var.color.primary_dark_200 : args.theme.var.color.background_dark_200};
  }
}`;
'''
