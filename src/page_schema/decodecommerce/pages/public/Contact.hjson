  color: ${t.var.color.primary_text};
  border: none;
  border-radius: 0.5rem;
  font-weight: 600;
  font-size: 1.1rem;
  cursor: pointer;
  transition: all 0.2s ease;
  
  &:hover:not(:disabled) {
    background: ${t.var.color.primary_dark_200};
    transform: translateY(-2px);
    box-shadow: 0 5px 15px ${t.var.color.primary_light_600};
  }
  
  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
}`;
