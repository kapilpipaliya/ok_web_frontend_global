    {
      id: "12",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        contextName: "formState",
        props: '''
const [formData, setFormData] = _.createStore({
  name: "",
  email: "",
  company: "",
  message: ""
});

const [isSubmitting, setIsSubmitting] = _.createSignal(false);

const handleSubmit = async (e) => {
  e.preventDefault();
  setIsSubmitting(true);
  
  // Simulate form submission
  await new Promise(resolve => setTimeout(resolve, 2000));
  
  _.showSuccessToast("Thank you! We'll be in touch within 24 hours.");
  
  // Reset form
  setFormData({
    name: "",
    email: "",
    company: "",
    message: ""
  });
  setIsSubmitting(false);
};

return {
  data: {
    formData,
    setFormData,
    isSubmitting,
    handleSubmit
  }
};
'''
      }
