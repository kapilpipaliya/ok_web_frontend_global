    {
      id: "13",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "advancedFeatures",
        loop: true,
        props: '''
return {
  data: [
    {
      title: "Real-time Inventory Sync",
      description: "Keep your inventory perfectly synchronized between NetSuite and your eCommerce platform. No more overselling or stock discrepancies.",
      icon: "carbon:data-1",
      features: [
        "Automatic stock level updates",
        "Multi-warehouse support",
        "Low stock alerts",
        "Batch inventory management"
      ]
    },
    {
      title: "Order Management System",
      description: "Streamline your order processing from placement to fulfillment with our integrated order management system.",
      icon: "carbon:delivery-truck",
      features: [
        "Automated order routing",
        "Status tracking",
        "Returns management",
        "Customer notifications"
      ]
    },
    {
      title: "Customer Portal",
      description: "Give your customers a self-service portal to manage their accounts, view orders, and track shipments.",
      icon: "carbon:user-multiple",
      features: [
        "Order history",
        "Reorder functionality",
        "Account management",
        "Support tickets"
      ]
    },
    {
      title: "Analytics & Reporting",
      description: "Get deep insights into your business performance with our comprehensive analytics suite.",
      icon: "carbon:analytics",
      features: [
        "Sales dashboards",
        "Customer insights",
        "Performance metrics",
        "Custom reports"
      ]
    }
  ]
};
'''
      }
    },
    {
      id: "14",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const feature = c.advancedFeatures;
const index = feature.index;
const isEven = index % 2 === 0;
return {
  as: "div"
};
''',
        css: '''
const feature = c.advancedFeatures;
const index = feature.index;
const isEven = index % 2 === 0;
return `._id {
  grid-column: span 2;
  display: grid;
  grid-template-columns: ${isEven ? '1fr 1fr' : '1fr 1fr'};
  gap: 3rem;
  align-items: center;
  margin-bottom: 4rem;
  
  @media (max-width: 768px) {
    grid-column: span 1;
    grid-template-columns: 1fr;
    margin-bottom: 3rem;
  }
}`;
'''
      }
    },
