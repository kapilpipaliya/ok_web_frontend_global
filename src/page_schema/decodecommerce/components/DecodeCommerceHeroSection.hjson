    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  min-height: 90vh;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, ${args.theme.var.color.background} 0%, ${args.theme.var.color.background_dark_100} 100%);
  position: relative;
  overflow: hidden;
  
  &::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(circle at 20% 50%, ${args.theme.var.color.primary_light_800} 0%, transparent 50%),
                      radial-gradient(circle at 80% 80%, ${args.theme.var.color.success_light_850} 0%, transparent 50%);
    opacity: 0.5;
  }
}`;
'''
      }
    },
    {
      id: "3",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1200px;
  margin: 0 auto;
  padding: 4rem 2rem;
  position: relative;
  z-index: 1;
  
  @media (max-width: 768px) {
    padding: 2rem 1rem;
  }
}`;
'''
      }
    },
    {
