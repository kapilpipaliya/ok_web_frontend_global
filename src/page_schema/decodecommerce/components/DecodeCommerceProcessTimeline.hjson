    {
      id: "9",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const step = args.contextData.steps;
return {
  as: "div"
};
''',
        css: '''
return [
  `._id {
    position: relative;
    z-index: 1;
    opacity: 0;
    animation: slideReveal 0.6s ease-out forwards;
    animation-delay: calc(var(--index, 0) * 0.2s);
    
    &:nth-child(1) { --index: 0; }
    &:nth-child(2) { --index: 1; }
    &:nth-child(3) { --index: 2; }
    &:nth-child(4) { --index: 3; }
  }`,
  `@keyframes slideReveal {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }`
];
'''
      }
    },
    {
