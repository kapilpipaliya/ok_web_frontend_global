  margin: 0 auto 1.5rem;
  background: ${args.theme.var.color.background};
  border: 3px solid ${args.theme.var.color.primary_l300};
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.3s ease;
  
  &:hover {
    transform: scale(1.1);
    border-color: ${args.theme.var.color.primary};
    box-shadow: 0 10px 30px ${args.theme.var.color.primary_l300};
  }
}`;
'''
