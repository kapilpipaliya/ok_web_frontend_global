        displayOrder: 2
        componentName: Html
        props:
          '''
const field = args.contextData.field;
const value = args.fns.getFieldValue(field.key);
const setFieldValue = args.fns.setFieldValue;

// Render appropriate input based on field type
if (field.type === "textArea") {
  return {
    componentName: "TextArea",
    value: value,
    onChange: (e) => setFieldValue(field.key, e.target.value),
    placeholder: field.placeholder || "",
    required: field.required || false,
    maxLength: field.maxLength
  };
}

if (field.type === "select" && field.selectConfig) {
  // Dynamic select with vertex options
  const [options, setOptions] = args.createSignal([]);
  const [loading, setLoading] = args.createSignal(false);

  // Fetch options on mount or when search changes
  args.createEffect(async () => {
    setLoading(true);
    const fetchedOptions = await args.fns.fetchSelectOptions(field);
    setOptions(fetchedOptions);
    setLoading(false);
  });

  const selectedVertex = args.fns.getSelectedVertex(field);
  const displayValue = selectedVertex 
    ? `${field.selectConfig.label}: ${selectedVertex.P?.[field.selectConfig.labelField || "name"] || "Unnamed"}`
    : value;

  return {
    componentName: "TomSelect",
    value: value,
    onChange: (newValue) => {
      setFieldValue(field.key, newValue);
    },
    options: options(),
    placeholder: field.placeholder || `Select ${field.selectConfig.label}...`,
    required: field.required || false,
    loading: loading()
  };
}

if (field.type === "checkbox") {
  return {
    as: "input",
    type: "checkbox",
    checked: value === true || value === "true",
    onChange: (e) => {
      setFieldValue(field.key, e.target.checked);
    }
  };
}

if (field.type === "date") {
  return {
    as: "input",
    type: "date",
    value: value,
    onChange: (e) => {
      setFieldValue(field.key, e.target.value);
    },
    required: field.required || false
  };
}

if (field.type === "number") {
  return {
    componentName: "TextInput",
    type: "number",
    value: value,
    onChange: (e) => {
      setFieldValue(field.key, e.target.value);
    },
    placeholder: field.placeholder || "",
    required: field.required || false,
    min: field.min,
    max: field.max
  };
}

// Default: text input
return {
  componentName: "TextInput",
  type: field.type === "email" ? "email" : "text",
  value: value,
  onChange: (e) => {
    setFieldValue(field.key, e.target.value);
  },
  placeholder: field.placeholder || "",
  required: field.required || false,
  maxLength: field.maxLength,
  minLength: field.minLength
};
'''
