        props:
          '''
const formConfig = args.fns.getFormConfig();

// Use nested groups structure if available, otherwise fallback to flat structure for backward compatibility
let fieldGroups = [];

if (formConfig?.groups && Array.isArray(formConfig.groups)) {
  // New nested structure
  fieldGroups = formConfig.groups.map(group => ({
    key: group.key || "ungrouped",
    title: group.title || "",
    gridColumns: group.gridColumns || formConfig?.gridColumns || 1,
    fields: group.fields || []
  }));
} else if (formConfig?.fields && Array.isArray(formConfig.fields)) {
  // Legacy flat structure - convert to nested
  const fields = formConfig.fields;
  const groups = {};
  const ungroupedFields = [];

  for (const field of fields) {
    if (field.groupKey) {
      if (!groups[field.groupKey]) {
        groups[field.groupKey] = {
          key: field.groupKey,
          title: field.groupTitle || field.groupKey,
          gridColumns: field.groupColumns || formConfig?.gridColumns || 1,
          fields: []
        };
      }
      groups[field.groupKey].fields.push(field);
    } else {
      ungroupedFields.push(field);
    }
  }

  fieldGroups = [
    ...Object.values(groups),
    ...(ungroupedFields.length > 0 ? [{ 
      key: "ungrouped", 
      title: "", 
      gridColumns: formConfig?.gridColumns || 1,
      fields: ungroupedFields 
    }] : [])
  ];
}

return {
  data: fieldGroups
};
'''
      }
    }
