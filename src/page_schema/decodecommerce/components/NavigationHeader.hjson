    },
    {
      id: "5",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        fns: '''
const [openDropdown, setOpenDropdown] = _.createSignal(null);
return {
  openDropdown,
  setOpenDropdown,
  toggleDropdown: (itemId) => {
    const current = openDropdown();
    setOpenDropdown(current === itemId ? null : itemId);
  },
  isDropdownOpen: (itemId) => {
    return openDropdown() === itemId;
  },
  closeDropdown: () => {
    setOpenDropdown(null);
  }
};
''',
        props: '''
return {
  as: "div",
  onMount: () => {
    const handleClickOutside = (event) => {
      const target = event.target;
      const navContainer = _.ref();
      if (navContainer && !navContainer.contains(target)) {
        f.closeDropdown();
      }
    };
    document.addEventListener('click', handleClickOutside);
    return () => {
      document.removeEventListener('click', handleClickOutside);
    };
  }
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 2rem;
  
  @media (max-width: 768px) {
    gap: 1rem;
  }
  
  > * {
    position: relative;
    
    @media (max-width: 768px) {
      display: none;
    }
  }
}`;
'''
      }
    },
    {
      id: "6",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "navItem",
        loop: true,
        props: '''
return {
  data: [
    { href: "/", text: "Home" },
    { href: "/features", text: "Features" },
    { href: "#", text: "Product", submenu: [
      { href: "/product/decode-product", text: "Decode Product" }
    ] },
    { href: "/pricing", text: "Pricing" },
    { href: "/about", text: "About" },
    { href: "/contact", text: "Contact" }
  ]
};
'''
      }
    },
    {
      id: "6a",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = c.navItem;
const itemId = item.href || item.text;
return {
  as: "div"
};
''',
        css: '''
const item = c.navItem;
const itemId = item.href || item.text;
const isOpen = f.isDropdownOpen(itemId);
return `._id {
  position: relative;
}`;
'''
      }
    },
    {
      id: "7",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = c.navItem;
const currentPath = _.location.pathname;
const isActive =
  item.href === currentPath ||
  (item.href === "/" && currentPath === "/") ||
  (item.submenu && item.submenu.some((sub) => sub.href === currentPath));
return {
  as: "div",
  style: "display: flex; align-items: center; gap: 0.5rem;"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}`;
'''
      }
    },
    {
      id: "7a",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = c.navItem;
const currentPath = _.location.pathname;
const isActive =
  item.href === currentPath ||
  (item.href === "/" && currentPath === "/") ||
  (item.submenu && item.submenu.some((sub) => sub.href === currentPath));
const itemId = item.href || item.text;
return {
  as: "a",
  href: item.href,
  text: item.text,
  onClick: (e) => {
    if (item.submenu && item.submenu.length > 0) {
      e.preventDefault();
      f.toggleDropdown(itemId);
    }
  }
};
''',
        css: '''
const item = c.navItem;
const currentPath = _.location.pathname;
const isActive =
  item.href === currentPath ||
  (item.href === "/" && currentPath === "/") ||
  (item.submenu && item.submenu.some((sub) => sub.href === currentPath));
return `._id {
  color: ${isActive ? t.var.color.primary : t.var.color.text};
  text-decoration: none;
  font-weight: ${isActive ? '600' : '500'};
  transition: all 0.2s ease;
  position: relative;
  padding: 0.25rem 0;
  
  ${isActive ? `
    &::after {
      content: '';
      position: absolute;
      bottom: -0.25rem;
      left: 0;
      right: 0;
      height: 2px;
      background: ${t.var.color.primary};
      border-radius: 1px;
    }
  ` : ''}
  
  &:hover {
    color: ${t.var.color.primary};
  }
}`;
'''
      }
    },
    {
      id: "7b",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const item = c.navItem;
const itemId = item.href || item.text;
const isOpen = f.isDropdownOpen(itemId);
return {
  as: "icon",
  icon: "carbon:chevron-down",
  width: 16,
  height: 16,
  hide: !item.submenu || item.submenu.length === 0,
  onClick: (e) => {
    e.preventDefault();
    e.stopPropagation();
    f.toggleDropdown(itemId);
  }
};
''',
        css: '''
const item = c.navItem;
const itemId = item.href || item.text;
const isOpen = f.isDropdownOpen(itemId);
return `._id {
  color: ${t.var.color.text};
  transition: transform 0.2s ease;
  transform: ${isOpen ? 'rotate(180deg)' : 'rotate(0deg)'};
  cursor: pointer;
  flex-shrink: 0;
}`;
'''
      }
    },
    {
      id: "10",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const item = c.navItem;
const itemId = item.href || item.text;
const isOpen = f.isDropdownOpen(itemId);
return {
  as: "div",
  hide: !item.submenu || item.submenu.length === 0 || !isOpen
};
''',
        css: '''
return `._id {
  position: absolute;
  top: 100%;
  left: 0;
  background: ${t.var.color.background};
  box-shadow: 0 4px 12px ${t.var.color.text_light_900};
