const currentPath = _.location.pathname;
const isActive = currentPath === submenuItem.href;
return `._id {
  display: block;
  padding: 0.5rem 1rem;
  color: ${t.var.color.text};
  text-decoration: none;
  white-space: nowrap;
  font-size: 0.95rem;
  transition: all 0.15s ease;
  
  &:hover {
    background: ${t.var.color.background_dark_100};
    color: ${t.var.color.primary};
  }
  
  ${isActive ? `
    font-weight: 600;
  ` : ''}
}`;
'''
      }
    },
