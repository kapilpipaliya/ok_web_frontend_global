{
  vertexes: [
    {
      id: "1",
      L: "Component",
      P: {
        key: "DecodeCommerceNavigationHeader"
      }
    },
    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header",
  onMount: () => {
    (function(w, d, s, u) {
      w.RocketChat = function(c) { w.RocketChat._.push(c) }; w.RocketChat._ = []; w.RocketChat.url = u;
      var h = d.getElementsByTagName(s)[0], j = d.createElement(s);
      j.async = true; j.src = 'https://rocket.decodeui.io/livechat/rocketchat-livechat.min.js?_=201903270000';
      h.parentNode.insertBefore(j, h);
    })(window, document, 'script', 'https://rocket.decodeui.io/livechat');
  }
};
''',
        css: '''
return `._id {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: ${args.theme.var.color.background};
  border-bottom: 1px solid ${args.theme.var.color.background_dark_200};
  transition: all 0.3s ease;
}`;
'''
      }
    },
    {
      id: "3",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "nav"
};
''',
        css: '''
return `._id {
  max-width: 1200px;
  margin: 0 auto;
  padding: 1rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  
  @media (max-width: 768px) {
    padding: 0.75rem 1rem;
  }
}`;
'''
      }
    },
    {
      id: "4",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "a",
  href: "/",
  text: "DecodeCommerce"
};
''',
        css: '''
return `._id {
  font-size: 1.5rem;
  font-weight: 700;
  color: ${args.theme.var.color.primary};
  text-decoration: none;
  transition: all 0.2s ease;
  
  &:hover {
    color: ${args.theme.var.color.primary_dark_200};
  }
  
  @media (max-width: 768px) {
    font-size: 1.25rem;
  }
}`;
'''
      }
    },
    {
      id: "5",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 2rem;
  
  @media (max-width: 768px) {
    gap: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "6",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Data",
        name: "navItems",
        loop: true,
        props: '''
return {
  data: [
    { href: "/", text: "Home" },
    { href: "/features", text: "Features" },
    { href: "/pricing", text: "Pricing" },
    { href: "/about", text: "About" },
    { href: "/contact", text: "Contact" }
  ]
};
'''
      }
    },
    {
      id: "7",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.navItems;
const currentPath = args.location.pathname;
const isActive = item.href === currentPath || (item.href === "/" && currentPath === "/");
return {
  as: "a",
  href: item.href,
  text: item.text
};
''',
        css: '''
const item = args.contextData.navItems;
const currentPath = args.location.pathname;
const isActive = item.href === currentPath || (item.href === "/" && currentPath === "/");
return `._id {
  color: ${isActive ? args.theme.var.color.primary : args.theme.var.color.text};
  text-decoration: none;
  font-weight: ${isActive ? '600' : '500'};
  transition: all 0.2s ease;
  position: relative;
  
  ${isActive ? `
    &::after {
      content: '';
      position: absolute;
      bottom: -0.25rem;
      left: 0;
      right: 0;
      height: 2px;
      background: ${args.theme.var.color.primary};
      border-radius: 1px;
    }
  ` : ''}
  
  &:hover {
    color: ${args.theme.var.color.primary};
  }
  
  @media (max-width: 768px) {
    display: none;
  }
}`;
'''
      }
    },
    {
      id: "8",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const currentMode = args.currentMode();
const isDark = currentMode === "dark";
return {
  as: "button",
  onClick: args.toggleTheme
};
''',
        css: '''
return `._id {
  background: transparent;
  border: 1px solid ${args.theme.var.color.background_dark_200};
  border-radius: 0.5rem;
  padding: 0.5rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  
  &:hover {
    background: ${args.theme.var.color.background_dark_100};
    border-color: ${args.theme.var.color.background_dark_300};
  }
}`;
'''
      }
    },
    {
      id: "9",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const currentMode = args.currentMode();
const isDark = currentMode === "dark";
return {
  as: "icon",
  icon: isDark ? "carbon:sun" : "carbon:moon",
  width: 20,
  height: 20
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text};
}`;
'''
      }
    }
  ],
  edges: [
