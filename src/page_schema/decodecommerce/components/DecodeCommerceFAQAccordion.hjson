    {
      id: "9",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Data",
        name: "faqs",
        loop: true,
        props: '''
const faqData = [
  {
    question: "How quickly can I get my eCommerce site live?",
    answer: "Our standard delivery time is 2 months from project kickoff. For Professional and Enterprise plans, we offer expedited delivery options that can have your site live in as little as 6 weeks."
  },
  {
    question: "Do you provide ongoing support after launch?",
    answer: "Yes! All our plans include ongoing support. Starter plans include email support, while Professional and Enterprise plans include priority support with faster response times and a dedicated account manager."
  },
  {
    question: "Can you work with my existing NetSuite customizations?",
    answer: "Absolutely. Our team specializes in NetSuite integrations and can work with your existing customizations, workflows, and business processes to ensure seamless integration."
  },
  {
    question: "What if I need custom features not listed in the plans?",
    answer: "We love custom challenges! Our Professional and Enterprise plans include custom feature development. Contact our sales team to discuss your specific requirements."
  },
  {
    question: "Is the platform really SEO-friendly?",
    answer: "Yes! Every site we build includes SEO best practices: semantic HTML, fast loading times, mobile optimization, structured data, and clean URLs. We also provide SEO training as part of the handover."
  },
  {
    question: "What's your refund policy?",
    answer: "We offer a 30-day money-back guarantee if you're not satisfied with the initial prototype. After development begins, we work closely with you to ensure the final product meets your expectations."
  }
];

return {
  data: faqData.map((item, idx) => ({ ...item, index: idx }))
};
'''
      }
    },
    {
      id: "10",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const faq = args.contextData.faqs;
const faqState = args.contextData.faqState;
const index = faq.index;
const isOpen = faqState.openIndex() === index;
return {
  as: "div"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.background};
  border: 1px solid ${args.theme.var.color.background_dark_200};
  border-radius: 0.75rem;
  overflow: hidden;
  transition: all 0.3s ease;
  
  &:hover {
    border-color: ${args.theme.var.color.primary_light_500};
  }
}`;
'''
      }
    },
    {
      id: "11",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const faq = args.contextData.faqs;
const faqState = args.contextData.faqState;
const index = faq.index;
const isOpen = faqState.openIndex() === index;
return {
  as: "button",
  onClick: () => faqState.setOpenIndex(isOpen ? null : index)
};
''',
        css: '''
const faq = args.contextData.faqs;
const faqState = args.contextData.faqState;
const index = faq.index;
const isOpen = faqState.openIndex() === index;
return `._id {
  width: 100%;
  padding: 1.25rem;
  background: ${isOpen ? args.theme.var.color.primary_light_900 : 'transparent'};
  border: none;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-align: left;
  transition: all 0.2s ease;
  
  &:hover {
    background: ${isOpen ? args.theme.var.color.primary_light_850 : args.theme.var.color.background_light_100};
  }
}`;
'''
      }
    },
