''',
        css: '''
const faq = args.contextData.faqs;
const faqState = args.contextData.faqState;
const index = faq.index;
const isOpen = faqState.openIndex() === index;
return isOpen ? [
  `._id {
    padding: 1rem 1.25rem 1.5rem;
    animation: slideDown 0.3s ease-out;
  }`,
  `@keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }`
] : '';
'''
      }
