return {
  as: "div"
};
''',
        css: '''
const plan = args.contextData.plans;
return `._id {
  background: ${args.theme.var.color.background};
  border: 2px solid ${plan.featured ? args.theme.var.color.primary : args.theme.var.color.background_dark_200};
  border-radius: 1rem;
  padding: 2rem;
  position: relative;
  transition: all 0.3s ease;
  ${plan.featured ? 'transform: scale(1.05);' : ''}
  
  &:hover {
    transform: translateY(-5px) ${plan.featured ? 'scale(1.05)' : ''};
    box-shadow: 0 10px 40px ${args.theme.var.color.text_light_850};
  }
}`;
'''
      }
    },
