        css: '''
return `._id {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  padding: 1.25rem 2.5rem;
  border-radius: 0.5rem;
  text-decoration: none;
  font-weight: 600;
  font-size: 1.1rem;
  transition: all 0.2s ease;
  box-shadow: 0 5px 15px ${args.theme.var.color.primary_light_300};
  
  &:hover {
    background: ${args.theme.var.color.primary_dark_200};
    transform: translateY(-2px);
    box-shadow: 0 8px 25px ${args.theme.var.color.primary_light_400};
  }
  
  @media (max-width: 768px) {
    padding: 1rem 2rem;
    font-size: 1rem;
  }
}`;
'''
