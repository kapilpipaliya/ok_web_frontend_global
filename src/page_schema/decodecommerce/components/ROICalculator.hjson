    {
      id: "7",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        contextName: "roiState",
        props: '''
// Input signals
const [monthlyVisitors, setMonthlyVisitors] = _.createSignal(10000);
const [conversionRate, setConversionRate] = _.createSignal(2); // percentage
const [avgOrderValue, setAvgOrderValue] = _.createSignal(75);
const [grossMargin, setGrossMargin] = _.createSignal(60); // percentage
const [timeframe, setTimeframe] = _.createSignal(6); // months
const serviceCost = 5000; // per month

// ROI Calculation
const calculateROI = () => {
  const monthlyOrders = monthlyVisitors() * (conversionRate() / 100);
  const monthlyRevenue = monthlyOrders * avgOrderValue();
  const monthlyProfit = monthlyRevenue * (grossMargin() / 100);
  
  const totalRevenue = monthlyRevenue * timeframe();
  const totalProfit = monthlyProfit * timeframe();
  const totalInvestment = serviceCost * timeframe();
  
  const netProfit = totalProfit - totalInvestment;
  const roi = ((netProfit) / totalInvestment) * 100;
  
  return {
    monthlyRevenue,
    totalRevenue,
    totalProfit,
    totalInvestment,
    netProfit,
    roi: Math.round(roi),
    breakeven: totalInvestment / monthlyProfit // months to breakeven
  };
};

return {
  data: {
    monthlyVisitors,
    setMonthlyVisitors,
    conversionRate,
    setConversionRate,
    avgOrderValue,
    setAvgOrderValue,
    grossMargin,
    setGrossMargin,
    timeframe,
    setTimeframe,
    serviceCost,
    calculateROI
  }
};
'''
      }
    },
