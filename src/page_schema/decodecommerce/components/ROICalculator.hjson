        componentName: "Html",
        props: '''
const state = c.roiState;
return {
  as: "input",
  type: "range",
  min: 1000,
  max: 100000,
  step: 1000,
  value: state.monthlyVisitors(),
  onInput: (e) => state.setMonthlyVisitors(parseInt(e.target.value))
};
''',
        css: '''
return `._id {
  width: 100%;
  height: 8px;
  -webkit-appearance: none;
  appearance: none;
  background: ${t.var.color.background_dark_200};
  border-radius: 4px;
  outline: none;
  position: relative;
  
  &::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    background: ${t.var.color.primary};
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 4px ${t.var.color.primary_light_500};
    border: 2px solid ${t.var.color.background};
    
    &:hover {
      transform: scale(1.1);
      box-shadow: 0 4px 8px ${t.var.color.primary_light_400};
    }
  }
  
  &::-moz-range-thumb {
    width: 24px;
    height: 24px;
    background: ${t.var.color.primary};
    border-radius: 50%;
    cursor: pointer;
    border: 2px solid ${t.var.color.background};
    transition: all 0.2s ease;
    box-shadow: 0 2px 4px ${t.var.color.primary_light_500};
    
    &:hover {
      transform: scale(1.1);
      box-shadow: 0 4px 8px ${t.var.color.primary_light_400};
    }
  }
}`;
'''
