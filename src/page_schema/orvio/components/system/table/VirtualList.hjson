{
  vertexes: [
    {
      id: virtualList_component
      L: Component
      P: {
        key: VirtualList
      }
    }
    {
      id: virtualList_root
      L: Attr
      P: {
        displayOrder: 1
        fns:
          '''
const getItems = () => {
  const getter = args.contextData.props?.getItems;
  if (typeof getter === "function") return getter() || [];
  return args.contextData.props?.items || [];
};

const ROW_HEIGHT = () => args.contextData.props?.itemHeight ?? 50;

const getRowSize = (index) => {
  const fn = args.contextData.props?.getItemHeightAt;
  const items = getItems();
  if (typeof fn === "function") {
    const h = fn(index, items[index]);
    if (typeof h === "number" && !isNaN(h) && h >= 0) return h;
  }
  return ROW_HEIGHT();
};

let virtualizerHandle = null;
const setVirtualizerHandle = (handle) => {
  virtualizerHandle = handle || null;
};

const [listRootEl, setListRootEl] = args.createSignal(null);

const getScrollElement = () => {
  const getter = args.contextData.props?.getScrollContainerElement;
  return typeof getter === "function" ? getter() || null : null;
};

const renderRow = args.createLoopRowRenderer((rowData, index) => {
  const i = index();
  return {
    index: i,
    start: 0,
    size: getRowSize(i),
    rowData,
  };
});

const isTextInputTarget = (target) => {
  if (!target || typeof target !== "object") return false;
  if (target.isContentEditable) return true;
  const tag = target.tagName;
  if (tag === "TEXTAREA" || tag === "SELECT" || tag === "OPTION") return true;
  if (tag === "INPUT") {
    const type = String(target.type || "text").toLowerCase();
    return (
      type !== "checkbox" &&
      type !== "radio" &&
      type !== "button" &&
      type !== "submit" &&
      type !== "reset" &&
      type !== "file" &&
      type !== "hidden"
    );
  }
  return false;
};

const isCheckboxTarget = (target) => {
  if (!target || typeof target !== "object") return false;
  return target.tagName === "INPUT" && String(target.type || "").toLowerCase() === "checkbox";
};

const getActiveIndex = () => args.contextData.props?.getActiveIndex?.() ?? -1;
const setActiveIndex = (n) => args.contextData.props?.setActiveIndex?.(n);
const getItemCount = () => getItems()?.length ?? 0;
const useKeyNav = () => typeof args.contextData.props?.setActiveIndex === "function";

const focusList = () => {
  listRootEl()?.focus?.({ preventScroll: true });
};

const selectIndex = (nextIndex, e) => {
  const len = getItemCount();
  if (len === 0 || nextIndex < 0 || nextIndex >= len) return;

  const current = getActiveIndex();
  if (e?.shiftKey) {
    args.contextData.props?.onShiftArrow?.(current, nextIndex);
  } else {
    args.contextData.props?.clearSelectionAnchor?.();
  }
  setActiveIndex(nextIndex);
  virtualizerHandle?.scrollToIndex?.(nextIndex, { align: "nearest" });
};

const handleListKeyDown = (e) => {
  if (!useKeyNav() || isTextInputTarget(e.target)) return;

  const len = getItemCount();
  if (len === 0) return;

  const current = getActiveIndex();

  switch (e.code) {
    case "ArrowDown":
    case "ArrowUp": {
      e.preventDefault();
      e.stopPropagation();
      const nextIndex =
        e.code === "ArrowDown"
          ? Math.min(current + 1, len - 1)
          : Math.max(current - 1, 0);
      selectIndex(nextIndex, e);
      focusList();
      return;
    }
    case "Space":
    case "Spacebar": {
      if (isCheckboxTarget(e.target)) return;
      if (current >= 0 && args.contextData.props?.onSpaceKey) {
        e.preventDefault();
        e.stopPropagation();
        args.contextData.props.onSpaceKey(current);
      }
      return;
    }
    case "ArrowLeft":
    case "ArrowRight": {
      const onExpandCollapse = args.contextData.props?.onExpandCollapse;
      if (!onExpandCollapse || current < 0) return;
      const row = getItems()[current];
      const expandableGroup = row?._isParent === true && row._parentKey != null;
      const expandableRow = row?.id && args.contextData.props?.rowHasExpansion?.(row) === true;
      if (expandableGroup || expandableRow) {
        e.preventDefault();
        e.stopPropagation();
        onExpandCollapse(current, e.code === "ArrowLeft" ? "collapse" : "expand");
      }
    }
  }
};

const handleListMouseDown = (e) => {
  if (!useKeyNav() || isTextInputTarget(e.target) || isCheckboxTarget(e.target)) return;
  focusList();
};

let scrollKeyNavEl = null;
const detachScrollKeyNav = () => {
  if (!scrollKeyNavEl) return;
  scrollKeyNavEl.removeEventListener("keydown", handleListKeyDown, true);
  scrollKeyNavEl.removeEventListener("mousedown", handleListMouseDown, true);
  scrollKeyNavEl = null;
};
const ensureScrollKeyNav = (el) => {
  if (!useKeyNav() || !el) return;
  if (scrollKeyNavEl === el) return;
  detachScrollKeyNav();
  scrollKeyNavEl = el;
  el.addEventListener("keydown", handleListKeyDown, true);
  el.addEventListener("mousedown", handleListMouseDown, true);
};

return {
  setListRootEl,
  getItems,
  getScrollElement,
  ensureScrollKeyNav,
  detachScrollKeyNav,
  ROW_HEIGHT,
  renderRow,
  setVirtualizerHandle,
  handleListKeyDown,
  handleListMouseDown,
  useKeyNav,
};
'''
        componentName: Html
        props:
          '''
const containerClass = args.contextData.props?.class || args.contextData.props?.containerClass || "";
const mw = args.contextData.props?.contentMinWidthPx;
const minWStyle =
  typeof mw === "number" && mw > 0 ? `min-width: ${mw}px;width:100%;box-sizing:border-box;` : "";
const useKeyNav = args.fns.useKeyNav?.();
const tabIndex = args.contextData.props?.tabIndex;
const role = args.contextData.props?.role;
const ariaLabel = args.contextData.props?.["attr:aria-label"];

return {
  as: "div",
  class: containerClass,
  ref: (el) => {
    args.fns.setListRootEl(el);
    args.fns.ensureScrollKeyNav?.(args.fns.getScrollElement?.());
  },
  ...(minWStyle ? { style: minWStyle } : {}),
  ...(useKeyNav && {
    tabIndex: tabIndex !== undefined ? tabIndex : 0,
    role,
    ...(ariaLabel && { "attr:aria-label": ariaLabel }),
    onKeyDownCapture: args.fns.handleListKeyDown,
    onMouseDownCapture: args.fns.handleListMouseDown,
  }),
};
'''
      }
    }
    {
      id: virtualList_virtua
      L: Attr
      P: {
        displayOrder: 1
        componentName: Virtualizer
        props:
          '''
const scrollEl = args.fns.getScrollElement?.();
const usesExternalScroll = typeof args.contextData.props?.getScrollContainerElement === "function";

if (usesExternalScroll && !scrollEl) {
  return { hide: true };
}

args.fns.ensureScrollKeyNav?.(scrollEl);

const rowHeight = args.fns.ROW_HEIGHT?.() ?? 50;
const getItemHeightAt = args.contextData.props?.getItemHeightAt;
const usesVariableRowHeight = typeof getItemHeightAt === "function";

return {
  data: args.fns.getItems(),
  scrollRef: scrollEl || undefined,
  ...(usesVariableRowHeight ? {} : { itemSize: rowHeight }),
  ref: args.fns.setVirtualizerHandle,
  children: args.fns.renderRow,
};
'''
      }
    }
    {
      id: virtualList_loop
      L: Attr
      P: {
        contextName: virtualItem
        loop: true
        displayOrder: 1
        componentName: Html
        props:
          '''
return { hide: true };
'''
      }
    }
    {
      id: virtualList_slot
      L: Attr
      P: {
        displayOrder: 2
        slot: children
        componentName: Slot
      }
    }
    {
      id: virtualList_variant_containerClass
      L: ComponentVariant
      P: {
        type: string
        key: containerClass
        defValue: ""
      }
    }
    {
      id: virtualList_variant_itemHeight
      L: ComponentVariant
      P: {
        type: number
        key: itemHeight
        defValue: 50
      }
    }
    {
      id: virtualList_variant_items
      L: ComponentVariant
      P: {
        type: array
        key: items
        defValue: []
      }
    }
  ]
  edges: [
    {
      id: virtualList_e_component_root
      T: Attr
      S: virtualList_component
      E: virtualList_root
    }
    {
      id: virtualList_e_variant_containerClass
      T: ComponentVariant
      S: virtualList_component
      E: virtualList_variant_containerClass
    }
    {
      id: virtualList_e_variant_itemHeight
      T: ComponentVariant
      S: virtualList_component
      E: virtualList_variant_itemHeight
    }
    {
      id: virtualList_e_variant_items
      T: ComponentVariant
      S: virtualList_component
      E: virtualList_variant_items
    }
    {
      id: virtualList_e_root_virtua
      T: Attr
      S: virtualList_root
      E: virtualList_virtua
    }
    {
      id: virtualList_e_virtua_loop
      T: Attr
      S: virtualList_virtua
      E: virtualList_loop
    }
    {
      id: virtualList_e_loop_slot
      T: Attr
      S: virtualList_loop
      E: virtualList_slot
    }
  ]
}
