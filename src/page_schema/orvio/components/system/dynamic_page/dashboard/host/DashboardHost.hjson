{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: DashboardHost
        dynamicComponent: DashboardRenderer,DashboardFilterBar,DashboardLayoutRenderer,DashboardWidgetShell,DashboardWidgetRenderer,DashboardMetricCard,DashboardChartWidget,DashboardMarkdownWidget,DashboardQuickActionsWidget,DashboardActivityFeedWidget,DashboardTimelineWidget,DashboardKanbanWidget,DashboardCrudEmbed,CrudRuntimeCore,DashboardEntityDrawer,EntityRuntimeHost,DashboardDevtools
        fns:
          '''
// Dashboard runtime platform — client orchestration; data via server functions only.
const platform = _.dashboardPlatform;

const DASHBOARD_GRAPH_LABEL = {
  RUNTIME: "DashboardRuntime",
  CONFIG: "DashboardConfig",
  SESSION: "DashboardSession",
  WIDGET_STATE: "DashboardWidgetState",
  WIDGET_RESULT: "DashboardWidgetResult"
};

const dashboardGraphIds = (dashboardKey) => ({
  runtime: `local:dashboard_runtime:${dashboardKey}`,
  config: `local:dashboard_config:${dashboardKey}`,
  session: `local:dashboard_session:${dashboardKey}`,
  widgetState: (widgetId) => `local:dashboard_widget_state:${dashboardKey}:${widgetId}`
});

let activeDashboardTxnId = 0;

const initEntityDrawerState = () => ({
  open: false,
  entityType: null,
  entityId: null,
  view: "detail",
  row: null,
  crudConfigRef: null,
  loading: false,
  error: null,
  title: null
});

const initWidgetUiState = (widgetId) => ({
  widgetId,
  filters: {},
  sorting: { column: null, direction: null },
  pagination: { page: 1, pageSize: 25 },
  selection: [],
  expandedRows: {},
  viewMode: "table",
  loading: false,
  error: null,
  empty: false,
  dataResultVertexId: null,
  rowVertexIds: [],
  dataVersion: 0,
  lifecycle: "INIT",
  executionGeneration: 0
});

const applyServerGraphToLocalGraph = (response, txnId) => {
  const graphPayload = response?.result?.graph ?? response?.graph;
  if (!graphPayload || typeof graphPayload !== "object") return;
  const vertexes = graphPayload.vertexes || {};
  const edges = graphPayload.edges || {};
  const deleted_vertexes = graphPayload.deleted_vertexes;
  const deleted_edges = graphPayload.deleted_edges;
  const hasWork =
    Object.keys(vertexes).length > 0 ||
    Object.keys(edges).length > 0 ||
    (Array.isArray(deleted_vertexes) && deleted_vertexes.length > 0) ||
    (Array.isArray(deleted_edges) && deleted_edges.length > 0);
  if (!hasWork) return;
  const tid = txnId != null && txnId > 0 ? txnId : activeDashboardTxnId || 0;
  _.setGraphData(tid, { vertexes, edges, deleted_vertexes, deleted_edges }, {});
};

const patchVertexProperties = (txnId, vertexId, updater) => {
  const vertex = g.vertexes[vertexId];
  if (!vertex) return;
  const previousP = vertex.P || {};
  const nextP =
    typeof updater === "function" ? updater({ ...previousP }) : { ...previousP, ...updater };
  _.setGraphData(txnId, { vertexes: { [vertexId]: { ...vertex, P: nextP } } }, {});
};

const buildDashboardGraphBootstrap = (dashboardKey, config, visibleWidgets) => {
  const ids = dashboardGraphIds(dashboardKey);
  const vertexes = {};
  const edges = {};
  const widgetStateIds = {};
  const defaultTimeRange =
    config.filters.find((filterConfig) => filterConfig?.type === "dateRange")?.default ||
    "last_year";

  vertexes[ids.runtime] = {
    id: ids.runtime,
    L: [DASHBOARD_GRAPH_LABEL.RUNTIME],
    P: {
      dashboardKey,
      configVertexId: ids.config,
      sessionVertexId: ids.session
    },
    IN: {},
    OUT: {}
  };
  vertexes[ids.config] = {
    id: ids.config,
    L: [DASHBOARD_GRAPH_LABEL.CONFIG],
    P: { dashboardKey, config },
    IN: {},
    OUT: {}
  };
  vertexes[ids.session] = {
    id: ids.session,
    L: [DASHBOARD_GRAPH_LABEL.SESSION],
    P: {
      dashboardKey,
      filters: {},
      timeRange: defaultTimeRange,
      layoutState: { type: config.layout.type },
      layoutOverrides: {},
      hiddenWidgets: {},
      entityDrawer: initEntityDrawerState()
    },
    IN: {},
    OUT: {}
  };
  edges[`e_${ids.runtime}_config`] = {
    id: `e_${ids.runtime}_config`,
    T: "DashboardConfig",
    S: ids.runtime,
    E: ids.config
  };
  edges[`e_${ids.runtime}_session`] = {
    id: `e_${ids.runtime}_session`,
    T: "DashboardSession",
    S: ids.runtime,
    E: ids.session
  };

  for (let widgetIndex = 0; widgetIndex < visibleWidgets.length; widgetIndex++) {
    const widgetConfig = visibleWidgets[widgetIndex];
    const stateId = ids.widgetState(widgetConfig.id);
    widgetStateIds[widgetConfig.id] = stateId;
    vertexes[stateId] = {
      id: stateId,
      L: [DASHBOARD_GRAPH_LABEL.WIDGET_STATE],
      P: {
        ...initWidgetUiState(widgetConfig.id),
        widgetId: widgetConfig.id,
        dashboardKey
      },
      IN: {},
      OUT: {}
    };
    edges[`e_${ids.runtime}_ws_${widgetConfig.id}`] = {
      id: `e_${ids.runtime}_ws_${widgetConfig.id}`,
      T: "DashboardWidgetState",
      S: ids.runtime,
      E: stateId
    };
  }

  return { vertexes, edges, ids, widgetStateIds };
};

const DEFAULT_WIDGET = {
  theme: { surface: "subdued", padding: "md", borderRadius: "lg", shadow: "sm" },
  permissions: { roles: [] },
  refresh: { enabled: false },
  layout: { x: 0, y: 0, w: 3, h: 2 },
  viewModes: ["table"]
};

const normalizeWidgetConfig = (widgetConfig) => {
  const base = widgetConfig && typeof widgetConfig === "object" ? widgetConfig : {};
  const type = String(base.type || "");
  if (!type) throw new Error("Dashboard widget requires type");
  const normalized = {
    ...DEFAULT_WIDGET,
    ...base,
    type,
    id: String(base.id || ""),
    layout: { ...DEFAULT_WIDGET.layout, ...(base.layout || {}) },
    theme: { ...DEFAULT_WIDGET.theme, ...(base.theme || {}) },
    permissions: { ...DEFAULT_WIDGET.permissions, ...(base.permissions || {}) },
    queryOverrides: base.queryOverrides || {},
    dataSource: base.dataSource || null,
    interactions: Array.isArray(base.interactions) ? base.interactions : [],
    visibility: Array.isArray(base.visibility) ? base.visibility : [],
    viewModes: Array.isArray(base.viewModes) ? base.viewModes : DEFAULT_WIDGET.viewModes,
    querySignatures: Array.isArray(base.querySignatures) ? base.querySignatures : [],
    logicalQueryKeys: Array.isArray(base.logicalQueryKeys) ? base.logicalQueryKeys : []
  };
  if (platform?.widget) {
    normalized.capabilities = platform.widget.resolveCapabilities(normalized);
    normalized.editor = platform.widget.resolveEditor(normalized);
  }
  return normalized;
};

const normalizeDashboardConfig = (rawConfig) => {
  const config = rawConfig && typeof rawConfig === "object" ? rawConfig : {};
  return {
    key: String(config.key || "dashboard"),
    title: config.title || "",
    subtitle: config.subtitle || "",
    version: Number(config.version || 1),
    mode: config.mode === "edit" ? "edit" : "view",
    layout: {
      type: config.layout?.type || "grid",
      columns: Number(config.layout?.columns || 12),
      rowHeight: Number(config.layout?.rowHeight || 80),
      gap: Number(config.layout?.gap || 16),
      responsive: config.layout?.responsive || { xl: { columns: 12 }, lg: { columns: 12 }, md: { columns: 8 }, sm: { columns: 4 } }
    },
    widgets: Array.isArray(config.widgets) ? config.widgets.map(normalizeWidgetConfig) : [],
    filters: Array.isArray(config.filters) ? config.filters : [],
    actions: Array.isArray(config.actions) ? config.actions : [],
    headerActions: Array.isArray(config.headerActions) ? config.headerActions : [],
    permissions: config.permissions || { roles: [] },
    realtime: {
      enabled: config.realtime?.enabled === true,
      channel: String(config.realtime?.channel || "dashboard"),
      pollingIntervalMs: Number(config.realtime?.pollingIntervalMs || 30000),
      staleWhileRevalidate: config.realtime?.staleWhileRevalidate !== false,
      logicalKey:
        typeof config.realtime?.logicalKey === "string" && config.realtime.logicalKey.trim() !== ""
          ? String(config.realtime.logicalKey)
          : undefined,
      entities: Array.isArray(config.realtime?.entities) ? config.realtime.entities : []
    },
    personalization: {
      allowMoveWidgets: config.personalization?.allowMoveWidgets !== false,
      allowHideWidgets: config.personalization?.allowHideWidgets === true,
      saveLayouts: config.personalization?.saveLayouts !== false
    },
    theme: config.theme || {},
    analytics: config.analytics || { enabled: true },
    entityDrawer: {
      enabled: config.entityDrawer?.enabled !== false,
      defaultView: config.entityDrawer?.defaultView || "detail",
      openOnRowSelect: config.entityDrawer?.openOnRowSelect === true,
      entityProfiles: config.entityDrawer?.entityProfiles || {}
    },
    devtools: config.devtools || { enabled: false },
    scheduler: config.scheduler || { debounceMs: 50, batchWindowMs: 16 }
  };
};

const setWidgetLifecycle = (store, widgetId, phase) => {
  store.patchWidgetState(widgetId, (previous) => {
    const prev = previous || initWidgetUiState(widgetId);
    const next = platform?.lifecycle?.transition?.(prev.lifecycle, phase) || phase;
    return { lifecycle: next };
  });
};

const registerWidgetSubscriptions = (subscriptionGraph, widgetConfig, store) => {
  if (!subscriptionGraph || !widgetConfig?.id) return;
  const composed = composeWidgetQuery(widgetConfig, store);
  const signatures = [...(widgetConfig.querySignatures || []), composed.querySignature].filter(Boolean);
  const logicalKeys = [...(widgetConfig.logicalQueryKeys || [])];
  if (widgetConfig.type === "crudTable" && widgetConfig.crudConfigRef) {
    logicalKeys.push(`crud:${widgetConfig.crudConfigRef}`);
  }
  if (widgetConfig.id) logicalKeys.push(`widget:${widgetConfig.id}`);
  subscriptionGraph.register(widgetConfig.id, signatures, logicalKeys);
};

const composeWidgetQuery = (widgetConfig, store) => {
  if (!store) {
    return { filters: {}, sort: { column: null, direction: null }, limit: null, cacheKey: "", querySignature: "" };
  }
  if (platform?.query?.compose) {
    return platform.query.compose(widgetConfig, store, store.config?.key);
  }
  return { filters: {}, sort: { column: null, direction: null }, limit: null, cacheKey: "", querySignature: "" };
};

const crudWidgetAdapter = (widgetConfig, runtime) => ({
  widgetId: widgetConfig.id,
  crudConfigRef: widgetConfig.crudConfigRef,
  tableVertexLabel: widgetConfig.crudConfigRef,
  composedQuery: () => composeWidgetQuery(widgetConfig, runtime.store),
  refresh: () => runtime.runtimeApi.refreshCrudWidget(widgetConfig.id),
  dispatch: (event) => runtime.runtimeApi.dispatchInteraction(event)
});

const evaluateVisibilityRules = (visibilityRules, context) => {
  if (!Array.isArray(visibilityRules) || visibilityRules.length === 0) return true;
  for (let index = 0; index < visibilityRules.length; index++) {
    const rule = visibilityRules[index];
    if (!rule?.condition) continue;
    try {
      const fn = new Function("context", `return (${rule.condition});`);
      if (!fn(context)) return false;
    } catch (error) {
      return false;
    }
  }
  return true;
};

const hasDashboardRolePermission = (permissionConfig) => {
  const roles = Array.isArray(permissionConfig?.roles) ? permissionConfig.roles : [];
  if (roles.length === 0) return true;
  const userRole = _.user?.P?.role;
  return userRole != null && roles.includes(userRole);
};

const filterVisibleWidgets = (dashboardConfig) => {
  if (!hasDashboardRolePermission(dashboardConfig.permissions)) return [];
  return dashboardConfig.widgets.filter((widgetConfig) => {
    const context = { user: _.user, graph: g, dashboard: dashboardConfig, widget: widgetConfig };
    return hasDashboardRolePermission(widgetConfig.permissions) && evaluateVisibilityRules(widgetConfig.visibility, context);
  });
};

const isInIframe = () => typeof window !== "undefined" && window.self !== window.top;

const resolveHeaderActions = async (headerActions) => {
  const actions = Array.isArray(headerActions) ? headerActions : [];
  const resolved = [];

  for (let index = 0; index < actions.length; index++) {
    const action = actions[index];
    if (!action || typeof action !== "object") continue;
    if (action.showInIframeOnly === true && !isInIframe()) continue;

    const type = String(action.type || "route").trim();

    if (type === "route") {
      const href = String(action.to || action.href || "").trim();
      if (!href) continue;
      resolved.push({
        key: String(action.key || `route_${index}`),
        label: String(action.label || action.key || "Open").trim() || "Open",
        href,
        openInNewTab: action.openInNewTab === true,
        variant: action.variant || "secondary"
      });
      continue;
    }

    if (type === "external") {
      const href = String(action.href || "").trim();
      if (!href || href === "#") continue;
      resolved.push({
        key: String(action.key || `external_${index}`),
        label: String(action.label || action.key || "Open").trim() || "Open",
        href,
        openInNewTab: action.openInNewTab !== false,
        variant: action.variant || "secondary"
      });
      continue;
    }

    if (type === "settingsLink") {
      const functionName = String(action.resolveFunction || "").trim();
      if (!functionName) continue;
      try {
        const res = await s({
          functionName,
          contextData: action.resolveContext || {}
        });
        const ok = res?.result?.success !== false && !res?.error;
        if (!ok) continue;
        const data = res?.result?.data || res?.data || {};
        const enabledField = action.enabledField || "enabled";
        if (data[enabledField] === false) continue;
        const href = String(data[action.hrefField || "href"] || "").trim();
        if (!href || href === "#") continue;
        const label =
          String(data[action.labelField || "label"] || action.label || action.key || "Open").trim() ||
          "Open";
        resolved.push({
          key: String(action.key || `settings_${index}`),
          label,
          href,
          openInNewTab: action.openInNewTab !== false,
          variant: action.variant || "secondary"
        });
      } catch (error) {
        console.warn("resolveHeaderActions settingsLink failed:", functionName, error);
      }
    }
  }

  return resolved;
};

const executeDataSource = async ({ widgetConfig, store, dashboardKey }) => {
  if (widgetConfig.type === "crudTable") {
    return { success: true, data: { crudConfigRef: widgetConfig.crudConfigRef || null, rows: [] } };
  }
  const dataSource = widgetConfig?.dataSource;
  if (!dataSource?.type) return { success: true, data: { value: 0, rows: [] } };

  const response = await s({
    functionName: "executeDashboardDataSource",
    contextData: {
      widgetId: widgetConfig.id,
      widgetType: widgetConfig.type,
      dataSource,
      dashboardKey,
      dashboardFilters: store.filters(),
      timeRange: store.timeRange(),
      widgetTrend: widgetConfig.trend || null,
      timestampField: widgetConfig.dataSource?.timestampField || "updatedAt"
    }
  });
  if (response?.error) return { success: false, message: response.error, data: null };
  const result = response?.result;
  if (!result?.success) return { success: false, message: result?.message || "Failed to load widget data", data: null };
  applyServerGraphToLocalGraph(response, activeDashboardTxnId);
  return { success: true, data: result.data || {}, meta: result.meta || {} };
};

const buildInteractionRegistry = (config, visibleWidgets, runtimeApiRef) => ({
  SET_FILTER: (event, store) => {
    store.setFilters({ ...store.filters(), ...(event.payload || {}) });
    void runtimeApiRef.refreshAllWidgets();
  },
  NAVIGATE: (event) => {
    const href = event?.to || event?.payload?.href;
    if (href) _.navigate(href);
  },
  OPEN_ENTITY_DRAWER: (event, store) => {
    const payload = event.payload || {};
    const row = payload.row;
    const entityType = payload.entityType || payload.crudConfigRef;
    const entityId = payload.entityId || row?.id;
    const profile = config.entityDrawer?.entityProfiles?.[entityType] || {};
    const crudConfigRef = payload.crudConfigRef || profile.crudConfigRef || entityType;
    const view = payload.view || config.entityDrawer?.defaultView || "detail";
    let title = null;
    if (row && profile.titleField && row.P?.[profile.titleField]) {
      title = String(row.P[profile.titleField]);
    }
    store.patchSession((session) => ({
      ...session,
      entityDrawer: {
        ...initEntityDrawerState(),
        open: true,
        entityType: entityType ? String(entityType) : null,
        entityId: entityId != null ? String(entityId) : null,
        view,
        row: row || null,
        crudConfigRef: crudConfigRef ? String(crudConfigRef) : null,
        loading: !row && !!entityId,
        error: null,
        title
      }
    }));
  },
  SELECT_ENTITY: (event, store, runtimeApi) => {
    runtimeApi.dispatchInteraction({
      type: "OPEN_ENTITY_DRAWER",
      sourceWidgetId: event.sourceWidgetId,
      payload: event.payload
    });
  },
  REFRESH_WIDGET: (event, store, runtimeApi) => {
    if (event?.widgetId) {
      void runtimeApi.refreshWidget(event.widgetId, {
        reason: "manual_refresh",
        bypassCache: true
      });
    }
  },
  REFRESH_DASHBOARD: (event, store, runtimeApi) => {
    void runtimeApi.refreshAllWidgets();
  },
  SET_TIME_RANGE: (event, store) => {
    if (event?.value != null) store.setTimeRange(event.value);
    void runtimeApiRef.refreshAllWidgets();
  },
  ROW_SELECTED: (event, store, runtimeApi) => {
    const row = event.payload?.row;
    if (!row || !config.entityDrawer?.enabled || !config.entityDrawer?.openOnRowSelect) return;
    const sourceWidget = visibleWidgets.find((w) => w.id === event.sourceWidgetId);
    const entityType = event.payload?.entityType || sourceWidget?.crudConfigRef;
    if (!entityType) return;
    void runtimeApi.dispatchInteraction({
      type: "OPEN_ENTITY_DRAWER",
      sourceWidgetId: event.sourceWidgetId,
      payload: {
        entityType,
        entityId: String(row.id),
        view: config.entityDrawer?.defaultView || "detail",
        row
      }
    });
  },
  ENTITY_CREATED: (event, store, runtimeApi) => { runtimeApi.publishMutation(event); },
  ENTITY_UPDATED: (event, store, runtimeApi) => { runtimeApi.publishMutation(event); },
  ENTITY_DELETED: (event, store, runtimeApi) => { runtimeApi.publishMutation(event); },
  RELATION_CREATED: (event, store, runtimeApi) => { runtimeApi.publishMutation(event); },
  RELATION_REMOVED: (event, store, runtimeApi) => { runtimeApi.publishMutation(event); }
});

const resolveWidgetLayout = (widgetConfig, dashboardConfig, layoutOverrides, breakpoint) => {
  const override = layoutOverrides?.[widgetConfig.id];
  const layout = override || widgetConfig.layout || {};
  const responsiveLayout = layout.responsive?.[breakpoint];
  const merged = { ...layout, ...(responsiveLayout || {}) };
  return {
    x: Number(merged.x || 0),
    y: Number(merged.y || 0),
    w: Number(merged.w || 3),
    h: Number(merged.h || 2),
    minW: merged.minW != null ? Number(merged.minW) : 1,
    minH: merged.minH != null ? Number(merged.minH) : 1
  };
};

const [breakpoint, setBreakpoint] = _.createSignal("lg");
const [runtimeState, setRuntimeState] = _.createSignal(null);
let breakpointCleanup = null;

const installBreakpointListener = () => {
  if (typeof window === "undefined") return;
  const update = () => {
    const width = window.innerWidth;
    const next =
      width >= 1280 ? "xl" : width >= 1024 ? "lg" : width >= 768 ? "md" : "sm";
    setBreakpoint(next);
  };
  update();
  window.addEventListener("resize", update);
  breakpointCleanup = () => window.removeEventListener("resize", update);
};

const saveDashboardLayout = async (store, config) => {
  if (config.personalization?.saveLayouts === false) return;
  const session = store.getSession();
  await s({
    functionName: "saveDashboardPreference",
    contextData: {
      dashboardKey: config.key,
      state: {
        filters: session.filters || {},
        timeRange: session.timeRange,
        layoutState: session.layoutState || {},
        layoutOverrides: session.layoutOverrides || {},
        hiddenWidgets: session.hiddenWidgets || {}
      }
    }
  });
};

const createRuntime = async (rawDashboardConfig) => {
  const config = normalizeDashboardConfig(rawDashboardConfig);
  const visibleWidgets = filterVisibleWidgets(config);
  const resolvedHeaderActions = await resolveHeaderActions(config.headerActions);
  const [selections, setSelections] = _.createSignal({});

  activeDashboardTxnId = _.generateNewTxnId(g, sg);
  const graphBootstrap = buildDashboardGraphBootstrap(config.key, config, visibleWidgets);
  _.setGraphData(activeDashboardTxnId, graphBootstrap, {});

  const [ui, setUi] = _.createStore({
    runtimeVertexId: graphBootstrap.ids.runtime,
    configVertexId: graphBootstrap.ids.config,
    sessionVertexId: graphBootstrap.ids.session,
    widgetStateIds: graphBootstrap.widgetStateIds,
    dashboard: { loading: true, mode: config.mode }
  });

  const getSessionVertex = () => g.vertexes[ui.sessionVertexId];
  const getConfigFromGraph = () => g.vertexes[ui.configVertexId]?.P?.config || config;

  const getSession = () => getSessionVertex()?.P || {};
  const patchSession = (updater) => patchVertexProperties(activeDashboardTxnId, ui.sessionVertexId, updater);

  const getWidgetStateVertexId = (widgetId) => ui.widgetStateIds[widgetId];
  const getWidgetState = (widgetId) => {
    const vertexId = getWidgetStateVertexId(widgetId);
    return vertexId ? g.vertexes[vertexId]?.P || null : null;
  };

  const resolveWidgetPresentation = (widgetId) => {
    const state = getWidgetState(widgetId) || {};
    const resultVertexId = state.dataResultVertexId;
    const resultP = resultVertexId ? g.vertexes[resultVertexId]?.P || {} : {};
    const rowIds = Array.isArray(state.rowVertexIds) ? state.rowVertexIds : [];
    const rows = [];
    for (let rowIndex = 0; rowIndex < rowIds.length; rowIndex++) {
      const rowVertex = g.vertexes[rowIds[rowIndex]];
      if (rowVertex) rows.push(rowVertex);
    }
    return {
      value: resultP.value,
      trend: resultP.trend,
      chart: resultP.chart,
      rows,
      count: resultP.count,
      crudConfigRef: resultP.crudConfigRef,
      meta: resultP.meta
    };
  };

  const patchWidgetState = (widgetId, partial) => {
    const vertexId = getWidgetStateVertexId(widgetId);
    if (!vertexId) return;
    patchVertexProperties(activeDashboardTxnId, vertexId, (previous) => ({
      ...previous,
      ...(typeof partial === "function" ? partial(previous) : partial)
    }));
  };

  const store = {
    get config() {
      return getConfigFromGraph();
    },
    txnId: activeDashboardTxnId,
    filters: () => getSession().filters || {},
    setFilters: (next) => {
      patchSession((session) => ({
        ...session,
        filters: typeof next === "function" ? next(session.filters || {}) : next
      }));
    },
    selections,
    setSelections,
    timeRange: () => getSession().timeRange,
    setTimeRange: (value) => {
      patchSession((session) => ({ ...session, timeRange: value }));
    },
    ui,
    setUi,
    getSession,
    patchSession,
    getWidgetState,
    resolveWidgetPresentation,
    patchWidgetState,
    getWidgetStateVertexId
  };

  const getDisplayWidgets = () => {
    if (store.ui.dashboard.mode === "edit") {
      return visibleWidgets;
    }
    const hidden = getSession().hiddenWidgets || {};
    return visibleWidgets.filter((widgetConfig) => hidden[widgetConfig.id] !== true);
  };

  const runtimeScope = platform?.scope?.create
    ? platform.scope.create("dashboard")
    : { scopeId: "dashboard_root", parentScopeId: null, namespace: "dashboard_root", kind: "dashboard" };
  const entityRuntimeScope = platform?.scope?.create
    ? platform.scope.create("entity", runtimeScope.scopeId)
    : runtimeScope;
  const dashboardCache = platform?.cache?.create ? platform.cache.create() : null;
  const subscriptionGraph = platform?.subscriptions?.createGraph ? platform.subscriptions.createGraph() : null;
  const devtoolsEnabled =
    config.devtools?.enabled === true ||
    _.searchParams?.dashboardDevtools === "1" ||
    _.searchParams?.dashboardDevtools === "true";
  const devtools = platform?.devtools?.createCollector ? platform.devtools.createCollector(devtoolsEnabled) : null;
  const runtimeTelemetry = platform?.telemetry?.create ? platform.telemetry.create() : null;
  const runtimeEventLog = platform?.eventLog?.create ? platform.eventLog.create() : null;
  const resourceOwnership = platform?.ownership?.createGraph ? platform.ownership.createGraph() : null;
  const executionCoordinator = platform?.execution?.createCoordinator
    ? platform.execution.createCoordinator()
    : null;
  const lifetimeTree = platform?.lifetime?.createTree
    ? platform.lifetime.createTree(runtimeScope.scopeId)
    : null;
  if (resourceOwnership && lifetimeTree) resourceOwnership.bindLifetimeTree(lifetimeTree);
  if (lifetimeTree) {
    lifetimeTree.register(entityRuntimeScope.scopeId, {
      parentScopeId: runtimeScope.scopeId,
      kind: "entity"
    });
  }
  let scheduler = null;

  for (let widgetIndex = 0; widgetIndex < visibleWidgets.length; widgetIndex++) {
    setWidgetLifecycle(store, visibleWidgets[widgetIndex].id, "INIT");
  }

  const crudRefreshCallbacks = {};
  let layoutSaveTimer = null;
  const scheduleLayoutSave = () => {
    if (layoutSaveTimer) clearTimeout(layoutSaveTimer);
    layoutSaveTimer = setTimeout(() => {
      layoutSaveTimer = null;
      void saveDashboardLayout(store, config);
    }, 600);
  };

  const isForceRefresh = (refreshMeta) => {
    if (refreshMeta?.bypassCache === true) return true;
    const reason = String(refreshMeta?.reason || "");
    return (
      reason === "manual_refresh" ||
      reason === "refresh_all" ||
      reason.includes("manual_refresh") ||
      reason.includes("refresh_all")
    );
  };

  const refreshWidget = async (widgetId, meta) => {
    const widgetConfig = visibleWidgets.find((widget) => widget.id === widgetId);
    if (!widgetConfig || widgetConfig.type === "crudTable") return;

    registerWidgetSubscriptions(subscriptionGraph, widgetConfig, store);
    const composed = composeWidgetQuery(widgetConfig, store);
    const signature = composed.querySignature || composed.cacheKey || widgetId;
    const swr = meta?.staleWhileRevalidate === true;
    const forceRefresh = isForceRefresh(meta);
    const scopeId = runtimeScope.scopeId;

    if (forceRefresh && executionCoordinator) {
      executionCoordinator.cancelWidget(widgetId, scopeId);
    }

    const generation = executionCoordinator
      ? executionCoordinator.getWidgetGeneration(widgetId, scopeId)
      : (getWidgetState(widgetId)?.executionGeneration || 0);

    if (dashboardCache && signature) {
      dashboardCache.abortPending(signature);
      if (forceRefresh) {
        dashboardCache.invalidateWidgets([widgetId]);
      }
      const cached = dashboardCache.getWidget(widgetId);
      if (cached && cached.querySignature === signature && !swr && !forceRefresh) {
        runtimeTelemetry?.recordCacheHit?.();
        runtimeEventLog?.push?.("cache_hit", { widgetId, signature }, meta?.causality);
        store.patchWidgetState(widgetId, {
          loading: false,
          error: null,
          empty: false,
          dataResultVertexId: cached.dataResultVertexId || null,
          rowVertexIds: cached.rowVertexIds || [],
          executionGeneration: generation
        });
        setWidgetLifecycle(store, widgetId, "READY");
        return;
      }
      if (cached && swr) setWidgetLifecycle(store, widgetId, "STALE_PENDING_REFRESH");
      if (!cached || cached.querySignature !== signature) {
        runtimeTelemetry?.recordCacheMiss?.();
        runtimeEventLog?.push?.("cache_miss", { widgetId, signature }, meta?.causality);
      }
      dashboardCache.createAbort(signature);
    }

    const fetchStartedAt = Date.now();
    const handle = executionCoordinator
      ? executionCoordinator.begin({
          runtimeScopeId: scopeId,
          widgetId,
          querySignature: signature,
          generation,
          parentMutationId: meta?.parentMutationId,
          reason: meta?.reason
        })
      : { executionId: `local_${widgetId}`, generation, widgetId, querySignature: signature };

    if (!handle) return;
    runtimeEventLog?.push?.(
      "execution_begin",
      { executionId: handle.executionId, widgetId, signature },
      meta?.causality
    );
    if (devtools) devtools.pushExecution({ phase: "begin", handle, generation });

    setWidgetLifecycle(store, widgetId, swr ? "STALE_PENDING_REFRESH" : "REFRESHING");
    store.patchWidgetState(widgetId, {
      loading: swr !== true,
      error: null,
      executionGeneration: generation
    });

    let result;
    try {
      result = await executeDataSource({ widgetConfig, store, dashboardKey: config.key });
    } catch (error) {
      if (executionCoordinator) executionCoordinator.cancel(handle.executionId, "fetch_error");
      store.patchWidgetState(widgetId, { loading: false, error: error?.message || "Failed to load" });
      setWidgetLifecycle(store, widgetId, "ERROR");
      if (devtools) devtools.pushExecution({ phase: "error", executionId: handle.executionId });
      return;
    }

    if (executionCoordinator && !executionCoordinator.enterPendingCommit(handle.executionId)) {
      runtimeTelemetry?.recordStaleReject?.();
      runtimeEventLog?.push?.(
        "execution_stale",
        { executionId: handle.executionId, widgetId },
        meta?.causality
      );
      setWidgetLifecycle(store, widgetId, "CANCELLED");
      if (devtools) devtools.pushExecution({ phase: "stale_rejected", executionId: handle.executionId });
      return;
    }
    runtimeEventLog?.push?.(
      "execution_pending_commit",
      { executionId: handle.executionId, widgetId },
      meta?.causality
    );
    setWidgetLifecycle(store, widgetId, "PENDING_COMMIT");

    const commitResult = executionCoordinator
      ? executionCoordinator.commit(handle.executionId, { generation })
      : { ok: true };

    if (!commitResult.ok) {
      runtimeTelemetry?.recordStaleReject?.();
      runtimeEventLog?.push?.(
        "execution_stale",
        { executionId: handle.executionId, widgetId, phase: "commit" },
        meta?.causality
      );
      setWidgetLifecycle(store, widgetId, "CANCELLED");
      if (devtools) devtools.pushExecution({ phase: "commit_stale", executionId: handle.executionId });
      return;
    }

    if (!result.success) {
      store.patchWidgetState(widgetId, {
        loading: false,
        error: result.message || "Failed to load",
        dataResultVertexId: null,
        rowVertexIds: []
      });
      setWidgetLifecycle(store, widgetId, "ERROR");
      return;
    }

    const payload = result.data || {};
    const resultVertexId = payload.resultVertexId || null;
    const rowVertexIds = Array.isArray(payload.rowVertexIds) ? payload.rowVertexIds : [];
    const resultP = resultVertexId ? g.vertexes[resultVertexId]?.P || {} : {};
    const isEmpty =
      (resultP.value == null || resultP.value === 0) &&
      rowVertexIds.length === 0 &&
      !resultP.chart &&
      !resultP.crudConfigRef;
    const resultMeta = result.meta || {};
    const prevVersion = getWidgetState(widgetId)?.dataVersion || 0;

    store.patchWidgetState(widgetId, {
      loading: false,
      error: null,
      dataResultVertexId: resultVertexId,
      rowVertexIds,
      empty: isEmpty,
      executionGeneration: generation,
      dataVersion: prevVersion + 1
    });
    setWidgetLifecycle(store, widgetId, "READY");

    if (dashboardCache && signature) {
      const ttlSeconds = Number(widgetConfig.dataSource?.cache?.ttl || 0);
      dashboardCache.setWidget(
        widgetId,
        signature,
        {
          dataResultVertexId: resultVertexId,
          rowVertexIds,
          meta: resultMeta,
          fetchedAt: Date.now(),
          querySignature: signature
        },
        ttlSeconds > 0 ? ttlSeconds : undefined
      );
    }
    runtimeTelemetry?.recordExecutionDuration?.(Date.now() - fetchStartedAt);
    runtimeEventLog?.push?.(
      "execution_commit",
      { executionId: handle.executionId, widgetId, generation },
      meta?.causality
    );
    runtimeEventLog?.push?.("lifecycle", { widgetId, phase: "READY" }, meta?.causality);
    if (devtools) devtools.pushExecution({ phase: "committed", executionId: handle.executionId, generation });
  };

  const refreshCrudWidget = (widgetId) => {
    const callback = crudRefreshCallbacks[widgetId];
    if (typeof callback === "function") callback();
  };

  const resolveInvalidationTargets = (event) => {
    const out = new Set(event?.widgetIds || []);
    if (subscriptionGraph && event?.querySignatures?.length) {
      for (const id of subscriptionGraph.resolveWidgetsForSignatures(event.querySignatures)) out.add(id);
    }
    if (subscriptionGraph && event?.logicalKeys?.length) {
      for (const id of subscriptionGraph.resolveWidgetsForLogicalKeys(event.logicalKeys)) out.add(id);
    }
    return [...out];
  };

  const executeScheduledRefresh = async (widgetIds, meta) => {
    runtimeEventLog?.push?.(
      "scheduler_flush",
      { widgetIds, reason: meta?.reason, coalesced: meta?.coalescedWidgetCount },
      meta?.causality
    );
    for (let index = 0; index < widgetIds.length; index++) {
      const widgetId = widgetIds[index];
      const widgetConfig = visibleWidgets.find((w) => w.id === widgetId);
      if (!widgetConfig) continue;
      if (widgetConfig.type === "crudTable") refreshCrudWidget(widgetId);
      else await refreshWidget(widgetId, meta);
    }
    if (devtools && scheduler) {
      devtools.pushScheduler(scheduler.getState());
      if (runtimeTelemetry) devtools.setTelemetry(runtimeTelemetry.snapshot());
    }
  };

  let invalidationCompression = null;

  const applyInvalidation = (event, batchMeta) => {
    const targets =
      batchMeta?.widgetIds?.length > 0
        ? batchMeta.widgetIds
        : resolveInvalidationTargets(event || {});
    const causality =
      event?.causality ||
      (platform?.causality?.create
        ? platform.causality.create({
            source: event?.source || "system",
            cause: event?.reason,
            mutationId: event?.mutationId,
            realtimeEventId: event?.realtimeEventId
          })
        : null);

    for (let index = 0; index < targets.length; index++) {
      const widgetId = targets[index];
      const widgetConfig = visibleWidgets.find((w) => w.id === widgetId);
      if (executionCoordinator && widgetConfig?.type !== "crudTable") {
        executionCoordinator.cancelWidget(widgetId, runtimeScope.scopeId);
      }
    }
    if (event?.querySignatures?.length && dashboardCache) {
      dashboardCache.invalidateSignatures(event.querySignatures);
    }
    if (event?.widgetIds?.length && dashboardCache) {
      dashboardCache.invalidateWidgets(event.widgetIds);
    }

    runtimeTelemetry?.recordInvalidationFanout?.(
      targets.length,
      batchMeta?.rawEventCount || event?.rawEventCount || 1
    );
    runtimeEventLog?.push?.(
      "invalidate",
      {
        targets,
        logicalKeys: event?.logicalKeys,
        querySignatures: event?.querySignatures,
        batchId: batchMeta?.batchId
      },
      causality
    );
    if (devtools) devtools.pushInvalidation({ ...event, causality }, targets);

    if (scheduler && targets.length > 0) {
      runtimeTelemetry?.recordSchedulerEnqueue?.(scheduler.getState().queue.length + targets.length);
      runtimeEventLog?.push?.(
        "scheduler_enqueue",
        { widgetIds: targets, batchId: batchMeta?.batchId },
        causality
      );
      scheduler.schedule(targets, {
        reason: event?.reason || batchMeta?.reason || "invalidate",
        priority: event?.priority || batchMeta?.priority || "normal",
        staleWhileRevalidate:
          event?.staleWhileRevalidate === true || batchMeta?.staleWhileRevalidate === true,
        causality,
        batchId: batchMeta?.batchId,
        rawEventCount: batchMeta?.rawEventCount || event?.rawEventCount || 1
      });
    }
    return targets;
  };

  if (platform?.compression?.createLayer) {
    invalidationCompression = platform.compression.createLayer({
      subscriptionGraph,
      debounceMs: Number(config.scheduler?.compressionMs || config.scheduler?.batchWindowMs || 16),
      onFlush: (batch) => {
        runtimeTelemetry?.recordCompression?.(batch.rawEventCount, batch.widgetIds.length);
        runtimeEventLog?.push?.(
          "compress",
          {
            batchId: batch.batchId,
            rawEventCount: batch.rawEventCount,
            logicalKeys: batch.logicalKeys,
            widgetCount: batch.widgetIds.length,
            compressionRatio: batch.compressionRatio
          },
          batch.causality
        );
        if (devtools) devtools.pushCompression(batch);
        applyInvalidation(
          {
            logicalKeys: batch.logicalKeys,
            querySignatures: batch.querySignatures,
            widgetIds: batch.widgetIds,
            reason: batch.reason,
            priority: batch.priority,
            staleWhileRevalidate: batch.staleWhileRevalidate,
            causality: batch.causality
          },
          batch
        );
      }
    });
  }

  if (platform?.scheduler?.create) {
    scheduler = platform.scheduler.create(executeScheduledRefresh, {
      debounceMs: Number(config.scheduler?.debounceMs || 50),
      batchWindowMs: Number(config.scheduler?.batchWindowMs || 16)
    });
    scheduler.onFlush = (meta) => {
      if (runtimeTelemetry && meta.coalescedWidgetCount) {
        runtimeTelemetry.recordCompression(meta.rawEventCount || 1, meta.widgetCount || 0);
      }
    };
  }

  if (lifetimeTree) {
    lifetimeTree.addDisposeCallback(runtimeScope.scopeId, () => {
      invalidationCompression?.clear?.();
      scheduler?.clear?.();
      executionCoordinator?.cancelScope?.(runtimeScope.scopeId);
      executionCoordinator?.dispose?.();
      dashboardCache?.clear?.();
      runtimeTelemetry?.reset?.();
      runtimeEventLog?.clear?.();
      resourceOwnership?.disposeScope?.(runtimeScope.scopeId);
      runtimeTelemetry?.recordScopeDisposal?.();
      devtools?.clear?.();
    });
  }

  const refreshAfterGlobalFilterChange = async () => {
    for (let widgetIndex = 0; widgetIndex < visibleWidgets.length; widgetIndex++) {
      const widgetConfig = visibleWidgets[widgetIndex];
      if (executionCoordinator && widgetConfig.type !== "crudTable") {
        executionCoordinator.cancelWidget(widgetConfig.id, runtimeScope.scopeId);
      }
      registerWidgetSubscriptions(subscriptionGraph, widgetConfig, store);
    }
    const widgetIds = visibleWidgets.map((w) => w.id);
    applyInvalidation(
      {
        widgetIds,
        reason: "filter_change",
        priority: "high",
        source: "filter",
        immediate: true
      },
      null
    );
    if (scheduler) await scheduler.flush();
    else await executeScheduledRefresh(widgetIds, {});
  };

  const refreshAllWidgets = async () => {
    setUi("dashboard", "loading", true);
    const widgetIds = getDisplayWidgets().map((w) => w.id);
    try {
      if (scheduler) {
        scheduler.schedule(widgetIds, { reason: "refresh_all", priority: "high", debounceMs: 0 });
        await scheduler.flush();
      } else {
        await executeScheduledRefresh(widgetIds, { reason: "refresh_all" });
      }
    } finally {
      setUi("dashboard", "loading", false);
    }
  };

  let interactionActionRegistry = {};

  const dispatchInteraction = async (event) => {
    const normalized = platform?.interaction?.normalize
      ? platform.interaction.normalize(event)
      : event;
    if (!normalized) return;
    if (devtools) devtools.pushInteraction(normalized);
    const handler = interactionActionRegistry[normalized.type];
    if (handler) await handler(normalized, store, runtimeApi);
  };

  const runtimeApi = {
    refreshWidget,
    refreshCrudWidget,
    refreshAllWidgets,
    refreshAfterGlobalFilterChange,
    registerCrudRefresh: (widgetId, callback) => { crudRefreshCallbacks[widgetId] = callback; },
    dispatchInteraction,
    updateWidgetLayout: (widgetId, layoutPartial, options) => {
      store.patchSession((session) => {
        const layoutOverrides = { ...(session.layoutOverrides || {}) };
        layoutOverrides[widgetId] = { ...(layoutOverrides[widgetId] || {}), ...layoutPartial };
        return { ...session, layoutOverrides };
      });
      if (options?.persist !== false) {
        scheduleLayoutSave();
      }
    },
    toggleWidgetHidden: (widgetId, hidden) => {
      const nextHidden = hidden !== false;
      store.patchSession((session) => {
        const hiddenWidgets = { ...(session.hiddenWidgets || {}) };
        if (nextHidden) hiddenWidgets[widgetId] = true;
        else delete hiddenWidgets[widgetId];
        return { ...session, hiddenWidgets };
      });
      scheduleLayoutSave();
    },
    setEditMode: (enabled) => {
      setUi("dashboard", "mode", enabled ? "edit" : "view");
    },
    closeEntityDrawer: () => {
      store.patchSession((session) => ({
        ...session,
        entityDrawer: initEntityDrawerState()
      }));
    },
    applyServerGraphToLocalGraph,
    invalidate: (event) => {
      const enriched = {
        ...(event || {}),
        causality:
          event?.causality ||
          (platform?.causality?.create
            ? platform.causality.create({
                source: event?.source || "system",
                cause: event?.reason,
                mutationId: event?.mutationId,
                realtimeEventId: event?.realtimeEventId
              })
            : undefined)
      };
      if (event?.immediate === true || !invalidationCompression) {
        return applyInvalidation(enriched, null);
      }
      invalidationCompression.ingest({
        ...enriched,
        rawEventCount: enriched.rawEventCount || 1
      });
      return resolveInvalidationTargets(enriched);
    },
    publishMutation: (rawMutation) => {
      const mutation = platform?.mutation?.normalize ? platform.mutation.normalize(rawMutation) : null;
      if (!mutation) return [];
      const targets = platform?.mutation?.resolveInvalidationTargets
        ? platform.mutation.resolveInvalidationTargets(mutation)
        : { querySignatures: [], logicalKeys: [] };
      if (devtools) devtools.pushMutation(mutation);
      const mutationId = mutation.entityId
        ? `${mutation.type}_${mutation.entityId}`
        : mutation.type;
      return runtimeApi.invalidate({
        querySignatures: targets.querySignatures,
        logicalKeys: targets.logicalKeys,
        reason: mutation.type,
        source: "mutation",
        mutationId,
        entityType: mutation.entityType,
        entityId: mutation.entityId,
        rawEventCount: 1,
        causality: platform?.causality?.create
          ? platform.causality.create({
              source: "mutation",
              cause: mutation.type,
              mutationId
            })
          : undefined
      });
    },
    dispose: () => {
      lifetimeTree?.disposeAll?.();
      for (let index = 0; index < visibleWidgets.length; index++) {
        setWidgetLifecycle(store, visibleWidgets[index].id, "DISPOSE");
        subscriptionGraph?.unregister?.(visibleWidgets[index].id);
      }
      for (let index = 0; index < visibleWidgets.length; index++) {
        setWidgetLifecycle(store, visibleWidgets[index].id, "DISPOSED");
      }
    }
  };

  interactionActionRegistry = buildInteractionRegistry(config, visibleWidgets, runtimeApi);

  const platformApi = platform?.api?.createPublic
    ? platform.api.createPublic({
        invalidate: (event) => runtimeApi.invalidate(event),
        publishMutation: (mutation) => runtimeApi.publishMutation(mutation),
        dispatchInteraction: (event) => runtimeApi.dispatchInteraction(event),
        refreshWidget: (widgetId, refreshMeta) => runtimeApi.refreshWidget(widgetId, refreshMeta),
        refreshCrudWidget: (widgetId) => runtimeApi.refreshCrudWidget(widgetId),
        refreshAllWidgets: () => runtimeApi.refreshAllWidgets(),
        closeEntityDrawer: () => runtimeApi.closeEntityDrawer(),
        dispatchInteractionRaw: (event) => runtimeApi.dispatchInteraction(event),
        store,
        config
      })
    : null;

  let realtimeBridge = null;
  if (config.realtime?.enabled === true && platformApi && platform?.realtime?.createBridge) {
    realtimeBridge = platform.realtime.createBridge({
      platformApi,
      dashboardKey: config.key,
      realtimeConfig: config.realtime,
      devtools,
      pollEvents: async (context) =>
        s({
          functionName: "pollDashboardRealtimeEvents",
          contextData: {
            dashboardKey: context.dashboardKey,
            channel: context.channel,
            watermark: context.watermark,
            realtimeConfig: context.realtimeConfig
          }
        }),
      onPollError: (error) => {
        console.warn("Dashboard realtime bridge poll error:", error);
      }
    });
    if (lifetimeTree) {
      lifetimeTree.addDisposeCallback(runtimeScope.scopeId, () => {
        realtimeBridge?.dispose?.();
      });
    }
    if (resourceOwnership) {
      resourceOwnership.register(
        {
          resourceId: `realtime_${config.key}`,
          scopeId: runtimeScope.scopeId,
          kind: "realtime_bridge",
          cleanupPolicy: "dispose",
          lifetimeMode: "scope"
        },
        () => realtimeBridge?.dispose?.()
      );
    }
  }

  const pref = await s({
    functionName: "loadDashboardPreference",
    contextData: { dashboardKey: config.key }
  });
  applyServerGraphToLocalGraph(pref, activeDashboardTxnId);
  const prefState = pref?.result?.data?.state;
  if (prefState && typeof prefState === "object") {
    store.patchSession((session) => ({
      ...session,
      filters: prefState.filters || session.filters || {},
      timeRange: prefState.timeRange || session.timeRange,
      layoutState: prefState.layoutState || session.layoutState,
      layoutOverrides: prefState.layoutOverrides || session.layoutOverrides || {},
      hiddenWidgets: prefState.hiddenWidgets || session.hiddenWidgets || {}
    }));
  }

  for (let widgetIndex = 0; widgetIndex < visibleWidgets.length; widgetIndex++) {
    registerWidgetSubscriptions(subscriptionGraph, visibleWidgets[widgetIndex], store);
    setWidgetLifecycle(store, visibleWidgets[widgetIndex].id, "LOAD");
  }

  await refreshAllWidgets();

  const handleWidgetInteraction = async (widgetConfig, interaction, eventPayload) => {
    const event = platform?.interaction?.resolveWidget
      ? platform.interaction.resolveWidget(interaction, eventPayload)
      : null;
    if (!event) return;
    event.sourceWidgetId = widgetConfig.id;
    event.runtimeScopeId = runtimeScope.scopeId;
    await dispatchInteraction(event);
  };

  const resolveLayoutForWidget = (widgetConfig) =>
    resolveWidgetLayout(widgetConfig, config, getSession().layoutOverrides || {}, breakpoint());

  const runtime = {
    config,
    headerActions: resolvedHeaderActions,
    txnId: activeDashboardTxnId,
    store,
    widgets: visibleWidgets,
    getDisplayWidgets,
    isWidgetHidden: (widgetId) => getSession().hiddenWidgets?.[widgetId] === true,
    runtimeApi,
    platformApi,
    runtimeScope,
    entityRuntimeScope,
    dashboardCache,
    subscriptionGraph,
    scheduler,
    executionCoordinator,
    lifetimeTree,
    realtimeBridge,
    devtools,
    runtimeTelemetry,
    runtimeEventLog,
    resourceOwnership,
    invalidationCompression,
    crudWidgetAdapter: (widgetConfig) => crudWidgetAdapter(widgetConfig, runtime),
    composeWidgetQuery: (widgetConfig) => composeWidgetQuery(widgetConfig, store),
    resolveWidgetLayout: resolveLayoutForWidget,
    handleWidgetInteraction,
    isEditMode: () => store.ui.dashboard.mode === "edit",
    isDashboardLoading: () => store.ui.dashboard.loading === true,
    isDevtoolsEnabled: () => devtools?.enabled === true,
    getBreakpoint: () => breakpoint(),
    setBreakpoint,
    engines: {
      interactionEngine: {
        dispatch: dispatchInteraction,
        resolveWidget: platform?.interaction?.resolveWidget,
        EVENT_TYPES: platform?.interaction?.EVENT_TYPES || []
      },
      queryEngine: platform?.query || null,
      mutationEngine: platform?.mutation || null,
      schedulerEngine: scheduler,
      subscriptionEngine: subscriptionGraph,
      executionEngine: executionCoordinator,
      realtimeEngine: realtimeBridge
    }
  };

  return runtime;
};

const initFromProps = async () => {
  const raw = c.props?.getDashboardConfig?.();
  if (!raw) {
    setRuntimeState(null);
    return;
  }
  const runtime = await createRuntime(raw);
  setRuntimeState(runtime);
};

const disposeDashboardRuntime = () => {
  const runtime = runtimeState();
  runtime?.realtimeBridge?.dispose?.();
  runtime?.runtimeApi?.dispose?.();
  const txnId = runtime?.txnId || activeDashboardTxnId;
  if (txnId && txnId > 0) {
    _.revertTransaction(txnId);
    activeDashboardTxnId = 0;
  }
  if (typeof breakpointCleanup === "function") {
    breakpointCleanup();
    breakpointCleanup = null;
  }
  setRuntimeState(null);
};

const getDashboardRuntime = () => runtimeState();

const mountDashboardHost = async () => {
  if (!breakpointCleanup) installBreakpointListener();
  let attempts = 0;
  while (!c.props?.getDashboardConfig?.() && attempts < 100) {
    await new Promise((resolve) => setTimeout(resolve, 50));
    attempts += 1;
  }
  await initFromProps();
  const runtime = getDashboardRuntime();
  const realtime = runtime?.config?.realtime;
  if (realtime?.enabled === true) {
    if (runtime?.realtimeBridge) {
      runtime.realtimeBridge.start();
    } else {
      console.warn("Dashboard realtime enabled but bridge was not created");
    }
  }
};

return {
  normalizeDashboardConfig,
  resolveHeaderActions,
  applyServerGraphToLocalGraph,
  crudWidgetAdapter,
  createRuntime,
  initFromProps,
  mountDashboardHost,
  disposeDashboardRuntime,
  getDashboardRuntime
};
