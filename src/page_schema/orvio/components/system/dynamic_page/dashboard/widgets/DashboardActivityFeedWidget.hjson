          '''
const rows = f.getRows();
return {
  as: "p",
  hide: rows.length > 0,
  text: "No activity"
};
'''
        css:
          '''
return `._id {
  margin: 0;
  font-size: 0.875rem;
  color: ${t.var.color.text_light_500};
}`;
'''
      }
