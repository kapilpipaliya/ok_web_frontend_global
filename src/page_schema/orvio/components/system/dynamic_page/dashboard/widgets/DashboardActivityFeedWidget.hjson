{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: DashboardActivityFeedWidget
        fns:
          '''
const pickDisplayValue = (properties, fieldConfig, fallback) => {
  const p = properties || {};
  const keys = Array.isArray(fieldConfig)
    ? fieldConfig
    : typeof fieldConfig === "string" && fieldConfig.trim() !== ""
      ? [fieldConfig]
      : ["title", "name", "subject", "label", "serial", "key"];
  for (let index = 0; index < keys.length; index++) {
    const value = p[keys[index]];
    if (value != null && String(value).trim() !== "") return String(value);
  }
  return fallback;
};

const getRows = () => {
  const widgetConfig = c.props?.widgetConfig || {};
  const displayFields = widgetConfig.displayFields || {};
  const widgetData = c.props?.widgetData || {};
  const rows = Array.isArray(widgetData.rows) ? widgetData.rows : [];
  return rows.map((row) => {
    const p = row?.P || {};
    return {
      id: row?.id,
      title: pickDisplayValue(p, displayFields.title, row?.id || "Item"),
      subtitle: pickDisplayValue(p, displayFields.subtitle, ""),
      time: pickDisplayValue(p, displayFields.time, "")
    };
  });
};
return { getRows };
'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const rows = f.getRows();
return {
  as: "ul",
  hide: rows.length === 0,
  loop: true,
  contextName: "feedItem",
  data: rows
};
'''
        css:
          '''
return `._id {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  max-height: 100%;
  overflow-y: auto;
}`;
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const item = c.feedItem;
return {
  as: "li",
  text: `${item.title}${item.subtitle ? " · " + item.subtitle : ""}${item.time ? " · " + item.time : ""}`
};
'''
        css:
          '''
return `._id {
  font-size: 0.8125rem;
  color: ${t.var.color.text};
  padding: 0.5rem 0.625rem;
  border-radius: 0.375rem;
  background: ${t.var.color.background_light_100};
  border: 1px solid ${t.var.color.border};
}`;
'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
