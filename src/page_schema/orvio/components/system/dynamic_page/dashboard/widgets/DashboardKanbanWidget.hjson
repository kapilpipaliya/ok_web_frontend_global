{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: DashboardKanbanWidget
        fns:
          '''
const pickDisplayValue = (properties, fieldConfig, fallback) => {
  const p = properties || {};
  const keys = Array.isArray(fieldConfig)
    ? fieldConfig
    : typeof fieldConfig === "string" && fieldConfig.trim() !== ""
      ? [fieldConfig]
      : ["title", "name", "subject", "label", "serial", "key"];
  for (let index = 0; index < keys.length; index++) {
    const value = p[keys[index]];
    if (value != null && String(value).trim() !== "") return String(value);
  }
  return fallback;
};

const getColumns = () => {
  const widgetConfig = args.contextData.props?.widgetConfig || {};
  const widgetData = args.contextData.props?.widgetData || {};
  const configured = Array.isArray(widgetConfig.kanbanColumns) ? widgetConfig.kanbanColumns : [];
  const groupField = widgetConfig.kanbanGroupField || "status";
  const titleFields = widgetConfig.displayFields?.title;
  const rows = Array.isArray(widgetData.rows) ? widgetData.rows : [];
  const buckets = {};
  for (let ci = 0; ci < configured.length; ci++) {
    buckets[String(configured[ci])] = [];
  }
  for (let ri = 0; ri < rows.length; ri++) {
    const row = rows[ri];
    const key = String(row?.P?.[groupField] ?? "unknown");
    if (!buckets[key]) buckets[key] = [];
    buckets[key].push({
      id: row?.id,
      title: pickDisplayValue(row?.P, titleFields, row?.id || "Card")
    });
  }
  if (configured.length === 0) {
    return [{ key: "all", label: "All", cards: rows.map((row) => ({
      id: row?.id,
      title: pickDisplayValue(row?.P, titleFields, row?.id || "Card")
    })) }];
  }
  return configured.map((colKey) => ({
    key: String(colKey),
    label: String(colKey),
    cards: buckets[String(colKey)] || []
  }));
};
return { getColumns };
'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div",
  loop: true,
  contextName: "kanbanColumn",
  data: args.fns.getColumns()
};
'''
        css:
          '''
return `._id {
  display: flex;
  gap: 0.75rem;
  height: 100%;
  min-height: 10rem;
  overflow-x: auto;
}`;
'''
      }
    }
