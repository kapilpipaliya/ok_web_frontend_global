{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: DashboardWidgetRenderer
        fns:
          '''
const getWidgetConfig = () => args.contextData.props?.widgetConfig || null;
const getRuntime = () => {
  const fromProps = args.contextData.props?.dashboardRuntime;
  if (typeof fromProps === "function") return fromProps();
  return null;
};
const getWidgetUi = () => {
  const widgetConfig = getWidgetConfig();
  const runtime = getRuntime();
  if (!widgetConfig || !runtime?.store) return { loading: true };
  const state = runtime.store.getWidgetState(widgetConfig.id) || {};
  const widgetData = runtime.store.resolveWidgetPresentation(widgetConfig.id);
  return {
    ...state,
    widgetStateVertexId: runtime.store.getWidgetStateVertexId(widgetConfig.id),
    dataResultVertexId: state.dataResultVertexId,
    widgetData
  };
};
return { getWidgetConfig, getRuntime, getWidgetUi };
'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: DashboardMetricCard
        props:
          '''
const widgetConfig = args.fns.getWidgetConfig();
const ui = args.fns.getWidgetUi();
return {
  widgetConfig,
  widgetData: ui.widgetData || {},
  widgetStateVertexId: ui.widgetStateVertexId,
  hide:
    widgetConfig?.type !== "metricCard" ||
    !!ui.error ||
    (ui.loading === true && !ui.dataResultVertexId)
};
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 2
        componentName: DashboardChartWidget
        props:
          '''
const widgetConfig = args.fns.getWidgetConfig();
const ui = args.fns.getWidgetUi();
const runtime = args.fns.getRuntime();
const graphVertexCount = Object.keys(args.graph?.vertexes || {}).length;
return {
  widgetConfig,
  widgetData: ui.widgetData || {},
  dataVersion: ui.dataVersion ?? 0,
  widgetStateVertexId: ui.widgetStateVertexId,
  graphVertexCount,
  dashboardRuntime: () => runtime,
  hide:
    widgetConfig?.type !== "chart" ||
    !!ui.error ||
    (ui.loading === true && !ui.dataResultVertexId)
};
'''
      }
    }
