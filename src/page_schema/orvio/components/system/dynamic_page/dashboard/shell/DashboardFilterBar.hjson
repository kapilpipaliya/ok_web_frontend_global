{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: DashboardFilterBar
        dynamicComponent: TomSelect
        fns:
          '''
const getRuntime = () => c.props?.dashboardRuntime?.() || null;

const DEFAULT_DATE_RANGE_OPTIONS = [
  { value: "all_time", label: "All time" },
  { value: "last_7_days", label: "Last 7 days" },
  { value: "last_30_days", label: "Last 30 days" },
  { value: "last_90_days", label: "Last 90 days" },
  { value: "last_year", label: "Last year" }
];

const getDateRangeOptions = (filter) => {
  if (Array.isArray(filter?.options) && filter.options.length > 0) {
    return filter.options.map((row) => ({
      value: row.value != null ? String(row.value) : "",
      label: row.label != null ? String(row.label) : String(row.value)
    }));
  }
  return DEFAULT_DATE_RANGE_OPTIONS;
};

const applyFilter = (filterKey, value) => {
  const runtime = getRuntime();
  if (!runtime?.store) return;
  runtime.store.setFilters({ ...runtime.store.filters(), [filterKey]: value });
  void runtime.runtimeApi.refreshAllWidgets();
};

const applyTimeRange = (value) => {
  const runtime = getRuntime();
  if (!runtime?.store) return;
  runtime.store.setTimeRange(value);
  void runtime.runtimeApi.refreshAllWidgets();
};

const getSelectOptions = (filter) => {
  if (Array.isArray(filter.options) && filter.options.length > 0) {
    return filter.options.map((row) => ({
      value: row.value != null ? String(row.value) : "",
      label: row.label != null ? String(row.label) : String(row.value)
    }));
  }
  return [];
};

return {
  getRuntime,
  applyFilter,
  applyTimeRange,
  getSelectOptions,
  getDateRangeOptions,
  DEFAULT_DATE_RANGE_OPTIONS
};
'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const runtime = f.getRuntime();
const filters = runtime?.config?.filters || [];
return {
  as: "div",
  hide: filters.length === 0
};
'''
        css:
          '''
return `._id {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem 1.25rem;
  padding: 0.75rem 1rem;
  border: 1px solid ${t.var.color.border};
  border-radius: 0.5rem;
  background: ${t.var.color.background_light_100};
}`;
'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const runtime = f.getRuntime();
const filters = runtime?.config?.filters || [];
return {
  as: "div",
  loop: true,
  contextName: "filterItem",
  data: filters
};
'''
        css:
          '''
return `._id {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 0.5rem;
  width: fit-content;
  max-width: 100%;
}`;
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const filter = c.filterItem;
return {
  as: "label",
  text: `${filter.label || filter.key}:`
};
'''
        css:
          '''
return `._id {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  color: ${t.var.color.text};
  white-space: nowrap;
}`;
'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 2
        componentName: TomSelect
        key: filter_tomselect
        props:
          '''
const filter = c.filterItem;
const runtime = f.getRuntime();
const current = runtime?.store?.filters?.()[filter.key];
const options = f.getSelectOptions(filter);
const displayValue =
  current == null || current === ""
    ? []
    : Array.isArray(current)
      ? current
      : [String(current)];
return {
  hide: filter.type !== "select",
  class: "dashboard-filter-control",
  value: displayValue,
  options,
  search: options.length > 10,
  multiple: filter.multiple === true,
  onChange: (newValue) => {
    let value = newValue;
    if (Array.isArray(newValue)) {
      value = filter.multiple === true ? newValue : newValue[0];
    }
    f.applyFilter(filter.key, value === "" ? undefined : value);
  }
};
'''
        css:
          '''
return `._id {
  flex: 0 0 auto;
  width: auto;
  min-width: 8rem;
  max-width: 14rem;
}`;
'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 3
        componentName: TomSelect
        key: filter_date_range
        props:
          '''
const filter = c.filterItem;
const runtime = f.getRuntime();
const current = runtime?.store?.timeRange?.() || filter.default || "last_year";
return {
  hide: filter.type !== "dateRange",
  class: "dashboard-filter-control",
  value: [String(current)],
  options: f.getDateRangeOptions(filter),
  search: false,
  multiple: false,
  onChange: (newValue) => {
    const value = Array.isArray(newValue) ? newValue[0] : newValue;
    if (value) f.applyTimeRange(String(value));
  }
};
'''
        css:
          '''
return `._id {
  flex: 0 0 auto;
  width: auto;
  min-width: 8rem;
  max-width: 14rem;
}`;
'''
      }
    }
  ]
  edges: [
