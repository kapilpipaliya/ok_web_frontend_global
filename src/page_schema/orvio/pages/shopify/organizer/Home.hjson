{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        fns: "return { enabled: () => true }"
        title: Decode Orders Organizer – Organize orders and draft orders in Shopify
        key: Home
        url: /
        props:
          "return {\n  isNoPermissionCheck: true\n}"
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          "return {\n  as: \"meta\",\n  name: \"description\",\n  content: \"Decode Orders Organizer helps you browse Shopify orders and draft orders in nested categories, expand rows to see line items, and tune the table from Settings—all inside Shopify admin.\"\n}"
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          "return `._id {\n  max-width: 800px;\n  margin: 0 auto;\n  padding: ${args.theme.var.spacing?.lg || \"2rem\"};\n  color: ${args.theme.var.color.text};\n}\n\n@media (max-width: 768px) {\n  ._id {\n    padding: ${args.theme.var.spacing?.md || \"1rem\"};\n  }\n}`;"
        displayOrder: 2
        componentName: Html
        props: "return { as: \"main\" }"
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          "return `._id {\n  font-size: 2rem;\n  font-weight: 700;\n  color: ${args.theme.var.color.text};\n  margin: 0 0 0.5rem 0;\n}\n\n@media (max-width: 768px) {\n  ._id { font-size: 1.75rem; }\n}`;"
        displayOrder: 1
        componentName: Html
        props: "return { as: \"h1\", text: \"Decode Orders Organizer\" }"
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          "return `._id {\n  font-size: 1.125rem;\n  line-height: 1.6;\n  color: ${args.theme.var.color.muted};\n  margin: 0 0 1rem 0;\n}`;"
        displayOrder: 2
        componentName: Html
        props:
          "return { as: \"p\", text: \"Two workspaces: full orders and draft orders—each with categories, search, and expandable line details.\" }"
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          "return `._id { font-size: 1rem; line-height: 1.6; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; }`;"
        displayOrder: 3
        textType: markdown
        componentName: Html
        text: "**Decode Orders Organizer** helps you manage **orders** and **draft orders** with nested **categories**, row **expansion** for line items, and **Settings** for columns and layout. Open **Orders** or **Draft orders** from the app navigation."
        props: "return { as: \"div\" }"
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css: "return `._id { margin-top: 2rem; }`;"
        displayOrder: 4
        componentName: Html
        props: "return { as: \"section\" }"
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        css:
          "return `._id { font-size: 1.25rem; font-weight: 600; color: ${args.theme.var.color.text}; margin: 0 0 0.75rem 0; }`;"
        displayOrder: 1
        componentName: Html
        props: "return { as: \"h2\", text: \"Key features\" }"
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        css:
          "return `._id { font-size: 1rem; line-height: 1.6; color: ${args.theme.var.color.text}; margin: 0; }`;"
        displayOrder: 2
        textType: markdown
        componentName: Html
        text: "- **Orders** — Table with filters, sort, and expandable line items.\n- **Draft orders** — Same patterns for Shopify drafts.\n- **Categories** — Sidebar trees for orders and for drafts.\n- **Settings** — Columns and expansion panel options."
        props: "return { as: \"div\" }"
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        css: "return `._id { margin-top: 2rem; }`;"
        displayOrder: 5
        componentName: Html
        props: "return { as: \"section\" }"
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        css:
          "return `._id { font-size: 1.25rem; font-weight: 600; color: ${args.theme.var.color.text}; margin: 0 0 0.75rem 0; }`;"
        displayOrder: 1
        componentName: Html
        props: "return { as: \"h2\", text: \"How it works\" }"
      }
    }
    {
      id: "12"
      L: Attr
      P: {
        css:
          "return `._id { font-size: 1rem; line-height: 1.6; color: ${args.theme.var.color.text}; margin: 0; }`;"
        displayOrder: 2
        textType: markdown
        componentName: Html
        text: "1. Install the app from the Shopify App Store.\n2. Open **Orders** or **Draft orders** from the nav.\n3. Use the category sidebar and expand rows for lines.\n4. Adjust **Settings** on each table as needed."
        props: "return { as: \"div\" }"
      }
    }
