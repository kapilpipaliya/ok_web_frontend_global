{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: loadSettingsSection
        description: Loads a single settings section document with defaults merged. Supports partial section loading for performance.
        body:
          '''
const actualUser = await _.getUserFromSession();
if (!actualUser) {
  return { success: false, message: "User session not found" };
}

const user = await _.getEffectiveUser(_.session, actualUser, c);
const {
  pageId,
  sectionId,
  scopeVertexLabel,
  scopeId,
  sectionConfig
} = c;

if (!pageId || !sectionId) {
  return { success: false, message: "pageId and sectionId are required" };
}

const parseJsonSafe = (value, fallback) => {
  if (value == null) return fallback;
  if (typeof value === "object") return value;
  try { return JSON.parse(String(value)); } catch { return fallback; }
};

const effectiveScopeLabel = scopeVertexLabel || "User";
const effectiveScopeId = scopeId || user.P.uuid;
const edgeType = `${effectiveScopeLabel}HasSettingsSection`;

let documentVertex = null;

if (effectiveScopeLabel === "User") {
  const query = `
    MATCH (scope:User {uuid: $scopeId})-[:${edgeType}]->(doc:SettingsSectionDocument {pageId: $pageId, sectionId: $sectionId})
    RETURN doc LIMIT 1
  `;
  const result = await _.session.run(query, { scopeId: effectiveScopeId, pageId, sectionId });
  if (result.records.length > 0) {
    const vertices = _.processResult(result.records, _.context, "doc");
    documentVertex = vertices[0];
  }
} else {
  const scopeMatchProperty = c.scopeMatchProperty || "uuid";
  const query = `
    MATCH (scope:${effectiveScopeLabel} {${scopeMatchProperty}: $scopeId})-[:${edgeType}]->(doc:SettingsSectionDocument {pageId: $pageId, sectionId: $sectionId})
    RETURN doc LIMIT 1
  `;
  const result = await _.session.run(query, { scopeId: effectiveScopeId, pageId, sectionId });
  if (result.records.length > 0) {
    const vertices = _.processResult(result.records, _.context, "doc");
    documentVertex = vertices[0];
  }
}

const storedValues = documentVertex
  ? parseJsonSafe(documentVertex.P?.values, {})
  : {};

let mergedValues = storedValues;
if (sectionConfig && s) {
  const mergeResult = await s({
    functionName: "settingsEngineHelpers",
    contextData: { action: "mergeDefaults", sectionConfig, values: storedValues }
  });
  if (mergeResult?.result?.success) {
    mergedValues = mergeResult.result.data?.values || storedValues;
  }
}

return {
  success: true,
  data: {
    pageId,
    sectionId,
    values: mergedValues,
    version: documentVertex?.P?.version ?? 0,
    documentId: documentVertex?.id ?? null,
    scopeVertexLabel: effectiveScopeLabel,
    scopeId: effectiveScopeId,
    exists: documentVertex != null
  },
  message: "Settings section loaded"
};
'''
      }
    }
  ]
  edges: []
}
