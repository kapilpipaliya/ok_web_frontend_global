{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Syncs Shopify inventory transfers and transfer line items. Uncategorized runs full inventoryTransfers pagination; a specific category loads rows via getUserContent then fetches those transfers by GID. Skips API when line items are filtered by a single inventoryTransferId.
        body:
          '''const {
  tableVertexLabel,
  filters = {},
  sort = {},
  shop: contextShop,
  showUnassigned,
  categoryId,
  parentVertexLabel,
  toParentEdgeType,
  enableUserScoping
} = args.contextData;
const isTransferTable = tableVertexLabel === "ShopifyInventoryTransfer";
const isLineTable = tableVertexLabel === "ShopifyInventoryTransferLineItem";
if (!isTransferTable && !isLineTable) return;

const hasTransferFilter =
  filters &&
  filters.inventoryTransferId != null &&
  String(filters.inventoryTransferId).length > 0;
if (isLineTable && hasTransferFilter) {
  console.log("[shopifyInventoryTransferBeforeFetchData] skip Shopify sync (single-transfer lines from graph)");
  return;
}

const shop = contextShop || args.shop;
if (!shop) {
  console.warn("[shopifyInventoryTransferBeforeFetchData] shop is required");
  return;
}

console.log("[shopifyInventoryTransferBeforeFetchData] contextData:", { shop, filters, sort });

const shopify = await args.getShopifyClient();
let admin;
try {
  const authResult = await shopify.unauthenticated.admin(shop);
  admin = authResult.admin;
} catch (e) {
  console.log("[shopifyInventoryTransferBeforeFetchData] Shopify admin auth failed:", e?.message || e);
  return;
}
if (!admin) {
  console.log("[shopifyInventoryTransferBeforeFetchData] no admin client for shop:", shop);
  return;
}

const vertexLabel = tableVertexLabel;
const uncategorizedVertexId = "_" + vertexLabel + "_uncategorized";
const isUncategorized = showUnassigned === true || categoryId === uncategorizedVertexId;

let categoryTransferGids = [];
if (!isUncategorized && categoryId && parentVertexLabel && toParentEdgeType) {
  try {
    const fetchResult = await args.executeNamedServerFunction(
      {
        functionName: "getUserContent",
        contextData: {
          tableVertexLabel,
          categoryId,
          parentVertexLabel,
          toParentEdgeType,
          enableUserScoping,
          hooks: null
        }
      },
      { functionLookupSubDomain: "orvio" }
    );
    const rows =
      fetchResult?.result?.success && Array.isArray(fetchResult.result.data) ? fetchResult.result.data : [];
    const seenTransferGids = new Set();
    for (const row of rows) {
      const transferGid = isTransferTable ? row.P?.id : row.P?.inventoryTransferId;
      if (transferGid && !seenTransferGids.has(transferGid)) {
        seenTransferGids.add(transferGid);
        categoryTransferGids.push(transferGid);
      }
    }
    console.log(
      "[shopifyInventoryTransferBeforeFetchData] category scope: unique transfer GIDs",
      categoryTransferGids.length,
      "table",
      tableVertexLabel
    );
  } catch (error) {
    console.error("[shopifyInventoryTransferBeforeFetchData] getUserContent (category scope):", error);
  }
  if (categoryTransferGids.length === 0) {
    console.log("[shopifyInventoryTransferBeforeFetchData] no rows in category; skip Shopify sync");
    return;
  }
}

const statusFilter = filters.status || "ALL";
let queryString = "";
if (statusFilter && statusFilter !== "ALL") {
  queryString = "status:" + String(statusFilter).toLowerCase();
}

const BULK_LINE_ITEMS_FIRST = 25;
const LINE_ITEMS_FIRST = 250;
const TRANSFERS_PAGE_SIZE = 25;

const TRANSFER_LINE_NODE_FIELDS = `
              id
              title
              totalQuantity
              shippedQuantity
              pickedForShipmentQuantity
              processableQuantity
              shippableQuantity
              inventoryItem {
                id
                sku
                tracked
                variant {
                  id
                  title
                  product {
                    id
                    title
                  }
                }
              }`;

const transfersQuery =
  `
  query InventoryTransfersSync($first: Int!, $after: String, $query: String, $sortKey: TransferSortKeys, $reverse: Boolean) {
    inventoryTransfers(first: $first, after: $after, query: $query, sortKey: $sortKey, reverse: $reverse) {
      pageInfo {
        hasNextPage
        endCursor
      }
      edges {
        node {
          id
          name
          status
          dateCreated
          note
          referenceName
          hasTimelineComment
          totalQuantity
          receivedQuantity
          tags
          origin {
            name
            location {
              id
              name
            }
          }
          destination {
            name
            location {
              id
              name
            }
          }
          lineItems(first: ` +
  BULK_LINE_ITEMS_FIRST +
  `) {
            pageInfo {
              hasNextPage
              endCursor
            }
            edges {
              node {` +
  TRANSFER_LINE_NODE_FIELDS +
  `
              }
            }
          }
        }
      }
    }
  }`.trim();

const transfersByNodesQuery =
  `
  query getInventoryTransfersByIds($ids: [ID!]!) {
    nodes(ids: $ids) {
      ... on InventoryTransfer {
          id
          name
          status
          dateCreated
          note
          referenceName
          hasTimelineComment
          totalQuantity
          receivedQuantity
          tags
          origin {
            name
            location {
              id
              name
            }
          }
          destination {
            name
            location {
              id
              name
            }
          }
          lineItems(first: ` +
  BULK_LINE_ITEMS_FIRST +
  `) {
            pageInfo {
              hasNextPage
              endCursor
            }
            edges {
              node {` +
  TRANSFER_LINE_NODE_FIELDS +
  `
              }
            }
          }
      }
    }
  }`.trim();

const transferLineItemsPageQuery =
  `
  query TransferLineItemsPage($transferId: ID!, $first: Int!, $after: String) {
    node(id: $transferId) {
      ... on InventoryTransfer {
        lineItems(first: $first, after: $after) {
          pageInfo {
            hasNextPage
            endCursor
          }
          edges {
            node {` +
  TRANSFER_LINE_NODE_FIELDS +
  `
            }
          }
        }
      }
    }
  }`.trim();

const fetchAllTransferLineNodes = async (adminClient, transferGid, initialLineItems) => {
  const nodes = [];
  let fetchErrored = false;
  let nextAfter;
  if (initialLineItems?.edges?.length > 0) {
    for (const e of initialLineItems.edges) {
      if (e?.node) nodes.push(e.node);
    }
    if (initialLineItems.pageInfo?.hasNextPage === true && initialLineItems.pageInfo.endCursor) {
      nextAfter = initialLineItems.pageInfo.endCursor;
    } else {
      nextAfter = false;
    }
  } else {
    nextAfter = null;
  }
  while (nextAfter !== false) {
    await new Promise((r) => setTimeout(r, 150));
    const resp = await adminClient.graphql(transferLineItemsPageQuery, {
      variables: { transferId: transferGid, first: LINE_ITEMS_FIRST, after: nextAfter }
    });
    const json = resp instanceof Response ? await resp.json() : resp;
    if (json.errors && json.errors.length > 0) {
      fetchErrored = true;
      console.error(
        "[shopifyInventoryTransferBeforeFetchData] transfer lineItems pagination error:",
        transferGid,
        json.errors[0]?.message || json.errors[0]
      );
      break;
    }
    const page = json.data?.node?.lineItems;
    if (!page) {
      fetchErrored = true;
      break;
    }
    for (const e of page.edges || []) {
      if (e?.node) nodes.push(e.node);
    }
    if (page.pageInfo?.hasNextPage === true && page.pageInfo.endCursor) {
      nextAfter = page.pageInfo.endCursor;
    } else {
      nextAfter = false;
    }
    if (page.pageInfo?.hasNextPage === true && !page.pageInfo.endCursor) {
      console.warn("[shopifyInventoryTransferBeforeFetchData] lineItems hasNextPage but no endCursor", transferGid);
      nextAfter = false;
    }
  }
  return { nodes, fetchErrored };
};

const sortCol = sort && sort.column;
const sortKey = sortCol === "name" || sortCol === "transferName" ? "ID" : "CREATED_AT";
const reverse = sort.direction === "desc";

let allTransfers = [];
const useCategoryTransferScope =
  !isUncategorized &&
  categoryId &&
  parentVertexLabel &&
  toParentEdgeType &&
  categoryTransferGids.length > 0;

if (useCategoryTransferScope) {
  const batchSize = 50;
  for (let batchOffset = 0; batchOffset < categoryTransferGids.length; batchOffset += batchSize) {
    const transferGidBatch = categoryTransferGids.slice(batchOffset, batchOffset + batchSize);
    const response = await admin.graphql(transfersByNodesQuery, { variables: { ids: transferGidBatch } });
    const apiResponse = response instanceof Response ? await response.json() : response;
    if (apiResponse.errors && apiResponse.errors.length > 0) {
      console.error(
        "[shopifyInventoryTransferBeforeFetchData] GraphQL error (nodes batch):",
        apiResponse.errors[0]?.message || "unknown"
      );
      return;
    }
    const transferNodes = apiResponse.data?.nodes || [];
    for (const transferNode of transferNodes) {
      if (transferNode) allTransfers.push(transferNode);
    }
    await new Promise((resolve) => setTimeout(resolve, 200));
  }
  console.log("[shopifyInventoryTransferBeforeFetchData] fetched transfers (category scope):", allTransfers.length);
} else {
  let cursor = null;
  let hasNextPage = true;
  while (hasNextPage) {
    const variables = {
      first: TRANSFERS_PAGE_SIZE,
      after: cursor || null,
      query: queryString || null,
      sortKey,
      reverse
    };
    const response = await admin.graphql(transfersQuery, { variables });
    const apiResponse = response instanceof Response ? await response.json() : response;
    if (apiResponse.errors && apiResponse.errors.length > 0) {
      console.error(
        "[shopifyInventoryTransferBeforeFetchData] GraphQL error:",
        apiResponse.errors[0]?.message || "unknown"
      );
      return;
    }
    const edges = apiResponse.data?.inventoryTransfers?.edges || [];
    allTransfers = allTransfers.concat(edges.map((e) => e.node));
    hasNextPage = apiResponse.data?.inventoryTransfers?.pageInfo?.hasNextPage === true;
    cursor = apiResponse.data?.inventoryTransfers?.pageInfo?.endCursor || null;
    if (!cursor) break;
    await new Promise((r) => setTimeout(r, 200));
  }
  console.log("[shopifyInventoryTransferBeforeFetchData] fetched transfers:", allTransfers.length);
}

const strJoinTags = (tags) =>
  Array.isArray(tags) ? tags.filter((x) => x != null && x !== "").join(", ") : "";

const session = args.session;
for (const t of allTransfers) {
  const transferId = t.id || "";
  const transferName = t.name || "";
  if (!transferId) continue;

  const origin = t.origin || {};
  const dest = t.destination || {};
  const transferProps = {
    id: transferId,
    name: transferName,
    status: t.status ? String(t.status) : "",
    dateCreated: t.dateCreated || "",
    note: t.note || "",
    referenceName: t.referenceName || "",
    hasTimelineComment: t.hasTimelineComment === true,
    totalQuantity: t.totalQuantity != null ? Number(t.totalQuantity) : 0,
    receivedQuantity: t.receivedQuantity != null ? Number(t.receivedQuantity) : 0,
    tags: strJoinTags(t.tags),
    originName: origin.name || origin.location?.name || "",
    originLocationId: origin.location?.id || "",
    destinationName: dest.name || dest.location?.name || "",
    destinationLocationId: dest.location?.id || ""
  };

  await session.run(`MERGE (tr:ShopifyInventoryTransfer { id: $id })
   SET tr += $props`, { id: transferId, props: transferProps });

  let lineNodes;
  let lineItemsFetchErrored = false;
  if (transferId && admin) {
    const lineRes = await fetchAllTransferLineNodes(admin, transferId, t.lineItems);
    lineNodes = lineRes.nodes;
    lineItemsFetchErrored = lineRes.fetchErrored;
  } else {
    lineNodes = t.lineItems?.edges?.map((e) => e.node) || [];
  }
  if (lineItemsFetchErrored) {
    console.warn("[shopifyInventoryTransferBeforeFetchData] transfer lines may be incomplete", {
      shop,
      transferId,
      transferName
    });
  }

  for (let idx = 0; idx < lineNodes.length; idx++) {
    const node = lineNodes[idx];
    const lineItemId = node.id || transferId + "-line-" + idx;
    const inv = node.inventoryItem || {};
    const variant = inv.variant || {};
    const product = variant.product || {};
    const lineProps = {
      id: lineItemId,
      inventoryTransferId: transferId,
      transferName,
      lineTitle: node.title || "",
      totalQuantity: node.totalQuantity != null ? Number(node.totalQuantity) : 0,
      shippedQuantity: node.shippedQuantity != null ? Number(node.shippedQuantity) : 0,
      pickedForShipmentQuantity:
        node.pickedForShipmentQuantity != null ? Number(node.pickedForShipmentQuantity) : 0,
      processableQuantity: node.processableQuantity != null ? Number(node.processableQuantity) : 0,
      shippableQuantity: node.shippableQuantity != null ? Number(node.shippableQuantity) : 0,
      inventoryItemId: inv.id || "",
      sku: inv.sku || "",
      variantGraphId: variant.id || "",
      variantTitle: variant.title || "",
      productGraphId: product.id || "",
      productTitle: product.title || ""
    };

    await session.run(
      `MERGE (li:ShopifyInventoryTransferLineItem { id: $lineItemId })
       SET li += $lineProps`,
      { lineItemId, lineProps }
    );
  }
}
'''
        key: shopifyInventoryTransferBeforeFetchData
      }
    }
  ]
  edges: []
}
