{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: attendraPortalAttendanceLogsAfterFetch
        description: getUserContent afterFetchData hook — keeps only AttendraAttendanceLog rows whose AttendraAttendanceLogEmployee target matches the signed-in user. Mutates contextData.result in place.
        body:
          '''
const user = await args.getUserFromSession();
const r = args.contextData?.result;
if (!r || !Array.isArray(r.data)) {
  return { success: true };
}
if (!user?.P?.uuid) {
  r.data = [];
  if (r.graph && typeof r.graph === "object") {
    r.graph.vertexes = {};
    r.graph.edges = {};
  }
  r.relatedVertices = [];
  r.message = "Found 0 Attendance log items";
  return { success: true };
}

const uuid = String(user.P.uuid).trim();
const edges = r.graph?.edges || {};
const nodes = r.graph?.vertexes || {};

const employeeUuidForLog = (log) => {
  const outArr = log?.OUT?.AttendraAttendanceLogEmployee;
  if (!Array.isArray(outArr)) return null;
  for (let i = 0; i < outArr.length; i++) {
    const e = edges[outArr[i]];
    if (!e?.E) continue;
    const end = nodes[e.E];
    const u = end?.P?.uuid;
    if (u != null && String(u).trim() !== "") return String(u).trim();
  }
  return null;
};

const filtered = r.data.filter((log) => employeeUuidForLog(log) === uuid);
const keepLogIds = new Set(filtered.map((x) => x.id).filter((id) => id != null && id !== ""));

if (r.graph && typeof r.graph === "object") {
  const nextVerts = {};
  const nextEdges = {};
  for (let li = 0; li < filtered.length; li++) {
    const log = filtered[li];
    if (log?.id) nextVerts[log.id] = log;
    const out = log?.OUT;
    if (!out || typeof out !== "object") continue;
    const keys = Object.keys(out);
    for (let ki = 0; ki < keys.length; ki++) {
      const arr = out[keys[ki]];
      if (!Array.isArray(arr)) continue;
      for (let ai = 0; ai < arr.length; ai++) {
        const eid = arr[ai];
        const e = edges[eid];
        if (!e) continue;
        nextEdges[eid] = e;
        if (e.S != null && nodes[e.S]) nextVerts[e.S] = nodes[e.S];
        if (e.E != null && nodes[e.E]) nextVerts[e.E] = nodes[e.E];
      }
    }
  }
  r.graph.vertexes = nextVerts;
  r.graph.edges = nextEdges;
}

r.data = filtered;
if (r.graph?.vertexes && typeof r.graph.vertexes === "object") {
  const verts = Object.values(r.graph.vertexes);
  r.relatedVertices = verts.filter((v) => v?.L && Array.isArray(v.L) && !v.L.includes("AttendraAttendanceLog"));
} else if (Array.isArray(r.relatedVertices)) {
  r.relatedVertices = r.relatedVertices.filter((v) => {
    if (!v?.L || !Array.isArray(v.L)) return false;
    if (v.L.includes("AttendraAttendanceLog")) return keepLogIds.has(v.id);
    return true;
  });
}

r.message = `Found ${filtered.length} Attendance log item${filtered.length !== 1 ? "s" : ""}`;
return { success: true };
'''
      }
    }
  ]
  edges: []
}
