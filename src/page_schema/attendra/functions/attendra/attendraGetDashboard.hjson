{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: attendraGetDashboard
        description: Returns today dashboard KPI counts + recent activity for Attendra. Uses getDBSessionForShop from context shop (Shopify session).
        body:
          '''
const shop = String(args.contextData?.shop || args.shop || "").trim().toLowerCase();
if (!shop) {
  return { success: false, error: "Shop is required." };
}

const dbName = args.getDatabaseNameForShop(shop, args.rawSubDomain);
const portalSignInPath = `/auth/signin`;
const portalSignInUrl = `https://${dbName}.decodecommerce.com${portalSignInPath}`;

const { dbSession } = await args.getDBSessionForShop(shop, args.rawSubDomain);

const now = new Date();

try {
  const settingRes = await dbSession.run(
    `MATCH (s:AttendraSetting {key: 'default'}) RETURN s LIMIT 1`,
    {}
  );
  const settingVertex = args.processResult(settingRes.records, args.context, "s")?.[0];
  const tz = settingVertex?.P?.timezone || "UTC";
  const lateThresholdMinutes = Number(settingVertex?.P?.lateThresholdMinutes ?? 10);
  const workdayStart = String(settingVertex?.P?.workdayStart || "09:00");

  const toParts = (d) => {
    const dtf = new Intl.DateTimeFormat("en-US", {
      timeZone: tz,
      hour12: false,
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit"
    });
    const parts = dtf.formatToParts(d);
    const get = (t) => parts.find((p) => p.type === t)?.value;
    return {
      y: Number(get("year") || 0),
      mo: Number(get("month") || 0),
      da: Number(get("day") || 0),
      h: Number(get("hour") || 0),
      mi: Number(get("minute") || 0)
    };
  };

  const todayStartIso = (() => {
    const startUtc = new Date(now);
    startUtc.setHours(0, 0, 0, 0);
    return startUtc.toISOString();
  })();

  const presentRes = await dbSession.run(
    `MATCH (l:AttendraAttendanceLog)-[:AttendraAttendanceLogEmployee]->(e:User)
     WHERE l.clockInAt >= $startIso
     RETURN count(DISTINCT elementId(e)) AS c`,
    { startIso: todayStartIso }
  );
  const presentToday = Number(presentRes.records[0]?.get("c") || 0);

  const clockedInRes = await dbSession.run(
    `MATCH (l:AttendraAttendanceLog)-[:AttendraAttendanceLogEmployee]->(e:User)
     WHERE l.clockOutAt IS NULL
     RETURN count(DISTINCT elementId(e)) AS c`,
    {}
  );
  const clockedInNow = Number(clockedInRes.records[0]?.get("c") || 0);

  const hoursRes = await dbSession.run(
    `MATCH (l:AttendraAttendanceLog)
     WHERE l.clockInAt >= $startIso
     WITH l,
       CASE WHEN l.clockOutAt IS NULL THEN duration.inSeconds(datetime(l.clockInAt), datetime()) ELSE duration.inSeconds(datetime(l.clockInAt), datetime(l.clockOutAt)) END AS d
     RETURN sum(d.seconds) AS totalSeconds`,
    { startIso: todayStartIso }
  );
  const totalSeconds = Number(hoursRes.records[0]?.get("totalSeconds") || 0);
  const hoursToday = Math.round((totalSeconds / 3600) * 10) / 10;

  const lateCandidateRes = await dbSession.run(
    `MATCH (l:AttendraAttendanceLog)-[:AttendraAttendanceLogEmployee]->(e:User)
     WHERE l.clockInAt >= $startIso
     RETURN e, l
     ORDER BY l.clockInAt ASC`,
    { startIso: todayStartIso }
  );
  const [startH, startM] = workdayStart.split(":").map((x) => Number(x));
  const lateCutoffMinutes = (Number.isFinite(startH) ? startH : 9) * 60 + (Number.isFinite(startM) ? startM : 0) + (Number.isFinite(lateThresholdMinutes) ? lateThresholdMinutes : 10);
  const lateEmployeeIds = new Set();
  for (let i = 0; i < lateCandidateRes.records.length; i++) {
    const row = lateCandidateRes.records[i];
    const lnode = row.get("l");
    const lp = lnode?.properties ?? {};
    const ci = lp.clockInAt;
    if (!ci) continue;
    const dd = new Date(String(ci));
    const p = toParts(dd);
    const mins = p.h * 60 + p.mi;
    if (mins <= lateCutoffMinutes) continue;
    const emp = row.get("e");
    const eid = emp && emp.elementId != null ? String(emp.elementId) : "";
    lateEmployeeIds.add(eid || "unknown-" + String(i));
  }
  const lateArrivals = lateEmployeeIds.size;

  const recentRes = await dbSession.run(
    `MATCH (l:AttendraAttendanceLog)-[:AttendraAttendanceLogEmployee]->(e:User)
     WHERE l.clockInAt >= $startIso
     RETURN e, l
     ORDER BY l.clockInAt DESC
     LIMIT 10`,
    { startIso: todayStartIso }
  );
  const recentActivity = recentRes.records.map((row) => {
    const emp = row.get("e");
    const lnode = row.get("l");
    const lp = lnode?.properties ?? {};
    const name = emp?.properties?.name != null ? String(emp.properties.name).trim() : "Employee";
    const ci = lp.clockInAt ? String(lp.clockInAt).slice(11, 16) : "";
    const co = lp.clockOutAt ? String(lp.clockOutAt).slice(11, 16) : null;
    return co ? `${name} clocked out at ${co}` : `${name} clocked in at ${ci}`;
  });

  return {
    success: true,
    data: {
      presentToday,
      clockedInNow,
      lateArrivals,
      hoursToday: String(hoursToday),
      timezone: tz,
      workdayStart,
      lateThresholdMinutes: String(lateThresholdMinutes),
      recentActivity,
      portalSignInPath,
      portalSignInUrl
    }
  };
} finally {
  await dbSession.close();
}
'''
      }
    }
  ]
  edges: []
}
