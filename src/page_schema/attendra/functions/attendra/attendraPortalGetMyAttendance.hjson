{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: attendraPortalGetMyAttendance
        description: Returns attendance logs for the signed-in portal user only (subdomain DB). Requires session user.
        body:
          '''
const user = await args.getUserFromSession();
if (!user?.P?.uuid) {
  return { success: false, error: "Not signed in." };
}
const userUuid = String(user.P.uuid).trim();

try {
  const logsRes = await args.session.run(
    `MATCH (l:AttendraAttendanceLog)-[:AttendraAttendanceLogEmployee]->(u:User {uuid: $userUuid})
     RETURN l
     ORDER BY l.clockInAt DESC
     LIMIT 200`,
    { userUuid }
  );
  const logs = logsRes.records.map((rec) => args.convertNodeToJson(rec.get("l")));

  const openRes = await args.session.run(
    `MATCH (l:AttendraAttendanceLog)-[:AttendraAttendanceLogEmployee]->(u:User {uuid: $userUuid})
     WHERE l.clockOutAt IS NULL
     RETURN l
     ORDER BY l.clockInAt DESC
     LIMIT 1`,
    { userUuid }
  );
  const openLog = openRes.records[0]
    ? args.convertNodeToJson(openRes.records[0].get("l"))
    : null;

  return {
    success: true,
    data: {
      logs,
      openLog
    }
  };
} catch (e) {
  console.error("attendraPortalGetMyAttendance", e);
  return { success: false, error: e?.message || "Failed to load attendance." };
}
'''
      }
    }
  ]
  edges: []
}
