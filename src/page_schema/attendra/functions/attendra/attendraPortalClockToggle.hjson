{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: attendraPortalClockToggle
        description: Portal clock in/out for the signed-in user. Creates an open log or closes the latest open log on the subdomain database.
        body:
          '''
const user = await args.getUserFromSession();
if (!user?.P?.uuid) {
  return { success: false, error: "Not signed in." };
}
const userUuid = String(user.P.uuid).trim();
const nowIso = new Date().toISOString();

try {
  const action = await args.session.executeWrite(async (tx) => {
    const openRes = await tx.run(
      `MATCH (l:AttendraAttendanceLog)-[:AttendraAttendanceLogEmployee]->(u:User {uuid: $userUuid})
       WHERE l.clockOutAt IS NULL
       RETURN l
       ORDER BY l.clockInAt DESC
       LIMIT 1`,
      { userUuid }
    );

    if (openRes.records.length > 0) {
      const node = openRes.records[0].get("l");
      const lp = node?.properties || {};
      const logUuid = String(lp.uuid || "").trim();
      if (!logUuid) {
        return { err: "Attendance log is missing uuid; contact support." };
      }
      const startMs = new Date(String(lp.clockInAt || nowIso)).getTime();
      const totalHours = Math.max(
        0,
        Math.round(((Date.now() - startMs) / 3600000) * 100) / 100
      );
      await tx.run(
        `MATCH (l:AttendraAttendanceLog {uuid: $logUuid})-[:AttendraAttendanceLogEmployee]->(:User {uuid: $userUuid})
         SET l.clockOutAt = $outIso,
             l.status = 'closed',
             l.totalHours = $totalHours,
             l.updatedAt = datetime()`,
        {
          userUuid,
          logUuid,
          outIso: nowIso,
          totalHours: String(totalHours)
        }
      );
      return { action: "clocked_out" };
    }

    const logUuid = args.uuidv7();
    await tx.run(
      `MATCH (u:User {uuid: $userUuid})
       CREATE (l:AttendraAttendanceLog {
         uuid: $logUuid,
         clockInAt: $inIso,
         status: 'open',
         createdAt: datetime(),
         updatedAt: datetime()
       })
       CREATE (l)-[:AttendraAttendanceLogEmployee]->(u)
       MERGE (u)-[:UserAttendraAttendanceLog]->(l)`,
      { userUuid, logUuid, inIso: nowIso }
    );
    return { action: "clocked_in" };
  });

  if (action?.err) {
    return { success: false, error: action.err };
  }
  return { success: true, data: action };
} catch (e) {
  console.error("attendraPortalClockToggle", e);
  return { success: false, error: e?.message || "Clock action failed." };
}
'''
      }
    }
  ]
  edges: []
}
