{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: employeeAfterCreate
        description: After staff User create — shop DB cleanup (transient shop/invite fields), optional invited status, send invitation email (same as global UserManagement invite flow).
        body:
          '''
const { tableVertexLabel, operation } = c || {};
if (tableVertexLabel !== "User" || operation !== "create") {
  return { success: true, message: "Skip: not User create" };
}

const shop = String(c?.shop || _.shop || "").trim().toLowerCase();
if (!shop) {
  return { success: true, message: "Skip: no shop in context" };
}

const result = c?.result;
const employee = result?.data;
const elementId = employee?.id;
if (!elementId) return { success: true, message: "Skip: missing employee elementId" };

const uuid = _.uuidv7();

const { dbSession } = await _.getDBSessionForShop(shop, _.rawSubDomain);
try {
  await dbSession.run(
    `MATCH (e:User) WHERE elementId(e) = $id
     SET e.status = "invited",
         e.updatedAt = $nowIso,
         e.uuid = coalesce(e.uuid, $uuid)
     REMOVE e.shop, e.shopDomain, e.inviteCode, e.inviteLink
     RETURN e`,
    { id: elementId, nowIso: new Date().toISOString(), uuid }
  );
} finally {
  await dbSession.close();
}

try {
  if (result?.data?.P) {
    //if (result.data.P.status == null || String(result.data.P.status).trim() === "") {
      result.data.P.status = "invited";
    //}
    if (result.data.P.uuid == null || String(result.data.P.uuid).trim() === "") {
      result.data.P.uuid = uuid;
    }
    delete result.data.P.shop;
    delete result.data.P.shopDomain;
    delete result.data.P.inviteCode;
    delete result.data.P.inviteLink;
  }
} catch (e) {
  console.warn("employeeAfterCreate: patch result failed", e);
}

try {
  const sendInvitationEmail = _.sendInvitationEmail;
  if (typeof sendInvitationEmail === "function" && employee && employee.P?.email) {
    const req = _.getRequestEvent?.()?.request;
    const shopDbName = _.getDatabaseNameForShop(shop, _.rawSubDomain);
    if (req && _.session && _.subDomain) {
      await sendInvitationEmail(req, employee, shopDbName, _.session, `${shopDbName}.decodecommerce.com`);
    } else {
      console.warn(
        "employeeAfterCreate: skip invitation email — missing request, session, or subDomain",
      );
    }
  }
} catch (invErr) {
  console.error("employeeAfterCreate: invitation email failed", invErr);
}

return { success: true, message: "Employee created (invitation email when configured)" };
'''
      }
    }
  ]
  edges: []
}
