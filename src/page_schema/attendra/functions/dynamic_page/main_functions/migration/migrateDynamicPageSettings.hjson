{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: migrateDynamicPageSettings
        description: Seeds default Attendra DynamicPage table_config Setting rows (employees, roles, time logs, tasks, portal time logs, graph files, settings, Shopify shops). Optional dryRun in contextData.
        body:
          '''
/**
 * Attendra — migrate default table settings for DynamicPage (getUserContent / mutateUserContent).
 * contextData: { dryRun?: boolean }
 */

const { dryRun = false } = args.contextData || {};
console.log(`Attendra settings migration (dryRun: ${dryRun})`);

const settingsConfigs = [
  {
    key: "Employee_settings_default",
    tableVertexLabel: "User",
    icon: "Users",
    name: "Employees",
    config: `return {
  title: "Employees",
  label: "Employee",
  icon: "ph:users-three",
  hideExportButtons: true,
  hideImportButtons: true,
  hideSettingsButton: false,
  actions: [
    { key: "edit", type: "edit" },
    { key: "delete", type: "delete", confirm: { title: "Delete employee?", message: "This cannot be undone.", confirmText: "Delete", cancelText: "Cancel", variant: "danger" } }
  ],
  rowClickable: true,
  showRowNumber: true,
  showSelection: true,
  resizableColumns: true,
  columnWidths: { __selection: "36px", __actions: "88px", __rowNumber: "36px" },
  enableLocalFilters: true,
  enableLocalSort: true,
  usePolarisUI: true,
  enableUserScopingForSidebar: false,
  enableUserScopingForContent: false,
  columns: [
    { key: "email", label: "Email", dataType: "text", renderer: "text", width: "240px", required: true, overflowEllipsis: true },
    { key: "name", label: "Name", dataType: "text", renderer: "text", width: "200px", overflowEllipsis: true },
    { key: "username", label: "Username", dataType: "text", renderer: "text", width: "160px", overflowEllipsis: true },
    { key: "role", label: "Roles", dataType: "relation", renderer: "text", multiSelect: true, width: "200px", overflowEllipsis: true, sortable: false, filterType: "text", selectConfig: { label: "Role", labelField: "key", relationshipType: "UserRole", limit: 200, edgeOnly: true, enableUserScoping: false } },
    { key: "status", label: "Status", dataType: "text", renderer: "badge", width: "130px", badgeKeyCase: "lower", badgeToneMap: { active: ["Active", "success"], inactive: ["Inactive", "critical"], invited: ["Invited", "attention"] } },
  ],
  rowHeight: 52,
  uniqueKeys: ["email", "username"],
  hooks: {
    afterCreate: ["employeeAfterCreate"],
    afterUpdate: ["employeeAfterUpdate"]
  },
  sidebar: {
    enabled: true,
    parentVertexLabel: "EmployeeCategory",
    toParentEdgeType: "EmployeeCategoryUser",
    rootKeys: {},
    label: "Category",
    formConfig: {
      gridColumns: 1,
      groups: [
        {
          key: "basic",
          title: "Group",
          gridColumns: 2,
          fields: [
            { key: "key", label: "Key", dataType: "text", renderer: "text", colSpan: 2, tooltip: "Optional stable key (lowercase, hyphens)." },
            { key: "name", label: "Name", dataType: "text", renderer: "text", required: true, colSpan: 2, tooltip: "Sidebar group or folder name." },
          ]
        }
      ]
    }
  },
  formConfig: {
    gridColumns: 2,
    fieldValidationByKey: {
      username: {
        pattern: "^[a-zA-Z0-9_-]+$",
        patternMessage: "Username can only contain letters, numbers, underscores, and hyphens",
        minLengthMessage: "Username must be at least 3 characters"
      },
      name: {
        pattern: "^[a-zA-Z -]+$",
        patternMessage: "Name can only contain letters, spaces, and hyphens",
        minLengthMessage: "Name must be at least 2 characters",
        maxLengthMessage: "Name must be at most 100 characters"
      }
    },
    groups: [
      {
        key: "employee",
        title: "Employee",
        gridColumns: 2,
        fields: [
          { key: "email", label: "Email", dataType: "email", renderer: "text", required: true, colSpan: 2 },
          { key: "name", label: "Name", dataType: "text", renderer: "text", required: true, colSpan: 1, minLength: 2, maxLength: 100 },
          { key: "username", label: "Username", dataType: "text", renderer: "text", required: true, colSpan: 1, minLength: 3, maxLength: 64 },
          {
            key: "role",
            label: "Roles",
            dataType: "relation", renderer: "multiSelect",
            required: true,
            colSpan: 2,
            placeholder: "Select roles",
            selectConfig: {
              label: "Role",
              labelField: "key",
              relationshipType: "UserRole",
              limit: 200,
              edgeOnly: true,
              enableUserScoping: false
            }
          },
          {
            key: "status",
            label: "Status",
            dataType: "select", renderer: "select",
            visible: (ctx) => ctx.mode !== "create",
            required: true,
            colSpan: 1,
            options: [
              { value: "active", label: "Active" },
              { value: "inactive", label: "Inactive" }
