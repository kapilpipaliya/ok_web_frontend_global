];

async function processSetting(setting) {
  const { key, tableVertexLabel, name, config } = setting;
  console.log(`Processing ${name} (${key})...`);
  const checkResult = await args.session.run(`MATCH (s:Setting {key: $key}) RETURN s`, { key });
  const exists = checkResult.records.length > 0;

  if (!dryRun) {
    if (exists) {
      await args.session.run(
        `MATCH (s:Setting {key: $key})
         SET s.config = $config,
             s.type = 'table_config',
             s.tableVertexLabel = $tableVertexLabel,
             s.updatedAt = datetime()
         RETURN s`,
        { key, config, tableVertexLabel }
      );
      return { created: 0, updated: 1 };
    }

    await args.session.run(
      `CREATE (s:Setting {
        key: $key,
        type: 'table_config',
        tableVertexLabel: $tableVertexLabel,
        config: $config,
        createdAt: datetime(),
        updatedAt: datetime()
      }) RETURN s`,
      { key, config, tableVertexLabel }
    );
    return { created: 1, updated: 0 };
  }

  return exists ? { created: 0, updated: 1 } : { created: 1, updated: 0 };
}

const stats = { created: 0, updated: 0, total: settingsConfigs.length };
for (let i = 0; i < settingsConfigs.length; i++) {
  const r = await processSetting(settingsConfigs[i]);
  stats.created += r.created;
  stats.updated += r.updated;
}


// Seed a single default settings row (Setting { key: "default" }) so Settings page has something to edit.
if (!dryRun) {
  const seedRes = await args.session.run(
    `MATCH (s:Setting {key: 'default'}) RETURN s LIMIT 1`,
    {}
  );
  if (seedRes.records.length === 0) {
    await args.session.run(
      `CREATE (s:Setting {
        key: 'default',
        timezone: 'UTC',
        lateThresholdMinutes: 10,
        autoClockOutHours: 12,
        workdayStart: '09:00',
        workdayEnd: '17:00',
        createdAt: $nowIso,
        updatedAt: $nowIso
      }) RETURN s`,
      { nowIso: new Date().toISOString() }
    );
  }
}

return {
  success: true,
  message: dryRun ? "Attendra migration dry run" : "Attendra settings migration completed",
  data: { ...stats, dryRun }
};
'''
      }
    }
  ]
  edges: []
}

