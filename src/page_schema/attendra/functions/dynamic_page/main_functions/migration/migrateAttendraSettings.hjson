{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: migrateAttendraSettings
        description: Seeds default Attendra DynamicPage table_config Setting rows (employees, roles, attendance logs, portal logs, graph files, settings). Optional dryRun in contextData.
        body:
          '''
/**
 * Attendra — migrate default table settings for DynamicPage (getUserContent / mutateUserContent).
 * contextData: { dryRun?: boolean }
 */

const { dryRun = false } = args.contextData || {};
console.log(`Attendra settings migration (dryRun: ${dryRun})`);

const settingsConfigs = [
  {
    key: "AttendraEmployee_settings_default",
    tableVertexLabel: "User",
    icon: "Users",
    name: "Employees",
    config: `return {
  title: "Employees",
