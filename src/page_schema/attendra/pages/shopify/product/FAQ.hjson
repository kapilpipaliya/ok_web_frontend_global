{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        fns: return { enabled: () => true }
        title: FAQ - Attendra
        key: FAQ
        url: /faq
        props: '''return { isNoPermissionCheck: true };'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id{ max-width: 800px; margin: 0 auto; padding: ${args.theme.var.spacing?.lg || "2rem"}; color:${args.theme.var.color.text}; }
@media (max-width: 768px){ ._id{ padding:${args.theme.var.spacing?.md || "1rem"}; } }`;'''
        displayOrder: 1
        fns:
          '''
const [expandedIndex, setExpandedIndex] = args.createSignal(null);
const toggleExpanded = (index) => setExpandedIndex((prev) => (prev === index ? null : index));
return { expandedIndex, toggleExpanded };
'''
        componentName: Html
        key: faq_root
        props: '''return { as: "main" };'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props: '''return { as:"h1", text:"Frequently asked questions" };'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        textType: markdown
        css: '''return `._id{ margin: 0 0 1.25rem 0; color:${args.theme.var.color.muted}; line-height: 1.6; }`;'''
        text: Common questions about **Attendra**.
        props: '''return { as: "div" };'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        css: '''return `._id{ display:flex; flex-direction:column; gap:1rem; }`;'''
        props: '''return { as:"section" };'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        contextName: faqItem
        loop: true
        displayOrder: 1
        componentName: Html
        css: '''return `._id{ border:1px solid ${args.theme.var.color.border}; background:${args.theme.var.color.background_light_100}; border-radius:0.75rem; overflow:hidden; }`;'''
        props:
          '''return { as:"div", data: [
  { index: 0, q: "How do staff clock in/out?", a: "Use Shopify Admin embedded pages, or your staff portal sign-in (see Dashboard → Portal Url) when you use a separate staff experience." },
  { index: 1, q: "Can I see who is currently clocked in?", a: "Yes — the dashboard shows who is clocked in now, plus totals for today." },
  { index: 2, q: "How do I add employees?", a: "Go to Employees, click Add, enter email, name, username, assign roles, and set status." },
  { index: 3, q: "Do you support payroll or biometrics?", a: "Not in the MVP. Attendra focuses on reliable time tracking first." }
] };'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        css:
          '''
return `._id{
  width: 100%;
  text-align: left;
  font-size: 1rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
  margin: 0;
  padding: 1rem 2.5rem 1rem 1rem;
  border: none;
  background: transparent;
  cursor: pointer;
  position: relative;
}
._id::after{
  content: "";
  position: absolute;
  right: 1rem;
  top: 50%;
  transform: translateY(-50%) rotate(45deg);
  width: 0.5rem;
  height: 0.5rem;
  border-right: 2px solid ${args.theme.var.color.text};
  border-bottom: 2px solid ${args.theme.var.color.text};
  transition: transform 0.2s ease;
}
._id[data-expanded="true"]::after{ transform: translateY(-50%) rotate(225deg); }`;
'''
        props:
          '''
const item = args.contextData.faqItem;
const index = item?.index ?? -1;
const isExpanded = args.fns.expandedIndex?.() === index;
return {
  as: "button",
  type: "button",
  text: item?.q || "",
  "data-expanded": isExpanded ? "true" : "false",
  onClick: () => args.fns.toggleExpanded?.(index)
};
'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        css: '''return `._id{ padding: 0 1rem 1rem 1rem; border-top:1px solid ${args.theme.var.color.border}; color:${args.theme.var.color.muted}; line-height:1.6; margin:0; }`;'''
        props:
          '''
const item = args.contextData.faqItem;
const index = item?.index ?? -1;
return { as: "p", text: item?.a || "", show: () => args.fns.expandedIndex?.() === index };
'''
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        displayOrder: 4
        componentName: Html
        textType: markdown
        css: '''return `._id{ margin-top: 1.25rem; color:${args.theme.var.color.muted}; }`;'''
        text: Need more help? Visit [Support](/support).
        props: '''return { as: "div" };'''
      }
    }
    {
      id: "layout"
      L: PageLayout
      P: {
        componentName: ShopifyLayout
      }
    }
  ]
  edges: [
    {
      id: "e1"
      T: "Attr"
      S: "1"
      E: "2"
    }
    {
      id: "e2"
      T: "PageLayout"
      S: "1"
      E: "layout"
    }
    {
      id: "e3"
      T: "Attr"
      S: "2"
      E: "3"
    }
    {
      id: "e4"
      T: "Attr"
      S: "2"
      E: "4"
    }
    {
      id: "e5"
      T: "Attr"
      S: "2"
      E: "5"
    }
    {
      id: "e6"
      T: "Attr"
      S: "2"
      E: "9"
    }
    {
      id: "e7"
      T: "Attr"
      S: "5"
      E: "6"
    }
    {
      id: "e8"
      T: "Attr"
      S: "6"
      E: "7"
    }
    {
      id: "e9"
      T: "Attr"
      S: "6"
      E: "8"
    }
  ]
}

