{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        fns: return { enabled: () => true }
        title: Changelog - Attendra
        url: /changelog
        key: Changelog
        props: '''return { isNoPermissionCheck: true };'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id{ max-width: 860px; margin: 0 auto; padding: ${args.theme.var.spacing?.lg || "2rem"}; color:${args.theme.var.color.text}; }
@media (max-width: 768px){ ._id{ padding:${args.theme.var.spacing?.md || "1rem"}; } }`;'''
        displayOrder: 1
        componentName: Html
        props: '''return { as:"main" };'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props: '''return { as:"h1", text:"Changelog" };'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        css: '''return `._id{ color:${args.theme.var.color.muted}; line-height:1.6; margin:0 0 1rem 0; }`;'''
        props: '''return { as:"p", text:"Recent updates and improvements to Attendra." };'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        css: '''return `._id{ margin-bottom: 1.25rem; }`;'''
        props: '''return { as:"section" };'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        css: '''return `._id{ font-size: 1.25rem; font-weight: 600; margin:0 0 0.35rem 0; }`;'''
        props: '''return { as:"h2", text:"May 2026" };'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        textType: markdown
        css: '''return `._id{ color:${args.theme.var.color.muted}; line-height:1.7; margin:0; }`;'''
        text:
          '''- MVP admin pages: Dashboard, Employees, Roles, Time Logs, Settings
- Staff portal sign-in URL on Dashboard
- Dashboard lateness driven by Settings (timezone + late threshold + start time)'''
        props: '''return { as:"div", textType:"markdown" };'''
      }
    }
    {
      id: "layout"
      L: PageLayout
      P: {
        componentName: ShopifyLayout
      }
    }
  ]
  edges: [
    {
      id: "e1"
      T: "Attr"
      S: "1"
      E: "2"
    }
