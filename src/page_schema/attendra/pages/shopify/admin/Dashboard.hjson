}'''
      }
    }
    {
      id: "12"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        key: portal_signin
        css:
          '''return `._id{
  margin: 0 0 1.25rem 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}`;'''
        props:
          '''const d = args.fns.dashboard?.();
const path = d?.portalSignInPath || "";
const href = typeof d?.portalSignInUrl === "string" && d.portalSignInUrl.length > 0 ? d.portalSignInUrl : "";
const show = args.fns.isInIframe() && !!path && !!href && href !== "#";
return {
  as: "s-button",
  "attr:variant": "secondary",
  text: "Portal Signin",
  hide: !show,
  onClick: () => {
    if (href && href !== "#") {
      window.open(href, "_blank", "noopener,noreferrer");
    }
  }
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 4
        componentName: Html
        key: cards
        css:
          '''return `._id{
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.75rem;
  margin-bottom: 1.25rem;
}
@media (max-width: 900px){
  ._id{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 520px){
  ._id{ grid-template-columns: 1fr; }
}`;'''
        props: '''return { as: "section" }'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        contextName: kpi
        loop: true
        displayOrder: 1
        componentName: Html
        css:
          '''return `._id{
  border: 1px solid ${args.theme.var.color.border};
  background: ${args.theme.var.color.background_light_100};
  border-radius: 0.75rem;
  padding: 0.9rem 1rem;
  min-width: 0;
}`;'''
        props:
          '''
const d = args.fns.dashboard?.();
const loading = args.fns.loading?.();
const items = [
  { k: "presentToday", label: "Present today", value: d?.presentToday ?? (loading ? "…" : "0") },
  { k: "clockedInNow", label: "Clocked in now", value: d?.clockedInNow ?? (loading ? "…" : "0") },
  { k: "lateArrivals", label: "Late arrivals", value: d?.lateArrivals ?? (loading ? "…" : "0") },
  { k: "hoursToday", label: "Hours today", value: d?.hoursToday ?? (loading ? "…" : "0.0") }
];

return {
  as: "div",
  data: items
};
'''
      }
    }
