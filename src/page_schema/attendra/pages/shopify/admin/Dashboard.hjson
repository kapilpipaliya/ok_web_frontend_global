        key: h1
        css:
          '''return `._id{
  font-size: 1.75rem;
  font-weight: 700;
  margin: 0 0 0.5rem 0;
  color: ${args.theme.var.color.text};
}`;'''
        props:
          '''return {
  as: "h1",
  text: "Time dashboard"
}'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 2
