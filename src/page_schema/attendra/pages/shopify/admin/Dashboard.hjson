    {
      id: "11"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        textType: markdown
        css:
          '''return `._id{ margin: 0; color:${args.theme.var.color.muted}; font-size: 0.95rem; line-height: 1.6; }`;'''
        props:
          '''
const d = args.fns.dashboard?.();
const rows = Array.isArray(d?.recentActivity) ? d.recentActivity : [];
const text = rows.length ? rows.map((r) => `- ${r}`).join("\\n") : (args.fns.loading?.() ? "Loading…" : "No activity yet.");
return { as: "div", text, textType: "markdown" };
'''
      }
