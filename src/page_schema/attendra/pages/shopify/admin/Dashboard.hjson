{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns:
          '''
const isInIframe = args.atom(false);
const [loading, setLoading] = args.createSignal(false);
const [dashboard, setDashboard] = args.createSignal(null);

const loadDashboard = async () => {
  try {
    setLoading(true);
    const res = await args.executeNamedServerFunction({
      functionName: "getDashboard",
      contextData: {}
    });
    const ok = res?.result?.success !== false && !res?.error;
    if (!ok) {
      args.showErrorToast?.(res?.error || res?.result?.error || "Failed to load dashboard");
      setDashboard(null);
      return;
    }
    setDashboard(res?.result?.data || null);
  } finally {
    setLoading(false);
  }
};

return {
  enabled: () => true,
  isInIframe,
  loading,
  dashboard,
  loadDashboard
};
'''
        title: Dashboard - Attendra
        url: /app
        key: Dashboard
        props:
          '''return {
  isNoPermissionCheck: true,
  onMount: () => {
    args.fns.isInIframe(window.self !== window.top);
    if (args.fns.isInIframe()) args.fns.loadDashboard();
  }
}'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: root
        css:
          '''return `._id{
  max-width: 1100px;
  margin: 0 auto;
  padding: ${args.theme.var.spacing?.lg || "2rem"};
}
@media (max-width: 768px){
  ._id{ padding: ${args.theme.var.spacing?.md || "1rem"}; }
}`;'''
        props:
          '''return {
  as: "main",
  hide: !args.fns.isInIframe()
}'''
      }
    }
    {
      id: "3"
      L: Attr
