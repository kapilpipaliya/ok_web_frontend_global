{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns:
          '''
const checkAdminRole = () => {
  const userRoles = args.user?.OUT?.UserRole || [];
  return userRoles.some((edgeId) => {
    const edge = args.graph.edges[edgeId];
    const role = args.graph.vertexes[edge?.E];
    return role?.P?.key === "Admin";
  });
};

const logoUploadConfiguration = (attachFieldKey, logoName, acceptOverride) => ({
  accept:
    acceptOverride ||
    "image/png,image/jpeg,image/jpg,image/webp,image/gif,image/svg+xml",
  uploadUrl: "/api/file/upload",
  attachUploadedFileToFieldKey: attachFieldKey,
  hidePreview: true,
  enableDragDrop: false,
  pickButtonLabel: `Upload ${logoName}`,
  pickButtonVariant: "secondary",
  fullWidth: false,
  successToastMessage: "File uploaded",
  uploadFailedMessage: "Upload failed",
  noFileReturnedMessage: "Upload failed: no file returned",
  notInGraphMessage: "Upload saved but file not found in graph",
  onUploadSuccess: async ({ uploadedId, callbacks, configuration, syncPreview, showSuccess }) => {
    const fieldKey = configuration.attachUploadedFileToFieldKey;
    if (fieldKey && typeof callbacks.setFieldValue === "function") {
      callbacks.setFieldValue(fieldKey, uploadedId);
    }
    syncPreview(uploadedId);
    showSuccess();
  },
});

const filePickerConfiguration = (modalTitle) => ({
  chooseButtonLabel: "Select file…",
  clearButtonLabel: "Clear",
  modalTitle,
  modalHintEmpty: "Select a file using the checkbox, then confirm.",
  modalHintSelected: "Selected: {name} — confirm or choose another file.",
  selectionMode: "single",
  confirmButtonLabel: "Use selection",
  cancelButtonLabel: "Cancel",
  closeButtonLabel: "Close",
  selectRowMessage: "Select a row in the list first.",
  invalidTypeMessage: "This type does not match the configured selection.",
  usePolarisUI: true,
  targetVertexLabels: ["File"],
  fileDownloadUrlPrefix: "/api/file/download",
  showImagePreview: true,
  buildSecondaryLabelFromVertex: true,
  pickerBodyProps: {
    tableVertexLabel: "File",
    tableSettingsLabel: "File",
    loadFromSetting: true
  }
});

const companyBrandingFormConfiguration = {
  gridColumns: 1,
  groups: [
    {
      key: "rectangular_logo",
      title: "Rectangular company logo",
      gridColumns: 1,
      fields: [
        {
          dataType: "file",
          renderer: "graphFileUpload",
          key: "rectangularLogoUpload",
          uploadConfiguration: logoUploadConfiguration(
            "rectangularLogo",
            "Rectangular Logo"
          ),
        },
        {
          dataType: "relation",
          renderer: "embeddedVertexPicker",
          key: "rectangularLogo",
          label: "Or choose from Files",
          helpText: "Upload above or pick a file from the repository. Used in headers and wide layouts.",
          pickerConfiguration: filePickerConfiguration("Choose rectangular logo")
        }
      ]
    },
    {
      key: "square_logo",
      title: "Square company logo",
      gridColumns: 1,
      fields: [
        {
          dataType: "file",
          renderer: "graphFileUpload",
          key: "squareLogoUpload",
          uploadConfiguration: logoUploadConfiguration(
            "squareLogo",
            "Square Logo"
          ),
        },
        {
          dataType: "relation",
          renderer: "embeddedVertexPicker",
          key: "squareLogo",
          label: "Or choose from Files",
          helpText: "Square logo for compact UI (portal sidebar, auth screens).",
          pickerConfiguration: filePickerConfiguration("Choose square logo")
        }
      ]
    },
    {
      key: "favicon",
      title: "Company favicon",
      gridColumns: 1,
      fields: [
        {
          dataType: "file",
          renderer: "graphFileUpload",
          key: "faviconUpload",
          uploadConfiguration: logoUploadConfiguration(
            "favicon",
            "Favicon",
            "image/png,image/jpeg,image/jpg,image/webp,image/gif,image/svg+xml,image/x-icon,image/vnd.microsoft.icon"
          ),
        },
        {
          dataType: "relation",
          renderer: "embeddedVertexPicker",
          key: "favicon",
          label: "Or choose from Files",
          helpText: "Small icon shown in browser tabs.",
          pickerConfiguration: filePickerConfiguration("Choose favicon")
        }
      ]
    }
  ]
};

const fileIdOrNull = (rawValue) => {
  const trimmed = rawValue != null ? String(rawValue).trim() : "";
  return trimmed !== "" ? trimmed : null;
};

const saveCompanyBrandingForm = async (savePayload) => {
  const formVertex = savePayload?.vertex;
  const rectangularLogo = fileIdOrNull(formVertex?.P?.rectangularLogo);
  const squareLogo = fileIdOrNull(formVertex?.P?.squareLogo);
  const favicon = fileIdOrNull(formVertex?.P?.favicon);
  if (!(rectangularLogo || squareLogo || favicon)) {
    args.showErrorToast?.("Select or upload at least one logo or favicon.");
    return false;
  }
  try {
    const response = await args.postAPI("/api/settings/updateCompanyLogo", {
      rectangularLogo,
      squareLogo,
      favicon
    });
    if (response?.graph && typeof response.graph === "object") {
      args.setGraphData(0, response.graph, {});
    }
    args.showSuccessToast?.(
      (typeof response.message === "string" && response.message) ||
        "Company branding updated successfully"
    );
    return true;
  } catch (error) {
    args.showErrorToast?.(error instanceof Error ? error.message : "Save failed");
    return false;
  }
};

return {
  enabled: () => true,
  checkAdminRole,
  companyBrandingFormConfiguration,
  saveCompanyBrandingForm,
};
'''
        title: Company branding - Attendra
        url: /portal/company-branding
        key: PortalCompanyBranding
        dynamicComponent: FloatingHelpTooltip, VertexPicker, FileUploader, FormManagement
        props:
          '''let companyBrandingFilesMerged = false;

const mergeCompanyBrandingFileVertices = () => {
  if (companyBrandingFilesMerged) return;
  companyBrandingFilesMerged = true;

  const globalSettingId = args.graph?.vertexLabelIdMap?.GlobalSetting?.[0];
  if (!globalSettingId) return;
  const globalSetting = args.graph.vertexes[globalSettingId];
  if (!globalSetting) return;

  const logoFiles = [
    args.evalExpression("->CompanyRectangularLogo", {
      graph: args.graph,
      vertexes: [globalSetting],
    })?.[0],
    args.evalExpression("->CompanySquareLogo", {
      graph: args.graph,
      vertexes: [globalSetting],
    })?.[0],
    args.evalExpression("->CompanyFavicon", {
      graph: args.graph,
      vertexes: [globalSetting],
    })?.[0],
  ].filter((file) => file?.id != null);

  const vertexMap = {};
  for (const file of logoFiles) {
    if (!args.graph.vertexes[file.id]) {
      vertexMap[file.id] = file;
    }
  }
  if (Object.keys(vertexMap).length > 0) {
    args.setGraphData(0, { vertexes: vertexMap }, {});
  }
};

return {
  isNoPermissionCheck: true,
  onMount: () => {
    if (!args.user) {
      args.navigate("/auth/signin", { replace: true });
      return;
    }
    if (!args.fns.checkAdminRole?.()) {
      args.showErrorToast?.("Admin access required");
      args.navigate("/portal/check-in", { replace: true });
      return;
    }
    mergeCompanyBrandingFileVertices();
  }
};'''
      }
