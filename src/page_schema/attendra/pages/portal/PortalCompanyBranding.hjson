    { id: "e_root_title", T: "Attr", S: "root", E: "title_row" }
    { id: "e_title_h1", T: "Attr", S: "title_row", E: "h1" }
    { id: "e_title_intro", T: "Attr", S: "title_row", E: "intro" }
    { id: "e_root_form", T: "Attr", S: "root", E: "branding_form" }
    { id: "e_layout", T: "PageLayout", S: "1", E: "layout" }
  ]
}
