        props:
          '''const globalSettingId = args.graph?.vertexLabelIdMap?.GlobalSetting?.[0];
const globalSetting = globalSettingId ? args.graph.vertexes[globalSettingId] : null;

const logoFileFromRelationship = (relationshipType) => {
  if (!globalSetting) return null;
  return (
    args.evalExpression(`->${relationshipType}`, {
      graph: args.graph,
      vertexes: [globalSetting],
    })?.[0] ?? null
  );
};

const fileElementId = (fileVertex) =>
  fileVertex?.id != null ? String(fileVertex.id) : "";

const rectangularFile = logoFileFromRelationship("CompanyRectangularLogo");
const squareFile = logoFileFromRelationship("CompanySquareLogo");
const faviconFile = logoFileFromRelationship("CompanyFavicon");

const logoFieldValues = {
  rectangularLogo: fileElementId(rectangularFile),
  squareLogo: fileElementId(squareFile),
  favicon: fileElementId(faviconFile),
};

const initialVertex =
  globalSetting != null
    ? {
        id: globalSetting.id,
        L: globalSetting.L,
        IN: globalSetting.IN,
        OUT: globalSetting.OUT,
        P: {
          ...globalSetting.P,
          ...logoFieldValues,
        },
      }
    : null;

return {
  formConfig: args.fns.companyBrandingFormConfiguration,
  initialVertex,
  clonePropertyOverrides: logoFieldValues,
  vertexLabel: "GlobalSetting",
  mode: "edit",
  onSave: args.fns.saveCompanyBrandingForm,
  afterSuccessfulSave: "reinitialize",
  hide: globalSetting == null,
  class: "portal-company-branding-form"
};'''
      }
