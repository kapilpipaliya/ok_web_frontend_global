{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns:
          '''
const [loading, setLoading] = args.createSignal(true);
const [openLog, setOpenLog] = args.createSignal(null);
const [elapsedLabel, setElapsedLabel] = args.createSignal("");

const formatElapsed = (ms) => {
  const totalSec = Math.max(0, Math.floor(ms / 1000));
  const h = Math.floor(totalSec / 3600);
  const m = Math.floor((totalSec % 3600) / 60);
  const s = totalSec % 60;
  const pad = (n) => String(n).padStart(2, "0");
  return h > 0 ? `${h}:${pad(m)}:${pad(s)}` : `${pad(m)}:${pad(s)}`;
};

const getClockInMs = (log) => {
  const iso = log?.P?.clockInAt;
  if (iso == null || String(iso).trim() === "") return NaN;
  const t = new Date(String(iso)).getTime();
  return Number.isFinite(t) ? t : NaN;
};

const formatClockInAt = (iso) => {
  if (iso == null || String(iso).trim() === "") return "—";
  try {
    const d = new Date(String(iso));
    if (Number.isNaN(d.getTime())) return String(iso);
    return d.toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" });
  } catch {
    return String(iso);
  }
};

const tickElapsed = () => {
  const ol = openLog();
  if (!ol) {
    setElapsedLabel("");
    return;
  }
  const start = getClockInMs(ol);
  if (!Number.isFinite(start)) {
    setElapsedLabel("—");
    return;
  }
  setElapsedLabel(formatElapsed(Date.now() - start));
};

args.createEffect(() => {
  const ol = openLog();
  if (!ol) {
    setElapsedLabel("");
    return;
  }
  tickElapsed();
  const timerId = setInterval(tickElapsed, 1000);
  return () => clearInterval(timerId);
});

const isClockedIn = () => {
  const ol = openLog();
  return ol != null && typeof ol === "object";
};

const loadState = async () => {
  try {
    setLoading(true);
    const res = await args.executeNamedServerFunction({
      functionName: "portalGetMyTime",
      contextData: {}
    });
    const ok = res?.result?.success !== false && !res?.error;
    if (!ok) {
      args.showErrorToast?.(res?.result?.error || res?.error || "Failed to load time status");
      setOpenLog(null);
      return;
    }
    setOpenLog(res?.result?.data?.openLog ?? null);
  } finally {
    setLoading(false);
  }
};

const toggleClock = async () => {
  try {
    setLoading(true);
    const res = await args.executeNamedServerFunction({
      functionName: "portalClockToggle",
      contextData: {}
    });
    const ok = res?.result?.success !== false && !res?.error;
    if (!ok) {
      args.showErrorToast?.(res?.result?.error || res?.error || "Clock action failed");
      return;
    }
    const action = res?.result?.data?.action;
    args.showSuccessToast?.(action === "clocked_out" ? "Clocked out" : "Clocked in");
    await loadState();
  } finally {
    setLoading(false);
  }
};

return {
  loading,
  openLog,
  isClockedIn,
  elapsedLabel,
  formatClockInAt,
  loadState,
  toggleClock
};
'''
        title: Check in - Attendra
        url: /portal/check-in
        key: PortalCheckIn
        props:
          '''return {
  isNoPermissionCheck: true,
  onMount: () => {
    if (!args.user) {
      args.navigate("/auth/signin", { replace: true });
      return;
    }
    args.fns.loadState();
  }
};'''
      }
    }
