}`;'''
        props:
          '''const loading = args.fns.loading();
let text = "Loading…";
if (!loading && !args.fns.isClockedIn()) {
  text = "You are clocked out. Clock in to start recording your time.";
}
return {
  as: "p",
  hide: () => loading || args.fns.isClockedIn(),
  text
};'''
      }
    }
