{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns:
          '''
return {
  executeYTOFunction: (functionName, contextData) =>
    args.executeNamedServerFunction({ functionName, contextData: contextData || {} })
};
'''
        title: My Time Logs - Attendra
        url: /portal/time-logs
        key: PortalLogs
        props:
          '''return {
  isNoPermissionCheck: true,
  onMount: () => {
    if (!args.user) {
      args.navigate("/auth/signin", { replace: true });
    }
  }
};'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        css:
          '''return `._id {
  width: 100%;
  max-width: none;
  margin: 0;
  text-align: left;
}`;'''
        props:
          '''return {
  as: "section"
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 1
        componentName: DynamicPage
        key: portal_time_logs_dynamic_page
        props:
          '''return {
  tableVertexLabel: "Time",
  tableSettingsLabel: "TimePortal",
  loadFromSetting: true
};'''
      }
    }
    {
      id: "layout"
      L: PageLayout
      P: {
        componentName: PortalLayout
      }
    }
  ]
  edges: [
    {
      id: e_page_root
      T: Attr
      S: "1"
      E: "2"
    }
    {
      id: e_root_dynamic
      T: Attr
      S: "2"
      E: "5"
    }
    {
      id: e_layout
      T: PageLayout
      S: "1"
      E: "layout"
    }
  ]
}
