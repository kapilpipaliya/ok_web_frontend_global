{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        fns: return { enabled: () => true }
        title: Privacy Policy - Attendra
        url: /privacy
        key: Privacy
        props: '''return { isNoPermissionCheck: true };'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id{ max-width: 860px; margin:0 auto; padding:${t.var.spacing?.lg || "2rem"}; color:${t.var.color.text}; }
@media (max-width: 768px){ ._id{ padding:${t.var.spacing?.md || "1rem"}; } }`;'''
        displayOrder: 1
        componentName: Html
        props: '''return { as:"main" };'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props: '''return { as:"h1", text:"Privacy Policy" };'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        css: '''return `._id{ color:${t.var.color.text_light_500}; font-style:italic; margin:0 0 1rem 0; font-size:0.95rem; }`;'''
        props:
          '''const d = new Date(2026, 4, 8);
const lastUpdated = "Last updated on: " + d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
return { as:"p", text: lastUpdated };'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        textType: markdown
        css: '''return `._id{ color:${t.var.color.text_light_500}; line-height:1.7; margin:0; }`;'''
        text:
          '''DecodeCommerce provides applications (“the Service”), including **Attendra**, to merchants who use Shopify. This Privacy Policy describes how data is collected, used, and shared when you install or use our app.\n\n- We store employee records you create (name, email, username, roles, status).\n- We store time logs (clock in/out timestamps, totals) created by your team.\n- We use this information only to provide the time tracking features.\n\nFor questions, contact us via [Support](/support) or email `privacy@decodecommerce.com`.'''
        props: '''return { as:"div", textType:"markdown" };'''
      }
    }
    {
      id: "layout"
      L: PageLayout
      P: {
        componentName: ShopifyLayout
      }
    }
  ]
  edges: [
