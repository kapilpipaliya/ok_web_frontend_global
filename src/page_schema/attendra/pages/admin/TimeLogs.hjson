{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns:
          '''
const isInIframe = _.atom(false);
return {
  enabled: () => true,
  executeYTOFunction: (functionName, contextData) =>
    s({ functionName, contextData: contextData || {} }),
  isInIframe
};
'''
        title: Time Logs - Attendra
        url: /time-logs
        key: Logs
        props:
          '''return {
  isNoPermissionCheck: true,
  onMount: () => f.isInIframe(window.self !== window.top)
}'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: DynamicPage
        key: logs_dynamic_page
        props:
          '''return {
  tableVertexLabel: "Time",
  loadFromSetting: true,
  hide: !f.isInIframe()
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        key: unique_outside
        as: "div"
        css: "return `._id { font-size: 1rem; line-height: 1.6; color: ${t.var.color.text}; padding: 1rem; }`;"
        props: "return { show: f.isInIframe() === false };"
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: unique_outside_p
        text: "Please open **Attendra** inside your Shopify admin (embedded app)."
        textType: "markdown"
        props: "return { as: 'div' };"
      }
    }
    {
      id: "layout"
      L: PageLayout
      P: {
        componentName: ShopifyLayout
      }
    }
  ]
  edges: [
    {
      id: "e1"
      T: "Attr"
      S: "1"
      E: "2"
    }
    {
      id: "e2"
      T: "Attr"
      S: "1"
      E: "3"
    }
    {
      id: "e3"
      T: "Attr"
      S: "3"
      E: "4"
    }
    {
      id: "e4"
      T: "PageLayout"
      S: "1"
      E: "layout"
    }
  ]
}

