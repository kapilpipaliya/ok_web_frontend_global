        displayOrder: 1
        fns:
          '''
const [ticket, setTicket] = _.createSignal(null);
const [messages, setMessages] = _.createSignal([]);
const [loading, setLoading] = _.createSignal(false);
const [sendingReply, setSendingReply] = _.createSignal(false);
const [replyText, setReplyText] = _.createSignal("");

const getSupportId = () => {
  const id = _.searchParams?.supportId;
  return typeof id === "string" && id ? id : null;
};

const loadConversation = async () => {
  const ticketId = getSupportId();
  if (!ticketId) {
    return;
  }

  setLoading(true);
  try {
    const result = await s({
      functionName: "shopifySupportGetConversation",
      contextData: {
        ticketId,
        markAsReadFor: "admin"
      }
    });

    if (result?.error || result?.result?.success === false) {
      const message =
        result?.error ||
        result?.result?.message ||
        "Failed to load conversation.";
      _.showErrorToast?.(message);
      return;
    }

    const payload = result?.result?.data || {};
    const t = payload.ticket || null;
    const msgs = Array.isArray(payload.messages) ? payload.messages : [];

    // Prepend the initial ticket message as the first message in the conversation
    const allMessages = [];
    if (t && t.P?.message) {
      allMessages.push({
        P: {
          message: t.P.message,
          createdAt: t.P.createdAt || t.P.updatedAt,
          email: t.P.email || "",
          name: t.P.name || "",
          senderType: "shop"
        }
      });
    }
    allMessages.push(...msgs);

    setTicket(t);
    setMessages(allMessages);
  } catch (error) {
    console.error("AdminSupportConversation.loadConversation error:", error);
    _.showErrorToast?.("Failed to load conversation.");
  } finally {
    setLoading(false);
  }
};

const sendReply = async () => {
  const ticketId = getSupportId();
  const text = (replyText() || "").trim();
  if (!ticketId || !text) {
    return;
  }

  setSendingReply(true);
  try {
    const result = await s({
      functionName: "shopifySupportReplyAsAdmin",
      contextData: {
        ticketId,
        message: text
      }
    });

    if (result?.error || result?.result?.success === false) {
      const message =
        result?.error ||
        result?.result?.message ||
        "Failed to send reply.";
      _.showErrorToast?.(message);
      return;
    }

    const reply = result?.result?.data?.reply;
    if (reply) {
      const current = messages() || [];
      setMessages([...current, reply]);
    } else {
      await loadConversation();
    }

    setReplyText("");
    _.showSuccessToast?.("Reply sent.");
  } catch (error) {
    console.error("AdminSupportConversation.sendReply error:", error);
    _.showErrorToast?.("Failed to send reply.");
  } finally {
    setSendingReply(false);
  }
};

const formatTimestamp = (timestamp) => {
  if (!timestamp) return "";
  try {
    const date = new Date(timestamp);
    const now = new Date();
    const diffMs = now - date;
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);

    if (diffMins < 1) {
      return "Just now";
    } else if (diffMins < 60) {
      return `${diffMins}m ago`;
    } else if (diffHours < 24) {
      return `${diffHours}h ago`;
    } else if (diffDays === 1) {
      return "Yesterday";
    } else if (diffDays < 7) {
      return `${diffDays}d ago`;
    } else {
      // Format as short date: "Jan 15" or "Dec 3"
      return date.toLocaleDateString("en-US", { month: "short", day: "numeric" });
    }
  } catch (e) {
    return String(timestamp);
  }
};

const initializeConversation = async () => {
  await loadConversation();
};

return {
  formatTimestamp,
  ticket,
  messages,
  loading,
  sendingReply,
  replyText,
  setReplyText,
  initializeConversation,
  loadConversation,
  sendReply
};
'''
        componentName: Html
        key: admin_support_root
        props:
          '''
return {
  as: "div",
  onMount: async () => {
    await f.initializeConversation();
  }
};
'''
      }
    }
