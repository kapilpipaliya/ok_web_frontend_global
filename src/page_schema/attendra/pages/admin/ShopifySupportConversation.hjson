        displayOrder: 2
        componentName: Html
        props:
          '''
const m = c.message;
const createdAt = m?.P?.createdAt;
let createdText = "";
if (createdAt) {
  try {
    const date = new Date(createdAt);
    const now = new Date();
    const isToday = date.toDateString() === now.toDateString();

    if (isToday) {
      // Show time only for today's messages
      createdText = date.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
    } else {
      // Show short date + time for older messages
      createdText = date.toLocaleDateString("en-US", { month: "short", day: "numeric" }) + " " + 
                    date.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
    }
  } catch (e) {
    createdText = String(createdAt);
  }
}

return {
  as: "div",
  text: createdText || ""
};
'''
