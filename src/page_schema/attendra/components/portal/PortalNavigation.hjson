  graph: g,
  vertexes: [_.user]
})?.[0];
const fileName =
  imageFileVertex?.P?.fileName != null ? String(imageFileVertex.P.fileName).trim() : "";
const profileImageUrl =
  fileName !== ""
    ? `/api/file/download/${encodeURIComponent(fileName)}`
    : "";
const safeCssUrl = profileImageUrl.replace(/\\/g, "\\\\").replace(/"/g, '\\"');
return {
  as: "div",
  hide: profileImageUrl === "",
  style:
    profileImageUrl !== "" ? `background-image: url("${safeCssUrl}")` : "",
  "attr:role": "img",
  "attr:aria-label": "Profile photo"
};'''
