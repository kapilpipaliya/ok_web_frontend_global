{
  vertexes: [
    {
      id: "pn1"
      L: Component
      P: {
        title: PortalNavigation
        key: PortalNavigation
        fns:
          '''
const [userMenuOpen, setUserMenuOpen] = _.createSignal(false);
const [userMenuTriggerRef, setUserMenuTriggerRef] = _.createSignal(null);
const [userMenuPanelRef, setUserMenuPanelRef] = _.createSignal(null);
const [menuHoverKey, setMenuHoverKey] = _.createSignal(null);
let userMenuFloatingCleanup = null;

const syncUserMenuWidth = (triggerElement, menuElement) => {
  const triggerWidth = Math.round(triggerElement.getBoundingClientRect().width);
  if (triggerWidth > 0) {
    const widthPx = `${triggerWidth}px`;
    menuElement.style.width = widthPx;
    menuElement.style.minWidth = widthPx;
    menuElement.style.maxWidth = widthPx;
  }
};

const setMenuItemHover = (key) => setMenuHoverKey(key);
const clearMenuItemHover = () => setMenuHoverKey(null);

const setupUserMenuFloating = async () => {
  const triggerElement = userMenuTriggerRef();
  const menuElement = userMenuPanelRef();
  if (!triggerElement || !menuElement || !_.floatingUI) return;
  syncUserMenuWidth(triggerElement, menuElement);
  const { computePosition, flip, shift, offset, autoUpdate } = _.floatingUI;
  const updatePosition = async () => {
    syncUserMenuWidth(triggerElement, menuElement);
    const { x, y } = await computePosition(triggerElement, menuElement, {
      placement: "top-start",
      strategy: "fixed",
      middleware: [offset(8), flip(), shift({ padding: 8 })]
    });
    Object.assign(menuElement.style, { left: `${x}px`, top: `${y}px` });
  };
  await updatePosition();
  userMenuFloatingCleanup = autoUpdate(triggerElement, menuElement, updatePosition, {
    ancestorScroll: true,
    ancestorResize: true,
    elementResize: true,
    layoutShift: true
  });
};

const toggleUserMenu = (clickEvent) => {
  clickEvent?.preventDefault();
  clickEvent?.stopPropagation();
  const nextOpen = !userMenuOpen();
  setUserMenuOpen(nextOpen);
  if (nextOpen) {
    requestAnimationFrame(() => void setupUserMenuFloating());
  } else if (userMenuFloatingCleanup) {
    userMenuFloatingCleanup();
    userMenuFloatingCleanup = null;
  }
};

const closeUserMenu = () => {
  setUserMenuOpen(false);
  if (userMenuFloatingCleanup) {
    userMenuFloatingCleanup();
    userMenuFloatingCleanup = null;
  }
};

const handleUserMenuDocumentClick = (clickEvent) => {
  const triggerElement = userMenuTriggerRef();
  const menuElement = userMenuPanelRef();
  if (!triggerElement || !menuElement) return;
  if (!triggerElement.contains(clickEvent.target) && !menuElement.contains(clickEvent.target)) {
    closeUserMenu();
  }
};

const navigateFromUserMenu = (path) => {
  closeUserMenu();
  _.navigate(path);
};

const navigateToLogout = () => {
  navigateFromUserMenu("/auth/logout");
};

const checkAdminRole = () => {
  const userRoles = _.user?.OUT?.UserRole || [];
  return userRoles.some((edgeId) => {
    const edge = g.edges[edgeId];
    const role = g.vertexes[edge?.E];
    return role?.P?.key === "Admin";
  });
};

const portalNavSectionsData = [
  {
    id: "staff",
    items: [
      {
        id: "check_in",
        href: "/portal/check-in",
        label: "Check in",
        icon: "ph:clock",
        pathCheck: (pathname) => String(pathname || "") === "/portal/check-in"
      },
      {
        id: "time_logs",
        href: "/portal/time-logs",
        label: "My Time Logs",
        icon: "ph:clipboard-text",
        pathCheck: (pathname) => String(pathname || "") === "/portal/time-logs"
      },
      {
        id: "tasks",
        href: "/portal/tasks",
        label: "My tasks",
        icon: "ph:check-square",
        pathCheck: (pathname) => String(pathname || "") === "/portal/tasks"
      }
    ]
  },
  {
    id: "admin",
    title: "Admin",
    showIf: () => checkAdminRole(),
    items: [
      {
        id: "company_branding",
        href: "/portal/company-branding",
        label: "Company branding",
        icon: "ph:paint-brush-broad",
        pathCheck: (pathname) => String(pathname || "") === "/portal/company-branding"
      }
    ]
  }
];

const portalNavSections = _.createMemo(() =>
  portalNavSectionsData.filter(
    (section) => !section.showIf || section.showIf(),
  ),
);

const isNavItemActive = (item) =>
  item.pathCheck ? item.pathCheck(_.location?.pathname) : false;

const onUserMenuMount = () => {
  document.addEventListener("click", handleUserMenuDocumentClick);
  return () => {
    document.removeEventListener("click", handleUserMenuDocumentClick);
    if (userMenuFloatingCleanup) userMenuFloatingCleanup();
  };
};

return {
  userMenuOpen,
  menuHoverKey,
  setUserMenuTriggerRef,
  setUserMenuPanelRef,
  setMenuItemHover,
  clearMenuItemHover,
  toggleUserMenu,
  closeUserMenu,
  navigateFromUserMenu,
  navigateToLogout,
  onUserMenuMount,
  checkAdminRole,
  portalNavSections,
  isNavItemActive
};
'''
      }
    }
