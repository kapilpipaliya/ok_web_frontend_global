        displayOrder: 1
        fns:
          '''
const getInitialConfig = () => c.props?.initialConfig || "";
const getTableVertexLabel = () => c.props?.tableVertexLabel;
const onSave = c.props?.onSave;
const rbConfirm = c?.confirmContext?.rbConfirm;

// State
const [configText, setConfigText] = _.createSignal("");
const [isLoadingDefault, setIsLoadingDefault] = _.createSignal(false);
const [isExampleExpanded, setIsExampleExpanded] = _.createSignal(false);

// Initialize from props
const initialize = () => {
  const initial = getInitialConfig();
  if (typeof initial === "string") {
    // If it's already a string (function body), use it directly
    setConfigText(initial);
  } else if (initial && typeof initial === "object") {
    // If it's an object, convert to function body format
    try {
      const objString = JSON.stringify(initial, null, 2);
      // Wrap in return statement for function body
      setConfigText(`return ${objString};`);
    } catch (e) {
      setConfigText("return {};");
    }
  } else {
    // Default empty function body
    setConfigText("return {};");
  }
};

// Load default settings
const handleLoadDefault = async () => {
  if (!rbConfirm) {
    if (_.showErrorToast) {
      _.showErrorToast("Confirmation dialog not available");
    }
    return;
  }

  const tableVertexLabel = getTableVertexLabel();
  if (!tableVertexLabel) {
    if (_.showErrorToast) {
      _.showErrorToast("Content type not available");
    }
    return;
  }

  // Show confirmation
  const confirmed = await rbConfirm({
    title: "Load Default Settings",
    message: "This will replace your current configuration with the default settings. Are you sure you want to continue?",
    confirmText: "Load Default",
    cancelText: "Cancel",
    variant: "primary"
  });

  if (!confirmed) {
    return;
  }

  try {
    setIsLoadingDefault(true);

    // Fetch default settings
    const result = await f.executeYTOFunction("getUserContentSetting", {
      tableVertexLabel,
      key: `${tableVertexLabel}_settings_default`
    });

    if (result?.error) {
      if (_.showErrorToast) {
        _.showErrorToast(result.error);
      }
      return;
    }

    if (result?.result?.success && result.result.data?.setting) {
      const settingData = result.result.data.setting.P || {};
      const configText = settingData.config;

      if (typeof configText === 'string') {
        setConfigText(configText);
        if (_.showSuccessToast) {
          _.showSuccessToast("Default settings loaded successfully");
        }
      } else {
        if (_.showErrorToast) {
          _.showErrorToast("Default settings not found or invalid");
        }
      }
    } else {
      if (_.showErrorToast) {
        _.showErrorToast("Default settings not found");
      }
    }
  } catch (error) {
    console.error("Error loading default settings:", error);
    if (_.showErrorToast) {
      _.showErrorToast(error.message || "Failed to load default settings");
    }
  } finally {
    setIsLoadingDefault(false);
  }
};

// Handle save
const handleSave = () => {
  if (!onSave) return;

  try {
    const text = configText().trim();
    if (!text) {
      throw new Error("Configuration cannot be empty");
    }

    // Validate that it's a valid function body by trying to create a function
    try {
      const configFunction = new Function(text);
      const config = configFunction();

      if (!config || typeof config !== "object") {
        throw new Error("Function must return an object.");
      }
    } catch (validationError) {
      throw new Error(validationError.message || "Invalid function body syntax");
    }

    // Save the raw text (function body), not the evaluated result
    onSave(text, f.handleSearch());
  } catch (error) {
    console.error("Error validating config:", error);
    // Use alert as fallback if showErrorToast is not available
    if (_.showErrorToast) {
      _.showErrorToast(error.message || "Invalid configuration syntax");
    } else {
      alert(error.message || "Invalid configuration syntax");
    }
  }
};

const toggleExample = () => {
  setIsExampleExpanded(!isExampleExpanded());
};

const getDetailedExample = () => {
  return `return {
  // Table columns: dataType = semantic data (validation/filter/sort); renderer = presentation only
  // renderer "iconAction": column.iconAction: { action: "clipboard"|"openUrl"|"custom", textAccessor(row),
  //   icon, activeIcon (carbon: ids), iconText, activeIconText, title, activeTitle, activeDurationMs, variant, size,
  //   showFeedback, allowEmpty, openUrlTarget, openUrlWindowFeatures, htmlButtonStyle, buttonBg, activeButtonBg, buttonFg, activeButtonFg,
  //   onClick(row, column, rowIndex, helpers) for action "custom" — helpers: getPayloadText, copyToClipboard, setFeedbackActive, clearFeedback }
  columns: [
    {
      key: "name",
      label: "Name",
      dataType: "text",
      renderer: "text",
      sortable: true,
      filterable: true,
      editable: true,
      required: true,
      width: "200px"
    },
    {
      key: "description",
      label: "Description",
      dataType: "text",
      renderer: "text",
      sortable: true,
      filterable: true,
      editable: true,
      width: "300px"
    },
    {
      key: "year",
      label: "Year",
      dataType: "number",
      renderer: "text",
      sortable: true,
      filterable: true,
      editable: true,
      width: "100px"
    },
    {
      key: "language",
      label: "Language",
      dataType: "relation",
      renderer: "text",
      sortable: true,
      filterable: true,
      editable: true,
      options: ["English", "Spanish", "French"],
      width: "150px"
    },
    {
      key: "isActive",
      label: "Active",
      dataType: "boolean",
      renderer: "checkbox",
      sortable: true,
      filterable: true,
      editable: true,
      width: "80px"
    },
    {
      key: "createdAt",
      label: "Created",
      dataType: "date",
      renderer: "isoDateTime",
      sortable: true,
      filterable: true,
      editable: false,
      width: "180px"
    },
    {
      key: "preview",
      label: "Preview",
      dataType: "text",
      renderer: "image",
      sortable: false,
      filterable: false,
      editable: true,
      width: "120px"
    },
    {
      key: "download",
      label: "Download",
      dataType: "text",
      renderer: "downloadLink",
      sortable: false,
      filterable: false,
      editable: false,
      width: "100px"
    },
    {
      key: "__copyLink",
      label: "",
      renderer: "iconAction",
      sortable: false,
      filterable: false,
      editable: false,
      width: "52px",
      iconAction: {
        action: "clipboard",
        icon: "carbon:link",
        activeIcon: "carbon:checkmark",
        title: "Copy link",
        activeTitle: "Copied",
        activeDurationMs: 3000,
        textAccessor: (row) => row.P?.imageUrl || row.P?.originUrl || ""
      }
    }
  ],

  // Form configuration (nested structure)
  formConfig: {
    gridColumns: 1, // Default columns for groups that don't specify
    groups: [
      {
        key: "basic",
        title: "Basic Information",
        gridColumns: 2, // This group uses 2 columns
        fields: [
          {
            key: "name",
            label: "Name",
            dataType: "text",
            renderer: "text",
            required: true,
            colSpan: 2 // Span across 2 columns within the group
          },
          {
            key: "description",
            label: "Description",
            dataType: "text",
            renderer: "textArea",
            required: false,
            colSpan: 2
          },
          {
            key: "year",
            label: "Year",
            dataType: "number",
            renderer: "number",
            required: false,
            colSpan: 1
          },
          {
            key: "language",
            label: "Language",
            dataType: "select",
            renderer: "select",
            required: false,
            options: ["English", "Spanish", "French"],
            colSpan: 1
          }
        ]
      },
      {
        key: "status",
        title: "Status",
        gridColumns: 1, // This group uses 1 column
        fields: [
          {
            key: "isActive",
            label: "Active",
            type: "checkbox",
            required: false,
            colSpan: 1
          }
        ]
      }
    ],
    saveFunction: null // Optional: custom save function
  },

  // Unique keys for validation
  uniqueKeys: ["name", "year"], // Fields that must be unique

  // Table display options
  title: "My Table",
  rowHeight: 50,
  showRowNumber: true,
  showSelection: true,
  resizableColumns: true,
  searchPlaceholder: "Search...",

  // Additional filter fields (displayed above table)
  additionalFilters: [
    {
      key: "status",
      label: "Status",
      type: "select",
      options: ["active", "inactive", "pending"]
    }
  ],

  // Custom actions (displayed in table header)
  customActions: [
    {
      label: "Custom Action",
      onClick: (selectedRows) => {
        console.log("Custom action", selectedRows);
      }
    }
  ],

  // Batch actions (displayed when rows are selected)
  batchActions: [
    {
      label: "Delete Selected",
      onClick: (selectedRows) => {
        console.log("Delete", selectedRows);
      },
      variant: "danger"
    }
  ],

  // Columns to hide conditionally
  hideColumns: ["download"], // Hide these columns

  // Show/hide buttons
  showAddButton: true,
  actions: [
    { key: "edit", type: "edit" },
    { key: "delete", type: "delete", confirm: { title: "Delete?", message: "This cannot be undone." } }
  ],

  // Data and function props (optional when loadFromSetting is true)
  dataFunction: null, // Optional: custom data fetching function
  importFunction: null, // Optional: custom import function
  exportFunction: null // Optional: custom export function
};`;
};

return {
  configText,
  setConfigText,
  initialize,
  handleSave,
  handleLoadDefault,
  isLoadingDefault,
  isExampleExpanded,
  toggleExample,
  getDetailedExample,
  getUsePolarisUI: () => f.getUsePolarisUI?.() === true
};
'''
        componentName: Html
        props:
