const isOpen = c.props?.isOpen || false;
const onClose = c.props?.onClose;

return {
  as: "div",
  hide: !isOpen,
  onClick: (e) => {
    if (e.target === e.currentTarget && onClose) {
      onClose();
    }
  }
};
'''
