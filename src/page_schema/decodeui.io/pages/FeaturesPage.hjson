        },
        {
          icon: "carbon:chart-line",
          title: "Analytics Ready",
          description: "Built-in support for Google Analytics and other tracking tools."
        }
      ]
    },
    {
      title: "Professional Services",
      description: "Let our experts build for you",
      icon: "carbon:user-multiple",
      features: [
