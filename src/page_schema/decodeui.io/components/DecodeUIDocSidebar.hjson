{
  vertexes: [
    {
      id: "1",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "aside"
};
''',
        css: '''
return `._id {
  width: 280px;
  height: calc(100vh - 5rem);
  position: sticky;
  top: 5rem;
  background: ${args.currentMode() === 'dark' ? args.theme.var.color.background_dark_100 : args.theme.var.color.background};
  border-right: 1px solid ${args.theme.var.color.background_dark_200};
  padding: 2rem;
  overflow-y: auto;
  
  @media (max-width: 968px) {
    display: none;
  }
  
  &::-webkit-scrollbar {
    width: 6px;
  }
  
  &::-webkit-scrollbar-track {
    background: ${args.theme.var.color.background_dark_100};
  }
  
  &::-webkit-scrollbar-thumb {
    background: ${args.theme.var.color.background_dark_300};
    border-radius: 3px;
  }
}`;
'''
      }
    },
    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "nav"
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}`;
'''
      }
    },
    {
      id: "3",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Data",
        name: "docSections",
        loop: true,
        props: '''
const currentPath = args.searchParams?.get("page") || "home";
return {
  data: [
    {
      title: "Getting Started",
      items: [
        { label: "Introduction", path: "home", icon: "carbon:home" },
        { label: "Quick Start", path: "quickstart", icon: "carbon:rocket" },
        { label: "Installation", path: "installation", icon: "carbon:download" },
        { label: "First Project", path: "first-project", icon: "carbon:new-tab" }
      ]
    },
    {
      title: "Building Pages",
      items: [
        { label: "Drag & Drop Basics", path: "drag-drop", icon: "carbon:drag-horizontal" },
        { label: "Components", path: "components", icon: "carbon:assembly-cluster" },
        { label: "Layouts", path: "layouts", icon: "carbon:template" },
        { label: "Forms", path: "forms", icon: "carbon:form" }
      ]
    },
    {
      title: "Styling",
      items: [
        { label: "Theme System", path: "themes", icon: "carbon:color-palette" },
        { label: "Custom CSS", path: "custom-css", icon: "carbon:code" },
        { label: "Responsive Design", path: "responsive", icon: "carbon:devices" },
        { label: "Animations", path: "animations", icon: "carbon:flow" }
      ]
    },
    {
      title: "Advanced",
      items: [
        { label: "API Reference", path: "api", icon: "carbon:api-1" },
        { label: "Custom Components", path: "custom-components", icon: "carbon:cube" },
        { label: "SEO Settings", path: "seo", icon: "carbon:search" },
        { label: "Deployment", path: "deployment", icon: "carbon:cloud-upload" }
      ]
    }
  ],
  currentPath
};
'''
      }
    },
