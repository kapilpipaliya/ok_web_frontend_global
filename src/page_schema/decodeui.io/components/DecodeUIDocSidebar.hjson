  flex-direction: column;
  gap: 0.25rem;
}`;
'''
      }
    },
    {
      id: "7",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Data",
        name: "navItems",
        loop: true,
        props: '''
const section = args.contextData.docSections;
const currentPath = args.contextData.docSections.currentPath;
return {
  data: section.items.map(item => ({
    ...item,
    isActive: item.path === currentPath
  }))
};
'''
      }
    },
    {
      id: "8",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
