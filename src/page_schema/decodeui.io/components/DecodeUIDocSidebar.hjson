    },
    {
      id: "9",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.navItems;
return {
  as: "a",
  onClick: (e) => {
    e.preventDefault();
    args.setSearchParams({ page: item.path });
  }
};
''',
        css: '''
const item = args.contextData.navItems;
return `._id {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.625rem 1rem;
  color: ${item.isActive ? args.theme.var.color.primary : args.theme.var.color.text};
  background: ${item.isActive ? (args.currentMode() === 'dark' ? 'rgba(59, 130, 246, 0.1)' : 'rgba(59, 130, 246, 0.1)') : 'transparent'};
  border-radius: 0.5rem;
  text-decoration: none;
  font-size: 0.9375rem;
  transition: all 0.2s ease;
  cursor: pointer;
  position: relative;
  
  &::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 1.5rem;
    background: ${args.theme.var.color.primary};
    border-radius: 0 2px 2px 0;
    opacity: ${item.isActive ? '1' : '0'};
    transition: opacity 0.2s ease;
  }
  
  &:hover {
    background: ${args.currentMode() === 'dark' ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.05)'};
    color: ${args.theme.var.color.primary};
  }
}`;
'''
      }
    },
