return {
  as: "section"
};
''',
        css: '''
return `._id {
  padding: 5rem 2rem;
  background: ${args.currentMode() === 'dark' ? args.theme.var.color.background : args.theme.var.color.background};
  
  @media (max-width: 768px) {
    padding: 3rem 1rem;
  }
}`;
'''
      }
    },
    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1000px;
  margin: 0 auto;
  background: linear-gradient(135deg, ${args.theme.var.color.primary}, ${args.theme.var.color.info});
  border-radius: 1.5rem;
  padding: 4rem;
  text-align: center;
  position: relative;
  overflow: hidden;
  
  @media (max-width: 768px) {
    padding: 3rem 2rem;
  }
  
  &::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1), transparent);
    transform: rotate(45deg);
  }
  
  &::after {
    content: '';
    position: absolute;
    bottom: -50%;
    left: -50%;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1), transparent);
    transform: rotate(-45deg);
  }
}`;
'''
      }
    },
    {
