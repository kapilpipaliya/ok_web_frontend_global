async function processSetting(setting) {
  const { key, tableVertexLabel, icon, name, config } = setting;
  console.log(`Processing ${name} (${icon})...`);

  const checkResult = await args.session.run(`MATCH (s:Setting {key: $key}) RETURN s`, { key });
  const exists = checkResult.records.length > 0;

  if (!dryRun) {
    if (exists) {
      await args.session.run(
        `MATCH (s:Setting {key: $key})
         SET s.config = $config,
             s.type = 'table_config',
             s.tableVertexLabel = $tableVertexLabel,
             s.updatedAt = datetime()
         RETURN s`,
        { key, config, tableVertexLabel }
      );
      console.log(`Updated ${name}`);
      return { created: 0, updated: 1 };
    }

    await args.session.run(
      `CREATE (s:Setting {
        key: $key,
        type: 'table_config',
        tableVertexLabel: $tableVertexLabel,
        config: $config,
        createdAt: datetime(),
        updatedAt: datetime()
      }) RETURN s`,
      { key, config, tableVertexLabel }
    );
    console.log(`Created ${name}`);
    return { created: 1, updated: 0 };
  }

  return exists ? { created: 0, updated: 1 } : { created: 1, updated: 0 };
}

async function processSettingsPageConfig(setting) {
  const { key, settingsPageId, name, config } = setting;
  console.log(`Processing settings page ${name}...`);

  const checkResult = await args.session.run(`MATCH (s:Setting {key: $key}) RETURN s`, { key });
  const exists = checkResult.records.length > 0;

  if (!dryRun) {
    if (exists) {
      await args.session.run(
        `MATCH (s:Setting {key: $key})
         SET s.config = $config,
             s.type = 'settings_page_config',
             s.settingsPageId = $settingsPageId,
             s.updatedAt = datetime()
         RETURN s`,
        { key, config, settingsPageId }
      );
      console.log(`Updated settings page ${name}`);
      return { created: 0, updated: 1 };
    }

    await args.session.run(
      `CREATE (s:Setting {
        key: $key,
        type: 'settings_page_config',
        settingsPageId: $settingsPageId,
        config: $config,
        createdAt: datetime(),
        updatedAt: datetime()
      }) RETURN s`,
      { key, config, settingsPageId }
    );
    console.log(`Created settings page ${name}`);
    return { created: 1, updated: 0 };
  }

  return exists ? { created: 0, updated: 1 } : { created: 1, updated: 0 };
}

const stats = { created: 0, updated: 0, total: settingsConfigs.length + settingsPageConfigs.length, tableConfigs: settingsConfigs.length, settingsPageConfigs: settingsPageConfigs.length };

for (let i = 0; i < settingsConfigs.length; i++) {
  const r = await processSetting(settingsConfigs[i]);
  stats.created += r.created;
  stats.updated += r.updated;
}

for (let j = 0; j < settingsPageConfigs.length; j++) {
  const r = await processSettingsPageConfig(settingsPageConfigs[j]);
  stats.created += r.created;
  stats.updated += r.updated;
}

return {
  success: true,
  message: dryRun ? "CertPulse migration dry run" : "CertPulse settings migration completed",
  data: { ...stats, dryRun }
};
'''
      }
    }
  ]
  edges: []
}

