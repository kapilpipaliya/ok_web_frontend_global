  as: "div"
};
''',
        css: '''
return `._id {
  /* Content styles for documentation */
  
  h2 {
    font-size: 1.875rem;
    font-weight: 600;
    color: ${args.theme.var.color.text};
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }
  
  h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: ${args.theme.var.color.text};
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  
  p {
    color: ${args.theme.var.color.text};
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }
  
  ul, ol {
    color: ${args.theme.var.color.text};
    line-height: 1.8;
    margin-bottom: 1.5rem;
    padding-left: 2rem;
  }
  
  li {
    margin-bottom: 0.5rem;
  }
  
  a {
    color: ${args.theme.var.color.primary};
    text-decoration: none;
    
    &:hover {
      text-decoration: underline;
    }
  }
  
  blockquote {
    border-left: 4px solid ${args.theme.var.color.primary};
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    color: ${args.theme.var.color.text};
    opacity: 0.8;
    font-style: italic;
  }
}`;
'''
