const step = args.contextData.steps;
const index = step.number - 1;
const isEven = index % 2 === 0;
return `._id {
  display: flex;
  align-items: center;
  margin-bottom: 3rem;
  position: relative;
  
  ${isEven ? '' : 'flex-direction: row-reverse;'}
  
  @media (max-width: 768px) {
    flex-direction: row !important;
    margin-bottom: 2rem;
  }
}`;
'''
