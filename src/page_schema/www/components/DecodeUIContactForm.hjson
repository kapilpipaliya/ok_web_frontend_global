        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "form",
  onSubmit: (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData);
    _.showSuccessToast("Thank you! We'll get back to you soon.");
    e.target.reset();
  }
};
''',
        css: '''
return `._id {
  max-width: 600px;
  margin: 0 auto;
}`;
'''
      }
