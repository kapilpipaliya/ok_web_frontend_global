        displayOrder: 1,
        componentName: "Html",
        contextName: "navItems",
        loop: true,
        props: '''
return {
  data: [
    { label: "Features", href: "/features" },
    { label: "Pricing", href: "/pricing" },
    { label: "Documentation", href: "/docs/getting-started" },
    { label: "About", href: "/about" }
  ]
};
'''
      }
    },
    {
      id: "8",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = c.navItems;
const currentPath = _.location.pathname;
const isActive = currentPath === item.href || 
  (item.href === "/docs/getting-started" && currentPath.startsWith("/docs"));
return {
  as: "a",
  text: item.label,
  href: item.href,
  onClick: (e) => {
    e.preventDefault();
    _.navigate(item.href);
  }
};
''',
        css: '''
const item = c.navItems;
const currentPath = _.location.pathname;
const isActive = currentPath === item.href || 
  (item.href === "/docs/getting-started" && currentPath.startsWith("/docs"));
return `._id {
  color: ${isActive ? t.var.color.primary : t.var.color.text};
  text-decoration: none;
  font-weight: ${isActive ? '600' : '500'};
  transition: all 0.2s ease;
  position: relative;
  
  &::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background: ${t.var.color.primary};
    transform: scaleX(${isActive ? '1' : '0'});
    transition: transform 0.2s ease;
  }
  
  &:hover {
    color: ${t.var.color.primary};
    
    &::after {
      transform: scaleX(1);
    }
  }
}`;
'''
      }
    },
    {
      id: "9",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
