  background: ${_.currentMode() === 'dark' ? t.var.color.background_dark_100 : 'rgba(255, 255, 255, 0.95)'};
  backdrop-filter: blur(10px);
  border-bottom: 1px solid ${t.var.color.background_dark_100};
  transition: all 0.3s ease;
  
  @media (max-width: 768px) {
    padding: 0 1rem;
  }
}`;
'''
