        css: '''
return `._id {
  position: relative;
  margin: 1.5rem 0;
  border-radius: 0.75rem;
  overflow: hidden;
  background: ${args.currentMode() === 'dark' ? args.theme.var.color.background_dark_200 : args.theme.var.color.background_dark_100};
  border: 1px solid ${args.theme.var.color.background_dark_300};
}`;
'''
      }
    },
    {
      id: "5",
