''',
        css: '''
return `._id {
  margin: 0;
  padding: 1.5rem;
  overflow-x: auto;
  
  &::-webkit-scrollbar {
    height: 6px;
  }
  
  &::-webkit-scrollbar-track {
    background: ${args.theme.var.color.background_dark_200};
  }
  
  &::-webkit-scrollbar-thumb {
    background: ${args.theme.var.color.background_dark_400};
    border-radius: 3px;
  }
}`;
'''
      }
