return {
  as: "span",
  text: language
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  color: ${args.theme.var.color.text};
  opacity: 0.7;
  text-transform: uppercase;
  font-weight: 500;
}`;
'''
      }
    },
    {
      id: "7",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const code = args.contextData.props?.code || "// Code example";
return {
  as: "button",
  onClick: () => {
    navigator.clipboard.writeText(code);
    args.showSuccessToast("Code copied to clipboard!");
  }
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.375rem 0.75rem;
  background: ${args.theme.var.color.background_dark_100};
  border: 1px solid ${args.theme.var.color.background_dark_300};
  border-radius: 0.375rem;
  color: ${args.theme.var.color.text};
  font-size: 0.875rem;
  cursor: pointer;
  transition: all 0.2s ease;
  
  &:hover {
    background: ${args.theme.var.color.background_dark_200};
    border-color: ${args.theme.var.color.background_dark_400};
  }
}`;
'''
      }
