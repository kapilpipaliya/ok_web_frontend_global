      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const language = args.contextData.props?.language || "javascript";
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1rem;
  background: ${args.currentMode() === 'dark' ? args.theme.var.color.background_dark_300 : args.theme.var.color.background_dark_200};
  border-bottom: 1px solid ${args.theme.var.color.background_dark_300};
}`;
'''
      }
    },
    {
      id: "6",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
