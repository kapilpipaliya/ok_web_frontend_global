return {
  as: "div"
};
''',
        css: '''
return `._id {
  background: ${_.currentMode() === 'dark' ? t.var.color.background_dark_100 : t.var.color.background};
  border: 1px solid ${t.var.color.background_dark_200};
  border-radius: 0.75rem;
  overflow: hidden;
  transition: all 0.3s ease;
  
  &:hover {
    border-color: ${t.var.color.background_dark_300};
  }
}`;
'''
      }
    },
    {
      id: "10",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const faq = c.faqs;
const { openItems, setOpenItems } = c.faqState;
const isOpen = openItems().includes(faq.id);

return {
  as: "button",
  onClick: () => {
    if (isOpen) {
      setOpenItems(openItems().filter(id => id !== faq.id));
    } else {
      setOpenItems([...openItems(), faq.id]);
    }
  }
};
''',
        css: '''
return `._id {
  width: 100%;
  padding: 1.5rem;
  background: none;
  border: none;
  text-align: left;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  transition: all 0.2s ease;
  
  &:hover {
    background: ${_.currentMode() === 'dark' ? 'rgba(255, 255, 255, 0.02)' : 'rgba(0, 0, 0, 0.02)'};
  }
  
  @media (max-width: 768px) {
    padding: 1.25rem;
  }
}`;
'''
      }
    },
