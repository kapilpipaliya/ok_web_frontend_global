        displayOrder: 1,
        componentName: "Html",
        contextName: "faqs",
        loop: true,
        props: '''
return {
  data: [
    {
      id: "1",
      question: "What is DecodeUI?",
      answer: "DecodeUI is a professional drag & drop page builder that allows you to create stunning, SEO-friendly websites without coding. You can build pages yourself using our intuitive interface, or hire our experts to create custom pages for you."
    },
    {
      id: "2",
      question: "How much does it cost to have pages built for me?",
      answer: "Our custom page creation service costs between $50-100 per page, depending on complexity. This includes professional design, responsive layout, SEO optimization, and revisions to ensure you're completely satisfied with the result."
    },
    {
      id: "3",
      question: "Can I switch between building myself and hiring you?",
      answer: "Absolutely! You have complete flexibility. You can start building pages yourself and hire us for specific pages when needed. Many clients build their main pages and hire us for specialized landing pages or complex layouts."
    },
    {
      id: "4",
      question: "Do I need coding knowledge to use DecodeUI?",
      answer: "No coding knowledge is required! Our drag & drop interface is designed for non-technical users. We provide comprehensive documentation and tutorials to help you build professional websites easily."
    },
    {
      id: "5",
      question: "Can I manage multiple websites?",
      answer: "Yes! DecodeUI supports multiple projects with isolated databases. Each project can have its own custom theme, domain, and settings. Perfect for agencies or businesses managing multiple brands."
    },
    {
      id: "6",
      question: "Is DecodeUI SEO friendly?",
      answer: "Yes, all pages built with DecodeUI are SEO-optimized by default. We follow best practices for meta tags, structured data, fast loading times, and mobile responsiveness to help your pages rank well in search engines."
    }
  ]
};
'''
      }
    },
    {
      id: "9",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
