      id: "8",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const isPopular = args.contextData.props?.isPopular || false;
return {
  as: "div"
};
''',
        css: '''
const isPopular = args.contextData.props?.isPopular || false;
return `._id {
  background: ${args.currentMode() === 'dark' ? args.theme.var.color.background_dark_100 : args.theme.var.color.background};
  border: 2px solid ${isPopular ? args.theme.var.color.primary : args.theme.var.color.background_dark_200};
  border-radius: 1rem;
  padding: 2rem;
  position: relative;
  transition: all 0.3s ease;
  height: 100%;
  display: flex;
  flex-direction: column;
  
  ${isPopular ? `
    transform: scale(1.05);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  ` : ''}
  
  &:hover {
    transform: translateY(-4px) ${isPopular ? 'scale(1.05)' : ''};
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
    border-color: ${args.theme.var.color.primary};
  }
  
  @media (max-width: 768px) {
    padding: 1.5rem;
    transform: ${isPopular ? 'scale(1)' : 'scale(1)'};
  }
}`;
'''
      }
    },
    {
      id: "9",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const isPopular = args.contextData.props?.isPopular || false;
return {
  as: isPopular ? "div" : ""
};
''',
        css: '''
const isPopular = args.contextData.props?.isPopular || false;
return isPopular ? `._id {
  position: absolute;
  top: -1rem;
  left: 50%;
  transform: translateX(-50%);
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  padding: 0.25rem 1rem;
  border-radius: 2rem;
  font-size: 0.875rem;
  font-weight: 600;
}` : '';
'''
      }
    },
