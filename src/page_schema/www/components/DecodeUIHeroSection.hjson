return {
  as: "section"
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 6rem 2rem 4rem;
  background: ${args.currentMode() === 'dark' ? args.theme.var.color.background : args.theme.var.color.background};
  position: relative;
  overflow: hidden;
  
  @media (max-width: 768px) {
    padding: 5rem 1rem 3rem;
    min-height: auto;
  }
  
  &::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -30%;
    width: 60%;
    height: 60%;
    background: radial-gradient(circle, ${args.theme.var.color.primary}, transparent);
    opacity: 0.05;
    filter: blur(100px);
  }
  
  &::after {
    content: '';
    position: absolute;
    bottom: -50%;
    left: -30%;
    width: 60%;
    height: 60%;
    background: radial-gradient(circle, ${args.theme.var.color.info}, transparent);
    opacity: 0.05;
    filter: blur(100px);
  }
}`;
'''
      }
    },
    {
      id: "2",
