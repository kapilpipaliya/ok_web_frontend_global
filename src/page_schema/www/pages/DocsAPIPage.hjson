        displayOrder: 9,
        componentName: "Html",
        contextName: "endpoints",
        loop: true,
        props: '''
return {
  data: [
    {
      title: "Projects",
      description: "Manage your website projects",
      endpoints: [
        {
          method: "GET",
          path: "/projects",
          description: "List all projects"
        },
        {
          method: "GET",
          path: "/projects/:id",
          description: "Get project details"
        },
        {
          method: "POST",
          path: "/projects",
          description: "Create a new project"
        },
        {
          method: "PUT",
          path: "/projects/:id",
          description: "Update project settings"
        },
        {
          method: "DELETE",
          path: "/projects/:id",
          description: "Delete a project"
        }
      ]
    },
    {
      title: "Pages",
      description: "Manage pages within projects",
      endpoints: [
        {
          method: "GET",
          path: "/projects/:projectId/pages",
          description: "List all pages in a project"
        },
        {
          method: "GET",
          path: "/pages/:id",
          description: "Get page content"
        },
        {
          method: "POST",
          path: "/projects/:projectId/pages",
          description: "Create a new page"
        },
        {
          method: "PUT",
          path: "/pages/:id",
          description: "Update page content"
        },
        {
          method: "DELETE",
          path: "/pages/:id",
          description: "Delete a page"
        }
      ]
    },
    {
      title: "Components",
      description: "Access component library",
      endpoints: [
        {
          method: "GET",
          path: "/components",
          description: "List available components"
        },
        {
          method: "GET",
          path: "/components/:id",
          description: "Get component details"
        },
        {
          method: "POST",
          path: "/components/custom",
          description: "Create custom component"
        }
      ]
    },
    {
      title: "Media",
      description: "Upload and manage media files",
      endpoints: [
        {
          method: "POST",
          path: "/media/upload",
          description: "Upload media file"
        },
        {
          method: "GET",
          path: "/media",
          description: "List media files"
        },
        {
          method: "DELETE",
          path: "/media/:id",
          description: "Delete media file"
        }
      ]
    }
  ]
};
'''
      }
