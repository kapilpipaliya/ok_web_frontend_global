          icon: "carbon:chevron-right"
        }
      ]
    },
    {
      title: "Content",
      icon: "carbon:document",
      description: "Text, images, and content display",
      components: [
        {
          name: "Heading",
          description: "H1-H6 headings with styling options",
          icon: "carbon:text-long-paragraph"
        },
        {
          name: "Paragraph",
