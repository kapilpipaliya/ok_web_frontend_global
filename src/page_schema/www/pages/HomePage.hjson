{
  vertexes: [
    {
      id: "page",
      L: "Page",
      P: {
        key: "HomePage",
        fns: "return { enabled: () => true }",
        isNoPermissionCheck: true,
        url: "/"
      }
    },
    {
      id: "1",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
