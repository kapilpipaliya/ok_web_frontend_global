  background: ${args.theme.var.color.background};
}`;
'''
      }
    },
    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Data",
        name: "headerState",
        props: '''
const [isScrolled, setIsScrolled] = args.createSignal(false);
const [mobileMenuOpen, setMobileMenuOpen] = args.createSignal(false);

// Add scroll listener
if (args.mounted()) {
  window.addEventListener('scroll', () => {
    setIsScrolled(window.scrollY > 50);
  });
}

return {
  data: { 
    isScrolled, 
    mobileMenu: [mobileMenuOpen, setMobileMenuOpen] 
  }
};
'''
      }
