  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: ${args.theme.var.color.background};
}`;
'''
      }
    },
    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Data",
        name: "pageAnimations",
        props: '''
const [isScrolled, setIsScrolled] = args.createSignal(false);
const [mobileMenuOpen, setMobileMenuOpen] = args.createSignal(false);
const refs = args.createStore({});
const timelines = args.createStore({});

// Initialize GSAP plugins
if (args.mounted()) {
  args.registerGSAPPlugins([args.GSAPPlugins.ScrollTrigger]);
  
  // Add scroll listener
  window.addEventListener('scroll', () => {
    setIsScrolled(window.scrollY > 50);
  });
}

// Helper function to save refs
const saveRef = (name, el) => {
  if (el) {
    args.setGraph('', { refs: { [name]: el } }, { merge: true });
  }
};

// Initialize animations
const initAnimations = () => {
  if (!args.mounted()) return;
  
  // Hero section entrance animation
  if (refs.heroTitle) {
    args.gsap.fromTo(refs.heroTitle, 
      { opacity: 0, y: 50 },
      { 
        opacity: 1, 
        y: 0, 
        duration: 1,
        ease: args.gsapEasings.power3.out,
        delay: 0.2
      }
    );
  }
  
  if (refs.heroSubtitle) {
    args.gsap.fromTo(refs.heroSubtitle,
      { opacity: 0, y: 30 },
      { 
        opacity: 1, 
        y: 0, 
        duration: 1,
        ease: args.gsapEasings.power3.out,
        delay: 0.4
      }
    );
  }
  
  if (refs.heroButtons) {
    args.gsap.fromTo(refs.heroButtons,
      { opacity: 0, y: 20 },
      { 
        opacity: 1, 
        y: 0, 
        duration: 1,
        ease: args.gsapEasings.power3.out,
        delay: 0.6
      }
    );
  }
  
  // Feature cards scroll animation
  const featureCards = document.querySelectorAll('.feature-card');
  featureCards.forEach((card, index) => {
    args.gsap.fromTo(card,
      { opacity: 0, y: 40, scale: 0.95 },
      {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.8,
        ease: args.gsapEasings.power2.out,
        scrollTrigger: {
          trigger: card,
          start: 'top bottom-=100',
          toggleActions: 'play none none reverse'
        },
        delay: index * 0.1
      }
    );
  });
  
  // Testimonial cards animation
  const testimonialCards = document.querySelectorAll('.testimonial-card');
  testimonialCards.forEach((card, index) => {
    args.gsap.fromTo(card,
      { opacity: 0, x: index % 2 === 0 ? -30 : 30 },
      {
        opacity: 1,
        x: 0,
        duration: 0.8,
        ease: args.gsapEasings.power2.out,
        scrollTrigger: {
          trigger: card,
          start: 'top bottom-=50',
          toggleActions: 'play none none reverse'
        }
      }
    );
  });
  
  // Timeline animation
  const timelineItems = document.querySelectorAll('.timeline-item');
  const timelineLine = document.querySelector('.timeline-line');
  
  if (timelineLine) {
    args.gsap.fromTo(timelineLine,
      { scaleY: 0, transformOrigin: 'top' },
      {
        scaleY: 1,
        duration: 1.5,
        ease: args.gsapEasings.power2.inOut,
        scrollTrigger: {
          trigger: timelineLine,
          start: 'top center',
          end: 'bottom center',
          scrub: 1
        }
      }
    );
  }
  
  timelineItems.forEach((item, index) => {
    args.gsap.fromTo(item,
      { opacity: 0, x: index % 2 === 0 ? -50 : 50 },
      {
        opacity: 1,
        x: 0,
        duration: 0.8,
        ease: args.gsapEasings.power2.out,
        scrollTrigger: {
          trigger: item,
          start: 'top center+=100',
          toggleActions: 'play none none reverse'
        }
      }
    );
  });
  
  // Section headers animation
  const sectionHeaders = document.querySelectorAll('.section-header');
  sectionHeaders.forEach(header => {
    const tl = args.createTimeline({
      scrollTrigger: {
        trigger: header,
        start: 'top bottom-=100',
        toggleActions: 'play none none reverse'
      }
    });
    
    tl.fromTo(header.querySelector('h2'),
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.8, ease: args.gsapEasings.power2.out }
    )
    .fromTo(header.querySelector('p'),
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.6, ease: args.gsapEasings.power2.out },
      '-=0.4'
    );
  });
  
  // Pricing cards hover animation
  const pricingCards = document.querySelectorAll('.pricing-card');
  pricingCards.forEach(card => {
    card.addEventListener('mouseenter', () => {
      args.gsap.to(card, {
        scale: 1.05,
        boxShadow: '0 20px 40px rgba(0,0,0,0.1)',
        duration: 0.3,
        ease: args.gsapEasings.power2.out
      });
    });
    
    card.addEventListener('mouseleave', () => {
      args.gsap.to(card, {
        scale: 1,
        boxShadow: '0 4px 6px rgba(0,0,0,0.05)',
        duration: 0.3,
        ease: args.gsapEasings.power2.out
      });
    });
  });
  
  // FAQ accordion animation
  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach((item, index) => {
    args.gsap.fromTo(item,
      { opacity: 0, y: 20 },
      {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: args.gsapEasings.power2.out,
        scrollTrigger: {
          trigger: item,
          start: 'top bottom-=50',
          toggleActions: 'play none none reverse'
        },
        delay: index * 0.05
      }
    );
  });
  
  // CTA section animation
  const ctaSection = document.querySelector('.cta-section');
  if (ctaSection) {
    const tl = args.createTimeline({
      scrollTrigger: {
        trigger: ctaSection,
        start: 'top bottom-=100',
        toggleActions: 'play none none reverse'
      }
    });
    
    tl.fromTo(ctaSection,
      { opacity: 0, scale: 0.95 },
      { opacity: 1, scale: 1, duration: 0.8, ease: args.gsapEasings.power2.out }
    );
  }
};

// Run animations after mount
if (args.mounted()) {
  setTimeout(initAnimations, 100);
}

return {
  data: { 
    isScrolled, 
    mobileMenu: [mobileMenuOpen, setMobileMenuOpen],
    refs,
    saveRef,
    initAnimations
  }
};
'''
      }
    },
