    },
    {
      id: "1",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: ${args.theme.var.color.background};
}`;
'''
      }
    },
    {
      id: "1a",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Data",
        name: "pageAnimations",
        props: '''
const refs = args.createStore({});

// Initialize GSAP plugins
if (args.mounted()) {
  args.registerGSAPPlugins([args.GSAPPlugins.ScrollTrigger]);
}

// Helper function to save refs
const saveRef = (name) => (el) => {
  if (el) {
    refs[name] = el;
  }
};

// Initialize animations
const initAnimations = () => {
  if (!args.mounted()) return;
  
  // Hero section fade in
  if (refs.heroTitle) {
    args.gsap.fromTo(refs.heroTitle,
      { opacity: 0, y: 40 },
      { 
        opacity: 1, 
        y: 0, 
        duration: 1,
        ease: args.gsapEasings.power3.out,
        delay: 0.2
      }
    );
  }
  
  if (refs.heroSubtitle) {
    args.gsap.fromTo(refs.heroSubtitle,
      { opacity: 0, y: 30 },
      { 
        opacity: 1, 
        y: 0, 
        duration: 1,
        ease: args.gsapEasings.power3.out,
        delay: 0.4
      }
    );
  }
  
  // Story section animation
  if (refs.storySection) {
    args.gsap.fromTo(refs.storySection,
      { opacity: 0, x: -50 },
      {
        opacity: 1,
        x: 0,
        duration: 1,
        ease: args.gsapEasings.power2.out,
        scrollTrigger: {
          trigger: refs.storySection,
          start: 'top center+=100',
          toggleActions: 'play none none reverse'
        }
      }
    );
  }
  
  // Stats animation with counter effect
  const statValues = document.querySelectorAll('.stat-value');
  statValues.forEach(stat => {
    const endValue = stat.textContent;
    const isPercentage = endValue.includes('%');
    const numericValue = parseInt(endValue.replace(/[^0-9]/g, ''));
    
    args.gsap.fromTo(stat,
      { 
        textContent: '0' + (isPercentage ? '%' : endValue.replace(/[0-9]/g, '')),
        opacity: 0,
        scale: 0.8
      },
      {
        textContent: endValue,
        opacity: 1,
        scale: 1,
        duration: 2,
        ease: args.gsapEasings.power2.out,
        snap: { textContent: 1 },
        scrollTrigger: {
          trigger: stat,
          start: 'top bottom-=100',
          toggleActions: 'play none none reverse'
        }
      }
    );
  });
  
  // Stats card animation
  if (refs.statsCard) {
    args.gsap.fromTo(refs.statsCard,
      { opacity: 0, y: 40, scale: 0.95 },
      {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.8,
        ease: args.gsapEasings.power2.out,
        scrollTrigger: {
          trigger: refs.statsCard,
          start: 'top center+=100',
          toggleActions: 'play none none reverse'
        }
      }
    );
  }
  
  // Values section title animation
  if (refs.valuesTitle) {
    args.gsap.fromTo(refs.valuesTitle,
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: args.gsapEasings.power2.out,
        scrollTrigger: {
          trigger: refs.valuesTitle,
          start: 'top bottom-=100',
          toggleActions: 'play none none reverse'
        }
      }
    );
  }
  
  // Values cards stagger animation
  const valueCards = document.querySelectorAll('.value-card');
  args.gsap.fromTo(valueCards,
    { opacity: 0, y: 50, rotateY: -10 },
    {
      opacity: 1,
      y: 0,
      rotateY: 0,
      duration: 0.8,
      stagger: 0.1,
      ease: args.gsapEasings.power2.out,
      scrollTrigger: {
        trigger: valueCards[0],
        start: 'top bottom-=100',
        toggleActions: 'play none none reverse'
      }
    }
  );
  
  // Hover animations for value cards
  valueCards.forEach(card => {
    card.addEventListener('mouseenter', () => {
      args.gsap.to(card, {
        scale: 1.05,
        boxShadow: '0 15px 30px rgba(0,0,0,0.15)',
        duration: 0.3,
        ease: args.gsapEasings.power2.out
      });
    });
    
    card.addEventListener('mouseleave', () => {
      args.gsap.to(card, {
        scale: 1,
        boxShadow: '0 4px 6px rgba(0,0,0,0.05)',
        duration: 0.3,
        ease: args.gsapEasings.power2.out
      });
    });
  });
  
  // CTA section animation
  const ctaSection = document.querySelector('.cta-section');
  if (ctaSection) {
    args.gsap.fromTo(ctaSection,
      { opacity: 0, scale: 0.9 },
      {
        opacity: 1,
        scale: 1,
        duration: 1,
        ease: args.gsapEasings.elastic.out(1, 0.5),
        scrollTrigger: {
          trigger: ctaSection,
          start: 'top bottom-=100',
          toggleActions: 'play none none reverse'
        }
      }
    );
  }
};

// Run animations after mount
if (args.mounted()) {
  setTimeout(initAnimations, 100);
}

return {
  data: { 
    refs,
    saveRef,
    initAnimations
  }
};
'''
      }
    },
