{
  vertexes: [
    {
      id: "page",
      L: "Page",
      P: {
        key: "PricingPage",
        fns: "return { enabled: () => true }",
        isNoPermissionCheck: true,
        url: "/pricing"
      }
    },
    {
      id: "1",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: ${args.theme.var.color.background};
}`;
'''
      }
    },
    {
      id: "1a",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Data",
        name: "pageAnimations",
        props: '''
const refs = args.createStore({});
const [selectedPlan, setSelectedPlan] = args.createSignal('pro');

// Initialize GSAP plugins
if (args.mounted()) {
  args.registerGSAPPlugins([args.GSAPPlugins.ScrollTrigger]);
}

// Helper function to save refs
const saveRef = (name) => (el) => {
  if (el) {
    refs[name] = el;
  }
};

// Initialize animations
const initAnimations = () => {
  if (!args.mounted()) return;
  
  // Hero title animation
  if (refs.heroTitle) {
    args.gsap.fromTo(refs.heroTitle,
      { opacity: 0, y: 50, scale: 0.9 },
      { 
        opacity: 1, 
        y: 0, 
        scale: 1,
        duration: 1,
        ease: args.gsapEasings.power3.out,
        delay: 0.2
      }
    );
  }
  
  // Hero subtitle animation
  if (refs.heroSubtitle) {
    args.gsap.fromTo(refs.heroSubtitle,
      { opacity: 0, y: 30 },
      { 
        opacity: 1, 
        y: 0, 
        duration: 1,
        ease: args.gsapEasings.power3.out,
        delay: 0.4
      }
    );
  }
  
  // Pricing cards entrance animation
  const pricingCards = document.querySelectorAll('.pricing-card');
  args.gsap.fromTo(pricingCards,
    { 
      opacity: 0, 
      y: 60,
      scale: 0.9,
      rotateY: -10
    },
    {
      opacity: 1,
      y: 0,
      scale: 1,
      rotateY: 0,
      duration: 0.8,
      stagger: 0.2,
      ease: args.gsapEasings.power2.out,
      delay: 0.6
    }
  );
  
  // Pricing cards hover and selection animation
  pricingCards.forEach((card, index) => {
    const isSelected = index === 1; // Pro plan is selected by default
    
    if (isSelected) {
      args.gsap.set(card, {
        scale: 1.05,
        boxShadow: '0 20px 40px rgba(59, 130, 246, 0.2)'
      });
    }
    
    card.addEventListener('mouseenter', () => {
      if (!card.classList.contains('selected')) {
        args.gsap.to(card, {
          scale: 1.02,
          y: -5,
          boxShadow: '0 15px 30px rgba(0,0,0,0.1)',
          duration: 0.3,
          ease: args.gsapEasings.power2.out
        });
      }
    });
    
    card.addEventListener('mouseleave', () => {
      if (!card.classList.contains('selected')) {
        args.gsap.to(card, {
          scale: 1,
          y: 0,
          boxShadow: '0 4px 6px rgba(0,0,0,0.05)',
          duration: 0.3,
          ease: args.gsapEasings.power2.out
        });
      }
    });
    
    card.addEventListener('click', () => {
      // Remove selected state from all cards
      pricingCards.forEach(c => {
        c.classList.remove('selected');
        args.gsap.to(c, {
          scale: 1,
          boxShadow: '0 4px 6px rgba(0,0,0,0.05)',
          duration: 0.3,
          ease: args.gsapEasings.power2.out
        });
      });
      
      // Add selected state to clicked card
      card.classList.add('selected');
      args.gsap.to(card, {
        scale: 1.05,
        boxShadow: '0 20px 40px rgba(59, 130, 246, 0.2)',
        duration: 0.3,
        ease: args.gsapEasings.power2.out
      });
    });
  });
  
  // Comparison table animation
  if (refs.comparisonTable) {
    const tl = args.createTimeline({
      scrollTrigger: {
        trigger: refs.comparisonTable,
        start: 'top bottom-=100',
        toggleActions: 'play none none reverse'
      }
    });
    
    tl.fromTo(refs.comparisonTitle,
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.6, ease: args.gsapEasings.power2.out }
    )
    .fromTo(refs.comparisonTable,
      { opacity: 0, y: 40, scale: 0.95 },
      { opacity: 1, y: 0, scale: 1, duration: 0.8, ease: args.gsapEasings.power2.out },
      '-=0.3'
    );
    
    // Animate table rows
    const tableRows = refs.comparisonTable.querySelectorAll('tbody tr');
    tl.fromTo(tableRows,
      { opacity: 0, x: -20 },
      { 
        opacity: 1, 
        x: 0, 
        duration: 0.4,
        stagger: 0.05,
        ease: args.gsapEasings.power2.out
      },
      '-=0.5'
    );
  }
  
  // FAQ section animation
  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach((item, index) => {
    args.gsap.fromTo(item,
      { opacity: 0, y: 30, x: index % 2 === 0 ? -20 : 20 },
      {
        opacity: 1,
        y: 0,
        x: 0,
        duration: 0.6,
        ease: args.gsapEasings.power2.out,
        scrollTrigger: {
          trigger: item,
          start: 'top bottom-=50',
          toggleActions: 'play none none reverse'
        },
        delay: index * 0.05
      }
    );
  });
  
  // CTA section animation
  const ctaSection = document.querySelector('.cta-section');
  if (ctaSection) {
    args.gsap.fromTo(ctaSection,
      { 
        opacity: 0, 
        scale: 0.9,
        y: 50
      },
      {
        opacity: 1,
        scale: 1,
        y: 0,
        duration: 1,
        ease: args.gsapEasings.elastic.out(1, 0.5),
        scrollTrigger: {
          trigger: ctaSection,
          start: 'top bottom-=100',
          toggleActions: 'play none none reverse'
        }
      }
    );
  }
  
  // Pricing toggle animation
  const pricingToggle = document.querySelector('.pricing-toggle');
  if (pricingToggle) {
    args.gsap.fromTo(pricingToggle,
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.6, ease: args.gsapEasings.power2.out, delay: 0.8 }
    );
  }
};

// Run animations after mount
if (args.mounted()) {
  setTimeout(initAnimations, 100);
}

return {
  data: { 
    refs,
    saveRef,
    selectedPlan,
    setSelectedPlan,
    initAnimations
  }
};
'''
      }
    },
