            { key: "key", label: "Key", dataType: "text", renderer: "text", colSpan: 2, tooltip: "Optional stable key (lowercase, hyphens)." },
            { key: "displayOrder", label: "Sort order", dataType: "number", renderer: "number", colSpan: 2, tooltip: "Lower numbers sort first among siblings." }
          ]
        }
      ]
    }
  },
  columns: [
    { key: "email", label: "Email", dataType: "text", renderer: "text", width: "260px", required: true, overflowEllipsis: true },
    { key: "name", label: "Name", dataType: "text", renderer: "text", width: "200px", overflowEllipsis: true },
    { key: "notes", label: "Notes", dataType: "text", renderer: "text", width: "280px", overflowEllipsis: true }
  ],
  rowHeight: 48,
  uniqueKeys: ["email"],
  formConfig: {
    gridColumns: 2,
    groups: [
      {
        key: "staff",
        title: "Staff member",
        gridColumns: 2,
        fields: [
          { key: "email", label: "Email", dataType: "text", renderer: "text", required: true, colSpan: 2, tooltip: "Email for this teammate (use the same email as their Shopify staff login when possible)." },
          { key: "name", label: "Display name", dataType: "text", renderer: "text", colSpan: 2, tooltip: "Optional display name." },
          { key: "notes", label: "Notes", dataType: "text", renderer: "textArea", colSpan: 2, tooltip: "Optional: role, department, or other context." }
        ]
      }
    ]
  }
};`
  }
];

async function processSetting(setting) {
  const { key, tableVertexLabel, icon, name, config } = setting;
  console.log(`Processing ${name} (${icon})...`);

  const checkResult = await args.session.run(`MATCH (s:Setting {key: $key}) RETURN s`, { key });
  const exists = checkResult.records.length > 0;

  if (!dryRun) {
    if (exists) {
      await args.session.run(
        `MATCH (s:Setting {key: $key})
         SET s.config = $config,
             s.type = 'table_config',
             s.tableVertexLabel = $tableVertexLabel,
             s.updatedAt = datetime()
         RETURN s`,
        { key, config, tableVertexLabel }
      );
      return { created: 0, updated: 1 };
    }

    await args.session.run(
      `CREATE (s:Setting {
        key: $key,
        type: 'table_config',
        tableVertexLabel: $tableVertexLabel,
        config: $config,
        createdAt: datetime(),
        updatedAt: datetime()
      }) RETURN s`,
      { key, config, tableVertexLabel }
    );
    return { created: 1, updated: 0 };
  }

  return exists ? { created: 0, updated: 1 } : { created: 1, updated: 0 };
}

const stats = { created: 0, updated: 0, total: settingsConfigs.length };

for (let i = 0; i < settingsConfigs.length; i++) {
  const r = await processSetting(settingsConfigs[i]);
  stats.created += r.created;
  stats.updated += r.updated;
}

return {
  success: true,
  message: dryRun ? "StoreTasks migration dry run" : "StoreTasks settings migration completed",
  data: { ...stats, dryRun }
};
'''
      }
    }
  ]
  edges: []
}

