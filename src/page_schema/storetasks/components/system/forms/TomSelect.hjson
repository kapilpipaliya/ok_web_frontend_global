          '''
const selectRef = args.fns.selectRef();

// Get props (options may be a Solid accessor — do not use .length on a function)
const rawOptions = args.contextData.props?.options;
const initialOptions =
  typeof rawOptions === "function"
    ? (() => {
        try {
          const v = rawOptions();
          return Array.isArray(v) ? v : [];
        } catch {
          return [];
        }
      })()
    : Array.isArray(rawOptions)
      ? rawOptions
      : [];
const optionType = args.contextData.props?.optionType || "";
const subType = args.contextData.props?.subType || "";
const functionName = args.contextData.props?.functionName || "";
const singularName = args.contextData.props?.singularName || "";
const pluralName = args.contextData.props?.pluralName || "";
const valueKey = args.contextData.props?.valueKey || "id";
const labelKey = args.contextData.props?.labelKey || "title";
const dataKey = args.contextData.props?.dataKey || "";
const functionContext = args.contextData.props?.functionContext || null;
const value = args.contextData.props?.value || "";
const placeholder = args.contextData.props?.placeholder || "Select an option...";
const disabled = args.contextData.props?.disabled || false;
const required = args.contextData.props?.required || false;
const search = args.contextData.props?.search !== false;
const multiple = args.contextData.props?.multiple || false;
const className = args.contextData.props?.class;
const titleAttr = args.contextData.props?.title || undefined;
const ariaDescribedBy = args.contextData.props?.["aria-describedby"] || undefined;

// Return element props with onMount and onCleanup
return {
  as: "select",
  ref: args.fns.setSelectRef,
  placeholder: placeholder,
  disabled: disabled,
  required: required,
  multiple: multiple,
  class: className,
  title: titleAttr,
  "aria-describedby": ariaDescribedBy,
  onMount: () => {

    // Check if TomSelect is already loaded
    if (window.TomSelect) {
      args.fns.initializeTomSelect();
    } else {
      args.fns.loadTomSelectLibrary();
    }

    // Initialize options based on available properties (priority order)
    if (functionName) {
      // Load options from custom function (highest priority)
      args.fns.loadOptionsFromCustomFunction(functionName, singularName, pluralName, valueKey, labelKey, dataKey, functionContext);
    } else if (optionType) {
      // Load options from getSelectOptions function
      args.fns.loadOptionsFromFunction(optionType, subType);
    } else if (initialOptions.length === 0) {
      // No function name, optionType and no initial options - keep empty
      args.fns.setOptions([]);
    } else {
      // Use provided options
      args.fns.setOptions(initialOptions);
    }
  },
  onCleanup: args.fns.cleanupTomSelect
};
