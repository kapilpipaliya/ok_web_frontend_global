        key: unique_4
        props:
          '''return {
  as: "section"
}'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        as: div
        css:
          '''return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin: 0;
}`;'''
        displayOrder: 1
        componentName: Html
        key: unique_3
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css: ""
        displayOrder: 1
        textType: markdown
        componentName: Html
        text:
          '''Planned and under consideration (not committed to a release date):

- **Templates**: Quick-add task templates per list (e.g. standard fulfillment checklist).
- **Notifications**: Optional email or admin notifications in addition to in-app reminders.
- **Recurring tasks**: Repeat on a schedule (daily / weekly).
- **Filters & saved views**: Save common filter combinations for the table.
- **Dark mode polish**: Tighter Polaris alignment for theme contrast in admin.
'''
        key: unique_5
        props:
          '''return {
  as: "div",
}'''
      }
    }
    {
