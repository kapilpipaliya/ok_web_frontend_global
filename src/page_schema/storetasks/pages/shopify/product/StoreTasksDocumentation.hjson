  margin: 0;
}`;'''
        displayOrder: 3
        textType: markdown
        componentName: Html
        text:
          '''The **[Tasks](/tasks)** page is the spreadsheet-style view: search, filters, sorting, columns, opening rows to edit tasks, sidebar lists, and modal settings when enabled.
'''
        props:
          '''return {
  as: "p",
}'''
      }
    }
