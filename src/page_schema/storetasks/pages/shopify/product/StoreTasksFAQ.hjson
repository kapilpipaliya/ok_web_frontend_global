{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        fns: return { enabled: () => true }
        title: FAQ - Store Tasks
        key: StoreTasksFAQ
        url: /faq
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  max-width: 800px;
  margin: 0 auto;
  padding: ${args.theme.var.spacing?.lg || "2rem"};
  color: ${args.theme.var.color.text};
}

@media (max-width: 768px) {
  ._id {
    padding: ${args.theme.var.spacing?.md || "1rem"};
  }
}`;'''
        displayOrder: 1
        fns:
          '''
const [expandedIndex, setExpandedIndex] = args.createSignal(null);
const toggleExpanded = (index) => {
  setExpandedIndex((prev) => (prev === index ? null : index));
};
return {
  expandedIndex,
  setExpandedIndex,
  toggleExpanded
};
'''
        componentName: Html
        key: faq_root
        props:
          '''return {
  as: "div"
}'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 2rem;
  font-weight: 700;
  color: ${args.theme.var.color.text};
  margin: 0 0 1rem 0;
}

@media (max-width: 768px) {
  ._id {
    font-size: 1.75rem;
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "h1",
  text: "Frequently asked questions"
}'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 1rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin-bottom: 1.5rem;
}`;'''
        displayOrder: 2
        textType: markdown
        componentName: Html
        text:
          '''Common questions about the **Store Tasks** app.
'''
        props:
          '''return {
  as: "div",
}'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}`;'''
        displayOrder: 3
        componentName: Html
        props:
          '''return {
  as: "div"
}'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        contextName: faqItem
        css:
          '''return `._id {
  border-radius: 0.75rem;
  border: 1px solid ${args.theme.var.color.border};
  background: ${args.theme.var.color.background_light_100};
  overflow: hidden;
}`;'''
        loop: true
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  data: [
    { index: 0, q: "Where do I manage tasks?", a: "Open Store Tasks from your Shopify admin. The main Tasks page uses a table; use the sidebar to pick a task list or see all tasks." },
    { index: 1, q: "How do I assign someone to a task?", a: "Open a task row to edit it. Choose an assignee in the form—the app links staff users with a relationship. You need staff accounts available in your store." },
    { index: 2, q: "Can I link a task to an order?", a: "Yes. Edit the task and use the order link field to associate a Shopify order for context." },
    { index: 3, q: "How do reminders work?", a: "Set due dates or reminder fields on tasks. Scheduled reminders depend on server jobs configured for your installation; ensure your hosting runs the reminder queue worker if reminders are enabled." },
    { index: 4, q: "The app only shows a message about opening inside Shopify.", a: "Store Tasks is built for embedded admin. Install and open it from Shopify admin while logged in as staff. Outside the iframe, marketing pages stay available (home, docs, FAQ)." },
    { index: 5, q: "Who do I contact for help?", a: "Use the Support page in the app or the link in the footer to reach the team." }
  ]
}'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''
return `._id {
  width: 100%;
  text-align: left;
  font-size: 1rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
  margin: 0;
  padding: 1rem 2.5rem 1rem 1rem;
  border: none;
  background: transparent;
  cursor: pointer;
  position: relative;
}

._id::after {
  content: "";
  position: absolute;
  right: 1rem;
  top: 50%;
  transform: translateY(-50%) rotate(45deg);
  width: 0.5rem;
  height: 0.5rem;
  border-right: 2px solid ${args.theme.var.color.text};
  border-bottom: 2px solid ${args.theme.var.color.text};
  transition: transform 0.2s ease;
}

._id[data-expanded="true"]::after {
  transform: translateY(-50%) rotate(225deg);
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const item = args.contextData.faqItem;
const index = item?.index ?? -1;
const isExpanded = args.fns.expandedIndex?.() === index;
return {
  as: "button",
  type: "button",
  text: item?.q || "",
  "data-expanded": isExpanded ? "true" : "false",
  onClick: () => args.fns.toggleExpanded?.(index)
};
'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        css:
          '''
return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin: 0;
  padding: 0 1rem 1rem 1rem;
  border-top: 1px solid ${args.theme.var.color.border};
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''
const item = args.contextData.faqItem;
const index = item?.index ?? -1;
return {
  as: "p",
  text: item?.a || "",
  show: () => args.fns.expandedIndex?.() === index
};
'''
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin-top: 1.5rem;
}`;'''
        displayOrder: 4
        textType: markdown
        componentName: Html
        text:
          '''Need more help? Visit the [Support](/support) page to create a request and talk to our team.
'''
        props:
          '''return {
  as: "div",
}'''
      }
    }
    {
      id: "10"
      L: PageLayout
      P: {
        componentName: ShopifyLayout
      }
    }
  ]
  edges: [
    { id: "e1", T: "Attr", S: "1", E: "2" }
    { id: "e2", T: "PageLayout", S: "1", E: "10" }
    { id: "e3", T: "Attr", S: "2", E: "3" }
    { id: "e4", T: "Attr", S: "2", E: "4" }
    { id: "e5", T: "Attr", S: "2", E: "5" }
    { id: "e6", T: "Attr", S: "2", E: "9" }
    { id: "e7", T: "Attr", S: "5", E: "6" }
    { id: "e8", T: "Attr", S: "6", E: "7" }
    { id: "e9", T: "Attr", S: "6", E: "8" }
  ]
}
