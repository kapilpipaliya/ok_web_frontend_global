    {
      id: "6"
      L: Attr
      P: {
        css:
          '''
return `._id {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 ${args.theme.var.spacing.md};
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
  border: none;
  border-radius: 0 ${args.theme.var.borderRadius.md} ${args.theme.var.borderRadius.md} 0;
  cursor: pointer;
  transition: all ${args.theme.var.animation.fast} ease;

  &:hover:not(:disabled) {
    background: ${args.theme.var.color.background_dark_200};
  }

  &:active:not(:disabled) {
    background: ${args.theme.var.color.background_dark_300};
  }

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
}`;
'''
        displayOrder: 3
        componentName: Html
        props:
          '''
const direction = args.contextData.props?.direction || "asc";
const onDirectionToggle = args.contextData.props?.onDirectionToggle || (() => {});
const disabled = args.contextData.props?.disabled || false;

// Determine icon based on direction
const icon = direction === "asc" ? "arrow-up" : "arrow-down";
const ariaLabel = direction === "asc" ? "Sort ascending" : "Sort descending";

return {
  as: "button",
  type: "button",
  onClick: () => {
    onDirectionToggle();
  },
  disabled: disabled,
  "aria-label": ariaLabel,
  title: ariaLabel
};
'''
      }
    }
