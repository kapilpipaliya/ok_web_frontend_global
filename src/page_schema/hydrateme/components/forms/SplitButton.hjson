        displayOrder: 1
        componentName: TomSelect
        props:
          '''
const field = args.contextData.props?.field || "";
const options = args.contextData.props?.options || [];
const onFieldChange = args.contextData.props?.onFieldChange || (() => {});
const disabled = args.contextData.props?.disabled || false;

return {
  value: field,
  options: options,
  onChange: (value) => {
    onFieldChange(value);
  },
  disabled: disabled,
  search: false,
  placeholder: "Sort by..."
};
'''
      }
    }
