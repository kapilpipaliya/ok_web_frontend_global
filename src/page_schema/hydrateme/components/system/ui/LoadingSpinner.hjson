        displayOrder: 1
        componentName: Html
        props:
          '''
// Get variant props with defaults
const size = args.contextData.props?.size || "medium";
const color = args.contextData.props?.color || "primary";
const text = args.contextData.props?.text || "";

return {
  as: "div",
  "aria-label": text || "Loading...",
  role: "status"
};
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''
// Get variant props with defaults
const size = args.contextData.props?.size || "medium";
const color = args.contextData.props?.color || "primary";

// Size configurations
const sizeConfig = {
  small: { diameter: 24, borderWidth: 2 },
  medium: { diameter: 48, borderWidth: 4 },
  large: { diameter: 64, borderWidth: 6 }
};

const config = sizeConfig[size] || sizeConfig.medium;

// Color configurations
const colorConfig = {
  primary: {
    border: args.theme.var.color.background_light_300,
    accent: args.theme.var.color.primary
  },
  text: {
    border: args.theme.var.color.background_light_200,
    accent: args.theme.var.color.text_light_500
  },
  white: {
    border: "rgba(255, 255, 255, 0.3)",
    accent: "rgba(255, 255, 255, 0.9)"
  }
};

const colors = colorConfig[color] || colorConfig.primary;

return `._id {
  /* Spinner styling */
  width: ${config.diameter}px;
  height: ${config.diameter}px;
  border: ${config.borderWidth}px solid ${colors.border};
  border-top: ${config.borderWidth}px solid ${colors.accent};
  border-radius: 50%;

  /* Animation */
  animation: ytoSpinnerRotate 1s linear infinite;

  /* Accessibility */
  display: inline-block;
}

/* Keyframe animation for spinner rotation */
@keyframes ytoSpinnerRotate {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

/* Reduce motion for accessibility */
@media (prefers-reduced-motion: reduce) {
  ._id {
    animation-duration: 2s;
  }
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
// Get variant props with defaults
const size = args.contextData.props?.size || "medium";
const color = args.contextData.props?.color || "primary";

return {
  as: "div"
};
'''
      }
    }
