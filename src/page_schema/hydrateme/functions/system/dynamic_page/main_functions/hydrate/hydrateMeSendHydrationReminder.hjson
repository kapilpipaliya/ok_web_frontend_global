{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: hydrateMeSendHydrationReminder
        description: Records a gentle Hydrate Circle reminder (Phase 2) — updates member lastRemindedAt and stores a ping row.
        body:
          '''
const actualUser = await _.getUserFromSession();
if (!actualUser) {
  return { success: false, message: "Sign in to send a reminder." };
}

const user = await _.getEffectiveUser(_.session, actualUser, c);
const uuid = user?.P?.uuid;
if (!uuid) {
  return { success: false, message: "User uuid missing." };
}

const memberElementId = c?.circleMemberElementId;
if (!memberElementId || String(memberElementId).trim() === "") {
  return { success: false, message: "circleMemberElementId is required." };
}

const check = await _.session.run(
  `MATCH (u:User {uuid: $uuid})-[:UserHydrateMeCircleMember]->(m:HydrateMeCircleMember)
   WHERE elementId(m) = $memberElementId
   RETURN m, coalesce(m.displayName, m.friendEmail, "friend") AS label
   LIMIT 1`,
  { uuid, memberElementId: String(memberElementId) },
);

if (!check.records[0]) {
  return { success: false, message: "Circle member not found for this user." };
}

const label = check.records[0].get("label");
const message =
  c?.message != null && String(c.message).trim() !== ""
    ? String(c.message).trim()
    : "Time to hydrate";

await _.session.run(
  `MATCH (u:User {uuid: $uuid})-[:UserHydrateMeCircleMember]->(m:HydrateMeCircleMember)
   WHERE elementId(m) = $memberElementId
   SET m.lastRemindedAt = datetime(),
       m.updatedAt = datetime()
   WITH u, m
   CREATE (p:HydrateMeHydrationPing {
     message: $message,
     targetLabel: $targetLabel,
     createdAt: datetime()
   }),
   (u)-[:UserHydrateMeHydrationPing]->(p),
   (p)-[:PingCircleMember]->(m)`,
  {
    uuid,
    memberElementId: String(memberElementId),
    message,
    targetLabel: String(label ?? "friend"),
  },
);

return {
  success: true,
  message: `Reminder recorded for ${label}. Push delivery can be wired to your notification provider later.`,
  data: { targetLabel: String(label ?? "friend") },
};
'''
      }
    }
  ]
  edges: []
}
