          { key: "note", label: "Note", dataType: "text", renderer: "textArea", colSpan: 2, tooltip: "Optional context (e.g. after workout)." }
        ]
      }
    ]
  },
  hooks: {
    afterCreate: ["hydrateMeWaterLogNormalize"],
    afterUpdate: ["hydrateMeWaterLogNormalize"]
  }
};`
  },
