    {
      id: "9"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: hm_home_prog_label
        props:
          '''const d = typeof args.fns.dash === "function" ? args.fns.dash() : null;
const today = Number(d?.todayMl) || 0;
const goal = Math.max(1, Number(d?.goalMl) || 2000);
const streak = Number(d?.streakDays) || 0;
return {
  as: "p",
  class: "hm-prog-label",
  text: `Today: ${today} ml / ${goal} ml · Streak: ${streak} day(s)`,
  hide: () => !args.user
};'''
        css:
          '''return `._id.hm-prog-label {
  margin: 0 0 ${args.theme.var.spacing.sm};
  font-weight: 600;
  color: ${args.theme.var.color.text};
}`;'''
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        displayOrder: 2
