{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        title: HydrateMe
        url: /hydrateme
        key: HydrateMeHome
        fns:
          '''
return {
  enabled: () => true,
  executeYTOFunction: (functionName, contextData) =>
    args.executeNamedServerFunction({
      functionName,
      contextData: contextData || {},
    }),
};
'''
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: PageLayout
      P: {
        displayOrder: 1
        componentName: HydrateMeLayout
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: hm_home_root
        fns:
          '''
const [dash, setDash] = args.createSignal(null);

const loadDashboard = async () => {
  if (!args.user) {
    setDash(null);
    return;
  }
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "hydrateMeGetDashboard",
      contextData: {},
    });
    if (result?.error || result?.result?.success === false) {
      const msg = result?.error || result?.result?.message || "Could not load dashboard.";
      args.showErrorToast?.(msg);
      setDash(null);
      return;
    }
    setDash(result?.result?.data ?? null);
  } catch (e) {
    console.error(e);
    args.showErrorToast?.("Could not load dashboard.");
  }
};

const logQuick = async (amountMl) => {
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "hydrateMeLogWater",
      contextData: { amountMl },
    });
    if (result?.error || result?.result?.success === false) {
      const msg = result?.error || result?.result?.message || "Could not log water.";
      args.showErrorToast?.(msg);
      return;
    }
    args.showSuccessToast?.(result?.result?.message || "Logged");
    await loadDashboard();
  } catch (e) {
    console.error(e);
    args.showErrorToast?.("Could not log water.");
  }
};

return { dash, loadDashboard, logQuick };
'''
        props:
          '''return {
  as: "div",
  class: "hm-home-root",
  onMount: () => {
    args.fns.loadDashboard();
  }
};'''
        css:
          '''return `._id.hm-home-root {
  display: flex;
  flex-direction: column;
  gap: ${args.theme.var.spacing.lg};
}`;'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: hm_home_h1
        props:
          '''return {
  as: "h1",
  class: "hm-home-title",
  text: "Stay hydrated, together"
};'''
        css:
          '''return `._id.hm-home-title {
  margin: 0;
  font-size: clamp(1.5rem, 4vw, 2rem);
  font-weight: 800;
  color: ${args.theme.var.color.text};
}`;'''
      }
    }
