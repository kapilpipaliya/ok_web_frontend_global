        key: hm_home_prog_bar
        props:
          '''return {
  as: "div",
  class: "hm-prog-track",
  hide: () => !args.user
};'''
        css:
          '''return `._id.hm-prog-track {
  height: 0.75rem;
  border-radius: ${args.theme.var.borderRadius.full};
  background: ${args.theme.var.color.border};
  overflow: hidden;
}`;'''
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: hm_home_prog_fill
        props:
          '''const d = typeof args.fns.dash === "function" ? args.fns.dash() : null;
const today = Number(d?.todayMl) || 0;
const goal = Math.max(1, Number(d?.goalMl) || 2000);
const pct = Math.min(100, Math.round((today / goal) * 100));
return {
  as: "div",
  class: "hm-prog-fill",
  style: { width: `${pct}%` },
  hide: () => !args.user
};'''
        css:
          '''return `._id.hm-prog-fill {
  height: 100%;
  border-radius: ${args.theme.var.borderRadius.full};
  background: ${args.theme.var.color.primary};
  transition: width ${args.theme.var.animation.normal} ease;
}`;'''
      }
    }
