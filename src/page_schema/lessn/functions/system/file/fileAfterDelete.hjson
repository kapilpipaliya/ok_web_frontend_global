{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: After a File vertex is deleted, remove the original and optimized variants from disk (same as DELETE /api/file).
        body:
          '''
const { tableVertexLabel, operation, result } = c;

if (tableVertexLabel !== "File" || operation !== "delete") return;

const fileProps = result?.data?.P;
if (!fileProps) return;

const subDomain = fileProps.subDomain != null ? String(fileProps.subDomain) : "";
const fileId = result?.data?.id != null ? String(result.data.id) : "";
if (subDomain && fileId) {
  try {
    await _.cancelImageOptimizationJob(subDomain, fileId);
  } catch (e) {
    console.log(e);
  }
}

try {
  await _.deleteFileDiskArtifacts(fileProps);
} catch (e) {
  console.log(e);
}
'''
        key: fileAfterDelete
      }
    }
  ]
  edges: []
}
