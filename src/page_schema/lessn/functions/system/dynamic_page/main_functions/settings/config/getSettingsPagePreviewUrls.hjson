{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Returns settings pages and preview URL map from Page vertices (settingsPageId + url).
        body:
          '''
/**
 * Loads settings pages from Page vertices.
 * Returns {
 *   previewUrls: { [settingsPageId]: url },
 *   pages: [{ settingsPageId, url, key, title }],
 *   sidebarItems: [{ id, label, path, icon }]
 * }
 */

try {
  const result = await _.session.run(
    `
    MATCH (p:Page)
    WHERE p.settingsPageId IS NOT NULL
      AND p.url IS NOT NULL
      AND trim(toString(p.settingsPageId)) <> ""
      AND trim(toString(p.url)) <> ""
    RETURN
      p.settingsPageId AS settingsPageId,
      p.url AS url,
      p.key AS key,
      p.title AS title,
      p.description AS description
    ORDER BY toLower(coalesce(toString(p.title), toString(p.key), toString(p.settingsPageId)))
    `
  );

  const previewUrls = { global: "/" };
  const pagesById = {};

  for (let i = 0; i < result.records.length; i++) {
    const record = result.records[i];
    const settingsPageId = record.get("settingsPageId");
    const url = record.get("url");
    if (settingsPageId == null || url == null) continue;

    const pageId = String(settingsPageId).trim();
    const pageUrl = String(url).trim();
    if (!pageId || !pageUrl) continue;

    // Prefer shorter public URLs (e.g. "/" over "/home-old") when duplicates share settingsPageId
    const existing = pagesById[pageId];
    if (existing && existing.url.length <= pageUrl.length) {
      continue;
    }

    const key = record.get("key") != null ? String(record.get("key")).trim() : "";
    const title = record.get("title") != null ? String(record.get("title")).trim() : "";
    const description = record.get("description") != null ? String(record.get("description")).trim() : "";
    const label = title || description || key || pageId;

    pagesById[pageId] = {
      settingsPageId: pageId,
      url: pageUrl,
      key: key || null,
      title: title || null,
      label
    };
    previewUrls[pageId] = pageUrl;
  }

  const pages = Object.keys(pagesById)
    .sort((a, b) => {
      const labelA = String(pagesById[a].label || a).toLowerCase();
      const labelB = String(pagesById[b].label || b).toLowerCase();
      return labelA.localeCompare(labelB);
    })
    .map((id) => pagesById[id]);

  const sidebarItems = pages.map((page) => ({
    id: page.settingsPageId,
    label: page.label,
    path: `/settings?page=${page.settingsPageId}`,
    icon: "document"
  }));

  return {
    success: true,
    data: { previewUrls, pages, sidebarItems },
    message: `Loaded ${pages.length} page preview URLs`
  };
} catch (error) {
  console.error("getSettingsPagePreviewUrls:", error);
  return {
    success: false,
    message: error?.message || "Failed to load page preview URLs"
  };
}
'''
        key: getSettingsPagePreviewUrls
      }
    }
  ]
  edges: []
}
