{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Creates, updates, or deletes user content. Works with any tableVertexLabel.
        body:
          '''
// Get current authenticated user from session
const actualUser = await _.getUserFromSession();
if (!actualUser) {
  return {
    success: false,
    message: "User session not found. Please log in and try again."
  };
}

// Get effective user (handles admin impersonation)
const user = await _.getEffectiveUser(_.session, actualUser, c);

// Extract parameters
// Format: data is an object with { vertex, relationships, nestedLineSync? }
const inputData = c.data || {};
const vertex = inputData.vertex;
const relationships = inputData.relationships || {};
const nestedLineSync = inputData.nestedLineSync || {};
const {
  tableVertexLabel,
  operation,
  elementId,
  uniqueKeys = [],
  enableUserScoping,
  hooks,
  nestedLinePropertyStripKeys = [],
  translatableFieldKeys = [],
  siteLanguages = []
} = c;

const nestedLineStripFromConfig = Array.isArray(nestedLinePropertyStripKeys)
  ? nestedLinePropertyStripKeys.map((k) => String(k))
  : [];
const NESTED_LINE_STRIP_KEYS = new Set([...Object.keys(nestedLineSync), ...nestedLineStripFromConfig]);

const isNeo4jPrimitive = (value) =>
  typeof value === "string" || typeof value === "number" || typeof value === "boolean";

const toNeo4jSafePropertyValue = (value) => {
  if (value === null || value === undefined) return value;
  if (isNeo4jPrimitive(value)) return value;
  if (Array.isArray(value)) {
    if (value.every((item) => isNeo4jPrimitive(item))) return value;
    return JSON.stringify(value);
  }
  if (typeof value === "object") return JSON.stringify(value);
  return String(value);
};

const sanitizePropertiesForNeo4j = (properties) => {
  const safe = {};
  for (const [key, value] of Object.entries(properties || {})) {
    if (value === undefined || value === null) continue;
    safe[key] = toNeo4jSafePropertyValue(value);
  }
  return safe;
};

const TRANSLATABLE_FIELD_KEYS = Array.isArray(translatableFieldKeys)
  ? translatableFieldKeys.map((k) => String(k)).filter(Boolean)
  : [];

const mergeChildGraphIntoContext = (childResult) => {
  const graph = childResult?.graph;
  if (!graph) return;
  const deletedVertexes = graph.deleted_vertexes;
  if (Array.isArray(deletedVertexes) && deletedVertexes.length > 0) {
    if (!_.context.deletedVertexes) _.context.deletedVertexes = [];
    for (let i = 0; i < deletedVertexes.length; i++) {
      const id = String(deletedVertexes[i]);
      if (!_.context.deletedVertexes.includes(id)) {
        _.context.deletedVertexes.push(id);
      }
    }
  }
  const deletedEdges = graph.deleted_edges;
  if (Array.isArray(deletedEdges) && deletedEdges.length > 0) {
    if (!_.context.deletedEdges) _.context.deletedEdges = [];
    for (let i = 0; i < deletedEdges.length; i++) {
      const id = String(deletedEdges[i]);
      if (!_.context.deletedEdges.includes(id)) {
        _.context.deletedEdges.push(id);
      }
    }
  }
  const childNodes = graph.vertexes;
  if (childNodes && typeof childNodes === "object") {
    if (!_.context.nodes) _.context.nodes = {};
    Object.assign(_.context.nodes, childNodes);
  }
  const childRels = graph.edges;
  if (childRels && typeof childRels === "object") {
    if (!_.context.relationships) _.context.relationships = {};
    Object.assign(_.context.relationships, childRels);
  }
};

const splitFormTranslations = async (props) => {
  if (TRANSLATABLE_FIELD_KEYS.length === 0) {
    return { rootProps: { ...(props || {}) }, translationsByLocale: {} };
  }
  const splitResult = await s(
    {
      functionName: "localizationHelpers",
      contextData: {
        action: "splitTranslatableProps",
        props,
        fieldKeys: TRANSLATABLE_FIELD_KEYS,
        languages: siteLanguages
      }
    },
    _.context
  );
  const data = splitResult?.result?.data;
  if (!splitResult?.result?.success || !data) {
    throw new Error(splitResult?.result?.message || "Failed to split translatable props");
  }
  return {
    rootProps: data.rootProps || {},
    translationsByLocale: data.translationsByLocale || {}
  };
};

const syncContentTranslations = async (action, contextData) => {
  const syncResult = await s(
    {
      functionName: "syncContentTranslations",
      contextData: { action, ...contextData }
    },
    _.context
  );
  mergeChildGraphIntoContext(syncResult);
  if (!syncResult?.result?.success) {
    throw new Error(syncResult?.result?.message || `Failed to ${action} translations`);
  }
  return syncResult.result;
};

const getInventoryVertexIdFromLineRow = (lineRow) => {
  if (lineRow.inventoryItemId != null && String(lineRow.inventoryItemId).trim() !== "")
    return String(lineRow.inventoryItemId).trim();
  if (lineRow.inventoryId != null && String(lineRow.inventoryId).trim() !== "")
    return String(lineRow.inventoryId).trim();
  return null;
};

const rowPassesNestedLineSyncRules = (lineRow, nestedLineItemsSyncRules) => {
  if (!nestedLineItemsSyncRules || typeof nestedLineItemsSyncRules !== "object") return true;

  const quantityFieldKey =
    nestedLineItemsSyncRules.quantityFieldKey != null
      ? String(nestedLineItemsSyncRules.quantityFieldKey)
      : null;
  const quantityRule = nestedLineItemsSyncRules.quantityRule;
  if (quantityFieldKey && quantityRule && typeof quantityRule === "object") {
    const quantityValue = Number(lineRow[quantityFieldKey]);
    const compareOp = quantityRule.op;
    const compareTo = Number(quantityRule.value);
    if (compareOp === ">") {
      if (!Number.isFinite(quantityValue) || !(quantityValue > compareTo)) return false;
    } else if (compareOp === ">=") {
      if (!Number.isFinite(quantityValue) || !(quantityValue >= compareTo)) return false;
    } else if (compareOp === "<") {
      if (!Number.isFinite(quantityValue) || !(quantityValue < compareTo)) return false;
    } else if (compareOp === "<=") {
      if (!Number.isFinite(quantityValue) || !(quantityValue <= compareTo)) return false;
    } else if (compareOp === "==") {
      if (!Number.isFinite(quantityValue) || quantityValue !== compareTo) return false;
    }
  }

  const requiredFieldKeys = Array.isArray(nestedLineItemsSyncRules.rowRequiredFields)
    ? nestedLineItemsSyncRules.rowRequiredFields
    : [];
  for (let fieldIndex = 0; fieldIndex < requiredFieldKeys.length; fieldIndex++) {
    const requiredKey = requiredFieldKeys[fieldIndex];
    if (String(lineRow[requiredKey] ?? "").trim() === "") return false;
  }

  const inventoryVertexId = getInventoryVertexIdFromLineRow(lineRow);
  const inventoryRequiredMode = nestedLineItemsSyncRules.inventoryRequiredMode || "never";
  if (inventoryRequiredMode === "always") {
    if (!inventoryVertexId) return false;
  } else if (inventoryRequiredMode === "when") {
    const whenFieldKey = nestedLineItemsSyncRules.inventoryRequiredWhenField;
    const whenValues = Array.isArray(nestedLineItemsSyncRules.inventoryRequiredWhenValues)
      ? nestedLineItemsSyncRules.inventoryRequiredWhenValues
      : [];
    if (whenFieldKey != null && String(whenFieldKey).trim() !== "" && whenValues.length > 0) {
      const fieldRawValue = lineRow[whenFieldKey];
      const normalizedFieldValue = String(fieldRawValue ?? "").trim().toLowerCase();
      const fieldMatchesWhen = whenValues.some(
        (allowedValue) => String(allowedValue).trim().toLowerCase() === normalizedFieldValue,
      );
      if (fieldMatchesWhen && !inventoryVertexId) return false;
    }
  }

  return true;
};

const buildChildLineProps = (lineRow, parentElementIdPropOnChild, parentElementId) => {
  const propertyKeysToSkip = new Set([
    "id",
    "inventoryItemId",
    "inventoryId",
    "imageFileIds",
    "fileIds",
    "images",
    "_key",
    "_draft"
  ]);
  const lineVertexProps = {};
  for (const [propertyKey, propertyValue] of Object.entries(lineRow || {})) {
    if (propertyKeysToSkip.has(propertyKey)) continue;
    if (String(propertyKey).startsWith("_")) continue;
    if (propertyValue === undefined || propertyValue === null || propertyValue === "") continue;
    lineVertexProps[propertyKey] = toNeo4jSafePropertyValue(propertyValue);
  }
  if (parentElementIdPropOnChild) {
    lineVertexProps[parentElementIdPropOnChild] = parentElementId;
  }
  return lineVertexProps;
};


const getImageFileIdsFromLineRow = (lineRow) => {
  const raw = lineRow?.imageFileIds != null ? lineRow.imageFileIds : lineRow?.fileIds;
  if (!Array.isArray(raw)) return [];
  const ids = [];
  const seen = new Set();
  for (let i = 0; i < raw.length; i++) {
    const id = raw[i] != null ? String(raw[i]).trim() : "";
    if (!id || id.startsWith("-") || seen.has(id)) continue;
    seen.add(id);
    ids.push(id);
  }
  return ids;
};

const syncLineFileEdges = async (
  session,
  {
    lineElementId,
    childLabel,
    childToFilesRelationshipType,
    filesTargetLabel,
    imageFileIds
  }
) => {
  if (!lineElementId || !childToFilesRelationshipType || !filesTargetLabel) return;
  await session.run(
    `MATCH (line:${childLabel})
     WHERE elementId(line) = $lid
     OPTIONAL MATCH (line)-[xr:${childToFilesRelationshipType}]->()
     DELETE xr`,
    { lid: lineElementId }
  );
  const ids = Array.isArray(imageFileIds) ? imageFileIds : [];
  if (ids.length === 0) return;
  await session.run(
    `UNWIND range(0, size($fileIds) - 1) AS idx
     WITH $fileIds[idx] AS fileId, idx
     MATCH (line:${childLabel})
     WHERE elementId(line) = $lid
     MATCH (file:${filesTargetLabel})
     WHERE elementId(file) = fileId
     CREATE (line)-[:${childToFilesRelationshipType} {displayOrder: idx}]->(file)`,
    { lid: lineElementId, fileIds: ids }
  );
};

const isLocalGraphVertexId = (id) => {
  if (id == null) return true;
  const trimmed = String(id).trim();
  if (!trimmed) return true;
  return trimmed.startsWith("-");
};

const patchRelationshipFieldPropsOnVertex = (vertex, relationships) => {
  if (!vertex?.P || !relationships || typeof relationships !== "object") return;
  for (const [fieldKey, relConfig] of Object.entries(relationships)) {
    if (!relConfig || typeof relConfig !== "object") continue;
    const ids = Array.isArray(relConfig.targetIds)
      ? relConfig.targetIds.map((x) => String(x).trim()).filter(Boolean)
      : [];
    if (ids.length === 0) {
      vertex.P[fieldKey] = null;
      continue;
    }
    vertex.P[fieldKey] = ids.length === 1 ? ids[0] : ids;
  }
};

const stripRelationshipFieldKeysFromProps = (props, relationships) => {
  if (!props || typeof props !== "object" || !relationships || typeof relationships !== "object")
    return;
  for (const fieldKey of Object.keys(relationships)) {
    delete props[fieldKey];
  }
};

const syncNestedLineCollections = async (session, params) => {
  const {
    parentElementId,
    parentLabel,
    nestedLineSync: syncMap,
    enableUserScoping,
    userUuid,
    userRelationshipType
  } = params;
  if (!syncMap || typeof syncMap !== "object") return;
  if (!parentElementId) return;

  for (const [, spec] of Object.entries(syncMap)) {
    if (!spec || typeof spec !== "object") continue;
    const childLabel = spec.childLabel;
    const parentToChildRelationshipType = spec.parentToChildRelationshipType;
    const childToInventoryRelationshipType = spec.childToInventoryRelationshipType || null;
    const inventoryTargetLabel = spec.inventoryTargetLabel || "InventoryItem";
    const childToFilesRelationshipType = spec.childToFilesRelationshipType || null;
    const filesTargetLabel = spec.filesTargetLabel || "File";
    const parentElementIdPropOnChild = spec.parentElementIdPropOnChild;
    const nestedLineItemsSyncRules = spec.nestedLineItemsSyncRules;
    const rows = Array.isArray(spec.rows) ? spec.rows : [];
    const deletedLineIds = Array.isArray(spec.deletedLineIds) ? spec.deletedLineIds : [];
    if (!childLabel || !parentToChildRelationshipType) continue;

    if (enableUserScoping) {
      const ownershipCheck = await session.run(
        `MATCH (u:User {uuid: $uuid})-[:${userRelationshipType}]->(p:${parentLabel})
         WHERE elementId(p) = $pid
         RETURN p LIMIT 1`,
        { uuid: userUuid, pid: parentElementId }
      );
      if (ownershipCheck.records.length === 0) continue;
    }

    for (let deleteIndex = 0; deleteIndex < deletedLineIds.length; deleteIndex++) {
      const lineElementId = deletedLineIds[deleteIndex];
      if (isLocalGraphVertexId(lineElementId)) continue;
      await session.run(
        `MATCH (p:${parentLabel})-[:${parentToChildRelationshipType}]->(line:${childLabel})
         WHERE elementId(p) = $pid AND elementId(line) = $lid
         DETACH DELETE line`,
        { pid: parentElementId, lid: String(lineElementId) }
      );
    }

    for (let rowIndex = 0; rowIndex < rows.length; rowIndex++) {
      const lineRow = rows[rowIndex];
      if (!lineRow || typeof lineRow !== "object") continue;
      if (!rowPassesNestedLineSyncRules(lineRow, nestedLineItemsSyncRules)) continue;

      const inventoryVertexId = getInventoryVertexIdFromLineRow(lineRow);
      const imageFileIds = getImageFileIdsFromLineRow(lineRow);
      const rawLineId = lineRow.id != null ? String(lineRow.id).trim() : "";
      const existingLineElementId = isLocalGraphVertexId(rawLineId) ? null : rawLineId;

      if (existingLineElementId) {
        const lineVertexProps = buildChildLineProps(
          lineRow,
          parentElementIdPropOnChild,
          parentElementId,
        );
        delete lineVertexProps.createdAt;
        await session.run(
          `MATCH (p:${parentLabel})-[:${parentToChildRelationshipType}]->(line:${childLabel})
           WHERE elementId(p) = $pid AND elementId(line) = $lid
           SET line += $props, line.updatedAt = datetime()`,
          { pid: parentElementId, lid: existingLineElementId, props: lineVertexProps }
        );
        if (childToInventoryRelationshipType && inventoryTargetLabel) {
          await session.run(
            `MATCH (line:${childLabel})
             WHERE elementId(line) = $lid
             OPTIONAL MATCH (line)-[xr:${childToInventoryRelationshipType}]->()
             DELETE xr`,
            { lid: existingLineElementId }
          );
          if (inventoryVertexId) {
            await session.run(
              `MATCH (line:${childLabel})
               WHERE elementId(line) = $lid
               MATCH (inv:${inventoryTargetLabel})
               WHERE elementId(inv) = $invId
               MERGE (line)-[:${childToInventoryRelationshipType}]->(inv)`,
              { lid: existingLineElementId, invId: inventoryVertexId }
            );
          }
        }
        await syncLineFileEdges(session, {
          lineElementId: existingLineElementId,
          childLabel,
          childToFilesRelationshipType,
          filesTargetLabel,
          imageFileIds
        });
      } else {
        const nowIso = new Date().toISOString();
        const lineVertexProps = buildChildLineProps(
          lineRow,
          parentElementIdPropOnChild,
          parentElementId,
        );
        lineVertexProps.createdAt = nowIso;
        lineVertexProps.updatedAt = nowIso;
        const createLineResult = await session.run(
          `MATCH (p:${parentLabel})
           WHERE elementId(p) = $pid
           CREATE (line:${childLabel} $props)
           CREATE (p)-[:${parentToChildRelationshipType}]->(line)
           RETURN elementId(line) AS lid`,
          { pid: parentElementId, props: lineVertexProps }
        );
        const newLineElementId = createLineResult.records[0]?.get("lid");
        const newLineElementIdStr = newLineElementId != null ? String(newLineElementId) : null;
        if (
          newLineElementIdStr &&
          inventoryVertexId &&
          childToInventoryRelationshipType &&
          inventoryTargetLabel
        ) {
          await session.run(
            `MATCH (line:${childLabel})
             WHERE elementId(line) = $lid
             MATCH (inv:${inventoryTargetLabel})
             WHERE elementId(inv) = $invId
             MERGE (line)-[:${childToInventoryRelationshipType}]->(inv)`,
            { lid: newLineElementIdStr, invId: inventoryVertexId }
          );
        }
        if (newLineElementIdStr) {
          await syncLineFileEdges(session, {
            lineElementId: newLineElementIdStr,
            childLabel,
            childToFilesRelationshipType,
            filesTargetLabel,
            imageFileIds
          });
        }
      }
    }

    // Reload children into API graph so edit forms can rehydrate after save.
    try {
      if (childToFilesRelationshipType && childToInventoryRelationshipType) {
        const reloadResult = await session.run(
          `MATCH (p:${parentLabel})-[r:${parentToChildRelationshipType}]->(line:${childLabel})
           WHERE elementId(p) = $pid
           OPTIONAL MATCH (line)-[ir:${childToInventoryRelationshipType}]->(inv)
           OPTIONAL MATCH (line)-[fr:${childToFilesRelationshipType}]->(file)
           RETURN p, r, line, ir, inv, fr, file`,
          { pid: parentElementId }
        );
        _.processResult(
          reloadResult.records,
          _.context,
          ["p", "line", "inv", "file"],
          ["r", "ir", "fr"]
        );
      } else if (childToFilesRelationshipType) {
        const reloadResult = await session.run(
          `MATCH (p:${parentLabel})-[r:${parentToChildRelationshipType}]->(line:${childLabel})
           WHERE elementId(p) = $pid
           OPTIONAL MATCH (line)-[fr:${childToFilesRelationshipType}]->(file)
           RETURN p, r, line, fr, file`,
          { pid: parentElementId }
        );
        _.processResult(reloadResult.records, _.context, ["p", "line", "file"], ["r", "fr"]);
      } else if (childToInventoryRelationshipType) {
        const reloadResult = await session.run(
          `MATCH (p:${parentLabel})-[r:${parentToChildRelationshipType}]->(line:${childLabel})
           WHERE elementId(p) = $pid
           OPTIONAL MATCH (line)-[ir:${childToInventoryRelationshipType}]->(inv)
           RETURN p, r, line, ir, inv`,
          { pid: parentElementId }
        );
        _.processResult(reloadResult.records, _.context, ["p", "line", "inv"], ["r", "ir"]);
      } else {
        const reloadResult = await session.run(
          `MATCH (p:${parentLabel})-[r:${parentToChildRelationshipType}]->(line:${childLabel})
           WHERE elementId(p) = $pid
           RETURN p, r, line`,
          { pid: parentElementId }
        );
        _.processResult(reloadResult.records, _.context, ["p", "line"], "r");
      }
    } catch (reloadErr) {
      console.error("syncNestedLineCollections reload:", reloadErr);
    }
  }
};

// Note: The returned API graph is built from _.context.nodes/relationships.
// Relationship writes must RETURN nodes/edges and run processResult to appear in the response.

if (!tableVertexLabel || typeof tableVertexLabel !== "string") {
  return {
    success: false,
    message: "tableVertexLabel is required and must be a string"
  };
}

if (!operation || !["create", "update", "delete", "batchUpdate"].includes(operation)) {
  return {
    success: false,
    message: "Invalid operation. Must be 'create', 'update', 'delete', or 'batchUpdate'"
  };
}

// Extract form data from vertex (single-row create/update/delete only)
let formData = null;
let translationsByLocale = null;
if (operation !== "batchUpdate") {
  if (!vertex || !vertex.P) {
    return {
      success: false,
      message: `${tableVertexLabel || "Content"} data is required`
    };
  }
  try {
    const split = await splitFormTranslations(vertex.P);
    formData = split.rootProps;
    translationsByLocale = split.translationsByLocale;
  } catch (splitError) {
    return {
      success: false,
      message: splitError?.message || "Failed to prepare translatable fields"
    };
  }
}

// Determine vertex label and relationship type based on tableVertexLabel
const vertexLabel = tableVertexLabel;
// Must match getUserContent.hjson: ownership is User + tableVertexLabel (e.g. UserFile for File).
// File uploads always create (User)-[:UserFile]->(File); tableSettingsLabel (e.g. FilePortal) is only for settings keys.
const relationshipType = `User${vertexLabel}`;

// Execute before hooks based on operation
if (operation === "create") {
  await _.executeHooks(hooks?.beforeCreate, {
    tableVertexLabel,
    operation,
    elementId,
    data: inputData,
    uniqueKeys,
    enableUserScoping
  });
} else if (operation === "update" || operation === "batchUpdate") {
  await _.executeHooks(hooks?.beforeUpdate, {
    tableVertexLabel,
    operation,
    elementId,
    data: inputData,
    uniqueKeys,
    enableUserScoping
  });
} else if (operation === "delete") {
  await _.executeHooks(hooks?.beforeDelete, {
    tableVertexLabel,
    operation,
    elementId,
    data: inputData,
    uniqueKeys,
    enableUserScoping
  });
}

try {
  if (operation === "create") {
    // Validate unique keys if provided
    if (uniqueKeys && Array.isArray(uniqueKeys) && uniqueKeys.length > 0) {
      // Build WHERE clause for unique key validation
      const uniqueConditions = uniqueKeys.map(key => {
        const value = formData[key];
        if (value === null || value === undefined || value === "") {
          return null; // Skip null/empty values in unique check
        }
        return `c.${key} = $unique_${key}`;
      }).filter(condition => condition !== null);

      if (uniqueConditions.length > 0) {
        // Check for existing records with same unique key values
        let checkQuery;
        let checkParams;
        if (!enableUserScoping) {
          checkQuery = `
            MATCH (c:${vertexLabel})
            WHERE ${uniqueConditions.join(" AND ")}
            RETURN c
            LIMIT 1
          `;
          checkParams = {};
        } else {
          checkQuery = `
            MATCH (u:User {uuid: $userUuid})-[:${relationshipType}]->(c:${vertexLabel})
            WHERE ${uniqueConditions.join(" AND ")}
            RETURN c
            LIMIT 1
          `;
          checkParams = { userUuid: user.P.uuid };
        }
        uniqueKeys.forEach(key => {
          if (formData[key] !== null && formData[key] !== undefined && formData[key] !== "") {
            checkParams[`unique_${key}`] = formData[key];
          }
        });

        const checkResult = await _.session.run(checkQuery, checkParams);
        if (checkResult.records.length > 0) {
          const conflictingKeys = uniqueKeys.filter(key => 
            formData[key] !== null && formData[key] !== undefined && formData[key] !== ""
          );
          return {
            success: false,
            message: `Record with ${conflictingKeys.join(", ")} already exists`
          };
        }
      }
    }

    // Build properties object (exclude id/elementId from formData)
    const { id, elementId: dataElementId, ...dataWithoutId } = formData;
    const properties = sanitizePropertiesForNeo4j({
      ...dataWithoutId,
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString()
    });
    if (vertexLabel === "User" && !properties.uuid) {
      properties.uuid = _.crypto.randomUUID();
    }
    NESTED_LINE_STRIP_KEYS.forEach((k) => {
      delete properties[k];
    });
    stripRelationshipFieldKeysFromProps(properties, relationships);

    // Create vertex and relationship in a single optimized transaction
    let createQuery;
    let createParams;
    if (!enableUserScoping) {
      createQuery = `
        CREATE (c:${vertexLabel} $properties)
        RETURN c
      `;
      createParams = { properties };
    } else {
      createQuery = `
        MATCH (u:User {uuid: $userUuid})
        CREATE (c:${vertexLabel} $properties)
        CREATE (u)-[:${relationshipType} {createdAt: datetime()}]->(c)
        RETURN c
      `;
      createParams = {
        userUuid: user.P.uuid,
        properties
      };
    }

    const result = await _.session.run(createQuery, createParams);

    if (result.records.length === 0) {
      return {
        success: false,
        message: "Failed to create content"
      };
    }

    // Use processResult to populate graph structure
    const vertices = _.processResult(result.records, _.context, 'c');
    const createdContent = vertices[0];
    const createdElementId = createdContent.id;

    // Handle relationships if provided (batched by relationshipType + targetLabel + direction)
    // Format: { fieldKey: { relationshipType, targetLabel, targetIds, incoming? } }
    if (relationships && typeof relationships === "object") {
      const validRels = [];
      for (const [fieldKey, relConfig] of Object.entries(relationships)) {
        if (!relConfig?.relationshipType || !relConfig?.targetLabel) continue;
        const ids = Array.isArray(relConfig.targetIds)
          ? relConfig.targetIds.map((x) => String(x).trim()).filter(Boolean)
          : [];
        for (let ri = 0; ri < ids.length; ri++) {
          validRels.push({ ...relConfig, fieldKey, targetId: ids[ri] });
        }
      }
      const byTypeAndLabel = new Map();
      for (const r of validRels) {
        const dir = r.incoming === true ? "in" : "out";
        const key = `${r.relationshipType}|${r.targetLabel}|${dir}`;
        if (!byTypeAndLabel.has(key)) byTypeAndLabel.set(key, []);
        byTypeAndLabel.get(key).push({ targetId: r.targetId, fieldKey: r.fieldKey });
      }
      for (const [key, items] of byTypeAndLabel) {
        const [relationshipType, targetLabel, dir] = key.split('|');
        const targetIds = items.map(i => i.targetId);
        const incoming = dir === "in";
        try {
          const relRes = await _.session.run(
            incoming
              ? `UNWIND $targetIds as targetId
                 MATCH (c:${vertexLabel}) WHERE elementId(c) = $contentId
                 MATCH (target:${targetLabel}) WHERE elementId(target) = targetId
                 MERGE (target)-[r:${relationshipType}]->(c)
                 ON CREATE SET r.createdAt = datetime()
                 RETURN c,
                   [x IN COLLECT(DISTINCT r) WHERE x IS NOT NULL] AS rlist,
                   [x IN COLLECT(DISTINCT target) WHERE x IS NOT NULL] AS tlist`
              : `UNWIND $targetIds as targetId
                 MATCH (c:${vertexLabel}) WHERE elementId(c) = $contentId
                 MATCH (target:${targetLabel}) WHERE elementId(target) = targetId
                 MERGE (c)-[r:${relationshipType}]->(target)
                 ON CREATE SET r.createdAt = datetime()
                 RETURN c,
                   [x IN COLLECT(DISTINCT r) WHERE x IS NOT NULL] AS rlist,
                   [x IN COLLECT(DISTINCT target) WHERE x IS NOT NULL] AS tlist`,
            { contentId: createdElementId, targetIds }
          );
          _.processResult(relRes.records, _.context, ["c", "tlist"], "rlist");
        } catch (relError) {
          console.error(`Error creating relationships for ${relationshipType}->${targetLabel}:`, relError);
        }
      }
    }

    patchRelationshipFieldPropsOnVertex(createdContent, relationships);

    try {
      await syncNestedLineCollections(_.session, {
        parentElementId: createdElementId,
        parentLabel: vertexLabel,
        nestedLineSync,
        enableUserScoping,
        userUuid: user.P.uuid,
        userRelationshipType: relationshipType
      });
    } catch (nestedErr) {
      console.error("syncNestedLineCollections (create):", nestedErr);
    }

    if (TRANSLATABLE_FIELD_KEYS.length > 0) {
      try {
        await syncContentTranslations("sync", {
          parentElementId: createdElementId,
          rootLabel: vertexLabel,
          translationsByLocale,
          fieldKeys: TRANSLATABLE_FIELD_KEYS
        });
      } catch (translationErr) {
        console.error("syncContentTranslations (create):", translationErr);
        return {
          success: false,
          message: translationErr?.message || "Failed to save translations"
        };
      }
    }

    const createResult = {
      success: true,
      data: createdContent,
      message: `${vertexLabel} created successfully`
    };

    // Execute afterCreate hooks
    await _.executeHooks(hooks?.afterCreate, {
      tableVertexLabel,
      operation,
      elementId: createdElementId,
      data: inputData,
      uniqueKeys,
      enableUserScoping,
      result: createResult
    });

    return createResult;

  } else if (operation === "update") {
    // Update existing content
    // Get elementId from vertex if available, otherwise use elementId parameter
    const updateElementId = elementId || vertex?.id;
    if (!updateElementId) {
      return {
        success: false,
        message: "elementId is required for update operation"
      };
    }

    // Validate unique keys if provided (excluding current record)
    if (uniqueKeys && Array.isArray(uniqueKeys) && uniqueKeys.length > 0) {
      const uniqueConditions = uniqueKeys.map(key => {
        const value = formData[key];
        if (value === null || value === undefined || value === "") {
          return null;
        }
        return `c.${key} = $unique_${key}`;
      }).filter(condition => condition !== null);

      if (uniqueConditions.length > 0) {
        // Check for existing records with same unique key values (excluding current record)
        let checkQuery;
        let checkParams;
        if (!enableUserScoping) {
          checkQuery = `
            MATCH (c:${vertexLabel})
            WHERE elementId(c) <> $elementId AND ${uniqueConditions.join(" AND ")}
            RETURN c
            LIMIT 1
          `;
          checkParams = { elementId: updateElementId };
        } else {
          checkQuery = `
            MATCH (u:User {uuid: $userUuid})-[:${relationshipType}]->(c:${vertexLabel})
            WHERE elementId(c) <> $elementId AND ${uniqueConditions.join(" AND ")}
            RETURN c
            LIMIT 1
          `;
          checkParams = { userUuid: user.P.uuid, elementId: updateElementId };
        }
        uniqueKeys.forEach(key => {
          if (formData[key] !== null && formData[key] !== undefined && formData[key] !== "") {
            checkParams[`unique_${key}`] = formData[key];
          }
        });

        const checkResult = await _.session.run(checkQuery, checkParams);
        if (checkResult.records.length > 0) {
          const conflictingKeys = uniqueKeys.filter(key => 
            formData[key] !== null && formData[key] !== undefined && formData[key] !== ""
          );
          return {
            success: false,
            message: `Record with ${conflictingKeys.join(", ")} already exists`
          };
        }
      }
    }

    // Build update properties (exclude id, elementId, createdAt)
    const { id, elementId: dataElementId, createdAt, ...dataWithoutId } = formData;
    const updateProperties = {
      ...dataWithoutId,
      updatedAt: new Date().toISOString()
    };

    // File media optimization is owned by the media-optimization worker. After upload the
    // client graph still has status=processing / variantsJson="{}" until it reloads; a form
    // save must not SET += those stale values and wipe a completed worker patch.
    if (vertexLabel === "File") {
      const FILE_OPTIMIZATION_PROTECTED_KEYS = [
        "status",
        "variantsJson",
        "processingVersion",
        "optimizedAt",
        "optimizationError",
        "optimizationGeneration"
      ];
      for (let i = 0; i < FILE_OPTIMIZATION_PROTECTED_KEYS.length; i++) {
        delete updateProperties[FILE_OPTIMIZATION_PROTECTED_KEYS[i]];
      }
    }

    // Remove undefined/null values and stringify nested objects/arrays for Neo4j
    const cleanProperties = sanitizePropertiesForNeo4j(updateProperties);
    NESTED_LINE_STRIP_KEYS.forEach((k) => {
      delete cleanProperties[k];
    });
    stripRelationshipFieldKeysFromProps(cleanProperties, relationships);

    // Update vertex with ownership verification in single query
    let updateQuery;
    let updateParams;
    if (!enableUserScoping) {
      updateQuery = `
        MATCH (c:${vertexLabel})
        WHERE elementId(c) = $elementId
        SET c += $properties
        RETURN c
      `;
      updateParams = {
        elementId: updateElementId,
        properties: cleanProperties
      };
    } else {
      updateQuery = `
        MATCH (u:User {uuid: $userUuid})-[:${relationshipType}]->(c:${vertexLabel})
        WHERE elementId(c) = $elementId
        SET c += $properties
        RETURN c
      `;
      updateParams = {
        userUuid: user.P.uuid,
        elementId: updateElementId,
        properties: cleanProperties
      };
    }

    const result = await _.session.run(updateQuery, updateParams);

    if (result.records.length === 0) {
      return {
        success: false,
        message: "Failed to update content"
      };
    }

    // Use processResult to populate graph structure
    const vertices = _.processResult(result.records, _.context, 'c');
    const updatedContent = vertices[0];

    // Handle relationships if provided (clear edge type per field, then optionally recreate)
    // Format: { fieldKey: { relationshipType, targetLabel, targetIds, incoming? } }
    if (relationships && typeof relationships === "object") {
      for (const [fieldKey, relConfig] of Object.entries(relationships)) {
        if (!relConfig?.relationshipType || !relConfig?.targetLabel) continue;
        const incoming = relConfig.incoming === true;
        try {
          // Capture edge ids so response includes deleted_edges (client can remove stale edges/labels)
          const captureRelQuery = incoming
            ? `
            MATCH ()-[r:${relConfig.relationshipType}]->(c:${vertexLabel})
            WHERE elementId(c) = $contentId
            RETURN c, [x IN COLLECT(DISTINCT r) WHERE x IS NOT NULL] AS rdel
          `
            : `
            MATCH (c:${vertexLabel})-[r:${relConfig.relationshipType}]->()
            WHERE elementId(c) = $contentId
            RETURN c, [x IN COLLECT(DISTINCT r) WHERE x IS NOT NULL] AS rdel
          `;
          const captureRes = await _.session.run(captureRelQuery, { contentId: updateElementId });
          _.processResult(captureRes.records, _.context, "c", "rdel");
          const relMap = _.context.relationships || {};
          // Safer: compute deleted ids from relationship map using source/end id + type.
          const delIds = [];
          for (const [eid, e] of Object.entries(relMap)) {
            if (!e || e.T !== relConfig.relationshipType) continue;
            if (incoming) {
              if (e.E === updateElementId) delIds.push(eid);
            } else if (e.S === updateElementId) {
              delIds.push(eid);
            }
          }
          if (!_.context.deletedEdges) _.context.deletedEdges = [];
          for (let i = 0; i < delIds.length; i++) _.context.deletedEdges.push(delIds[i]);
          // Do not return deleted edges in graph.edges; also remove them from node IN/OUT so UI reads the latest edge.
          const nodesMap = _.context.nodes || {};
          for (let i = 0; i < delIds.length; i++) {
            const delId = delIds[i];
            const ed = relMap[delId];
            if (ed) {
              const sNode = nodesMap[ed.S];
              const eNode = nodesMap[ed.E];
              if (sNode?.OUT?.[ed.T]) sNode.OUT[ed.T] = sNode.OUT[ed.T].filter((x) => x !== delId);
              if (eNode?.IN?.[ed.T]) eNode.IN[ed.T] = eNode.IN[ed.T].filter((x) => x !== delId);
            }
            delete relMap[delId];
          }

          const deleteRelQuery = incoming
            ? `
            MATCH ()-[r:${relConfig.relationshipType}]->(c:${vertexLabel})
            WHERE elementId(c) = $contentId
            DELETE r
          `
            : `
            MATCH (c:${vertexLabel})-[r:${relConfig.relationshipType}]->()
            WHERE elementId(c) = $contentId
            DELETE r
          `;
          await _.session.run(deleteRelQuery, { contentId: updateElementId });

          const targetIds = Array.isArray(relConfig.targetIds)
            ? relConfig.targetIds.map((x) => String(x).trim()).filter(Boolean)
            : [];

          if (targetIds.length === 0) continue;

          const createRelQuery = incoming
            ? `
            UNWIND $targetIds AS targetId
            MATCH (c:${vertexLabel})
            WHERE elementId(c) = $contentId
            MATCH (target:${relConfig.targetLabel})
            WHERE elementId(target) = targetId
            MERGE (target)-[r:${relConfig.relationshipType}]->(c)
            ON CREATE SET r.createdAt = datetime()
            ON MATCH SET r.updatedAt = datetime()
            RETURN c,
              [x IN COLLECT(DISTINCT r) WHERE x IS NOT NULL] AS rlist,
              [x IN COLLECT(DISTINCT target) WHERE x IS NOT NULL] AS tlist
          `
            : `
            UNWIND $targetIds AS targetId
            MATCH (c:${vertexLabel})
            WHERE elementId(c) = $contentId
            MATCH (target:${relConfig.targetLabel})
            WHERE elementId(target) = targetId
            MERGE (c)-[r:${relConfig.relationshipType}]->(target)
            ON CREATE SET r.createdAt = datetime()
            ON MATCH SET r.updatedAt = datetime()
            RETURN c,
              [x IN COLLECT(DISTINCT r) WHERE x IS NOT NULL] AS rlist,
              [x IN COLLECT(DISTINCT target) WHERE x IS NOT NULL] AS tlist
          `;

          const createRes = await _.session.run(createRelQuery, {
            contentId: updateElementId,
            targetIds,
          });
          _.processResult(createRes.records, _.context, ["c", "tlist"], "rlist");
        } catch (relError) {
          console.error(`Error updating relationship for ${fieldKey}:`, relError);
        }
      }
    }

    patchRelationshipFieldPropsOnVertex(updatedContent, relationships);

    try {
      await syncNestedLineCollections(_.session, {
        parentElementId: updateElementId,
        parentLabel: vertexLabel,
        nestedLineSync,
        enableUserScoping,
        userUuid: user.P.uuid,
        userRelationshipType: relationshipType
      });
    } catch (nestedErr) {
      console.error("syncNestedLineCollections (update):", nestedErr);
    }

    if (TRANSLATABLE_FIELD_KEYS.length > 0) {
      try {
        await syncContentTranslations("sync", {
          parentElementId: updateElementId,
          rootLabel: vertexLabel,
          translationsByLocale,
          fieldKeys: TRANSLATABLE_FIELD_KEYS
        });
      } catch (translationErr) {
        console.error("syncContentTranslations (update):", translationErr);
        return {
          success: false,
          message: translationErr?.message || "Failed to save translations"
        };
      }
    }

    const updateResult = {
      success: true,
      data: updatedContent,
      message: `${vertexLabel} updated successfully`
    };

    // Execute afterUpdate hooks
    await _.executeHooks(hooks?.afterUpdate, {
      tableVertexLabel,
      operation,
      elementId: updateElementId,
      data: inputData,
      uniqueKeys,
      enableUserScoping,
      result: updateResult
    });

    return updateResult;

  } else if (operation === "batchUpdate") {
    const rawItems = Array.isArray(inputData.items) ? inputData.items : [];
    if (rawItems.length === 0) {
      return {
        success: false,
        message: "items are required for batchUpdate"
      };
    }

    const FILE_OPTIMIZATION_PROTECTED_KEYS = [
      "status",
      "variantsJson",
      "processingVersion",
      "optimizedAt",
      "optimizationError",
      "optimizationGeneration"
    ];

    const items = [];
    for (let i = 0; i < rawItems.length; i++) {
      const raw = rawItems[i] || {};
      const itemElementId =
        raw.elementId ||
        raw.id ||
        raw.vertex?.id ||
        raw.vertex?.elementId;
      if (itemElementId == null || String(itemElementId).trim() === "") continue;

      const propsSource =
        raw.properties && typeof raw.properties === "object"
          ? raw.properties
          : raw.vertex?.P && typeof raw.vertex.P === "object"
            ? raw.vertex.P
            : null;
      if (!propsSource) continue;

      const { id, elementId: _dataElementId, createdAt, ...dataWithoutId } = propsSource;
      const updateProperties = {
        ...dataWithoutId,
        updatedAt: new Date().toISOString()
      };

      if (vertexLabel === "File") {
        for (let pk = 0; pk < FILE_OPTIMIZATION_PROTECTED_KEYS.length; pk++) {
          delete updateProperties[FILE_OPTIMIZATION_PROTECTED_KEYS[pk]];
        }
      }

      const cleanProperties = sanitizePropertiesForNeo4j(updateProperties);
      NESTED_LINE_STRIP_KEYS.forEach((k) => {
        delete cleanProperties[k];
      });

      items.push({
        elementId: String(itemElementId).trim(),
        properties: cleanProperties
      });
    }

    if (items.length === 0) {
      return {
        success: false,
        message: "No valid items to batch update"
      };
    }

    let batchQuery;
    let batchParams;
    if (!enableUserScoping) {
      batchQuery = `
        UNWIND $items AS item
        MATCH (c:${vertexLabel})
        WHERE elementId(c) = item.elementId
        SET c += item.properties
        RETURN c
      `;
      batchParams = { items };
    } else {
      batchQuery = `
        UNWIND $items AS item
        MATCH (u:User {uuid: $userUuid})-[:${relationshipType}]->(c:${vertexLabel})
        WHERE elementId(c) = item.elementId
        SET c += item.properties
        RETURN c
      `;
      batchParams = {
        userUuid: user.P.uuid,
        items
      };
    }

    const batchRunResult = await _.session.run(batchQuery, batchParams);
    const batchVertices = _.processResult(batchRunResult.records, _.context, "c");

    if (batchVertices.length === 0) {
      return {
        success: false,
        message: "Failed to batch update content"
      };
    }

    const batchResult = {
      success: true,
      data: {
        updated: batchVertices,
        count: batchVertices.length,
        requested: items.length
      },
      message: `Updated ${batchVertices.length} ${vertexLabel}(s) successfully`
    };

    await _.executeHooks(hooks?.afterUpdate, {
      tableVertexLabel,
      operation,
      elementId: null,
      data: inputData,
      uniqueKeys,
      enableUserScoping,
      result: batchResult
    });

    return batchResult;

  } else if (operation === "delete") {
    // Delete content - elementId can come from elementId parameter or vertex.id/vertex.elementId
    const deleteElementId = elementId || (vertex ? (vertex.elementId || vertex.id) : null);
    if (!deleteElementId) {
      return {
        success: false,
        message: "elementId is required for delete operation"
      };
    }

    // Get the vertex data before deletion for hooks (if needed)
    // We need to fetch it before deletion to get properties like Shopify ID
    let deletedVertexData = null;
    try {
      const fetchQuery = !enableUserScoping
        ? `MATCH (c:${vertexLabel}) WHERE elementId(c) = $elementId RETURN c`
        : `MATCH (u:User {uuid: $userUuid})-[:${relationshipType}]->(c:${vertexLabel}) WHERE elementId(c) = $elementId RETURN c`;
      const fetchParams = enableUserScoping ? { elementId: deleteElementId, userUuid: user.P.uuid } : { elementId: deleteElementId };
      const fetchResult = await _.session.run(fetchQuery, fetchParams);
      if (fetchResult.records.length > 0) {
        const vertexNode = fetchResult.records[0].get('c');
        deletedVertexData = _.convertNodeToJson(vertexNode);
      }
    } catch (e) {
      console.warn("Failed to fetch vertex data before deletion for hooks:", e);
    }

    // Capture connected edge ids before DETACH DELETE so the client can drop them
    // (deleteVertex requires empty IN/OUT on the local graph).
    const deletedEdgeIdsFromDetach = [];
    try {
      const edgeCaptureQuery = !enableUserScoping
        ? `
          MATCH (c:${vertexLabel})
          WHERE elementId(c) = $elementId
          OPTIONAL MATCH (c)-[r]-()
          RETURN collect(DISTINCT elementId(r)) as edgeIds
        `
        : `
          MATCH (u:User {uuid: $userUuid})-[:${relationshipType}]->(c:${vertexLabel})
          WHERE elementId(c) = $elementId
          OPTIONAL MATCH (c)-[r]-()
          RETURN collect(DISTINCT elementId(r)) as edgeIds
        `;
      const edgeCaptureParams = enableUserScoping
        ? { elementId: deleteElementId, userUuid: user.P.uuid }
        : { elementId: deleteElementId };
      const edgeCaptureResult = await _.session.run(edgeCaptureQuery, edgeCaptureParams);
      if (edgeCaptureResult.records.length > 0) {
        const edgeIds = edgeCaptureResult.records[0].get("edgeIds") || [];
        for (let i = 0; i < edgeIds.length; i++) {
          if (edgeIds[i] != null) deletedEdgeIdsFromDetach.push(String(edgeIds[i]));
        }
      }
    } catch (e) {
      console.warn("Failed to capture edge ids before content deletion:", e);
    }

    try {
      await syncContentTranslations("delete", {
        parentElementId: deleteElementId,
        rootLabel: vertexLabel
      });
    } catch (translationErr) {
      console.error("syncContentTranslations (delete):", translationErr);
      return {
        success: false,
        message: translationErr?.message || "Failed to delete translations"
      };
    }

    // Verify ownership and delete in single optimized query
    let deleteQuery;
    let deleteParams;
    if (!enableUserScoping) {
      deleteQuery = `
        MATCH (c:${vertexLabel})
        WHERE elementId(c) = $elementId
        DETACH DELETE c
        RETURN count(c) as deleted
      `;
      deleteParams = { elementId: deleteElementId };
    } else {
      deleteQuery = `
        MATCH (u:User {uuid: $userUuid})-[r:${relationshipType}]->(c:${vertexLabel})
        WHERE elementId(c) = $elementId
        DETACH DELETE c, r
        RETURN count(c) as deleted
      `;
      deleteParams = {
        userUuid: user.P.uuid,
        elementId: deleteElementId
      };
    }

    const result = await _.session.run(deleteQuery, deleteParams);

    const deleted = result.records[0]?.get('deleted') || 0;

    if (deleted === 0) {
      return {
        success: false,
        message: "Content not found or you don't have permission to delete it"
      };
    }

    // Push deletions into response graph so applyServerGraphToLocalGraph removes them
    if (!_.context.deletedEdges) _.context.deletedEdges = [];
    for (let i = 0; i < deletedEdgeIdsFromDetach.length; i++) {
      const edgeId = deletedEdgeIdsFromDetach[i];
      if (edgeId && !_.context.deletedEdges.includes(edgeId)) {
        _.context.deletedEdges.push(edgeId);
      }
    }
    if (!_.context.deletedVertexes) _.context.deletedVertexes = [];
    const deletedVertexId = String(deleteElementId);
    if (!_.context.deletedVertexes.includes(deletedVertexId)) {
      _.context.deletedVertexes.push(deletedVertexId);
    }

    const deleteResult = {
      success: true,
      message: `${vertexLabel} deleted successfully`,
      data: deletedVertexData
        ? { id: deleteElementId, P: deletedVertexData.P }
        : { id: deleteElementId },
      deleted_vertexes: [deletedVertexId],
      deleted_edges: deletedEdgeIdsFromDetach
    };

    // Execute afterDelete hooks
    await _.executeHooks(hooks?.afterDelete, {
      tableVertexLabel,
      operation,
      elementId: deleteElementId,
      data: inputData,
      uniqueKeys,
      enableUserScoping,
      result: deleteResult
    });

    return deleteResult;
  }
} catch (error) {
  console.error(`Error in mutateUserContent (${operation}):`, error);
  return {
    success: false,
    message: error.message || `Failed to ${operation} ${tableVertexLabel}`
  };
}
'''
        key: mutateUserContent
      }
    }
  ]
  edges: []
}