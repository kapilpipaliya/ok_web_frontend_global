{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Moves multiple content items to a category by creating relationships. If categoryId is null/empty or the synthetic _{contentLabel}_uncategorized id, removes relationships instead.
        body:
          '''
// Get current authenticated user from session
const actualUser = await _.getUserFromSession();
if (!actualUser) {
  return {
    success: false,
    message: "User session not found. Please log in and try again."
  };
}

// Get effective user (handles admin impersonation)
const user = await _.getEffectiveUser(_.session, actualUser, c);

// Extract parameters
const { 
  contentIds, 
  categoryId, 
  relationshipType, 
  categoryLabel, 
  contentLabel, 
  contentLabelDisplay,
  enableUserScopingForSidebar, 
  enableUserScopingForContent,
  sourceCategoryId,
  hooks
} = c;

if (!contentIds || !Array.isArray(contentIds) || contentIds.length === 0) {
  return {
    success: false,
    message: "contentIds array is required and must not be empty"
  };
}

if (!relationshipType || !categoryLabel || !contentLabel) {
  return {
    success: false,
    message: "relationshipType, categoryLabel, and contentLabel are required"
  };
}

const userUuid = user.P.uuid;
const userCategoryRelType = `User${categoryLabel}`;
const contentRelType = `User${contentLabel}`;
const uncategorizedVertexId = contentLabel ? '_' + contentLabel + '_uncategorized' : null;
const allVertexId = contentLabel ? '_' + contentLabel + '_all' : null;
const isUncategorizedCategoryId = (id) =>
  id == null ||
  id === '' ||
  (uncategorizedVertexId != null && id === uncategorizedVertexId);
const isAllCategoryId = (id) =>
  allVertexId != null && id === allVertexId;
const isConcreteCategoryId = (id) =>
  id != null &&
  id !== '' &&
  (uncategorizedVertexId == null || id !== uncategorizedVertexId) &&
  (allVertexId == null || id !== allVertexId);

// Initialize deleted edges tracking in context if not exists
if (!_.context.deletedEdges) {
  _.context.deletedEdges = [];
}

// All is a view filter only — not a move destination
if (isAllCategoryId(categoryId)) {
  return {
    success: false,
    message: "Cannot move items to All"
  };
}

// If categoryId is null, undefined, or synthetic uncategorized id, remove relationships
const isUncategorized = isUncategorizedCategoryId(categoryId);

// Execute beforeMoveItemsToCategory hooks
await _.executeHooks(hooks?.beforeMoveItemsToCategory, {
  contentIds,
  categoryId,
  relationshipType,
  categoryLabel,
  contentLabel,
  enableUserScopingForSidebar,
  enableUserScopingForContent,
  sourceCategoryId
});

try {
  let query;
  let queryParams;
  let successCount = 0;
  let errorCount = 0;
  const errors = [];
  const deletedEdgeIds = [];

  if (isUncategorized) {
    // Remove relationships for all content items
    // First, get the edge IDs before deleting them
    let getEdgeIdsQuery;
    if (!enableUserScopingForContent) {
      getEdgeIdsQuery = `
        MATCH (content:${contentLabel})-[r:${relationshipType}]->(:${categoryLabel})
        WHERE elementId(content) IN $contentIds
        RETURN collect(elementId(r)) as edgeIds
      `;
      queryParams = { contentIds };
    } else {
      getEdgeIdsQuery = `
        MATCH (u:User {uuid: $userUuid})-[:${contentRelType}]->(content:${contentLabel})-[r:${relationshipType}]->(:${categoryLabel})
        WHERE elementId(content) IN $contentIds
        RETURN collect(elementId(r)) as edgeIds
      `;
      queryParams = { userUuid, contentIds };
    }

    const getEdgeIdsResult = await _.session.run(getEdgeIdsQuery, queryParams);
    const edgeIds = getEdgeIdsResult.records[0]?.get('edgeIds') || [];
    const validEdgeIds = Array.isArray(edgeIds) ? edgeIds.filter(id => id !== null) : [];

    // Now delete the edges
    if (validEdgeIds.length > 0) {
      if (!enableUserScopingForContent) {
        query = `
          UNWIND $edgeIds as edgeId
          MATCH ()-[r:${relationshipType}]->()
          WHERE elementId(r) = edgeId
          DELETE r
          RETURN count(r) as deletedCount
        `;
        queryParams = { edgeIds: validEdgeIds };
      } else {
        query = `
          UNWIND $edgeIds as edgeId
          MATCH ()-[r:${relationshipType}]->()
          WHERE elementId(r) = edgeId
          DELETE r
          RETURN count(r) as deletedCount
        `;
        queryParams = { edgeIds: validEdgeIds };
      }

      const deleteResult = await _.session.run(query, queryParams);
      successCount = deleteResult.records[0]?.get('deletedCount') || 0;
    }

    // Track deleted edge IDs
    if (validEdgeIds.length > 0) {
      deletedEdgeIds.push(...validEdgeIds);
      _.context.deletedEdges.push(...validEdgeIds);
    }

    // Calculate updated content counts for uncategorized and source category
    const updatedCounts = {};

    if (successCount > 0) {
      // Calculate uncategorized count (items without any category relationship)
      let uncategorizedCountQuery;
      let uncategorizedCountParams;
      if (!enableUserScopingForContent) {
        uncategorizedCountQuery = `
          MATCH (content:${contentLabel})
          WHERE NOT EXISTS {
            MATCH (content)-[:${relationshipType}]->(:${categoryLabel})
          }
          RETURN count(DISTINCT content) as contentCount
        `;
        uncategorizedCountParams = {};
      } else {
        uncategorizedCountQuery = `
          MATCH (u:User {uuid: $userUuid})-[:${contentRelType}]->(content:${contentLabel})
          WHERE NOT EXISTS {
            MATCH (content)-[:${relationshipType}]->(:${categoryLabel})
          }
          RETURN count(DISTINCT content) as contentCount
        `;
        uncategorizedCountParams = { userUuid };
      }

      const uncategorizedCountResult = await _.session.run(uncategorizedCountQuery, uncategorizedCountParams);
      const uncategorizedCount = uncategorizedCountResult.records[0]?.get('contentCount') || 0;
      updatedCounts.targetCount = uncategorizedCount;
      updatedCounts.targetCategoryId = uncategorizedVertexId;

      // Calculate source category count if provided and not uncategorized
      if (isConcreteCategoryId(sourceCategoryId)) {
        let sourceCountQuery;
        let sourceCountParams;
        if (!enableUserScopingForSidebar && !enableUserScopingForContent) {
          sourceCountQuery = `
            MATCH (content:${contentLabel})-[r:${relationshipType}]->(cat:${categoryLabel})
            WHERE elementId(cat) = $sourceCategoryId
            RETURN count(DISTINCT content) as contentCount
          `;
          sourceCountParams = { sourceCategoryId };
        } else if (!enableUserScopingForSidebar && enableUserScopingForContent) {
          sourceCountQuery = `
            MATCH (u:User {uuid: $userUuid})-[:${contentRelType}]->(content:${contentLabel})
            MATCH (content)-[:${relationshipType}]->(cat:${categoryLabel})
            WHERE elementId(cat) = $sourceCategoryId
            RETURN count(DISTINCT content) as contentCount
          `;
          sourceCountParams = { userUuid, sourceCategoryId };
        } else if (enableUserScopingForSidebar && !enableUserScopingForContent) {
          sourceCountQuery = `
            MATCH (u:User {uuid: $userUuid})-[:${userCategoryRelType}]->(cat:${categoryLabel})
            WHERE elementId(cat) = $sourceCategoryId
            MATCH (content:${contentLabel})-[r:${relationshipType}]->(cat)
            RETURN count(DISTINCT content) as contentCount
          `;
          sourceCountParams = { userUuid, sourceCategoryId };
        } else {
          sourceCountQuery = `
            MATCH (u:User {uuid: $userUuid})-[:${userCategoryRelType}]->(cat:${categoryLabel})
            WHERE elementId(cat) = $sourceCategoryId
            MATCH (u)-[:${contentRelType}]->(content:${contentLabel})-[r:${relationshipType}]->(cat)
            RETURN count(DISTINCT content) as contentCount
          `;
          sourceCountParams = { userUuid, sourceCategoryId };
        }

        const sourceCountResult = await _.session.run(sourceCountQuery, sourceCountParams);
        updatedCounts.sourceCount = sourceCountResult.records[0]?.get('contentCount') || 0;
        updatedCounts.sourceCategoryId = sourceCategoryId;
      } else if (sourceCategoryId != null && isUncategorizedCategoryId(sourceCategoryId)) {
        // Source is uncategorized, so use the same uncategorized count
        updatedCounts.sourceCount = uncategorizedCount;
        updatedCounts.sourceCategoryId = uncategorizedVertexId;
      }
    }

    const label = contentLabelDisplay || 'item';
    const plural = label.endsWith('y') ? label.slice(0, -1) + 'ies' : label + (label.endsWith('s') ? '' : 's');
    const uncategorizedResult = {
      success: true,
      message: `Moved ${successCount} ${successCount !== 1 ? plural : label} successfully`,
      data: { movedCount: successCount, updatedCounts: Object.keys(updatedCounts).length > 0 ? updatedCounts : undefined }
    };

    // Execute afterMoveItemsToCategory hooks
    await _.executeHooks(hooks?.afterMoveItemsToCategory, {
      contentIds,
      categoryId,
      relationshipType,
      categoryLabel,
      contentLabel,
      enableUserScopingForSidebar,
      enableUserScopingForContent,
      sourceCategoryId,
      result: uncategorizedResult
    });

    return uncategorizedResult;
  } else {
    // Create relationships for all content items to the category
    // Before creating, remove any existing relationships for these items
    // Process each content item individually to handle errors gracefully

    // Skip items already in the target category (important when moving from All)
    let idsToProcess = contentIds;
    let skippedAlreadyInTarget = 0;
    if (isConcreteCategoryId(categoryId) && Array.isArray(contentIds) && contentIds.length > 0) {
      let alreadyQuery;
      let alreadyParams;
      if (!enableUserScopingForContent) {
        alreadyQuery = `
          MATCH (content:${contentLabel})-[:${relationshipType}]->(cat:${categoryLabel})
          WHERE elementId(content) IN $contentIds AND elementId(cat) = $categoryId
          RETURN collect(elementId(content)) AS alreadyIds
        `;
        alreadyParams = { contentIds, categoryId };
      } else {
        alreadyQuery = `
          MATCH (u:User {uuid: $userUuid})-[:${contentRelType}]->(content:${contentLabel})-[:${relationshipType}]->(cat:${categoryLabel})
          WHERE elementId(content) IN $contentIds AND elementId(cat) = $categoryId
          RETURN collect(elementId(content)) AS alreadyIds
        `;
        alreadyParams = { userUuid, contentIds, categoryId };
      }
      try {
        const alreadyResult = await _.session.run(alreadyQuery, alreadyParams);
        const alreadyIds = alreadyResult.records[0]?.get('alreadyIds') || [];
        const alreadySet = new Set(
          (Array.isArray(alreadyIds) ? alreadyIds : []).map((id) => String(id))
        );
        if (alreadySet.size > 0) {
          idsToProcess = contentIds.filter((id) => !alreadySet.has(String(id)));
          skippedAlreadyInTarget = contentIds.length - idsToProcess.length;
        }
      } catch (alreadyError) {
        console.warn("moveItemsToCategory already-in-target check failed:", alreadyError);
      }
      if (idsToProcess.length === 0) {
        const label = contentLabelDisplay || 'item';
        const plural = label.endsWith('y') ? label.slice(0, -1) + 'ies' : label + (label.endsWith('s') ? '' : 's');
        return {
          success: false,
          message: `${plural} are already in this category`
        };
      }
    }

    for (const contentId of idsToProcess) {
      try {
        // First, get old edge IDs before deleting
        let getOldEdgeIdsQuery;
        let getOldEdgeIdsParams;

        if (!enableUserScopingForSidebar && !enableUserScopingForContent) {
          getOldEdgeIdsQuery = `
            MATCH (content:${contentLabel})
            WHERE elementId(content) = $contentId
            OPTIONAL MATCH (content)-[oldRel:${relationshipType}]->(:${categoryLabel})
            RETURN collect(elementId(oldRel)) as oldRelIds
          `;
          getOldEdgeIdsParams = { contentId };
        } else if (!enableUserScopingForSidebar && enableUserScopingForContent) {
          getOldEdgeIdsQuery = `
            MATCH (u:User {uuid: $userUuid})-[:${contentRelType}]->(content:${contentLabel})
            WHERE elementId(content) = $contentId
            OPTIONAL MATCH (content)-[oldRel:${relationshipType}]->(:${categoryLabel})
            RETURN collect(elementId(oldRel)) as oldRelIds
          `;
          getOldEdgeIdsParams = { userUuid, contentId };
        } else if (enableUserScopingForSidebar && !enableUserScopingForContent) {
          getOldEdgeIdsQuery = `
            MATCH (content:${contentLabel})
            WHERE elementId(content) = $contentId
            OPTIONAL MATCH (content)-[oldRel:${relationshipType}]->(:${categoryLabel})
            RETURN collect(elementId(oldRel)) as oldRelIds
          `;
          getOldEdgeIdsParams = { contentId };
        } else {
          getOldEdgeIdsQuery = `
            MATCH (u:User {uuid: $userUuid})-[:${contentRelType}]->(content:${contentLabel})
            WHERE elementId(content) = $contentId
            OPTIONAL MATCH (content)-[oldRel:${relationshipType}]->(:${categoryLabel})
            RETURN collect(elementId(oldRel)) as oldRelIds
          `;
          getOldEdgeIdsParams = { userUuid, contentId };
        }

        const getOldEdgeIdsResult = await _.session.run(getOldEdgeIdsQuery, getOldEdgeIdsParams);
        const oldRelIds = getOldEdgeIdsResult.records[0]?.get('oldRelIds') || [];
        const validOldRelIds = Array.isArray(oldRelIds) ? oldRelIds.filter(id => id !== null) : [];

        // Delete old edges if any exist
        if (validOldRelIds.length > 0) {
          const deleteOldEdgesQuery = `
            UNWIND $edgeIds as edgeId
            MATCH ()-[r:${relationshipType}]->()
            WHERE elementId(r) = edgeId
            DELETE r
            RETURN count(r) as deletedCount
          `;
          await _.session.run(deleteOldEdgesQuery, { edgeIds: validOldRelIds });
          deletedEdgeIds.push(...validOldRelIds);
          _.context.deletedEdges.push(...validOldRelIds);
        }

        // Now create the new relationship
        if (!enableUserScopingForSidebar && !enableUserScopingForContent) {
          query = `
            MATCH (cat:${categoryLabel})
            WHERE elementId(cat) = $categoryId
            MATCH (content:${contentLabel})
            WHERE elementId(content) = $contentId
            MERGE (content)-[r:${relationshipType}]->(cat)
            ON CREATE SET r.createdAt = datetime()
            ON MATCH SET r.updatedAt = datetime()
            RETURN r
          `;
          queryParams = { categoryId, contentId };
        } else if (!enableUserScopingForSidebar && enableUserScopingForContent) {
          query = `
            MATCH (cat:${categoryLabel})
            WHERE elementId(cat) = $categoryId
            MATCH (u:User {uuid: $userUuid})
            MATCH (u)-[:${contentRelType}]->(content:${contentLabel})
            WHERE elementId(content) = $contentId
            MERGE (content)-[r:${relationshipType}]->(cat)
            ON CREATE SET r.createdAt = datetime()
            ON MATCH SET r.updatedAt = datetime()
            RETURN r
          `;
          queryParams = { userUuid, categoryId, contentId };
        } else if (enableUserScopingForSidebar && !enableUserScopingForContent) {
          query = `
            MATCH (u:User {uuid: $userUuid})
            MATCH (u)-[:${userCategoryRelType}]->(cat:${categoryLabel})
            WHERE elementId(cat) = $categoryId
            MATCH (content:${contentLabel})
            WHERE elementId(content) = $contentId
            MERGE (content)-[r:${relationshipType}]->(cat)
            ON CREATE SET r.createdAt = datetime()
            ON MATCH SET r.updatedAt = datetime()
            RETURN r
          `;
          queryParams = { userUuid, categoryId, contentId };
        } else {
          query = `
            MATCH (u:User {uuid: $userUuid})
            MATCH (u)-[:${userCategoryRelType}]->(cat:${categoryLabel})
            WHERE elementId(cat) = $categoryId
            MATCH (u)-[:${contentRelType}]->(content:${contentLabel})
            WHERE elementId(content) = $contentId
            MERGE (content)-[r:${relationshipType}]->(cat)
            ON CREATE SET r.createdAt = datetime()
            ON MATCH SET r.updatedAt = datetime()
            RETURN r
          `;
          queryParams = { userUuid, categoryId, contentId };
        }

        const result = await _.session.run(query, queryParams);

        if (result.records.length > 0) {
          // Use processResult to populate graph structure
          _.processResult(result.records, _.context, [], 'r');
          successCount++;
        } else {
          errorCount++;
          errors.push(`Content item ${contentId} not found or not accessible`);
        }
      } catch (error) {
        errorCount++;
        errors.push(`Error moving content ${contentId}: ${error.message}`);
      }
    }

    // Calculate updated content counts for source and target categories
    const updatedCounts = {};

    if (successCount > 0) {
      // Calculate target category count
      if (categoryId) {
        let targetCountQuery;
        let targetCountParams;
        if (!enableUserScopingForSidebar && !enableUserScopingForContent) {
          targetCountQuery = `
            MATCH (content:${contentLabel})-[r:${relationshipType}]->(cat:${categoryLabel})
            WHERE elementId(cat) = $categoryId
            RETURN count(DISTINCT content) as contentCount
          `;
          targetCountParams = { categoryId };
        } else if (!enableUserScopingForSidebar && enableUserScopingForContent) {
          targetCountQuery = `
            MATCH (u:User {uuid: $userUuid})-[:${contentRelType}]->(content:${contentLabel})
            MATCH (content)-[:${relationshipType}]->(cat:${categoryLabel})
            WHERE elementId(cat) = $categoryId
            RETURN count(DISTINCT content) as contentCount
          `;
          targetCountParams = { userUuid, categoryId };
        } else if (enableUserScopingForSidebar && !enableUserScopingForContent) {
          targetCountQuery = `
            MATCH (u:User {uuid: $userUuid})-[:${userCategoryRelType}]->(cat:${categoryLabel})
            WHERE elementId(cat) = $categoryId
            MATCH (content:${contentLabel})-[r:${relationshipType}]->(cat)
            RETURN count(DISTINCT content) as contentCount
          `;
          targetCountParams = { userUuid, categoryId };
        } else {
          targetCountQuery = `
            MATCH (u:User {uuid: $userUuid})-[:${userCategoryRelType}]->(cat:${categoryLabel})
            WHERE elementId(cat) = $categoryId
            MATCH (u)-[:${contentRelType}]->(content:${contentLabel})-[r:${relationshipType}]->(cat)
            RETURN count(DISTINCT content) as contentCount
          `;
          targetCountParams = { userUuid, categoryId };
        }

        const targetCountResult = await _.session.run(targetCountQuery, targetCountParams);
        updatedCounts.targetCount = targetCountResult.records[0]?.get('contentCount') || 0;
        updatedCounts.targetCategoryId = categoryId;
      }

      // Calculate source category count if provided
      if (sourceCategoryId) {
        if (sourceCategoryId != null && isUncategorizedCategoryId(sourceCategoryId)) {
          // Source is uncategorized, count items without any category relationship
          let uncategorizedCountQuery;
          let uncategorizedCountParams;
          if (!enableUserScopingForContent) {
            uncategorizedCountQuery = `
              MATCH (content:${contentLabel})
              WHERE NOT EXISTS {
                MATCH (content)-[:${relationshipType}]->(:${categoryLabel})
              }
              RETURN count(DISTINCT content) as contentCount
            `;
            uncategorizedCountParams = {};
          } else {
            uncategorizedCountQuery = `
              MATCH (u:User {uuid: $userUuid})-[:${contentRelType}]->(content:${contentLabel})
              WHERE NOT EXISTS {
                MATCH (content)-[:${relationshipType}]->(:${categoryLabel})
              }
              RETURN count(DISTINCT content) as contentCount
            `;
            uncategorizedCountParams = { userUuid };
          }

          const uncategorizedCountResult = await _.session.run(uncategorizedCountQuery, uncategorizedCountParams);
          updatedCounts.sourceCount = uncategorizedCountResult.records[0]?.get('contentCount') || 0;
          updatedCounts.sourceCategoryId = uncategorizedVertexId;
        } else {
          // Source is a regular category
          let sourceCountQuery;
          let sourceCountParams;
          if (!enableUserScopingForSidebar && !enableUserScopingForContent) {
            sourceCountQuery = `
              MATCH (content:${contentLabel})-[r:${relationshipType}]->(cat:${categoryLabel})
              WHERE elementId(cat) = $sourceCategoryId
              RETURN count(DISTINCT content) as contentCount
            `;
            sourceCountParams = { sourceCategoryId };
          } else if (!enableUserScopingForSidebar && enableUserScopingForContent) {
            sourceCountQuery = `
              MATCH (u:User {uuid: $userUuid})-[:${contentRelType}]->(content:${contentLabel})
              MATCH (content)-[:${relationshipType}]->(cat:${categoryLabel})
              WHERE elementId(cat) = $sourceCategoryId
              RETURN count(DISTINCT content) as contentCount
            `;
            sourceCountParams = { userUuid, sourceCategoryId };
          } else if (enableUserScopingForSidebar && !enableUserScopingForContent) {
            sourceCountQuery = `
              MATCH (u:User {uuid: $userUuid})-[:${userCategoryRelType}]->(cat:${categoryLabel})
              WHERE elementId(cat) = $sourceCategoryId
              MATCH (content:${contentLabel})-[r:${relationshipType}]->(cat)
              RETURN count(DISTINCT content) as contentCount
            `;
            sourceCountParams = { userUuid, sourceCategoryId };
          } else {
            sourceCountQuery = `
              MATCH (u:User {uuid: $userUuid})-[:${userCategoryRelType}]->(cat:${categoryLabel})
              WHERE elementId(cat) = $sourceCategoryId
              MATCH (u)-[:${contentRelType}]->(content:${contentLabel})-[r:${relationshipType}]->(cat)
              RETURN count(DISTINCT content) as contentCount
            `;
            sourceCountParams = { userUuid, sourceCategoryId };
          }

          const sourceCountResult = await _.session.run(sourceCountQuery, sourceCountParams);
          updatedCounts.sourceCount = sourceCountResult.records[0]?.get('contentCount') || 0;
          updatedCounts.sourceCategoryId = sourceCategoryId;
        }
      }

      const label = contentLabelDisplay || 'item';
      const plural = label.endsWith('y') ? label.slice(0, -1) + 'ies' : label + (label.endsWith('s') ? '' : 's');
      const moveResult = {
        success: true,
        message: `Moved ${successCount} ${successCount !== 1 ? plural : label} successfully${errorCount > 0 ? ` (${errorCount} failed)` : ''}`,
        data: { 
          movedCount: successCount, 
          errorCount, 
          errors: errorCount > 0 ? errors : undefined,
          updatedCounts
        }
      };

      // Execute afterMoveItemsToCategory hooks
      await _.executeHooks(hooks?.afterMoveItemsToCategory, {
        contentIds,
        categoryId,
        relationshipType,
        categoryLabel,
        contentLabel,
        enableUserScopingForSidebar,
        enableUserScopingForContent,
        sourceCategoryId,
        result: moveResult
      });

      return moveResult;
    } else {
      const failResult = {
        success: false,
        message: `Failed to move items: ${errors.join('; ')}`,
        data: { movedCount: 0, errorCount, errors }
      };

      // Execute afterMoveItemsToCategory hooks even on failure
      await _.executeHooks(hooks?.afterMoveItemsToCategory, {
        contentIds,
        categoryId,
        relationshipType,
        categoryLabel,
        contentLabel,
        enableUserScopingForSidebar,
        enableUserScopingForContent,
        sourceCategoryId,
        result: failResult
      });

      return failResult;
    }
  }
} catch (error) {
  console.error("Error moving items to category:", error);
  return {
    success: false,
    message: error.message || "Failed to move items to category"
  };
}
'''
        key: moveItemsToCategory
      }
    }
  ]
  edges: []
}