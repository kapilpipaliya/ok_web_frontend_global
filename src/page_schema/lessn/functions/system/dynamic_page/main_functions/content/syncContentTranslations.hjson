{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Sync or delete {Label}Translation vertices for table content. Edge type is rootLabel + translationLabel.
        body:
          '''
/**
 * contextData.action: "sync" | "delete"
 * sync: parentElementId, rootLabel, translationsByLocale, fieldKeys
 * delete: parentElementId, rootLabel
 */

const action = c?.action;
if (!action) {
  return { success: false, message: "action is required" };
}

const getTranslationMeta = (rootLabel) => {
  const label = rootLabel != null ? String(rootLabel).trim() : "";
  const translationLabel = `${label}Translation`;
  return {
    rootLabel: label,
    translationLabel,
    edgeType: `${label}${translationLabel}`
  };
};

const pushUnique = (bucketKey, value) => {
  if (value == null || value === "") return;
  if (!Array.isArray(_.context[bucketKey])) _.context[bucketKey] = [];
  const id = String(value);
  if (!_.context[bucketKey].includes(id)) _.context[bucketKey].push(id);
};

const trackDeletedVertexId = (vertexId) => pushUnique("deletedVertexes", vertexId);
const trackDeletedEdgeId = (edgeId) => pushUnique("deletedEdges", edgeId);

const translationHasContent = (props, fieldKeys) => {
  if (!props || typeof props !== "object") return false;
  for (let i = 0; i < fieldKeys.length; i++) {
    const text = props[fieldKeys[i]];
    if (text != null && String(text).trim() !== "") return true;
  }
  return false;
};

const deleteAllTranslations = async (parentElementId, rootLabel) => {
  const { translationLabel, edgeType } = getTranslationMeta(rootLabel);
  const existingResult = await _.session.run(
    `
    MATCH (content:${rootLabel})-[translationEdge:${edgeType}]->(translation:${translationLabel})
    WHERE elementId(content) = $parentElementId
    OPTIONAL MATCH (translation)-[incidentEdge]-()
    RETURN
      [id IN collect(DISTINCT elementId(translation)) WHERE id IS NOT NULL] AS translationIds,
      [id IN collect(DISTINCT elementId(translationEdge)) WHERE id IS NOT NULL] AS translationEdgeIds,
      [id IN collect(DISTINCT elementId(incidentEdge)) WHERE id IS NOT NULL] AS incidentEdgeIds
    `,
    { parentElementId }
  );
  const record = existingResult.records[0];
  const translationIds = record ? record.get("translationIds") || [] : [];
  const translationEdgeIds = record ? record.get("translationEdgeIds") || [] : [];
  const incidentEdgeIds = record ? record.get("incidentEdgeIds") || [] : [];
  for (let i = 0; i < translationIds.length; i++) trackDeletedVertexId(translationIds[i]);
  for (let i = 0; i < translationEdgeIds.length; i++) trackDeletedEdgeId(translationEdgeIds[i]);
  for (let i = 0; i < incidentEdgeIds.length; i++) trackDeletedEdgeId(incidentEdgeIds[i]);
  if (!translationIds.length) return { deleted: 0 };
  await _.session.run(
    `
    MATCH (content:${rootLabel})-[:${edgeType}]->(translation:${translationLabel})
    WHERE elementId(content) = $parentElementId
    DETACH DELETE translation
    `,
    { parentElementId }
  );
  return { deleted: translationIds.length };
};

const syncTranslations = async (params) => {
  const {
    parentElementId,
    rootLabel,
    translationsByLocale,
    fieldKeys
  } = params;
  const keys = Array.isArray(fieldKeys) ? fieldKeys.map((k) => String(k)).filter(Boolean) : [];
  if (!parentElementId || !rootLabel || keys.length === 0) {
    return { upserted: 0, deleted: 0 };
  }

  const { translationLabel, edgeType } = getTranslationMeta(rootLabel);
  const nowIso = new Date().toISOString();

  const existingResult = await _.session.run(
    `
    MATCH (content:${rootLabel})-[:${edgeType}]->(translation:${translationLabel})
    WHERE elementId(content) = $parentElementId
    RETURN elementId(translation) AS translationId, translation.locale AS locale
    `,
    { parentElementId }
  );
  const existingByLocale = {};
  for (let i = 0; i < existingResult.records.length; i++) {
    const record = existingResult.records[i];
    const locale = record.get("locale");
    const translationId = record.get("translationId");
    if (locale != null && String(locale).trim() !== "" && translationId != null) {
      existingByLocale[String(locale)] = String(translationId);
    }
  }

  const desiredLocales = Object.keys(translationsByLocale || {});
  const toUpsert = [];
  const toDeleteIds = [];

  for (let i = 0; i < desiredLocales.length; i++) {
    const locale = desiredLocales[i];
    const localeProps = translationsByLocale[locale] || { locale };
    if (!translationHasContent(localeProps, keys)) {
      const existingId = existingByLocale[locale];
      if (existingId) toDeleteIds.push(existingId);
      continue;
    }
    const props = { locale, updatedAt: nowIso };
    for (let fieldIndex = 0; fieldIndex < keys.length; fieldIndex++) {
      const key = keys[fieldIndex];
      const text = localeProps[key];
      props[key] = text != null ? String(text) : "";
    }
    const existingId = existingByLocale[locale];
    if (existingId) {
      toUpsert.push({ translationId: existingId, props, isNew: false });
    } else {
      props.createdAt = nowIso;
      toUpsert.push({ translationId: null, props, isNew: true });
    }
  }

  const existingLocales = Object.keys(existingByLocale);
  for (let i = 0; i < existingLocales.length; i++) {
    const locale = existingLocales[i];
    if (desiredLocales.includes(locale)) continue;
    toDeleteIds.push(existingByLocale[locale]);
  }

  if (toDeleteIds.length > 0) {
    for (let i = 0; i < toDeleteIds.length; i++) trackDeletedVertexId(toDeleteIds[i]);
    await _.session.run(
      `
      MATCH (content:${rootLabel})-[:${edgeType}]->(translation:${translationLabel})
      WHERE elementId(content) = $parentElementId AND elementId(translation) IN $translationIds
      DETACH DELETE translation
      `,
      { parentElementId, translationIds: toDeleteIds }
    );
  }

  const toUpdate = toUpsert.filter((row) => !row.isNew);
  const toCreate = toUpsert.filter((row) => row.isNew);

  if (toUpdate.length > 0) {
    const updateResult = await _.session.run(
      `
      UNWIND $rows AS row
      MATCH (content:${rootLabel})-[translationEdge:${edgeType}]->(translation:${translationLabel})
      WHERE elementId(content) = $parentElementId AND elementId(translation) = row.translationId
      SET translation += row.props
      RETURN content, translationEdge, translation
      `,
      {
        parentElementId,
        rows: toUpdate.map((row) => ({
          translationId: row.translationId,
          props: row.props
        }))
      }
    );
    _.processResult(updateResult.records, _.context, ["content", "translation"], "translationEdge");
  }

  if (toCreate.length > 0) {
    const createResult = await _.session.run(
      `
      UNWIND $rows AS row
      MATCH (content:${rootLabel})
      WHERE elementId(content) = $parentElementId
      CREATE (translation:${translationLabel})
      SET translation = row.props
      CREATE (content)-[translationEdge:${edgeType}]->(translation)
      RETURN content, translationEdge, translation
      `,
      {
        parentElementId,
        rows: toCreate.map((row) => ({ props: row.props }))
      }
    );
    _.processResult(createResult.records, _.context, ["content", "translation"], "translationEdge");
  }

  return { upserted: toUpsert.length, deleted: toDeleteIds.length };
};

if (action === "delete") {
  const { parentElementId, rootLabel } = c;
  if (!parentElementId || !rootLabel) {
    return { success: false, message: "parentElementId and rootLabel are required" };
  }
  try {
    const data = await deleteAllTranslations(parentElementId, rootLabel);
    return { success: true, data, message: "Translations deleted" };
  } catch (error) {
    console.error("syncContentTranslations delete:", error);
    return {
      success: false,
      message: error?.message || "Failed to delete translations"
    };
  }
}

if (action === "sync") {
  const {
    parentElementId,
    rootLabel,
    translationsByLocale,
    fieldKeys
  } = c;
  if (!parentElementId || !rootLabel) {
    return { success: false, message: "parentElementId and rootLabel are required" };
  }
  try {
    const data = await syncTranslations({
      parentElementId,
      rootLabel,
      translationsByLocale,
      fieldKeys
    });
    return { success: true, data, message: "Translations synced" };
  } catch (error) {
    console.error("syncContentTranslations sync:", error);
    return {
      success: false,
      message: error?.message || "Failed to sync translations"
    };
  }
}

return { success: false, message: `Unknown action: ${action}` };
'''
        key: syncContentTranslations
      }
    }
  ]
  edges: []
}
