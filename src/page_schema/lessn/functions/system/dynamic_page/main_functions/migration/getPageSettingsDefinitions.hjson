    sections: [
      {
        id: "content",
        title: "Page content",
        fields: [
          buildField({ key: "pageTitle", label: "Page title", renderer: "text", defaultValue: "Products", colSpan: 1 }),
          buildField({ key: "pageSubtitle", label: "Page subtitle", renderer: "text", defaultValue: "Browse our curated Amazon product picks by category", colSpan: 1 }),
          buildField({ key: "rootBreadcrumbLabel", label: "Root breadcrumb label", renderer: "text", defaultValue: "Products", colSpan: 1 }),
          buildField({ key: "emptyCategoriesText", label: "Empty categories text", renderer: "text", defaultValue: "No categories in this location.", colSpan: 1 }),
          buildField({ key: "emptyProductsText", label: "Empty products text", renderer: "text", defaultValue: "No products in this category.", colSpan: 1 })
        ]
      }
    ],
    defaultDocuments: [{
      sectionId: "content",
      values: {
        pageTitle: "Products",
        pageSubtitle: "Browse our curated Amazon product picks by category",
        rootBreadcrumbLabel: "Products",
