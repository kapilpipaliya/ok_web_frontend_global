    sections: [
      {
        id: "content",
        title: "Page content",
        fields: [
          buildField({ key: "pageTitle", label: "Page title", renderer: "text", defaultValue: "Contact", colSpan: 1 }),
          buildField({ key: "pageSubtitle", label: "Page subtitle", renderer: "text", defaultValue: "Questions about a product or this site? Get in touch.", colSpan: 1 }),
          buildField({ key: "infoTitle", label: "Info section title", renderer: "text", defaultValue: "Contact information", colSpan: 1 }),
          buildField({ key: "email", label: "Email", renderer: "text", defaultValue: "", colSpan: 1, translatable: false })
        ]
      }
    ],
    defaultDocuments: [{
      sectionId: "content",
      values: {
        pageTitle: "Contact",
        pageSubtitle: "Questions about a product or this site? Get in touch.",
        infoTitle: "Contact information",
        email: ""
      }
    }]
  }
];
function stripFieldSchema(field) {
  if (!field || typeof field !== "object") return field;
  const next = { ...field };
  delete next.defaultValue;
  if (next.fieldArrayConfig && typeof next.fieldArrayConfig === "object") {
    const config = { ...next.fieldArrayConfig };
    delete config.defaultItems;
    if (Array.isArray(config.itemFields)) {
      config.itemFields = config.itemFields.map(stripFieldSchema);
    }
    next.fieldArrayConfig = config;
  }
  return next;
}

function buildConfig(page, contentSidebarItems, globalItems) {
  const sectionConfigs = page.sections.map((section) => ({
    id: section.id,
    type: "card",
    title: section.title,
    description: section.description || "",
    form: {
      gridColumns: 1,
      groups: [{
        key: section.id + "Form",
        title: "",
        gridColumns: 1,
        fields: (section.fields || []).map(stripFieldSchema)
      }]
    }
  }));

  return `return {
  pageMode: "settings",
  id: "${page.settingsPageId}",
  route: "/settings?page=${page.settingsPageId}",
  title: "${page.name}",
  description: "${page.description || ""}",
  version: 1,
  scope: { vertexLabel: "GlobalSetting", matchProperty: "key", idParam: "scopeId" },
  saveStrategy: { mode: "section", debounceMs: 1200, autosave: false, showSaveBar: true, warnOnLeave: true },
  audit: { enabled: true, resource: "settings.${page.settingsPageId}", includeDiff: true },
  sidebar: {
    title: "Site Settings",
    groups: [
      { id: "global", label: "Global", items: ${JSON.stringify(globalItems)} },
      { id: "content", label: "Content", items: ${JSON.stringify(contentSidebarItems)} }
    ]
  },
  sections: ${JSON.stringify(sectionConfigs)}
};`;
}

const finalizedPages = pages.map((page) => finalizePage(page));

const settingsPageConfigs = finalizedPages.map((page) => ({
  key: page.settingsPageId + "_settings_page",
  settingsPageId: page.settingsPageId,
  name: page.name,
  config: buildConfig(page, sidebarItems, globalSidebarItems)
}));

const defaultSectionDocuments = finalizedPages.flatMap((page) =>
  (page.defaultDocuments || []).map((doc) => ({
    pageId: page.settingsPageId,
    sectionId: doc.sectionId,
    values: doc.values
  }))
);

