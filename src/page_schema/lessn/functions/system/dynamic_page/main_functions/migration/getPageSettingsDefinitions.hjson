];
const tableSchemaParts = tableDefinitions.flatMap((tableDef) => [
  {
    key: tableDef.schemaKeys.general,
    tableKey: tableDef.tableKey,
    tableVertexLabel: tableDef.tableVertexLabel,
    part: "general",
    name: tableDef.name + " general schema",
    config: buildTableSchemaPartConfig("general", tableDef.general)
  },
  {
    key: tableDef.schemaKeys.columns,
    tableKey: tableDef.tableKey,
    tableVertexLabel: tableDef.tableVertexLabel,
    part: "columns",
    name: tableDef.name + " columns schema",
    config: tableDef.columnsConfig || buildTableSchemaPartConfig("columns", { columns: tableDef.columns })
  },
  {
    key: tableDef.schemaKeys.formConfig,
    tableKey: tableDef.tableKey,
    tableVertexLabel: tableDef.tableVertexLabel,
    part: "formConfig",
    name: tableDef.name + " form config schema",
    config: tableDef.formConfigConfig || buildTableSchemaPartConfig("formConfig", tableDef.formConfig)
  },
  {
    key: tableDef.schemaKeys.sidebar,
    tableKey: tableDef.tableKey,
    tableVertexLabel: tableDef.tableVertexLabel,
    part: "sidebar",
    name: tableDef.name + " sidebar schema",
    config: buildTableSchemaPartConfig("sidebar", tableDef.sidebar)
  }
]);

