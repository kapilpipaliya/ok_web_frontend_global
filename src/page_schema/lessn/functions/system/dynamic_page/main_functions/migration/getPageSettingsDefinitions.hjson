// Columns + formConfig keep valueAccessor / onUploadSuccess as real functions (not JSON).
const fileTableColumnsConfig = `return {
  part: "columns",
  columns: [
    {
      key: "preview",
      label: "Preview",
      dataType: "text",
      renderer: "imagePreview",
      width: "150px",
      sortable: false,
      valueAccessor: (row) => {
        const fileName = row.P?.fileName != null ? String(row.P.fileName).trim() : "";
        if (fileName === "") return null;
        const mime = String(row.P?.mimeType || row.P?.fileType || "");
        if (mime && !mime.startsWith("image/")) return null;
        return "/api/file/download/" + encodeURIComponent(fileName);
      }
    },
    {
      key: "fileName",
      label: "Name",
      dataType: "text",
      renderer: "text",
      width: "240px",
      valueAccessor: (row) => row.P?.fileName || "",
      overflowEllipsis: true
    },
    {
      key: "fileSize",
      label: "Size (bytes)",
      dataType: "text",
      renderer: "text",
      width: "110px",
      valueAccessor: (row) => (row.P?.fileSize != null ? String(row.P.fileSize) : "")
    },
    {
      key: "fileType",
      label: "Type",
      dataType: "text",
      renderer: "text",
      width: "140px",
      valueAccessor: (row) => row.P?.mimeType || row.P?.fileType || ""
    },
    { key: "uploadDate", label: "Uploaded", dataType: "date", renderer: "date", width: "130px" },
    {
      key: "description",
      label: "Description",
      dataType: "text",
      renderer: "text",
      width: "220px",
      valueAccessor: (row) => row.P?.description,
      overflowEllipsis: true
    }
  ]
};`;

const fileTableFormConfigConfig = `return {
  part: "formConfig",
  gridColumns: 1,
  groups: [
    {
      key: "basic",
      title: "File",
      gridColumns: 2,
      fields: [
        {
          key: "__fileUpload",
          dataType: "file",
          renderer: "graphFileUpload",
          required: true,
          colSpan: 2,
          tooltip: "Choose one or more files to upload. They are stored under the selected sidebar folder key path (or dated directory if uncategorized), linked to your user (UserFile). Then set description and save.",
          visible: "ctx.mode === 'create'",
          uploadConfiguration: {
            accept: "*/*",
            uploadUrl: "/api/file/upload",
            uploadInitUrl: "/api/file/upload/init",
            uploadChunkUrl: "/api/file/upload/chunk",
            uploadCompleteUrl: "/api/file/upload/complete",
            uploadAbortUrl: "/api/file/upload/abort",
            chunkThresholdBytes: 5242880,
            chunkSizeBytes: 4194304,
            multiple: true,
            maxFiles: 100,
            hidePreview: false,
            enableDragDrop: true,
            fullWidth: true,
            previewMinHeight: "8rem",
            previewMaxItemWidth: "10rem",
            previewMaxItemHeight: "10rem",
            previewObjectFit: "contain",
            fileDownloadUrlPrefix: "/api/file/download",
            pickButtonLabel: "Choose files to upload",
            onUploadSuccess: async (hook) => {
              if (!hook.isLastFile) return;
              hook.callbacks.assignFormVertex?.(hook.uploadedId);
              hook.syncFormFields?.(hook.uploadedId);
              if ((hook.fileCount || 1) === 1) hook.syncPreview(hook.uploadedId);
              hook.showSuccess(
                hook.fileCount > 1 ? (hook.fileCount + " files uploaded") : undefined
              );
            }
          }
        },
        {
          key: "fileName",
          label: "File name",
          dataType: "text",
          renderer: "text",
          required: true,
          maxLength: 512,
          colSpan: 2,
          tooltip: "Display name for the file.",
          disabled: "ctx.mode === 'edit'"
        },
        {
          key: "description",
          label: "Description",
          dataType: "text",
          renderer: "textArea",
          required: false,
          maxLength: 4000,
          colSpan: 2
        },
        {
          key: "fileSize",
          label: "Size (bytes)",
          dataType: "text",
          renderer: "text",
          disabled: true,
          colSpan: 1
        },
        {
          key: "fileType",
          label: "MIME type",
          dataType: "text",
          renderer: "text",
          disabled: true,
          colSpan: 1
        },
        {
          key: "uploadDate",
          label: "Upload date",
          dataType: "text",
          renderer: "text",
          disabled: true,
          colSpan: 2
        }
      ]
    }
  ]
};`;

function buildTableSchemaPartConfig(part, body) {
  const payload = { part, ...(body && typeof body === "object" ? body : {}) };
  return `return ${JSON.stringify(payload, null, 2)};`;
}

