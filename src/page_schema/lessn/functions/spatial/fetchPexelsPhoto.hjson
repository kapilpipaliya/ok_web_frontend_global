{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: fetchPexelsPhoto
        description: Fetches one curated Pexels photo for spatial room wall art (requires PEXELS_API_KEY).
        body:
          '''
const query = String(c?.query || "modern office").trim();
const apiKey = process.env.PEXELS_API_KEY || process.env.PEXELS_KEY;

const fallback = {
  success: true,
  data: {
    photoUrl:
      "https://images.pexels.com/photos/37347/office-freelancer-computer-business-37347.jpeg?auto=compress&cs=tinysrgb&w=1600",
    photographer: "Pixabay",
    photoUrlPage: "https://www.pexels.com/photo/computer-desk-desk-laptop-37347/",
    source: "fallback"
  }
};

if (!apiKey) {
  return fallback;
}

try {
  const url =
    "https://api.pexels.com/v1/search?query=" +
    encodeURIComponent(query) +
    "&per_page=1&orientation=landscape";
  const res = await fetch(url, {
    headers: { Authorization: apiKey }
  });
  if (!res.ok) {
    return fallback;
  }
  const json = await res.json();
  const photo = json?.photos?.[0];
  if (!photo?.src?.large2x && !photo?.src?.large) {
    return fallback;
  }
  return {
    success: true,
    data: {
      photoUrl: photo.src.large2x || photo.src.large,
      photographer: photo.photographer || "Pexels contributor",
      photoUrlPage: photo.url || "https://www.pexels.com/",
      source: "pexels"
    }
  };
} catch (error) {
  console.error("fetchPexelsPhoto:", error);
  return fallback;
}
'''
      }
    }
  ]
  edges: []
}
