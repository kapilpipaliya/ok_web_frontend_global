{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        isNoPermissionCheck: true
        fns: return { enabled: () => true }
        key: ThemeToggle
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  background: none;
  color: inherit;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.25rem;
  transition: opacity 0.2s ease;

  &:hover {
    opacity: 0.7;
  }

  &:active {
    opacity: 0.5;
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const currentMode = _.currentMode();
const isDarkMode = currentMode === 'dark';
return {
  as: "button",
  onClick: () => {
    _.toggleTheme()
  },
  title: isDarkMode ? "Switch to light mode" : "Switch to dark mode"
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''const currentMode = _.currentMode();
const isDarkMode = currentMode === "dark";
return {
  as: "icon",
  icon: isDarkMode ? "carbon:sun" : "carbon:moon",
  width: 36,
  height: 36,
};'''
      }
    }
  ]
  edges: [
    {
      id: e1
      T: Attr
      S: "1"
      E: "2"
    }
    {
      id: e2
      T: Attr
      S: "2"
      E: "3"
    }
  ]
}