{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        dynamicComponent: SettingsEditorShell, SettingsSectionNav, IconButton, Button, Html
        description: Floating admin panel to edit current page settings while viewing the live page.
        fns:
          '''
const DEFAULT_PANEL_WIDTH = 440;
const MIN_PANEL_WIDTH = 360;
const MAX_PANEL_WIDTH = 960;
const SCHEMA_PANEL_MIN_WIDTH = 560;
const PANEL_WIDTH_STORAGE_KEY = "fulchand-settings-panel-width";

const loadStoredPanelWidth = () => {
  if (typeof window === "undefined") return DEFAULT_PANEL_WIDTH;
  try {
    const stored = Number(window.localStorage.getItem(PANEL_WIDTH_STORAGE_KEY));
    if (Number.isFinite(stored) && stored >= MIN_PANEL_WIDTH && stored <= MAX_PANEL_WIDTH) {
      return stored;
    }
  } catch (_) {}
  return DEFAULT_PANEL_WIDTH;
};

const persistPanelWidth = (width) => {
  try {
    window.localStorage.setItem(PANEL_WIDTH_STORAGE_KEY, String(width));
  } catch (_) {}
};

const getMaxPanelWidth = () => {
  if (typeof window === "undefined") return MAX_PANEL_WIDTH;
  return Math.min(MAX_PANEL_WIDTH, Math.floor(window.innerWidth * 0.92));
};

const checkAdminRole = () => {
  const userRoles = _.user?.OUT?.UserRole || [];
  return userRoles.some((edgeId) => {
    const edge = g.edges[edgeId];
    const role = g.vertexes[edge?.E];
    return role?.P?.key === "Admin";
  });
};

const isLangCode = (value) =>
  value != null && /^[a-z]{2,3}$/i.test(String(value).trim());

const getPagePathWithoutLang = () => {
  const parts = String(_.location?.pathname || "").split("/").filter(Boolean);
  if (parts.length > 0 && isLangCode(parts[0])) {
    return parts.length > 1 ? "/" + parts.slice(1).join("/") : "/";
  }
  return _.location?.pathname || "/";
};

const normalizePath = (path) => {
  const raw = String(path || "/").trim() || "/";
  if (raw === "/") return "/";
  return raw.replace(/\/+$/, "") || "/";
};

const getSettingsPageId = () => {
  const fromProps = c.props?.settingsPageId;
  if (fromProps != null && String(fromProps).trim() !== "") {
    return String(fromProps).trim();
  }

  const pathname = normalizePath(getPagePathWithoutLang());
  let bestMatch = null;
  let bestLen = Infinity;

  for (const vertexId in g.vertexes) {
    const vertex = g.vertexes[vertexId];
    if (!vertex?.L?.includes("Page")) continue;
    const settingsPageId = vertex.P?.settingsPageId;
    if (settingsPageId == null || String(settingsPageId).trim() === "") continue;
    const pageUrl = normalizePath(vertex.P?.url || "/");
    if (pageUrl !== pathname) continue;
    if (pageUrl.length < bestLen) {
      bestLen = pageUrl.length;
      bestMatch = String(settingsPageId).trim();
    }
  }

  return bestMatch;
};

const isOnSettingsRoute = () => {
  const pathname = _.location?.pathname || "";
  return pathname === "/settings" || pathname.startsWith("/settings/");
};

const [isPanelOpen, setIsPanelOpen] = _.createSignal(false);
const [panelWidth, setPanelWidth] = _.createSignal(loadStoredPanelWidth());
const [isResizingPanel, setIsResizingPanel] = _.createSignal(false);
const [editorMode, setEditorMode] = _.createSignal("content");
const [sectionNav, setSectionNav] = _.createSignal([]);
const [activeSectionId, setActiveSectionId] = _.createSignal(null);
const [siteLanguages, setSiteLanguages] = _.createSignal([]);
let siteLanguagesLoadPromise = null;

const DEFAULT_SITE_LANGUAGES = [
  { code: "en", label: "English", isDefault: true },
  { code: "hi", label: "Hindi", isDefault: false },
  { code: "gu", label: "Gujarati", isDefault: false }
];

const loadSiteLanguages = async () => {
  const existing = siteLanguages();
  if (Array.isArray(existing) && existing.length > 0) return existing;
  if (siteLanguagesLoadPromise) return siteLanguagesLoadPromise;

  siteLanguagesLoadPromise = (async () => {
    try {
      const result = await executeYTOFunction("getSiteLanguages", {});
      const languages = result?.result?.data?.languages || [];
      const resolved = languages.length > 0 ? languages : DEFAULT_SITE_LANGUAGES;
      setSiteLanguages(resolved);
      return resolved;
    } catch (error) {
      console.error("PageSettingsEditor loadSiteLanguages:", error);
      setSiteLanguages(DEFAULT_SITE_LANGUAGES);
      return DEFAULT_SITE_LANGUAGES;
    } finally {
      siteLanguagesLoadPromise = null;
    }
  })();

  return siteLanguagesLoadPromise;
};

const executeYTOFunction = (functionName, contextData) =>
  s({
    functionName,
    contextData: contextData || {}
  });

const loadSectionNav = async () => {
  const settingsPageId = getSettingsPageId();
  if (!settingsPageId) {
    setSectionNav([]);
    return;
  }

  try {
    const result = await executeYTOFunction("getSettingsPageConfig", {
      settingsPageId,
      allowPublicRead: true
    });
    const setting = result?.result?.data?.setting;
    if (!setting?.P?.config) {
      setSectionNav([]);
      return;
    }
    const configFn = new Function(setting.P.config);
    const pageConfig = configFn();
    const sections = Array.isArray(pageConfig?.sections) ? pageConfig.sections : [];
    setSectionNav(sections.map((section) => ({
      id: section.id,
      title: section.title || section.id
    })));
    if (sections.length > 0 && !activeSectionId()) {
      setActiveSectionId(sections[0].id);
    }
  } catch (error) {
    console.error("Failed to load settings section nav:", error);
    setSectionNav([]);
  }
};

const refreshPagePreview = () => {
  const path = _.location?.pathname || "/";
  const search = _.location?.search || "";
  _.navigate(path + search, { replace: true });
};

const togglePanel = async () => {
  const nextOpen = !isPanelOpen();
  setIsPanelOpen(nextOpen);
  if (nextOpen) {
    setEditorMode("content");
    await loadSectionNav();
  }
};

const closePanel = () => {
  setIsPanelOpen(false);
  setEditorMode("content");
};

const switchEditorMode = (mode) => {
  setEditorMode(mode);
  if (mode === "schema") {
    const minWidth = Math.min(getMaxPanelWidth(), SCHEMA_PANEL_MIN_WIDTH);
    if (panelWidth() < minWidth) {
      setPanelWidth(minWidth);
      persistPanelWidth(minWidth);
    }
  }
};

const scrollToSection = (sectionId) => {
  if (!sectionId) return;
  setActiveSectionId(sectionId);
  const panel = document.querySelector("[data-fulchand-settings-panel]");
  const target = panel?.querySelector(`[data-section-id="${sectionId}"]`);
  if (target && typeof target.scrollIntoView === "function") {
    target.scrollIntoView({ behavior: "smooth", block: "start" });
  }
};

const onSettingsSaved = () => {
  refreshPagePreview();
};

const onSchemaSaved = () => {
  void loadSectionNav();
  refreshPagePreview();
};

const syncBodyPanelClass = () => {
  const open = isPanelOpen();
  const width = panelWidth();
  document.body.style.setProperty("--fulchand-settings-panel-width", `${width}px`);
  if (open) {
    document.body.classList.add("fulchand-settings-panel-open");
  } else {
    document.body.classList.remove("fulchand-settings-panel-open");
  }
};

const startPanelResize = (event) => {
  event.preventDefault();
  event.stopPropagation();
  setIsResizingPanel(true);
  const startX = event.clientX;
  const startWidth = panelWidth();

  const handleMouseMove = (moveEvent) => {
    const delta = startX - moveEvent.clientX;
    const next = Math.max(MIN_PANEL_WIDTH, Math.min(getMaxPanelWidth(), startWidth + delta));
    setPanelWidth(next);
  };

  const handleMouseUp = () => {
    setIsResizingPanel(false);
    persistPanelWidth(panelWidth());
    document.body.classList.remove("fulchand-settings-panel-resizing");
    document.removeEventListener("mousemove", handleMouseMove);
    document.removeEventListener("mouseup", handleMouseUp);
  };

  document.body.classList.add("fulchand-settings-panel-resizing");
  document.addEventListener("mousemove", handleMouseMove);
  document.addEventListener("mouseup", handleMouseUp);
};

const handleDocumentKeydown = (event) => {
  if (event.key === "Escape" && isPanelOpen()) {
    closePanel();
  }
};

const onEditorMount = async () => {
  await loadSiteLanguages();
  document.addEventListener("keydown", handleDocumentKeydown);
  window.addEventListener("fulchand-settings-saved", onSettingsSaved);
  return () => {
    document.removeEventListener("keydown", handleDocumentKeydown);
    window.removeEventListener("fulchand-settings-saved", onSettingsSaved);
    document.body.classList.remove("fulchand-settings-panel-open");
    document.body.style.removeProperty("--fulchand-settings-panel-width");
  };
};

_.createEffect(() => {
  panelWidth();
  isPanelOpen();
  syncBodyPanelClass();
});

return {
  DEFAULT_PANEL_WIDTH,
  MIN_PANEL_WIDTH,
  MAX_PANEL_WIDTH,
  panelWidth,
  isResizingPanel,
  startPanelResize,
  checkAdminRole,
  getSettingsPageId,
  isOnSettingsRoute,
  isPanelOpen,
  editorMode,
  setEditorMode,
  switchEditorMode,
  sectionNav,
  activeSectionId,
  executeYTOFunction,
  togglePanel,
  closePanel,
  scrollToSection,
  refreshPagePreview,
  onSettingsSaved,
  onSchemaSaved,
  siteLanguages,
  loadSiteLanguages,
  onEditorMount
};
'''
