        description: Shared layout with header, page content slot, and footer for Fulchand Shastri pages
        fns:
          '''
const prefersReducedMotion = () =>
  window.matchMedia("(prefers-reduced-motion: reduce)").matches;

const revealElement = (el) => {
  if (!el) return;
  el.style.opacity = "1";
  el.style.transform = "";
};

const isInViewport = (el) => {
  const rect = el.getBoundingClientRect();
  const vh = window.innerHeight || document.documentElement.clientHeight;
  const vw = window.innerWidth || document.documentElement.clientWidth;
  return rect.bottom > 0 && rect.right > 0 && rect.top < vh && rect.left < vw;
};

const applyInitialState = (el, state) => {
  if (state.opacity) {
    el.style.opacity = "0";
  }
  const parts = [];
  if (state.x) parts.push(`translateX(${state.x}px)`);
  if (state.y) parts.push(`translateY(${state.y}px)`);
  if (state.scale !== 1) parts.push(`scale(${state.scale})`);
  if (state.rotate) parts.push(`rotate(${state.rotate}deg)`);
  if (parts.length) {
    el.style.transform = parts.join(" ");
  }
};

const animateOnView = (el, options = {}) => {
  if (!el || el.dataset.motionInit) return;

  const {
    opacity = true,
    x = 0,
    y = 24,
    scale = 1,
    rotate = 0,
    duration = 0.55,
    delay = 0,
    easing = "easeOut",
    amount = 0.01,
    margin = "0px"
  } = options;

  if (prefersReducedMotion()) {
    el.dataset.motionInit = "true";
    revealElement(el);
    return;
  }

  applyInitialState(el, { opacity, x, y, scale, rotate });
  el.dataset.motionInit = "true";

  // Always reveal if inView never fires (Android Chrome / IO quirks)
  const safetyTimer = setTimeout(() => revealElement(el), 2500);

  const keyframes = {};

  if (opacity) {
    keyframes.opacity = [0, 1];
  }

  if (x) {
    keyframes.x = [x, 0];
  }

  if (y) {
    keyframes.y = [y, 0];
  }

  if (scale !== 1) {
    keyframes.scale = [scale, 1];
  }

  if (rotate) {
    keyframes.rotate = [rotate, 0];
  }

  if (Object.keys(keyframes).length === 0) {
    clearTimeout(safetyTimer);
    revealElement(el);
    return;
  }

  let ran = false;
  const runAnimation = () => {
    if (ran) return;
    ran = true;
    clearTimeout(safetyTimer);
    _.motion.animate(el, keyframes, {
      duration,
      delay,
      easing
    });
  };

  _.motion.inView(el, runAnimation, { amount, margin });

  // Elements already on-screen often miss inView on Android Chrome
  requestAnimationFrame(() => {
    if (isInViewport(el)) {
      setTimeout(runAnimation, 50);
    }
  });
};

return {
  animateOnView,
  executeYTOFunction: (functionName, contextData) =>
    s({
      functionName,
      contextData: contextData || {}
    })
};
'''
