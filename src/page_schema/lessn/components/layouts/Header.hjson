        displayOrder: 1
        componentName: Menu
        props:
          '''const getCurrentLang = () => {
  const lang = _.params?.lang;
  if (lang && /^[a-z]{2,3}$/i.test(String(lang)))
    return String(lang).toLowerCase();
  return "en";
};

const localizeHref = (path) => {
  if (
    !path ||
    path.startsWith("http") ||
    path.startsWith("mailto:") ||
    path === "#"
  )
    return path;
  const lang = getCurrentLang();
  if (path === "/") return `/${lang}`;
  const normalized = path.startsWith("/") ? path : `/${path}`;
  return `/${lang}${normalized}`;
};

const localizeItem = (item) => ({
  ...item,
  href: localizeHref(item.href),
  baseHref: item.href,
  children: Array.isArray(item.children)
    ? item.children.map((child) => localizeItem(child))
    : Array.isArray(item.submenu)
      ? item.submenu.map((child) => localizeItem(child))
      : undefined,
});

const categoryToMenuItem = (category) => {
  if (!category) return null;
  const key =
    category.key != null && String(category.key).trim() !== ""
      ? String(category.key).trim()
      : "";
  const childNodes = Array.isArray(category.children)
    ? category.children.map((child) => categoryToMenuItem(child)).filter(Boolean)
    : [];
  return {
    id: category.id || key || category.name,
    text: category.name || key || "Category",
    href: key ? `/products/${encodeURIComponent(key)}` : "/products",
    children: childNodes.length > 0 ? childNodes : undefined
  };
};

const productCategoryChildren = (c.productNav?.categories || [])
  .map((category) => categoryToMenuItem(category))
  .filter(Boolean);

const items = [
  { id: "home", text: "Home", href: "/" },
  {
    id: "products",
    text: "Products",
    href: "/products",
    children:
      productCategoryChildren.length > 0 ? productCategoryChildren : undefined
  },
  { id: "about", text: "About Us", href: "/about" },
  { id: "contact", text: "Contact", href: "/contact" }
];

return {
  items: items.map((item) => localizeItem(item)),
  panelBackground: "#f5e6d3",
  hoverBackground: "rgba(0, 0, 0, 0.1)",
  activeBorderColor: "#3a2317",
};'''
      }
