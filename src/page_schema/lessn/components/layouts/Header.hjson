}

html.header-compact ._id {
  padding: 0.15rem 1rem;
}`;'''
        displayOrder: 1
        fns:
          '''let compact = false;
let ticking = false;
const COMPACT_ON = 80;
const EXPAND_ON = 16;

const applyCompact = (scrollY) => {
  const next = compact ? scrollY > EXPAND_ON : scrollY > COMPACT_ON;
  if (next === compact) return;
  compact = next;
  document.documentElement.classList.toggle("header-compact", next);
};

const onScroll = () => {
  if (ticking) return;
  ticking = true;
  requestAnimationFrame(() => {
    ticking = false;
    applyCompact(window.scrollY);
  });
};

const bindScroll = () => {
  applyCompact(window.scrollY);
  window.addEventListener("scroll", onScroll, { passive: true });
};

const unbindScroll = () => {
  window.removeEventListener("scroll", onScroll);
  document.documentElement.classList.remove("header-compact");
  compact = false;
  ticking = false;
};

return {
  bindScroll,
  unbindScroll
};
'''
        componentName: Html
        serverFunction:
          '''
try {
  const result = await s({
    functionName: "getProductCategories",
    contextData: {
      tableKey: "products",
      tableVertexLabel: "Product"
    }
  });
  if (!result?.result?.success) {
    console.warn(
      "getProductCategories failed:",
      result?.result?.message || result?.error
    );
    return { categories: [] };
  }
  const categories = result.result.data?.categories;
  return {
    categories: Array.isArray(categories) ? categories : []
  };
} catch (error) {
  console.error("Error loading product categories for nav:", error);
  return { categories: [] };
}
'''
        props:
