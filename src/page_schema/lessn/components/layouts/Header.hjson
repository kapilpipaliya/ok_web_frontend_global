        displayOrder: 2
        fns:
          '''const [musicPlaying, setMusicPlaying] = _.createSignal(false);
const [audioRef, setAudioRef] = _.createSignal(null);

return {
  musicPlaying,
  setMusicPlaying,
  audioRef,
  setAudioRef,
};'''
        componentName: Html
        props:
          '''return {
  as: "button",
  onClick: async () => {
    const audioElement = f.audioRef();

    if (audioElement) {
      try {
        if (f.musicPlaying()) {
          audioElement.pause();
        } else {
          const playPromise = audioElement.play();
          if (playPromise !== undefined) {
            await playPromise;
          }
        }
      } catch (error) {
        console.error("Audio playback error:", error);
        _.showErrorToast(
          "Unable to play audio. Please check your browser settings.",
        );
      }
    }
  },
};'''
      }
    }
