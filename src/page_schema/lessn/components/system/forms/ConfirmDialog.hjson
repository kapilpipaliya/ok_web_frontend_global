      }
    }
    {
      id: "8"
      L: Attr
      P: {
        css:
          '''return `._id {
  color: ${t.var.color.text};
  font-size: 1rem;
  line-height: 1.6;
  margin: 0;
  white-space: pre-line;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const p = f.getProps();
return {
  as: "p",
  text: p.message || "Are you sure you want to proceed?"
};'''
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  gap: ${t.var.spacing.md};
  padding: ${t.var.spacing.md} ${t.var.spacing.xl} ${t.var.spacing.xl};
  justify-content: flex-end;
}

@media (max-width: 768px) {
  ._id {
    flex-direction: column-reverse;
    gap: ${t.var.spacing.sm};
  }
}`;'''
        displayOrder: 3
        componentName: Html
        props:
          '''return {
  as: "footer"
};'''
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Button
        props:
          '''const p = f.getProps();
const cancelText = p.cancelText || "Cancel";
const onCancel = p.onCancel;
const loading = p.loading || false;

return {
  text: cancelText,
  variant: "secondary",
  disabled: loading,
  onClick: () => {
    if (onCancel && !loading) onCancel();
  }
};'''
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Button
        props:
          '''const p = f.getProps();
const confirmText = p.confirmText || "Confirm";
const onConfirm = p.onConfirm;
const loading = p.loading || false;
const variant = p.variant || "danger";
const buttonVariant =
  variant === "primary" ? "primary" : variant === "warning" ? "primary" : "danger";

return {
  text: loading ? "Please wait..." : confirmText,
  variant: buttonVariant,
  loading: loading,
  disabled: loading,
  onClick: async () => {
    if (onConfirm && !loading) await onConfirm();
  }
};'''
      }
    }
