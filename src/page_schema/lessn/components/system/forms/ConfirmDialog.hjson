{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''
const getProps = () => c.props || {};

return {
  getProps,
  handleClose: () => getProps().onCancel?.()
};
'''
        key: ConfirmDialog
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: ContentModal
        props:
          '''const p = f.getProps();
return {
  isOpen: p.isOpen === true,
  title: p.title || "Confirm Action",
  maxWidth: "400px",
  showTitle: false,
  zIndex: 9999,
  onClose: f.handleClose
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        slotName: children
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  min-height: 0;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''return `._id {
  padding: ${t.var.spacing.xl} ${t.var.spacing.xl} ${t.var.spacing.md};
  border-bottom: 1px solid ${t.var.color.border};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "header"
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''const p = f.getProps();
const variant = p.variant || "danger";

const iconConfig = {
  danger: t.var.color.error,
  warning: t.var.color.warning,
  primary: t.var.color.primary
};

const iconColor = iconConfig[variant] || iconConfig.danger;

return `._id {
  color: ${iconColor};
  margin-bottom: ${t.var.spacing.sm};
  display: block;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const p = f.getProps();
const variant = p.variant || "danger";

const iconConfig = {
  danger: {
    icon: "carbon:warning-filled",
    color: t.var.color.error
  },
  warning: {
    icon: "carbon:warning-alt-filled",
    color: t.var.color.warning
  },
  primary: {
    icon: "carbon:help-filled",
    color: t.var.color.primary
  }
};

const config = iconConfig[variant] || iconConfig.danger;

return {
  as: "icon",
  icon: config.icon,
  width: 24,
  height: 24
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 1.25rem;
  font-weight: 600;
  color: ${t.var.color.text};
  margin: 0;
  line-height: 1.4;
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const p = f.getProps();
return {
  as: "h2",
  text: p.title || "Confirm Action"
};'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''return `._id {
