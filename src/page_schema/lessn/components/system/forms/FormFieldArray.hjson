}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const itemIndex = c.fieldArrayItem;
return {
  as: "div",
  text: f.getItemLabel(itemIndex),
  class: "fm-field-array-item-title"
};'''
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Button
        props:
          '''const itemIndex = c.fieldArrayItem;
return {
  variant: "danger",
  size: "sm",
  text: "Remove",
  type: "button",
  disabled: f.isDisabled(),
  onClick: () => f.removeItem(itemIndex)
};'''
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        contextName: fieldArrayField
        css:
          '''return `._id.fm-field-array-field {
  display: flex;
  flex-direction: column;
  gap: ${t.var.spacing.xs};
  width: 100%;
}`;'''
        loop: true
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "div",
  class: "fm-field-array-field",
  data: f.getItemFields()
};'''
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        css:
          '''return `._id.fm-field-array-field-label {
  font-size: 0.875rem;
  font-weight: 500;
  color: ${t.var.color.text};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const itemField = c.fieldArrayField || {};
return {
  as: "label",
  text: itemField.label || itemField.key || "Field",
  class: "fm-field-array-field-label"
};'''
      }
    }
    {
      id: "12"
      L: Attr
      P: {
        displayOrder: 2
        componentName: FormLocalizedText
        props:
          '''const itemField = c.fieldArrayField || {};
const itemIndex = c.fieldArrayItem;
const isTranslatable = f.isItemFieldTranslatable?.(itemField);
const isTextArea = itemField.renderer === "textArea";
const hide = !isTranslatable;
const value = f.getItemFieldValue(f.getItemAt(itemIndex), itemField);
return {
  hide,
  languages: f.getSiteLanguages?.(),
  value: typeof value === "object" && value != null ? value : {},
  multiline: isTextArea,
  onChange: (nextValue) => f.updateItemField(itemIndex, itemField.key, nextValue),
  required: itemField.required === true,
  disabled: f.isDisabled()
};'''
      }
    }
    {
      id: "13"
      L: Attr
      P: {
        displayOrder: 2
        componentName: TextArea
        props:
          '''const itemField = c.fieldArrayField || {};
const itemIndex = c.fieldArrayItem;
const hide = itemField.renderer !== "textArea" || f.isItemFieldTranslatable?.(itemField);
const value = f.getItemFieldValue(f.getItemAt(itemIndex), itemField);
return {
  hide,
  value: typeof value === "string" ? value : "",
  onChange: (e) => f.updateItemField(itemIndex, itemField.key, e.target.value),
  placeholder: itemField.placeholder || "",
  required: itemField.required === true,
  disabled: f.isDisabled()
};'''
      }
    }
    {
      id: "14"
      L: Attr
      P: {
        displayOrder: 3
        componentName: TextInput
        props:
          '''const itemField = c.fieldArrayField || {};
const itemIndex = c.fieldArrayItem;
const hide = f.isSpecialItemFieldRenderer?.(itemField) === true;
const value = f.getItemFieldValue(f.getItemAt(itemIndex), itemField);
return {
  hide,
  value: typeof value === "string" ? value : "",
  onChange: (e) => f.updateItemField(itemIndex, itemField.key, e.target.value),
  placeholder: itemField.placeholder || "",
  required: itemField.required === true,
  disabled: f.isDisabled(),
  type: itemField.dataType === "number" ? "number" : "text"
};'''
      }
    }
    {
      id: "16"
      L: Attr
      P: {
        displayOrder: 2
        componentName: FormFieldArray
        props:
          '''const itemField = c.fieldArrayField || {};
const itemIndex = c.fieldArrayItem;
const value = f.getItemFieldValue(f.getItemAt(itemIndex), itemField);
return {
  hide: itemField.renderer !== "fieldArray" || !itemField.fieldArrayConfig,
  field: f.buildNestedFieldArrayField?.(itemField) || itemField,
  value: Array.isArray(value) ? value : [],
  disabled: f.isDisabled(),
  siteLanguages: f.getSiteLanguages?.(),
  onChange: (nextItems) => f.updateItemField(itemIndex, itemField.key, nextItems)
};'''
      }
    }
    {
      id: "17"
      L: Attr
      P: {
        displayOrder: 2
        componentName: VertexPicker
        props:
          '''const itemField = c.fieldArrayField || {};
const itemIndex = c.fieldArrayItem;
const pickerProps = f.getVertexPickerProps?.(itemIndex, itemField);
return {
  hide: itemField.renderer !== "embeddedVertexPicker" || !pickerProps,
  ...(pickerProps || {})
};'''
      }
    }
    {
      id: "15"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Button
