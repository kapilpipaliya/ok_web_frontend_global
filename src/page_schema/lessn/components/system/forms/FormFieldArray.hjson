{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        dynamicComponent: TextInput, TextArea, Button, FormLocalizedText, FormFieldArray, VertexPicker
        key: FormFieldArray
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id.fm-field-array {
  display: flex;
  flex-direction: column;
  gap: ${t.var.spacing.md};
  width: 100%;
}`;'''
        displayOrder: 1
        fns:
          '''const getProps = () => c.props || {};
const getField = () => getProps().field || {};
const getConfig = () => getField().fieldArrayConfig || {};

const getItemFields = () => {
  const itemFields = getConfig().itemFields;
  return Array.isArray(itemFields) ? itemFields : [];
};

const parseItems = (value) => {
  if (Array.isArray(value)) return value.map((item) => ({ ...(item || {}) }));
  if (typeof value === "string" && value.trim() !== "") {
    try {
      const parsed = JSON.parse(value);
      return Array.isArray(parsed) ? parsed.map((item) => ({ ...(item || {}) })) : [];
    } catch {
      return [];
    }
  }
  return [];
};

const getItems = () => parseItems(getProps().value);

const commitItems = (items) => {
  getProps().onChange?.(items);
};

const buildDefaultItem = () => {
  const item = {};
  const itemFields = getItemFields();
  const siblingAxes = getProps().getSiblingFieldValue?.("optionAxes");
  for (let fieldIndex = 0; fieldIndex < itemFields.length; fieldIndex++) {
    const itemField = itemFields[fieldIndex];
    if (!itemField?.key) continue;
    if (itemField.defaultValue !== undefined) {
      item[itemField.key] = itemField.defaultValue;
    } else if (itemField.renderer === "fieldArray") {
      if (
        itemField.key === "options" &&
        Array.isArray(siblingAxes) &&
        siblingAxes.length > 0
      ) {
        item[itemField.key] = siblingAxes
          .filter((axis) => axis?.key)
          .map((axis) => ({
            key: String(axis.key).trim(),
            value: ""
          }));
      } else if (Array.isArray(itemField.fieldArrayConfig?.defaultItems)) {
        item[itemField.key] = itemField.fieldArrayConfig.defaultItems.map((row) => ({
          ...(row || {})
        }));
      } else {
        item[itemField.key] = [];
      }
    } else if (itemField.renderer === "embeddedVertexPicker") {
      item[itemField.key] =
        itemField.pickerConfiguration?.selectionMode === "multiple" ? [] : "";
    } else if (itemField.dataType === "boolean" || itemField.renderer === "checkbox") {
      item[itemField.key] = false;
    } else if (itemField.translatable === true) {
      item[itemField.key] = {};
    } else {
      item[itemField.key] = "";
    }
  }
  return item;
};

const updateItemField = (itemIndex, fieldKey, fieldValue) => {
  const items = getItems();
  if (!items[itemIndex]) return;
  const nextItems = items.map((item, index) =>
    index === itemIndex ? { ...item, [fieldKey]: fieldValue } : item
  );
  commitItems(nextItems);
};

const addItem = () => {
  const config = getConfig();
  const items = getItems();
  if (config.maxItems != null && items.length >= Number(config.maxItems)) return;
  commitItems([...items, buildDefaultItem()]);
};

const removeItem = (itemIndex) => {
  const config = getConfig();
  const items = getItems();
  if (config.minItems != null && items.length <= Number(config.minItems)) return;
  commitItems(items.filter((_, index) => index !== itemIndex));
};

const reorderItems = (fromIndex, toIndex) => {
  const items = getItems();
  if (fromIndex === toIndex || fromIndex < 0 || toIndex < 0) return;
  if (fromIndex >= items.length || toIndex >= items.length) return;
  const nextItems = [...items];
  const [moved] = nextItems.splice(fromIndex, 1);
  nextItems.splice(toIndex, 0, moved);
  commitItems(nextItems);
};

const fieldArrayDraggableCleanups = new Map();
const [draggedItemIndex, setDraggedItemIndex] = _.createSignal(null);
const [dragOverItemIndex, setDragOverItemIndex] = _.createSignal(null);

const initFieldArrayDraggable = (element, itemIndex) => {
  if (!element || !_.draggable || f.isDisabled?.()) return;

  const existingCleanup = fieldArrayDraggableCleanups.get(element);
  if (existingCleanup) existingCleanup();

  const cleanup = _.draggable({
    element,
    getInitialData: () => ({
      type: "field-array-item",
      index: itemIndex
    }),
    onDragStart: () => setDraggedItemIndex(itemIndex),
    onDrop: () => {
      setDraggedItemIndex(null);
      setDragOverItemIndex(null);
    }
  });

  fieldArrayDraggableCleanups.set(element, cleanup);
};

const initFieldArrayDropTarget = (element, itemIndex) => {
  if (!element || !_.dropTargetForElements || f.isDisabled?.()) return null;

  return _.dropTargetForElements({
    element,
    canDrop: ({ source }) => source.data?.type === "field-array-item",
    onDragEnter: ({ source }) => {
      if (typeof source.data?.index === "number") {
        setDragOverItemIndex(itemIndex);
      }
    },
    onDragLeave: () => setDragOverItemIndex(null),
    onDrop: ({ source }) => {
      const fromIndex = source.data?.index;
      if (typeof fromIndex === "number") {
        reorderItems(fromIndex, itemIndex);
      }
      setDraggedItemIndex(null);
      setDragOverItemIndex(null);
    }
  });
};

const cleanupFieldArrayDraggable = (element) => {
  const cleanup = fieldArrayDraggableCleanups.get(element);
  if (cleanup) {
    cleanup();
    fieldArrayDraggableCleanups.delete(element);
  }
};

const isItemDragging = (itemIndex) => draggedItemIndex() === itemIndex;
const isItemDragOver = (itemIndex) => dragOverItemIndex() === itemIndex;

// Use stable numeric indices for loop data so Solid <For> does not remount rows on each keystroke.
const getItemIndices = () => {
  const items = getItems();
  const indices = [];
  for (let index = 0; index < items.length; index++) {
    indices.push(index);
  }
  return indices;
};

const getItemAt = (itemIndex) => getItems()[itemIndex] || {};

const getItemLabel = (itemIndex) =>
  `${getConfig().itemLabel || "Item"} ${itemIndex + 1}`;

const getItemFieldValue = (item, itemField) => {
  if (!itemField?.key) return "";
  const value = item?.[itemField.key];
  if (value == null) {
    if (itemField.renderer === "fieldArray") return [];
    if (itemField.renderer === "embeddedVertexPicker") {
      return itemField.pickerConfiguration?.selectionMode === "multiple" ? [] : "";
    }
    return itemField.translatable === true ? {} : "";
  }
  return value;
};

const isItemFieldTranslatable = (itemField) => itemField?.translatable === true;

const isSpecialItemFieldRenderer = (itemField) => {
  const renderer = itemField?.renderer;
  return (
    renderer === "textArea" ||
    renderer === "fieldArray" ||
    renderer === "embeddedVertexPicker" ||
    renderer === "checkbox" ||
    itemField?.translatable === true
  );
};

const buildNestedFieldArrayField = (itemField) => ({
  key: itemField.key,
  label: itemField.label || itemField.key,
  renderer: "fieldArray",
  dataType: "array",
  fieldArrayConfig: itemField.fieldArrayConfig || {}
});

const getVertexPickerProps = (itemIndex, itemField) => {
  const pickerConfiguration =
    itemField?.pickerConfiguration != null && typeof itemField.pickerConfiguration === "object"
      ? { ...itemField.pickerConfiguration }
      : null;
  if (!pickerConfiguration) return null;
  if (pickerConfiguration.usePolarisUI === undefined) {
    pickerConfiguration.usePolarisUI = true;
  }
  const value = getItemFieldValue(getItemAt(itemIndex), itemField);
  const selectionMode =
    pickerConfiguration.selectionMode === "multiple" ? "multiple" : "single";
  const selectedElementId =
    selectionMode === "single" && value != null && String(value).trim() !== ""
      ? String(value).trim()
      : "";
  const selectedValues =
    selectionMode === "multiple" && Array.isArray(value)
      ? value.map((id) => String(id)).filter((id) => id.trim() !== "")
      : selectionMode === "multiple" && value != null && String(value).trim() !== ""
        ? [String(value).trim()]
        : [];
  const previewFileNamePropertyKey =
    pickerConfiguration.previewFileNameProperty != null
      ? String(pickerConfiguration.previewFileNameProperty)
      : "fileName";
  const fileDownloadUrlPrefix =
    pickerConfiguration.fileDownloadUrlPrefix != null
      ? String(pickerConfiguration.fileDownloadUrlPrefix).trim()
      : "";
  const selectedVertex =
    selectedElementId && g.vertexes[selectedElementId]
      ? g.vertexes[selectedElementId]
      : null;
  let previewUrl = "";
  if (fileDownloadUrlPrefix !== "" && selectedVertex?.P?.[previewFileNamePropertyKey] != null) {
    const previewFileName = String(selectedVertex.P[previewFileNamePropertyKey]).trim();
    if (previewFileName !== "") {
      previewUrl = `${fileDownloadUrlPrefix}/${encodeURIComponent(previewFileName)}`;
    }
  }
  let secondaryLabel = "";
  if (selectionMode === "multiple" && selectedValues.length > 0) {
    secondaryLabel = `${selectedValues.length} file(s) selected`;
  } else if (pickerConfiguration.buildSecondaryLabelFromVertex === true && selectedVertex) {
    const label = selectedVertex.P?.[previewFileNamePropertyKey];
    if (label != null && String(label).trim() !== "") {
      secondaryLabel = String(label).trim();
    }
  }
  return {
    value: selectionMode === "single" ? selectedElementId : "",
    values: selectionMode === "multiple" ? selectedValues : undefined,
    secondaryLabel,
    previewUrl,
    showImagePreview: pickerConfiguration.showImagePreview === true && previewUrl !== "",
    disabled: isDisabled(),
    pickerConfiguration,
    onSelect: (vertexElementId, selectedVertexPayload) => {
      updateItemField(itemIndex, itemField.key, vertexElementId);
      if (selectedVertexPayload && !g.vertexes[vertexElementId]) {
        _.setGraphData(0, { vertexes: { [vertexElementId]: selectedVertexPayload } }, {});
      }
    },
    onSelectMultiple: (vertexElementIds, selectedVertexPayloads) => {
      updateItemField(itemIndex, itemField.key, vertexElementIds);
      if (Array.isArray(selectedVertexPayloads)) {
        const vertexMap = {};
        for (const selectedVertexPayload of selectedVertexPayloads) {
          if (selectedVertexPayload?.id && !g.vertexes[selectedVertexPayload.id]) {
            vertexMap[selectedVertexPayload.id] = selectedVertexPayload;
          }
        }
        if (Object.keys(vertexMap).length > 0) {
          _.setGraphData(0, { vertexes: vertexMap }, {});
        }
      }
    },
    onClear: () =>
      updateItemField(
        itemIndex,
        itemField.key,
        selectionMode === "multiple" ? [] : ""
      )
  };
};

const DEFAULT_SITE_LANGUAGES = [
  { code: "en", label: "English", isDefault: true },
  { code: "hi", label: "Hindi", isDefault: false },
  { code: "gu", label: "Gujarati", isDefault: false }
];

const getSiteLanguages = () => {
  const languages = getProps().siteLanguages;
  if (Array.isArray(languages) && languages.length > 0) return languages;
  return DEFAULT_SITE_LANGUAGES;
};

const isDisabled = () => getProps().disabled === true;

const ensureMinItems = () => {
  if (isDisabled()) return;
  const config = getConfig();
  const minItems = Number(config.minItems);
  if (!Number.isFinite(minItems) || minItems < 1) return;
  const items = getItems();
  if (items.length >= minItems) return;
  const seeded = [];
  if (Array.isArray(config.defaultItems) && config.defaultItems.length > 0) {
    for (let i = 0; i < config.defaultItems.length && seeded.length < minItems; i++) {
      seeded.push({ ...buildDefaultItem(), ...(config.defaultItems[i] || {}) });
    }
  }
  while (seeded.length < minItems) {
    seeded.push(buildDefaultItem());
  }
  commitItems([...items, ...seeded.slice(0, minItems - items.length)]);
};

return {
  getField,
  getConfig,
  getItemFields,
  getItemIndices,
  getItemAt,
  getItemLabel,
  addItem,
  removeItem,
  reorderItems,
  updateItemField,
  getItemFieldValue,
  isItemFieldTranslatable,
  getSiteLanguages,
  isDisabled,
  ensureMinItems,
  isSpecialItemFieldRenderer,
  buildNestedFieldArrayField,
  getVertexPickerProps,
  initFieldArrayDraggable,
  initFieldArrayDropTarget,
  cleanupFieldArrayDraggable,
  isItemDragging,
  isItemDragOver
};'''
        componentName: Html
        props:
          '''return {
  as: "div",
  class: "fm-field-array",
  onMount: () => f.ensureMinItems?.()
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        contextName: fieldArrayItem
        loop: true
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  data: f.getItemIndices()
};'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''const itemIndex = c.fieldArrayItem;
const dragOver = f.isItemDragOver?.(itemIndex);
const dragging = f.isItemDragging?.(itemIndex);
return `._id.fm-field-array-item {
  display: flex;
  flex-direction: column;
  gap: ${t.var.spacing.sm};
  padding: ${t.var.spacing.md};
  border: 1px solid ${dragOver ? t.var.color.primary : t.var.color.border};
  border-radius: 0.5rem;
  background: ${t.var.color.background_light_50};
  ${dragging ? "opacity: 0.55;" : ""}
  ${dragOver ? `outline: 2px dashed ${t.var.color.primary};` : ""}
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const itemIndex = c.fieldArrayItem;
return {
  as: "div",
  class: "fm-field-array-item",
  ref: (element) => {
    if (element && f.initFieldArrayDropTarget) {
      const dropCleanup = f.initFieldArrayDropTarget(element, itemIndex);
      element.__fmFieldArrayDropCleanup = dropCleanup;
    } else if (element?.__fmFieldArrayDropCleanup) {
      element.__fmFieldArrayDropCleanup();
      element.__fmFieldArrayDropCleanup = null;
    }
  }
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id.fm-field-array-item-header {
  display: flex;
  align-items: flex-start;
  gap: ${t.var.spacing.sm};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  class: "fm-field-array-item-header"
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          '''return `._id.fm-field-array-drag-handle {
  flex-shrink: 0;
  color: ${t.var.color.text_light_500};
  cursor: grab;
}`;'''
        displayOrder: 0
        componentName: Html
        props:
          '''const itemIndex = c.fieldArrayItem;
return {
  as: "icon",
  icon: "ph:dots-six-vertical",
  height: 16,
  width: 16,
  class: "fm-field-array-drag-handle",
  hide: f.isDisabled?.(),
  ref: (element) => {
    const index = c.fieldArrayItem;
    if (element && f.initFieldArrayDraggable) {
      f.initFieldArrayDraggable(element, index);
    } else if (element === null && f.cleanupFieldArrayDraggable) {
      f.cleanupFieldArrayDraggable(element);
    }
  }
};'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''return `._id.fm-field-array-item-header-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: ${t.var.spacing.sm};
  flex: 1;
  min-width: 0;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  class: "fm-field-array-item-header-main"
};'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        css:
          '''return `._id.fm-field-array-item-title {
