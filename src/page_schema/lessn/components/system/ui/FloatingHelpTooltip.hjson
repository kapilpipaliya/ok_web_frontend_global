    {
      id: "12"
      L: Attr
      P: {
        css:
          '''const helpListItem = c.helpListItem;
const showsRequirementStatus =
  helpListItem?.met != null || helpListItem?.hasInput === true;
const isRequirementMet = Boolean(helpListItem?.met);
const statusIconColor = !showsRequirementStatus
  ? t.var.color.text
  : isRequirementMet
    ? t.var.color.success
    : t.var.color.error;
return `._id {
  flex-shrink: 0;
  color: ${statusIconColor};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const helpListItem = c.helpListItem;
const showsRequirementStatus =
  helpListItem?.met != null || helpListItem?.hasInput === true;
const isRequirementMet = Boolean(helpListItem?.met);
const statusIconName = !showsRequirementStatus
  ? "ph:circle"
  : isRequirementMet
    ? "ph:check-circle-fill"
    : "ph:x-circle-fill";
return {
  as: "icon",
  icon: statusIconName,
  width: 18,
  height: 18
};'''
      }
    }
