{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: FloatingHelpTooltip
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  position: relative;
  display: inline-flex;
  align-items: center;
  vertical-align: middle;
  flex-shrink: 0;
}`;'''
        displayOrder: 1
        fns:
          '''const [isOpen, setIsOpen] = _.createSignal(false);
const [triggerRef, setTriggerRef] = _.createSignal(null);
const [floatingRef, setFloatingRef] = _.createSignal(null);
let disposePositionUpdater = null;
let closeDelayTimeoutId = null;

const getPlacement = () => c.props?.placement || "top";

const getHelpText = () => {
  const rawHelpText = c.props?.text;
  if (typeof rawHelpText === "string") {
    return rawHelpText.replace(/\\n/g, "\n");
  }
  return rawHelpText == null ? "" : String(rawHelpText);
};

const getListRows = () => {
  const componentProps = c.props || {};
  const rowsSource =
    componentProps.rows ?? componentProps.items ?? componentProps.policyRows;
  if (typeof rowsSource === "function") {
    const resolvedRows = rowsSource();
    return Array.isArray(resolvedRows) ? resolvedRows : [];
  }
  if (Array.isArray(rowsSource)) return rowsSource;
  return [];
};

const getListTitle = () => {
  const componentProps = c.props || {};
  const rawTitle =
    componentProps.title ??
    componentProps.listTitle ??
    componentProps.policyTitle ??
    "";
  return typeof rawTitle === "string" ? rawTitle.trim() : "";
};

const hasHelpContent = () => {
  const helpText = getHelpText();
  const hasHelpText =
    typeof helpText === "string" ? helpText.trim() !== "" : Boolean(helpText);
  return hasHelpText || getListRows().length > 0;
};

const clearCloseDelay = () => {
  if (closeDelayTimeoutId != null) {
    clearTimeout(closeDelayTimeoutId);
    closeDelayTimeoutId = null;
  }
};

const tearDownFloating = () => {
  clearCloseDelay();
  if (disposePositionUpdater) {
    disposePositionUpdater();
    disposePositionUpdater = null;
  }
};

const setupFloatingUI = async () => {
  const triggerElement = triggerRef();
  const floatingElement = floatingRef();
  if (!triggerElement || !floatingElement || !_.floatingUI) return;

  try {
    const { computePosition, flip, shift, offset, autoUpdate } = _.floatingUI;

    const updatePosition = async () => {
      const { x: leftPx, y: topPx } = await computePosition(
        triggerElement,
        floatingElement,
        {
          placement: getPlacement(),
          strategy: "fixed",
          middleware: [
            offset(6),
            flip(),
            shift({ padding: 8 })
          ]
        }
      );
      Object.assign(floatingElement.style, {
        left: String(leftPx) + "px",
        top: String(topPx) + "px"
      });
    };

    if (disposePositionUpdater) {
      disposePositionUpdater();
      disposePositionUpdater = null;
    }

    await updatePosition();

    disposePositionUpdater = autoUpdate(
      triggerElement,
      floatingElement,
      updatePosition,
      {
        ancestorScroll: true,
        ancestorResize: true,
        elementResize: true,
        layoutShift: true,
        animationFrame: false
      }
    );
  } catch (error) {
    console.error("FloatingHelpTooltip:", error);
  }
};

const openTooltip = () => {
  clearCloseDelay();
  setIsOpen(true);
  requestAnimationFrame(() => setupFloatingUI());
};

const scheduleClose = () => {
  clearCloseDelay();
  closeDelayTimeoutId = window.setTimeout(() => {
    setIsOpen(false);
    tearDownFloating();
    closeDelayTimeoutId = null;
  }, 100);
};

return {
  isOpen,
  setTriggerRef,
  setFloatingRef,
  openTooltip,
  scheduleClose,
  clearHideTimer: clearCloseDelay,
  tearDownFloating,
  getHelpText,
  getListRows,
  getListTitle,
  hasHelpContent
};'''
        componentName: Html
        props:
          '''const componentProps = c.props || {};
return {
  as: "span",
  hide: componentProps.hide === true || !f.hasHelpContent?.(),
  onCleanup: () => {
    f.tearDownFloating();
  }
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.125rem;
  min-width: 1.375rem;
  min-height: 1.375rem;
  margin-left: 0.25rem;
  border: none;
  background: transparent;
  border-radius: ${t.var.borderRadius.sm};
  cursor: help;
  font-size: 0.75rem;
  line-height: 1;
  padding: 0.125rem;
  flex-shrink: 0;
  box-sizing: content-box;
}

._id:hover {
  background: ${t.var.color.background_light_200};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const componentProps = c.props || {};
const fieldLabel = componentProps.fieldLabel || "";
return {
  as: "span",
  ref: f.setTriggerRef,
  onMouseEnter: () => f.openTooltip(),
  onMouseLeave: () => f.scheduleClose(),
  hide: !f.hasHelpContent?.(),
  "aria-label": fieldLabel || "Help"
};'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''const componentProps = c.props || {};
const triggerTintProp = componentProps.triggerTint;
const iconColor =
  typeof triggerTintProp === "function"
    ? triggerTintProp()
    : t.var.color.text_light_500;
return `._id {
  flex-shrink: 0;
  color: ${iconColor};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const componentProps = c.props || {};
const triggerIconProp = componentProps.triggerIcon;
if (
  triggerIconProp === undefined ||
  triggerIconProp === null ||
  triggerIconProp === ""
) {
  return {
    as: "icon",
    icon: "ph:question",
    width: 20,
    height: 20,
    hide: true
  };
}
const resolvedTriggerIcon =
  typeof triggerIconProp === "function" ? triggerIconProp() : triggerIconProp;
const iconName = String(resolvedTriggerIcon || "").trim() || "ph:question";
return {
  as: "icon",
  icon: iconName,
  width: 20,
  height: 20,
  hide: false
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''const componentProps = c.props || {};
const triggerIconProp = componentProps.triggerIcon;
if (
  triggerIconProp === undefined ||
  triggerIconProp === null ||
  triggerIconProp === ""
) {
  return {
    as: "span",
    text: "\u24D8",
    hide: false
  };
}
const resolvedTriggerIcon =
  typeof triggerIconProp === "function" ? triggerIconProp() : triggerIconProp;
const hasCustomTriggerIcon = Boolean(String(resolvedTriggerIcon || "").trim());
return {
  as: "span",
  text: "\u24D8",
  hide: hasCustomTriggerIcon
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "portal"
};'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''return `._id {
  position: fixed;
  z-index: 1100;
  max-width: min(18.75rem, calc(100vw - 1rem));
  padding: 12px;
  background: ${t.var.color.background};
  color: ${t.var.color.text};
  border: 1px solid ${t.var.color.border};
  border-radius: 4px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  font-size: 14px;
  font-weight: 400;
  line-height: 1.45;
  pointer-events: auto;
  animation: fm-help-fade 0.12s ease-out;
  display: flex;
  flex-direction: column;
  gap: 0;
  white-space: normal;
}

@keyframes fm-help-fade {
  from { opacity: 0; transform: translateY(2px); }
  to { opacity: 1; transform: translateY(0); }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  ref: f.setFloatingRef,
  role: "tooltip",
  hide: !f.isOpen(),
  onMouseEnter: () => f.clearHideTimer(),
  onMouseLeave: () => f.scheduleClose()
};'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        css:
          '''return `._id {
