return `._id {
  position: fixed;
  inset: 0;
  z-index: ${zIndex};
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  animation: contentModalFadeIn 0.2s ease;
}

@keyframes contentModalFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@media (max-width: 768px) {
  ._id {
    padding: 0;
    align-items: flex-end;
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  hide: c.props?.isOpen !== true,
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      // Defer close — same as Escape (avoid unmount during the click handler)
      window.setTimeout(() => c.props?.onClose?.(), 0);
    }
  }
};'''
