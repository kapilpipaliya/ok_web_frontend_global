    max-width: 100%;
    max-height: 100vh;
    height: 100vh;
    border-radius: 0;
  }
}`;'''
        displayOrder: 1
        fns:
          '''
let trap = null;
let cancelFocusTrapTimer = null;
let stopEscapeClose = null;
let unpushEscapeHandler = null;

const deactivateTrap = (returnFocus) => {
  if (!trap) return;
  try {
    trap.deactivate({ returnFocus: returnFocus !== false });
  } catch (_) {
    try {
      trap.deactivate({ returnFocus: false });
    } catch (_) {
      /* iframe may already be gone */
    }
  }
  trap = null;
};

const initializeFocusTrap = () => {
  const element = _.ref();
  if (!element) return;

  deactivateTrap(false);

  trap = _.focusTrap.createFocusTrap(element, {
    fallbackFocus: () => element,
    escapeDeactivates: false,
    allowOutsideClick: true,
    returnFocusOnDeactivate: true,
    initialFocus: c.props?.initialFocus === false ? false : undefined
  });

  try {
    trap.activate();
  } catch (_) {
    trap = null;
  }
};

const scheduleFocusTrap = () => {
  cancelFocusTrapTimer?.();
  cancelFocusTrapTimer = _.makeTimer(
    () => {
      cancelFocusTrapTimer = null;
      initializeFocusTrap();
    },
    200,
    setTimeout
  );
};

const cleanupFocusTrap = () => {
  cancelFocusTrapTimer?.();
  cancelFocusTrapTimer = null;
  // Blur iframe so focus-trap can restore focus to the opener on the parent page.
  try {
    if (document.activeElement?.tagName === "IFRAME") {
      document.activeElement.blur();
    }
  } catch (_) {
    /* ignore */
  }
  deactivateTrap(true);
};

const requestClose = () => {
  c.props?.onClose?.();
};

const getEscapeStack = () => {
  if (!window.__contentModalEscapeStack) {
    window.__contentModalEscapeStack = [];
  }
  return window.__contentModalEscapeStack;
};

const unbindEscapeClose = () => {
  if (typeof stopEscapeClose === "function") {
    stopEscapeClose();
  }
  stopEscapeClose = null;
  if (typeof unpushEscapeHandler === "function") {
    unpushEscapeHandler();
  }
  unpushEscapeHandler = null;
};

const bindEscapeClose = () => {
  unbindEscapeClose();
  const closeHandler = () => requestClose();
  const stack = getEscapeStack();
  stack.push(closeHandler);
  unpushEscapeHandler = () => {
    const idx = stack.lastIndexOf(closeHandler);
    if (idx >= 0) stack.splice(idx, 1);
  };
  stopEscapeClose = _.tinykeys(
    window,
    {
      Escape: (event) => {
        if (stack[stack.length - 1] !== closeHandler) return;
        event.preventDefault();
        // Defer close so we do not unmount / unsubscribe while tinykeys is still
        // dispatching this keydown (that was crashing the parent page).
        window.setTimeout(() => {
          closeHandler();
        }, 0);
      }
    },
    { ignore: () => false }
  );
};

const notifyClosed = () => {
  const onClosed = c.props?.onClosed;
  if (typeof onClosed === "function") {
    onClosed();
  }
};

return {
  scheduleFocusTrap,
  cleanupFocusTrap,
  bindEscapeClose,
  unbindEscapeClose,
  notifyClosed
};
'''
        componentName: Html
        props:
          '''return {
  as: "div",
  tabindex: -1,
  role: "dialog",
  "aria-modal": true,
  onClick: (e) => e.stopPropagation(),
  onMount: () => {
    f.bindEscapeClose?.();
    f.scheduleFocusTrap?.();
  },
  onCleanup: () => {
    f.unbindEscapeClose?.();
    f.cleanupFocusTrap?.();
    f.notifyClosed?.();
  }
};'''
      }
