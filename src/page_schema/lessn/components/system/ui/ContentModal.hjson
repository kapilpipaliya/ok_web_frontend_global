      L: Attr
      P: {
        css:
          '''const maxWidth = c.props?.maxWidth || "880px";
return `._id {
  background: ${t.var.color.background};
  border-radius: 0.75rem;
  width: 100%;
  max-width: ${maxWidth};
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.12);
  animation: contentModalSlideUp 0.28s ease;
  overflow: hidden;
}

@keyframes contentModalSlideUp {
  from {
    opacity: 0;
    transform: translateY(16px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-width: 768px) {
