{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        description: Embla carousel with overlay prev/next on slides, dots below, and children slot for slides
        key: Carousel
        updatedAt: 2026-07-11T11:45:05.128Z
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  width: 100%;
}`;'''
        displayOrder: 1
        fns:
          '''// https://www.embla-carousel.com/docs/get-started/solid
// Embla root = viewport; it reads root.children[0] as the container.
// Bind only after the container mounts (see container onMount), otherwise
// visiting the page can init Embla while viewport still has no children.
const carouselOptions = {
  loop: c.props?.loop === true,
  align: c.props?.align || "center",
  ...(c.props?.options || {})
};
const [emblaRef, emblaApi] = _.useCarousel(() => carouselOptions);

const [prevBtnDisabled, setPrevBtnDisabled] = _.createSignal(true);
const [nextBtnDisabled, setNextBtnDisabled] = _.createSignal(true);
const [selectedIndex, setSelectedIndex] = _.createSignal(0);
const [scrollSnaps, setScrollSnaps] = _.createSignal([]);

const onPrevButtonClick = () => {
  const api = emblaApi();
  if (!api) return;
  api.scrollPrev();
};

const onNextButtonClick = () => {
  const api = emblaApi();
  if (!api) return;
  api.scrollNext();
};

const onDotButtonClick = (index) => {
  const api = emblaApi();
  if (!api) return;
  api.scrollTo(index);
};

const onInit = (api) => {
  setScrollSnaps(api.scrollSnapList());
};

const onSelect = (api) => {
  setPrevBtnDisabled(!api.canScrollPrev());
  setNextBtnDisabled(!api.canScrollNext());
  const idx = api.selectedScrollSnap();
  setSelectedIndex(idx);
  const onChange = c.props?.onActiveIndexChange;
  if (typeof onChange === "function") onChange(idx);
};

_.createEffect(() => {
  const api = emblaApi();
  const targetIndex = c.props?.activeIndex;
  if (!api || typeof targetIndex !== "number" || targetIndex < 0) return;
  if (api.selectedScrollSnap() !== targetIndex) {
    api.scrollTo(targetIndex);
  }
});

_.createEffect(
  _.on(emblaApi, (api) => {
    if (!api) return;

    onInit(api);
    onSelect(api);
    api
      .on("reInit", onInit)
      .on("reInit", onSelect)
      .on("select", onSelect)
      .on("slidesChanged", onInit);

    _.onCleanup(() => {
      api
        .off("reInit", onInit)
        .off("reInit", onSelect)
        .off("select", onSelect)
        .off("slidesChanged", onInit);
    });
  })
);

return {
  emblaRef,
  emblaApi,
  prevBtnDisabled,
  nextBtnDisabled,
  selectedIndex,
  scrollSnaps,
  onPrevButtonClick,
  onNextButtonClick,
  onDotButtonClick,
  slideSize: () => c.props?.slideSize || "100%",
  slideSpacing: () => c.props?.slideSpacing || "0",
  showArrows: () => c.props?.showArrows !== false,
  showDots: () => c.props?.showDots !== false
};'''
        componentName: Html
        props:
          '''return {
  as: "div",
  class: c.props.class
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  position: relative;
  width: 100%;
  max-height: min(380px, 45vh);
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div"
};'''
      }
    }
    {
      id: "4"
      L: Attr
