        css:
          '''return `._id {
  overflow: hidden;
  width: 100%;
  max-height: min(380px, 45vh);
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div"
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''const slideSize = f.slideSize();
const slideSpacing = f.slideSpacing();
const hasSpacing = slideSpacing && slideSpacing !== "0" && slideSpacing !== "0rem";

return `._id {
  display: flex;
  touch-action: pan-y pinch-zoom;
  ${hasSpacing ? `margin-left: calc(${slideSpacing} * -1);` : ""}
}

._id > * {
  flex: 0 0 ${slideSize};
  min-width: 0;
  ${hasSpacing ? `padding-left: ${slideSpacing};` : ""}
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const data = c.props?.data;
const contextName = c.props?.contextName || "slide";
const hasData = Array.isArray(data);

return {
  as: "div",
  ...(hasData
    ? {
        data,
        contextName,
        loop: true
      }
    : {}),
  // Embla reads viewport.children[0]; defer until after hydrate paints the node.
  onMount: () => {
    const container = _.ref();
    const viewport = container?.parentElement;
    if (!viewport) return () => {};
    const bind = f.emblaRef;
    let cancelled = false;
    let outer = 0;
    let inner = 0;
    outer = requestAnimationFrame(() => {
      inner = requestAnimationFrame(() => {
        if (!cancelled) bind(viewport);
      });
    });
    return () => {
      cancelled = true;
      cancelAnimationFrame(outer);
      cancelAnimationFrame(inner);
      bind(undefined);
    };
  }
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Slot
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''return `._id {
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  data: [
    {
      side: "prev",
      icon: "carbon:chevron-left",
      ariaLabel: "Previous slide",
      onClick: f.onPrevButtonClick,
      disabled: f.prevBtnDisabled
    },
    {
      side: "next",
      icon: "carbon:chevron-right",
      ariaLabel: "Next slide",
      onClick: f.onNextButtonClick,
      disabled: f.nextBtnDisabled
    }
  ],
  contextName: "control",
  loop: true,
  hide: !f.showArrows()
};'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        css:
          '''const side = c.control?.side || "prev";
const inset = side === "prev" ? "left: 0.75rem;" : "right: 0.75rem;";
const insetMobile = side === "prev" ? "left: 0.5rem;" : "right: 0.5rem;";

return `._id {
  appearance: none;
  position: absolute;
  top: 50%;
  ${inset}
  transform: translateY(-50%);
  z-index: 3;
  background: color-mix(in oklch, ${t.var.color.background} 88%, transparent);
  touch-action: manipulation;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  padding: 0;
  margin: 0;
  border: 1px solid ${t.var.color.border};
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 9999px;
  color: ${t.var.color.text};
  pointer-events: auto;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
  transition: background 150ms ease, border-color 150ms ease, color 150ms ease, opacity 150ms ease;

  &:hover:not(:disabled) {
    background: ${t.var.color.primary_light_100};
    border-color: ${t.var.color.primary_light_400};
    color: ${t.var.color.primary};
  }

  &:focus-visible {
    outline: 2px solid ${t.var.color.primary};
    outline-offset: 2px;
  }

  &:disabled {
    opacity: 0.35;
    cursor: default;
  }

  @media (max-width: 640px) {
    ${insetMobile}
    width: 2.25rem;
    height: 2.25rem;
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const control = c.control;
const disabled =
  typeof control.disabled === "function" ? control.disabled() : control.disabled;

return {
  as: "button",
  type: "button",
  disabled,
  onClick: control.onClick,
  "aria-label": control.ariaLabel
};'''
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
