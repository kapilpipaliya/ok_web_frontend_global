};'''
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 0.35rem;
  margin-top: 1.25rem;
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "div",
  data: f.scrollSnaps().map((_, index) => index),
  contextName: "dotIndex",
  loop: true,
  hide: !f.showDots()
};'''
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        css:
          '''return `._id {
  appearance: none;
  background: ${t.var.color.border};
  touch-action: manipulation;
  display: flex;
  cursor: pointer;
  border: 0;
  padding: 0;
  margin: 0;
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 9999px;
  transition: background 150ms ease, transform 150ms ease, width 150ms ease;

  &:hover {
    background: ${t.var.color.text_light_400};
  }

  &:focus-visible {
    outline: 2px solid ${t.var.color.primary};
    outline-offset: 2px;
  }

  &.embla__dot--selected {
    background: ${t.var.color.primary};
    width: 1.25rem;
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const index = c.dotIndex;
const selected = f.selectedIndex() === index;

return {
  as: "button",
  type: "button",
  class: selected ? "embla__dot--selected" : undefined,
  onClick: () => f.onDotButtonClick(index),
  "aria-label": "Go to slide " + (index + 1),
  "aria-current": selected ? "true" : undefined
};'''
      }
    }
  ]
