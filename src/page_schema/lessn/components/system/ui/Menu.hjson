        props:
          '''const item = c.menuItem;
const id = f.getItemId(item);
const ctrl = f.getController();
return {
  as: "div",
  ref: ctrl.setMenuRef(id),
  "attr:role": "menu",
  "attr:aria-hidden": () => (ctrl.isOpen(id) ? "false" : "true"),
  onPointerMove: (e) => ctrl.onMenuPointerMove(e),
  onPointerEnter: (e) => {
    if (!e?.pointerType || e.pointerType === "mouse" || e.pointerType === "pen") {
      ctrl.keepOpen();
    }
  },
  onPointerLeave: (e) => {
    ctrl.stopAutoScroll();
    ctrl.onParentPointerLeave(e);
  }
};'''
