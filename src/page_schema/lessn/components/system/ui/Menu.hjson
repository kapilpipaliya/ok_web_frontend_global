        props:
          '''const item = c.menuItem;
const depth = f.getDepth();
const id = f.getItemId(item);
const hasChildren = f.getChildren(item).length > 0;
const layout = f.getLayout();
const ctrl = f.getController();
const href = item.href;
const hasHref = href && href !== "#";

if (hasChildren) {
  // Parent with a real href: render as link so click navigates (hover still opens submenu)
  if (hasHref) {
    return {
      as: "a",
      href,
      ref: ctrl.setTriggerRef(id),
      "attr:aria-expanded": () => ctrl.isOpen(id),
      "attr:aria-haspopup": "true",
      "attr:role": layout === "panel" ? "menuitem" : undefined,
      onPointerDown: (e) => ctrl.onParentPointerDown(e),
      onPointerEnter: (e) => ctrl.onParentPointerEnter(e, depth, id),
      onPointerMove: (e) => ctrl.onParentPointerMove(e, depth, id),
      onClick: (e) => {
        const navigated = ctrl.onParentClick(e, depth, id, {
          allowNavigate: true
        });
        if (navigated) f.onItemClick(item);
      }
    };
  }

  return {
    as: "button",
    type: "button",
    ref: ctrl.setTriggerRef(id),
    "attr:aria-expanded": () => ctrl.isOpen(id),
    "attr:aria-haspopup": "true",
    "attr:role": layout === "panel" ? "menuitem" : undefined,
    onPointerDown: (e) => ctrl.onParentPointerDown(e),
    onPointerEnter: (e) => ctrl.onParentPointerEnter(e, depth, id),
    onPointerMove: (e) => ctrl.onParentPointerMove(e, depth, id),
    onClick: (e) => ctrl.onParentClick(e, depth, id)
  };
}

if (hasHref) {
  return {
    as: "a",
    href,
    "attr:role": layout === "panel" ? "menuitem" : undefined,
    onClick: () => f.onItemClick(item),
    onPointerEnter: () => ctrl.keepOpen()
