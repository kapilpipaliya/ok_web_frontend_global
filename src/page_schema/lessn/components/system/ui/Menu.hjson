  align-items: center;
  justify-content: space-between;
  gap: 0.35rem;
  width: ${isBar ? "auto" : "100%"};
  box-sizing: border-box;
  padding: ${isBar ? "0.5rem 0.65rem" : "0.75rem 1.25rem"};
  min-height: ${isBar ? "auto" : "2.75rem"};
  color: ${color};
  text-decoration: none;
  font-weight: 500;
  font-size: ${isBar ? "0.95rem" : "inherit"};
  font-family: inherit;
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
