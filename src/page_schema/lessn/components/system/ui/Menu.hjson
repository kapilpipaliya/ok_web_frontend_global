{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        isNoPermissionCheck: true
        description: SSR-safe nested menu. All items render in HTML; Floating UI positions on open. Props: items[{id,text,href,children|submenu}], depth, layout, controller, placements, closeDelay, isActive, onItemClick, colors.
        fns:
          '''
const props = () => c.props || {};

const getDepth = () => Number(props().depth) || 0;
const getLayout = () =>
  props().layout || (getDepth() === 0 ? "bar" : "panel");
const getItems = () => {
  const items = props().items;
  return Array.isArray(items) ? items : [];
};
const getChildren = (item) => {
  if (!item) return [];
  if (Array.isArray(item.children) && item.children.length) return item.children;
  if (Array.isArray(item.submenu) && item.submenu.length) return item.submenu;
  return [];
};
const getItemId = (item) =>
  item?.id != null ? String(item.id) : String(item?.text || "");

const getRootPlacement = () => props().rootPlacement || "bottom-start";
const getSubmenuPlacement = () => props().submenuPlacement || "right-start";
const getCloseDelay = () => Number(props().closeDelay) || 250;

const getTriggerColor = () =>
  props().triggerColor || t.var.color.text;
const getPanelBackground = () =>
  props().panelBackground || t.var.color.background;
const getHoverBackground = () =>
  props().hoverBackground || "rgba(0, 0, 0, 0.08)";
const getActiveBorderColor = () =>
  props().activeBorderColor || getTriggerColor();

const getPagePath = () => {
  const parts = String(_.location?.pathname || "")
    .split("/")
    .filter(Boolean);
  if (parts.length > 0 && /^[a-z]{2,3}$/i.test(parts[0])) {
    return parts.length > 1 ? "/" + parts.slice(1).join("/") : "/";
  }
  return _.location?.pathname || "/";
};

const defaultIsActive = (item) => {
  if (!item) return false;
  const currentPath = getPagePath();
  const itemPath = item.baseHref || item.href;
  if (itemPath && itemPath !== "#" && currentPath === itemPath) return true;
  return getChildren(item).some((child) => defaultIsActive(child));
};

const isItemActive = (item) => {
  const custom = props().isActive;
  if (typeof custom === "function") return !!custom(item);
  return defaultIsActive(item);
};

const isMouseLikePointer = (pointerType) =>
  !pointerType || pointerType === "mouse" || pointerType === "pen";

const createController = () => {
  const [openPath, setOpenPath] = _.createSignal([]);
  const [scrollFlags, setScrollFlags] = _.createSignal({});
  const triggerRefs = new Map();
  const menuRefs = new Map();
  const scrollBodyRefs = new Map();
  const floatingCleanups = new Map();
  let closeTimer = null;
  let lastPointerType = "mouse";
  let autoScrollRaf = null;
  let autoScrollId = null;
  let pointerPos = { x: 0, y: 0 };
  // Pointer position frozen at last scroll — enters with same coords are scroll-induced
  let scrollPointerPos = { x: NaN, y: NaN };

  const setTriggerRef = (id) => (el) => {
    if (el) triggerRefs.set(id, el);
    else triggerRefs.delete(id);
  };

  const setMenuRef = (id) => (el) => {
    if (el) menuRefs.set(id, el);
    else menuRefs.delete(id);
  };

  const setScrollBodyRef = (id) => (el) => {
    if (el) scrollBodyRefs.set(id, el);
    else scrollBodyRefs.delete(id);
  };

  const getScrollFlags = (id) => scrollFlags()[id] || { up: false, down: false };
  const canScrollUp = (id) => !!getScrollFlags(id).up;
  const canScrollDown = (id) => !!getScrollFlags(id).down;

  const onMenuPointerMove = (event) => {
    if (event?.clientX == null) return;
    pointerPos = { x: event.clientX, y: event.clientY };
  };

  // Scroll moves items under a stationary cursor and fires pointerenter.
  // Lock opens to that cursor position until the mouse actually moves.
  const markMenuScrolling = (id) => {
    scrollPointerPos = { x: pointerPos.x, y: pointerPos.y };
    if (closeTimer) {
      clearTimeout(closeTimer);
      closeTimer = null;
    }
    const path = openPath();
    const idx = path.indexOf(id);
    if (idx >= 0 && path.length > idx + 1) {
      const prev = path;
      for (let i = idx + 1; i < prev.length; i++) stopFloating(prev[i]);
      setOpenPath(prev.slice(0, idx + 1));
    }
  };

  const isScrollInducedEnter = (event) => {
    // Hovering the auto-scroll icons: never open nested from item enters
    if (autoScrollId != null) return true;
    if (event?.clientX == null || Number.isNaN(scrollPointerPos.x)) return false;
    return (
      event.clientX === scrollPointerPos.x &&
      event.clientY === scrollPointerPos.y
    );
  };

  const updateScrollAffordances = (id) => {
    const body = scrollBodyRefs.get(id);
    if (!body) {
      setScrollFlags((prev) => {
        if (!prev[id]) return prev;
        const next = { ...prev };
        delete next[id];
        return next;
      });
      return;
    }
    // Subpixel + padding: treat near-edges as fully scrolled
    const EPS = 4;
    const maxScroll = body.scrollHeight - body.clientHeight;
    const up = maxScroll > EPS && body.scrollTop > EPS;
    const down =
      maxScroll > EPS &&
      body.scrollTop + body.clientHeight < body.scrollHeight - EPS;
    const prev = getScrollFlags(id);
    if (prev.up === up && prev.down === down) return;
    setScrollFlags((all) => ({ ...all, [id]: { up, down } }));
  };

  const onScrollBodyScroll = (id) => {
    markMenuScrolling(id);
    updateScrollAffordances(id);
  };

  const stopAutoScroll = () => {
    if (autoScrollRaf != null) {
      cancelAnimationFrame(autoScrollRaf);
      autoScrollRaf = null;
    }
    autoScrollId = null;
  };

  const startAutoScroll = (id, direction) => {
    stopAutoScroll();
    autoScrollId = id;
    markMenuScrolling(id);
    const step = () => {
      if (autoScrollId !== id) return;
      const body = scrollBodyRefs.get(id);
      if (!body) {
        stopAutoScroll();
        return;
      }
      const before = body.scrollTop;
      body.scrollTop = before + direction * 6;
      markMenuScrolling(id);
      updateScrollAffordances(id);
      if (body.scrollTop === before) {
        stopAutoScroll();
        return;
      }
      autoScrollRaf = requestAnimationFrame(step);
    };
    autoScrollRaf = requestAnimationFrame(step);
  };

  const isInsideMenus = (target) => {
    if (!target) return false;
    for (const el of triggerRefs.values()) {
      if (el.contains?.(target)) return true;
    }
    for (const el of menuRefs.values()) {
      if (el.contains?.(target)) return true;
    }
    return false;
  };

  const stopFloating = (id) => {
    if (autoScrollId === id) stopAutoScroll();
    const cleanup = floatingCleanups.get(id);
    if (cleanup) {
      cleanup();
      floatingCleanups.delete(id);
    }
    setScrollFlags((prev) => {
      if (!prev[id]) return prev;
      const next = { ...prev };
      delete next[id];
      return next;
    });
  };

  const setupFloating = async (id, placement, offsetPx) => {
    stopFloating(id);
    const trigger = triggerRefs.get(id);
    const menu = menuRefs.get(id);
    if (!trigger || !menu || !_.floatingUI) return;

    const { computePosition, flip, shift, offset, autoUpdate, size } =
      _.floatingUI;

    const middleware = [
      offset(offsetPx),
      flip({ fallbackAxisSideDirection: "start" }),
      shift({ padding: 8 }),
    ];
    if (typeof size === "function") {
      middleware.push(
        size({
          padding: 8,
          apply({ availableHeight, elements }) {
            const maxH = Math.max(120, availableHeight);
            const floating = elements.floating;
            Object.assign(floating.style, {
              maxHeight: `${maxH}px`,
              height: "",
              overflow: "hidden",
              display: "flex",
              flexDirection: "column",
            });
            requestAnimationFrame(() => {
              const body = scrollBodyRefs.get(id);
              if (body && body.scrollHeight > maxH - 4) {
                floating.style.height = `${maxH}px`;
              }
              updateScrollAffordances(id);
            });
          },
        }),
      );
    }

    const updatePosition = async () => {
      const { x, y } = await computePosition(trigger, menu, {
        placement,
        strategy: "fixed",
        middleware,
      });
      Object.assign(menu.style, {
        left: `${x}px`,
        top: `${y}px`,
      });
      updateScrollAffordances(id);
    };

    await updatePosition();
    floatingCleanups.set(
      id,
      autoUpdate(trigger, menu, updatePosition, {
        ancestorScroll: true,
        ancestorResize: true,
        elementResize: true,
        layoutShift: true,
      }),
    );
  };

  const clearCloseTimer = () => {
    if (closeTimer) {
      clearTimeout(closeTimer);
      closeTimer = null;
    }
  };

  const closeAll = () => {
    clearCloseTimer();
    stopAutoScroll();
    const path = openPath();
    for (const menuId of path) stopFloating(menuId);
    setOpenPath([]);
  };

  const closeFrom = (depth) => {
    clearCloseTimer();
    const prev = openPath();
    for (let i = depth; i < prev.length; i++) stopFloating(prev[i]);
    setOpenPath(prev.slice(0, depth));
  };

  const keepOpen = () => clearCloseTimer();

  const scheduleClose = () => {
    clearCloseTimer();
    closeTimer = setTimeout(() => closeAll(), getCloseDelay());
  };

  const openAt = (depth, id) => {
    keepOpen();
    const prev = openPath();
    const next = [...prev.slice(0, depth), id];
    for (let i = depth; i < prev.length; i++) {
      if (prev[i] && prev[i] !== next[i]) stopFloating(prev[i]);
    }
    setOpenPath(next);
    const placement =
      depth === 0 ? getRootPlacement() : getSubmenuPlacement();
    const offsetPx = depth === 0 ? 4 : 0;
    // Panels are always in the DOM (SSR); position after paint
    requestAnimationFrame(() => {
      void setupFloating(id, placement, offsetPx);
    });
  };

  const toggleAt = (depth, id) => {
    keepOpen();
    if (
      isOpen(id) &&
      openPath()[depth] === id &&
      openPath().length === depth + 1
    ) {
      closeFrom(depth);
      return;
    }
    openAt(depth, id);
  };

  const isOpen = (id) => openPath().includes(id);

  const onParentPointerEnter = (event, depth, id) => {
    if (event?.pointerType) lastPointerType = event.pointerType;
    if (!isMouseLikePointer(event?.pointerType)) return;
    // Ignore enters caused by items sliding under a stationary cursor
    if (isScrollInducedEnter(event)) {
      keepOpen();
      return;
    }
    scrollPointerPos = { x: NaN, y: NaN };
    openAt(depth, id);
  };

  // After scroll, the item under the cursor already got a silenced enter —
  // open it as soon as the mouse actually moves.
  const onParentPointerMove = (event, depth, id) => {
    onMenuPointerMove(event);
    if (event?.pointerType && !isMouseLikePointer(event.pointerType)) return;
    if (autoScrollId != null) return;
    if (Number.isNaN(scrollPointerPos.x)) return;
    if (
      event.clientX === scrollPointerPos.x &&
      event.clientY === scrollPointerPos.y
    ) {
      return;
    }
    scrollPointerPos = { x: NaN, y: NaN };
    openAt(depth, id);
  };

  const onParentPointerLeave = (event) => {
    if (event?.pointerType) lastPointerType = event.pointerType;
    if (!isMouseLikePointer(event?.pointerType)) return;
    scheduleClose();
  };

  const onParentPointerDown = (event) => {
    if (event?.pointerType) lastPointerType = event.pointerType;
  };

  const onParentClick = (event, depth, id, options = {}) => {
    const allowNavigate = options.allowNavigate === true;

    // Parent with href: mouse click navigates; touch opens submenu first if closed
    if (allowNavigate) {
      if (!isMouseLikePointer(lastPointerType) && !isOpen(id)) {
        event?.preventDefault?.();
        event?.stopPropagation?.();
        openAt(depth, id);
        return false;
      }
      // Let the browser follow the link; close open panels
      closeAll();
      return true;
    }

    event?.preventDefault?.();
    event?.stopPropagation?.();
    if (isMouseLikePointer(lastPointerType)) {
      if (!isOpen(id)) openAt(depth, id);
      return false;
    }
    toggleAt(depth, id);
    return false;
  };

  const onOutsidePointerDown = (event) => {
    if (openPath().length === 0) return;
    if (isInsideMenus(event.target)) return;
    closeAll();
  };

  const onDocumentKeyDown = (event) => {
    if (event.key === "Escape" && openPath().length > 0) {
      event.preventDefault();
      closeAll();
    }
  };

  const onMount = () => {
    document.addEventListener("pointerdown", onOutsidePointerDown, true);
    document.addEventListener("keydown", onDocumentKeyDown);
    return () => {
      document.removeEventListener("pointerdown", onOutsidePointerDown, true);
      document.removeEventListener("keydown", onDocumentKeyDown);
      clearCloseTimer();
      stopAutoScroll();
      for (const cleanup of floatingCleanups.values()) cleanup();
      floatingCleanups.clear();
    };
  };

  return {
    openPath,
    openAt,
    toggleAt,
    closeFrom,
    isOpen,
    keepOpen,
    scheduleClose,
    closeAll,
    setTriggerRef,
    setMenuRef,
    setScrollBodyRef,
    canScrollUp,
    canScrollDown,
    updateScrollAffordances,
    onScrollBodyScroll,
    onMenuPointerMove,
    startAutoScroll,
    stopAutoScroll,
    onParentPointerEnter,
    onParentPointerMove,
    onParentPointerLeave,
    onParentPointerDown,
    onParentClick,
    onMount,
  };
};

let localController = null;
const getController = () => {
  const fromProps = props().controller;
  if (fromProps) return fromProps;
  if (!localController) localController = createController();
  return localController;
};

const onItemClick = (item) => {
  getController().closeAll();
  const handler = props().onItemClick;
  if (typeof handler === "function") handler(item);
};

// Nested Menu ComponentFields mount depth-first. On the client that overflows
// the call stack during hydration (SSR/Node is fine). Keep ComponentField
// nesting; on client, delay each nested level's items by one microtask so
// the stack can unwind between levels. SSR still renders immediately.
const isServer = typeof window === "undefined";
const [itemsReady, setItemsReady] = _.createSignal(
  isServer || getDepth() === 0
);
if (!isServer && getDepth() > 0) {
  queueMicrotask(() => setItemsReady(true));
}

return {
  props,
  getDepth,
  getLayout,
  getItems,
  getChildren,
  getItemId,
  getTriggerColor,
  getPanelBackground,
  getHoverBackground,
  getActiveBorderColor,
  isItemActive,
  getController,
  onItemClick,
  isItemsReady: () => itemsReady(),
};
