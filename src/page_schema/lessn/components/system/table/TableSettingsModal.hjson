{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        description: Modal wrapper for TableSchemaEditorShell (table schema editor).
        fns:
          '''
const getProps = () => c.props || {};

return {
  getProps,
  handleClose: () => getProps().onClose?.()
};
'''
        key: TableSettingsModal
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: ContentModal
        props:
          '''const p = f.getProps();
return {
  isOpen: p.isOpen === true,
  title: p.title || "Table Settings",
  maxWidth: "1200px",
  showTitle: p.showTitle !== false,
  onClose: f.handleClose
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        slotName: children
        css:
          '''return `._id {
  flex: 1;
  min-height: 0;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  height: min(80vh, 820px);
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: TableSchemaEditorShell
        props:
          '''const p = f.getProps();
return {
  tableKey: p.tableKey,
  embeddedMode: true,
  isOpen: p.isOpen === true,
  onSaved: () => {
    if (typeof p.onSaved === "function") p.onSaved();
  }
};'''
      }
    }
  ]
  edges: [
    {
      id: e1
      T: Attr
      S: "1"
      E: "2"
    }
    {
      id: e2
      T: Attr
      S: "2"
      E: "3"
    }
    {
      id: e3
      T: Attr
      S: "3"
      E: "4"
    }
  ]
}
