{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''
const getProps = () => c.props || {};

const [formTxnId, setFormTxnId] = _.createSignal(0);

const cleanup = () => {
  const txnId = formTxnId();
  if (txnId && txnId > 0) {
    _.revertTransaction(txnId);
    setFormTxnId(0);
  }
};

const getModalTitle = () => {
  const p = getProps();
  const mode = p.mode || "add";
  const label = p.label;
  if (mode === "add") return label ? `Add New ${label}` : "Add New Item";
  if (mode === "view") return label ? `View ${label}` : "View Item";
  return label ? `Edit ${label}` : "Edit Item";
};

const handleClose = () => {
  cleanup();
  getProps().onClose?.();
};

return {
  getProps,
  formTxnId,
  setFormTxnId,
  cleanup,
  getModalTitle,
  handleClose
};
'''
        key: TableModal
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: ContentModal
        props:
          '''const p = f.getProps();
return {
  isOpen: p.isOpen === true,
  title: f.getModalTitle(),
  maxWidth: "880px",
  onClose: f.handleClose
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        slotName: children
        css:
          '''return `._id {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: ${t.var.spacing.lg};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  onCleanup: () => {
    f.cleanup();
  }
};'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: FormManagement
        props:
          '''const p = f.getProps();
const formConfig = p.formConfig;
const mode = p.mode || "add";
const tableVertexLabel = p.tableVertexLabel;
const initialVertex = p.initialVertex;
const onSave = p.onSave;
const onClose = p.onClose;

const wrappedOnSave = async (saveData) => {
  const txnId = f?.formTxnId?.();
  if (txnId && txnId > 0) {
    f.setFormTxnId(txnId);
  }
  if (onSave) {
    return await onSave(saveData);
  }
  return false;
};

const wrappedOnClose = () => {
  f.cleanup();
  if (onClose) {
    onClose();
  }
};

return {
  formConfig: formConfig,
  initialVertex: initialVertex,
  mode: mode,
  inModal: true,
  vertexLabel: tableVertexLabel,
  onSave: wrappedOnSave,
  onClose: wrappedOnClose,
  selectedSidebarItem: p.selectedSidebarItem,
  sidebarConfig: p.sidebarConfig
};'''
      }
    }
