  initialVertex,
  siteLanguages: f.getSiteLanguages?.() || [],
  mode: "edit",
  vertexLabel: "SettingsFormData",
  hideActionsBar: true,
  afterSuccessfulSave: "reinitialize",
  onSave: f.handleSectionSave,
  onFnsReady: f.registerFormManagementFns,
  onFieldChange: () => f.markDirty(),
  hide: !formConfig || !initialVertex
};'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
