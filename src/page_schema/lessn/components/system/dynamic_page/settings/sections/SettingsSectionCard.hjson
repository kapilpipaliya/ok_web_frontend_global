return `._id {
  background: ${t.var.color.background_light_100};
  border: 1px solid ${isDanger ? t.var.color.error : t.var.color.border};
  border-radius: ${t.var.borderRadius.lg};
  margin-bottom: ${t.var.spacing.lg};
  overflow: hidden;
}`;'''
