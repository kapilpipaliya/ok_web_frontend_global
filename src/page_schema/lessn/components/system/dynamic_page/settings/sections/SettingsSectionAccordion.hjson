{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        dynamicComponent: SettingsSectionRenderer
        fns:
          '''
const getSectionConfig = () => c.props?.sectionConfig || null;
const [expandedSectionIds, setExpandedSectionIds] = _.createSignal([]);

const toggleSection = (sectionId) => {
  setExpandedSectionIds((current) => {
    if (current.includes(sectionId)) return current.filter((id) => id !== sectionId);
    return [...current, sectionId];
  });
};

const isExpanded = (sectionId) => expandedSectionIds().includes(sectionId);

const getNestedSections = () => {
  const sectionConfig = getSectionConfig();
  return Array.isArray(sectionConfig?.sections) ? sectionConfig.sections : [];
};

return {
  getSectionConfig,
  toggleSection,
  isExpanded,
  getNestedSections
};
'''
        key: SettingsSectionAccordion
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  margin-bottom: ${t.var.spacing.lg};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div"
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 1.125rem;
  font-weight: 600;
  margin-bottom: ${t.var.spacing.md};
  color: ${t.var.color.text};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const sectionConfig = f.getSectionConfig();
return {
  as: "h2",
  text: sectionConfig?.title || "",
  hide: !sectionConfig?.title
};'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        contextName: nestedSection
        css:
          '''return `._id {
  border: 1px solid ${t.var.color.border};
  border-radius: ${t.var.borderRadius.md};
  margin-bottom: ${t.var.spacing.sm};
  overflow: hidden;
}`;'''
        loop: true
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "div",
  data: f.getNestedSections()
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''const nestedSection = c.nestedSection;
const expanded = f.isExpanded(nestedSection.id);
return expanded
  ? `._id {
  width: 100%;
  text-align: left;
  padding: ${t.var.spacing.md};
  background: ${t.var.color.background_light_200};
  border: none;
  font-weight: 600;
  cursor: pointer;
  color: ${t.var.color.text};
}`
  : `._id {
  width: 100%;
  text-align: left;
  padding: ${t.var.spacing.md};
  background: ${t.var.color.background_light_100};
  border: none;
  font-weight: 600;
  cursor: pointer;
  color: ${t.var.color.text};
}
._id:hover {
  background: ${t.var.color.background_light_200};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const nestedSection = c.nestedSection;
return {
  as: "button",
  type: "button",
  text: nestedSection.title || nestedSection.id,
  onClick: () => f.toggleSection(nestedSection.id)
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 2
        componentName: SettingsSectionRenderer
        props:
          '''const nestedSection = c.nestedSection;
const expanded = f.isExpanded(nestedSection.id);
return {
  sectionConfig: nestedSection,
  siteLanguages: c.props?.siteLanguages || [],
  hide: !expanded
};'''
      }
    }
  ]
