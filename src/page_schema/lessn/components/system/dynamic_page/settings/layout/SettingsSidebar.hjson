}`;'''
        loop: true
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "div",
  data: f.getVisibleGroups()
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: ${t.var.color.text_light_500};
  margin-bottom: ${t.var.spacing.xs};
  padding: 0 ${t.var.spacing.sm};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const group = c.sidebarGroup;
return {
