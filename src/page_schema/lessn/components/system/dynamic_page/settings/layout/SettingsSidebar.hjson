{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''
const GLOBAL_SIDEBAR_ITEM = {
  id: "global",
  label: "Global Settings",
  path: "/settings?page=global",
  icon: "settings"
};

const [pageSidebarItems, setPageSidebarItems] = _.createSignal([]);
let pageSidebarItemsLoadPromise = null;

const loadPageSidebarItems = async () => {
  if (pageSidebarItemsLoadPromise) return pageSidebarItemsLoadPromise;

  pageSidebarItemsLoadPromise = (async () => {
    try {
      const result = await s({
        functionName: "getSettingsPagePreviewUrls",
        contextData: {}
      });
      const items = result?.result?.data?.sidebarItems;
      const resolved = Array.isArray(items) ? items : [];
      setPageSidebarItems(resolved);
      return resolved;
    } catch (error) {
      console.error("SettingsSidebar loadPageSidebarItems:", error);
      return pageSidebarItems();
    } finally {
      pageSidebarItemsLoadPromise = null;
    }
  })();

  return pageSidebarItemsLoadPromise;
};

const getSidebarConfig = () => c.props?.sidebarConfig || f.getSettingsSidebarConfig?.() || null;

const checkPermissions = (permissionConfig) => {
  if (!permissionConfig) return true;
  if (_.isNoPermissionCheck === true) return true;
  if (_.hasFullPermission || _.hasEditPermission || _.hasViewPermission) return true;
  return false;
};

const getVisibleGroups = () => {
  const sidebarConfig = getSidebarConfig() || {};
  const configGroups = Array.isArray(sidebarConfig.groups) ? sidebarConfig.groups : [];
  const contentFromPages = pageSidebarItems();

  const groups = configGroups.length > 0
    ? configGroups.map((group) => {
        if (group.id === "content") {
          return {
            ...group,
            items: contentFromPages.length > 0 ? contentFromPages : (group.items || [])
          };
        }
        if (group.id === "global") {
          const globalItems = Array.isArray(group.items) && group.items.length > 0
            ? group.items
            : [GLOBAL_SIDEBAR_ITEM];
          return { ...group, items: globalItems };
        }
        return group;
      })
    : [
        { id: "global", label: "Global", items: [GLOBAL_SIDEBAR_ITEM] },
        { id: "content", label: "Content", items: contentFromPages }
      ];

  return groups.filter((group) => {
    if (!checkPermissions(group.permissions)) return false;
    return true;
  }).map((group) => ({
    ...group,
    items: (group.items || []).filter((item) => checkPermissions(item.permissions))
  })).filter((group) => (group.items || []).length > 0);
};

const parseNavPath = (itemPath) => {
  if (!itemPath) return { pathname: "", sectionId: null, pageId: null };
  const qIndex = itemPath.indexOf("?");
  if (qIndex === -1) return { pathname: itemPath, sectionId: null, pageId: null };
  const pathname = itemPath.slice(0, qIndex);
  const params = new URLSearchParams(itemPath.slice(qIndex + 1));
  return {
    pathname,
    sectionId: params.get("section"),
    pageId: params.get("page")
  };
};

const isActivePath = (itemPath) => {
  const currentPath = _.location?.pathname || "";
  if (!itemPath) return false;

  const parsed = parseNavPath(itemPath);
  if (parsed.pageId) {
    return currentPath === parsed.pathname
      && String(_.searchParams?.page || "").trim() === String(parsed.pageId).trim();
  }
  if (parsed.sectionId) {
    return currentPath === parsed.pathname && _.searchParams?.section === parsed.sectionId;
  }

  if (itemPath === currentPath) return true;
  return currentPath.startsWith(itemPath + "/");
};

const handleNavigate = (item) => {
  if (!item?.path) return;
  _.navigate(item.path);
};

return {
  getSidebarConfig,
  getVisibleGroups,
  isActivePath,
  handleNavigate,
  loadPageSidebarItems,
  sidebarTitle: () => getSidebarConfig()?.title || "Settings"
};
'''
        key: SettingsSidebar
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  width: 240px;
  flex-shrink: 0;
  border-right: 1px solid ${t.var.color.border};
  padding: ${t.var.spacing.md};
  background: ${t.var.color.background_light_100};
  min-height: 100%;
  overflow-y: auto;
}

@media (max-width: 768px) {
  ._id {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid ${t.var.color.border};
    max-height: 240px;
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "aside",
  onMount: () => {
    void f.loadPageSidebarItems?.();
  }
};'''
      }
