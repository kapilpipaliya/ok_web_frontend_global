}`;'''
        loop: true
        displayOrder: 2
        componentName: Html
        props:
          '''const group = c.sidebarGroup;
return {
  as: "nav",
  data: group.items || []
};'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''const item = c.navItem;
const active = f.isActivePath(item.path);
return active
  ? `._id {
  display: block;
  padding: ${t.var.spacing.sm} ${t.var.spacing.md};
  border-radius: ${t.var.borderRadius.md};
  color: ${t.var.color.primary_text};
  background: ${t.var.color.primary};
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  transition: background 150ms ease;
}`
  : `._id {
  display: block;
  padding: ${t.var.spacing.sm} ${t.var.spacing.md};
  border-radius: ${t.var.borderRadius.md};
  color: ${t.var.color.text};
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  transition: background 150ms ease;
}
._id:hover {
  background: ${t.var.color.background_light_200};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const item = c.navItem;
return {
  as: "a",
  href: item.path,
  text: item.label,
  onClick: (event) => {
    event.preventDefault();
    f.handleNavigate(item);
  }
};'''
      }
    }
