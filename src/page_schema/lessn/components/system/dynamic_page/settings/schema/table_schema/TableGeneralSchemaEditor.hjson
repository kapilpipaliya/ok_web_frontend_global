{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        dynamicComponent: Button, TextArea, LoadingSpinner, Html, FormManagement
        description: Visual editor for table general schema using FormManagement; unknown keys survive saves.
        fns:
          '''
const getProps = () => c.props || {};
const getTableKey = () => {
  const v = getProps().tableKey;
  return v != null && String(v).trim() !== "" ? String(v).trim() : null;
};
const getSchemaKey = () => {
  const v = getProps().schemaKey;
  return v != null && String(v).trim() !== "" ? String(v).trim() : null;
};
const executeYTOFunction = (fn, ctx) => s({ functionName: fn, contextData: ctx || {} });

const FORM_FIELD_KEYS = [
  "title",
  "label",
  "icon",
  "modalMaxWidth",
  "rowHeight",
  "publicRead",
  "showSelection",
  "hideExportButtons",
  "hideImportButtons",
  "hideSettingsButton",
  "hideAddButton",
  "enableUserScopingForContent",
  "enableLocalFilters",
  "enableLocalSort",
  "usePolarisUI",
  "rowClickable",
  "showRowNumber",
  "resizableColumns",
  "calendarEnabled",
  "calendarDateField",
  "calendarEndDateField",
  "calendarTitleField",
  "calendarColorField",
  "calendarDefaultView",
  "calendarDefaultContentView",
  "calendarAllowDrag"
];

const [columnOptions, setColumnOptions] = _.createSignal([]);

const columnSelectOptions = (includeEmpty) => {
  const cols = columnOptions();
  const opts = includeEmpty ? [{ value: "", label: "(none)" }] : [];
  for (let i = 0; i < cols.length; i++) {
    opts.push(cols[i]);
  }
  return opts;
};

const getGeneralFormConfig = () => ({
  gridColumns: 2,
  groups: [
    {
      key: "identity",
      title: "Identity",
      gridColumns: 2,
      fields: [
        { key: "title", label: "Title", dataType: "text", renderer: "text", colSpan: 1 },
        { key: "label", label: "Label", dataType: "text", renderer: "text", colSpan: 1 },
        { key: "icon", label: "Icon", dataType: "text", renderer: "text", colSpan: 1, placeholder: "ph:book-open" },
        { key: "modalMaxWidth", label: "Modal max width", dataType: "text", renderer: "text", colSpan: 1, placeholder: "880px" },
        { key: "rowHeight", label: "Row height", dataType: "text", renderer: "text", colSpan: 1, placeholder: "56" }
      ]
    },
    {
      key: "flags",
      title: "Flags",
      gridColumns: 2,
      fields: [
        { key: "publicRead", label: "Public read", dataType: "boolean", renderer: "checkbox", colSpan: 1 },
        { key: "showSelection", label: "Show selection", dataType: "boolean", renderer: "checkbox", colSpan: 1 },
        { key: "hideExportButtons", label: "Hide export buttons", dataType: "boolean", renderer: "checkbox", colSpan: 1 },
        { key: "hideImportButtons", label: "Hide import buttons", dataType: "boolean", renderer: "checkbox", colSpan: 1 },
        { key: "hideSettingsButton", label: "Hide settings button", dataType: "boolean", renderer: "checkbox", colSpan: 1 },
        { key: "hideAddButton", label: "Hide add button", dataType: "boolean", renderer: "checkbox", colSpan: 1 },
        { key: "enableUserScopingForContent", label: "User-scoped content", dataType: "boolean", renderer: "checkbox", colSpan: 1 },
        { key: "enableLocalFilters", label: "Local filters", dataType: "boolean", renderer: "checkbox", colSpan: 1 },
        { key: "enableLocalSort", label: "Local sort", dataType: "boolean", renderer: "checkbox", colSpan: 1 },
        { key: "usePolarisUI", label: "Use Polaris UI", dataType: "boolean", renderer: "checkbox", colSpan: 1 },
        { key: "rowClickable", label: "Row clickable", dataType: "boolean", renderer: "checkbox", colSpan: 1 },
        { key: "showRowNumber", label: "Show row number", dataType: "boolean", renderer: "checkbox", colSpan: 1 },
        { key: "resizableColumns", label: "Resizable columns", dataType: "boolean", renderer: "checkbox", colSpan: 1 }
      ]
    },
    {
      key: "calendar",
      title: "Calendar view",
      gridColumns: 2,
      fields: [
        { key: "calendarEnabled", label: "Enable calendar view", dataType: "boolean", renderer: "checkbox", colSpan: 1 },
        { key: "calendarAllowDrag", label: "Drag to reschedule", dataType: "boolean", renderer: "checkbox", colSpan: 1 },
        {
          key: "calendarDateField",
          label: "Start date field",
          dataType: "select",
          renderer: "select",
          colSpan: 1,
          options: columnSelectOptions(false),
          placeholder: "Select date column"
        },
        {
          key: "calendarEndDateField",
          label: "End date field (multi-day)",
          dataType: "select",
          renderer: "select",
          colSpan: 1,
          options: columnSelectOptions(true),
          placeholder: "Optional"
        },
        {
          key: "calendarTitleField",
          label: "Event title field",
          dataType: "select",
          renderer: "select",
          colSpan: 1,
          options: columnSelectOptions(true),
          placeholder: "Optional"
        },
        {
          key: "calendarColorField",
          label: "Color field",
          dataType: "select",
          renderer: "select",
          colSpan: 1,
          options: columnSelectOptions(true),
          placeholder: "Optional"
        },
        {
          key: "calendarDefaultView",
          label: "Default calendar layout",
          dataType: "select",
          renderer: "select",
          colSpan: 1,
          options: [
            { value: "month", label: "Month" },
            { value: "week", label: "Week" }
          ]
        },
        {
          key: "calendarDefaultContentView",
          label: "Default content view",
          dataType: "select",
          renderer: "select",
          colSpan: 1,
          options: [
            { value: "table", label: "Table" },
            { value: "calendar", label: "Calendar" }
          ]
        }
      ]
    }
  ]
});

const defaultGeneral = () => ({
  part: "general",
  title: "",
  label: "",
  icon: "",
  modalMaxWidth: "",
  rowHeight: 56,
  publicRead: false,
  showSelection: true,
  hideExportButtons: false,
  hideImportButtons: false,
  hideSettingsButton: false,
  hideAddButton: false,
  enableUserScopingForContent: false,
  enableLocalFilters: true,
  enableLocalSort: true,
  usePolarisUI: false,
  rowClickable: false,
  showRowNumber: true,
  resizableColumns: true,
  calendarConfig: {
    enabled: false,
    dateField: "",
    endDateField: "",
    titleField: "",
    colorField: "",
    defaultView: "month",
    defaultContentView: "table",
    allowDragReschedule: true
  }
});

const CALENDAR_FORM_KEYS = [
  "calendarEnabled",
  "calendarDateField",
  "calendarEndDateField",
  "calendarTitleField",
  "calendarColorField",
  "calendarDefaultView",
  "calendarDefaultContentView",
  "calendarAllowDrag"
];

const flattenCalendarForForm = (data) => {
  const cal = data?.calendarConfig && typeof data.calendarConfig === "object" ? data.calendarConfig : {};
  return {
    calendarEnabled: cal.enabled === true,
    calendarDateField: cal.dateField != null ? String(cal.dateField) : "",
    calendarEndDateField: cal.endDateField != null ? String(cal.endDateField) : "",
    calendarTitleField: cal.titleField != null ? String(cal.titleField) : "",
    calendarColorField: cal.colorField != null ? String(cal.colorField) : "",
    calendarDefaultView: cal.defaultView === "week" ? "week" : "month",
    calendarDefaultContentView: cal.defaultContentView === "calendar" ? "calendar" : "table",
    calendarAllowDrag: cal.allowDragReschedule !== false
  };
};

const packCalendarFromForm = (formValues) => {
  const dateField =
    formValues?.calendarDateField != null ? String(formValues.calendarDateField).trim() : "";
  const endDateField =
    formValues?.calendarEndDateField != null ? String(formValues.calendarEndDateField).trim() : "";
  const titleField =
    formValues?.calendarTitleField != null ? String(formValues.calendarTitleField).trim() : "";
  const colorField =
    formValues?.calendarColorField != null ? String(formValues.calendarColorField).trim() : "";
  const defaultView = formValues?.calendarDefaultView === "week" ? "week" : "month";
  const defaultContentView =
    formValues?.calendarDefaultContentView === "calendar" ? "calendar" : "table";
  return {
    enabled: formValues?.calendarEnabled === true,
    dateField,
    endDateField: endDateField || undefined,
    titleField: titleField || undefined,
    colorField: colorField || undefined,
    defaultView,
    defaultContentView,
    allowDragReschedule: formValues?.calendarAllowDrag !== false
  };
};

const [loading, setLoading] = _.createSignal(false);
const [saving, setSaving] = _.createSignal(false);
const [schemaData, setSchemaData] = _.createSignal(defaultGeneral());
const [formVertex, setFormVertex] = _.createSignal(null);
const [formRevision, setFormRevision] = _.createSignal(0);
const [formManagementFns, setFormManagementFns] = _.createSignal(null);
const [configJsonText, setConfigJsonText] = _.createSignal("");
const [jsonError, setJsonError] = _.createSignal("");
const [editorMode, setEditorMode] = _.createSignal("visual");

const isJsonMode = () => editorMode() === "json";

const syncJsonFromData = (data) => {
  setConfigJsonText(
    JSON.stringify(data && typeof data === "object" ? { ...data } : defaultGeneral(), null, 2)
  );
  setJsonError("");
};

const pickFormValues = (data) => {
  const source = data && typeof data === "object" ? data : {};
  const defaults = defaultGeneral();
  const values = {};
  for (let i = 0; i < FORM_FIELD_KEYS.length; i++) {
    const key = FORM_FIELD_KEYS[i];
    if (CALENDAR_FORM_KEYS.includes(key)) continue;
    values[key] = source[key] !== undefined ? source[key] : defaults[key];
  }
  Object.assign(values, flattenCalendarForForm({ ...defaults, ...source }));
  return values;
};

const buildFormVertex = (data) => {
  const vertexId = _.generateNewVertexId(g, sg);
  const values = pickFormValues(data);
  _.addNewVertex(
    0,
    {
      id: vertexId,
      L: ["TableGeneralSchemaFormData"],
      P: { ...values },
      IN: {},
      OUT: {}
    },
    g,
    sg
  );
  return g.vertexes[vertexId] || null;
};

const mergeFormIntoSchema = (formP, baseData) => {
  const base =
    baseData && typeof baseData === "object"
      ? { ...baseData }
      : { ...(schemaData() || defaultGeneral()) };
  const formValues = formP && typeof formP === "object" ? formP : {};
  for (let i = 0; i < FORM_FIELD_KEYS.length; i++) {
    const key = FORM_FIELD_KEYS[i];
    if (CALENDAR_FORM_KEYS.includes(key)) continue;
    if (Object.prototype.hasOwnProperty.call(formValues, key)) {
      base[key] = formValues[key];
    }
  }
  if (base.rowHeight != null && base.rowHeight !== "") {
    const asNumber = Number(base.rowHeight);
    if (Number.isFinite(asNumber)) base.rowHeight = asNumber;
  }
  if (base.modalMaxWidth != null) {
    const trimmed = String(base.modalMaxWidth).trim();
    base.modalMaxWidth = trimmed !== "" ? trimmed : "";
  }
  base.calendarConfig = packCalendarFromForm(formValues);
  for (let i = 0; i < CALENDAR_FORM_KEYS.length; i++) {
    delete base[CALENDAR_FORM_KEYS[i]];
  }
  base.part = "general";
  return base;
};

const applyLoadedSetting = (setting) => {
  if (!setting?.P?.config) {
    const defaults = defaultGeneral();
    setSchemaData(defaults);
    syncJsonFromData(defaults);
    setFormVertex(buildFormVertex(defaults));
    setFormRevision((n) => n + 1);
    return;
  }
  try {
    const data = new Function(setting.P.config)();
    // Keep every stored key; only fill defaults for known form fields.
    const merged = { ...defaultGeneral(), ...(data || {}), part: "general" };
    setSchemaData(merged);
    syncJsonFromData(merged);
    setFormVertex(buildFormVertex(merged));
    setFormRevision((n) => n + 1);
  } catch (error) {
    setSchemaData(defaultGeneral());
    setConfigJsonText(String(setting.P.config || ""));
    setJsonError("Failed to parse stored config");
    setFormVertex(buildFormVertex(defaultGeneral()));
    setFormRevision((n) => n + 1);
  }
};

const loadColumnOptions = async () => {
  const tableKey = getTableKey();
  if (!tableKey) {
    setColumnOptions([]);
    return;
  }
  try {
    const idsResult = await executeYTOFunction("getTableIds", { tableKey });
    const columnsKey = idsResult?.result?.data?.schemaKeys?.columns;
    if (!columnsKey) {
      setColumnOptions([]);
      return;
    }
    const result = await executeYTOFunction("getTableSchema", { key: columnsKey });
    if (!result?.result?.success) {
      setColumnOptions([]);
      return;
    }
    const setting = result.result.data?.setting;
    if (!setting?.P?.config) {
      setColumnOptions([]);
      return;
    }
    const data = new Function(setting.P.config)();
    const cols = Array.isArray(data?.columns) ? data.columns : [];
    const opts = [];
    for (let i = 0; i < cols.length; i++) {
      const col = cols[i];
      const key = col?.key != null ? String(col.key).trim() : "";
      if (!key) continue;
      opts.push({
        value: key,
        label: col.label != null && String(col.label).trim() !== "" ? String(col.label) : key
      });
    }
    setColumnOptions(opts);
  } catch (error) {
    console.error("Failed to load column options for calendar config", error);
    setColumnOptions([]);
  }
};

const loadSchema = async () => {
  const schemaKey = getSchemaKey();
  if (!schemaKey) return;
  setLoading(true);
  try {
    await loadColumnOptions();
    const result = await executeYTOFunction("getTableSchema", { key: schemaKey });
    if (!result?.result?.success) {
      _.showErrorToast?.(result?.result?.message || "Failed to load table schema");
      return;
    }
    applyLoadedSetting(result.result.data?.setting);
  } catch (error) {
    _.showErrorToast?.("Failed to load table schema");
  } finally {
    setLoading(false);
  }
};

const persistSchemaObject = async (configObj) => {
  const schemaKey = getSchemaKey();
  if (!schemaKey) {
    _.showErrorToast?.("Schema key is missing");
    return false;
  }
  const payload = configObj && typeof configObj === "object" ? { ...configObj, part: "general" } : defaultGeneral();
  const configBody = `return ${JSON.stringify(payload, null, 2)};`;
  const result = await executeYTOFunction("saveTableSchema", {
    key: schemaKey,
    tableKey: getTableKey(),
    part: "general",
    config: configBody,
    name: getProps().title || "Table general schema"
  });
  if (!result?.result?.success) {
    _.showErrorToast?.(result?.result?.message || "Failed to save");
    return false;
  }
  _.showSuccessToast?.(result.result.message || "Table schema saved");
  applyLoadedSetting(result.result.data?.setting);
  getProps().onSaved?.();
  return true;
};

const handleFormSave = async (savePayload) => {
  const next = mergeFormIntoSchema(savePayload?.vertex?.P, schemaData());
  const ok = await persistSchemaObject(next);
  return ok;
};

const saveSchema = async () => {
  setSaving(true);
  try {
    if (isJsonMode()) {
      const parsed = JSON.parse(configJsonText());
      // JSON mode is authoritative for the full object, including unknown keys.
      await persistSchemaObject({ ...(parsed || {}), part: "general" });
      return;
    }
    const formFns = formManagementFns();
    if (formFns?.handleSave) {
      await formFns.handleSave();
      return;
    }
    const liveVertex = formFns?.getFormVertex?.() || formVertex();
    const next = mergeFormIntoSchema(liveVertex?.P, schemaData());
    await persistSchemaObject(next);
  } catch (error) {
    _.showErrorToast?.(isJsonMode() ? "Invalid JSON" : "Failed to save table schema");
  } finally {
    setSaving(false);
  }
};

const setEditorModeSafe = (mode) => {
  if (mode === "json") {
    // Refresh JSON from latest schema + live form field values before switching.
    const liveVertex = formManagementFns()?.getFormVertex?.() || formVertex();
    const merged = mergeFormIntoSchema(liveVertex?.P, schemaData());
    setSchemaData(merged);
    syncJsonFromData(merged);
  } else if (mode === "visual") {
    try {
      const parsed = JSON.parse(configJsonText());
      const merged = { ...defaultGeneral(), ...(parsed || {}), part: "general" };
      setSchemaData(merged);
      setFormVertex(buildFormVertex(merged));
      setFormRevision((n) => n + 1);
      setJsonError("");
    } catch (error) {
      setJsonError("Invalid JSON — fix before switching to Visual");
      _.showErrorToast?.("Invalid JSON — fix before switching to Visual");
      return;
    }
  }
  setEditorMode(mode);
};

const registerFormManagementFns = (formFns) => {
  setFormManagementFns(formFns || null);
};

return {
  loading,
  saving,
  isJsonMode,
  configJsonText,
  setConfigJsonText,
  jsonError,
  loadSchema,
  saveSchema,
  setEditorMode: setEditorModeSafe,
  GENERAL_FORM_CONFIG: getGeneralFormConfig(),
  getGeneralFormConfig,
  formVertex,
  formRevision,
  handleFormSave,
  registerFormManagementFns,
  FORM_FIELD_KEYS
};
'''
