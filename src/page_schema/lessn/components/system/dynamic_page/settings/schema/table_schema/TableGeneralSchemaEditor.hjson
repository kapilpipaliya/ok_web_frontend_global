      P: {
        css: return `._id { flex: 1; min-height: 0; overflow: auto; }`;
        displayOrder: 3
        componentName: Html
        props: "return { as: \"div\", hide: f.loading?.() === true };"
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        css:
          '''return `._id {
  padding: 0.75rem 1rem;
  min-height: 0;
}`;'''
        displayOrder: 1
        componentName: FormManagement
        props:
          '''const initialVertex = f.formVertex?.();
const revision = f.formRevision?.() || 0;
return {
  key: `table-general-form-${revision}`,
  hide: f.isJsonMode?.() === true || !initialVertex,
  formConfig: typeof f.getGeneralFormConfig === "function" ? f.getGeneralFormConfig() : f.GENERAL_FORM_CONFIG,
  initialVertex,
  mode: "edit",
  vertexLabel: "TableGeneralSchemaFormData",
  hideActionsBar: true,
  afterSuccessfulSave: "reinitialize",
  onSave: f.handleFormSave,
  onFnsReady: f.registerFormManagementFns
};'''
      }
    }
    {
