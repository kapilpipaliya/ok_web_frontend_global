      : selectionMode === "multiple" && value != null && String(value).trim() !== ""
        ? [String(value).trim()]
        : [];
  const selectedElementId =
    selectionMode === "multiple"
      ? selectedValues[0] || ""
      : value != null && String(value).trim() !== ""
        ? String(value).trim()
        : "";
  const selectedVertex =
    selectedElementId && g.vertexes[selectedElementId]
      ? g.vertexes[selectedElementId]
