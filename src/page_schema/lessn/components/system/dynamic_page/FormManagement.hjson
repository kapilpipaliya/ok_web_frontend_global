  if (!pickerConfiguration) {
    return { as: "motionFragment", hide: true };
  }
  if (pickerConfiguration.usePolarisUI === undefined) {
    pickerConfiguration.usePolarisUI = f.getUsePolarisUI?.() === true;
  }
  const selectionMode =
    pickerConfiguration.selectionMode === "multiple" ? "multiple" : "single";
  const selectedValues =
    selectionMode === "multiple" && Array.isArray(value)
