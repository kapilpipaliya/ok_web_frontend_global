  as: "s-button",
  "attr:variant": "primary",
  text: f.isFileUploading?.() === true ? "Uploading…" : "Save",
  onClick: f.handleSave,
  disabled: f.isSubmitting() || f.isFileUploading?.() === true,
  hide: f.getUsePolarisUI?.() !== true
};'''
      }
    }
