    if (previewFileName !== "") {
      previewUrl = `${fileDownloadUrlPrefix}/${encodeURIComponent(previewFileName)}`;
    }
  }
  let secondaryLabel = "";
  if (pickerConfiguration.secondaryLabel != null) {
    secondaryLabel = String(pickerConfiguration.secondaryLabel).trim();
  } else if (pickerConfiguration.buildSecondaryLabelFromVertex === true) {
    if (selectionMode === "multiple" && selectedValues.length > 0) {
      const names = selectedValues
        .map((id) => g.vertexes[id]?.P?.[previewFileNamePropertyKey])
        .filter((name) => name != null && String(name).trim() !== "")
        .map((name) => String(name).trim());
      if (names.length === 0) {
        secondaryLabel = `${selectedValues.length} selected`;
      } else if (names.length <= 2) {
        secondaryLabel = names.join(", ");
      } else {
        secondaryLabel = `${names.length} files: ${names.slice(0, 2).join(", ")}…`;
      }
    } else if (selectedVertex) {
      const label = selectedVertex.P?.[previewFileNamePropertyKey];
      if (label != null && String(label).trim() !== "") {
