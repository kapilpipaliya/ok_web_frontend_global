  font-size: 0.75rem;
  color: ${t.var.color.error};
  min-height: 1.25rem;
}`;'''
        displayOrder: 4
        componentName: Html
        props:
          '''const field = c.field;
const error = f.errors[field.key];

return {
  as: "div",
  text: error || "",
  hide: !error
};'''
      }
    }
    {
      id: "16"
      L: Attr
      P: {
        css:
          '''const inModal = c.props?.inModal === true;
const lg = t.var.spacing.lg;
const md = t.var.spacing.md;
return `._id {
  padding: ${md} ${lg};
  border-top: 1px solid ${t.var.color.border};
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: ${md};
  ${inModal ? `
  margin-left: -${lg};
  margin-right: -${lg};
  margin-bottom: -${lg};
  padding-left: ${lg};
  padding-right: ${lg};
  padding-bottom: ${lg};
  ` : ''}
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "div",
  hide: f.getMode?.() === "view" || c.props?.hideActionsBar === true
};'''
      }
    }
    {
      id: "17"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''const onClose = c.props?.onClose;

const handleCancel = () => {
  const txnId = f.formTxnId();
  if (txnId && txnId > 0) {
    _.revertTransaction(txnId);
    f.setFormTxnId(0);
  }
  if (onClose) onClose();
};

return {
  as: "s-button",
  "attr:variant": "secondary",
  text: "Cancel",
  onClick: handleCancel,
  disabled: f.isSubmitting() || f.isFileUploading?.() === true,
  hide: f.getUsePolarisUI?.() !== true
};'''
      }
    }
    {
      id: "18"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Button
        props:
          '''const onClose = c.props?.onClose;

const handleCancel = () => {
  // Cleanup transaction if needed
  const txnId = f.formTxnId();
  if (txnId && txnId > 0) {
    _.revertTransaction(txnId);
    f.setFormTxnId(0);
  }

  if (onClose) {
    onClose();
  }
};

return {
  variant: "secondary",
  onClick: handleCancel,
  text: "Cancel",
  disabled: f.isSubmitting(),
  hide: f.getUsePolarisUI?.() === true
};'''
      }
    }
