if (
  f.getFieldRenderer(field) === "isoDateTime"
) {
  const toDatetimeLocalValue = (raw) => {
    if (raw == null || String(raw).trim() === "") return "";
    const date = new Date(raw);
    if (Number.isNaN(date.getTime())) return "";
    const pad = (n) => String(n).padStart(2, "0");
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
  };
  return {
    componentName: "TextInput",
    type: "datetime-local",
    value: toDatetimeLocalValue(value),
    placeholder: field.placeholder || "",
    required: fieldRequired,
    disabled: fieldDisabled || f.isSubmitting(),
    onChange: (e) => {
      const next = e.target.value;
      if (!next) {
        setFieldValue(field.key, "");
        return;
      }
      const parsed = new Date(next);
      if (Number.isNaN(parsed.getTime())) {
        setFieldValue(field.key, next);
        return;
      }
      setFieldValue(field.key, parsed.toISOString());
    },
    ...accessibility
  };
}

if (f.getFieldDataType(field) === "number") {
  return {
    componentName: "TextInput",
    type: "number",
    value: value,
