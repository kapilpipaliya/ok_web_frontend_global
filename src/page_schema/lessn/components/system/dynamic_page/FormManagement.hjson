const tooltipMeta = f.getFieldTooltipMeta(field);
const hintId = `fm-field-hint-${field.key}`;
const accessibility = tooltipMeta.showBelow && tooltipMeta.body ? { "aria-describedby": hintId } : {};

// Render appropriate input from field renderer (+ dataType for validation/input kind)
if (f.getFieldRenderer(field) === "graphFileUpload") {
  const baseUploadConfiguration =
    field.uploadConfiguration != null &&
    typeof field.uploadConfiguration === "object" &&
    !Array.isArray(field.uploadConfiguration)
      ? field.uploadConfiguration
      : null;
  if (!baseUploadConfiguration) {
    return { as: "motionFragment", hide: true };
  }
  const selectedSidebarItem =
    typeof c.props?.selectedSidebarItem === "function"
      ? c.props.selectedSidebarItem()
      : c.props?.selectedSidebarItem;
  const sidebarConfig =
    c.props?.sidebarConfig != null && typeof c.props.sidebarConfig === "object"
      ? c.props.sidebarConfig
      : null;
  const rootKey = sidebarConfig?.rootKeys?.key;
  const tableVertexLabel = c.props?.vertexLabel || c.props?.tableVertexLabel;
  const uncategorizedId = tableVertexLabel
    ? "_" + tableVertexLabel + "_uncategorized"
    : null;
  const allId = tableVertexLabel
    ? "_" + tableVertexLabel + "_all"
    : null;
  const isUncat =
    selectedSidebarItem &&
    uncategorizedId &&
    (selectedSidebarItem.id === uncategorizedId ||
      selectedSidebarItem.P?.key === uncategorizedId);
  const isAll =
    selectedSidebarItem &&
    allId &&
    (selectedSidebarItem.id === allId ||
      selectedSidebarItem.P?.key === allId);
  const isRoot =
    selectedSidebarItem &&
    rootKey &&
    selectedSidebarItem.P?.key === rootKey;
  const folderId =
    selectedSidebarItem?.id && !isUncat && !isAll && !isRoot
      ? String(selectedSidebarItem.id)
      : "";
  return {
