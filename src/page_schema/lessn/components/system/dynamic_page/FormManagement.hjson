{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        dynamicComponent: FloatingHelpTooltip, VertexPicker, FileUploader, TomSelect, TextArea, FormNestedLineItems, FormFieldArray, FormLocalizedText, FormFilesGallery
        key: FormManagement
        updatedAt: 2026-07-16T18:05:56.013Z
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        fns:
          '''// Form field schema: dataType = semantics/validation; renderer = UI control
const getFieldDataType = (field) => field?.dataType || "text";

const getFieldRenderer = (field) => field?.renderer || "text";

const isTranslatableTextField = (field) => {
  if (field?.translatable !== true) return false;
  const renderer = getFieldRenderer(field);
  return renderer === "text" || renderer === "textArea";
};

const isRelationField = (field) => {
  const fieldDataType = getFieldDataType(field);
  return fieldDataType === "relation" || fieldDataType === "select";
};

// Form state management using Vertex format
const getFormConfig = () => c.props?.formConfig;
const getInitialVertex = () => c.props?.initialVertex;
const getMode = () => c.props?.mode || "add";
const getVertexLabel = () => {
  return c.props?.vertexLabel || "FormData";
};
const getClonePropertyOverrides = () => {
  const overrides = c.props?.clonePropertyOverrides;
  return overrides != null && typeof overrides === "object" && !Array.isArray(overrides)
    ? overrides
    : {};
};

const DEFAULT_SITE_LANGUAGES = [
  { code: "en", label: "English", isDefault: true },
  { code: "hi", label: "Hindi", isDefault: false },
  { code: "gu", label: "Gujarati", isDefault: false }
];

const getSiteLanguages = () => {
  const languages = c.props?.siteLanguages;
  if (Array.isArray(languages) && languages.length > 0) return languages;
  return DEFAULT_SITE_LANGUAGES;
};

// Form vertex ID - vertex will be read from graph
const [formVertexId, setFormVertexId] = _.createSignal(null);
const [formTxnId, setFormTxnId] = _.createSignal(0);
const [errors, setErrors] = _.createStore({});
const [isSubmitting, setIsSubmitting] = _.createSignal(false);
const [isFileUploading, setIsFileUploading] = _.createSignal(false);
const [uploadedContentIds, setUploadedContentIds] = _.createSignal([]);
const [nestedLineMeta, setNestedLineMeta] = _.createSignal({ deletedIdsByField: {} });
const resetNestedLineMeta = () => setNestedLineMeta({ deletedIdsByField: {} });
const rememberUploadedContentIds = (ids) => {
  const list = (Array.isArray(ids) ? ids : ids != null ? [ids] : [])
    .map((id) => String(id || "").trim())
    .filter((id) => id && !id.startsWith("-"));
  setUploadedContentIds(list);
};

const markNestedLineDeleted = (fieldKey, lineId) => {
  if (!fieldKey || !lineId) return;
  setNestedLineMeta((m) => {
    const d = { ...(m.deletedIdsByField || {}) };
    const cur = d[fieldKey] || [];
    if (cur.includes(lineId)) return m;
    d[fieldKey] = [...cur, lineId];
    return { deletedIdsByField: d };
  });
};

const getNestedDeletedIdsForField = (fieldKey) =>
  nestedLineMeta().deletedIdsByField[fieldKey] || [];

// Nested line rows live only as child vertices + edges (see nestedLineItemsConfig.parentToChildRelationshipType).
// Listed via _.evalExpression(rowsExpression or `->${relationshipType}`, { graph, vertexes: [parent] }).
// Edit mode: children must already be in the client graph (getUserContent 1-hop). Do not seed blanks on edit.
const hydrateNestedLineFields = () => {};

// Seed required/minItems nested lines on create only.
// Nested lines are not stored on the parent vertex P[fieldKey]; no placeholder arrays.
const ensureNestedLineEmptyArrays = () => {
  const parentVertex = getFormVertex();
  if (!parentVertex?.id) return;
  const txnId = ensureFormTxn();
  if (!txnId) return;
  const allFields = getAllFields();
  for (const field of allFields) {
    if (!isFieldVisible(field)) continue;
    if (getFieldRenderer(field) !== "nestedLineItems") continue;
    const nestedLineItemsConfig = field.nestedLineItemsConfig;
    if (
      !nestedLineItemsConfig?.childLabel ||
      !nestedLineItemsConfig?.parentToChildRelationshipType
    ) {
      continue;
    }
    let rows = getNestedLineVerticesForField(field);
    const configuredMin =
      nestedLineItemsConfig.minItems != null ? Number(nestedLineItemsConfig.minItems) : NaN;
    // minItems gates removal; required fields still get one starter row on create when minItems is 0.
    const minItems = Number.isFinite(configuredMin)
      ? Math.max(0, configuredMin)
      : isFieldRequired(field)
        ? 1
        : 0;
    const seedCount =
      minItems > 0 ? minItems : isFieldRequired(field) ? 1 : 0;
    while (rows.length < seedCount) {
      const displayOrder = Date.now() + rows.length;
      const newLineProperties = { displayOrder };
      const parentElementIdPropertyKey = nestedLineItemsConfig.parentElementIdPropOnChild;
      if (parentElementIdPropertyKey) {
        newLineProperties[parentElementIdPropertyKey] = parentVertex.id;
      }
      const columnDefinitions = Array.isArray(nestedLineItemsConfig.lineColumns)
        ? nestedLineItemsConfig.lineColumns
        : [];
      for (let columnIndex = 0; columnIndex < columnDefinitions.length; columnIndex++) {
        const columnDef = columnDefinitions[columnIndex];
        if (
          !columnDef ||
          columnDef.columnType === "actions" ||
          columnDef.columnType === "inventory" ||
          columnDef.columnType === "files" ||
          columnDef.columnType === "optionPairs"
        ) {
          continue;
        }
        if (!columnDef.key || String(columnDef.key).startsWith("_")) continue;
        if (columnDef.defaultValue !== undefined) {
          newLineProperties[columnDef.key] = columnDef.defaultValue;
        }
      }
      const defaultOverlay = nestedLineItemsConfig.defaultNewLineProperties;
      if (defaultOverlay && typeof defaultOverlay === "object") {
        for (const propertyKey of Object.keys(defaultOverlay)) {
          newLineProperties[propertyKey] = defaultOverlay[propertyKey];
        }
      }
      for (let columnIndex = 0; columnIndex < columnDefinitions.length; columnIndex++) {
        const columnDef = columnDefinitions[columnIndex];
        if (!columnDef || columnDef.columnType !== "optionPairs") continue;
        const axesFieldKey =
          columnDef.optionAxesFieldKey != null && String(columnDef.optionAxesFieldKey).trim() !== ""
            ? String(columnDef.optionAxesFieldKey).trim()
            : "optionAxes";
        let axes = [];
        const axesRaw = getFieldValue(axesFieldKey);
        if (Array.isArray(axesRaw)) axes = axesRaw;
        else if (typeof axesRaw === "string" && axesRaw.trim() !== "") {
          try {
            const parsed = JSON.parse(axesRaw);
            axes = Array.isArray(parsed) ? parsed : [];
          } catch {
            axes = [];
          }
        }
        for (let axisIndex = 0; axisIndex < axes.length; axisIndex++) {
          const key = axes[axisIndex]?.key != null ? String(axes[axisIndex].key).trim() : "";
          if (!key || String(key).startsWith("_")) continue;
          if (newLineProperties[key] === undefined) newLineProperties[key] = "";
        }
      }
      const newLineVertexId = _.generateNewVertexId(g, sg);
      const newLineVertex = _.newVertex(
        newLineVertexId,
        [nestedLineItemsConfig.childLabel],
        newLineProperties,
      );
      _.addNewVertex(txnId, newLineVertex, g, sg);
      const newParentToChildEdgeId = _.generateNewVertexId(g, sg);
      const parentToChildEdge = _.newEdge(
        newParentToChildEdgeId,
        nestedLineItemsConfig.parentToChildRelationshipType,
        {},
        parentVertex.id,
        newLineVertexId,
      );
      _.addNewEdge(txnId, parentToChildEdge, g, sg);
      rows = getNestedLineVerticesForField(field);
    }
  }
};

// Helper to get form vertex from graph (or initialVertex for view mode)
const getFormVertex = () => {
  const mode = getMode();
  const initialVertex = getInitialVertex();
  if (mode === "view" && initialVertex) {
    return initialVertex;
  }
  const vertexId = formVertexId();
  if (!vertexId) return null;
  return g.vertexes[vertexId] || null;
};

// --- Generic field rules (FormContext: { mode, values, user }) ---
// props.mode accepts "add" | "create" | "edit" | "view"; ctx.mode uses "create" | "edit" | "view".
// Field rules: visible | disabled | required as boolean, (ctx) => boolean, or string body compiled as (ctx, _) => ...
// Optional validate: (value, ctx) => string | null, or string body (value, ctx, _).
const normalizeFormMode = () => {
  const propsMode = getMode();
  if (propsMode === "add" || propsMode === "create") return "create";
  if (propsMode === "edit") return "edit";
  if (propsMode === "view") return "view";
  return "create";
};

const buildFormContext = () => {
  const formVertex = getFormVertex();
  const values = formVertex && formVertex.P ? { ...formVertex.P } : {};
  return {
    mode: normalizeFormMode(),
    values,
    user: _.user
  };
};

const compileCtxPredicate = (source) => {
  const sourceText = String(source || "").trim();
  if (!sourceText) return null;
  const trimmed = sourceText.trimStart();
  const hasLeadingReturn =
    trimmed.startsWith("return ") ||
    trimmed.startsWith("return\t") ||
    trimmed.startsWith("return\n") ||
    trimmed === "return;";
  const body = hasLeadingReturn ? sourceText : `return (${sourceText});`;
  try {
    return new Function("ctx", "_", body);
  } catch (e) {
    console.warn("FormManagement: invalid predicate string", e);
    return null;
  }
};

const compileValueCtxValidate = (source) => {
  const sourceText = String(source || "").trim();
  if (!sourceText) return null;
  const trimmed = sourceText.trimStart();
  const hasLeadingReturn =
    trimmed.startsWith("return ") ||
    trimmed.startsWith("return\t") ||
    trimmed.startsWith("return\n") ||
    trimmed === "return;";
  const body = hasLeadingReturn ? sourceText : `return (${sourceText});`;
  try {
    return new Function("value", "ctx", "_", body);
  } catch (e) {
    console.warn("FormManagement: invalid validate string", e);
    return null;
  }
};

const evalFieldRule = (field, key, legacyFallback) => {
  if (!field || !key) return legacyFallback;
  const raw = field[key];
  if (raw === undefined || raw === null) return legacyFallback;
  if (typeof raw === "function") {
    try {
      const ctx = buildFormContext();
      if (key === "required") return Boolean(raw(ctx));
      return Boolean(raw(ctx));
    } catch (e) {
      console.warn("FormManagement: field rule", key, field?.key, e);
      return legacyFallback;
    }
  }
  if (typeof raw === "string") {
    const fn = compileCtxPredicate(raw);
    if (!fn) return legacyFallback;
    try {
      return Boolean(fn(buildFormContext(), _));
    } catch (e) {
      console.warn("FormManagement: field rule string", key, field?.key, e);
      return legacyFallback;
    }
  }
  if (typeof raw === "boolean") return raw;
  return legacyFallback;
};

const isFieldVisible = (field) => {
  if (!field) return false;
  const hasExplicitVisible =
    typeof field.visible === "function" ||
    (typeof field.visible === "string" && field.visible.trim() !== "") ||
    typeof field.visible === "boolean";
  if (hasExplicitVisible && !evalFieldRule(field, "visible", true)) {
    return false;
  }
  if (!field.dependsOn) return true;

  const vertex = getFormVertex();
  if (!vertex) return false;

  const dependsOnValue = vertex.P[field.dependsOn.field];

  if (field.dependsOn.operator === "equals") {
    return dependsOnValue === field.dependsOn.value;
  } else if (field.dependsOn.operator === "notEquals") {
    return dependsOnValue !== field.dependsOn.value;
  } else if (field.dependsOn.operator === "contains") {
    return String(dependsOnValue || "").includes(field.dependsOn.value);
  }

  return true;
};

const isFieldRequired = (field) => {
  if (!field) return false;
  if (typeof field.required === "function" || (typeof field.required === "string" && field.required.trim() !== "")) {
    return evalFieldRule(field, "required", false);
  }
  return Boolean(field.required);
};

const isFieldDisabled = (field) => {
  if (!field) return true;
  const hasDyn =
    typeof field.disabled === "function" ||
    (typeof field.disabled === "string" && field.disabled.trim() !== "") ||
    typeof field.disabled === "boolean";
  if (hasDyn && evalFieldRule(field, "disabled", false)) return true;
  if (getMode() === "view") return true;
  return false;
};

const evalFieldCustomValidate = (field, value) => {
  if (!field || field.validate == null) return null;
  const raw = field.validate;
  if (typeof raw === "string" && !raw.trim()) return null;
  const ctx = buildFormContext();
  if (typeof raw === "function") {
    try {
      const msg = raw(value, ctx);
      if (msg == null || msg === "") return null;
      return String(msg);
    } catch (e) {
      console.warn("FormManagement: validate fn", field?.key, e);
      return "Validation error";
    }
  }
  if (typeof raw === "string") {
    const fn = compileValueCtxValidate(raw);
    if (!fn) return null;
    try {
      const msg = fn(value, ctx, _);
      if (msg == null || msg === "") return null;
      return String(msg);
    } catch (e) {
      console.warn("FormManagement: validate string", field?.key, e);
      return "Validation error";
    }
  }
  return null;
};

const ensureFormTxn = () => {
  let txnId = formTxnId();
  if (!txnId || txnId === 0) {
    txnId = _.generateNewTxnId(g, sg);
    setFormTxnId(txnId);
  }
  return txnId;
};

const getNestedLineVerticesForField = (field) => {
  const nestedLineItemsConfig = field?.nestedLineItemsConfig;
  const parent = getFormVertex();
  if (
    !field ||
    getFieldRenderer(field) !== "nestedLineItems" ||
    !nestedLineItemsConfig?.parentToChildRelationshipType ||
    !parent
  ) {
    return [];
  }
  const rowsExpression =
    nestedLineItemsConfig.rowsExpression ||
    `->${nestedLineItemsConfig.parentToChildRelationshipType}`;
  const expressionResult =
    _.evalExpression(rowsExpression, { graph: g, vertexes: [parent] }) || [];
  const rowVertices = Array.isArray(expressionResult) ? expressionResult : [];
  const sortedRowVertices = rowVertices.filter(
    (rowVertex) => rowVertex && typeof rowVertex.id === "string"
  );
  sortedRowVertices.sort(
    (left, right) => (Number(left.P?.displayOrder) || 0) - (Number(right.P?.displayOrder) || 0)
  );
  return sortedRowVertices;
};

const buildNestedLineRowPayload = (rowVertex, nestedLineItemsConfig) => {
  const parentElementIdProperty = nestedLineItemsConfig.parentElementIdPropOnChild;
  const inventoryRelationshipType = nestedLineItemsConfig.childToInventoryRelationshipType;
  const inventoryTargetLabel = nestedLineItemsConfig.inventoryTargetLabel || "InventoryItem";
  const filesRelationshipType = nestedLineItemsConfig.childToFilesRelationshipType;
  const filesTargetLabel = nestedLineItemsConfig.filesTargetLabel || "File";
  let inventoryItemId = "";
  if (
    inventoryRelationshipType &&
    rowVertex.OUT &&
    rowVertex.OUT[inventoryRelationshipType]
  ) {
    const outgoingEdgeIds = rowVertex.OUT[inventoryRelationshipType];
    for (let edgeIndex = 0; edgeIndex < outgoingEdgeIds.length; edgeIndex++) {
      const edge = g.edges[outgoingEdgeIds[edgeIndex]];
      if (!edge) continue;
      const targetVertex = g.vertexes[edge.E];
      if (targetVertex?.L?.includes(inventoryTargetLabel)) {
        inventoryItemId = edge.E;
        break;
      }
    }
  }
  const imageFileIds = [];
  if (filesRelationshipType && rowVertex.OUT && rowVertex.OUT[filesRelationshipType]) {
    const fileEdgeIds = rowVertex.OUT[filesRelationshipType];
    const seen = new Set();
    for (let edgeIndex = 0; edgeIndex < fileEdgeIds.length; edgeIndex++) {
      const edge = g.edges[fileEdgeIds[edgeIndex]];
      if (!edge?.E) continue;
      const targetVertex = g.vertexes[edge.E];
      if (targetVertex && !targetVertex.L?.includes(filesTargetLabel)) continue;
      const id = String(edge.E).trim();
      if (!id || seen.has(id)) continue;
      seen.add(id);
      imageFileIds.push(id);
    }
  }
  const rowPayload = {
    id: rowVertex.id,
    ..._.klona(rowVertex.P || {}),
    inventoryItemId,
    imageFileIds
  };
  delete rowPayload.images;
  if (parentElementIdProperty) delete rowPayload[parentElementIdProperty];
  return rowPayload;
};

// String validation: per-field props + optional formConfig.fieldValidationByKey[field.key] preset (field wins for defined keys)
const mergeValidationPreset = (field) => {
  if (!field?.key) return field;
  const preset = getFormConfig()?.fieldValidationByKey?.[field.key];
  if (!preset || typeof preset !== "object") return field;
  const out = { ...preset };
  for (const k in field) {
    if (Object.prototype.hasOwnProperty.call(field, k) && field[k] !== undefined) {
      out[k] = field[k];
    }
  }
  return out;
};

// Helper to get all fields from grouped form config
const getAllFields = () => {
  const formConfig = getFormConfig();
  if (!formConfig) return [];

  if (formConfig.groups && Array.isArray(formConfig.groups)) {
    const allFields = [];
    for (const group of formConfig.groups) {
      if (group.fields && Array.isArray(group.fields)) {
        allFields.push(...group.fields);
      }
    }
    return allFields;
  }

  return [];
};

/** Same rule as localizationHelpers.collectTranslatableFieldKeys / DynamicPage. */
const collectTranslatableFieldKeys = (formConfig) => {
  const keys = [];
  const groups = formConfig?.groups;
  if (!Array.isArray(groups)) return keys;
  for (let gi = 0; gi < groups.length; gi++) {
    const fields = groups[gi]?.fields;
    if (!Array.isArray(fields)) continue;
    for (let fi = 0; fi < fields.length; fi++) {
      const field = fields[fi];
      if (field?.translatable === true && field?.key) keys.push(String(field.key));
    }
  }
  return keys;
};

const getTranslationMeta = (rootLabel) => {
  const translationLabel = `${rootLabel}Translation`;
  return { translationLabel, edgeType: `${rootLabel}${translationLabel}` };
};

const getDefaultLanguageCode = (languages) => {
  const list = Array.isArray(languages) ? languages : [];
  const explicit = list.find((lang) => lang?.isDefault === true && lang?.code);
  if (explicit?.code) return String(explicit.code);
  const first = list.find((lang) => lang?.code);
  return first?.code ? String(first.code) : "en";
};

const isLocalizedMap = (value) =>
  value != null && typeof value === "object" && !Array.isArray(value);

/** Merge root default-language strings + {Label}Translation vertices into FormLocalizedText maps. */
const hydrateTranslationsOntoFormVertex = (txnId, formVertex, sourceVertex, vertexLabel) => {
  if (!formVertex?.id || !sourceVertex || !vertexLabel) return;
  const fieldKeys = collectTranslatableFieldKeys(getFormConfig());
  if (fieldKeys.length === 0) return;

  const languages = getSiteLanguages();
  const defaultCode = getDefaultLanguageCode(languages);
  const { translationLabel, edgeType } = getTranslationMeta(vertexLabel);

  const maps = {};
  for (let i = 0; i < fieldKeys.length; i++) {
    const key = fieldKeys[i];
    const normalized = {};
    for (let li = 0; li < languages.length; li++) {
      const code = languages[li]?.code;
      if (code) normalized[code] = "";
    }
    const rootVal = sourceVertex.P?.[key];
    if (isLocalizedMap(rootVal)) {
      for (const locale of Object.keys(rootVal)) {
        if (Object.prototype.hasOwnProperty.call(normalized, locale)) {
          normalized[locale] = rootVal[locale] == null ? "" : String(rootVal[locale]);
        }
      }
    } else if (rootVal != null && String(rootVal) !== "") {
      normalized[defaultCode] = String(rootVal);
    }
    maps[key] = normalized;
  }

  const edgeIds = sourceVertex.OUT?.[edgeType] || [];
  for (let ei = 0; ei < edgeIds.length; ei++) {
    const edge = g.edges[edgeIds[ei]];
    if (!edge?.E) continue;
    const translationVertex = g.vertexes[edge.E];
    if (!translationVertex?.L?.includes(translationLabel)) continue;
    const locale = translationVertex.P?.locale;
    if (locale == null || String(locale).trim() === "") continue;
    const localeCode = String(locale);
    for (let fi = 0; fi < fieldKeys.length; fi++) {
      const key = fieldKeys[fi];
      if (!maps[key]) continue;
      const text = translationVertex.P?.[key];
      if (text != null) maps[key][localeCode] = String(text);
    }
  }

  _.mergeVertexProperties(txnId, formVertex.id, g, sg, maps);
};

// Initialize form from vertex
const initializeForm = () => {
  const pendingTxn = formTxnId();
  if (pendingTxn && pendingTxn > 0) {
    _.revertTransaction(pendingTxn);
    setFormTxnId(0);
  }

  const formConfig = getFormConfig();
  const initialVertex = getInitialVertex();
  const mode = getMode();
  const vertexLabel = getVertexLabel();
  resetNestedLineMeta();
  setUploadedContentIds([]);

  const hasFields =
    Array.isArray(formConfig?.groups) &&
    formConfig.groups.some((g) => Array.isArray(g.fields) && g.fields.length > 0);
  if (!hasFields) {
    setFormVertexId(null);
    return;
  }

  // View mode: no graph mutation, just display initialVertex
  if (mode === "view" && initialVertex) {
    setFormVertexId(null);
    setErrors({});
    return;
  }

  if (mode === "edit" && initialVertex) {
    // Check if vertex exists in graph
    const existingVertex = g.vertexes[initialVertex.id];

    if (existingVertex) {
      // Clone vertex before editing so edits don't mutate the original until save
      const txnId = _.generateNewTxnId(g, sg);
      setFormTxnId(txnId);
      const clonedVertex = _.cloneVertexWithEdges(
        txnId,
        existingVertex,
        getClonePropertyOverrides(),
        g,
        sg,
      );
      setFormVertexId(clonedVertex.id);
      // cloneVertexWithEdges copies OUT only — fill incoming relation fields
      // from the source vertex's IN edges / hydrated props.
      hydrateIncomingRelationPropsOntoFormVertex(txnId, clonedVertex, existingVertex);
      hydrateTranslationsOntoFormVertex(txnId, clonedVertex, existingVertex, vertexLabel);
      hydrateNestedLineFields();
    } else {
      // Vertex doesn't exist in graph, create new vertex with initialVertex properties
      const txnId = _.generateNewTxnId(g, sg);
      setFormTxnId(txnId);

      const vertexId = _.generateNewVertexId(g, sg);

      const createdVertex = _.newVertex(vertexId, initialVertex.L || [vertexLabel], _.klona(initialVertex.P));

      // Add vertex to graph using addNewVertex
      _.addNewVertex(txnId, createdVertex, g, sg);

      // Store vertex ID instead of vertex object
      setFormVertexId(vertexId);
      hydrateIncomingRelationPropsOntoFormVertex(txnId, createdVertex, initialVertex);
      hydrateTranslationsOntoFormVertex(txnId, createdVertex, initialVertex, vertexLabel);
      hydrateNestedLineFields();
    }
  } else {
    // Create new vertex using newVertex and generateNewVertexId
    // Generate a new transaction ID (separate from vertex properties)
    const txnId = _.generateNewTxnId(g, sg);
    setFormTxnId(txnId);

    const vertexId = _.generateNewVertexId(g, sg);
    const initialProperties = {};

    // Initialize with default values from all fields
    const allFields = getAllFields();

    for (const field of allFields) {
      if (!isFieldVisible(field)) continue;
      if (getFieldRenderer(field) === "graphFileUpload") continue;
      if (getFieldRenderer(field) === "embeddedVertexPicker") continue;
      if (getFieldRenderer(field) === "nestedLineItems") continue;
      if (getFieldRenderer(field) === "fieldArray") {
        if (Array.isArray(field.defaultValue)) {
          initialProperties[field.key] = field.defaultValue;
        } else if (Array.isArray(field.fieldArrayConfig?.defaultItems)) {
          initialProperties[field.key] = field.fieldArrayConfig.defaultItems;
        } else {
          initialProperties[field.key] = [];
        }
        continue;
      }
      if (field.defaultValue !== undefined) {
        initialProperties[field.key] = field.defaultValue;
      } else {
        initialProperties[field.key] = "";
      }
    }

    const createdVertex = _.newVertex(vertexId, [vertexLabel], initialProperties);

    // Add vertex to graph using addNewVertex
    _.addNewVertex(txnId, createdVertex, g, sg);

    // Store vertex ID instead of vertex object
    setFormVertexId(vertexId);
    ensureNestedLineEmptyArrays();
  }

  setErrors({});
};

const applyAutoReferenceSequencesAfterAdd = async () => {
  const propsMode = getMode();
  if (propsMode !== "add" && propsMode !== "create") return;
  const vertexId = formVertexId();
  if (!vertexId) return;
  const allFields = getAllFields();
  const bySeqKey = new Map();
  for (let fi = 0; fi < allFields.length; fi++) {
    const field = allFields[fi];
    if (!isFieldVisible(field)) continue;
    const sk = field?.autoReferenceSequenceKey;
    if (!sk || typeof sk !== "string" || !field.key) continue;
    const seqKey = String(sk).trim();
    if (!seqKey) continue;
    if (!bySeqKey.has(seqKey)) bySeqKey.set(seqKey, []);
    bySeqKey.get(seqKey).push(field.key);
  }
  if (bySeqKey.size === 0) return;

  for (const [seqKey, fieldKeys] of bySeqKey.entries()) {
    try {
      const res = await s({
        functionName: "reserveWorkshopReferenceNumber",
        contextData: { sequenceKey: seqKey }
      });
      if (res?.error) {
        _.showErrorToast?.(String(res.error));
        continue;
      }
      const inner = res?.result;
      if (!inner?.success) {
        _.showErrorToast?.(inner?.message || "Failed to reserve reference number");
        continue;
      }
      const val = inner.data?.value;
      if (val == null) continue;
      const sval = String(val);
      for (let ki = 0; ki < fieldKeys.length; ki++) {
        setFieldValue(fieldKeys[ki], sval);
      }
    } catch (e) {
      _.showErrorToast?.(e?.message || "Failed to reserve reference number");
    }
  }
};

const getEdgeRelationshipTargets = (vertex, relationshipType, incoming = false) => {
  if (!vertex || !relationshipType || !g?.edges) return [];
  const eids = incoming
    ? vertex.IN?.[relationshipType]
    : vertex.OUT?.[relationshipType];
  if (!Array.isArray(eids) || eids.length === 0) return [];
  const ids = [];
  for (let i = 0; i < eids.length; i++) {
    const ed = g.edges[eids[i]];
    if (!ed) continue;
    const targetId = incoming ? ed.S : ed.E;
    if (targetId != null && String(targetId).trim() !== "") ids.push(String(targetId).trim());
  }
  return ids;
};

// Edit clones omit IN edges — copy incoming relation ids onto form vertex P for TomSelect/etc.
const hydrateIncomingRelationPropsOntoFormVertex = (txnId, formVertex, sourceVertex) => {
  if (!formVertex?.id || !sourceVertex) return;
  const patches = {};
  const allFields = getAllFields();
  for (let i = 0; i < allFields.length; i++) {
    const field = allFields[i];
    if (!isRelationField(field) || field.selectConfig?.incoming !== true) continue;
    const rel = field.selectConfig?.relationshipType;
    if (!rel || !field.key) continue;
    const existing = formVertex.P?.[field.key];
    if (existing != null && String(existing).trim() !== "") continue;
    const fromSourceProp = sourceVertex.P?.[field.key];
    if (fromSourceProp != null && String(fromSourceProp).trim() !== "") {
      patches[field.key] = String(fromSourceProp).trim();
      continue;
    }
    const ids = getEdgeRelationshipTargets(sourceVertex, rel, true);
    if (ids.length > 0) patches[field.key] = ids[0];
  }
  if (Object.keys(patches).length === 0) return;
  _.mergeVertexProperties(txnId, formVertex.id, g, sg, patches);
};

const vertexOutEdgeContainsTarget = (vertex, relationshipType, targetVertexId) => {
  const outEdges = vertex?.OUT?.[relationshipType];
  if (!Array.isArray(outEdges) || !g?.edges) return false;
  const target = String(targetVertexId).trim();
  for (let i = 0; i < outEdges.length; i++) {
    const edge = g.edges[outEdges[i]];
    if (edge && String(edge.E).trim() === target) return true;
  }
  return false;
};

const setEdgeRelationshipTargets = (txnId, vertex, relationshipType, targetIds) => {
  if (!vertex?.id || !relationshipType) return;
  const normalizedIds = (
    Array.isArray(targetIds)
      ? targetIds
      : targetIds != null && String(targetIds).trim() !== ""
        ? [String(targetIds).trim()]
        : []
  )
    .map((id) => String(id).trim())
    .filter((id) => id !== "");
  const previousEdgeIds = Array.isArray(vertex.OUT?.[relationshipType])
    ? [...vertex.OUT[relationshipType]]
    : [];
  for (let i = 0; i < previousEdgeIds.length; i++) {
    const edgeId = previousEdgeIds[i];
    const edge = g.edges[edgeId];
    if (!edge) continue;
    if (normalizedIds.includes(String(edge.E).trim())) continue;
    _.deleteEdge(txnId, edgeId, g, sg);
  }
  const liveVertex = g.vertexes[vertex.id] || vertex;
  for (let j = 0; j < normalizedIds.length; j++) {
    const targetVertexId = normalizedIds[j];
    if (!g.vertexes[targetVertexId]) continue;
    if (vertexOutEdgeContainsTarget(liveVertex, relationshipType, targetVertexId)) continue;
    _.addNewEdge(
      txnId,
      _.newEdge(
        _.generateNewVertexId(g, sg),
        relationshipType,
        {},
        liveVertex.id,
        targetVertexId
      ),
      g,
      sg
    );
  }
};

const fieldUsesEdgeOnlyRelationship = (field) =>
  !!(
    field &&
    field.selectConfig?.relationshipType &&
    field.selectConfig.edgeOnly === true &&
    field.selectConfig.propertyOnly !== true
  );

const embeddedVertexPickerUsesRelationshipEdge = (field) =>
  getFieldRenderer(field) === "embeddedVertexPicker" &&
  field?.selectConfig?.relationshipType;

// Get form field value from vertex
const getFieldValue = (fieldKey) => {
  const vertex = getFormVertex();
  if (!vertex) return "";
  const field = getAllFields().find((f) => f.key === fieldKey);
  if (getFieldRenderer(field) === "graphFileUpload") return "";
  if (
    field &&
    (getFieldRenderer(field) === "multiSelect" || field.multiSelect === true) &&
    fieldUsesEdgeOnlyRelationship(field)
  ) {
    return getEdgeRelationshipTargets(
      vertex,
      field.selectConfig.relationshipType,
      field.selectConfig.incoming === true
    );
  }
  if (field && isRelationField(field) && field.selectConfig?.incoming === true && field.selectConfig?.relationshipType) {
    const fromProp = vertex?.P?.[fieldKey];
    if (fromProp != null && String(fromProp).trim() !== "") return String(fromProp).trim();
    const ids = getEdgeRelationshipTargets(vertex, field.selectConfig.relationshipType, true);
    return ids.length > 0 ? ids[0] : "";
  }
  if (field && isRelationField(field) && fieldUsesEdgeOnlyRelationship(field)) {
    const ids = getEdgeRelationshipTargets(vertex, field.selectConfig.relationshipType);
    return ids.length > 0 ? ids[0] : "";
  }
  if (embeddedVertexPickerUsesRelationshipEdge(field)) {
    const ids = getEdgeRelationshipTargets(vertex, field.selectConfig.relationshipType);
    const selectionMode =
      field.pickerConfiguration?.selectionMode === "multiple" ? "multiple" : "single";
    if (selectionMode === "multiple") return ids;
    return ids.length > 0 ? ids[0] : "";
  }
  if (getFieldRenderer(field) === "embeddedVertexPicker") {
    return "";
  }
  if (getFieldRenderer(field) === "fieldArray") {
    const rawValue = vertex?.P?.[fieldKey];
    if (Array.isArray(rawValue)) return rawValue;
    if (typeof rawValue === "string" && rawValue.trim() !== "") {
      try {
        const parsed = JSON.parse(rawValue);
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    }
    return [];
  }
  return vertex?.P?.[fieldKey] ?? "";
};

// Set form field value in vertex using mergeVertexProperties
const setFieldValue = (fieldKey, value) => {
  const nestedField = getAllFields().find((f) => f.key === fieldKey);
  if (getFieldRenderer(nestedField) === "nestedLineItems") return;
  if (getFieldRenderer(nestedField) === "graphFileUpload") return;
  const vertexId = formVertexId();
  if (!vertexId) return;

  // Get or generate txnId (separate variable, not stored in vertex)
  let txnId = formTxnId();
  if (!txnId || txnId === 0) {
    txnId = _.generateNewTxnId(g, sg);
    setFormTxnId(txnId);
  }

  if (getFieldRenderer(nestedField) === "embeddedVertexPicker") {
    if (embeddedVertexPickerUsesRelationshipEdge(nestedField)) {
      const formVertex = g.vertexes[vertexId];
      if (!formVertex) return;
      const selectionMode =
        nestedField.pickerConfiguration?.selectionMode === "multiple" ? "multiple" : "single";
      const targetIds =
        selectionMode === "multiple"
          ? Array.isArray(value)
            ? value
            : value != null && String(value).trim() !== ""
              ? [String(value).trim()]
              : []
          : value;
      setEdgeRelationshipTargets(
        txnId,
        formVertex,
        nestedField.selectConfig.relationshipType,
        targetIds
      );
      const onFieldChange = c.props?.onFieldChange;
      if (typeof onFieldChange === "function") {
        onFieldChange(fieldKey, value);
      }
    } else {
      // propertyOnly picker: store id or id[] on the vertex property
      _.mergeVertexProperties(txnId, vertexId, g, sg, {
        [fieldKey]: value
      });
      const onFieldChange = c.props?.onFieldChange;
      if (typeof onFieldChange === "function") {
        onFieldChange(fieldKey, value);
      }
    }
    return;
  }

  // Use mergeVertexProperties to update vertex in graph
  // The vertex will be automatically updated in the graph
  _.mergeVertexProperties(txnId, vertexId, g, sg, { [fieldKey]: value });

  const onFieldChange = c.props?.onFieldChange;
  if (typeof onFieldChange === "function") {
    onFieldChange(fieldKey, value);
  }
};

// Validate form
const validate = () => {
  const vertex = getFormVertex();
  const allFields = getAllFields();

  if (allFields.length === 0 || !vertex) return true;

  const newErrors = {};
  for (const field of allFields) {
    if (!isFieldVisible(field)) continue;
    if (getFieldRenderer(field) === "graphFileUpload") {
      if (isFieldRequired(field)) {
        const formVertex = getFormVertex();
        const vertexId = formVertex?.id != null ? String(formVertex.id).trim() : "";
        const isLocalDraft = vertexId === "" || vertexId.startsWith("-");
        const uploadedName =
          formVertex?.P?.fileName != null ? String(formVertex.P.fileName).trim() : "";
        if (isLocalDraft || uploadedName === "") {
          const multi = field.uploadConfiguration?.multiple === true;
          newErrors[field.key] = multi ? "Please upload at least one file" : "Please upload a file";
        }
      }
      continue;
    }
    const value = embeddedVertexPickerUsesRelationshipEdge(field)
      ? getFieldValue(field.key)
      : vertex.P[field.key];
    const rules = mergeValidationPreset(field);

    if (isFieldRequired(field) && (getFieldRenderer(field) === "multiSelect" || field.multiSelect === true)) {
      let multiSelectValue = vertex.P[field.key];
      if (fieldUsesEdgeOnlyRelationship(field)) {
        if (multiSelectValue === undefined || multiSelectValue === null) {
          multiSelectValue = getEdgeRelationshipTargets(vertex, field.selectConfig.relationshipType);
        }
      }
      const ok = Array.isArray(multiSelectValue)
        ? multiSelectValue.length > 0
        : multiSelectValue != null && String(multiSelectValue).trim() !== "";
      if (!ok) {
        newErrors[field.key] = `${field.label || field.key}: select at least one`;
      }
      continue;
    }

    if (getFieldRenderer(field) === "nestedLineItems" && isFieldRequired(field)) {
      const rows = getNestedLineVerticesForField(field);
      if (rows.length === 0) {
        newErrors[field.key] = `${field.label || field.key}: add at least one line`;
        continue;
      }
      const lineColumns = Array.isArray(field.nestedLineItemsConfig?.lineColumns)
        ? field.nestedLineItemsConfig.lineColumns
        : [];
      for (let rowIndex = 0; rowIndex < rows.length; rowIndex++) {
        const rowVertex = rows[rowIndex];
        for (let columnIndex = 0; columnIndex < lineColumns.length; columnIndex++) {
          const columnDef = lineColumns[columnIndex];
          if (!columnDef?.key) continue;
          if (columnDef.columnType === "actions" || columnDef.columnType === "inventory") continue;

          if (columnDef.columnType === "files") {
            if (!columnDef.required) continue;
            const filesRelationshipType =
              field.nestedLineItemsConfig?.childToFilesRelationshipType;
            const filesTargetLabel =
              field.nestedLineItemsConfig?.filesTargetLabel || "File";
            let hasImages = false;
            if (filesRelationshipType && rowVertex?.OUT?.[filesRelationshipType]) {
              const fileEdgeIds = rowVertex.OUT[filesRelationshipType];
              for (let edgeIndex = 0; edgeIndex < fileEdgeIds.length; edgeIndex++) {
                const edge = g.edges[fileEdgeIds[edgeIndex]];
                if (!edge?.E) continue;
                const targetVertex = g.vertexes[edge.E];
                if (targetVertex && !targetVertex.L?.includes(filesTargetLabel)) continue;
                hasImages = true;
                break;
              }
            }
            if (!hasImages) {
              newErrors[field.key] = `${field.label || field.key} ${rowIndex + 1}: ${columnDef.label || columnDef.key} is required`;
              break;
            }
            continue;
          }

          if (columnDef.columnType === "optionPairs") {
            const axesFieldKey =
              columnDef.optionAxesFieldKey != null &&
              String(columnDef.optionAxesFieldKey).trim() !== ""
                ? String(columnDef.optionAxesFieldKey).trim()
                : "optionAxes";
            let axes = [];
            const axesRaw = getFieldValue(axesFieldKey);
            if (Array.isArray(axesRaw)) axes = axesRaw;
            else if (typeof axesRaw === "string" && axesRaw.trim() !== "") {
              try {
                const parsed = JSON.parse(axesRaw);
                axes = Array.isArray(parsed) ? parsed : [];
              } catch {
                axes = [];
              }
            }
            // No option types → options are optional (single-SKU / first-variant products).
            if (axes.length === 0) continue;
            let missingOption = false;
            for (let axisIndex = 0; axisIndex < axes.length; axisIndex++) {
              const axisKey =
                axes[axisIndex]?.key != null ? String(axes[axisIndex].key).trim() : "";
              if (!axisKey) continue;
              const optionValue = rowVertex?.P?.[axisKey];
              if (optionValue === undefined || optionValue === null || String(optionValue).trim() === "") {
                missingOption = true;
                break;
              }
            }
            if (missingOption) {
              newErrors[field.key] = `${field.label || field.key} ${rowIndex + 1}: ${columnDef.label || "Options"} is required`;
              break;
            }
            continue;
          }

          if (!columnDef.required || String(columnDef.key).startsWith("_")) continue;
          const cellValue = rowVertex?.P?.[columnDef.key];
          if (cellValue === undefined || cellValue === null || String(cellValue).trim() === "") {
            newErrors[field.key] = `${field.label || field.key} ${rowIndex + 1}: ${columnDef.label || columnDef.key} is required`;
            break;
          }
        }
        if (newErrors[field.key]) break;
      }
      continue;
    }

    if (getFieldRenderer(field) === "fieldArray") {
      const items = getFieldValue(field.key);
      const itemFields = field.fieldArrayConfig?.itemFields || [];
      if (isFieldRequired(field) && (!Array.isArray(items) || items.length === 0)) {
        newErrors[field.key] = `${field.label || field.key}: add at least one item`;
        continue;
      }
      if (Array.isArray(items)) {
        for (let itemIndex = 0; itemIndex < items.length; itemIndex++) {
          const item = items[itemIndex] || {};
          for (let fieldIndex = 0; fieldIndex < itemFields.length; fieldIndex++) {
            const itemField = itemFields[fieldIndex];
            if (!itemField?.required || !itemField?.key) continue;
            const itemValue = item[itemField.key];
            if (itemField.renderer === "fieldArray") {
              if (!Array.isArray(itemValue) || itemValue.length === 0) {
                newErrors[field.key] = `${field.label || field.key} ${itemIndex + 1}: ${itemField.label || itemField.key} is required`;
                break;
              }
              const nestedItemFields = itemField.fieldArrayConfig?.itemFields || [];
              for (let nestedIndex = 0; nestedIndex < itemValue.length; nestedIndex++) {
                const nestedItem = itemValue[nestedIndex] || {};
                for (let nestedFieldIndex = 0; nestedFieldIndex < nestedItemFields.length; nestedFieldIndex++) {
                  const nestedField = nestedItemFields[nestedFieldIndex];
                  if (!nestedField?.required || !nestedField?.key) continue;
                  const nestedValue = nestedItem[nestedField.key];
                  if (nestedValue === undefined || nestedValue === null || String(nestedValue).trim() === "") {
                    newErrors[field.key] = `${field.label || field.key} ${itemIndex + 1}: ${nestedField.label || nestedField.key} is required`;
                    break;
                  }
                }
                if (newErrors[field.key]) break;
              }
              if (newErrors[field.key]) break;
              continue;
            }
            if (itemField.renderer === "embeddedVertexPicker") {
              const isMultiple = itemField.pickerConfiguration?.selectionMode === "multiple";
              const hasImages = isMultiple
                ? Array.isArray(itemValue) && itemValue.length > 0
                : itemValue != null && String(itemValue).trim() !== "";
              if (!hasImages) {
                newErrors[field.key] = `${field.label || field.key} ${itemIndex + 1}: ${itemField.label || itemField.key} is required`;
                break;
              }
              continue;
            }
            if (itemValue === undefined || itemValue === null || String(itemValue).trim() === "") {
              newErrors[field.key] = `${field.label || field.key} ${itemIndex + 1}: ${itemField.label || itemField.key} is required`;
              break;
            }
          }
          if (newErrors[field.key]) break;
        }
      }
      continue;
    }

    if (isFieldRequired(field) && (value === undefined || value === null || value === "")) {
      newErrors[field.key] = `${field.label || field.key} is required`;
    }

    if (getFieldDataType(field) === "email" && value) {
      const trimmedEmail = String(value).trim();
      if (
        trimmedEmail &&
        !new RegExp("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$").test(trimmedEmail)
      ) {
        newErrors[field.key] = "Invalid email format";
      }
    }

    if (!newErrors[field.key] && rules.minLength && value && String(value).length < rules.minLength) {
      newErrors[field.key] =
        typeof rules.minLengthMessage === "string" && rules.minLengthMessage.trim()
          ? rules.minLengthMessage.trim()
          : `Must be at least ${rules.minLength} characters`;
    }

    if (!newErrors[field.key] && rules.maxLength && value && String(value).length > rules.maxLength) {
      newErrors[field.key] =
        typeof rules.maxLengthMessage === "string" && rules.maxLengthMessage.trim()
          ? rules.maxLengthMessage.trim()
          : `Must be at most ${rules.maxLength} characters`;
    }

    if (!newErrors[field.key] && rules.pattern && value) {
      const valueString = String(value);
      let patternRegex = null;
      try {
        patternRegex = new RegExp(rules.pattern);
      } catch (e) {
        console.warn("FormManagement: invalid rules.pattern for field", field.key, rules.pattern);
      }
      if (patternRegex && !patternRegex.test(valueString)) {
        newErrors[field.key] =
          typeof rules.patternMessage === "string" && rules.patternMessage.trim()
            ? rules.patternMessage.trim()
            : "Invalid format";
      }
    }

    if (!newErrors[field.key]) {
      const customErr = evalFieldCustomValidate(field, value);
      if (customErr) newErrors[field.key] = customErr;
    }
  }

  setErrors(newErrors);
  return Object.keys(newErrors).length === 0;
};

// Handle save
const handleSave = async () => {
  if (isFileUploading()) {
    _.showErrorToast?.("Please wait for the file upload to finish");
    return;
  }

  if (!validate()) {
    _.showErrorToast?.("Please fix form errors");
    return;
  }

  const onSave = c.props?.onSave;
  if (!onSave) {
    _.showErrorToast?.("Save function not provided");
    return;
  }

  const vertex = getFormVertex();
  if (!vertex) {
    _.showErrorToast?.("Form data not initialized");
    return;
  }

  setIsSubmitting(true);
  try {
    // Use vertex directly instead of converting
    const relationshipData = {};
    const allFields = getAllFields();

    if (allFields.length > 0) {
      for (const field of allFields) {
        if (!isFieldVisible(field)) continue;
        if (getFieldRenderer(field) === "graphFileUpload") continue;
        if (embeddedVertexPickerUsesRelationshipEdge(field)) {
          const pickerConfiguration = field.pickerConfiguration;
          const selectionMode =
            pickerConfiguration?.selectionMode === "multiple" ? "multiple" : "single";
          const fromEdges = getEdgeRelationshipTargets(
            vertex,
            field.selectConfig.relationshipType
          );
          relationshipData[field.key] = {
            relationshipType: field.selectConfig.relationshipType,
            targetLabel: field.selectConfig.label,
            targetIds: selectionMode === "multiple" ? fromEdges : fromEdges.slice(0, 1),
            incoming: field.selectConfig.incoming === true
          };
          continue;
        }
        if (getFieldRenderer(field) === "embeddedVertexPicker") continue;
        if (
          (getFieldRenderer(field) === "multiSelect" || field.multiSelect === true) &&
          field.selectConfig &&
          !field.selectConfig.propertyOnly
        ) {
          let raw = vertex.P[field.key];
          if (fieldUsesEdgeOnlyRelationship(field)) {
            const fromEdges = getEdgeRelationshipTargets(
              vertex,
              field.selectConfig.relationshipType
            );
            if (raw === undefined || raw === null) {
              raw = fromEdges;
            }
          }
          const ids = Array.isArray(raw)
            ? raw.map((entry) => String(entry).trim()).filter((trimmedId) => trimmedId !== "")
            : raw != null && String(raw).trim() !== ""
              ? [String(raw).trim()]
              : [];
          relationshipData[field.key] = {
            relationshipType: field.selectConfig.relationshipType,
            targetLabel: field.selectConfig.label,
            targetIds: ids,
            incoming: field.selectConfig.incoming === true
          };
          continue;
        }
        if (isRelationField(field) && field.selectConfig && !field.selectConfig.propertyOnly) {
          const selectedId = vertex.P[field.key];
          const trimmedId =
            selectedId != null && String(selectedId).trim() !== ""
              ? String(selectedId).trim()
              : null;
          relationshipData[field.key] = {
            relationshipType: field.selectConfig.relationshipType,
            targetLabel: field.selectConfig.label,
            targetIds: trimmedId ? [trimmedId] : [],
            incoming: field.selectConfig.incoming === true
          };
        }
      }
    }

    const nestedLineSync = {};
    const nMeta = nestedLineMeta();
    for (const field of allFields) {
      if (!isFieldVisible(field)) continue;
      if (getFieldRenderer(field) !== "nestedLineItems" || !field.nestedLineItemsConfig) continue;
      const nestedLineItemsConfig = field.nestedLineItemsConfig;
      nestedLineSync[field.key] = {
        childLabel: nestedLineItemsConfig.childLabel,
        parentToChildRelationshipType: nestedLineItemsConfig.parentToChildRelationshipType,
        childToInventoryRelationshipType:
          nestedLineItemsConfig.childToInventoryRelationshipType || null,
        inventoryTargetLabel: nestedLineItemsConfig.inventoryTargetLabel || "InventoryItem",
        childToFilesRelationshipType:
          nestedLineItemsConfig.childToFilesRelationshipType || null,
        filesTargetLabel: nestedLineItemsConfig.filesTargetLabel || "File",
        parentElementIdPropOnChild: nestedLineItemsConfig.parentElementIdPropOnChild,
        nestedLineItemsSyncRules: nestedLineItemsConfig.nestedLineItemsSyncRules || null,
        rows: getNestedLineVerticesForField(field).map((rowVertex) =>
          buildNestedLineRowPayload(rowVertex, nestedLineItemsConfig)
        ),
        deletedLineIds: nMeta.deletedIdsByField[field.key] || []
      };
    }

    const result = await onSave({
      vertex: vertex,
      relationships: relationshipData,
      nestedLineSync,
      uploadedContentIds: uploadedContentIds()
    });

    // Clean up only after successful save (when onSave returns truthy)
    if (result) {
      const txnId = formTxnId();
      if (txnId && txnId > 0) {
        _.revertTransaction(txnId);
        setFormTxnId(0);
      }
      const afterSuccessfulSave = c.props?.afterSuccessfulSave;
      if (afterSuccessfulSave === "reinitialize") {
        initializeForm();
      } else {
        setFormVertexId(null);
      }
    }
    return result;
  } catch (error) {
    console.error("Error saving:", error);
    _.showErrorToast?.("Failed to save");
    return false;
  } finally {
    setIsSubmitting(false);
  }
};

// Tooltip / help: tooltip | helpText | description (first non-empty string wins)
// Floating panel (ⓘ hover): tooltipDisplay "native" | "both" (default native); tooltipIcon: false disables ⓘ
// tooltipTitle overrides body text in the floating panel; tooltipShortcut appended as (shortcut)
// tooltipDisplay "below" | "both": extra helper line under label; tooltipPlacement passed to Floating UI (e.g. top, bottom-start)
// tooltipDelay reserved; showTooltip: false disables all help UI
const pickHelpString = (...vals) => {
  for (const candidate of vals) {
    if (typeof candidate === "string" && candidate.trim()) return candidate.trim();
  }
  return "";
};

const getFieldTooltipMeta = (field) => {
  const empty = {
    body: "",
    floatingHelpText: "",
    showFloatingHelp: false,
    ariaDescription: "",
    showBelow: false,
    placement: "top",
    delayMs: null,
    shortcut: ""
  };
  if (!field || field.showTooltip === false) return empty;

  const body = pickHelpString(field.tooltip, field.helpText, field.description);
  if (!body) return empty;

  const titleOverride = pickHelpString(field.tooltipTitle);
  const panelBase = titleOverride || body;
  const ariaDescription = pickHelpString(field.ariaDescription) || body;
  const shortcut = pickHelpString(field.tooltipShortcut);
  const floatingHelpText = shortcut ? `${panelBase} (${shortcut})` : panelBase;
  const placement = typeof field.tooltipPlacement === "string" ? field.tooltipPlacement : "top";
  const delayMs = typeof field.tooltipDelay === "number" ? field.tooltipDelay : null;
  const mode = field.tooltipDisplay || "native";
  const showBelow = mode === "below" || mode === "both";
  const showFloatingPanel = mode === "native" || mode === "both";
  const showFloatingHelp = showFloatingPanel && field.tooltipIcon !== false;

  return {
    body,
    floatingHelpText,
    showFloatingHelp,
    ariaDescription,
    showBelow,
    placement,
    delayMs,
    shortcut
  };
};

// Expose fns to parent if onFnsReady callback is provided
const onFnsReady = c.props?.onFnsReady;
let lastReadyVertexId = null;
if (onFnsReady && typeof onFnsReady === "function") {
  _.createEffect(() => {
    const vertexId = formVertexId();
    if (vertexId == null || vertexId === lastReadyVertexId) return;
    lastReadyVertexId = vertexId;
    onFnsReady({
