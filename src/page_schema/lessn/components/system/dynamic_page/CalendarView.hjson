{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: CalendarView
        description: Month/week calendar for DynamicPage rows keyed by a configured date or date-time column. Drag events between days or hours to update the row vertex.
        dynamicComponent: Button, LoadingSpinner, Html, TableModal
        fns:
          '''
const calendarStateVertexId = _.generateNewVertexId(g, sg);
_.addNewVertex(0, {
  id: calendarStateVertexId,
  L: ["CalendarViewUiState"],
  P: {
    cursorYear: null,
    cursorMonth: null,
    cursorWeekStart: null,
    layout: null,
    dragOverDayKey: null,
    dragOverHourKey: null,
    loading: false,
    isModalOpen: false,
    modalMode: "edit",
    formData: null,
    editingRow: null,
    selectedEventIds: [],
    focusedDayKey: null,
    showUnscheduled: true,
    eventsCacheEpoch: 0
  },
  IN: {},
  OUT: {}
}, g, sg);

const patchCalP = (partial) => {
  _.mergeVertexProperties(0, calendarStateVertexId, g, sg, partial);
};
const calP = () => g.vertexes[calendarStateVertexId]?.P;

const WEEKDAY_LABELS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
const HOUR_START = 0;
const HOUR_END = 23;

const EVENT_COLOR_PALETTE = [
  { bg: "oklch(0.62 0.16 250)", fg: "oklch(0.98 0.01 250)" },
  { bg: "oklch(0.65 0.15 145)", fg: "oklch(0.15 0.02 145)" },
  { bg: "oklch(0.70 0.14 50)", fg: "oklch(0.18 0.02 50)" },
  { bg: "oklch(0.60 0.17 25)", fg: "oklch(0.98 0.01 25)" },
  { bg: "oklch(0.58 0.14 300)", fg: "oklch(0.98 0.01 300)" },
  { bg: "oklch(0.66 0.12 200)", fg: "oklch(0.15 0.02 200)" },
  { bg: "oklch(0.55 0.10 0)", fg: "oklch(0.98 0.01 0)" },
  { bg: "oklch(0.68 0.13 330)", fg: "oklch(0.15 0.02 330)" }
];

const pad2 = (n) => String(n).padStart(2, "0");

const toDateKey = (date) => {
  if (!(date instanceof Date) || Number.isNaN(date.getTime())) return null;
  return `${date.getFullYear()}-${pad2(date.getMonth() + 1)}-${pad2(date.getDate())}`;
};

const parseDateValue = (value) => {
  if (value == null || value === "") return null;
  if (value instanceof Date) {
    return Number.isNaN(value.getTime()) ? null : value;
  }
  const asString = String(value).trim();
  if (!asString) return null;
  if (/^\d{4}-\d{2}-\d{2}$/.test(asString)) {
    const parts = asString.split("-").map(Number);
    const local = new Date(parts[0], parts[1] - 1, parts[2], 0, 0, 0, 0);
    return Number.isNaN(local.getTime()) ? null : local;
  }
  const parsed = new Date(asString);
  return Number.isNaN(parsed.getTime()) ? null : parsed;
};

const startOfWeek = (date) => {
  const d = new Date(date.getFullYear(), date.getMonth(), date.getDate(), 0, 0, 0, 0);
  d.setDate(d.getDate() - d.getDay());
  return d;
};

const addDays = (date, days) => {
  const d = new Date(date.getFullYear(), date.getMonth(), date.getDate(), 0, 0, 0, 0);
  d.setDate(d.getDate() + days);
  return d;
};

const eachDateKeyInclusive = (startDate, endDate) => {
  const keys = [];
  if (!startDate) return keys;
  let cur = new Date(startDate.getFullYear(), startDate.getMonth(), startDate.getDate());
  const end = endDate
    ? new Date(endDate.getFullYear(), endDate.getMonth(), endDate.getDate())
    : cur;
  if (end.getTime() < cur.getTime()) {
    keys.push(toDateKey(cur));
    return keys;
  }
  while (cur.getTime() <= end.getTime()) {
    keys.push(toDateKey(cur));
    cur = addDays(cur, 1);
  }
  return keys;
};

const ensureCursorInitialized = () => {
  const p = calP();
  if (p?.cursorYear != null && p?.cursorMonth != null) {
    if (!focusedDayKeyLocal && p?.focusedDayKey) focusedDayKeyLocal = p.focusedDayKey;
    return;
  }
  const now = new Date();
  const key = toDateKey(now);
  focusedDayKeyLocal = key;
  patchCalP({
    cursorYear: now.getFullYear(),
    cursorMonth: now.getMonth(),
    cursorWeekStart: toDateKey(startOfWeek(now)),
    focusedDayKey: key
  });
};

const getLayout = () => {
  const fromUrl = f.getCalendarLayoutFromUrl?.();
  let layout = null;
  if (fromUrl === "month" || fromUrl === "week") layout = fromUrl;
  else {
    const stored = calP()?.layout;
    if (stored === "month" || stored === "week") layout = stored;
  }
  if (!layout) {
    const cfg = f.getCalendarConfig?.() || {};
    layout = cfg.defaultView === "week" ? "week" : "month";
  }
  if (layout === "week" && f.isCalendarDateTimeField?.() !== true) return "month";
  return layout;
};

const setLayout = (layout) => {
  if (layout !== "month" && layout !== "week") return;
  patchCalP({ layout });
  f.setCalendarLayoutInUrl?.(layout);
};

const getCursorDate = () => {
  ensureCursorInitialized();
  const p = calP();
  return new Date(p.cursorYear, p.cursorMonth, 1, 0, 0, 0, 0);
};

const getWeekStartDate = () => {
  ensureCursorInitialized();
  const key = calP()?.cursorWeekStart;
  const parsed = parseDateValue(key);
  if (parsed) return startOfWeek(parsed);
  return startOfWeek(new Date());
};

const goToday = () => {
  const now = new Date();
  const key = toDateKey(now);
  focusedDayKeyLocal = key;
  patchCalP({
    cursorYear: now.getFullYear(),
    cursorMonth: now.getMonth(),
    cursorWeekStart: toDateKey(startOfWeek(now)),
    focusedDayKey: key
  });
};

const goPrev = () => {
  if (getLayout() === "week") {
    const start = getWeekStartDate();
    start.setDate(start.getDate() - 7);
    const key = toDateKey(start);
    focusedDayKeyLocal = key;
    patchCalP({
      cursorWeekStart: toDateKey(start),
      cursorYear: start.getFullYear(),
      cursorMonth: start.getMonth(),
      focusedDayKey: key
    });
    return;
  }
  const d = getCursorDate();
  d.setMonth(d.getMonth() - 1);
  const key = toDateKey(d);
  focusedDayKeyLocal = key;
  patchCalP({
    cursorYear: d.getFullYear(),
    cursorMonth: d.getMonth(),
    cursorWeekStart: toDateKey(startOfWeek(d)),
    focusedDayKey: key
  });
};

const goNext = () => {
  if (getLayout() === "week") {
    const start = getWeekStartDate();
    start.setDate(start.getDate() + 7);
    const key = toDateKey(start);
    focusedDayKeyLocal = key;
    patchCalP({
      cursorWeekStart: toDateKey(start),
      cursorYear: start.getFullYear(),
      cursorMonth: start.getMonth(),
      focusedDayKey: key
    });
    return;
  }
  const d = getCursorDate();
  d.setMonth(d.getMonth() + 1);
  const key = toDateKey(d);
  focusedDayKeyLocal = key;
  patchCalP({
    cursorYear: d.getFullYear(),
    cursorMonth: d.getMonth(),
    cursorWeekStart: toDateKey(startOfWeek(d)),
    focusedDayKey: key
  });
};

const getHeaderLabel = () => {
  if (getLayout() === "week") {
    const start = getWeekStartDate();
    const end = new Date(start);
    end.setDate(end.getDate() + 6);
    const startLabel = start.toLocaleDateString(undefined, { month: "short", day: "numeric" });
    const endLabel = end.toLocaleDateString(undefined, {
      month: "short",
      day: "numeric",
      year: "numeric"
    });
    return `${startLabel} – ${endLabel}`;
  }
  const d = getCursorDate();
  return d.toLocaleDateString(undefined, { month: "long", year: "numeric" });
};

const isDateTimeColumn = () => f.isCalendarDateTimeField?.() === true;

const getEventTitle = (row) => {
  const cfg = f.getCalendarConfig?.() || {};
  const titleField = cfg.titleField;
  if (titleField && row?.P?.[titleField] != null && String(row.P[titleField]).trim() !== "") {
    return String(row.P[titleField]).trim();
  }
  const fallbacks = ["title", "name", "fileName", "key", "subject", "label"];
  for (let i = 0; i < fallbacks.length; i++) {
    const v = row?.P?.[fallbacks[i]];
    if (v != null && String(v).trim() !== "") return String(v).trim();
  }
  return row?.id != null ? String(row.id) : "Item";
};

const hashString = (str) => {
  let h = 0;
  const s = String(str || "");
  for (let i = 0; i < s.length; i++) {
    h = (h << 5) - h + s.charCodeAt(i);
    h |= 0;
  }
  return Math.abs(h);
};

const getEventColors = (row) => {
  const cfg = f.getCalendarConfig?.() || {};
  const colorField = cfg.colorField;
  if (!colorField) return null;
  const raw = row?.P?.[colorField];
  if (raw == null || String(raw).trim() === "") return null;
  const asString = String(raw).trim();
  if (
    asString.startsWith("#") ||
    asString.startsWith("oklch(") ||
    asString.startsWith("rgb") ||
    asString.startsWith("hsl")
  ) {
    return { bg: asString, fg: t?.var?.color?.primary_text || "#fff" };
  }
  const idx = hashString(asString) % EVENT_COLOR_PALETTE.length;
  return EVENT_COLOR_PALETTE[idx];
};

const getEventChipStyle = (event) => {
  const colors = event?.colors || getEventColors(event?.row);
  if (!colors) return "";
  return `background:${colors.bg};color:${colors.fg};`;
};

const getRowDate = (row) => {
  const field = f.getCalendarDateField?.();
  if (!field) return null;
  return parseDateValue(row?.P?.[field]);
};

const getRowEndDate = (row) => {
  const field = f.getCalendarEndDateField?.() || f.getCalendarConfig?.()?.endDateField;
  if (!field) return null;
  return parseDateValue(row?.P?.[field]);
};

const hasEndDateField = () => {
  const field = f.getCalendarEndDateField?.() || f.getCalendarConfig?.()?.endDateField;
  return !!(field && String(field).trim());
};

const getCalendarRows = () => {
  const rows =
    typeof f.getMainTableRowVertices === "function" ? f.getMainTableRowVertices() : [];
  return Array.isArray(rows) ? rows : [];
};

const buildEventObject = (row, dayKey, segment, startKey, endKey) => {
  const date = getRowDate(row);
  return {
    id: row.id,
    title: getEventTitle(row),
    date,
    hour: date ? date.getHours() : 0,
    dayKey,
    segment: segment || "single",
    startKey,
    endKey,
    colors: getEventColors(row),
    row,
    canResizeStart: hasEndDateField() && (segment === "start" || segment === "single"),
    canResizeEnd: hasEndDateField() && (segment === "end" || segment === "single")
  };
};

const buildEventsByDayMap = () => {
  const map = Object.create(null);
  const rows = getCalendarRows();
  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    const start = getRowDate(row);
    if (!start) continue;
    const end = getRowEndDate(row) || start;
    const startKey = toDateKey(start);
    const endKey = toDateKey(end);
    const keys = eachDateKeyInclusive(start, end);
    for (let k = 0; k < keys.length; k++) {
      const key = keys[k];
      if (!key) continue;
      let segment = "single";
      if (keys.length > 1) {
        if (k === 0) segment = "start";
        else if (k === keys.length - 1) segment = "end";
        else segment = "middle";
      }
      if (!map[key]) map[key] = [];
      map[key].push(buildEventObject(row, key, segment, startKey, endKey));
    }
  }
  const keys = Object.keys(map);
  for (let i = 0; i < keys.length; i++) {
    map[keys[i]].sort((a, b) => {
      const at = a.date?.getTime?.() || 0;
      const bt = b.date?.getTime?.() || 0;
      return at - bt;
    });
  }
  return map;
};

const getEventsForDayKey = (dayKey, byDay) => {
  if (!dayKey) return [];
  const source = byDay || buildEventsByDayMap();
  const list = source[dayKey];
  return Array.isArray(list) ? list : [];
};

const getUnscheduledEvents = () => {
  const rows = getCalendarRows();
  const out = [];
  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    if (getRowDate(row)) continue;
    out.push({
      id: row.id,
      title: getEventTitle(row),
      colors: getEventColors(row),
      row,
      unscheduled: true
    });
  }
  return out;
};

const getUnscheduledCount = () => getUnscheduledEvents().length;

// Cache month/week structure + events so arrow-key focus does not rebuild chips.
let eventsByDayCache = { key: null, map: null };
let monthCellsCache = { key: null, cells: null };
let weekDaysCache = { key: null, days: null };

const getCalendarDataCacheKey = () => {
  const pageP = f.pageStateVertexId ? g.vertexes[f.pageStateVertexId]?.P : null;
  const ids = pageP?.mainTableRowIds;
  const idPart = Array.isArray(ids) ? `${ids.length}:${ids[0] || ""}:${ids[ids.length - 1] || ""}` : "0";
  return [
    calP()?.eventsCacheEpoch || 0,
    pageP?.contentFetchKey ?? "",
    idPart,
    f.getCalendarDateField?.() || "",
    f.getCalendarEndDateField?.() || "",
    f.getCalendarColorField?.() || "",
    f.getCalendarConfig?.()?.titleField || ""
  ].join("|");
};

const invalidateCalendarEventCache = () => {
  eventsByDayCache = { key: null, map: null };
  monthCellsCache = { key: null, cells: null };
  weekDaysCache = { key: null, days: null };
  const nextEpoch = (calP()?.eventsCacheEpoch || 0) + 1;
  patchCalP({ eventsCacheEpoch: nextEpoch });
};

const getCachedEventsByDayMap = () => {
  const key = getCalendarDataCacheKey();
  if (eventsByDayCache.key === key && eventsByDayCache.map) {
    return eventsByDayCache.map;
  }
  const map = buildEventsByDayMap();
  eventsByDayCache = { key, map };
  return map;
};

const buildMonthCells = () => {
  ensureCursorInitialized();
  const p = calP();
  const year = p?.cursorYear;
  const month = p?.cursorMonth;
  const dataKey = getCalendarDataCacheKey();
  const cacheKey = `m:${year}-${month}|${dataKey}`;
  if (monthCellsCache.key === cacheKey && monthCellsCache.cells) {
    return monthCellsCache.cells;
  }
  const cursor = new Date(year, month, 1, 0, 0, 0, 0);
  const first = new Date(year, month, 1);
  const start = startOfWeek(first);
  const todayKey = toDateKey(new Date());
  const byDay = getCachedEventsByDayMap();
  const cells = [];
  for (let i = 0; i < 42; i++) {
    const d = new Date(start.getFullYear(), start.getMonth(), start.getDate() + i);
    const key = toDateKey(d);
    cells.push({
      key,
      dayNumber: d.getDate(),
      inCurrentMonth: d.getMonth() === month,
      isToday: key === todayKey,
      events: getEventsForDayKey(key, byDay)
    });
  }
  monthCellsCache = { key: cacheKey, cells };
  return cells;
};

const buildWeekDays = () => {
  ensureCursorInitialized();
  const weekStartKey = calP()?.cursorWeekStart;
  const dataKey = getCalendarDataCacheKey();
  const cacheKey = `w:${weekStartKey}|${dataKey}`;
  if (weekDaysCache.key === cacheKey && weekDaysCache.days) {
    return weekDaysCache.days;
  }
  const start = getWeekStartDate();
  const todayKey = toDateKey(new Date());
  const byDay = getCachedEventsByDayMap();
  const days = [];
  for (let i = 0; i < 7; i++) {
    const d = new Date(start.getFullYear(), start.getMonth(), start.getDate() + i);
    const key = toDateKey(d);
    days.push({
      key,
      label: d.toLocaleDateString(undefined, { weekday: "short", month: "short", day: "numeric" }),
      isToday: key === todayKey,
      events: getEventsForDayKey(key, byDay)
    });
  }
  weekDaysCache = { key: cacheKey, days };
  return days;
};

const HOUR_SLOTS = (() => {
  const hours = [];
  for (let h = HOUR_START; h <= HOUR_END; h++) {
    hours.push({ hour: h, label: `${pad2(h)}:00` });
  }
  return hours;
})();

const buildHourSlots = () => HOUR_SLOTS;

const getEventsForDayHour = (dayKey, hour) => {
  const events = getEventsForDayKey(dayKey, getCachedEventsByDayMap());
  if (!events.length) return [];
  const out = [];
  for (let i = 0; i < events.length; i++) {
    const ev = events[i];
    if (ev.segment === "middle" || ev.segment === "end") {
      if (hour === 0) out.push(ev);
    } else if (ev.hour === hour) {
      out.push(ev);
    }
  }
  return out;
};

const loadCalendarData = async () => {
  if (typeof f.fetchData !== "function") return;
  const pageVid = f.pageStateVertexId;
  const alreadyLoaded =
    g.vertexes[pageVid]?.P?.contentFetchKey != null &&
    Array.isArray(g.vertexes[pageVid]?.P?.mainTableRowIds);
  if (!alreadyLoaded) patchCalP({ loading: true });
  try {
    await f.fetchData(undefined, undefined, undefined, () => {});
    invalidateCalendarEventCache();
  } catch (error) {
    console.error("Calendar load failed:", error);
  } finally {
    if (calP()?.loading) patchCalP({ loading: false });
  }
};

const refreshFromSidebar = () => {
  const item = f.selectedSidebarItem?.();
  if (item || f.hasSidebar?.() !== true) {
    loadCalendarData();
  }
};

const getSelectedEventIds = () => {
  const ids = calP()?.selectedEventIds;
  return Array.isArray(ids) ? ids.map(String) : [];
};

const clearSelection = () => {
  patchCalP({ selectedEventIds: [] });
};

const isEventSelected = (eventId) => {
  if (eventId == null) return false;
  return getSelectedEventIds().includes(String(eventId));
};

const toggleEventSelection = (eventId, additive) => {
  if (eventId == null) return;
  const id = String(eventId);
  const cur = getSelectedEventIds();
  if (!additive) {
    patchCalP({ selectedEventIds: [id] });
    return;
  }
  const next = cur.slice();
  const idx = next.indexOf(id);
  if (idx >= 0) next.splice(idx, 1);
  else next.push(id);
  patchCalP({ selectedEventIds: next });
};

const resolveDragItemIds = (eventId) => {
  const id = String(eventId);
  const selected = getSelectedEventIds();
  if (selected.length > 1 && selected.includes(id)) return selected;
  return [id];
};

const eventDragCleanups = new Map();
const resizeDragCleanups = new Map();
const dayDropCleanups = new Map();
const hourDropCleanups = new Map();
const eventDragBound = new WeakMap();
const resizeDragBound = new WeakMap();
const dayDropBound = new WeakMap();
const hourDropBound = new WeakMap();

const cleanupMap = (map, element) => {
  if (!element) return;
  const cleanup = map.get(element);
  if (cleanup) {
    cleanup();
    map.delete(element);
  }
};

const initEventDraggable = (element, eventId) => {
  if (!element || !_.draggable || !eventId) return;
  if (f.getCalendarConfig?.()?.allowDragReschedule === false) return;
  if (eventDragBound.get(element) === eventId && eventDragCleanups.has(element)) return;
  cleanupMap(eventDragCleanups, element);
  const cleanup = _.draggable({
    element,
    getInitialData: () => {
      const itemIds = resolveDragItemIds(eventId);
      return {
        type: "calendar-event",
        itemIds,
        count: itemIds.length,
        sourceTableVertexLabel: f.getTableVertexLabel?.() || null,
        sourceTableKey: f.getTableKey?.() || null
      };
    },
    onGenerateDragPreview: ({ nativeSetDragImage }) => {
      if (!_.setCustomNativeDragPreview || !nativeSetDragImage) return;
      const itemIds = resolveDragItemIds(eventId);
      const row = g.vertexes[eventId];
      const label =
        itemIds.length > 1
          ? `${itemIds.length} items`
          : row
            ? getEventTitle(row)
            : "Event";
      return _.setCustomNativeDragPreview({
        nativeSetDragImage,
        getOffset: _.pointerOutsideOfPreview
          ? _.pointerOutsideOfPreview({ x: "8px", y: "8px" })
          : undefined,
        render: ({ container }) => {
          container.style.boxSizing = "border-box";
          container.style.padding = "8px 10px";
          container.style.borderRadius = "8px";
          container.style.border = `1px solid ${t?.var?.color?.border ?? "rgba(0,0,0,0.2)"}`;
          container.style.background = `${t?.var?.color?.primary ?? "#4f46e5"}`;
          container.style.color = `${t?.var?.color?.primary_text ?? "#fff"}`;
          container.style.fontSize = "12px";
          container.style.fontWeight = "600";
          container.style.maxWidth = "220px";
          container.style.overflow = "hidden";
          container.style.textOverflow = "ellipsis";
          container.style.whiteSpace = "nowrap";
          container.textContent = label;
        }
      });
    },
    onDragStart: () => {
      element.style.opacity = "0.55";
    },
    onDrop: () => {
      element.style.opacity = "1";
    }
  });
  eventDragCleanups.set(element, cleanup);
  eventDragBound.set(element, eventId);
  return cleanup;
};

const initResizeDraggable = (element, eventId, edge) => {
  if (!element || !_.draggable || !eventId) return;
  if (!hasEndDateField()) return;
  if (f.getCalendarConfig?.()?.allowDragReschedule === false) return;
  const bindKey = `${eventId}:${edge}`;
  if (resizeDragBound.get(element) === bindKey && resizeDragCleanups.has(element)) return;
  cleanupMap(resizeDragCleanups, element);
  const cleanup = _.draggable({
    element,
    getInitialData: () => ({
      type: edge === "end" ? "calendar-resize-end" : "calendar-resize-start",
      itemIds: [String(eventId)],
      count: 1,
      edge,
      sourceTableVertexLabel: f.getTableVertexLabel?.() || null,
      sourceTableKey: f.getTableKey?.() || null
    }),
    onDragStart: () => {
      element.style.opacity = "0.7";
    },
    onDrop: () => {
      element.style.opacity = "1";
    }
  });
  resizeDragCleanups.set(element, cleanup);
  resizeDragBound.set(element, bindKey);
  return cleanup;
};

const dropModeFromSource = (data) => {
  if (!data) return "move";
  if (data.type === "calendar-resize-start") return "resize-start";
  if (data.type === "calendar-resize-end") return "resize-end";
  return "move";
};

const canDropCalendarPayload = (data) => {
  if (!data) return false;
  if (
    data.type === "calendar-event" ||
    data.type === "table-items" ||
    data.type === "calendar-resize-start" ||
    data.type === "calendar-resize-end"
  ) {
    return Array.isArray(data.itemIds) && data.itemIds.length > 0;
  }
  return false;
};

const initDayDropTarget = (element, dayKey) => {
  if (!element || !_.dropTargetForElements || !dayKey) return;
  if (dayDropBound.get(element) === dayKey && dayDropCleanups.has(element)) return;
  cleanupMap(dayDropCleanups, element);
  const cleanup = _.dropTargetForElements({
    element,
    getData: () => ({ type: "calendar-day", dayKey }),
    canDrop: ({ source }) => canDropCalendarPayload(source?.data),
    onDragEnter: () => {
      element.classList.add("cal-day-drag-over");
    },
    onDragLeave: () => {
      element.classList.remove("cal-day-drag-over");
    },
    onDrop: async ({ source }) => {
      element.classList.remove("cal-day-drag-over");
      const data = source?.data;
      const itemIds = Array.isArray(data?.itemIds) ? data.itemIds : [];
      if (itemIds.length === 0) return;
      if (typeof f.updateRowsCalendarDate === "function") {
        const result = await f.updateRowsCalendarDate(itemIds, dayKey, null, {
          mode: dropModeFromSource(data)
        });
        if (result?.success !== false) invalidateCalendarEventCache();
        clearSelection();
      }
    }
  });
  dayDropCleanups.set(element, cleanup);
  dayDropBound.set(element, dayKey);
  return cleanup;
};

const initHourDropTarget = (element, dayKey, hour) => {
  if (!element || !_.dropTargetForElements || !dayKey || hour == null) return;
  const slotKey = `${dayKey}T${pad2(hour)}`;
  if (hourDropBound.get(element) === slotKey && hourDropCleanups.has(element)) return;
  cleanupMap(hourDropCleanups, element);
  const cleanup = _.dropTargetForElements({
    element,
    getData: () => ({ type: "calendar-hour", dayKey, hour }),
    canDrop: ({ source }) => canDropCalendarPayload(source?.data),
    onDragEnter: () => {
      element.classList.add("cal-hour-drag-over");
    },
    onDragLeave: () => {
      element.classList.remove("cal-hour-drag-over");
    },
    onDrop: async ({ source }) => {
      element.classList.remove("cal-hour-drag-over");
      const data = source?.data;
      const itemIds = Array.isArray(data?.itemIds) ? data.itemIds : [];
      if (itemIds.length === 0) return;
      if (typeof f.updateRowsCalendarDate === "function") {
        const result = await f.updateRowsCalendarDate(itemIds, dayKey, hour, {
          mode: dropModeFromSource(data)
        });
        if (result?.success !== false) invalidateCalendarEventCache();
        clearSelection();
      }
    }
  });
  hourDropCleanups.set(element, cleanup);
  hourDropBound.set(element, slotKey);
  return cleanup;
};

const bindEventRef = (el, eventId) => {
  if (!el) return;
  initEventDraggable(el, eventId);
};

const bindResizeStartRef = (el, eventId) => {
  if (!el) return;
  initResizeDraggable(el, eventId, "start");
};

const bindResizeEndRef = (el, eventId) => {
  if (!el) return;
  initResizeDraggable(el, eventId, "end");
};

const bindDayRef = (el, dayKey) => {
  if (!el || !dayKey) return;
  dayElementsByKey.set(dayKey, el);
  const focused = getFocusedDayKey() === dayKey;
  el.classList.toggle("cal-day-focused", focused);
  el.tabIndex = focused ? 0 : -1;
  el.setAttribute("aria-selected", focused ? "true" : "false");
  initDayDropTarget(el, dayKey);
};

const bindHourRef = (el, dayKey, hour) => {
  if (!el) return;
  initHourDropTarget(el, dayKey, hour);
};

const openRow = async (row) => {
  if (!row) return;
  const onRowClick = f.prop?.("onRowClick");
  if (typeof onRowClick === "function") {
    onRowClick(row, _);
    return;
  }
  const onEdit = f.prop?.("onEdit");
  if (typeof onEdit === "function") {
    try {
      await onEdit(row, _);
      return;
    } catch (error) {
      console.error("Error in onEdit function:", error);
      _.showErrorToast?.(error?.message || "Failed to open edit form");
      return;
    }
  }
  const formConfig = f.getFormConfig?.();
  if (!formConfig) {
    _.showWarningToast?.("Form is not configured for this table");
    return;
  }
  patchCalP({
    modalMode: "edit",
    editingRow: row,
    formData: row,
    isModalOpen: true
  });
};

const openAddForDay = (dayKey, hour) => {
  const cfg = f.getCalendarConfig?.();
  const dateField = cfg?.dateField;
  if (!dateField) {
    _.showWarningToast?.("Calendar date field is not configured");
    return;
  }
  const formConfig = f.getFormConfig?.();
  if (!formConfig) {
    _.showWarningToast?.("Form is not configured for this table");
    return;
  }
  const asDateTime = isDateTimeColumn() || hour != null;
  const value =
    typeof f.formatCalendarStoredValue === "function"
      ? f.formatCalendarStoredValue(dayKey, hour, null, asDateTime)
      : dayKey;
  if (value == null) return;
  const label = f.getTableVertexLabel?.() || "Item";
  patchCalP({
    modalMode: "add",
    editingRow: null,
    formData: {
      id: null,
      L: [label],
      P: { [dateField]: value },
      IN: {},
      OUT: {}
    },
    isModalOpen: true,
    focusedDayKey: dayKey
  });
  focusedDayKeyLocal = dayKey;
};

const handleDayCellClick = (e, dayKey) => {
  if (!dayKey) return;
  if (e?.target?.closest?.("[data-cal-event]")) return;
  if (e?.target?.closest?.("[data-cal-resize]")) return;
  setFocusedDayKeyFast(dayKey);
  openAddForDay(dayKey, null);
};

const handleHourCellClick = (e, dayKey, hour) => {
  if (!dayKey) return;
  if (e?.target?.closest?.("[data-cal-event]")) return;
  if (e?.target?.closest?.("[data-cal-resize]")) return;
  setFocusedDayKeyFast(dayKey);
  openAddForDay(dayKey, hour);
};

const handleEventClick = (e, event) => {
  e?.stopPropagation?.();
  const additive = !!(e?.metaKey || e?.ctrlKey || e?.shiftKey);
  if (additive) {
    toggleEventSelection(event?.id, true);
    return;
  }
  toggleEventSelection(event?.id, false);
  openRow(event?.row);
};

const closeEditModal = () => {
  patchCalP({
    isModalOpen: false,
    formData: null,
    editingRow: null
  });
};

const handleSave = async (formDataToSave) => {
  const formConfig = f.getFormConfig?.();
  if (!formConfig?.saveFunction) {
    _.showErrorToast?.("Save function not configured");
    return false;
  }
  try {
    if (f.pageStateVertexId) {
      _.mergeVertexProperties(0, f.pageStateVertexId, g, sg, { loading: true });
    }
    const mode = calP()?.modalMode ?? "edit";
    const originalRow = calP()?.editingRow ?? null;
    const result = await formConfig.saveFunction({
      mode,
      data: formDataToSave,
      originalRow
    });
    if (result?.success) {
      _.showSuccessToast?.(
        mode === "add" ? "Item added successfully" : "Item updated successfully"
      );
      closeEditModal();
      f.invalidateContentFetchKey?.();
      await loadCalendarData();
      return true;
    }
    _.showErrorToast?.(result?.message || result?.error || "Failed to save");
    return false;
  } catch (error) {
    console.error("Error saving from calendar:", error);
    _.showErrorToast?.(error?.message || "Failed to save item");
    return false;
  } finally {
    if (f.pageStateVertexId) {
      _.mergeVertexProperties(0, f.pageStateVertexId, g, sg, { loading: false });
    }
  }
};

const getEditModalProps = () => {
  const p = calP() || {};
  const modalMaxWidth = f.prop?.("modalMaxWidth") || f.getConfigGeneralValue?.("modalMaxWidth");
  return {
    isOpen: p.isModalOpen === true,
    onClose: closeEditModal,
    mode: p.modalMode || "edit",
    formConfig: f.getFormConfig?.(),
    initialVertex: p.formData ?? null,
    onSave: handleSave,
    label: f.prop?.("label") || f.getConfigGeneralValue?.("label"),
    tableVertexLabel: f.getTableVertexLabel?.(),
    selectedSidebarItem: f.selectedSidebarItem,
    sidebarConfig: f.getSidebarConfig?.() || null,
    maxWidth:
      modalMaxWidth != null && String(modalMaxWidth).trim() !== ""
        ? String(modalMaxWidth).trim()
        : undefined
  };
};

const dayElementsByKey = new Map();
let focusedDayKeyLocal = null;

const getFocusedDayKey = () => focusedDayKeyLocal || calP()?.focusedDayKey || null;

const applyFocusedDayDom = (dayKey) => {
  dayElementsByKey.forEach((el, key) => {
    if (!el) return;
    const focused = key === dayKey;
    el.classList.toggle("cal-day-focused", focused);
    el.tabIndex = focused ? 0 : -1;
    el.setAttribute("aria-selected", focused ? "true" : "false");
  });
};

const setFocusedDayKeyFast = (dayKey) => {
  focusedDayKeyLocal = dayKey;
  applyFocusedDayDom(dayKey);
  const focusedEl = dayElementsByKey.get(dayKey);
  if (focusedEl && typeof focusedEl.focus === "function") {
    try {
      focusedEl.focus({ preventScroll: true });
    } catch (error) {
      focusedEl.focus();
    }
  }
};

const shiftFocusedDay = (deltaDays) => {
  ensureCursorInitialized();
  const p = calP();
  const currentKey = getFocusedDayKey() || toDateKey(new Date());
  const current = parseDateValue(currentKey) || new Date();
  const next = addDays(current, deltaDays);
  const nextKey = toDateKey(next);
  const cursorYear = p?.cursorYear;
  const cursorMonth = p?.cursorMonth;
  // Within the visible month: DOM-only focus move (no reactive rebuild).
  if (next.getFullYear() === cursorYear && next.getMonth() === cursorMonth) {
    setFocusedDayKeyFast(nextKey);
    return;
  }
  focusedDayKeyLocal = nextKey;
  patchCalP({
    focusedDayKey: nextKey,
    cursorYear: next.getFullYear(),
    cursorMonth: next.getMonth(),
    cursorWeekStart: toDateKey(startOfWeek(next))
  });
};

const handleCalendarKeyDown = (e) => {
  if (!e) return;
  const key = e.key;
  if (key === "Escape") {
    if (calP()?.isModalOpen) {
      e.preventDefault?.();
      closeEditModal();
      return;
    }
    if (getSelectedEventIds().length) {
      e.preventDefault?.();
      clearSelection();
    }
    return;
  }
  if (calP()?.isModalOpen) return;
  if (key === "ArrowLeft") {
    e.preventDefault?.();
    shiftFocusedDay(-1);
    return;
  }
  if (key === "ArrowRight") {
    e.preventDefault?.();
    shiftFocusedDay(1);
    return;
  }
  if (key === "ArrowUp") {
    e.preventDefault?.();
    shiftFocusedDay(-7);
    return;
  }
  if (key === "ArrowDown") {
    e.preventDefault?.();
    shiftFocusedDay(7);
    return;
  }
  if (key === "Enter") {
    e.preventDefault?.();
    const focused = getFocusedDayKey();
    if (!focused) return;
    const events = getEventsForDayKey(focused, getCachedEventsByDayMap());
    const selected = getSelectedEventIds();
    if (selected.length === 1) {
      const row = g.vertexes[selected[0]];
      if (row) {
        openRow(row);
        return;
      }
    }
    if (events.length === 1) {
      openRow(events[0].row);
      return;
    }
    openAddForDay(focused, null);
  }
};

const isDayFocused = (dayKey) => getFocusedDayKey() === dayKey;

return {
  calendarStateVertexId,
  getLayout,
  setLayout,
  goToday,
  goPrev,
  goNext,
  getHeaderLabel,
  isDateTimeColumn,
  buildMonthCells,
  buildWeekDays,
  buildHourSlots,
  getEventsForDayHour,
  getEventsForDayKey,
  getUnscheduledEvents,
  getUnscheduledCount,
  loadCalendarData,
  refreshFromSidebar,
  bindEventRef,
  bindResizeStartRef,
  bindResizeEndRef,
  bindDayRef,
  bindHourRef,
  openRow,
  openAddForDay,
  handleDayCellClick,
  handleHourCellClick,
  handleEventClick,
  handleCalendarKeyDown,
  closeEditModal,
  handleSave,
  getEditModalProps,
  getEventChipStyle,
  isEventSelected,
  isDayFocused,
  hasEndDateField,
  WEEKDAY_LABELS,
  calP,
  getEventTitle
};

