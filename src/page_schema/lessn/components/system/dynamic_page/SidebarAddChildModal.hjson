{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''
// Store FormManagement's formTxnId getter (set via onFnsReady from modal content)
const formTxnIdRef = { current: null };

// Slot children run inside ContentModal's DataContext, so use getProps() instead of c.props there.
const getProps = () => c.props || {};

// Revert transaction when closing without save (Cancel button, etc.)
const cleanup = () => {
  const getTxnId = formTxnIdRef.current;
  const txnId = getTxnId && typeof getTxnId === "function" ? getTxnId() : null;
  if (txnId && txnId > 0) {
    _.revertTransaction(txnId);
  }
};

const getModalTitle = () => {
  const p = getProps();
  const mode = p.mode || "add";
  const parentId = p.parentId;
  const label = p.label || "Item";
  if (mode === "add") {
    return parentId === null || parentId === undefined
      ? `Add Root ${label}`
      : `Add New Child ${label}`;
  }
  return `Edit ${label}`;
};

const handleClose = () => {
  cleanup();
  getProps().onClose?.();
};

return {
  formTxnIdRef,
  getProps,
  cleanup,
  getModalTitle,
  handleClose
};
'''
        key: SidebarAddChildModal
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: ContentModal
        props:
          '''const p = f.getProps();
return {
  isOpen: p.isOpen === true,
  title: f.getModalTitle(),
  maxWidth: "600px",
  onClose: f.handleClose
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        slotName: children
        css:
          '''return `._id {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: ${t.var.spacing.lg};
}`;'''
        displayOrder: 1
        fns:
          '''return {
  cleanup: () => f?.cleanup?.(),
  formTxnIdRef: f?.formTxnIdRef
};'''
        componentName: Html
        props:
          '''return {
  as: "div",
  onCleanup: () => {
    f.cleanup();
  }
};'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: FormManagement
        props:
          '''const p = f.getProps();
const sidebarConfig = p.sidebarConfig || {};
const formConfig = sidebarConfig?.formConfig;
const parentId = p.parentId;
const vertexId = p.vertexId;
const initialVertex = p.initialVertex;
const mode = p.mode || "add";
const parentVertexLabel = sidebarConfig?.parentVertexLabel;
const toParentEdgeType = sidebarConfig?.toParentEdgeType;
const rootKeys = sidebarConfig?.rootKeys || {};
const tableVertexLabel = p.tableVertexLabel;
const relationshipType = p.relationshipType;
const onSave = p.onSave;
const onClose = p.onClose;

const formHasKeyField = (cfg) => {
  if (!cfg || !Array.isArray(cfg.groups)) return false;
  for (let gi = 0; gi < cfg.groups.length; gi++) {
    const fields = cfg.groups[gi]?.fields;
    if (!Array.isArray(fields)) continue;
    for (let fi = 0; fi < fields.length; fi++) {
      if (fields[fi]?.key === "key") return true;
    }
  }
  return false;
};

const ensureSidebarFormConfigWithKeyField = (cfg) => {
  if (!cfg) return cfg;
  if (formHasKeyField(cfg)) return cfg;
  const out = _.klona(cfg);
  const keyField = {
    key: "key",
    label: "Key",
    type: "text",
    required: true,
    maxLength: 255,
    colSpan: 2,
    tooltip:
      "Required. Enter a unique key yourself (letters, numbers, underscores). It is not generated from the name."
  };
  if (!Array.isArray(out.groups) || out.groups.length === 0) {
    out.groups = [
      {
        key: "_sidebarGenerated",
        title: "Details",
        gridColumns: out.gridColumns || 1,
        fields: [keyField]
      }
    ];
    return out;
  }
  const g0 = out.groups[0];
  const existing = Array.isArray(g0.fields) ? g0.fields : [];
  g0.fields = [...existing, keyField];
  return out;
};

const formConfigResolved = ensureSidebarFormConfigWithKeyField(formConfig);

const wrappedOnSave = async (saveData) => {
  const vertex = saveData.vertex;
  if (!vertex) {
    _.showErrorToast?.("No vertex data to save");
    return false;
  }

  const keyVal = String(vertex.P?.key ?? "").trim();
  if (!keyVal) {
    _.showErrorToast?.("Key is Required");
    return false;
  }
  const nameVal = String(vertex.P?.name || vertex.P?.title || "").trim();
  const nameForServer = nameVal || keyVal;

  const label = p.label || "Item";
  try {
    const result = await s({
      functionName: "saveSidebarVertex",
      contextData: {
        vertexId: vertexId || null,
        name: nameForServer,
        key: keyVal,
        parentId: parentId,
        parentVertexLabel: parentVertexLabel,
        toParentEdgeType: toParentEdgeType,
        rootKeys: rootKeys,
        properties: (() => {
          const copy = _.klona(vertex.P || {});
          delete copy.key;
          const rels = saveData.relationships || {};
          for (const fieldKey of Object.keys(rels)) {
            delete copy[fieldKey];
          }
          return copy;
        })(),
        relationships: saveData.relationships || {},
        tableVertexLabel: tableVertexLabel,
        relationshipType: relationshipType,
        enableUserScoping: p.enableUserScoping,
        hooks: p.hooks,
        label: label
      }
    });

    const errorMessage = f.extractError?.(
      result,
      true,
      `Failed to ${mode === "edit" ? "update" : "create"} ${label}`
    );
    if (errorMessage) {
      return false;
    }

    if (result?.result?.success) {
      // Apply graph payload (new/updated edges + deleted_edges) before tree callbacks
      if (
        result.graph &&
        (result.graph.vertexes ||
          result.graph.edges ||
          (Array.isArray(result.graph.deleted_edges) &&
            result.graph.deleted_edges.length > 0) ||
          (Array.isArray(result.graph.deleted_vertexes) &&
            result.graph.deleted_vertexes.length > 0))
      ) {
        _.setGraphData(0, result.graph, {});
      }
      _.showSuccessToast?.(
        result.result.message ||
          `${label} ${mode === "edit" ? "updated" : "created"} successfully`
      );
      if (onSave) {
        await onSave(result.result.data);
      }
      if (onClose) {
        onClose();
      }
      return true;
    }
    return false;
  } catch (error) {
    console.error("Error saving vertex:", error);
    _.showErrorToast?.(
      `Failed to ${mode === "edit" ? "update" : "create"} ${label}`
    );
    return false;
  }
};

const wrappedOnClose = () => {
  f.cleanup();
  if (onClose) {
    onClose();
  }
};

return {
  formConfig: formConfigResolved,
  initialVertex: initialVertex || null,
  mode: mode,
  vertexLabel: null,
  onSave: wrappedOnSave,
  onClose: wrappedOnClose,
  inModal: true,
  onFnsReady: (fns) => {
    if (f?.formTxnIdRef) f.formTxnIdRef.current = fns.formTxnId;
  }
};'''
      }
    }
