const parentId = c.props?.parentId;
const label = c.props?.label || "Item";

let title;
if (mode === "add") {
  title = parentId === null || parentId === undefined ? `Add Root ${label}` : `Add New Child ${label}`;
} else {
  title = `Edit ${label}`;
}

return {
  as: "div",
  text: title
};'''
