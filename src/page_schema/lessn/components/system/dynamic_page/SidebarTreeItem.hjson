  refreshChildren,
  isDragOver,
  setIsDragOver,
  isDragging,
  isValidDrop,
  isDescendantOf,
  validateDropTarget,
  initDraggable,
  initDropTarget,
  cleanupDragAndDrop,
  handleMoveSidebarItem,
  handleTableItemsDrop,
  getUsePolarisUI: () => f.getUsePolarisUI?.() === true,
  isUncategorizedTreeNode,
  isAllTreeNode,
  isVirtualSidebarCategory,
  getUncategorizedVertexId,
  getAllVertexId
};
