  ${backgroundColor ? `background-color: ${backgroundColor};` : ""}
  ${dragOverStyle}
  ${isDragging ? `opacity: 0.5;` : ""}
  padding: 2px 0;
  transition: background-color 0.15s ease-in-out;
  ${isNested ? `border-left: 1px dashed ${t.var.color.border};` : ""}

  &:hover {
    background-color: ${t.var.color.background_dark_150};
  }

  &:hover .tree-item-actions {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
}`;'''
