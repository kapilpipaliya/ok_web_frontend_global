}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "span"
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id {
  color: ${t.var.color.text_light_200};
  flex-shrink: 0;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const index = c.index ?? 0;
return {
  as: "icon",
  icon: "ph:caret-right",
  width: 14,
  height: 14,
  hide: index === 0
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          '''const items = Array.isArray(c.props?.items) ? c.props.items : [];
const index = c.index ?? 0;
const isLast = index === items.length - 1;
return `._id {
  border: none;
  background: transparent;
  padding: 0.1rem 0.2rem;
  border-radius: 0.25rem;
  font-size: 0.875rem;
  font-weight: ${isLast ? 600 : 500};
  color: ${isLast ? t.var.color.text : t.var.color.text_light_100};
  cursor: ${isLast ? "default" : "pointer"};
  text-decoration: none;
  transition: background 0.15s ease, color 0.15s ease;

  ${!isLast ? `
  &:hover {
    background: ${t.var.color.background};
    color: ${t.var.color.text};
    text-decoration: underline;
  }
  ` : ""}
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const crumb = c.crumb || {};
const items = Array.isArray(c.props?.items) ? c.props.items : [];
const index = c.index ?? 0;
const isLast = index === items.length - 1;
const rootLabel = c.props?.rootLabel || "Gallery";
const label = crumb.isRoot ? (rootLabel || crumb.name || "Gallery") : (crumb.name || "Folder");
const hrefFor = c.props?.hrefFor;
const rootHref = c.props?.rootHref;
const href = !isLast
  ? (typeof hrefFor === "function" ? hrefFor(crumb) : null)
  : null;
const resolvedHref = href || (crumb.isRoot && !isLast ? rootHref : null);
const onNavigate = c.props?.onNavigate;
return {
  as: isLast ? "span" : (resolvedHref ? "a" : "button"),
  type: isLast || resolvedHref ? undefined : "button",
  href: isLast ? undefined : (resolvedHref || undefined),
  text: label,
  "aria-current": isLast ? "page" : undefined,
  onClick: isLast
    ? undefined
    : (e) => {
        if (!onNavigate) return;
        if (resolvedHref) e.preventDefault();
        onNavigate(crumb);
      }
};'''
      }
    }
  ]
