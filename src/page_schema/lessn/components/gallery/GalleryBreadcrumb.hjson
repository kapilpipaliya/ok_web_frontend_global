        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "nav",
  "aria-label": "Gallery breadcrumb"
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        contextName: crumb
        loop: true
        displayOrder: 1
        componentName: Html
        props:
          '''const items = Array.isArray(c.props?.items) ? c.props.items : [];
return {
  as: "fragment",
