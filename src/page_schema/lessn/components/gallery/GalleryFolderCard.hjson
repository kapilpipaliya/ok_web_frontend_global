{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        description: Folder card for gallery browser. Props: folder {id,name,contentCount,folderCount,imageUrl}, onOpen(folder), index.
        key: GalleryFolderCard
        updatedAt: 2026-07-13T18:16:26.920Z
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 0;
  width: 100%;
  text-align: left;
  padding: 0;
  border: 1px solid ${t.var.color.border};
  border-radius: 0.75rem;
  background: ${t.var.color.background};
  cursor: pointer;
  text-decoration: none;
  color: inherit;
  overflow: hidden;
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
  transform-origin: center center;

  &:hover {
    z-index: 1;
    border-color: ${t.var.color.primary_light_300};
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }

  &:focus-visible {
    outline: 2px solid ${t.var.color.primary};
    outline-offset: 2px;
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const folder = c.props?.folder || c.props || {};
const index = c.props?.index ?? c.index ?? 0;
const href = c.props?.href;
const onOpen = c.props?.onOpen;
return {
  as: href ? "a" : "button",
  type: href ? undefined : "button",
  href: href || undefined,
  "data-animate": "",
  ref: (el) => {
    if (!el) return;
    f.animateOnView?.(el, { delay: index * 0.05 });
    if (el.dataset.hoverInit) return;
    el.dataset.hoverInit = "true";
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    _.motion.hover(el, (element) => {
      _.motion.animate(element, { scale: 1.1 });
      return () => _.motion.animate(element, { scale: 1 });
    });
  },
  onClick: (e) => {
    if (!onOpen) return;
    if (href) e.preventDefault();
    onOpen(folder);
  }
};'''
      }
    }
    {
      id: "2b"
      L: Attr
      P: {
        css:
          '''return `._id {
  width: 100%;
  aspect-ratio: 1;
  object-fit: cover;
  display: block;
  background: ${t.var.color.background_light_200};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const folder = c.props?.folder || c.props || {};
const src = folder.imageUrl || "";
const ready = folder.imageReady !== false && !!src;
return {
  as: ready ? "img" : "fragment",
  src: ready ? src : undefined,
  srcset: ready && folder.imageSrcset ? folder.imageSrcset : undefined,
  sizes: ready ? "(max-width:768px) 50vw, 200px" : undefined,
  alt: folder.name || "Category",
  loading: "lazy",
  hide: !ready
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 3rem;
  height: 3rem;
  margin: 0.75rem 0.875rem 0;
  border-radius: 0.625rem;
  background: ${t.var.color.primary_light_100};
  color: ${t.var.color.primary};
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const folder = c.props?.folder || c.props || {};
const ready = !!(folder.imageUrl && String(folder.imageUrl).trim()) && folder.imageReady !== false;
return {
  as: "div",
  hide: ready
};'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "icon",
  icon: c.props?.icon || "ph:folder",
  width: 28,
  height: 28
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  min-width: 0;
  width: 100%;
  padding: 0.5rem 0.875rem 0.5rem;
}`;'''
        displayOrder: 3
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          '''return `._id {
  margin: 0;
  font-size: 1.0625rem;
  font-weight: 600;
  color: ${t.var.color.text};
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const folder = c.props?.folder || c.props || {};
return {
  as: "h3",
  text: folder.name || "Category"
};'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''return `._id {
  margin: 0;
  font-size: 0.8125rem;
  color: ${t.var.color.text_light_300};
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const folder = c.props?.folder || c.props || {};
const categories = Number(folder.folderCount || 0);
const products = Number(folder.contentCount || 0);
const parts = [];
if (categories > 0) parts.push(`${categories} categor${categories === 1 ? "y" : "ies"}`);
if (products > 0) parts.push(`${products} product${products === 1 ? "" : "s"}`);
return {
  as: "p",
  text: parts.length > 0 ? parts.join(" · ") : "Empty"
};'''
      }
    }
