  "attr:aria-label": "Open search",
  "attr:aria-expanded": () => f.mobileExpanded() === true,
  "attr:aria-keyshortcuts": "Control+K Meta+K",
  hide: () => f.getVariant() !== "header",
  onClick: () => f.expandMobile()
};'''
