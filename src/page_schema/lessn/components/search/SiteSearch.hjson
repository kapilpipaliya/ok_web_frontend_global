  cursor: pointer;

  @media (max-width: 768px) {
    display: ${f.getVariant() === "header" && !f.mobileExpanded() ? "inline-flex" : "none"};
  }

  &:hover { opacity: 0.7; }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "button",
