{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        isNoPermissionCheck: true
        description: Header/site search for ProductCategory and Product. Props: variant (header|page), initialQuery, tableKey, tableVertexLabel, limit, placeholder.
        fns:
          '''
const props = () => c.props || {};
const RECENT_KEY = "lessn.siteSearch.recent";
const ANALYTICS_KEY = "lessn.siteSearch.analytics";
const LISTBOX_ID = "site-search-listbox";

const [query, setQuery] = _.createSignal(
  props().initialQuery != null ? String(props().initialQuery) : ""
);
const [categories, setCategories] = _.createSignal([]);
const [products, setProducts] = _.createSignal([]);
const [popularCategories, setPopularCategories] = _.createSignal([]);
const [recentSearches, setRecentSearches] = _.createSignal([]);
const [categoryTotal, setCategoryTotal] = _.createSignal(0);
const [productTotal, setProductTotal] = _.createSignal(0);
const [loading, setLoading] = _.createSignal(false);
const [error, setError] = _.createSignal("");
const [open, setOpen] = _.createSignal(false);
const [mobileExpanded, setMobileExpanded] = _.createSignal(false);
const [activeIndex, setActiveIndex] = _.createSignal(-1);
const [rootRef, setRootRef] = _.createSignal(null);
const [inputRef, setInputRef] = _.createSignal(null);
const [listboxRef, setListboxRef] = _.createSignal(null);
let debounceTimer = null;
let searchSeq = 0;

const getVariant = () =>
  props().variant === "page" ? "page" : "header";

const getLimit = () => {
  const n = Number(props().limit);
  if (Number.isFinite(n) && n > 0) return Math.min(n, 50);
  return getVariant() === "page" ? 30 : 8;
};

const getLang = () => {
  const lang = _.params?.lang;
  if (lang && /^[a-z]{2,3}$/i.test(String(lang))) {
    return String(lang).toLowerCase();
  }
  return "en";
};

const categoryHref = (item) => {
  const key = item?.key != null ? String(item.key).trim() : "";
  if (!key) return `/${getLang()}/products`;
  return `/${getLang()}/products/${encodeURIComponent(key)}`;
};

const productHref = (item) => {
  const key = item?.key != null ? String(item.key).trim() : "";
  if (!key) return `/${getLang()}/products`;
  return `/${getLang()}/product/${encodeURIComponent(key)}`;
};

const searchPageHref = (q) => {
  const term = q != null ? String(q).trim() : "";
  if (!term) return `/${getLang()}/search`;
  return `/${getLang()}/search?q=${encodeURIComponent(term)}`;
};

const optionId = (kind, item, index) => {
  const raw = item?.id != null ? String(item.id) : String(index);
  return `site-search-opt-${kind}-${raw.replace(/[^a-zA-Z0-9_-]/g, "_")}`;
};

const escapeHtml = (value) =>
  String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");

const highlightHtml = (value) => {
  const text = value != null ? String(value) : "";
  const term = query().trim();
  if (!text) return "";
  if (!term) return escapeHtml(text);
  const lower = text.toLowerCase();
  const needle = term.toLowerCase();
  let out = "";
  let cursor = 0;
  let idx = lower.indexOf(needle, cursor);
  while (idx >= 0) {
    out += escapeHtml(text.slice(cursor, idx));
    out += `<mark>${escapeHtml(text.slice(idx, idx + needle.length))}</mark>`;
    cursor = idx + needle.length;
    idx = lower.indexOf(needle, cursor);
  }
  out += escapeHtml(text.slice(cursor));
  return out;
};

const applyHighlight = (el, value) => {
  if (!el) return;
  el.innerHTML = highlightHtml(value);
};

const readJson = (key, fallback) => {
  try {
    const raw = window.localStorage.getItem(key);
    if (!raw) return fallback;
    const parsed = JSON.parse(raw);
    return parsed == null ? fallback : parsed;
  } catch (_e) {
    return fallback;
  }
};

const writeJson = (key, value) => {
  try {
    window.localStorage.setItem(key, JSON.stringify(value));
  } catch (_e) {
    /* ignore quota / private mode */
  }
};

const loadRecentSearches = () => {
  const list = readJson(RECENT_KEY, []);
  setRecentSearches(Array.isArray(list) ? list.filter((x) => typeof x === "string") : []);
};

const pushRecentSearch = (term) => {
  const clean = term != null ? String(term).trim() : "";
  if (!clean) return;
  const prev = Array.isArray(recentSearches()) ? recentSearches() : [];
  const next = [clean, ...prev.filter((item) => item.toLowerCase() !== clean.toLowerCase())].slice(0, 8);
  setRecentSearches(next);
  writeJson(RECENT_KEY, next);
};

const logAnalytics = (event) => {
  const entry = {
    ts: Date.now(),
    query: query().trim(),
    ...event
  };
  try {
    const prev = readJson(ANALYTICS_KEY, []);
    const next = Array.isArray(prev) ? prev.slice(-199) : [];
    next.push(entry);
    writeJson(ANALYTICS_KEY, next);
  } catch (_e) {
    /* ignore */
  }
  console.info("[site-search]", entry);
};

const clearResults = () => {
  setCategories([]);
  setProducts([]);
  setCategoryTotal(0);
  setProductTotal(0);
  setActiveIndex(-1);
};

const resultCountLabel = () => {
  if (loading()) return "Searching";
  if (error()) return error();
  if (!query().trim()) {
    const recent = recentSearches().length;
    const popular = popularCategories().length;
    if (recent || popular) {
      return `${recent} recent, ${popular} popular`;
    }
    return "";
  }
  const catCount = categories().length;
  const prodCount = products().length;
  if (catCount === 0 && prodCount === 0) return "No results";
  return `Showing ${catCount} of ${categoryTotal()} categories, ${prodCount} of ${productTotal()} products`;
};

const totalsLabel = () => {
  if (!query().trim() || loading() || error()) return "";
  return `Showing ${categories().length + products().length} of ${categoryTotal() + productTotal()} results`;
};

const viewAllLabel = () => {
  const total = categoryTotal() + productTotal();
  const shown = categories().length + products().length;
  if (total > shown) return `View all results (showing ${shown} of ${total})`;
  return "View all results";
};

const getFlatOptions = () => {
  const opts = [];
  if (!query().trim()) {
    const recent = recentSearches();
    for (let i = 0; i < recent.length; i++) {
      opts.push({
        type: "recent",
        item: { text: recent[i] },
        id: optionId("recent", { id: recent[i] }, i)
      });
    }
    const popular = popularCategories();
    for (let i = 0; i < popular.length; i++) {
      const item = popular[i];
      opts.push({
        type: "popular",
        item,
        id: optionId("popular", item, i)
      });
    }
    return opts;
  }
  const cats = categories();
  for (let i = 0; i < cats.length; i++) {
    const item = cats[i];
    opts.push({ type: "category", item, id: optionId("category", item, i) });
  }
  const prods = products();
  for (let i = 0; i < prods.length; i++) {
    const item = prods[i];
    opts.push({ type: "product", item, id: optionId("product", item, i) });
  }
  if (!loading() && !error()) {
    opts.push({ type: "viewAll", id: "site-search-opt-view-all" });
  }
  return opts;
};

const activeOptionId = () => {
  const opts = getFlatOptions();
  const idx = activeIndex();
  if (idx < 0 || idx >= opts.length) return undefined;
  return opts[idx].id;
};

const isOptionActive = (id) => activeOptionId() === id;

const scrollActiveIntoView = () => {
  const id = activeOptionId();
  if (!id) return;
  const el = document.getElementById(id);
  if (!el) return;
  el.scrollIntoView({ block: "nearest" });
};

const runSearch = async (rawQuery) => {
  const term = rawQuery != null ? String(rawQuery).trim() : "";
  const seq = ++searchSeq;
  setLoading(true);
  setError("");
  try {
    const result = await s({
      functionName: "searchPublicCatalog",
      contextData: {
        query: term,
        tableKey: props().tableKey || "products",
        tableVertexLabel: props().tableVertexLabel || "Product",
        limit: getLimit()
      }
    });
    if (seq !== searchSeq) return;
    if (!result?.result?.success) {
      clearResults();
      setPopularCategories([]);
      setError(result?.result?.message || result?.error || "Search failed");
      return;
    }
    const data = result.result.data || {};
    setCategories(Array.isArray(data.categories) ? data.categories : []);
    setProducts(Array.isArray(data.products) ? data.products : []);
    setPopularCategories(
      Array.isArray(data.popularCategories) ? data.popularCategories : []
    );
    setCategoryTotal(Number(data.categoryTotal) || 0);
    setProductTotal(Number(data.productTotal) || 0);
    setActiveIndex(-1);
    setError("");
    if (term) {
      logAnalytics({
        action: "search",
        categoryCount: Number(data.categoryTotal) || 0,
        productCount: Number(data.productTotal) || 0
      });
    }
  } catch (err) {
    if (seq !== searchSeq) return;
    console.error("SiteSearch failed:", err);
    clearResults();
    setError(err?.message || "Search failed");
  } finally {
    if (seq === searchSeq) setLoading(false);
  }
};

const scheduleSearch = (rawQuery) => {
  if (debounceTimer) clearTimeout(debounceTimer);
  const term = rawQuery != null ? String(rawQuery).trim() : "";
  setLoading(true);
  setError("");
  debounceTimer = setTimeout(() => {
    void runSearch(term);
  }, 220);
};

const onQueryInput = (event) => {
  const value = event?.currentTarget?.value ?? "";
  setQuery(value);
  setOpen(true);
  setActiveIndex(-1);
  scheduleSearch(value);
};

const openPanel = () => {
  setOpen(true);
  loadRecentSearches();
  if (!query().trim()) scheduleSearch("");
  else scheduleSearch(query());
};

const closePanel = () => {
  setOpen(false);
  setActiveIndex(-1);
};

const collapseMobile = () => {
  setMobileExpanded(false);
  closePanel();
};

const expandMobile = () => {
  setMobileExpanded(true);
  setOpen(true);
  loadRecentSearches();
  requestAnimationFrame(() => {
    inputRef()?.focus?.();
    scheduleSearch(query().trim());
  });
};

const focusSearch = () => {
  if (getVariant() === "header") {
    const isNarrow = window.matchMedia?.("(max-width: 768px)")?.matches;
    if (isNarrow) {
      expandMobile();
      return;
    }
  }
  setOpen(true);
  loadRecentSearches();
  inputRef()?.focus?.();
  if (!query().trim()) scheduleSearch("");
};

const goToSearchPage = (rawQuery) => {
  const term = rawQuery != null ? String(rawQuery).trim() : query().trim();
  if (!term) return;
  pushRecentSearch(term);
  logAnalytics({ action: "view_all", href: searchPageHref(term) });
  closePanel();
  setMobileExpanded(false);
  _.navigate(searchPageHref(term));
};

const applyRecent = (term) => {
  const clean = term != null ? String(term).trim() : "";
  if (!clean) return;
  setQuery(clean);
  pushRecentSearch(clean);
  logAnalytics({ action: "recent_click", recent: clean });
  scheduleSearch(clean);
};

const selectCategory = (item, source = "category") => {
  pushRecentSearch(query());
  logAnalytics({
    action: "click",
    resultType: source,
    resultId: item?.id,
    resultKey: item?.key,
    href: categoryHref(item)
  });
  closePanel();
  setMobileExpanded(false);
  _.navigate(categoryHref(item));
};

const selectProduct = (item) => {
  pushRecentSearch(query());
  logAnalytics({
    action: "click",
    resultType: "product",
    resultId: item?.id,
    resultKey: item?.key,
    href: productHref(item)
  });
  closePanel();
  setMobileExpanded(false);
  _.navigate(productHref(item));
};

const activateOption = (opt) => {
  if (!opt) return;
  if (opt.type === "category" || opt.type === "popular") {
    selectCategory(opt.item, opt.type);
  } else if (opt.type === "product") {
    selectProduct(opt.item);
  } else if (opt.type === "recent") {
    applyRecent(opt.item?.text);
  } else if (opt.type === "viewAll") {
    goToSearchPage(query());
  }
};

const onSubmit = (event) => {
  event?.preventDefault?.();
  const opts = getFlatOptions();
  const idx = activeIndex();
  if (idx >= 0 && idx < opts.length) {
    activateOption(opts[idx]);
    return;
  }
  goToSearchPage(query());
};

const moveActive = (delta) => {
  const opts = getFlatOptions();
  if (!opts.length) {
    setActiveIndex(-1);
    return;
  }
  setOpen(true);
  const current = activeIndex();
  let next = current + delta;
  if (current < 0) next = delta > 0 ? 0 : opts.length - 1;
  if (next < 0) next = opts.length - 1;
  if (next >= opts.length) next = 0;
  setActiveIndex(next);
  requestAnimationFrame(() => scrollActiveIntoView());
};

const onKeyDown = (event) => {
  const key = event?.key;
  if (key === "Escape") {
    event.preventDefault();
    if (getVariant() === "header" && mobileExpanded()) {
      collapseMobile();
      return;
    }
    closePanel();
    inputRef()?.blur?.();
    return;
  }
  if (key === "ArrowDown") {
    event.preventDefault();
    moveActive(1);
    return;
  }
  if (key === "ArrowUp") {
    event.preventDefault();
    moveActive(-1);
    return;
  }
  if (key === "Home" && showPanel()) {
    event.preventDefault();
    if (getFlatOptions().length) {
      setActiveIndex(0);
      requestAnimationFrame(() => scrollActiveIntoView());
    }
    return;
  }
  if (key === "End" && showPanel()) {
    event.preventDefault();
    const opts = getFlatOptions();
    if (opts.length) {
      setActiveIndex(opts.length - 1);
      requestAnimationFrame(() => scrollActiveIntoView());
    }
  }
};

const hasResults = () => categories().length > 0 || products().length > 0;
const hasEmptySuggestions = () =>
  recentSearches().length > 0 || popularCategories().length > 0;

const showPanel = () => {
  if (getVariant() === "page") return false;
  if (!open()) return false;
  if (error()) return true;
  if (query().trim()) return true;
  return hasEmptySuggestions() || loading();
};

const showEmpty = () =>
  showPanel() &&
  !loading() &&
  !error() &&
  !!query().trim() &&
  !hasResults();

const showError = () => !!error() && !loading();

const showIdleSuggestions = () =>
  showPanel() && !query().trim() && !error();

const isUpdating = () =>
  loading() && (hasResults() || (!!query().trim() && !error()));

const onDocumentPointerDown = (event) => {
  const root = rootRef();
  if (!root) return;
  if (root.contains?.(event.target)) return;
  closePanel();
  if (getVariant() === "header") setMobileExpanded(false);
};

const onDocumentKeyDown = (event) => {
  if ((event.metaKey || event.ctrlKey) && String(event.key).toLowerCase() === "k") {
    event.preventDefault();
    focusSearch();
    return;
  }
  if (event.key === "Escape") {
    if (getVariant() === "header" && mobileExpanded()) collapseMobile();
  }
};

const onMount = () => {
  loadRecentSearches();
  document.addEventListener("pointerdown", onDocumentPointerDown, true);
  document.addEventListener("keydown", onDocumentKeyDown);
  return () => {
    document.removeEventListener("pointerdown", onDocumentPointerDown, true);
    document.removeEventListener("keydown", onDocumentKeyDown);
    if (debounceTimer) clearTimeout(debounceTimer);
    searchSeq += 1;
  };
};

_.createEffect(() => {
  activeIndex();
  categories();
  products();
  recentSearches();
  popularCategories();
  requestAnimationFrame(() => scrollActiveIntoView());
});

if (getVariant() === "page") {
  _.createEffect(() => {
    const next =
      _.searchParams?.q != null ? String(_.searchParams.q).trim() : "";
    setQuery(next);
    void runSearch(next);
  });
}

return {
  props,
  getVariant,
  query,
  setQuery,
  categories,
  products,
  popularCategories,
  recentSearches,
  categoryTotal,
  productTotal,
  loading,
  error,
  open,
  mobileExpanded,
  activeIndex,
  setActiveIndex,
  LISTBOX_ID,
  setRootRef,
  setInputRef,
  setListboxRef,
  onQueryInput,
  openPanel,
  closePanel,
  expandMobile,
  collapseMobile,
  onSubmit,
  onKeyDown,
  selectCategory,
  selectProduct,
  applyRecent,
  categoryHref,
  productHref,
  searchPageHref,
  goToSearchPage,
  hasResults,
  showPanel,
  showEmpty,
  showError,
  showIdleSuggestions,
  resultCountLabel,
  totalsLabel,
  viewAllLabel,
  optionId,
  isOptionActive,
  activeOptionId,
  getFlatOptions,
  applyHighlight,
  highlightHtml,
  isUpdating,
  onMount
};
'''
        key: SiteSearch
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''const isPage = f.getVariant() === "page";
return `._id {
  position: relative;
  display: ${isPage ? "block" : "inline-flex"};
  align-items: center;
  width: ${isPage ? "100%" : "auto"};
  min-width: ${isPage ? "0" : "12rem"};
  max-width: ${isPage ? "40rem" : "18rem"};
  flex: ${isPage ? "none" : "1 1 12rem"};

  mark {
    background: rgba(58, 35, 23, 0.16);
    color: inherit;
    font-weight: 700;
    padding: 0 0.05em;
  }

  @media (max-width: 768px) {
    min-width: ${isPage ? "0" : "auto"};
    max-width: ${isPage ? "none" : "none"};
    flex: ${isPage ? "none" : "0 0 auto"};
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
