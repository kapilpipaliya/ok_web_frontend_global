    {
      id: "15"
      L: Attr
      P: {
        css:
          '''const option = c.optionValue || {};
const compatible =
  f.isOptionCompatible?.(option.axisKey, option.value) !== false;
const selected = !!f.isOptionSelected?.(option.axisKey, option.value);
const isColor = !!option.isColor;
return `._id {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: ${isColor ? "2.25rem" : "2.75rem"};
  min-height: 2.25rem;
  padding: ${isColor ? "0.2rem" : "0.45rem 0.8rem"};
  border-radius: ${isColor ? "999px" : "0.5rem"};
  border: 2px solid ${selected ? t.var.color.primary : t.var.color.border};
  background: ${selected ? t.var.color.primary_light_100 : t.var.color.background};
  color: ${compatible ? t.var.color.text : t.var.color.text_light_400};
  font-size: 0.875rem;
  font-weight: ${selected ? 700 : 500};
  line-height: 1.2;
  cursor: pointer;
  opacity: ${compatible ? 1 : 0.55};
  text-decoration: ${compatible ? "none" : "line-through"};
  transition: border-color 0.15s ease, background 0.15s ease, opacity 0.15s ease, transform 0.15s ease;

  &:focus-visible {
    outline: 2px solid ${t.var.color.primary};
    outline-offset: 2px;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    &:hover {
      border-color: ${t.var.color.primary};
      transform: translateY(-1px);
    }
  }

  ${!compatible ? `
  &::after {
    content: "";
    position: absolute;
    inset: 45% -8%;
    height: 1.5px;
    background: ${t.var.color.text_light_400};
    transform: rotate(-28deg);
    pointer-events: none;
  }
  ` : ""}
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const option = c.optionValue || {};
const compatible =
  f.isOptionCompatible?.(option.axisKey, option.value) !== false;
const selected = !!f.isOptionSelected?.(option.axisKey, option.value);
return {
  as: "button",
  type: "button",
  class: "pd-swatch",
  role: "option",
  "aria-selected": selected,
  title: compatible ? option.label : `${option.label} (switches other options)`,
  onClick: () => f.selectOptionValue?.(option.axisKey, option.value)
};'''
      }
    }
