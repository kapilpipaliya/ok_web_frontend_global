        props:
          '''const images = f.carouselImages?.() || [];
const variant = f.previewVariant?.();
const selection = f.selection?.() || {};
const selectionKey = Object.keys(selection)
  .sort()
  .map((axisKey) => `${axisKey}:${selection[axisKey] ?? ""}`)
  .join("|");
return {
  key: variant?.id != null ? String(variant.id) : selectionKey || "carousel",
  data: images,
  contextName: "productImage",
  loop: images.length > 1,
  showArrows: images.length > 1,
  showDots: false,
  activeIndex: f.carouselIndex?.() ?? 0,
  onActiveIndexChange: (index) => f.setCarouselIndex?.(index),
  hide: images.length === 0
};'''
