{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        dynamicComponent: Carousel, Button
        description: Product detail with option swatches, availability-aware selection, image carousel, and markdown description.
        key: ProductDetailView
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}`;'''
        displayOrder: 1
        fns:
          '''const props = () => c.props || {};
const product = () => props().product || {};

const normalize = (value) => (value == null ? "" : String(value).trim());

const parseAxes = () => {
  const axes = product().optionAxes;
  return Array.isArray(axes) ? axes.filter((axis) => axis?.key) : [];
};

const parseVariants = () => {
  const variants = product().variants;
  return Array.isArray(variants) ? variants : [];
};

const uniqueValuesForAxis = (axisKey) => {
  const values = new Set();
  for (const variant of parseVariants()) {
    const value = normalize(variant?.options?.[axisKey]);
    if (value) values.add(value);
  }
  return Array.from(values).sort((a, b) => a.localeCompare(b));
};

const selectableAxes = () =>
  parseAxes().filter((axis) => uniqueValuesForAxis(axis.key).length > 0);

const hasSelectableOptions = () => selectableAxes().length > 0;

const isColorAxis = (axis) => {
  const key = normalize(axis?.key).toLowerCase();
  const label = normalize(axis?.label).toLowerCase();
  return key.includes("color") || key.includes("colour") || label.includes("color") || label.includes("colour");
};

const looksLikeColor = (value) => {
  const raw = normalize(value);
  if (!raw) return false;
  if (/^#([0-9a-f]{3}|[0-9a-f]{6}|[0-9a-f]{8})$/i.test(raw)) return true;
  if (/^(rgb|hsl)a?\(/i.test(raw)) return true;
  return /^[a-z]{3,20}$/i.test(raw);
};

const variantMatchesPartial = (variant, selection, skipAxisKey) => {
  for (const axis of selectableAxes()) {
    if (axis.key === skipAxisKey) continue;
    const selected = normalize(selection?.[axis.key]);
    if (!selected) continue;
    if (normalize(variant?.options?.[axis.key]) !== selected) return false;
  }
  return true;
};

const isValueAvailable = (axisKey, value, selection) => {
  const target = normalize(value);
  if (!target) return false;
  return parseVariants().some((variant) => {
    if (normalize(variant?.options?.[axisKey]) !== target) return false;
    return variantMatchesPartial(variant, selection, axisKey);
  });
};

const findExactVariant = (selection) => {
  // No option types (or none with values) → always show the first variant.
  if (!hasSelectableOptions()) return parseVariants()[0] || null;
  const axes = selectableAxes();
  if (axes.some((axis) => !normalize(selection?.[axis.key]))) return null;
  return (
    parseVariants().find((variant) =>
      axes.every(
        (axis) => normalize(variant?.options?.[axis.key]) === normalize(selection?.[axis.key])
      )
    ) || null
  );
};

const scoreVariant = (variant, selection) => {
  let score = 0;
  let mismatches = 0;
  for (const axis of selectableAxes()) {
    const selected = normalize(selection?.[axis.key]);
    if (!selected) continue;
    const variantValue = normalize(variant?.options?.[axis.key]);
    if (!variantValue) {
      mismatches += 1;
      continue;
    }
    if (variantValue === selected) score += 1;
    else mismatches += 1;
  }
  return { score, mismatches };
};

const findNearestVariant = (selection, preferredAxisKey) => {
  const variants = parseVariants();
  if (variants.length === 0) return null;
  const preferredValue = preferredAxisKey ? normalize(selection?.[preferredAxisKey]) : "";
  let pool = variants;
  if (preferredAxisKey && preferredValue) {
    const matchingPreferred = variants.filter(
      (variant) => normalize(variant?.options?.[preferredAxisKey]) === preferredValue
    );
    if (matchingPreferred.length > 0) pool = matchingPreferred;
  }
  let best = pool[0];
  let bestScore = -1;
  let bestMismatches = Number.POSITIVE_INFINITY;
  for (const variant of pool) {
    const { score, mismatches } = scoreVariant(variant, selection);
    if (score > bestScore || (score === bestScore && mismatches < bestMismatches)) {
      best = variant;
      bestScore = score;
      bestMismatches = mismatches;
    }
  }
  return best;
};

const selectionFromVariant = (variant) => {
  const next = {};
  for (const axis of selectableAxes()) {
    next[axis.key] = normalize(variant?.options?.[axis.key]);
  }
  return next;
};

const autoSelectSingletons = (selection) => {
  let next = { ...selection };
  let changed = true;
  while (changed) {
    changed = false;
    for (const axis of selectableAxes()) {
      const available = uniqueValuesForAxis(axis.key).filter((value) =>
        isValueAvailable(axis.key, value, next)
      );
      const current = normalize(next[axis.key]);
      if (current && !available.includes(current)) {
        next = { ...next, [axis.key]: available[0] || "" };
        changed = true;
        continue;
      }
      if (available.length === 1 && current !== available[0]) {
        next = { ...next, [axis.key]: available[0] };
        changed = true;
      }
    }
  }
  return next;
};

const reconcileSelection = (selection, preferredAxisKey) => {
  if (!hasSelectableOptions()) {
    const first = parseVariants()[0] || null;
    return { selection: {}, variant: first };
  }
  let next = { ...selection };
  let exact = findExactVariant(next);
  if (!exact) {
    const nearest = findNearestVariant(next, preferredAxisKey);
    if (nearest) next = selectionFromVariant(nearest);
  }
  next = autoSelectSingletons(next);
  exact = findExactVariant(next);
  if (!exact) {
    const nearest = findNearestVariant(next, preferredAxisKey);
    if (nearest) {
      next = autoSelectSingletons(selectionFromVariant(nearest));
      exact = findExactVariant(next);
    }
  }
  return { selection: next, variant: exact };
};

const buildInitialSelection = () => {
  if (!hasSelectableOptions()) {
    return { selection: {}, variant: parseVariants()[0] || null };
  }
  const first = parseVariants()[0];
  const base = first ? selectionFromVariant(first) : {};
  for (const axis of selectableAxes()) {
    if (!normalize(base[axis.key])) {
      const values = uniqueValuesForAxis(axis.key);
      base[axis.key] = values[0] || "";
    }
  }
  return reconcileSelection(base, null);
};

const initialResolved = buildInitialSelection();
const [selection, setSelection] = _.createSignal(initialResolved.selection);
const [activeVariant, setActiveVariant] = _.createSignal(initialResolved.variant);

// Re-resolve when product data arrives or changes (e.g. async serverFunction).
_.createEffect(() => {
  const productKey = product()?.key || product()?.id || "";
  const variantCount = parseVariants().length;
  const axisSignature = selectableAxes()
    .map((axis) => `${axis.key}:${uniqueValuesForAxis(axis.key).join(",")}`)
    .join("|");
  void productKey;
  void variantCount;
  void axisSignature;
  const resolved = buildInitialSelection();
  setSelection(resolved.selection);
  setActiveVariant(resolved.variant);
});

const applySelection = (nextSelection, preferredAxisKey) => {
  const reconciled = reconcileSelection(nextSelection, preferredAxisKey);
  setSelection(reconciled.selection);
  setActiveVariant(reconciled.variant);
};

const selectOptionValue = (axisKey, value) => {
  const nextValue = normalize(value);
  if (!nextValue || !axisKey) return;
  // Always allow choosing a known option value; reconcile other axes to the nearest valid variant.
  applySelection({ ...selection(), [axisKey]: nextValue }, axisKey);
};

const optionAxesForUi = () =>
  selectableAxes().map((axis) => ({
    key: axis.key,
    label: axis.label || axis.key,
    isColor: isColorAxis(axis),
    values: uniqueValuesForAxis(axis.key)
  }));

const optionValuesForAxis = (axis) => {
  const currentSelection = selection();
  const selected = normalize(currentSelection?.[axis.key]);
  return (axis.values || []).map((value) => {
    const compatible = isValueAvailable(axis.key, value, currentSelection);
    return {
      axisKey: axis.key,
      value,
      label: value,
      compatible,
      selected: selected === normalize(value),
      isColor: !!axis.isColor && looksLikeColor(value),
      swatchColor: looksLikeColor(value) ? value : ""
    };
  });
};

const isOptionCompatible = (axisKey, value) =>
  isValueAvailable(axisKey, value, selection());

const isOptionSelected = (axisKey, value) =>
  normalize(selection()?.[axisKey]) === normalize(value);

const hasExactVariant = () => !!activeVariant();

const previewVariant = () => {
  if (!hasSelectableOptions()) return parseVariants()[0] || null;
  return activeVariant() || findNearestVariant(selection(), null);
};

const carouselImages = () => {
  const images = previewVariant()?.images;
  const variantImages = Array.isArray(images) ? images.filter((img) => img && (img.url || img.placeholder)) : [];
  if (variantImages.length > 0) return variantImages;
  const listing = product()?.listingImage;
  if (listing && (listing.url || listing.placeholder)) {
    return [
      {
        id: "listing",
        url: listing.url || "",
        srcset: listing.srcset || "",
        width: listing.width,
        height: listing.height,
        ready: listing.ready,
        placeholder: listing.placeholder,
        alt: product()?.title || "Product image"
      }
    ];
  }
  const listingUrl = product()?.listingImageUrl;
  if (listingUrl) {
    return [{ id: "listing", url: listingUrl, alt: product()?.title || "Product image", ready: true }];
  }
  return [];
};

const formatRupeePrice = (price) => {
  const raw = price == null ? "" : String(price).trim();
  if (!raw) return "";
  return /^₹/.test(raw) ? raw : `₹${raw}`;
};

const [carouselIndex, setCarouselIndex] = _.createSignal(0);
const [galleryContainerEl, setGalleryContainerEl] = _.createSignal(null);

_.createEffect(() => {
  void previewVariant()?.id;
  void carouselImages().length;
  setCarouselIndex(0);
});

_.createEffect(() => {
  const index = carouselIndex();
  const container = galleryContainerEl();
  if (!container) return;
  const thumb = container.querySelector(`[data-gallery-index="${index}"]`);
  if (!thumb) return;
  thumb.scrollIntoView({ behavior: "smooth", inline: "nearest", block: "nearest" });
});

const availabilityLabel = () => {
  const variant = activeVariant() || (!hasSelectableOptions() ? parseVariants()[0] : null);
  if (!variant) {
    return hasSelectableOptions() ? "Select options to see availability" : "Unavailable";
  }
  if (variant?.stock != null && String(variant.stock).trim() !== "") {
    return String(variant.stock).trim();
  }
  return variant?.amazonUrl ? "In stock" : "Available";
};

return {
  product,
  parseAxes,
  parseVariants,
  selection,
  activeVariant,
  previewVariant,
  hasExactVariant,
  optionAxesForUi,
  optionValuesForAxis,
  selectOptionValue,
  isValueAvailable,
  isOptionCompatible,
  isOptionSelected,
  carouselImages,
  carouselIndex,
  setCarouselIndex,
  setGalleryContainerEl,
  formatRupeePrice,
  availabilityLabel,
  openAmazon: () => {
    const url = activeVariant()?.amazonUrl;
    if (url) window.open(url, "_blank", "noopener,noreferrer");
  }
};'''
