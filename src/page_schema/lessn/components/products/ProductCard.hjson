    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  width: 100%;
  text-align: left;
  padding: 0;
  border: 1px solid ${t.var.color.border};
  border-radius: 0.75rem;
  background: ${t.var.color.background};
  overflow: hidden;
  cursor: pointer;
  text-decoration: none;
  color: inherit;
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
  transform-origin: center center;

  &:hover {
    z-index: 1;
    border-color: ${t.var.color.primary_light_300};
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }

  &:focus-visible {
    outline: 2px solid ${t.var.color.primary};
    outline-offset: 2px;
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const item = c.props?.item || c.props || {};
const index = c.props?.index ?? c.index ?? 0;
const onOpen = c.props?.onOpen;
return {
  as: "button",
  type: "button",
  "data-animate": "",
  ref: (el) => {
    if (!el) return;
    f.animateOnView?.(el, { delay: index * 0.05 });
    if (el.dataset.hoverInit) return;
    el.dataset.hoverInit = "true";
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    _.motion.hover(el, (element) => {
      _.motion.animate(element, { scale: 1.1 });
      return () => _.motion.animate(element, { scale: 1 });
    });
  },
  onClick: () => onOpen?.(item)
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  background: ${t.var.color.background_light_200};
  overflow: hidden;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "motionFragment" };
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''return `._id {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease;

  button:hover & {
    transform: scale(1.04);
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const item = c.props?.item || c.props || {};
const src = item.previewUrl || "";
const ready = item.previewReady !== false && !!src;
return {
  as: ready ? "img" : "fragment",
  src: ready ? src : undefined,
  srcset: ready && item.previewSrcset ? item.previewSrcset : undefined,
  sizes: ready ? "(max-width:768px) 50vw, 280px" : undefined,
  width: ready && item.previewWidth ? item.previewWidth : undefined,
  height: ready && item.previewHeight ? item.previewHeight : undefined,
  alt: item.title || "Product",
  loading: "lazy"
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id {
  position: absolute;
