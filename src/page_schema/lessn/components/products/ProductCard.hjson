{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        description: Affiliate product card. Props: item, href, onOpen(item), index.
        key: ProductCard
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  width: 100%;
  text-align: left;
  padding: 0;
  border: 1px solid ${t.var.color.border};
  border-radius: 0.75rem;
  background: ${t.var.color.background};
  overflow: hidden;
  color: inherit;
  transition: box-shadow 0.15s ease, border-color 0.15s ease, transform 0.15s ease;

  &:hover {
    z-index: 1;
    border-color: ${t.var.color.primary_light_300};
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }

  &:focus-within {
    outline: 2px solid ${t.var.color.primary};
    outline-offset: 2px;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    &:hover {
      transform: translateY(-2px);
    }
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const item = c.props?.item || c.props || {};
const index = c.props?.index ?? c.index ?? 0;
return {
  as: "article",
  ref: (el) => {
    if (!el) return;
    f.animateOnView?.(el, { delay: Math.min(index, 6) * 0.02 });
  }
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  background: ${t.var.color.background_light_200};
  overflow: hidden;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "motionFragment" };
      }
    }
    {
      id: "card_link"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  color: inherit;
  text-decoration: none;
  cursor: pointer;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const item = c.props?.item || c.props || {};
const onOpen = c.props?.onOpen;
const href = c.props?.href;
return {
  as: href ? "a" : "button",
  type: href ? undefined : "button",
  href: href || undefined,
  onClick: (e) => {
    if (!href && !onOpen) return;
    if (href && (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0)) return;
    if (href) e.preventDefault();
    if (onOpen) onOpen(item);
    else if (href) _.navigate(href);
  }
};'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''return `._id {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.15s ease;

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    a:hover &,
    button:hover &,
    article:hover & {
      transform: scale(1.03);
    }
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const item = c.props?.item || c.props || {};
const src = item.previewUrl || "";
const ready = item.previewReady !== false && !!src;
const index = c.props?.index ?? c.index ?? 0;
return {
  as: ready ? "img" : "fragment",
  src: ready ? src : undefined,
  srcset: ready && item.previewSrcset ? item.previewSrcset : undefined,
  sizes: ready ? "(max-width:768px) 50vw, 280px" : undefined,
  width: ready && item.previewWidth ? item.previewWidth : undefined,
  height: ready && item.previewHeight ? item.previewHeight : undefined,
  alt: item.title || "Product",
  loading: index < 6 ? "eager" : "lazy",
  fetchpriority: index === 0 ? "high" : undefined
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: ${t.var.color.primary};
  background: linear-gradient(
    135deg,
    ${t.var.color.primary_light_100} 0%,
    ${t.var.color.background_light_100} 100%
  );
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const item = c.props?.item || c.props || {};
const ready = !!item.previewUrl && item.previewReady !== false;
return {
  as: "div",
  hide: ready
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "icon",
  icon: "ph:shopping-bag",
  width: 40,
  height: 40
};'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''return `._id {
  position: absolute;
  top: 0.5rem;
  right: 0.5rem;
  padding: 0.2rem 0.5rem;
  border-radius: 0.25rem;
  font-size: 0.75rem;
  font-weight: 700;
  background: ${t.var.color.primary};
  color: ${t.var.color.primary_text};
}`;'''
        displayOrder: 3
        componentName: Html
        props:
          '''const item = c.props?.item || c.props || {};
const raw = item.price == null ? "" : String(item.price).trim();
const price = !raw ? "" : (/^₹/.test(raw) ? raw : `₹${raw}`);
return {
  as: "span",
  text: price,
  hide: !price
};'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  padding: 0.5rem 0.875rem 0.5rem;
  min-width: 0;
}`;'''
        displayOrder: 2
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        css:
          '''return `._id {
  margin: 0;
  font-size: 0.9375rem;
  font-weight: 600;
  color: ${t.var.color.text};
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const item = c.props?.item || c.props || {};
return {
  as: "h3",
  text: item.title || "Untitled"
};'''
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        css:
          '''return `._id {
  margin: 0;
  font-size: 0.8125rem;
  color: ${t.var.color.text_light_300};
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const item = c.props?.item || c.props || {};
const text = item.shortDescription || "";
return {
  as: "p",
  text,
  hide: !text
};'''
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        css:
          '''return `._id {
  margin: 0 0.75rem 0.75rem;
  padding: 0.45rem 0.7rem;
  border-radius: 0.375rem;
  background: ${t.var.color.primary};
  color: ${t.var.color.primary_text};
  font-size: 0.8125rem;
  font-weight: 700;
  text-align: center;
  text-decoration: none;
  position: relative;
  z-index: 1;

  &:hover {
    background: ${t.var.color.primary_dark_200};
  }
}`;'''
        displayOrder: 3
        componentName: Html
        props:
          '''const item = c.props?.item || c.props || {};
const url = item.amazonUrl != null ? String(item.amazonUrl).trim() : "";
return {
  as: "a",
  href: url || undefined,
  target: "_blank",
  rel: "noopener noreferrer",
  text: "View on Amazon",
  hide: !url
};'''
