        componentName: Html
        props:
          '''const parent = f.parentCrumb?.();
const href = f.parentHref?.() || f.crumbHref?.(parent) || f.getBasePath?.();
const label = parent?.isRoot
  ? (f.labels?.()?.rootBreadcrumbLabel || "Products")
  : (parent?.name || "Parent category");
return {
  as: "a",
  href,
  text: `Browse ${label}`,
  hide: !parent,
  onClick: (e) => {
    if (f.useUrlState?.()) return;
    e.preventDefault();
    f.navigateBreadcrumb?.(parent);
  }
};'''
