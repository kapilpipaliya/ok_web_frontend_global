{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        description: Recursive product category browser. Props: initialData, labels, tableKey, tableVertexLabel, useUrlState (default false = local state), basePath, urlParam (default category), locale.
        key: ProductBrowser
        updatedAt: 2026-07-15T11:23:21.356Z
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}`;'''
        displayOrder: 1
        fns:
          '''const props = () => c.props || {};

// useUrlState true  → real links; page reloads initialData from ?category=
// useUrlState false → local loadFolder (no URL)
const useUrlState = () => props().useUrlState === true;
const urlParam = () => {
  const key = props().urlParam;
  return key != null && String(key).trim() !== "" ? String(key).trim() : "category";
};

const [overrideData, setOverrideData] = _.createSignal(null);
const [loading, setLoading] = _.createSignal(false);
const [error, setError] = _.createSignal("");

const getData = () => {
  if (useUrlState()) return props().initialData || {};
  return overrideData() || props().initialData || {};
};

const getFoldersForRender = () => {
  const list = getData().folders;
  return Array.isArray(list) ? list : [];
};
const getItemsForRender = () => {
  const list = getData().items;
  return Array.isArray(list) ? list : [];
};
const getBreadcrumbForRender = () => {
  const list = getData().breadcrumb;
  return Array.isArray(list) ? list : [];
};

const labels = () => ({
  rootBreadcrumbLabel: "Products",
  emptyCategoriesText: "No categories in this location.",
  emptyProductsText: "No products in this category.",
  loadingText: "Loading…",
  ...(props().labels || {})
});

const getBasePath = () => {
  const fromProps = props().basePath;
  if (fromProps != null && String(fromProps).trim() !== "") return String(fromProps).trim();
  const lang = _.params?.lang ? String(_.params.lang).toLowerCase() : "";
  if (lang && /^[a-z]{2,3}$/i.test(lang)) return `/${lang}/products`;
  return "/products";
};

const folderHref = (folderKey) => {
  if (!useUrlState()) return null;
  const base = getBasePath();
  if (!folderKey) return base;
  return `${base}/${encodeURIComponent(String(folderKey))}`;
};

const crumbHref = (crumb) => {
  if (!useUrlState()) return null;
  if (!crumb || crumb.isRoot || !crumb.key) return getBasePath();
  return folderHref(crumb.key);
};

const loadFolder = async (categoryKey) => {
  setLoading(true);
  setError("");
  try {
    const result = await s({
      functionName: "loadPublicProductsFolder",
      contextData: {
        tableKey: props().tableKey || "products",
        tableVertexLabel: props().tableVertexLabel || "Product",
        categoryKey: categoryKey || null,
        locale: props().locale || null
      }
    });
    if (!result?.result?.success) {
      setError(result?.result?.message || result?.error || "Failed to load products");
      return;
    }
    const data = result.result.data || {};
    setOverrideData({
      folders: Array.isArray(data.folders) ? data.folders : [],
      items: Array.isArray(data.items) ? data.items : [],
      breadcrumb: Array.isArray(data.breadcrumb) ? data.breadcrumb : [],
      currentCategoryId: data.currentCategoryId || null,
      currentCategoryKey: data.currentCategoryKey || null
    });
  } catch (e) {
    console.error("ProductBrowser loadFolder failed:", e);
    setError(e?.message || "Failed to load products");
  } finally {
    setLoading(false);
  }
};

const openFolder = (folder) => {
  if (useUrlState() || !folder?.key) return;
  loadFolder(folder.key);
};

const navigateBreadcrumb = (crumb) => {
  if (useUrlState() || !crumb) return;
  if (crumb.isRoot) loadFolder(null);
  else if (crumb.key) loadFolder(crumb.key);
};

const productHref = (item) => {
  if (!item?.key) return null;
  const lang = _.params?.lang ? String(_.params.lang).toLowerCase() : "";
  const langPrefix = lang && /^[a-z]{2,3}$/i.test(lang) ? `/${lang}` : "";
  return `${langPrefix}/product/${encodeURIComponent(String(item.key).trim())}`;
};

const openProduct = (item) => {
  const href = productHref(item);
  if (!href) return;
  _.navigate(href);
};

const getLangPrefix = () => {
  const base = getBasePath();
  const fromBase = String(base || "").match(/^\/([a-z]{2,3})(?:\/|$)/i);
  if (fromBase) return `/${fromBase[1].toLowerCase()}`;
  const lang = _.params?.lang ? String(_.params.lang).toLowerCase() : "";
  if (lang && /^[a-z]{2,3}$/i.test(lang)) return `/${lang}`;
  return "";
};

const searchHref = () => `${getLangPrefix()}/search`;

const parentCrumb = () => {
  const crumbs = getBreadcrumbForRender();
  if (!Array.isArray(crumbs) || crumbs.length < 2) return null;
  return crumbs[crumbs.length - 2];
};

return {
  useUrlState,
  urlParam,
  getFoldersForRender,
  getItemsForRender,
  getBreadcrumbForRender,
  loading,
  error,
  labels,
  getBasePath,
  folderHref,
  crumbHref,
  productHref,
  openFolder,
  navigateBreadcrumb,
  openProduct,
  parentCrumb,
  searchHref,
  parentHref: () => {
    const crumb = parentCrumb();
    if (!crumb) return getBasePath();
    return crumbHref(crumb) || getBasePath();
  },
  hasFolders: () => getFoldersForRender().length > 0,
  hasItems: () => getItemsForRender().length > 0,
  isEmpty: () => getFoldersForRender().length === 0 && getItemsForRender().length === 0,
  getData
};'''
        componentName: Html
        props:
          '''return {
  as: "div"
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: GalleryBreadcrumb
        props:
          '''const crumbs = f.getBreadcrumbForRender?.()
  || c.props?.initialData?.breadcrumb
  || [];
const withUrl = f.useUrlState?.() === true
  || c.props?.useUrlState === true;
const basePath = f.getBasePath?.() || c.props?.basePath || "/products";
return {
  items: Array.isArray(crumbs) ? crumbs : [],
  rootLabel: f.labels?.()?.rootBreadcrumbLabel || "Products",
  rootHref: withUrl ? basePath : null,
  hrefFor: withUrl
    ? (crumb) => f.crumbHref?.(crumb) || basePath
    : null,
  onNavigate: withUrl ? undefined : (crumb) => f.navigateBreadcrumb?.(crumb)
};'''
      }
    }
