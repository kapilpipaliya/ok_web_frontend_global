    {
      id: "banner_css"
      L: Attr
      P: {
        displayOrder: 0
        componentName: Html
        props:
          '''return {
  as: "style",
  text: `.home-banner-stage {
  aspect-ratio: 3 / 1;
  width: 100%;
  max-height: none !important;
}
.home-banner-stage > *:first-child,
.home-banner-stage > *:first-child > *,
.home-banner-stage > *:first-child > * > * {
  height: 100%;
  max-height: none !important;
}
.home-banner-carousel,
.home-banner-carousel * {
  max-height: none !important;
}
.home-banner-carousel a {
  display: block;
  width: 100%;
  height: 100%;
}
.home-banner-carousel img {
  display: block;
  width: 100% !important;
  height: 100% !important;
  max-height: none !important;
  object-fit: contain !important;
  object-position: center;
}`
};'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  padding: 0;
  margin-bottom: 0;
}`;'''
        displayOrder: 1
        componentName: Carousel
        key: unique_3
        props:
          '''const banners = c.homeSettings?.banners ?? [];
return {
  class: "home-banner-carousel",
  stageClass: "home-banner-stage",
  aspectRatio: "3 / 1",
  data: banners,
  contextName: "banner",
  loop: true,
  showArrows: true,
  showDots: true,
  hide: () => banners.length === 0
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: block;
  width: 100%;
  height: 100%;
  line-height: 0;
  text-decoration: none;
  color: inherit;
}`;'''
        displayOrder: 1
        componentName: Html
        key: unique_6
        props:
          '''const banner = c.banner;
const rawPath = banner?.P?.description != null ? String(banner.P.description).trim() : "";

const localizeHref = (path) => {
  if (!path) return null;
  if (/^https?:\/\//i.test(path) || path.startsWith("mailto:") || path === "#") {
    return path;
  }
  const normalized = path.startsWith("/") ? path : `/${path}`;
  const lang = _.params?.lang ? String(_.params.lang).toLowerCase() : "";
  // Match [lang]/[...page].tsx: only prefix when first segment is a language code
  if (lang && /^[a-z]{2,3}$/i.test(lang)) {
    if (normalized === "/") return `/${lang}`;
    return `/${lang}${normalized}`;
  }
  return normalized;
};

const href = localizeHref(rawPath);

return {
  as: href ? "a" : "div",
  ...(href ? { href } : {})
};'''
      }
    }
    {
      id: "4"
