        displayOrder: 1
        componentName: Html
        key: unique_7
        props:
          '''const banner = c.banner;
const fileName = banner?.P?.fileName != null ? String(banner.P.fileName).trim() : "";
const isFirst = (c.index ?? 0) === 0;
return {
  as: "img",
  src: fileName ? `/api/file/download/${encodeURIComponent(fileName)}` : undefined,
  alt: "Lessn home banner",
  width: 1500,
  height: 500,
  sizes: "100vw",
  loading: isFirst ? "eager" : "lazy",
  fetchpriority: isFirst ? "high" : undefined,
  decoding: "async",
  onLoad: () => f.emblaApi?.()?.reInit?.()
};'''
      }
