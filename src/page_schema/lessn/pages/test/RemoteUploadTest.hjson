}`;
'''
        props:
          '''
return {
  as: "p",
  text: "Use the form to batch-upload remote URLs via POST /api/file/upload with { files: [{ url, fileName }] }. Failures are reported per file without aborting the whole batch."
};
'''
      }
    }
    {
      id: "form"
      L: Attr
      P: {
        displayOrder: 3
        componentName: FormManagement
        props:
          '''
return {
  mode: "add",
  vertexLabel: "RemoteUploadTest",
  formConfig: f.remoteUploadFormConfiguration,
  onSave: f.saveRemoteUploadForm,
  afterSuccessfulSave: "reinitialize",
  class: "remote-upload-test-form"
};
'''
      }
    }
    {
      id: "downloads"
      L: Attr
      P: {
        displayOrder: 4
        componentName: Html
        css:
          '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}`;
'''
        props:
          '''
return {
  as: "div",
  show: () => (f.uploadedFiles?.() || []).length > 0
};
'''
      }
    }
    {
      id: "downloads_title"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        css:
          '''
return `._id {
  margin: 0;
  font-size: 0.875rem;
  font-weight: 600;
  color: ${t.var.color.text};
}`;
'''
        props:
          '''
return {
  as: "h2",
  text: "Uploaded files"
};
'''
      }
    }
    {
      id: "downloads_links"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        css:
          '''
return `._id {
  font-size: 0.9375rem;
  line-height: 1.5;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;

  a {
    color: ${t.var.color.primary};
    text-decoration: underline;
  }
}`;
'''
        props:
          '''
return {
  as: "div",
  innerHTML: f.uploadedFilesHtml?.() || "",
  show: () => (f.uploadedFiles?.() || []).length > 0
};
'''
      }
    }
    {
      id: "result_label"
      L: Attr
