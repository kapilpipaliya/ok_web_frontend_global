{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        settingsPageId: products
        isNoPermissionCheck: true
        fns: return { enabled: () => true }
        url: /products/:category?
        key: Products
        props:
          '''
const locale = _.params?.lang ? String(_.params.lang).toLowerCase() : undefined;
const routeParams = _.context?.getParams?.(_.meta) || {};
const categoryKey = routeParams.category != null && String(routeParams.category).trim() !== ""
  ? String(routeParams.category).trim()
  : null;
return {
  contextName: "productsSettings",
  serverFunction: `
try {
  const pageResult = await s({
    functionName: "loadPublicPageSettings",
    contextData: { pageId: "products", allowPublicRead: true, locale: ${JSON.stringify(locale ?? null)} }
  });
  const folderResult = await s({
    functionName: "loadPublicProductsFolder",
    contextData: {
      tableKey: "products",
      tableVertexLabel: "Product",
      categoryKey: ${JSON.stringify(categoryKey)},
      locale: ${JSON.stringify(locale ?? null)}
    }
  });

  const sections = pageResult?.result?.success ? (pageResult.result.data?.sections || {}) : {};
  const folderData = folderResult?.result?.success ? (folderResult.result.data || {}) : {};

  return {
    content: sections.content || {},
    folderData,
    categoryKey: ${JSON.stringify(categoryKey)}
  };
} catch (error) {
  console.error("Error loading products page:", error);
  return {
    content: {},
    folderData: { folders: [], items: [], breadcrumb: [] },
    categoryKey: ${JSON.stringify(categoryKey)}
  };
}
`
};
'''
      }
    }
    {
      id: "seo_title"
      L: Attr
      P: {
        displayOrder: 0.1
        componentName: Html
        props:
          '''const content = c.productsSettings?.content || {};
const folderData = c.productsSettings?.folderData || {};
const categoryKey = c.productsSettings?.categoryKey;
const crumbs = Array.isArray(folderData.breadcrumb) ? folderData.breadcrumb : [];
const current = crumbs.length > 0 ? crumbs[crumbs.length - 1] : null;
const categoryLabel =
  (current && !current.isRoot && (current.name || current.title || current.key)) ||
  categoryKey ||
  null;
const pageTitle = content.pageTitle || "Products";
const title = categoryLabel
  ? `${categoryLabel} | ${pageTitle} | Lessn`
  : `${pageTitle} | Lessn`;
return {
  as: "title",
  text: title
};'''
      }
    }
    {
      id: "seo_description"
      L: Attr
      P: {
        displayOrder: 0.2
        componentName: Html
        props:
          '''const content = c.productsSettings?.content || {};
const folderData = c.productsSettings?.folderData || {};
const categoryKey = c.productsSettings?.categoryKey;
const crumbs = Array.isArray(folderData.breadcrumb) ? folderData.breadcrumb : [];
const current = crumbs.length > 0 ? crumbs[crumbs.length - 1] : null;
const categoryLabel =
  (current && !current.isRoot && (current.name || current.title || current.key)) ||
  categoryKey ||
  null;
const base =
  content.pageSubtitle ||
  "Browse our curated Amazon product picks by category.";
return {
  as: "meta",
  name: "description",
  content: categoryLabel ? `${categoryLabel} — ${base}` : base
};'''
      }
    }
    {
      id: "seo_robots"
      L: Attr
      P: {
        displayOrder: 0.3
        componentName: Html
        props:
          '''const categoryKey = c.productsSettings?.categoryKey;
const invalid =
  categoryKey != null &&
  (String(categoryKey).startsWith(":") || String(categoryKey).includes("{"));
return {
  as: "meta",
  name: "robots",
  content: "noindex, nofollow",
  hide: !invalid
};'''
      }
    }
    {
      id: "seo_og_title"
      L: Attr
      P: {
        displayOrder: 0.4
        componentName: Html
        props:
          '''const content = c.productsSettings?.content || {};
const folderData = c.productsSettings?.folderData || {};
const categoryKey = c.productsSettings?.categoryKey;
const crumbs = Array.isArray(folderData.breadcrumb) ? folderData.breadcrumb : [];
const current = crumbs.length > 0 ? crumbs[crumbs.length - 1] : null;
const categoryLabel =
  (current && !current.isRoot && (current.name || current.title || current.key)) ||
  categoryKey ||
  null;
const pageTitle = content.pageTitle || "Products";
return {
  as: "meta",
  property: "og:title",
  content: categoryLabel
    ? `${categoryLabel} | ${pageTitle} | Lessn`
    : `${pageTitle} | Lessn`
};'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  padding: 0.5rem 1rem 1.25rem;
}`;'''
        displayOrder: 2
        componentName: Html
        props: return { as: "main" };
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  max-width: 1200px;
  margin: 0 auto;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''return `._id {
  margin: 0 0 1.5rem 0;
  font-size: 2rem;
  font-weight: 700;
  color: ${t.var.color.text};
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''const content = c.productsSettings?.content || {};
return {
  as: "h1",
  text: content.pageTitle || "Products",
  hide: true
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id {
  margin: -0.75rem 0 1.5rem 0;
  color: ${t.var.color.text_light_300};
  font-size: 1rem;
  line-height: 1.5;
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const content = c.productsSettings?.content || {};
return {
  as: "p",
  text: content.pageSubtitle || "Browse our curated Amazon product picks",
  hide: true
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 3
        componentName: ProductBrowser
        props:
          '''const content = c.productsSettings?.content || {};
const folderData = c.productsSettings?.folderData || {};
const locale = _.params?.lang ? String(_.params.lang).toLowerCase() : undefined;
const langPrefix = locale && /^[a-z]{2,3}$/i.test(locale) ? `/${locale}` : "/en";
return {
  tableKey: "products",
  tableVertexLabel: "Product",
  locale,
  useUrlState: true,
  basePath: `${langPrefix}/products`,
  initialData: folderData,
  labels: {
    rootBreadcrumbLabel: content.rootBreadcrumbLabel || content.pageTitle || "Products",
    emptyCategoriesText: content.emptyCategoriesText || "No categories in this location.",
    emptyProductsText: content.emptyProductsText || "No products in this category.",
    loadingText: "Loading…"
  }
};'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        css:
          '''return `._id {
  margin: 1rem 0 0;
  font-size: 0.75rem;
  line-height: 1.5;
  color: ${t.var.color.text_light_200};
}`;'''
        displayOrder: 4
        componentName: Html
        props:
          '''const content = c.productsSettings?.content || {};
return {
  as: "p",
  text: content.disclosureText || "As an Amazon Associate we earn from qualifying purchases."
};'''
      }
    }
    {
      id: "7"
      L: PageLayout
      P: {
        displayOrder: 1
        componentName: Layout
      }
    }
  ]
  edges: [
    {
      id: e_seo_title
      T: Attr
      S: "1"
      E: "seo_title"
    }
    {
      id: e_seo_description
      T: Attr
      S: "1"
      E: "seo_description"
    }
    {
      id: e_seo_robots
      T: Attr
      S: "1"
      E: "seo_robots"
    }
    {
      id: e_seo_og_title
      T: Attr
      S: "1"
      E: "seo_og_title"
    }
    {
      id: e1
      T: Attr
      S: "1"
      E: "2"
    }
    {
      id: e2
      T: PageLayout
      S: "1"
      E: "7"
    }
    {
      id: e3
      T: Attr
      S: "2"
      E: "3"
    }
