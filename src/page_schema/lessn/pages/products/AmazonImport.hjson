{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        key: AmazonImport
        title: Amazon Product Import
        url: /portal/amazon-import
        signinRequired: true
        isNoPermissionCheck: true
        dynamicComponent: FormManagement
        fns:
          '''
const [resultJson, setResultJson] = _.createSignal("");
const [importedFiles, setImportedFiles] = _.createSignal([]);
const [importedProducts, setImportedProducts] = _.createSignal([]);
const [isImporting, setIsImporting] = _.createSignal(false);
const [importProgress, setImportProgress] = _.createSignal(null);
const [importRowStatuses, setImportRowStatuses] = _.createSignal([]);
const [toolbarContext, setToolbarContext] = _.createSignal(null);
const [formManagementFns, setFormManagementFns] = _.createSignal(null);
const [titleFetchStatuses, setTitleFetchStatuses] = _.createSignal({});

const registerFormManagementFns = (formFns) => {
  setFormManagementFns(formFns);
};

const requestCloseIframeModal = () => {
  try {
    if (window.parent && window.parent !== window) {
      window.parent.postMessage(
        { type: "dynamicPage.toolbarCloseRequest" },
        window.location.origin
      );
    }
  } catch (_) {
    /* ignore */
  }
};

const onToolbarContextMessage = (event) => {
  if (event.origin !== window.location.origin) return;
  const data = event.data;
  if (!data || typeof data !== "object") return;
  if (data.type !== "dynamicPage.toolbarContext") return;
  setToolbarContext(data);
};

const pickFileList = (data) => {
  if (Array.isArray(data?.data?.files)) return data.data.files;
  if (Array.isArray(data?.files)) return data.files;
  return [];
};

const downloadHrefFor = (file) => {
  const name = file?.P?.fileName;
  if (!name) return "";
  return `/api/file/download/${encodeURIComponent(String(name))}`;
};

const parseImportRows = (rawRows) => {
  const rows = Array.isArray(rawRows) ? rawRows : [];
  return rows
    .map((row) => {
      const amazonUrl = row?.amazonUrl != null ? String(row.amazonUrl).trim() : "";
      const productTitle = row?.productTitle != null ? String(row.productTitle).trim() : "";
      const fileName = row?.fileName != null ? String(row.fileName).trim() : "";
      return {
        amazonUrl,
        productTitle,
        fileName: fileName || productTitle
      };
    })
    .filter((row) => row.amazonUrl);
};

const isLikelyAmazonUrl = (raw) => {
  try {
    const parsed = new URL(String(raw || "").trim());
    if (!/^https?:$/i.test(parsed.protocol)) return false;
    const host = parsed.hostname.toLowerCase().replace(/^www\./, "");
    return host === "link.amazon" || host.endsWith(".link.amazon") || host.includes("amazon.");
  } catch {
    return false;
  }
};

const slugifyPreserveCase = (value, maxLength = 80) => {
  return String(value ?? "")
    .trim()
    .replace(/[^a-zA-Z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, maxLength);
};

let previousProductsSnapshot = [];
const autoFilledTitlesByIndex = {};
const titleFetchTimers = {};
const titleFetchTokens = {};

const snapshotProducts = (items) =>
  (Array.isArray(items) ? items : []).map((item) => ({
    amazonUrl: item?.amazonUrl != null ? String(item.amazonUrl).trim() : "",
    productTitle: item?.productTitle != null ? String(item.productTitle).trim() : "",
    fileName: item?.fileName != null ? String(item.fileName).trim() : ""
  }));

const setTitleFetchStatus = (index, status) => {
  setTitleFetchStatuses((prev) => ({ ...(prev || {}), [index]: status }));
};

const applyFetchedTitle = (index, amazonUrl, title) => {
  const formFns = formManagementFns();
  if (!formFns?.getFieldValue || !formFns?.setFieldValue) return;

  const currentItems = snapshotProducts(formFns.getFieldValue("products"));
  const row = currentItems[index];
  if (!row || row.amazonUrl !== amazonUrl) return;

  const previousTitle = row.productTitle;
  const previousAutoTitle = autoFilledTitlesByIndex[index] || "";
  const shouldFillTitle =
    previousTitle === "" || previousTitle === previousAutoTitle;
  if (!shouldFillTitle) return;

  const nextTitle = String(title || "").trim();
  if (!nextTitle) return;

  const previousSlug = slugifyPreserveCase(previousTitle);
  const nextSlug = slugifyPreserveCase(nextTitle);
  const currentFileName = row.fileName;
  const shouldFillFileName =
    currentFileName === "" || currentFileName === previousSlug;

  const nextItems = currentItems.map((item, itemIndex) => {
    if (itemIndex !== index) return { ...item };
    return {
      ...item,
      productTitle: nextTitle,
      fileName: shouldFillFileName ? nextSlug : item.fileName
    };
  });

  autoFilledTitlesByIndex[index] = nextTitle;
  formFns.setFieldValue("products", nextItems);
};

const fetchAndFillTitle = async (index, amazonUrl) => {
  const token = `${Date.now()}-${Math.random()}`;
  titleFetchTokens[index] = token;
  setTitleFetchStatus(index, "loading");

  try {
    const result = await s({
      functionName: "fetchAmazonProductTitle",
      contextData: { amazonUrl }
    });
    if (titleFetchTokens[index] !== token) return;

    const payload = result?.result || result;
    if (payload?.success !== true) {
      setTitleFetchStatus(index, "error");
      _.showErrorToast?.(payload?.message || "Could not fetch Amazon title");
      return;
    }

    const title = String(payload?.data?.title || "").trim();
    if (!title) {
      setTitleFetchStatus(index, "error");
      _.showErrorToast?.("Could not fetch Amazon title");
      return;
    }

    applyFetchedTitle(index, amazonUrl, title);
    setTitleFetchStatus(index, "success");
  } catch (error) {
    if (titleFetchTokens[index] !== token) return;
    setTitleFetchStatus(index, "error");
    _.showErrorToast?.(
      error instanceof Error ? error.message : "Could not fetch Amazon title"
    );
  }
};

const scheduleFetchTitle = (index, amazonUrl) => {
  if (titleFetchTimers[index]) clearTimeout(titleFetchTimers[index]);
  titleFetchTimers[index] = setTimeout(() => {
    void fetchAndFillTitle(index, amazonUrl);
  }, 10);
};

const handleAmazonImportFieldChange = (fieldKey, value) => {
  if (fieldKey !== "products") return;

  const nextSnapshot = snapshotProducts(value);
  const prevSnapshot = previousProductsSnapshot;
  previousProductsSnapshot = nextSnapshot;

  for (let index = 0; index < nextSnapshot.length; index++) {
    const url = nextSnapshot[index].amazonUrl;
    const prevUrl = prevSnapshot[index]?.amazonUrl || "";
    if (!url || url === prevUrl) continue;
    if (!isLikelyAmazonUrl(url)) continue;
    scheduleFetchTitle(index, url);
  }

  for (const indexKey of Object.keys(autoFilledTitlesByIndex)) {
    const index = Number(indexKey);
    if (!Number.isFinite(index) || index >= nextSnapshot.length) {
      delete autoFilledTitlesByIndex[indexKey];
    }
  }
};

const amazonImportFormConfiguration = {
  gridColumns: 1,
  groups: [
    {
      key: "amazon",
      title: "Amazon import",
      gridColumns: 1,
      fields: [
        {
          key: "products",
          label: "Products",
          dataType: "array",
          renderer: "fieldArray",
          required: true,
          colSpan: 1,
          helpText: "Paste an Amazon URL to auto-fill the product title. Image file name is auto-slugged from product title (same casing) while it is empty or still in sync.",
          defaultValue: [{ amazonUrl: "", productTitle: "", fileName: "" }],
          fieldArrayConfig: {
            itemLabel: "Product",
            addButtonLabel: "Add URL",
            minItems: 1,
            defaultItems: [{ amazonUrl: "", productTitle: "", fileName: "" }],
            itemFields: [
              {
                key: "amazonUrl",
                label: "Amazon URL",
                dataType: "text",
                renderer: "text",
                required: true,
                placeholder: "https://www.amazon.com/dp/...",
                autoFocus: true
              },
              {
                key: "productTitle",
                label: "Product title",
                dataType: "text",
                renderer: "text",
                required: true,
                placeholder: "Your listing title",
                autoSlugTo: "fileName",
                autoSlugMode: "emptyOrSynced",
                autoSlugSeparator: "-",
                autoSlugMaxLength: 80,
                autoSlugPreserveCase: true
              },
              {
                key: "fileName",
                label: "Image file name",
                dataType: "text",
                renderer: "text",
                required: false,
                placeholder: "wireless-earbuds"
              }
            ]
          }
        }
      ]
    }
  ]
};

const saveAmazonImportForm = async (savePayload) => {
  const entries = parseImportRows(savePayload?.vertex?.P?.products);

  if (entries.length === 0) {
    _.showErrorToast?.("Add at least one Amazon URL");
    return false;
  }

  const missingTitles = entries.filter((row) => !row.productTitle);
  if (missingTitles.length > 0) {
    _.showErrorToast?.("Product title is required for every URL");
    return false;
  }

  const ctx = toolbarContext() || {};
  const inIframe = typeof window !== "undefined" && window.parent && window.parent !== window;
  if (inIframe) {
    const missing = [];
    if (!ctx.productCategoryId) missing.push("Products category");
    if (!ctx.filesCategoryId) missing.push("Files folder");
    if (missing.length > 0) {
      _.showErrorToast?.(
        `Select a ${missing.join(" and a ")} on the Products page, then open Amazon import again.`
      );
      return false;
    }
  }

  setIsImporting(true);
  setResultJson("");
  setImportedFiles([]);
  setImportedProducts([]);
  setImportProgress({ current: 0, total: entries.length, title: "" });
  setImportRowStatuses(
    entries.map((entry) => ({
      productTitle: entry.productTitle,
      status: "pending",
      message: "Waiting"
    }))
  );

  const results = [];
  const allFiles = [];
  const allProducts = [];

  try {
    for (let i = 0; i < entries.length; i++) {
      const entry = entries[i];
      setImportProgress({
        current: i + 1,
        total: entries.length,
        title: entry.productTitle
      });
      setImportRowStatuses((prev) =>
        (prev || []).map((row, idx) =>
          idx === i ? { ...row, status: "importing", message: "Importing…" } : row
        )
      );

      const result = await s({
        functionName: "importAmazonProduct",
        contextData: {
          amazonUrl: entry.amazonUrl,
          productTitle: entry.productTitle,
          fileName: entry.fileName,
          productCategoryId: ctx.productCategoryId || null,
          filesCategoryId: ctx.filesCategoryId || null,
          productCategoryLabel: ctx.productCategoryLabel || "ProductCategory",
          productToCategoryEdgeType: ctx.productToCategoryEdgeType || "ParentProductCategory",
          filesCategoryLabel: ctx.filesCategoryLabel || "Folder",
          filesToCategoryEdgeType: ctx.filesToCategoryEdgeType || "ParentFolder",
          tableVertexLabel: ctx.tableVertexLabel || "Product",
          filesTableVertexLabel: ctx.filesTableVertexLabel || "File"
        }
      });

      const payload = result?.result || result;
      if (payload?.graph) {
        _.setGraphData?.(0, payload.graph, {});
      } else if (result?.graph) {
        _.setGraphData?.(0, result.graph, {});
      }

      results.push({
        amazonUrl: entry.amazonUrl,
        productTitle: entry.productTitle,
        success: payload?.success === true,
        message: payload?.message || null,
        productId: payload?.data?.product?.id || null
      });

      const ok = payload?.success === true;
      setImportRowStatuses((prev) =>
        (prev || []).map((row, idx) =>
          idx === i
            ? {
                ...row,
                status: ok ? "success" : "error",
                message: payload?.message || (ok ? "Imported" : "Failed")
              }
            : row
        )
      );

      if (ok) {
        allFiles.push(...pickFileList(payload));
        if (payload?.data?.product) allProducts.push(payload.data.product);
      }
    }

    setImportedFiles(allFiles);
    setImportedProducts(allProducts);
    setResultJson(JSON.stringify({ count: entries.length, results }, null, 2));

    const successCount = results.filter((row) => row.success).length;
    const failureCount = results.length - successCount;

    if (successCount > 0) {
      try {
        if (window.parent && window.parent !== window) {
          window.parent.postMessage(
            {
              type: "dynamicPage.toolbarResult",
              actionKey: ctx.actionKey || "amazonImport",
              success: true,
              productIds: allProducts.map((product) => product?.id).filter(Boolean)
            },
            window.location.origin
          );
        }
      } catch (_) {
        /* ignore */
      }
    }

    if (successCount > 0 && failureCount === 0) {
      _.showSuccessToast?.(
        successCount === 1
          ? `Imported "${allProducts[0]?.P?.title || entries[0].productTitle}"`
          : `Imported ${successCount} product(s)`
      );
      return true;
    }

    if (successCount > 0 && failureCount > 0) {
      _.showSuccessToast?.(`Imported ${successCount} product(s); ${failureCount} failed`);
      return true;
    }

    _.showErrorToast?.(results[0]?.message || "Amazon import failed");
    return false;
  } catch (error) {
    const message = error instanceof Error ? error.message : "Amazon import failed";
    setResultJson(JSON.stringify({ error: message, results }, null, 2));
    setImportRowStatuses((prev) =>
      (prev || []).map((row) =>
        row.status === "importing" || row.status === "pending"
          ? { ...row, status: "error", message }
          : row
      )
    );
    _.showErrorToast?.(message);
    return false;
  } finally {
    setIsImporting(false);
  }
};

const importProgressText = () => {
  const progress = importProgress();
  if (!progress || !progress.total) return "";
  if (isImporting()) {
    const title = progress.title ? `: ${progress.title}` : "";
    return `Importing ${progress.current} of ${progress.total}${title}`;
  }
  const rows = importRowStatuses() || [];
  const successCount = rows.filter((row) => row.status === "success").length;
  return `Imported ${successCount} of ${progress.total}`;
};

return {
  enabled: () => true,
  amazonImportFormConfiguration,
  saveAmazonImportForm,
  resultJson,
  importedFiles,
  downloadHrefFor,
  importedProducts,
  isImporting,
  importProgress,
  importRowStatuses,
  importProgressText,
  toolbarContext,
  onToolbarContextMessage,
  registerFormManagementFns,
  handleAmazonImportFieldChange,
  titleFetchStatuses,
  requestCloseIframeModal
};
'''
        props:
          '''
return {
  enabled: () => true,
  onMount: () => {
    window.addEventListener("message", f.onToolbarContextMessage);
    try {
      if (window.parent && window.parent !== window) {
        window.parent.postMessage(
          { type: "dynamicPage.toolbarContextRequest" },
          window.location.origin
        );
      }
    } catch (_) {
      /* ignore */
    }
  },
  onCleanup: () => {
    window.removeEventListener("message", f.onToolbarContextMessage);
  }
};
'''
      }
    }
    {
