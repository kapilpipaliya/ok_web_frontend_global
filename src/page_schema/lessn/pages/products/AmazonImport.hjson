}`;
'''
        props:
          '''
const ctx = f.toolbarContext?.() || null;
const productCat = ctx?.productCategoryId || null;
const filesCat = ctx?.filesCategoryId || null;
const hasAny = !!(productCat || filesCat);
return {
  as: "p",
  hide: !hasAny,
  text: hasAny
    ? `Saving into Products category ${productCat || "(none)"} · Files folder ${filesCat || "(none)"}`
    : ""
};
'''
      }
