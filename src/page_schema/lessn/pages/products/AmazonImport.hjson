  formConfig: f.amazonImportFormConfiguration,
  onSave: f.saveAmazonImportForm,
  onFnsReady: f.registerFormManagementFns,
  onFieldChange: f.handleAmazonImportFieldChange,
  saveShortcut: "$mod+KeyS",
  closeShortcut: "Escape",
  onShortcutClose: f.requestCloseIframeModal,
  afterSuccessfulSave: "reinitialize",
  class: "amazon-import-form"
};
'''
