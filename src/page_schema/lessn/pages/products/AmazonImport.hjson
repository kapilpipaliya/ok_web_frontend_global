return {
  as: "p",
  text: "Paste one or more Amazon product URLs. Each row becomes a Product: Playwright reads title, price, description, and images; image file name keeps the title casing and is slugged until you edit it. When opened from Products, category IDs arrive via postMessage. Shortcuts: Cmd/Ctrl+S to import, Esc to close."
};
'''
      }
