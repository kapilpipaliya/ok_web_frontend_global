'''
        props:
          '''
const files = f.importedFiles?.() || [];
return {
  as: "div",
  hide: files.length === 0,
  data: files
};
'''
      }
    }
    {
      id: "downloads_item"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const file = c.importedFile;
const name = file?.P?.fileName || file?.id || "file";
const href = f.downloadHrefFor?.(file) || "";
return href
  ? {
      as: "a",
      href,
      target: "_blank",
      rel: "noopener noreferrer",
      text: name
    }
  : {
      as: "div",
      text: name
    };
'''
      }
    }
    {
      id: "result"
      L: Attr
      P: {
        displayOrder: 7
        componentName: Html
        css:
          '''
return `._id {
  margin: 0;
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  background: ${t.var.color.background_light_200};
  color: ${t.var.color.text};
  font-size: 0.75rem;
  line-height: 1.45;
  overflow: auto;
  max-height: 24rem;
  white-space: pre-wrap;
  word-break: break-word;
}`;
'''
        props:
          '''
return {
  as: "pre",
  text: () => f.resultJson?.() || "",
  show: () => !!(f.resultJson?.() || "")
};
'''
      }
    }
    {
      id: "layout"
      L: PageLayout
      P: {
        componentName: PortalLayout
        displayOrder: 1
      }
    }
  ]
  edges: [
    { id: "e1", T: "Attr", S: "1", E: "main" }
    { id: "e2", T: "Attr", S: "main", E: "container" }
    { id: "e3", T: "Attr", S: "container", E: "title" }
    { id: "e4", T: "Attr", S: "container", E: "intro" }
    { id: "e4b", T: "Attr", S: "container", E: "toolbar_context" }
    { id: "e5", T: "Attr", S: "container", E: "busy" }
    { id: "e5b", T: "Attr", S: "busy", E: "busy_title" }
    { id: "e5c", T: "Attr", S: "busy", E: "busy_list" }
    { id: "e5d", T: "Attr", S: "busy_list", E: "busy_item" }
    { id: "e6", T: "Attr", S: "container", E: "form" }
    { id: "e7", T: "Attr", S: "container", E: "product_summary" }
    { id: "e8", T: "Attr", S: "product_summary", E: "product_summary_title" }
    { id: "e8b", T: "Attr", S: "product_summary", E: "product_summary_list" }
    { id: "e9", T: "Attr", S: "product_summary_list", E: "product_summary_body" }
    { id: "e10", T: "Attr", S: "container", E: "downloads" }
