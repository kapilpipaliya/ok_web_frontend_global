      id: "busy_item"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        css:
          '''
const status = c.importStatus?.status;
const color =
  status === "success"
    ? t.var.color.success
    : status === "error"
      ? t.var.color.error
      : status === "importing"
        ? t.var.color.primary
        : t.var.color.text_dark_400;
return `._id {
  margin: 0;
  font-size: 0.8125rem;
  line-height: 1.4;
  color: ${color};
}`;
'''
        props:
          '''
const row = c.importStatus || {};
const title = row.productTitle || "Product";
const message = row.message || row.status || "";
const label =
  row.status === "pending"
    ? "Waiting"
    : row.status === "importing"
      ? "Importing"
      : row.status === "success"
        ? "Done"
        : "Failed";
return {
  as: "p",
  text: `${label}: ${title}${message && row.status !== "pending" && row.status !== "importing" ? ` — ${message}` : ""}`
};
'''
      }
