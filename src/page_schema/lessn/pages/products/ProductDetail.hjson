{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        settingsPageId: products
        isNoPermissionCheck: true
        fns: return { enabled: () => true }
        url: /product/:productKey
        key: ProductDetail
        props:
          '''
const locale = _.params?.lang ? String(_.params.lang).toLowerCase() : undefined;
const routeParams = _.context?.getParams?.(_.meta) || {};
const productKey = routeParams.productKey != null && String(routeParams.productKey).trim() !== ""
  ? String(routeParams.productKey).trim()
  : null;
return {
  contextName: "productDetailSettings",
  serverFunction: `
try {
  if (!${JSON.stringify(productKey)}) {
    return { product: null, error: "Missing product key" };
  }
  const result = await s({
    functionName: "loadPublicProduct",
    contextData: {
      productKey: ${JSON.stringify(productKey)},
      tableKey: "products",
      tableVertexLabel: "Product",
      locale: ${JSON.stringify(locale ?? null)}
    }
  });
  if (!result?.result?.success) {
    return {
      product: null,
      error: result?.result?.message || result?.error || "Product not found"
    };
  }
  return {
    product: result.result.data?.product || null,
    error: null
  };
} catch (error) {
  console.error("Error loading product detail:", error);
  return { product: null, error: error?.message || "Failed to load product" };
}
`
};
'''
      }
    }
    {
      id: "2"
      L: PageLayout
      P: {
        displayOrder: 1
        componentName: Layout
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  padding: 1.5rem 1rem 3rem;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "main" };
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''return `._id {
  max-width: 1100px;
  margin: 0 auto;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          '''return `._id {
  padding: 2rem;
  border: 1px dashed ${t.var.color.border};
  border-radius: 0.75rem;
  color: ${t.var.color.error};
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const data = c.productDetailSettings || {};
return {
  as: "div",
  text: data.error || "Product not found",
  hide: !!data.product,
  "data-animate": "",
  ref: (el) => el && f.animateOnView(el)
};'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 3
        componentName: ProductDetailView
        props:
          '''const data = c.productDetailSettings || {};
return {
  product: data.product,
  hide: !data.product
};'''
      }
    }
  ]
  edges: [
    {
      id: e1
      T: PageLayout
      S: "1"
      E: "2"
    }
    {
      id: e2
      T: Attr
      S: "1"
      E: "3"
    }
    {
      id: e3
      T: Attr
      S: "3"
      E: "4"
    }
    {
      id: e5
