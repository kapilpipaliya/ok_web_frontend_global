{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        settingsPageId: products
        isNoPermissionCheck: true
        fns: return { enabled: () => true }
        url: /product/:productKey
        key: ProductDetail
        props:
          '''
const locale = _.params?.lang ? String(_.params.lang).toLowerCase() : undefined;
const routeParams = _.context?.getParams?.(_.meta) || {};
const productKey = routeParams.productKey != null && String(routeParams.productKey).trim() !== ""
  ? String(routeParams.productKey).trim()
  : null;
return {
  contextName: "productDetailSettings",
  serverFunction: `
try {
  if (!${JSON.stringify(productKey)}) {
    return { product: null, error: "Missing product key", productKey: null };
  }
  const result = await s({
    functionName: "loadPublicProduct",
    contextData: {
      productKey: ${JSON.stringify(productKey)},
      tableKey: "products",
      tableVertexLabel: "Product",
      locale: ${JSON.stringify(locale ?? null)}
    }
  });
  if (!result?.result?.success) {
    return {
      product: null,
      error: result?.result?.message || result?.error || "Product not found",
      productKey: ${JSON.stringify(productKey)}
    };
  }
  return {
    product: result.result.data?.product || null,
    error: null,
    productKey: ${JSON.stringify(productKey)}
  };
} catch (error) {
  console.error("Error loading product detail:", error);
  return {
    product: null,
    error: error?.message || "Failed to load product",
    productKey: ${JSON.stringify(productKey)}
  };
}
`
};
'''
      }
    }
    {
      id: "2"
      L: PageLayout
      P: {
        displayOrder: 1
        componentName: Layout
      }
    }
    {
      id: "seo_title"
      L: Attr
      P: {
        displayOrder: 0.1
        componentName: Html
        props:
          '''const data = c.productDetailSettings || {};
const product = data.product || {};
const productTitle = product.title || data.productKey || "Product";
return {
  as: "title",
  text: `${productTitle} | Lessn`
};'''
      }
    }
    {
      id: "seo_description"
      L: Attr
      P: {
        displayOrder: 0.2
        componentName: Html
        props:
          '''const data = c.productDetailSettings || {};
const product = data.product || {};
const productTitle = product.title || data.productKey || "Product";
const shortDescription =
  product.shortDescription != null ? String(product.shortDescription).trim() : "";
const content = shortDescription
  ? shortDescription.slice(0, 160)
  : `${productTitle} — curated Amazon pick on Lessn.`;
return {
  as: "meta",
  name: "description",
  content
};'''
      }
    }
    {
      id: "seo_robots"
      L: Attr
      P: {
        displayOrder: 0.3
        componentName: Html
        props:
          '''const data = c.productDetailSettings || {};
const productKey = data.productKey;
const invalidKey =
  productKey == null ||
  String(productKey).trim() === "" ||
  String(productKey).startsWith(":") ||
  String(productKey).includes("{");
const missing = !data.product;
return {
  as: "meta",
  name: "robots",
  content: "noindex, nofollow",
  hide: !(invalidKey || missing)
};'''
      }
    }
    {
      id: "seo_og_title"
      L: Attr
      P: {
        displayOrder: 0.4
        componentName: Html
        props:
          '''const data = c.productDetailSettings || {};
const product = data.product || {};
const productTitle = product.title || data.productKey || "Product";
return {
  as: "meta",
  property: "og:title",
  content: `${productTitle} | Lessn`
};'''
      }
    }
    {
      id: "seo_og_description"
      L: Attr
      P: {
        displayOrder: 0.45
        componentName: Html
        props:
          '''const data = c.productDetailSettings || {};
const product = data.product || {};
const productTitle = product.title || data.productKey || "Product";
const shortDescription =
  product.shortDescription != null ? String(product.shortDescription).trim() : "";
const content = shortDescription
  ? shortDescription.slice(0, 160)
  : `${productTitle} — curated Amazon pick on Lessn.`;
return {
  as: "meta",
  property: "og:description",
  content
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  padding: 1.5rem 1rem 3rem;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "main" };
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''return `._id {
  max-width: 1100px;
  margin: 0 auto;
}`;'''
        displayOrder: 1
        componentName: Html
        props: return { as: "div" };
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          '''return `._id {
  padding: 2rem;
  border: 1px dashed ${t.var.color.border};
  border-radius: 0.75rem;
  color: ${t.var.color.error};
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''const data = c.productDetailSettings || {};
return {
  as: "div",
  text: data.error || "Product not found",
  hide: !!data.product
};'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 3
        componentName: ProductDetailView
        props:
          '''const data = c.productDetailSettings || {};
return {
  product: data.product,
  hide: !data.product
};'''
      }
    }
  ]
  edges: [
    {
      id: e1
      T: PageLayout
      S: "1"
      E: "2"
    }
    {
      id: e_seo_title
      T: Attr
      S: "1"
      E: "seo_title"
    }
