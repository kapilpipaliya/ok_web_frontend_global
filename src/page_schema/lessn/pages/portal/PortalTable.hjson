          '''
const checkAdminRole = () => {
  const userRoles = _.user?.OUT?.UserRole || [];
  return userRoles.some((edgeId) => {
    const edge = g.edges[edgeId];
    const role = g.vertexes[edge?.E];
    return role?.P?.key === "Admin";
  });
};

const TABLE_KEY_BY_LABEL = {
  Product: "products",
  File: "files",
  Page: "pages",
  Component: "components",
  Function: "functions",
  EmailTemplate: "email_templates",
  ContactSubmission: "contacts"
};

const TABLE_TITLE_BY_LABEL = {
  Product: "Products",
  File: "Files",
  Page: "Pages",
  Component: "Components",
  Function: "Functions",
  EmailTemplate: "Email templates",
  ContactSubmission: "Contacts"
};

const PAGE_DESIGNER_ENTITIES = new Set(["Page", "Component", "Function", "EmailTemplate"]);
const PAGE_DESIGNER_KEY_ENTITIES = new Set(["Page", "Component"]);

const getTableVertexLabel = () => {
  const table = _.searchParams?.table;
  if (table) {
    const value = String(table).trim();
    if (TABLE_KEY_BY_LABEL[value]) return value;
    return value;
  }
  return "Product";
};

const getTableKey = () => {
  const fromQuery = _.searchParams?.key;
  if (fromQuery != null && String(fromQuery).trim() !== "") return String(fromQuery).trim();
  const label = getTableVertexLabel();
  return TABLE_KEY_BY_LABEL[label] || "products";
};

const getPageDesignerEntity = () => {
  const label = getTableVertexLabel();
  return PAGE_DESIGNER_ENTITIES.has(label) ? label : null;
};

const getPageDesignerPath = (entity, row) => {
  if (!entity || !row) return null;
  const useKey = PAGE_DESIGNER_KEY_ENTITIES.has(entity);
  const segment = useKey ? row?.P?.key : row?.id;
  if (segment == null || String(segment).trim() === "") return null;
  return `/admin/${entity}/${encodeURIComponent(String(segment).trim())}`;
};

const openInPageDesigner = (row) => {
  const entity = getPageDesignerEntity();
  if (!entity) return;
  const path = getPageDesignerPath(entity, row);
  if (path) _.navigate(path);
};

const deleteDesignerEntity = async (row) => {
  const entity = getPageDesignerEntity();
  if (!entity) return;
  const id = row?.id;
  if (!id) return;
  const result = await _.postAPI("/api/page/delete", { id }, "DELETE");
  if (result?.success) {
    if (result.graph) {
      _.setGraphData(0, result.graph, {});
    }
    _.showSuccessToast?.(`${getTableTitle()} entry deleted successfully`);
    const table = getTableVertexLabel();
    const key = getTableKey();
    if (isSchemaMode()) {
      _.setSearchParams({ table, key, mode: "schema" }, { replace: true });
    } else {
      _.setSearchParams({ table, key, mode: null }, { replace: true });
    }
    return;
  }
  _.showErrorToast?.(result?.error || `Failed to delete ${entity}`);
  throw new Error(result?.error || "Delete failed");
};

const getTableActionHandlers = () => {
  if (!getPageDesignerEntity()) return undefined;
  return {
    edit: openInPageDesigner,
    delete: deleteDesignerEntity
  };
};

const makeDeleteConfirm = (entityLabel) => ({
  title: `Delete ${entityLabel.toLowerCase()}?`,
  message: "This cannot be undone.",
  confirmText: "Delete",
  cancelText: "Cancel",
  variant: "danger"
});

const getDesignerTableActions = () => [
  {
    key: "edit",
    type: "edit",
    icon: "ph:pen",
    title: "Open in page designer",
    ariaLabel: "Open in page designer"
  },
  {
    key: "delete",
    type: "delete",
    icon: "ph:trash",
    confirm: makeDeleteConfirm(getTableTitle().replace(/s$/, "") || "item")
  }
];

const getTableActions = () => {
  if (getPageDesignerEntity()) return getDesignerTableActions();
  if (getTableVertexLabel() === "Product") {
    return [
      { key: "edit", type: "edit" },
      { key: "delete", type: "delete", confirm: makeDeleteConfirm("product") }
    ];
  }
  if (getTableVertexLabel() === "File") {
    return [
      { key: "edit", type: "edit" },
      { key: "delete", type: "delete", confirm: makeDeleteConfirm("file") }
    ];
  }
  return undefined;
};

const getTableTitle = () => {
  const label = getTableVertexLabel();
  return TABLE_TITLE_BY_LABEL[label] || `${label} table`;
};

const isSchemaMode = () => _.searchParams?.mode === "schema";

const setEditorMode = (mode) => {
  const table = getTableVertexLabel();
  const key = getTableKey();
  if (mode === "schema") {
    _.setSearchParams({ table, key, mode: "schema" }, { replace: true });
  } else {
    _.setSearchParams({ table, key, mode: null }, { replace: true });
  }
};

const onSchemaSaved = () => {
  const tableKey = f.getTableKey?.();
  if (!tableKey || String(tableKey).trim() === "") {
    _.showErrorToast?.("Table key missing. Unable to process schema save.");
    return;
  }
  window.dispatchEvent(new CustomEvent("affiliate-table-schema-saved", { detail: { tableKey } }));
  _.showSuccessToast?.("Table schema saved");
};

return {
  checkAdminRole,
  getTableVertexLabel,
  getTableKey,
  getTableTitle,
  getTableActionHandlers,
  getTableActions,
  openInPageDesigner,
  isSchemaMode,
  setEditorMode,
  onSchemaSaved
};
