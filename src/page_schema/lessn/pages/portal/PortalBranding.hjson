          helpText: "Upload above or pick a file from the repository. Used in headers and wide layouts.",
          selectConfig: {
            label: "File",
            relationshipType: "CompanyRectangularLogo",
            edgeOnly: true,
            propertyOnly: false
          },
          pickerConfiguration: filePickerConfiguration("Choose rectangular logo")
        }
      ]
    },
    {
