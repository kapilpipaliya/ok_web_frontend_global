        fns:
          '''
const checkAdminRole = () => {
  const userRoles = _.user?.OUT?.UserRole || [];
  return userRoles.some((edgeId) => {
    const edge = g.edges[edgeId];
    const role = g.vertexes[edge?.E];
    return role?.P?.key === "Admin";
  });
};

const logoUploadConfiguration = (attachFieldKey, logoName, acceptOverride) => ({
  accept:
    acceptOverride ||
    "image/png,image/jpeg,image/jpg,image/webp,image/gif,image/svg+xml",
  uploadUrl: "/api/file/upload",
  attachUploadedFileToFieldKey: attachFieldKey,
  hidePreview: true,
  enableDragDrop: false,
  pickButtonLabel: `Upload ${logoName}`,
  pickButtonVariant: "secondary",
  fullWidth: false,
  successToastMessage: "File uploaded",
  uploadFailedMessage: "Upload failed",
  noFileReturnedMessage: "Upload failed: no file returned",
  notInGraphMessage: "Upload saved but file not found in graph",
  onUploadSuccess: async ({ uploadedId, callbacks, configuration, syncPreview, showSuccess }) => {
    const fieldKey = configuration.attachUploadedFileToFieldKey;
    if (fieldKey && typeof callbacks.setFieldValue === "function") {
      callbacks.setFieldValue(fieldKey, uploadedId);
    }
    syncPreview(uploadedId);
    showSuccess();
  },
});

const filePickerConfiguration = (modalTitle) => ({
  chooseButtonLabel: "Select file…",
  clearButtonLabel: "Clear",
  modalTitle,
  modalHintEmpty: "Select a file using the checkbox, then confirm.",
  modalHintSelected: "Selected: {name} — confirm or choose another file.",
  selectionMode: "single",
  confirmButtonLabel: "Use selection",
  cancelButtonLabel: "Cancel",
  closeButtonLabel: "Close",
  selectRowMessage: "Select a row in the list first.",
  invalidTypeMessage: "This type does not match the configured selection.",
  usePolarisUI: true,
  targetVertexLabels: ["File"],
  fileDownloadUrlPrefix: "/api/file/download",
  showImagePreview: true,
  buildSecondaryLabelFromVertex: true,
  pickerBodyProps: {
    tableVertexLabel: "File",
    tableKey: "files",
    loadFromSetting: true
  }
});

const companyBrandingFormConfiguration = {
