        props:
          '''const globalSettingId = g?.vertexLabelIdMap?.GlobalSetting?.[0];
const globalSetting = globalSettingId ? g.vertexes[globalSettingId] : null;

const initialVertex =
  globalSetting != null
    ? {
        id: globalSetting.id,
        L: globalSetting.L,
        IN: globalSetting.IN,
        OUT: globalSetting.OUT,
        P: _.klona(globalSetting.P),
      }
    : null;

return {
  formConfig: f.companyBrandingFormConfiguration,
  initialVertex,
  vertexLabel: "GlobalSetting",
  mode: "edit",
  onSave: f.saveCompanyBrandingForm,
  afterSuccessfulSave: "reinitialize",
  hide: globalSetting == null,
  class: "portal-branding-form"
};'''
