};

const fileIdOrNull = (rawValue) => {
  const trimmed = rawValue != null ? String(rawValue).trim() : "";
  return trimmed !== "" ? trimmed : null;
};

const logoFileIdFromSavePayload = (savePayload, fieldKey, relationshipType) => {
  const rel = savePayload?.relationships?.[fieldKey];
  if (rel?.targetIds?.length > 0) {
    return fileIdOrNull(rel.targetIds[0]);
  }
  const formVertex = savePayload?.vertex;
  const edgeIds = formVertex?.OUT?.[relationshipType];
  if (Array.isArray(edgeIds) && edgeIds.length > 0) {
    const edge = g?.edges?.[edgeIds[0]];
    if (edge?.E != null) return fileIdOrNull(edge.E);
  }
  return null;
};

const saveCompanyBrandingForm = async (savePayload) => {
  const formVertex = savePayload?.vertex;
  const appName =
    formVertex?.P?.appName != null ? String(formVertex.P.appName).trim() : "";
  const redirectUrlAfterSignin =
    formVertex?.P?.redirectUrlAfterSignin != null
      ? String(formVertex.P.redirectUrlAfterSignin).trim()
      : "";
  const rectangularLogo = logoFileIdFromSavePayload(
    savePayload,
    "rectangularLogo",
    "CompanyRectangularLogo"
  );
  const squareLogo = logoFileIdFromSavePayload(
    savePayload,
    "squareLogo",
    "CompanySquareLogo"
  );
  const favicon = logoFileIdFromSavePayload(savePayload, "favicon", "CompanyFavicon");
  const hasLogo = !!(rectangularLogo || squareLogo || favicon);
  try {
    const generalResponse = await _.postAPI("/api/settings/general/update", {
      appName,
      redirectUrlAfterSignin
    });
    if (generalResponse?.graph && typeof generalResponse.graph === "object") {
      _.setGraphData(0, generalResponse.graph, {});
    }
    if (hasLogo) {
      const response = await _.postAPI("/api/settings/updateCompanyLogo", {
        rectangularLogo,
        squareLogo,
        favicon
      });
      if (response?.graph && typeof response.graph === "object") {
        _.setGraphData(0, response.graph, {});
      }
    }
    _.showSuccessToast?.(
      (typeof generalResponse?.message === "string" && generalResponse.message) ||
        "Branding updated successfully"
    );
    return true;
  } catch (error) {
    _.showErrorToast?.(error instanceof Error ? error.message : "Save failed");
    return false;
  }
};

return {
  enabled: () => true,
  checkAdminRole,
  companyBrandingFormConfiguration,
  saveCompanyBrandingForm,
};
'''
        title: Branding
        url: /portal/branding
        key: PortalBranding
        dynamicComponent: FloatingHelpTooltip, VertexPicker, FileUploader, FormManagement
        props:
          '''let brandingFilesMerged = false;

const mergeBrandingFileVertices = () => {
  if (brandingFilesMerged) return;
  brandingFilesMerged = true;

  const globalSettingId = g?.vertexLabelIdMap?.GlobalSetting?.[0];
  if (!globalSettingId) return;
  const globalSetting = g.vertexes[globalSettingId];
  if (!globalSetting) return;

  const logoFiles = [
    _.evalExpression("->CompanyRectangularLogo", {
      graph: g,
      vertexes: [globalSetting],
    })?.[0],
    _.evalExpression("->CompanySquareLogo", {
      graph: g,
      vertexes: [globalSetting],
    })?.[0],
    _.evalExpression("->CompanyFavicon", {
      graph: g,
      vertexes: [globalSetting],
    })?.[0],
  ].filter((file) => file?.id != null);

  const vertexMap = {};
  for (const file of logoFiles) {
    if (!g.vertexes[file.id]) {
      vertexMap[file.id] = file;
    }
  }
  if (Object.keys(vertexMap).length > 0) {
    _.setGraphData(0, { vertexes: vertexMap }, {});
  }
};

return {
  isNoPermissionCheck: true,
  onMount: () => {
    if (!_.user) {
      _.navigate("/auth/signin", { replace: true });
      return;
    }
    if (!f.checkAdminRole?.()) {
      _.showErrorToast?.("Admin access required");
      _.navigate("/", { replace: true });
      return;
    }
    mergeBrandingFileVertices();
  }
};'''
      }
