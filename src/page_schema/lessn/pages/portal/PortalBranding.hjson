          label: "Redirect URL After Signin",
          dataType: "text",
          renderer: "text",
          placeholder: "Enter URL to redirect after signin (optional)",
          helpText: "Relative path (e.g. /portal/table) used after a successful sign-in."
        }
      ]
    },
    {
