          uploadConfiguration: logoUploadConfiguration(
            "squareLogo",
            "Square Logo"
          ),
        },
        {
          dataType: "relation",
          renderer: "embeddedVertexPicker",
          key: "squareLogo",
          label: "Or choose from Files",
          helpText: "Square logo for compact UI (portal sidebar, auth screens).",
          selectConfig: {
            label: "File",
            relationshipType: "CompanySquareLogo",
            edgeOnly: true,
            propertyOnly: false
          },
          pickerConfiguration: filePickerConfiguration("Choose square logo")
        }
      ]
    },
    {
      key: "favicon",
      title: "Company favicon",
      gridColumns: 1,
      fields: [
        {
          dataType: "file",
          renderer: "graphFileUpload",
          key: "faviconUpload",
          uploadConfiguration: logoUploadConfiguration(
            "favicon",
