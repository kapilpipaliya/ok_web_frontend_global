            "image/png,image/jpeg,image/jpg,image/webp,image/gif,image/svg+xml,image/x-icon,image/vnd.microsoft.icon"
          ),
        },
        {
          dataType: "relation",
          renderer: "embeddedVertexPicker",
          key: "favicon",
          label: "Or choose from Files",
          helpText: "Small icon shown in browser tabs.",
          selectConfig: {
            label: "File",
