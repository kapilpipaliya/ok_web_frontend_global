{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns:
          '''
const checkAdminRole = () => {
  const userRoles = _.user?.OUT?.UserRole || [];
  return userRoles.some((edgeId) => {
    const edge = g.edges[edgeId];
    const role = g.vertexes[edge?.E];
    return role?.P?.key === "Admin";
  });
};

const [pagePreviewUrls, setPagePreviewUrls] = _.createSignal({ global: "/" });
let pagePreviewUrlsLoadPromise = null;

const loadPagePreviewUrls = async () => {
  const existing = pagePreviewUrls();
  if (existing && Object.keys(existing).length > 1) return existing;
  if (pagePreviewUrlsLoadPromise) return pagePreviewUrlsLoadPromise;

  pagePreviewUrlsLoadPromise = (async () => {
    try {
      const result = await s({
        functionName: "getSettingsPagePreviewUrls",
        contextData: {}
      });
      const urls = result?.result?.data?.previewUrls || {};
      const resolved = { global: "/", ...urls };
      setPagePreviewUrls(resolved);
      return resolved;
    } catch (error) {
      console.error("Settings loadPagePreviewUrls:", error);
      return { global: "/" };
    } finally {
      pagePreviewUrlsLoadPromise = null;
    }
  })();

  return pagePreviewUrlsLoadPromise;
};

const getPreviewUrl = () => {
  const settingsPageId = _.searchParams?.page || "home";
  return pagePreviewUrls()[settingsPageId] || "/";
};

const refreshPreview = () => {
  const iframe = document.querySelector("[data-fulchand-settings-preview]");
  if (iframe && iframe.contentWindow) {
    iframe.contentWindow.location.reload();
  }
};

const onSettingsSaved = () => refreshPreview();

const isSchemaMode = () => _.searchParams?.mode === "schema";

const setEditorMode = (mode) => {
  const page = _.searchParams?.page || "home";
  if (mode === "schema") {
    _.setSearchParams({ page, mode: "schema" }, { replace: true });
    const minWidth = Math.min(getMaxEditorWidth(), SCHEMA_EDITOR_MIN_WIDTH);
    if (editorPaneWidth() < minWidth) {
      setEditorPaneWidth(minWidth);
      persistEditorWidth(minWidth);
    }
  } else {
    _.setSearchParams({ page, mode: null }, { replace: true });
  }
};

const onSchemaSaved = () => {
  refreshPreview();
  _.showSuccessToast?.("Schema saved — content editor will use the updated fields");
};

const DEFAULT_EDITOR_WIDTH = 560;
const MIN_EDITOR_WIDTH = 360;
const MAX_EDITOR_WIDTH = 1200;
const SCHEMA_EDITOR_MIN_WIDTH = 640;
const EDITOR_WIDTH_STORAGE_KEY = "fulchand-settings-editor-width";

const loadStoredEditorWidth = () => {
  if (typeof window === "undefined") return DEFAULT_EDITOR_WIDTH;
  try {
    const stored = Number(window.localStorage.getItem(EDITOR_WIDTH_STORAGE_KEY));
    if (Number.isFinite(stored) && stored >= MIN_EDITOR_WIDTH && stored <= MAX_EDITOR_WIDTH) {
      return stored;
    }
  } catch (_) {}
  return DEFAULT_EDITOR_WIDTH;
};

const persistEditorWidth = (width) => {
  try {
    window.localStorage.setItem(EDITOR_WIDTH_STORAGE_KEY, String(width));
  } catch (_) {}
};

const getMaxEditorWidth = () => {
  if (typeof window === "undefined") return MAX_EDITOR_WIDTH;
  return Math.min(MAX_EDITOR_WIDTH, Math.floor(window.innerWidth * 0.85));
};

const [editorPaneWidth, setEditorPaneWidth] = _.createSignal(loadStoredEditorWidth());
const [isResizingEditor, setIsResizingEditor] = _.createSignal(false);

const syncEditorPaneWidth = () => {
  const width = editorPaneWidth();
  document.documentElement.style.setProperty("--fulchand-settings-editor-width", `${width}px`);
};

const startEditorResize = (event) => {
  event.preventDefault();
  event.stopPropagation();
  setIsResizingEditor(true);
  const startX = event.clientX;
  const startWidth = editorPaneWidth();

  const handleMouseMove = (moveEvent) => {
    const delta = startX - moveEvent.clientX;
    const next = Math.max(MIN_EDITOR_WIDTH, Math.min(getMaxEditorWidth(), startWidth + delta));
    setEditorPaneWidth(next);
  };

  const handleMouseUp = () => {
    setIsResizingEditor(false);
    persistEditorWidth(editorPaneWidth());
    document.body.classList.remove("fulchand-settings-resizing");
    document.removeEventListener("mousemove", handleMouseMove, true);
    document.removeEventListener("mouseup", handleMouseUp, true);
  };

  document.body.classList.add("fulchand-settings-resizing");
  document.addEventListener("mousemove", handleMouseMove, true);
  document.addEventListener("mouseup", handleMouseUp, true);
};

const [siteLanguages, setSiteLanguages] = _.createSignal([]);
let siteLanguagesLoadPromise = null;

const DEFAULT_SITE_LANGUAGES = [
  { code: "en", label: "English", isDefault: true },
  { code: "hi", label: "Hindi", isDefault: false },
  { code: "gu", label: "Gujarati", isDefault: false }
];

const loadSiteLanguages = async () => {
  const existing = siteLanguages();
  if (Array.isArray(existing) && existing.length > 0) return existing;
  if (siteLanguagesLoadPromise) return siteLanguagesLoadPromise;

  siteLanguagesLoadPromise = (async () => {
    try {
      const result = await s({
        functionName: "getSiteLanguages",
        contextData: {}
      });
      const languages = result?.result?.data?.languages || [];
      const resolved = languages.length > 0 ? languages : DEFAULT_SITE_LANGUAGES;
      setSiteLanguages(resolved);
      return resolved;
    } catch (error) {
      console.error("Settings loadSiteLanguages:", error);
      setSiteLanguages(DEFAULT_SITE_LANGUAGES);
      return DEFAULT_SITE_LANGUAGES;
    } finally {
      siteLanguagesLoadPromise = null;
    }
  })();

  return siteLanguagesLoadPromise;
};

_.createEffect(() => {
  editorPaneWidth();
  syncEditorPaneWidth();
});

return {
  enabled: () => true,
  DEFAULT_EDITOR_WIDTH,
  MIN_EDITOR_WIDTH,
  MAX_EDITOR_WIDTH,
  editorPaneWidth,
  isResizingEditor,
  startEditorResize,
  checkAdminRole,
  getPreviewUrl,
  refreshPreview,
  onSettingsSaved,
  isSchemaMode,
  setEditorMode,
  onSchemaSaved,
  siteLanguages,
  loadSiteLanguages,
  pagePreviewUrls,
  loadPagePreviewUrls,
  syncEditorPaneWidth,
  executeYTOFunction: (functionName, contextData) =>
    s({
      functionName,
      contextData: contextData || {}
    })
};
'''
        title: Site Settings
        url: /settings
        key: Settings
        props:
          '''
return {
  isNoPermissionCheck: true,
  onMount: async () => {
    if (!_.user) {
      _.navigate("/auth/signin", { replace: true });
      return;
    }
    if (!f.checkAdminRole?.()) {
      _.showErrorToast?.("Admin access required");
      _.navigate("/", { replace: true });
      return;
    }
    await Promise.all([
      f.loadSiteLanguages?.(),
      f.loadPagePreviewUrls?.()
    ]);
    f.syncEditorPaneWidth?.();
    window.addEventListener("fulchand-settings-saved", f.onSettingsSaved);
  },
  onCleanup: () => {
    window.removeEventListener("fulchand-settings-saved", f.onSettingsSaved);
    document.documentElement.style.removeProperty("--fulchand-settings-editor-width");
  }
};
