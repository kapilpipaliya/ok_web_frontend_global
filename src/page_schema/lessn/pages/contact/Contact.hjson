      L: Attr
      P: {
        displayOrder: 1
        componentName: FormManagement
        props:
          '''return {
  mode: "add",
  vertexLabel: "ContactSubmission",
  hideActionsBar: true,
  afterSuccessfulSave: "reinitialize",
  onSave: f.handleContactSubmit,
  onFnsReady: f.registerFormManagementFns,
  formConfig: {
    gridColumns: 1,
    groups: [
      {
        key: "contact",
        title: "",
        gridColumns: 1,
        fields: [
          {
            key: "name",
            label: "Your name",
            dataType: "text",
            renderer: "text",
            required: true,
            colSpan: 1,
            placeholder: "Enter your full name"
          },
          {
            key: "email",
            label: "Email address",
            dataType: "email",
            renderer: "text",
            required: true,
            colSpan: 1,
            placeholder: "your@email.com"
          },
          {
            key: "phone",
            label: "Phone number",
            dataType: "text",
            renderer: "text",
            required: false,
            colSpan: 1,
            placeholder: "+1 555 000 0000"
          },
          {
            key: "subject",
            label: "Subject",
            dataType: "text",
            renderer: "text",
            required: true,
            colSpan: 1,
            placeholder: "What is this regarding?"
          },
          {
            key: "message",
            label: "Message",
            dataType: "text",
            renderer: "textArea",
            required: true,
            colSpan: 1,
            minLength: 10,
            maxLength: 5000,
            placeholder: "Please enter your message here..."
          }
        ]
      }
    ]
  }
};'''
