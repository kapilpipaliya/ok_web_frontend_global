    {
      id: "28"
      L: Attr
      P: {
        displayOrder: 2
        fns:
          '''const [formManagementFns, setFormManagementFns] = _.createSignal(null);
const [isSubmitting, setIsSubmitting] = _.createSignal(false);
const [submitted, setSubmitted] = _.createSignal(false);

const registerFormManagementFns = (formFns) => {
  setFormManagementFns(formFns);
};

const handleContactSubmit = async ({ vertex }) => {
  const values = vertex?.P || {};
  const name = String(values.name || "").trim();
  const email = String(values.email || "").trim();
  const phone = String(values.phone || "").trim();
  const subject = String(values.subject || "").trim();
  const message = String(values.message || "").trim();

  setIsSubmitting(true);
  try {
    const response = await s({
      functionName: "submitContactForm",
      contextData: { name, email, phone, subject, message }
    });
    const result = response?.result;
    if (result?.success) {
      setSubmitted(true);
      _.showSuccessToast(result.data?.message || "Thank you for contacting us. We will get back to you soon!");
      return true;
    }
    _.showErrorToast(result?.error || "Failed to send message");
    return false;
  } catch (error) {
    console.error("Contact form error:", error);
    _.showErrorToast("An error occurred. Please try again.");
    return false;
  } finally {
    setIsSubmitting(false);
  }
};

const runContactSubmit = () => {
  if (isSubmitting() || submitted()) return;
  const formFns = formManagementFns();
  if (!formFns?.handleSave) {
    _.showErrorToast("Form is not ready yet");
    return;
  }
  formFns.handleSave();
};

const sendAnother = () => {
  setSubmitted(false);
};

return {
  formManagementFns,
  registerFormManagementFns,
  handleContactSubmit,
  runContactSubmit,
  isSubmitting,
  submitted,
  sendAnother
};'''
        componentName: Html
        props:
          '''return {
  as: "div"
};'''
      }
    }
