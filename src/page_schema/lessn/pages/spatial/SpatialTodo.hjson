  cursor: pointer;
  transition: border-color 180ms ease, background 180ms ease;
  &:hover {
    background: ${t.var.color.background_light_100};
    border-color: color-mix(in oklch, ${t.var.color.primary} 35%, ${t.var.color.border});
  }
}`;
'''
