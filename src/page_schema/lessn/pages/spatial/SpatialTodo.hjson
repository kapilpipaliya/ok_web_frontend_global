const [activeProjectId, setActiveProjectId] = _.createSignal(null);
const [selectedTaskId, setSelectedTaskId] = _.createSignal(null);
const [focusMode, setFocusMode] = _.createSignal(false);
const [viewMode, setViewMode] = _.createSignal("spatial");
const [workspaceName] = _.createSignal("Kapil's Workspace");
