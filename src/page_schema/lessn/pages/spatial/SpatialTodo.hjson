{
  vertexes: [
    {
      id: "page"
      L: Page
      P: {
        key: SpatialTodo
        url: /spatial-todo
        public: true
        isNoPermissionCheck: true
        description: Spatial Todo Manager — free open boards
        fns:
          '''
const today = new Date();
const iso = (d) => d.toISOString().slice(0, 10);
const addDays = (n) => {
  const d = new Date(today);
  d.setDate(d.getDate() + n);
  return iso(d);
};

// Tasks are free-floating cards on open pads — no walls, desks, or room shells.
const CARD_STAND_HEIGHT = 0.08;

// Optional named presets (legacy). Placement is free X/Z — drag anywhere or edit numbers.
const AREA_SLOTS = {
  nw: { x: -5.5, z: -4.2, w: 9.5, d: 7.2, label: "Northwest" },
  ne: { x: 5.5, z: -4.2, w: 9.5, d: 7.2, label: "Northeast" },
  sw: { x: -5.5, z: 5.2, w: 9.5, d: 7.2, label: "Southwest" },
  se: { x: 5.5, z: 5.2, w: 9.5, d: 7.2, label: "Southeast" },
  center: { x: 0, z: 0.4, w: 8.2, d: 6.2, label: "Center" }
};

const CATEGORY_KINDS = {
  desk: { label: "Area", surfaceY: 0.06 },
  board: { label: "Area", surfaceY: 0.06 },
  table: { label: "Area", surfaceY: 0.06 },
  shelf: { label: "Area", surfaceY: 0.06 },
  bin: { label: "Area", surfaceY: 0.06 },
  archive: { label: "Area", surfaceY: 0.06 }
};

const CATEGORY_TINTS = [0xf0d8d0, 0xd8e2ec, 0xe8e6e0, 0xd6e6d8, 0xe4d8ec, 0xd8ebe4, 0xf0e6d0, 0xd0dde8];
const DEFAULT_ZONE_W = 8.5;
const DEFAULT_ZONE_D = 6.5;
const LOBBY_BOUNDS = 64;
const ROOM_BOUNDS = 48;

const clampLobby = (x, z) => ({
  x: Math.max(-LOBBY_BOUNDS, Math.min(LOBBY_BOUNDS, x)),
  z: Math.max(-LOBBY_BOUNDS, Math.min(LOBBY_BOUNDS, z))
});

const clampRoom = (x, z) => ({
  x: Math.max(-ROOM_BOUNDS, Math.min(ROOM_BOUNDS, x)),
  z: Math.max(-ROOM_BOUNDS, Math.min(ROOM_BOUNDS, z))
});

const normalizeCategory = (cat, index = 0) => {
  const slot = cat?.area && AREA_SLOTS[cat.area] ? AREA_SLOTS[cat.area] : null;
  const col = index % 2;
  const row = Math.floor(index / 2);
  const fallbackX = -5.5 + col * 11;
  const fallbackZ = -4.2 + row * 9.4;
  return {
    id: cat.id,
    label: cat.label || "Category",
    kind: cat.kind || "desk",
    tint: cat.tint || CATEGORY_TINTS[index % CATEGORY_TINTS.length],
    isDone: !!cat.isDone,
    x: typeof cat.x === "number" ? cat.x : slot ? slot.x : fallbackX,
    z: typeof cat.z === "number" ? cat.z : slot ? slot.z : fallbackZ,
    w: typeof cat.w === "number" ? cat.w : slot ? slot.w : DEFAULT_ZONE_W,
    d: typeof cat.d === "number" ? cat.d : slot ? slot.d : DEFAULT_ZONE_D
  };
};

const defaultCategories = () => [
  normalizeCategory({ id: "today", label: "Today", kind: "desk", x: -5.5, z: -4.2, w: 9.5, d: 7.2, tint: 0xf0d8d0, isDone: false }, 0),
  normalizeCategory({ id: "week", label: "This Week", kind: "board", x: 5.5, z: -4.2, w: 9.5, d: 7.2, tint: 0xd8e2ec, isDone: false }, 1),
  normalizeCategory({ id: "later", label: "Later", kind: "bin", x: -5.5, z: 5.2, w: 9.5, d: 7.2, tint: 0xe8e6e0, isDone: false }, 2),
  normalizeCategory({ id: "done", label: "Done", kind: "archive", x: 5.5, z: 5.2, w: 9.5, d: 7.2, tint: 0xd6e6d8, isDone: true }, 3)
];

const nextCategoryPlacement = (categories) => {
  const n = (categories || []).length;
  const col = n % 3;
  const row = Math.floor(n / 3);
  return clampRoom(-7 + col * 7, -6 + row * 6.5);
};

const ENVIRONMENTS = {
  studio: { bg: 0xf3f5f7, floor: 0xe6eaef, accent: 0x3b6d9a, light: 1.05 },
  warm: { bg: 0xf7f3ef, floor: 0xefe6dc, accent: 0xb07a4a, light: 1.0 },
  library: { bg: 0xf2f4f6, floor: 0xe4e8ec, accent: 0x4a6b5a, light: 0.95 },
  minimal: { bg: 0xf6f6f6, floor: 0xececec, accent: 0x5a5a5a, light: 1.0 },
  industrial: { bg: 0xebe6e0, floor: 0xddd6ce, accent: 0x7a6550, light: 0.92 },
  outdoor: { bg: 0xe8eef2, floor: 0xd5e0c8, accent: 0x5a7a4a, light: 1.1 }
};

// Plain open worlds — mood only. No walls, furniture, home shells, or props.
const WORLD_CATALOG = {
  plain_open: {
    id: "plain_open",
    label: "Open plain",
    blurb: "Wide open board — drag anything freely",
    type: "open",
    env: "minimal",
    exposure: 1.05,
    hdri: "studio_small_09"
  },
  plain_soft: {
    id: "plain_soft",
    label: "Soft light",
    blurb: "Gentle open space for calm planning",
    type: "open",
    env: "studio",
    exposure: 1.1,
    hdri: "studio_small_09"
  },
  plain_warm: {
    id: "plain_warm",
    label: "Warm plain",
    blurb: "Sunny open ground — free placement",
    type: "open",
    env: "warm",
    exposure: 1.0,
    hdri: "kiara_1_dawn"
  },
  plain_focus: {
    id: "plain_focus",
    label: "Focus plain",
    blurb: "Cool open field for deep work",
    type: "open",
    env: "library",
    exposure: 1.02,
    hdri: "studio_small_09"
  },
  plain_air: {
    id: "plain_air",
    label: "Airy plain",
    blurb: "Bright outdoor-feel open board",
    type: "open",
    env: "outdoor",
    exposure: 1.08,
    hdri: "kiara_1_dawn"
  },
  plain_night: {
    id: "plain_night",
    label: "Night plain",
    blurb: "Low-key open board for evening sessions",
    type: "open",
    env: "industrial",
    exposure: 0.95,
    hdri: "empty_warehouse_01"
  }
};

// Back-compat aliases from older home/office/library world ids
const WORLD_ALIASES = {
  lobby: "plain_open",
  lobby_valley: "plain_air",
  outdoor_plaza: "plain_air",
  studio: "plain_soft",
  office_modern: "plain_soft",
  office_minimal: "plain_open",
  warm: "plain_warm",
  home_cozy: "plain_warm",
  library: "plain_focus",
  library_study: "plain_focus",
  minimal: "plain_open",
  warehouse: "plain_night",
  workshop: "plain_warm",
  museum_hall: "plain_focus"
};

const WORLD_PROFILES = WORLD_CATALOG;

const resolveWorldId = (id) => {
  if (!id) return "plain_open";
  if (WORLD_CATALOG[id]) return id;
  return WORLD_ALIASES[id] || "plain_open";
};

const getWorldById = (id) => WORLD_CATALOG[resolveWorldId(id)] || WORLD_CATALOG.plain_open;

const worldList = (filter) => {
  const all = Object.values(WORLD_CATALOG);
  if (!filter || filter === "all" || filter === "open" || filter === "indoor" || filter === "outdoor") return all;
  return all.filter((w) => w.type === filter);
};

const buildZoneLayout = (categories) => {
  const layout = {};
  const cats = (categories && categories.length ? categories : defaultCategories()).map((c, i) =>
    normalizeCategory(c, i)
  );
  cats.forEach((cat) => {
    const kindMeta = CATEGORY_KINDS[cat.kind] || CATEGORY_KINDS.desk;
    layout[cat.id] = {
      label: cat.label,
      x: cat.x,
      z: cat.z,
      w: cat.w,
      d: cat.d,
      tint: cat.tint || 0xe8e6e0,
      surfaceY: kindMeta.surfaceY,
      kind: cat.kind || "desk",
      isDone: !!cat.isDone
    };
  });
  return layout;
};

// Fallback layout for helpers before projects hydrate
const ZONE_LAYOUT = buildZoneLayout(defaultCategories());

const ROOM_LAYOUT = {
  "p-shopify": { x: 0, z: -14, label: "Shopify App" },
  "p-product": { x: -14, z: 0, label: "Product" },
  "p-personal": { x: 14, z: 0, label: "Personal" },
  "p-learning": { x: 0, z: 14, label: "Learning" }
};

const makeProject = (partial) => {
  const worldId = resolveWorldId(partial.worldId || partial.environment || "plain_open");
  const lobby = partial.lobbyPosition || ROOM_LAYOUT[partial.id] || { x: 0, z: 0 };
  const cats = Array.isArray(partial.categories) && partial.categories.length
    ? partial.categories.map((c, i) => normalizeCategory(c, i))
    : defaultCategories();
  const lobbyPos = clampLobby(lobby.x, lobby.z);
  return {
    icon: "●",
    color: "#3B6D9A",
    ...partial,
    worldId,
    environment: worldId,
    lobbyPosition: lobbyPos,
    categories: cats
  };
};

const initialProjects = [
  makeProject({ id: "p-shopify", name: "Shopify App", color: "#4A6B5A", worldId: "plain_soft", lobbyPosition: { x: 0, z: -14 } }),
  makeProject({ id: "p-product", name: "Product", color: "#3B6D9A", worldId: "plain_open", lobbyPosition: { x: -14, z: 0 } }),
  makeProject({ id: "p-personal", name: "Personal", color: "#B07A4A", worldId: "plain_warm", lobbyPosition: { x: 14, z: 0 } }),
  makeProject({ id: "p-learning", name: "Learning", color: "#6B5B8A", worldId: "plain_focus", lobbyPosition: { x: 0, z: 14 } })
];

const layoutForProject = (project) => buildZoneLayout(project?.categories || defaultCategories());

const zoneSlot = (zone, index, project) => {
  const layoutMap = project ? layoutForProject(project) : ZONE_LAYOUT;
  const keys = Object.keys(layoutMap);
  const layout = layoutMap[zone] || layoutMap[keys[0]] || ZONE_LAYOUT.today;
  const col = index % 2;
  const row = Math.floor(index / 2);
  const surfaceY = layout.surfaceY ?? 0.06;
  const fan = (index % 5) * 0.07;
  return {
    x: layout.x - Math.min(2.1, layout.w / 4) + col * Math.min(2.35, layout.w / 3) + fan,
    y: surfaceY + CARD_STAND_HEIGHT / 2,
    z: layout.z - Math.min(1.6, layout.d / 4) + row * 1.55 + (col === 0 ? 0.12 : -0.08),
    ry: col === 0 ? 0.22 + fan : -0.18 - fan
  };
};

const clampInZone = (zone, x, z, project) => {
  const layoutMap = project ? layoutForProject(project) : ZONE_LAYOUT;
  const keys = Object.keys(layoutMap);
  const layout = layoutMap[zone] || layoutMap[keys[0]] || ZONE_LAYOUT.today;
  const hw = layout.w / 2 - 0.9;
  const hd = layout.d / 2 - 0.9;
  return {
    x: Math.max(layout.x - hw, Math.min(layout.x + hw, x)),
    z: Math.max(layout.z - hd, Math.min(layout.z + hd, z))
  };
};

const positionOnZoneSurface = (zone, x, z, ry, project) => {
  const layoutMap = project ? layoutForProject(project) : ZONE_LAYOUT;
  const keys = Object.keys(layoutMap);
  const layout = layoutMap[zone] || layoutMap[keys[0]] || ZONE_LAYOUT.today;
  const surfaceY = layout.surfaceY ?? 0.06;
  const clamped = clampInZone(zone, x, z, project);
  return {
    x: clamped.x,
    y: surfaceY + CARD_STAND_HEIGHT / 2,
    z: clamped.z,
    ry: typeof ry === "number" ? ry : 0
  };
};

const doneCategoryId = (project) => {
  const cats = project?.categories || defaultCategories();
  return cats.find((c) => c.isDone)?.id || cats[cats.length - 1]?.id || "done";
};

const firstOpenCategoryId = (project) => {
  const cats = project?.categories || defaultCategories();
  return cats.find((c) => !c.isDone)?.id || cats[0]?.id || "today";
};

const inferZone = (task, project) => {
  const doneId = doneCategoryId(project);
  if (task.completed || task.zone === doneId) return doneId;
  const cats = (project?.categories || defaultCategories()).filter((c) => !c.isDone);
  if (task.zone && cats.some((c) => c.id === task.zone)) return task.zone;
  const todayStr = iso(today);
  const weekEnd = addDays(7);
  if (!task.dueDate || task.dueDate <= todayStr) return cats[0]?.id || "today";
  if (task.dueDate <= weekEnd) return cats[1]?.id || cats[0]?.id || "week";
  return cats[2]?.id || cats[cats.length - 1]?.id || "later";
};

const seedTask = (partial, zoneIndex) => {
  const project = initialProjects.find((p) => p.id === partial.projectId);
  const zone = partial.zone || inferZone(partial, project);
  const doneId = doneCategoryId(project);
  return {
    tags: [],
    subtasks: [],
    createdAt: addDays(-2),
    completed: zone === doneId,
    ...partial,
    zone,
    position: partial.position || zoneSlot(zone, zoneIndex, project)
  };
};

