const task = c.listTask;
return {
  as: "button",
  type: "button",
  text: (task.completed ? "✓ " : "") + task.title + " · " + f.formatDueLabel(task.dueDate),
  onClick: () => {
    f.setViewMode("spatial");
    f.selectTask(task.id);
  }
};
'''
        css:
