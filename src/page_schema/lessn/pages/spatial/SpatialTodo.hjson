const [projects, setProjects] = _.createSignal(initialProjects);
const [tasks, setTasks] = _.createSignal(initialTasks);
const [notifications, setNotifications] = _.createSignal(initialNotifications);

const [sidebarCollapsed, setSidebarCollapsed] = _.createSignal(false);
