return `._id {
  position: absolute;
  top: 0.85rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  display: inline-flex;
  gap: 0.15rem;
  padding: 0.2rem;
  background: color-mix(in oklch, ${t.var.color.background} 88%, transparent);
  border: 1px solid ${t.var.color.border};
  border-radius: 999px;
  backdrop-filter: blur(8px);
  box-shadow: 0 4px 16px color-mix(in oklch, ${t.var.color.text} 6%, transparent);
}`;
'''
      }
    }
