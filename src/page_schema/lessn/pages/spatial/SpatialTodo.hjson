  text: "Spatial",
  onClick: () => f.setViewMode("spatial")
};
'''
        css:
          '''
const active = f.viewMode() === "spatial";
return `._id {
  border: none;
  background: ${active ? t.var.color.background_light_200 : "transparent"};
  color: ${active ? t.var.color.text : t.var.color.text_light_400};
  font: 500 0.78rem/1 var(--st-font, inherit);
  padding: 0.4rem 0.85rem;
  border-radius: 999px;
  cursor: pointer;
  transition: background 180ms ease, color 180ms ease;
}`;
'''
