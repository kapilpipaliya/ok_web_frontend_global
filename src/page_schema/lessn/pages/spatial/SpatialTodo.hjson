  projects,
  tasks,
  notifications,
  sidebarCollapsed,
  activeNav,
  activeProjectId,
  selectedTaskId,
  focusMode,
  spaceMode,
  viewMode,
  workspaceName,
  showTaskModal,
  showProjectModal,
  showWorldCustomize,
  showCommandPalette,
  showNotifications,
  showSettings,
  commandQuery,
  searchFilter,
  cameraAction,
  sceneRevision,
  dragRevision,
  settings,
  counts,
  filteredTasks,
  selectedTask,
  activeProject,
  activeCategories,
  activeZoneLayout,
  currentWorldProfile,
  unreadCount,
  projectById,
  formatDueLabel,
  selectNav,
  selectProject,
  enterProject,
  exitToLobby,
  selectTask,
  openTaskFromSearch,
  closeTaskPanel,
  exitFocus,
  toggleSidebar,
  openNewTask,
  openNewProject,
  openWorldCustomize,
  createTask,
  createProject,
  updateProject,
  setProjectWorld,
  setLobbyWorld,
  addCategory,
  updateCategory,
  removeCategory,
  moveProjectInLobby,
  moveCategoryInSpace,
  normalizeCategory,
  clampLobby,
  clampRoom,
  updateTask,
  toggleTaskComplete,
  toggleSubtask,
  deleteTask,
  duplicateTask,
  moveTaskInSpace,
  nearestZone,
  zoneSlot,
  layoutForProject,
  resetCamera,
  zoomCamera,
  focusSelected,
  openCommandPalette,
  closeCommandPalette,
  setCommandQuery,
  setSearchFilter,
  setShowNotifications,
  setShowSettings,
  setShowTaskModal,
  setShowProjectModal,
  setShowWorldCustomize,
  setViewMode,
  markNotificationsRead,
  applyAppearance,
  setSettings,
  runCommand,
  searchResults,
  bumpScene,
  isoToday: () => iso(today),
  addDays,
  bindShortcuts: () => {
    unbindShortcuts?.();
    unbindShortcuts = _.tinykeys(window, {
      "$mod+KeyK": (e) => {
        e.preventDefault();
        if (showCommandPalette()) closeCommandPalette();
        else openCommandPalette();
      },
      "KeyN": (e) => {
        const tag = (e.target && e.target.tagName) || "";
        if (tag === "INPUT" || tag === "TEXTAREA" || e.target?.isContentEditable) return;
        e.preventDefault();
        openNewTask();
      },
      "KeyR": (e) => {
        const tag = (e.target && e.target.tagName) || "";
        if (tag === "INPUT" || tag === "TEXTAREA") return;
        e.preventDefault();
        resetCamera();
      },
      "KeyF": (e) => {
        const tag = (e.target && e.target.tagName) || "";
        if (tag === "INPUT" || tag === "TEXTAREA") return;
        e.preventDefault();
        focusSelected();
      },
      "BracketLeft": (e) => {
        const tag = (e.target && e.target.tagName) || "";
        if (tag === "INPUT" || tag === "TEXTAREA") return;
        e.preventDefault();
        toggleSidebar();
      },
      "Escape": () => {
        if (showCommandPalette()) closeCommandPalette();
        else if (showNotifications()) setShowNotifications(false);
        else if (showSettings()) setShowSettings(false);
        else if (showTaskModal()) setShowTaskModal(false);
        else if (showProjectModal()) setShowProjectModal(false);
        else if (focusMode() || selectedTaskId()) exitFocus();
        else if (spaceMode() === "room") exitToLobby();
      }
    });
  },
  unbindShortcuts: () => {
    unbindShortcuts?.();
    unbindShortcuts = null;
  }
};
