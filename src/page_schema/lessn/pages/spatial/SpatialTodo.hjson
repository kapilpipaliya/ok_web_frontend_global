const [showTaskModal, setShowTaskModal] = _.createSignal(false);
const [showProjectModal, setShowProjectModal] = _.createSignal(false);
const [showWorldCustomize, setShowWorldCustomize] = _.createSignal(false);
const [showCommandPalette, setShowCommandPalette] = _.createSignal(false);
const [showNotifications, setShowNotifications] = _.createSignal(false);
const [showSettings, setShowSettings] = _.createSignal(false);
const [commandQuery, setCommandQuery] = _.createSignal("");
const [searchFilter, setSearchFilter] = _.createSignal("all");

const [cameraAction, setCameraAction] = _.createSignal(null);
const [sceneRevision, setSceneRevision] = _.createSignal(0);
const [dragRevision, setDragRevision] = _.createSignal(0);

const [settings, setSettings] = _.createStore({
  appearance: "system",
  defaultProjectId: "p-shopify",
  lobbyWorldId: "plain_open",
  gridVisible: true,
  animationIntensity: "medium",
  startWeekOnMonday: true,
  defaultPriority: "medium",
  defaultDuration: "30m"
});

const [pexelsPhoto, setPexelsPhoto] = _.createSignal(null);

const loadPexelsForProfile = async (query) => {
  try {
    const response = await s({
      functionName: "fetchPexelsPhoto",
      contextData: { query: query || "workspace" }
    });
    const payload = response?.result;
    if (payload?.success && payload.data) {
      setPexelsPhoto(payload.data);
      bumpScene();
    }
  } catch (err) {
    console.warn("Pexels photo load failed", err);
  }
};

const bumpScene = () => setSceneRevision((n) => n + 1);

const activeCategories = _.createMemo(() => {
  const project = projects().find((p) => p.id === activeProjectId());
  return project?.categories || defaultCategories();
});

const activeZoneLayout = _.createMemo(() => {
  const project = projects().find((p) => p.id === activeProjectId());
  return layoutForProject(project);
});

const currentWorldProfile = _.createMemo(() => {
  if (spaceMode() === "lobby" || !activeProjectId()) {
    return getWorldById(settings.lobbyWorldId || "plain_open");
  }
  const project = projects().find((p) => p.id === activeProjectId());
  return getWorldById(project?.worldId || project?.environment || "plain_open");
});

const counts = _.createMemo(() => {
  const list = tasks();
  const project = projects().find((p) => p.id === activeProjectId());
  const scoped = project ? list.filter((t) => t.projectId === project.id) : list;
  const cats = project?.categories || defaultCategories();
  const byCat = {};
  cats.forEach((c) => {
    byCat[c.id] = scoped.filter((t) =>
      c.isDone ? t.completed || t.zone === c.id : !t.completed && t.zone === c.id
    ).length;
  });
  return {
    spaces: projects().length,
    all: scoped.length,
    ...byCat
  };
});

const filteredTasks = _.createMemo(() => {
  const list = tasks();
  const nav = activeNav();
  const projectId = activeProjectId();
  const mode = spaceMode();

  if (mode === "lobby" && !projectId) return [];

  let result = list;
  if (projectId) result = result.filter((t) => t.projectId === projectId);

  if (nav && nav !== "spaces" && nav !== "project" && nav !== "all") {
    const project = projects().find((p) => p.id === projectId);
    const cat = (project?.categories || defaultCategories()).find((c) => c.id === nav);
    if (cat?.isDone) result = result.filter((t) => t.completed || t.zone === cat.id);
    else if (cat) result = result.filter((t) => !t.completed && t.zone === cat.id);
  }

  return result;
});

const selectedTask = _.createMemo(() => {
  const id = selectedTaskId();
  if (!id) return null;
  return tasks().find((t) => t.id === id) || null;
});

const activeProject = _.createMemo(() => {
  const id = activeProjectId();
  if (!id) return null;
  return projects().find((p) => p.id === id) || null;
});

const unreadCount = _.createMemo(() => notifications().filter((n) => n.unread).length);

const projectById = (id) => projects().find((p) => p.id === id);

const formatDueLabel = (dueDate) => {
  if (!dueDate) return "No date";
  const todayStr = iso(today);
  if (dueDate === todayStr) return "Today";
  if (dueDate === addDays(1)) return "Tomorrow";
  if (dueDate < todayStr) return "Overdue";
  const d = new Date(dueDate + "T12:00:00");
  return d.toLocaleDateString(undefined, { month: "short", day: "numeric" });
};

const exitToLobby = () => {
  setSpaceMode("lobby");
  setActiveProjectId(null);
  setActiveNav("spaces");
  setSelectedTaskId(null);
  setFocusMode(false);
  setCameraAction({ type: "lobby", token: Date.now() });
  bumpScene();
};

const selectNav = (key) => {
  if (key === "spaces") {
    exitToLobby();
    return;
  }
  // Zone filters need a room — enter default project if still in lobby
  if (!activeProjectId()) {
    const pid = settings.defaultProjectId || projects()[0]?.id;
    if (pid) {
      setActiveProjectId(pid);
      setSpaceMode("room");
      setCameraAction({ type: "enterRoom", projectId: pid, token: Date.now() });
    }
  }
  setActiveNav(key);
  setSelectedTaskId(null);
  setFocusMode(false);
  bumpScene();
};

const enterProject = (projectId) => {
  if (!projectId) return;
  setActiveProjectId(projectId);
  setActiveNav("project");
  setSpaceMode("room");
  setSelectedTaskId(null);
  setFocusMode(false);
  setCameraAction({ type: "enterRoom", projectId, token: Date.now() });
  bumpScene();
};

const selectProject = (projectId) => enterProject(projectId);

const selectTask = (taskId) => {
  setSelectedTaskId(taskId);
  if (taskId) {
    setFocusMode(true);
    setCameraAction({ type: "focus", taskId, token: Date.now() });
  } else {
    setFocusMode(false);
  }
};

const openTaskFromSearch = (taskId) => {
  const task = tasks().find((t) => t.id === taskId);
  if (!task) return;
  if (task.projectId) enterProject(task.projectId);
  setSelectedTaskId(taskId);
  setFocusMode(true);
  setCameraAction({ type: "focus", taskId, token: Date.now() });
  bumpScene();
};

const closeTaskPanel = () => {
  setSelectedTaskId(null);
  setFocusMode(false);
  if (spaceMode() === "room") {
    setCameraAction({ type: "enterRoom", projectId: activeProjectId(), token: Date.now() });
  }
};

const exitFocus = () => closeTaskPanel();

const toggleSidebar = () => setSidebarCollapsed((v) => !v);

const openNewTask = () => {
  setShowTaskModal(true);
  setShowCommandPalette(false);
};

const openNewProject = () => {
  setShowProjectModal(true);
  setShowCommandPalette(false);
};

const createTask = (payload) => {
  const id = "t-" + Date.now();
  const projectId = payload.projectId || activeProjectId() || settings.defaultProjectId;
  const project = projects().find((p) => p.id === projectId);
  const draft = {
    dueDate: payload.dueDate || addDays(0),
    completed: false,
    zone: payload.zone
  };
  const zone = payload.zone || inferZone(draft, project);
  const doneId = doneCategoryId(project);
  const existingInZone = tasks().filter((t) => t.projectId === projectId && t.zone === zone).length;
  if (spaceMode() !== "room" || activeProjectId() !== projectId) {
    enterProject(projectId);
  }
  const task = {
    id,
    title: payload.title || "Untitled task",
    description: payload.description || "",
    projectId,
    priority: payload.priority || settings.defaultPriority,
    dueDate: draft.dueDate,
    zone,
    position: zoneSlot(zone, existingInZone, project),
    completed: zone === doneId,
    tags: payload.tags || [],
    subtasks: (payload.subtasks || []).map((title, i) => ({
      id: "ns-" + id + "-" + i,
      title,
      done: false
    })),
    createdAt: iso(today)
  };
  setTasks((prev) => [...prev, task]);
  setShowTaskModal(false);
  setSelectedTaskId(id);
  setFocusMode(true);
  bumpScene();
  _.showSuccessToast("Task created");
};

const createProject = (payload) => {
  const id = "p-" + Date.now();
  const angle = (projects().length % 8) * (Math.PI / 4);
  const lobbyPosition = payload.lobbyPosition || {
    x: Math.cos(angle) * 14,
    z: Math.sin(angle) * 14
  };
  const project = makeProject({
    id,
    name: payload.name || "New Project",
    color: payload.color || "#3B6D9A",
    worldId: payload.worldId || payload.environment || "plain_open",
    icon: payload.icon || "●",
    categories: payload.categories || defaultCategories(),
    lobbyPosition
  });
  ROOM_LAYOUT[id] = { x: lobbyPosition.x, z: lobbyPosition.z, label: project.name };
  setProjects((prev) => [...prev, project]);
  setShowProjectModal(false);
  enterProject(id);
  _.showSuccessToast("Project world created");
};

const updateProject = (projectId, patch) => {
  setProjects((prev) =>
    prev.map((p) => {
      if (p.id !== projectId) return p;
      const next = makeProject({ ...p, ...patch, id: p.id });
      ROOM_LAYOUT[projectId] = {
        x: next.lobbyPosition.x,
        z: next.lobbyPosition.z,
        label: next.name
      };
      return next;
    })
  );
  bumpScene();
};

const setProjectWorld = (projectId, worldId) => {
  updateProject(projectId, { worldId: resolveWorldId(worldId) });
  const profile = getWorldById(worldId);
  _.showSuccessToast("World updated · " + (profile?.label || worldId));
};

const setLobbyWorld = (worldId) => {
  const id = resolveWorldId(worldId);
  setSettings("lobbyWorldId", id);
  if (spaceMode() === "lobby") bumpScene();
  _.showSuccessToast("Lobby world · " + getWorldById(id).label);
};

const addCategory = (projectId, partial) => {
  const project = projects().find((p) => p.id === projectId);
  if (!project) return;
  const place = nextCategoryPlacement(project.categories);
  const id = partial?.id || ("cat-" + Date.now());
  const tint = CATEGORY_TINTS[(project.categories || []).length % CATEGORY_TINTS.length];
  const next = [
    ...(project.categories || []),
    normalizeCategory(
      {
        id,
        label: partial?.label || "New area",
        kind: partial?.kind || "desk",
        tint: partial?.tint || tint,
        isDone: !!partial?.isDone,
        x: typeof partial?.x === "number" ? partial.x : place.x,
        z: typeof partial?.z === "number" ? partial.z : place.z,
        w: typeof partial?.w === "number" ? partial.w : DEFAULT_ZONE_W,
        d: typeof partial?.d === "number" ? partial.d : DEFAULT_ZONE_D
      },
      (project.categories || []).length
    )
  ];
  updateProject(projectId, { categories: next });
  _.showSuccessToast("Category added — drag it anywhere in the room");
};

const moveProjectInLobby = (projectId, x, z) => {
  const pos = clampLobby(x, z);
  updateProject(projectId, { lobbyPosition: pos });
};

const moveCategoryInSpace = (projectId, categoryId, x, z) => {
  const project = projects().find((p) => p.id === projectId);
  if (!project) return;
  const cat = (project.categories || []).find((c) => c.id === categoryId);
  if (!cat) return;
  const nextPos = clampRoom(x, z);
  const dx = nextPos.x - (typeof cat.x === "number" ? cat.x : 0);
  const dz = nextPos.z - (typeof cat.z === "number" ? cat.z : 0);
  const nextCats = (project.categories || []).map((c) =>
    c.id === categoryId ? normalizeCategory({ ...c, x: nextPos.x, z: nextPos.z }, 0) : c
  );
  const updatedProject = { ...project, categories: nextCats };
  setTasks((prev) =>
    prev.map((t) => {
      if (t.projectId !== projectId || t.zone !== categoryId) return t;
      const px = (t.position?.x || 0) + dx;
      const pz = (t.position?.z || 0) + dz;
      return {
        ...t,
        position: positionOnZoneSurface(categoryId, px, pz, t.position?.ry, updatedProject)
      };
    })
  );
  updateProject(projectId, { categories: nextCats });
};

const updateCategory = (projectId, categoryId, patch) => {
  const project = projects().find((p) => p.id === projectId);
  if (!project) return;
  const prevCat = (project.categories || []).find((c) => c.id === categoryId);
  const next = (project.categories || []).map((c, i) =>
    c.id === categoryId ? normalizeCategory({ ...c, ...patch }, i) : normalizeCategory(c, i)
  );
  updateProject(projectId, { categories: next });
  const moved =
    (typeof patch.x === "number" && patch.x !== prevCat?.x) ||
    (typeof patch.z === "number" && patch.z !== prevCat?.z);
  const resized = typeof patch.w === "number" || typeof patch.d === "number" || patch.kind;
  if (moved && prevCat) {
    const dx = (typeof patch.x === "number" ? patch.x : prevCat.x) - prevCat.x;
    const dz = (typeof patch.z === "number" ? patch.z : prevCat.z) - prevCat.z;
    const updatedProject = { ...project, categories: next };
    setTasks((prev) =>
      prev.map((t) => {
        if (t.projectId !== projectId || t.zone !== categoryId) return t;
        return {
          ...t,
          position: positionOnZoneSurface(
            categoryId,
            (t.position?.x || 0) + dx,
            (t.position?.z || 0) + dz,
            t.position?.ry,
            updatedProject
          )
        };
      })
    );
  } else if (resized) {
    const updatedProject = { ...project, categories: next };
    setTasks((prev) =>
      prev.map((t) => {
        if (t.projectId !== projectId || t.zone !== categoryId) return t;
        return {
          ...t,
          position: positionOnZoneSurface(
            categoryId,
            t.position?.x || 0,
            t.position?.z || 0,
            t.position?.ry,
            updatedProject
          )
        };
      })
    );
  }
  bumpScene();
};

const removeCategory = (projectId, categoryId) => {
  const project = projects().find((p) => p.id === projectId);
  if (!project || (project.categories || []).length <= 1) {
    _.showWarningToast("Keep at least one category");
    return;
  }
  const next = (project.categories || []).filter((c) => c.id !== categoryId);
  const fallback = next.find((c) => !c.isDone)?.id || next[0].id;
  setTasks((prev) =>
    prev.map((t) => {
      if (t.projectId !== projectId || t.zone !== categoryId) return t;
      const siblings = prev.filter(
        (x) => x.projectId === projectId && x.zone === fallback && x.id !== t.id
      ).length;
      const updatedProject = { ...project, categories: next };
      return {
        ...t,
        zone: fallback,
        completed: next.find((c) => c.id === fallback)?.isDone || false,
        position: zoneSlot(fallback, siblings, updatedProject)
      };
    })
  );
  updateProject(projectId, { categories: next });
  if (activeNav() === categoryId) setActiveNav("project");
  _.showSuccessToast("Category removed");
};

const openWorldCustomize = () => {
  setShowWorldCustomize(true);
  setShowCommandPalette(false);
};

const updateTask = (taskId, patch) => {
  setTasks((prev) => prev.map((t) => (t.id === taskId ? { ...t, ...patch } : t)));
  bumpScene();
};

const toggleTaskComplete = (taskId) => {
  setTasks((prev) =>
    prev.map((t) => {
      if (t.id !== taskId) return t;
      const project = projects().find((p) => p.id === t.projectId);
      const doneId = doneCategoryId(project);
      const completed = !t.completed;
      const zone = completed
        ? doneId
        : inferZone({ ...t, completed: false, zone: t.zone === doneId ? firstOpenCategoryId(project) : t.zone }, project);
      const siblings = prev.filter((x) => x.projectId === t.projectId && x.zone === zone && x.id !== t.id).length;
      return { ...t, completed, zone, position: zoneSlot(zone, siblings, project) };
    })
  );
  bumpScene();
};

const toggleSubtask = (taskId, subtaskId) => {
  setTasks((prev) =>
    prev.map((t) => {
      if (t.id !== taskId) return t;
      return {
        ...t,
        subtasks: (t.subtasks || []).map((s) =>
          s.id === subtaskId ? { ...s, done: !s.done } : s
        )
      };
    })
  );
};

const deleteTask = (taskId) => {
  setTasks((prev) => prev.filter((t) => t.id !== taskId));
  if (selectedTaskId() === taskId) setSelectedTaskId(null);
  bumpScene();
  _.showSuccessToast("Task deleted");
};

const duplicateTask = (taskId) => {
  const source = tasks().find((t) => t.id === taskId);
  if (!source) return;
  const id = "t-" + Date.now();
  const copy = {
    ...source,
    id,
    title: source.title + " (copy)",
    completed: false,
    position: {
      x: source.position.x + 1.2,
      y: source.position.y,
      z: source.position.z + 0.8
    },
    subtasks: (source.subtasks || []).map((s, i) => ({
      id: "ds-" + id + "-" + i,
      title: s.title,
      done: false
    })),
    createdAt: iso(today)
  };
  setTasks((prev) => [...prev, copy]);
  setSelectedTaskId(id);
  bumpScene();
  _.showSuccessToast("Task duplicated");
};

const moveTaskInSpace = (taskId, position, zone) => {
  setTasks((prev) =>
    prev.map((t) => {
      if (t.id !== taskId) return t;
      const project = projects().find((p) => p.id === t.projectId);
      const layoutMap = layoutForProject(project);
      const keys = Object.keys(layoutMap);
      const nextZone = zone && layoutMap[zone] ? zone : keys[Math.min(2, keys.length - 1)] || "later";
      const cat = (project?.categories || []).find((c) => c.id === nextZone);
      const completed = !!cat?.isDone;
      const nextPos = positionOnZoneSurface(nextZone, position.x, position.z, position.ry, project);
      return {
        ...t,
        position: nextPos,
        zone: nextZone,
        completed
      };
    })
  );
  setDragRevision((n) => n + 1);
  bumpScene();
};

const nearestZone = (x, z) => {
  const layoutMap = activeZoneLayout();
  const entries = Object.entries(layoutMap);
  for (const [key, layout] of entries) {
    const hw = layout.w / 2;
    const hd = layout.d / 2;
    if (Math.abs(x - layout.x) <= hw && Math.abs(z - layout.z) <= hd) return key;
  }
  let best = entries[0]?.[0] || "later";
  let bestDist = Infinity;
  for (const [key, layout] of entries) {
    const dx = x - layout.x;
    const dz = z - layout.z;
    const dist = Math.sqrt(dx * dx + dz * dz);
    if (dist < bestDist) {
      bestDist = dist;
      best = key;
    }
  }
  return best;
};

const resetCamera = () => {
  if (spaceMode() === "room" && activeProjectId()) {
    setCameraAction({ type: "enterRoom", projectId: activeProjectId(), token: Date.now() });
  } else {
    setCameraAction({ type: "lobby", token: Date.now() });
  }
};
const zoomCamera = (dir) => setCameraAction({ type: "zoom", dir, token: Date.now() });
const focusSelected = () => {
  const id = selectedTaskId();
  if (id) {
    setFocusMode(true);
    setCameraAction({ type: "focus", taskId: id, token: Date.now() });
  }
};

const openCommandPalette = () => {
  setCommandQuery("");
  setSearchFilter("all");
  setShowCommandPalette(true);
  setShowNotifications(false);
};

const closeCommandPalette = () => {
  setShowCommandPalette(false);
  setCommandQuery("");
};

const markNotificationsRead = () => {
  setNotifications((prev) => prev.map((n) => ({ ...n, unread: false })));
};

const applyAppearance = (mode) => {
  setSettings("appearance", mode);
  _.setColorMode(mode);
};

const runCommand = (commandId) => {
  closeCommandPalette();
  switch (commandId) {
    case "create-task":
      openNewTask();
      break;
    case "create-project":
      openNewProject();
      break;
    case "go-today":
      selectNav("today");
      break;
    case "go-spaces":
      exitToLobby();
      break;
    case "go-week":
      selectNav("week");
      break;
    case "enter-shopify":
      enterProject("p-shopify");
      break;
    case "toggle-sidebar":
      toggleSidebar();
      break;
    case "reset-camera":
      resetCamera();
      break;
    case "focus-selected":
      focusSelected();
      break;
    case "exit-focus":
      exitFocus();
      break;
    case "open-settings":
      setShowSettings(true);
      break;
    case "customize-world":
      openWorldCustomize();
      break;
    default:
      break;
  }
};

const searchResults = _.createMemo(() => {
  const q = commandQuery().trim().toLowerCase();
  const filter = searchFilter();
  const taskMatches = tasks()
    .filter((t) => {
      if (filter === "projects") return false;
      if (filter === "completed" && !t.completed) return false;
      if (filter === "overdue" && !(t.dueDate && t.dueDate < iso(today) && !t.completed)) return false;
      if (filter === "tasks" && t.completed) return false;
      if (!q) return filter !== "all" || true;
      return (
        t.title.toLowerCase().includes(q) ||
        (t.description || "").toLowerCase().includes(q) ||
        (t.tags || []).some((tag) => tag.toLowerCase().includes(q))
      );
    })
    .slice(0, 8);

  const projectMatches =
    filter === "tasks" || filter === "completed" || filter === "overdue"
      ? []
      : projects()
          .filter((p) => !q || p.name.toLowerCase().includes(q))
          .slice(0, 6);

  const commands = [
    { id: "create-task", label: "Create task", hint: "N" },
    { id: "create-project", label: "Create project", hint: "" },
    { id: "customize-world", label: "Customize open plain", hint: "" },
    { id: "enter-shopify", label: "Enter Shopify App", hint: "" },
    { id: "go-spaces", label: "Back to spaces", hint: "Esc" },
    { id: "toggle-sidebar", label: "Toggle sidebar", hint: "[" },
    { id: "reset-camera", label: "Reset camera", hint: "R" },
    { id: "focus-selected", label: "Focus selected task", hint: "F" },
    { id: "exit-focus", label: "Exit focus mode", hint: "" },
    { id: "open-settings", label: "Open settings", hint: "," }
  ].filter((cmd) => !q || cmd.label.toLowerCase().includes(q));

  return { tasks: taskMatches, projects: projectMatches, commands };
});

let unbindShortcuts = null;

return {
  ZONE_LAYOUT,
  ROOM_LAYOUT,
  AREA_SLOTS,
  CATEGORY_KINDS,
  ENVIRONMENTS,
  WORLD_PROFILES,
  WORLD_CATALOG,
  worldList,
  getWorldById,
  resolveWorldId,
  defaultCategories,
  pexelsPhoto,
