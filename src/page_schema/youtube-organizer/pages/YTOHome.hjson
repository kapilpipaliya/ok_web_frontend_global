    padding: 2rem 0;
  }
}`;
'''
      }
    },
    {
      id: "3",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: "YouTube Organizer"
};
''',
        css: '''
return `._id {
  font-size: 1.75rem;
  font-weight: 700;
  color: ${args.theme.var.color.text};
  margin: 0 0 0.5rem 0;
  
  @media (min-width: 768px) {
    font-size: 2.25rem;
  }
}`;
'''
      }
    },
    {
      id: "4",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "Organize your YouTube channels and playlists in one place"
};
''',
        css: '''
return `._id {
  font-size: 1rem;
  color: ${args.theme.var.color.text};
  opacity: 0.7;
  margin: 0;
  
  @media (min-width: 768px) {
    font-size: 1.125rem;
  }
}`;
'''
      }
    },
    {
      id: "5",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
  
  @media (min-width: 768px) {
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
}`;
'''
      }
    },
    {
      id: "6",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  onClick: () => args.navigate("/yto/channels"),
  role: "button",
  tabIndex: 0,
  "aria-label": "Go to channels"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.background};
  border: 2px solid ${args.theme.var.color.border};
  border-radius: 1rem;
  padding: 2rem;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s ease;
  
  &:hover {
    border-color: ${args.theme.var.color.primary};
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }
  
  &:focus {
    outline: 2px solid ${args.theme.var.color.primary};
    outline-offset: 2px;
  }
  
  @media (min-width: 768px) {
    padding: 3rem;
  }
}`;
'''
      }
    },
    {
      id: "7",
      L: "Attr",
      P: {
