    {
      id: "4",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        contextName: "channels",
        serverFunction: '''
// Fetch user's channels
if (!args.user) {
  return [];
}

const result = await args.session.run(
  `MATCH (u:User {id: $userId})-[uc:UserChannelSetting]->(c:Channel)
   RETURN c
   ORDER BY c.title`,
  { userId: args.user.id }
);

return result.records.map(record => {
  const channel = record.get('c').properties;
  return {
    id: channel.id,
    channelId: channel.channelId,
    title: channel.title,
    description: channel.description,
    thumbnails: channel.thumbnails,
    subscriberCount: channel.subscriberCount,
    videoCount: channel.videoCount
  };
});
''',
        props: '''
const channels = args.contextData.channels || [];
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}`;
'''
      }
    },
    {
      id: "5",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "channelList",
        loop: true,
        props: '''
const channels = args.contextData.channels || [];
if (channels.length === 0) {
  return {
    data: [{
      id: "empty",
      isEmpty: true
    }]
  };
}
return {
  data: channels
};
'''
      }
    },
    {
      id: "6",
