{
  vertexes: [
    {
      id: "page1",
      L: "Page",
      P: {
        key: "YTOChannels",
        name: "YouTube Organizer Channels",
        description: "Manage YouTube channels",
        url: "/yto/channels"
      }
    },
    {
      id: "layout1",
      L: "PageLayout",
      P: {
        componentName: "YTOLayout",
        displayOrder: 1
      }
    },
    {
      id: "1",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
return {
  showAddModal: () => {
    const [modalOpen, setModalOpen] = args.contextData.modalState || [false, () => {}];
    setModalOpen(true);
  },
  closeModal: () => {
    const [modalOpen, setModalOpen] = args.contextData.modalState || [false, () => {}];
    const [channelUrl, setChannelUrl] = args.contextData.urlState || ["", () => {}];
    const [apiKey, setApiKey] = args.contextData.apiKeyState || ["", () => {}];
    setModalOpen(false);
    setChannelUrl("");
    setApiKey("");
  },
  addChannel: async () => {
    const [channelUrl] = args.contextData.urlState || [""];
    const [apiKey] = args.contextData.apiKeyState || [""];
    const [loading, setLoading] = args.contextData.loadingState || [false, () => {}];
    
    if (!channelUrl) {
      args.showErrorToast("Please enter a channel URL");
      return;
    }
    
    if (!apiKey && !process.env.YOUTUBE_API_KEY) {
      args.showErrorToast("Please enter a YouTube API key");
      return;
    }
    
    setLoading(true);
    
    try {
      const result = await args.executeNamedServerFunction({functionName: 'fetchYouTubeChannel', contextData: {
        channelUrl: channelUrl,
        apiKey: apiKey
      }});
      
      if (result.error) {
        args.showErrorToast(result.error);
      } else if (result.result && result.result.success) {
        args.showSuccessToast(`Channel "${result.result.data.channel.snippet.title}" added successfully with ${result.result.data.videosAdded} videos`);
        args.fns.closeModal();
        // Refresh the page to show new channel
        window.location.reload();
      } else if (result.success) {
        args.showSuccessToast(`Channel "${result.data.channel.snippet.title}" added successfully with ${result.data.videosAdded} videos`);
        args.fns.closeModal();
        // Refresh the page to show new channel
        window.location.reload();
      } else {
        args.showErrorToast(result.result?.error || result.error || "Failed to add channel");
      }
    } catch (error) {
      args.showErrorToast(error.message || "Failed to add channel");
    } finally {
      setLoading(false);
    }
  }
};
''',
        props: '''
// Initialize modal and form state
const [modalOpen, setModalOpen] = args.createSignal(false);
const [channelUrl, setChannelUrl] = args.createSignal("");
const [apiKey, setApiKey] = args.createSignal("");
const [loading, setLoading] = args.createSignal(false);

return {
  data: {
    modalState: [modalOpen, setModalOpen],
    urlState: [channelUrl, setChannelUrl],
    apiKeyState: [apiKey, setApiKey],
    loadingState: [loading, setLoading]
  }
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  min-height: calc(100vh - 8rem);
  position: relative;
}`;
'''
      }
    },
    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
return `._id {
