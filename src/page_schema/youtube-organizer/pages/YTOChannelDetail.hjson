}

return {
  as: "div"
};
''',
        css: '''
return `._id {
  padding: 1rem;
  background: ${args.theme.var.color.background_dark_100};
  border-radius: 0.75rem;
  
  @media (min-width: 768px) {
    padding: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "21",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
