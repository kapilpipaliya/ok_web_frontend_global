{
  vertexes: [
    {
      id: "page1",
      L: "Page",
      P: {
        key: "YTOPlaylists",
        name: "YouTube Organizer Playlists",
        description: "Manage YouTube playlists",
        url: "/yto/playlists"
      }
    },
    {
      id: "layout1",
      L: "PageLayout",
      P: {
        componentName: "YTOLayout",
        displayOrder: 1
      }
    },
    {
      id: "1",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
return {
  showAddModal: () => {
    const [modalOpen, setModalOpen] = args.contextData.modalState || [false, () => {}];
    setModalOpen(true);
  },
  closeModal: () => {
    const [modalOpen, setModalOpen] = args.contextData.modalState || [false, () => {}];
    const [playlistUrl, setPlaylistUrl] = args.contextData.urlState || ["", () => {}];
    const [apiKey, setApiKey] = args.contextData.apiKeyState || ["", () => {}];
    setModalOpen(false);
    setPlaylistUrl("");
    setApiKey("");
  },
  addPlaylist: async () => {
    const [playlistUrl] = args.contextData.urlState || [""];
    const [apiKey] = args.contextData.apiKeyState || [""];
    const [loading, setLoading] = args.contextData.loadingState || [false, () => {}];
    
    if (!playlistUrl) {
      args.showErrorToast("Please enter a playlist URL");
      return;
    }
    
    if (!apiKey && !process.env.YOUTUBE_API_KEY) {
      args.showErrorToast("Please enter a YouTube API key");
      return;
    }
    
    setLoading(true);
    
    try {
      const result = await args.executeServerFunction('fetchYouTubePlaylist', {
        playlistUrl: playlistUrl,
        apiKey: apiKey
      });
      
      if (result.success) {
        args.showSuccessToast(`Playlist "${result.data.playlist.snippet.title}" added successfully with ${result.data.videosAdded} videos`);
        args.fns.closeModal();
        // Refresh the page to show new playlist
        window.location.reload();
      } else {
        args.showErrorToast(result.error || "Failed to add playlist");
      }
    } catch (error) {
      args.showErrorToast(error.message || "Failed to add playlist");
    } finally {
      setLoading(false);
    }
  }
};
''',
        props: '''
// Initialize modal and form state
const [modalOpen, setModalOpen] = args.createSignal(false);
const [playlistUrl, setPlaylistUrl] = args.createSignal("");
const [apiKey, setApiKey] = args.createSignal("");
const [loading, setLoading] = args.createSignal(false);

return {
  data: {
    modalState: [modalOpen, setModalOpen],
    urlState: [playlistUrl, setPlaylistUrl],
    apiKeyState: [apiKey, setApiKey],
    loadingState: [loading, setLoading]
  }
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  min-height: calc(100vh - 8rem);
  position: relative;
}`;
'''
      }
    },
    {
      id: "2",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.5rem 0;
}`;
'''
      }
    },
    {
      id: "3",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: "My Playlists"
};
''',
        css: '''
return `._id {
  font-size: 1.5rem;
  font-weight: 700;
  color: ${args.theme.var.color.text};
  margin: 0;
  
  @media (min-width: 768px) {
    font-size: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "4",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        contextName: "playlists",
        serverFunction: '''
// Fetch user's playlists
if (!args.user) {
  return [];
}

const result = await args.session.run(
  `MATCH (u:User {id: $userId})-[up:UserPlaylist]->(p:Playlist)
   RETURN p
   ORDER BY p.title`,
  { userId: args.user.id }
);

return result.records.map(record => {
  const playlist = record.get('p').properties;
  return {
    id: playlist.id,
    playlistId: playlist.playlistId,
    title: playlist.title,
    description: playlist.description,
    thumbnails: playlist.thumbnails,
    channelTitle: playlist.channelTitle,
    itemCount: playlist.itemCount,
    status: playlist.status
  };
});
''',
        props: '''
const playlists = args.contextData.playlists || [];
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
  
  @media (min-width: 640px) {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
}`;
'''
      }
    },
    {
      id: "5",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "playlistList",
        loop: true,
        props: '''
const playlists = args.contextData.playlists || [];
if (playlists.length === 0) {
  return {
    data: [{
      id: "empty",
      isEmpty: true
    }]
  };
}
return {
  data: playlists
};
'''
      }
    },
    {
      id: "6",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.playlistList;
if (item.isEmpty) {
  // Empty state
  return {
    as: "div"
  };
}
// Playlist card wrapper
return {
  as: "div"
};
''',
        css: '''
const item = args.contextData.playlistList;
if (item.isEmpty) {
  return `._id {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem 1rem;
    color: ${args.theme.var.color.text};
    opacity: 0.6;
  }`;
}
return "";
'''
      }
    },
