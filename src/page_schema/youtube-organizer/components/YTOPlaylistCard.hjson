{
  vertexes: [
    {
      id: "1",
      L: "Component",
      P: {
        key: "YTOPlaylistCard",
        name: "YouTube Organizer Playlist Card",
        description: "Accessible card component for displaying playlist information"
      }
    },
    {
      id: "2",
      L: "ComponentVariant",
      P: {
        key: "playlist",
        type: "string",
        defValue: "{}"
      }
    },
    {
      id: "3",
      L: "ComponentVariant",
      P: {
        key: "onClick",
        type: "string",
        defValue: ""
      }
    },
    {
      id: "4",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const playlistData = args.contextData.props?.playlist;
const playlist = typeof playlistData === 'string' ? JSON.parse(playlistData) : playlistData || {};
const onClick = args.contextData.props?.onClick;
return {
  as: "article",
  onClick: onClick ? () => eval(onClick) : undefined,
  role: "article",
  tabIndex: 0,
  "aria-label": `${playlist.title || "Playlist"} playlist card`
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  background: ${args.theme.var.color.background};
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.75rem;
  overflow: hidden;
  cursor: pointer;
  transition: all 0.3s ease;
  
  &:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    border-color: ${args.theme.var.color.primary_light_400};
  }
  
  &:focus {
    outline: 2px solid ${args.theme.var.color.primary};
    outline-offset: 2px;
  }
  
  @media (min-width: 768px) {
    max-width: 320px;
  }
}`;
'''
      }
    },
    {
      id: "5",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const playlistData = args.contextData.props?.playlist;
const playlist = typeof playlistData === 'string' ? JSON.parse(playlistData) : playlistData || {};
const thumbnailUrl = playlist.thumbnails?.medium?.url || playlist.thumbnails?.default?.url || '';
return {
  as: "div",
  style: `background-image: url('${thumbnailUrl}')`
};
''',
        css: '''
return `._id {
  width: 100%;
  padding-top: 56.25%;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-color: ${args.theme.var.color.background_dark_300};
  position: relative;
}`;
'''
      }
    },
    {
      id: "6",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const playlistData = args.contextData.props?.playlist;
const playlist = typeof playlistData === 'string' ? JSON.parse(playlistData) : playlistData || {};
const itemCount = playlist.itemCount || 0;
return {
  as: "div"
};
''',
        css: '''
return `._id {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 35%;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(2px);
}`;
'''
      }
    },
    {
      id: "7",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  text-align: center;
  color: white;
}`;
'''
      }
    },
    {
      id: "8",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const playlistData = args.contextData.props?.playlist;
const playlist = typeof playlistData === 'string' ? JSON.parse(playlistData) : playlistData || {};
const itemCount = playlist.itemCount || 0;
return {
  as: "div",
  text: itemCount.toString()
};
''',
        css: '''
return `._id {
  font-size: 1.5rem;
  font-weight: 700;
  line-height: 1;
  
  @media (min-width: 768px) {
    font-size: 1.75rem;
  }
}`;
'''
      }
    },
    {
      id: "9",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "material-symbols:playlist-play",
  width: 20,
  height: 20
};
''',
        css: '''
return `._id {
  margin-top: 0.25rem;
  opacity: 0.9;
}`;
'''
      }
    },
    {
      id: "10",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}`;
'''
      }
    },
    {
      id: "11",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const playlistData = args.contextData.props?.playlist;
const playlist = typeof playlistData === 'string' ? JSON.parse(playlistData) : playlistData || {};
return {
  as: "h3",
  text: playlist.title || "Untitled Playlist"
};
''',
        css: '''
return `._id {
  font-size: 1rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
  margin: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
  
  @media (min-width: 768px) {
    font-size: 1.125rem;
  }
}`;
'''
      }
    },
    {
      id: "12",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const playlistData = args.contextData.props?.playlist;
const playlist = typeof playlistData === 'string' ? JSON.parse(playlistData) : playlistData || {};
return {
  as: "p",
  text: playlist.channelTitle || "Unknown Channel"
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  color: ${args.theme.var.color.text};
  opacity: 0.7;
  margin: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}`;
'''
      }
    },
    {
      id: "13",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const playlistData = args.contextData.props?.playlist;
const playlist = typeof playlistData === 'string' ? JSON.parse(playlistData) : playlistData || {};
const privacy = playlist.status?.privacyStatus || "public";
const privacyText = privacy === "private" ? "Private" : privacy === "unlisted" ? "Unlisted" : "Public";
const itemCount = playlist.itemCount || 0;
const itemText = itemCount === 1 ? "1 video" : itemCount + " videos";
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 0.8125rem;
  color: ${args.theme.var.color.text};
  opacity: 0.6;
}`;
'''
      }
    },
    {
      id: "14",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const playlistData = args.contextData.props?.playlist;
const playlist = typeof playlistData === 'string' ? JSON.parse(playlistData) : playlistData || {};
const privacy = playlist.status?.privacyStatus || "public";
const privacyText = privacy === "private" ? "Private" : privacy === "unlisted" ? "Unlisted" : "Public";
return {
  as: "span",
  text: privacyText
};
''',
        css: '''
const playlistData = args.contextData.props?.playlist;
const playlist = typeof playlistData === 'string' ? JSON.parse(playlistData) : playlistData || {};
const privacy = playlist.status?.privacyStatus || "public";
const isPrivate = privacy === "private";
const isUnlisted = privacy === "unlisted";
return `._id {
  padding: 0.125rem 0.5rem;
  background: ${isPrivate ? args.theme.var.color.error_light_100 : isUnlisted ? args.theme.var.color.warning_light_100 : args.theme.var.color.success_light_100};
  color: ${isPrivate ? args.theme.var.color.error : isUnlisted ? args.theme.var.color.warning : args.theme.var.color.success};
  border-radius: 0.25rem;
  font-size: 0.75rem;
  font-weight: 500;
}`;
'''
      }
    },
    {
      id: "15",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const playlistData = args.contextData.props?.playlist;
const playlist = typeof playlistData === 'string' ? JSON.parse(playlistData) : playlistData || {};
const itemCount = playlist.itemCount || 0;
const itemText = itemCount === 1 ? "1 video" : itemCount + " videos";
return {
  as: "span",
  text: itemText
};
'''
      }
    }
