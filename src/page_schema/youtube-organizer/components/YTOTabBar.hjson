{
  vertexes: [
    {
      id: "1",
      L: "Component",
      P: {
        key: "YTOTabBar",
        name: "YouTube Organizer Tab Bar",
        description: "Accessible tab bar component for channel and playlist views"
      }
    },
    {
      id: "2",
      L: "ComponentVariant",
      P: {
        key: "tabs",
        type: "string",
        defValue: '["Videos", "Playlists"]'
      }
    },
    {
      id: "3",
      L: "ComponentVariant",
      P: {
        key: "activeTab",
        type: "string",
        defValue: "Videos"
      }
    },
    {
      id: "4",
      L: "ComponentVariant",
      P: {
        key: "onTabChange",
        type: "string",
        defValue: ""
      }
    },
    {
      id: "5",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  role: "tablist",
  "aria-label": "Content tabs"
};
''',
        css: '''
return `._id {
  display: flex;
  gap: 0.5rem;
  padding: 0.25rem;
  background: ${args.theme.var.color.background_dark_100};
  border-radius: 0.5rem;
  margin-bottom: 1.5rem;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  
  &::-webkit-scrollbar {
    height: 4px;
  }
  
  &::-webkit-scrollbar-track {
    background: transparent;
  }
  
  &::-webkit-scrollbar-thumb {
    background: ${args.theme.var.color.border};
    border-radius: 2px;
  }
  
  @media (min-width: 768px) {
    gap: 0.75rem;
    padding: 0.375rem;
  }
}`;
'''
      }
    },
    {
      id: "6",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "tabItems",
        loop: true,
        props: '''
const tabsData = args.contextData.props?.tabs || '["Videos", "Playlists"]';
const tabs = typeof tabsData === 'string' ? JSON.parse(tabsData) : tabsData;
return {
  data: tabs.map((tab, index) => ({ id: index, name: tab }))
};
'''
      }
    },
    {
      id: "7",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const tab = args.contextData.tabItems;
const activeTab = args.contextData.props?.activeTab || "Videos";
const isActive = tab.name === activeTab;
const onTabChange = args.contextData.props?.onTabChange;

return {
  as: "button",
  onClick: onTabChange ? () => eval(onTabChange)(tab.name) : undefined,
  role: "tab",
  "aria-selected": isActive,
  "aria-controls": `tabpanel-${tab.id}`,
  tabIndex: isActive ? 0 : -1
};
''',
        css: '''
const tab = args.contextData.tabItems;
const activeTab = args.contextData.props?.activeTab || "Videos";
const isActive = tab.name === activeTab;

return `._id {
  padding: 0.625rem 1.25rem;
  border: none;
  background: ${isActive ? args.theme.var.color.primary : "transparent"};
  color: ${isActive ? args.theme.var.color.primary_text : args.theme.var.color.text};
  font-size: 0.875rem;
  font-weight: ${isActive ? 600 : 500};
  border-radius: 0.375rem;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
  flex-shrink: 0;
  
  &:hover:not([aria-selected="true"]) {
    background: ${args.theme.var.color.background_dark_200};
    color: ${args.theme.var.color.primary};
  }
  
  &:focus {
    outline: 2px solid ${args.theme.var.color.primary};
    outline-offset: 2px;
  }
  
  &:active {
    transform: scale(0.98);
  }
  
  @media (min-width: 768px) {
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
  }
}`;
'''
      }
    },
    {
      id: "8",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const tab = args.contextData.tabItems;
const iconMap = {
  "Videos": "material-symbols:play-circle-outline-rounded",
  "Playlists": "material-symbols:playlist-play-rounded",
  "About": "material-symbols:info-outline-rounded",
  "Community": "material-symbols:people-outline-rounded"
};
const icon = iconMap[tab.name];
if (!icon) return { as: "" };

return {
  as: "icon",
  icon: icon,
  width: 18,
  height: 18,
  "aria-hidden": "true"
};
''',
        css: '''
return `._id {
  margin-right: 0.375rem;
  vertical-align: text-bottom;
  
  @media (min-width: 768px) {
    width: 20px;
    height: 20px;
    margin-right: 0.5rem;
  }
}`;
'''
      }
    },
    {
      id: "9",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const tab = args.contextData.tabItems;
return {
  as: "span",
  text: tab.name
};
'''
      }
    }
  ],
  edges: [
    { id: "e1", T: "ComponentVariant", S: "1", E: "2" },
    { id: "e2", T: "ComponentVariant", S: "1", E: "3" },
    { id: "e3", T: "ComponentVariant", S: "1", E: "4" },
    { id: "e4", T: "Attr", S: "1", E: "5" },
    { id: "e5", T: "Attr", S: "5", E: "6" },
    { id: "e6", T: "Attr", S: "6", E: "7" },
    { id: "e7", T: "Attr", S: "7", E: "8" },
    { id: "e8", T: "Attr", S: "7", E: "9" }
  ]
}