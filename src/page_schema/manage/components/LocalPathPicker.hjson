      E: pick_folders_btn
    }
    {
      id: e_toolbar_clear
      T: Attr
      S: picker_toolbar
      E: clear_btn
    }
    {
      id: e_shell_file_input
      T: Attr
      S: picker_shell
      E: file_input
    }
    {
      id: e_shell_folder_input
      T: Attr
      S: picker_shell
      E: folder_input
    }
    {
