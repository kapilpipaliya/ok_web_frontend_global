    }
    {
      id: "resultTitle"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "h3",
  text: "Result"
};'''
        css:
          '''return `._id {
  margin: 0 0 ${args.theme.var.spacing.sm};
  font-size: 1rem;
  font-weight: 600;
}`;'''
      }
    }
    {
      id: "resultError"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''const err = args.fns.store.lastError;
return {
  as: "pre",
  text: err ? `${err.message}${err.stack ? "\\n\\n" + err.stack : ""}` : "",
  hide: !err
};'''
        css:
          '''return `._id {
  margin: 0;
  padding: ${args.theme.var.spacing.md};
  border-radius: ${args.theme.var.borderRadius.md};
  background: ${args.theme.var.color.error_light_100};
  color: ${args.theme.var.color.error_text};
  font-size: 0.875rem;
  overflow-x: auto;
  white-space: pre-wrap;
  word-break: break-word;
}`;'''
      }
    }
    {
      id: "resultOutput"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        props:
          '''const result = args.fns.store.lastResult;
return {
  as: "pre",
  text: result !== null && result !== undefined ? args.fns.formatResult(result) : "Run a source to see output here.",
  hide: !!args.fns.store.lastError
};'''
        css:
          '''return `._id {
  margin: 0;
  padding: ${args.theme.var.spacing.md};
  border-radius: ${args.theme.var.borderRadius.md};
  background: ${args.theme.var.color.background_dark_900};
  color: ${args.theme.var.color.background_light_900_text};
  font-size: 0.875rem;
  overflow-x: auto;
  white-space: pre-wrap;
  word-break: break-word;
  min-height: 120px;
}`;'''
      }
    }
  ]
