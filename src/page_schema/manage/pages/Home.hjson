{
  vertexes: [
    {
      id: "page1"
      L: Page
      P: {
        key: Home
        url: /manage
        title: Manage
        public: true
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "layout1"
      L: PageLayout
      P: {
        componentName: Layout
        displayOrder: 1
      }
    }
    {
      id: "root"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        fns:
          '''
const DEFAULT_SOURCE = {
  id: "default-modules",
  name: "List modules",
  description: "Returns sorted built-in module names available in args",
  code: 'return Object.keys(args).filter((key) => key !== "require").sort();',
  argsJson: "{}"
};

const loadFromSettings = () => {
  const parseSourcesJson = (raw) => {
    if (typeof raw !== "string" || !raw.trim()) return null;
    try {
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed : null;
    } catch {
      return null;
    }
  };

  const host =
    args.userSetting?.connectionHost ||
    args.userSetting?.connection?.host ||
    "127.0.0.1";
  const port = String(
    args.userSetting?.connectionPort ||
    args.userSetting?.connection?.port ||
    "3000"
  );
  const list =
    parseSourcesJson(args.userSetting?.sourcesJson) ||
    (Array.isArray(args.userSetting?.sources) && args.userSetting.sources.length
      ? args.userSetting.sources
      : null) ||
    [DEFAULT_SOURCE];

  return {
    host,
    port,
    sources: list,
    selectedId: list[0]?.id || DEFAULT_SOURCE.id
  };
};

const [store, setStore] = args.createStore({
  host: "127.0.0.1",
  port: "3000",
  sources: [DEFAULT_SOURCE],
  selectedId: DEFAULT_SOURCE.id,
  name: "",
  description: "",
  code: "",
  argsJson: "{}",
  connectionStatus: "idle",
  connectionMessage: "",
  executing: false,
  lastResult: null,
  lastError: null
});

const persistSettings = () => {
  args.saveUserSetting({
    connectionHost: store.host,
    connectionPort: store.port,
    sourcesJson: JSON.stringify(
      store.sources.map(({ id, name, description, code, argsJson }) => ({
        id,
        name,
        description,
        code,
        argsJson
      }))
    )
  });
};

const getBaseUrl = () => {
  const host = (store.host || "127.0.0.1").trim();
  const port = (store.port || "3000").trim();
  return `http://${host}:${port}`;
};

const getTargetAddressSpace = () => {
  const host = (store.host || "127.0.0.1").trim().toLowerCase();
  if (host === "localhost" || host === "127.0.0.1" || host === "[::1]" || host === "::1") {
    return "loopback";
  }
  return "local";
};

const executeOnServer = async (code, userArgs) => {
  let response;
  try {
    response = await fetch(`${getBaseUrl()}/execute`, {
      method: "POST",
      mode: "cors",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ code, args: userArgs }),
      targetAddressSpace: getTargetAddressSpace()
    });
  } catch (error) {
    throw new Error(
      error instanceof Error
        ? `${error.message}. Run "npm run execute-server" on this PC and allow local network access if Chrome prompts.`
        : String(error)
    );
  }

  let data;
  try {
    data = await response.json();
  } catch {
    throw new Error(`Invalid response from execute server (${response.status})`);
  }

  if (!response.ok || !data.success) {
    const message = data?.error?.message || `Request failed (${response.status})`;
    const err = new Error(message);
    if (data?.error?.stack) err.stack = data.error.stack;
    throw err;
  }
  return data.result;
};

const syncEditorFromSelection = () => {
  const source = store.sources.find((s) => s.id === store.selectedId);
  if (!source) return;
  setStore({
    name: source.name,
    description: source.description || "",
    code: source.code,
    argsJson: source.argsJson || "{}"
  });
};

const selectSource = (id) => {
  setStore("selectedId", id);
  syncEditorFromSelection();
};

const saveCurrentSource = () => {
  const id = store.selectedId;
  const updated = {
    id,
    name: store.name.trim() || "Untitled source",
    description: store.description.trim(),
    code: store.code,
    argsJson: store.argsJson || "{}",
    updatedAt: new Date().toISOString()
  };
  setStore("sources", (sources) => sources.map((s) => (s.id === id ? updated : s)));
  persistSettings();
};

const addSource = () => {
  const id = `source-${Date.now()}`;
  const source = {
    id,
    name: "New source",
    description: "",
    code: 'return "Hello from execute server";',
    argsJson: "{}",
    updatedAt: new Date().toISOString()
  };
  setStore("sources", (sources) => [...sources, source]);
  setStore("selectedId", id);
  syncEditorFromSelection();
  persistSettings();
};

const deleteSource = () => {
  if (store.sources.length <= 1) {
    args.showWarningToast("Keep at least one source");
    return;
  }
  const id = store.selectedId;
  const next = store.sources.filter((s) => s.id !== id);
  setStore("sources", next);
  setStore("selectedId", next[0].id);
  syncEditorFromSelection();
  persistSettings();
  args.showSuccessToast("Source deleted");
};

const parseArgsJson = () => {
  try {
    const parsed = JSON.parse(store.argsJson || "{}");
    if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
      throw new Error("Args must be a JSON object");
    }
    return parsed;
  } catch (error) {
    throw new Error(error instanceof Error ? error.message : "Invalid args JSON");
  }
};

const testConnection = async () => {
  setStore({ connectionStatus: "checking", connectionMessage: "Checking connection..." });
  try {
    const result = await executeOnServer(
      'return { ok: true, modules: Object.keys(args).filter((k) => k !== "require").length };',
      {}
    );
    persistSettings();
    setStore({
      connectionStatus: "online",
      connectionMessage: `Connected — ${result?.modules ?? 0} modules available`
    });
    args.showSuccessToast("Execute server is reachable");
  } catch (error) {
    setStore({
      connectionStatus: "offline",
      connectionMessage: error instanceof Error ? error.message : String(error)
    });
    args.showErrorToast("Cannot reach execute server");
  }
};

const runSelectedSource = async () => {
  setStore({ executing: true, lastResult: null, lastError: null });
  try {
    const userArgs = parseArgsJson();
    saveCurrentSource();
    const result = await executeOnServer(store.code, userArgs);
    setStore({ lastResult: result, lastError: null });
    args.showSuccessToast("Execution completed");
  } catch (error) {
    setStore({
      lastError: {
        message: error instanceof Error ? error.message : String(error),
        stack: error instanceof Error ? error.stack : undefined
      },
      lastResult: null
    });
    args.showErrorToast("Execution failed");
  } finally {
    setStore("executing", false);
  }
};

const initFromSettings = () => {
  const settings = loadFromSettings();
  setStore({
    host: settings.host,
    port: settings.port,
    sources: settings.sources,
    selectedId: settings.selectedId
  });
  syncEditorFromSelection();
};

const formatResult = (value) => {
  if (value === undefined) return "";
  if (typeof value === "string") return value;
  try {
    return JSON.stringify(value, null, 2);
  } catch {
    return String(value);
  }
};

const connectionBadgeClass = () => {
  if (store.connectionStatus === "online") return "online";
  if (store.connectionStatus === "offline") return "offline";
  if (store.connectionStatus === "checking") return "checking";
  return "idle";
};

return {
  store,
  setStore,
  initFromSettings,
  persistSettings,
  getBaseUrl,
  selectSource,
  saveCurrentSource,
  addSource,
  deleteSource,
  testConnection,
  runSelectedSource,
  formatResult,
  connectionBadgeClass
};
'''
        props:
          '''return {
  as: "div",
  onMount: () => {
    args.fns.initFromSettings();
  }
};'''
