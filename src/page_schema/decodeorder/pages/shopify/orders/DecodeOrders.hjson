    const r = await args.fns.executeYTOFunction("getShopifyOrdersWithLineItems", {
      filters: filters.filters || {},
      sort: filters.sort || {}
    });
    if (r?.result?.success && Array.isArray(r.result.data)) return { data: r.result.data };
    return { data: [] };
  }
};'''
