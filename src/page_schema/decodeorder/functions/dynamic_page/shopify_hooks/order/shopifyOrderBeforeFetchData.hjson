{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Syncs Shopify orders, line items, and per-order returns (return line items, refunds on the return, reverse fulfillment orders, exchange line items) before fetching order or line-item tables. Skips Shopify API when loading line items filtered by a single orderId (Neo4j only). ShopifyReturn and ShopifyReturnLineItem tables read graph data populated by this sync (no separate returns hook).
        body:
          '''const { tableVertexLabel, filters = {}, sort = {}, shop: contextShop } = args.contextData;
const isReturnTable = tableVertexLabel === "ShopifyReturn";
const isReturnLineTable = tableVertexLabel === "ShopifyReturnLineItem";
if (isReturnTable || isReturnLineTable) {
  console.log(
    "[shopifyOrderBeforeFetchData] skip Shopify sync (returns are synced when the orders table runs)"
  );
  return;
}
const isOrderTable = tableVertexLabel === "ShopifyOrder";
const isLineTable = tableVertexLabel === "ShopifyOrderLineItem";
if (!isOrderTable && !isLineTable) return;

const hasOrderIdFilter =
  filters &&
  filters.orderId != null &&
  String(filters.orderId).length > 0;
if (isLineTable && hasOrderIdFilter) {
  console.log("[shopifyOrderBeforeFetchData] skip Shopify sync (single-order line items from graph)");
  return;
}

const shop = contextShop || args.shop;
if (!shop) {
  console.warn("shopifyOrderBeforeFetchData: shop is required");
  return;
}

// Map unfulfilled units + sellable line qty → stored fulfillmentStatus (matches nestedSplit.matchStatuses in table config).
const fulfillmentStatusFromRemaining = (remainingUnfulfilledUnits, sellableLineQuantity) => {
  const remaining = Number(remainingUnfulfilledUnits) || 0;
  const qty = Number(sellableLineQuantity) || 0;
  if (remaining <= 0) return "FULFILLED";
  if (qty > 0 && remaining < qty) return "PARTIALLY_FULFILLED";
  return "UNFULFILLED";
};

// Per-line remaining + fulfillmentStatus use only LineItem.unfulfilledQuantity / currentQuantity from GraphQL (no FulfillmentOrder aggregation).

console.log("[shopifyOrderBeforeFetchData] contextData:", { shop, filters, sort });

const shopify = await args.getShopifyClient();
let admin;
try {
  const authResult = await shopify.unauthenticated.admin(shop);
  admin = authResult.admin;
} catch (e) {
  console.log("[shopifyOrderBeforeFetchData] Shopify admin auth failed:", e?.message || e);
  return;
}
if (!admin) {
  console.log("[shopifyOrderBeforeFetchData] no admin client for shop:", shop);
  return;
}

const statusFilter = filters.status || "ALL";
let queryString = "";
if (statusFilter === "UNFULFILLED") queryString = "fulfillment_status:unfulfilled";
else if (statusFilter === "OPEN") queryString = "status:open";
const dateFrom = filters.dateFrom || null;
const dateTo = filters.dateTo || null;
if (dateFrom) queryString = queryString ? queryString + " AND created_at:>=" + dateFrom : "created_at:>=" + dateFrom;
if (dateTo) queryString = queryString ? queryString + " AND created_at:<=" + dateTo : "created_at:<=" + dateTo;
console.log("[shopifyOrderBeforeFetchData] queryString:", queryString || "(none)");

// Bulk orders query must stay under Shopify single-query cost limit (~1000); line items are loaded per order.
const BULK_LINE_ITEMS_FIRST = 15;
const LINE_ITEMS_FIRST = 250;
const ORDERS_PAGE_SIZE = 20;
const RETURNS_BULK_FIRST = 30;
const RETURN_LINES_FIRST = 250;
const RETURN_REFUNDS_FIRST = 50;
const RETURN_RFO_FIRST = 25;
const RETURN_EXCHANGE_FIRST = 50;

