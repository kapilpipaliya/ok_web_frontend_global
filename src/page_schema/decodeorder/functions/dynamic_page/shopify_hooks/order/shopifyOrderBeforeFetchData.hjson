const sortCol = sort && sort.column;
const sortKey =
  sortCol === "orderName" || sortCol === "name" ? "ORDER_NUMBER" : "CREATED_AT";
const reverse = sort.direction === "desc";

let allOrders = [];
let cursor = null;
let hasNextPage = true;
while (hasNextPage) {
  const variables = { first: ORDERS_PAGE_SIZE, query: queryString || null, sortKey, reverse };
  if (cursor) variables.after = cursor;
  if (!cursor) {
    console.log("[shopifyOrderBeforeFetchData] query (copy for manual test):\n", ordersQuery);
    console.log("[shopifyOrderBeforeFetchData] variables:", JSON.stringify(variables, null, 2));
  }
  const response = await admin.graphql(ordersQuery, { variables });
  const apiResponse = response instanceof Response ? await response.json() : response;
  if (!cursor) {
    console.log("[shopifyOrderBeforeFetchData] first page response:", {
      errors: apiResponse.errors,
      edgesCount: apiResponse.data?.orders?.edges?.length ?? 0,
      hasNextPage: apiResponse.data?.orders?.pageInfo?.hasNextPage
    });
  }
  if (apiResponse.errors && apiResponse.errors.length > 0) {
    console.error("[shopifyOrderBeforeFetchData] GraphQL error:", apiResponse.errors[0].message || "unknown");
    return;
  }
  const edges = apiResponse.data?.orders?.edges || [];
  allOrders = allOrders.concat(edges.map((e) => e.node));
  hasNextPage = apiResponse.data?.orders?.pageInfo?.hasNextPage === true;
  cursor = apiResponse.data?.orders?.pageInfo?.endCursor || null;
  if (!cursor) break;
  await new Promise((r) => setTimeout(r, 200));
}
console.log("[shopifyOrderBeforeFetchData] fetched orders:", allOrders.length, "total from API");

const money = (set) => {
  const m = set?.shopMoney;
  return { amount: m?.amount ?? "", currency: m?.currencyCode ?? "" };
};

const safeJson = (v) => {
  try {
    return JSON.stringify(v ?? null);
  } catch (e) {
    return "";
  }
};

const strJoin = (arr) =>
  Array.isArray(arr) ? arr.filter((x) => x != null && x !== "").join(", ") : "";

const session = args.session;
for (const order of allOrders) {
  const orderId = order.id || "";
  const orderName = order.name || "";
  const orderCreatedAt = order.createdAt || "";
  const orderUpdatedAt = order.updatedAt || orderCreatedAt;
  const tagsArr = order.tags;
  const tagsStr = Array.isArray(tagsArr) ? tagsArr.join(", ") : tagsArr || "";
  const sub = money(order.subtotalPriceSet);
  const tot = money(order.totalPriceSet);
  const tax = money(order.totalTaxSet);
  const ship = money(order.totalShippingPriceSet);
  const m = (set) => money(set);
  const cashRound = order.totalCashRoundingAdjustment || {};
  const cashPay = m(cashRound.paymentSet);
  const cashRef = m(cashRound.refundSet);
  let lineNodes;
  let lineItemsFetchErrored = false;
  if (orderId && admin) {
    const lineRes = await fetchAllLineItemNodes(admin, orderId, order.lineItems);
    lineNodes = lineRes.nodes;
    lineItemsFetchErrored = lineRes.fetchErrored;
  } else {
    lineNodes = order.lineItems?.edges?.map((e) => e.node) || [];
  }
  if (lineItemsFetchErrored) {
    console.warn("[shopifyOrderBeforeFetchData] line items list may be incomplete (pagination error)", {
      shop,
      orderId,
      orderName
    });
  }
  if (lineNodes.length >= LINE_ITEMS_FIRST) {
    console.log("[shopifyOrderBeforeFetchData] metric: orderLineItemsCountAtOrAbovePageCap", {
      shop,
      orderId,
      orderName,
      lineItemsCount: lineNodes.length,
      pageCap: LINE_ITEMS_FIRST
    });
  }
  const fullReturnsPayload = [];
  const initialReturnsConn = order.returns;
  const hasReturnHint =
    (Array.isArray(initialReturnsConn?.edges) && initialReturnsConn.edges.length > 0) ||
    initialReturnsConn?.pageInfo?.hasNextPage === true;
  if (orderId && admin && hasReturnHint) {
    const retRes = await fetchAllReturnsForOrder(admin, orderId, order.returns);
    if (retRes.fetchErrored) {
      console.warn("[shopifyOrderBeforeFetchData] returns list may be incomplete for order", orderId, orderName);
    }
    for (const ret of retRes.nodes) {
      const returnGid = ret.id || "";
      if (!returnGid) continue;
      const lineRes = await fetchAllReturnLineNodes(admin, returnGid, null);
      const refundRes = await fetchAllReturnRefundsNodes(admin, returnGid, null);
      const rfoRes = await fetchAllReturnRfoNodes(admin, returnGid, null);
      const exchRes = await fetchAllReturnExchangeNodes(admin, returnGid, null);
      if (lineRes.fetchErrored) {
        console.warn("[shopifyOrderBeforeFetchData] return line items may be incomplete", returnGid);
      }
      if (refundRes.fetchErrored) {
        console.warn("[shopifyOrderBeforeFetchData] return refunds may be incomplete", returnGid);
      }
      if (rfoRes.fetchErrored) {
        console.warn("[shopifyOrderBeforeFetchData] return reverse fulfillment orders may be incomplete", returnGid);
      }
      if (exchRes.fetchErrored) {
        console.warn("[shopifyOrderBeforeFetchData] return exchange line items may be incomplete", returnGid);
      }
      fullReturnsPayload.push({
        id: ret.id,
        name: ret.name,
        status: ret.status,
        createdAt: ret.createdAt,
        closedAt: ret.closedAt,
        requestApprovedAt: ret.requestApprovedAt,
        totalQuantity: ret.totalQuantity,
        staffMember: ret.staffMember,
        returnLineItems: lineRes.nodes,
        refunds: refundRes.nodes,
        reverseFulfillmentOrders: rfoRes.nodes,
        exchangeLineItems: exchRes.nodes
      });
    }
  }
  const orderProps = {
    id: orderId,
    name: orderName,
    createdAt: orderCreatedAt,
    updatedAt: orderUpdatedAt,
    legacyResourceId: order.legacyResourceId != null ? String(order.legacyResourceId) : "",
    orderNumber: order.number != null ? String(order.number) : "",
    confirmationNumber: order.confirmationNumber || "",
    currencyCode: order.currencyCode ? String(order.currencyCode) : "",
    presentmentCurrencyCode: order.presentmentCurrencyCode ? String(order.presentmentCurrencyCode) : "",
    clientIp: order.clientIp || "",
    customerLocale: order.customerLocale || "",
    poNumber: order.poNumber || "",
    sourceName: order.sourceName || "",
    sourceIdentifier: order.sourceIdentifier || "",
    registeredSourceUrl: order.registeredSourceUrl ? String(order.registeredSourceUrl) : "",
    discountCode: order.discountCode || "",
    discountCodes: strJoin(order.discountCodes),
    statusPageUrl: order.statusPageUrl ? String(order.statusPageUrl) : "",
    cancelReason: order.cancelReason != null ? String(order.cancelReason) : "",
    processedAt: order.processedAt || "",
    cancelledAt: order.cancelledAt || "",
    closedAt: order.closedAt || "",
    note: order.note || "",
    tags: tagsStr,
    email: order.email || "",
    phone: order.phone || "",
    displayFulfillmentStatus: order.displayFulfillmentStatus || "",
    displayFinancialStatus: order.displayFinancialStatus || "",
    returnStatus: order.returnStatus != null ? String(order.returnStatus) : "",
    closed: order.closed === true,
    confirmed: order.confirmed === true,
    edited: order.edited === true,
    fulfillable: order.fulfillable === true,
    refundable: order.refundable === true,
    restockable: order.restockable === true,
    requiresShipping: order.requiresShipping === true,
    unpaid: order.unpaid === true,
    fullyPaid: order.fullyPaid === true,
    capturable: order.capturable === true,
    canMarkAsPaid: order.canMarkAsPaid === true,
    canNotifyCustomer: order.canNotifyCustomer === true,
    billingAddressMatchesShippingAddress: order.billingAddressMatchesShippingAddress === true,
    customerAcceptsMarketing: order.customerAcceptsMarketing === true,
    productNetwork: order.productNetwork === true,
    hasTimelineComment: order.hasTimelineComment === true,
    merchantEditable: order.merchantEditable === true,
    merchantEditableErrors: strJoin(order.merchantEditableErrors),
    taxesIncluded: order.taxesIncluded === true,
    taxExempt: order.taxExempt === true,
    dutiesIncluded: order.dutiesIncluded === true,
    estimatedTaxes: order.estimatedTaxes === true,
    testOrder: order.test === true,
    subtotalLineItemsQuantity: order.subtotalLineItemsQuantity != null ? Number(order.subtotalLineItemsQuantity) : 0,
    currentSubtotalLineItemsQuantity:
      order.currentSubtotalLineItemsQuantity != null ? Number(order.currentSubtotalLineItemsQuantity) : 0,
    currentTotalWeight: order.currentTotalWeight != null ? String(order.currentTotalWeight) : "",
    totalWeight: order.totalWeight != null ? String(order.totalWeight) : "",
    cancellationStaffNote: order.cancellation?.staffNote || "",
    customerGraphId: order.customer?.id || "",
    customerDisplayName: order.customer?.displayName || "",
    customerEmail: order.customer?.email || "",
    customerPhone: order.customer?.phone || "",
    appName: order.app?.name || "",
    merchantOfRecordAppName: order.merchantOfRecordApp?.name || "",
    businessEntityId: order.merchantBusinessEntity?.id || "",
    businessEntityDisplayName: order.merchantBusinessEntity?.displayName || "",
    businessEntityCompanyName: order.merchantBusinessEntity?.companyName || "",
    businessEntityPrimary: order.merchantBusinessEntity?.primary === true,
    orderStaffMemberId: order.orderStaffMember?.id || "",
    orderStaffMemberName: order.orderStaffMember?.name || "",
    orderStaffMemberEmail: order.orderStaffMember?.email || "",
    channelName: order.channelInformation?.channelDefinition?.channelName || "",
    channelHandle: order.channelInformation?.channelDefinition?.handle || "",
    fulfillmentsTotalCount: order.fulfillmentsCount?.count != null ? String(order.fulfillmentsCount.count) : "",
    transactionsTotalCount: order.transactionsCount?.count != null ? String(order.transactionsCount.count) : "",
    shopifyProtectStatus: order.shopifyProtect?.status != null ? String(order.shopifyProtect.status) : "",
    riskRecommendation: order.risk?.recommendation != null ? String(order.risk.recommendation) : "",
    paymentGatewayNames: strJoin(order.paymentGatewayNames),
    publicationName: order.publication?.name || "",
    publicationId: order.publication?.id || "",
    retailLocationName: order.retailLocation?.name || "",
    retailLocationId: order.retailLocation?.id || "",
    paymentTermsId: order.paymentTerms?.id || "",
    additionalPaymentCollectionUrl: order.paymentCollectionDetails?.additionalPaymentCollectionUrl
      ? String(order.paymentCollectionDetails.additionalPaymentCollectionUrl)
      : "",
    journeyReady: order.customerJourneySummary?.ready === true,
    journeyCustomerOrderIndex:
      order.customerJourneySummary?.customerOrderIndex != null
        ? Number(order.customerJourneySummary.customerOrderIndex)
        : "",
    journeyDaysToConversion:
      order.customerJourneySummary?.daysToConversion != null
        ? Number(order.customerJourneySummary.daysToConversion)
        : "",
    journeyMomentsCount:
      order.customerJourneySummary?.momentsCount?.count != null
        ? String(order.customerJourneySummary.momentsCount.count)
        : "",
    cashRoundingPaymentAmount: cashPay.amount,
    cashRoundingPaymentCurrency: cashPay.currency,
    cashRoundingRefundAmount: cashRef.amount,
    cashRoundingRefundCurrency: cashRef.currency,
    subtotalAmount: sub.amount,
    subtotalCurrency: sub.currency,
    originalTotalPriceAmount: m(order.originalTotalPriceSet).amount,
    originalTotalPriceCurrency: m(order.originalTotalPriceSet).currency,
    currentTotalPriceAmount: m(order.currentTotalPriceSet).amount,
    currentTotalPriceCurrency: m(order.currentTotalPriceSet).currency,
    totalPriceAmount: tot.amount,
    totalPriceCurrency: tot.currency,
    currentSubtotalPriceAmount: m(order.currentSubtotalPriceSet).amount,
    currentSubtotalPriceCurrency: m(order.currentSubtotalPriceSet).currency,
    cartDiscountAmount: m(order.cartDiscountAmountSet).amount,
    cartDiscountCurrency: m(order.cartDiscountAmountSet).currency,
    currentCartDiscountAmount: m(order.currentCartDiscountAmountSet).amount,
    currentCartDiscountCurrency: m(order.currentCartDiscountAmountSet).currency,
    totalDiscountsAmount: m(order.totalDiscountsSet).amount,
    totalDiscountsCurrency: m(order.totalDiscountsSet).currency,
    currentTotalDiscountsAmount: m(order.currentTotalDiscountsSet).amount,
    currentTotalDiscountsCurrency: m(order.currentTotalDiscountsSet).currency,
    totalTaxAmount: tax.amount,
    totalTaxCurrency: tax.currency,
    currentTotalTaxAmount: m(order.currentTotalTaxSet).amount,
    currentTotalTaxCurrency: m(order.currentTotalTaxSet).currency,
    totalShippingAmount: ship.amount,
    totalShippingCurrency: ship.currency,
    currentShippingPriceAmount: m(order.currentShippingPriceSet).amount,
    currentShippingPriceCurrency: m(order.currentShippingPriceSet).currency,
    netPaymentAmount: m(order.netPaymentSet).amount,
    netPaymentCurrency: m(order.netPaymentSet).currency,
    totalOutstandingAmount: m(order.totalOutstandingSet).amount,
    totalOutstandingCurrency: m(order.totalOutstandingSet).currency,
    totalReceivedAmount: m(order.totalReceivedSet).amount,
    totalReceivedCurrency: m(order.totalReceivedSet).currency,
    totalRefundedAmount: m(order.totalRefundedSet).amount,
    totalRefundedCurrency: m(order.totalRefundedSet).currency,
    totalRefundedShippingAmount: m(order.totalRefundedShippingSet).amount,
    totalRefundedShippingCurrency: m(order.totalRefundedShippingSet).currency,
    totalTipReceivedAmount: m(order.totalTipReceivedSet).amount,
    totalTipReceivedCurrency: m(order.totalTipReceivedSet).currency,
    totalCapturableAmount: m(order.totalCapturableSet).amount,
    totalCapturableCurrency: m(order.totalCapturableSet).currency,
    refundDiscrepancyAmount: m(order.refundDiscrepancySet).amount,
    refundDiscrepancyCurrency: m(order.refundDiscrepancySet).currency,
    originalTotalAdditionalFeesAmount: m(order.originalTotalAdditionalFeesSet).amount,
    originalTotalAdditionalFeesCurrency: m(order.originalTotalAdditionalFeesSet).currency,
    currentTotalAdditionalFeesAmount: m(order.currentTotalAdditionalFeesSet).amount,
    currentTotalAdditionalFeesCurrency: m(order.currentTotalAdditionalFeesSet).currency,
    originalTotalDutiesAmount: m(order.originalTotalDutiesSet).amount,
    originalTotalDutiesCurrency: m(order.originalTotalDutiesSet).currency,
    currentTotalDutiesAmount: m(order.currentTotalDutiesSet).amount,
    currentTotalDutiesCurrency: m(order.currentTotalDutiesSet).currency,
    lineItemsCount: lineNodes.length,
    billingAddressJson: safeJson(order.billingAddress),
    shippingAddressJson: safeJson(order.shippingAddress),
    displayAddressJson: safeJson(order.displayAddress),
    customAttributesJson: safeJson(order.customAttributes),
    taxLinesJson: safeJson(order.taxLines),
    currentTaxLinesJson: safeJson(order.currentTaxLines),
    additionalFeesJson: safeJson(order.additionalFees),
    agreementsJson: safeJson(order.agreements),
    discountApplicationsJson: safeJson(order.discountApplications),
    disputesJson: safeJson(order.disputes),
    alertsJson: safeJson(order.alerts),
    eventsJson: safeJson(order.events),
    fulfillmentOrdersJson: safeJson(order.fulfillmentOrders),
    fulfillmentsJson: safeJson(order.fulfillments),
    nonFulfillableLineItemsJson: safeJson(order.nonFulfillableLineItems),
    localizedFieldsJson: safeJson(order.localizedFields),
    metafieldsJson: safeJson(order.metafields),
    refundsJson: safeJson(order.refunds),
    returnsCount: fullReturnsPayload.length,
    returnsJson: safeJson(fullReturnsPayload),
    riskJson: safeJson(order.risk),
    shippingLineJson: safeJson(order.shippingLine),
    shippingLinesJson: safeJson(order.shippingLines),
    transactionsJson: safeJson(order.transactions),
    customerJson: safeJson(order.customer),
    customerJourneySummaryJson: safeJson(order.customerJourneySummary),
    channelInformationJson: safeJson(order.channelInformation),
    purchasingEntityJson: safeJson(order.purchasingEntity),
    paymentCollectionDetailsJson: safeJson(order.paymentCollectionDetails),
    paymentTermsJson: safeJson(order.paymentTerms),
    publicationJson: safeJson(order.publication),
    retailLocationJson: safeJson(order.retailLocation),
    totalCashRoundingAdjustmentJson: safeJson(order.totalCashRoundingAdjustment)
  };

  await session.run(`MERGE (o:ShopifyOrder { id: $id })
   SET o += $props`, {
    id: orderId,
    props: orderProps
  });
  for (let idx = 0; idx < lineNodes.length; idx++) {
    const node = lineNodes[idx];
    const lineItemId = node.id || orderId + "-" + idx;
    const attrs = node.customAttributes || [];
    const propertiesText = attrs.map((a) => (a.key || "") + ": " + (a.value || "")).filter(Boolean).join(" | ");
    const variantTitle = node.variant && node.variant.title ? node.variant.title : "";
    const variantSku = node.variant?.sku || "";
    const variantId = node.variant?.id || "";
    const productId = node.product?.id || "";
    const lineImageUrl =
      (node.image && node.image.url) ||
      (node.variant && node.variant.image && node.variant.image.url) ||
      (node.product && node.product.featuredImage && node.product.featuredImage.url) ||
      "";
    const ou = money(node.originalUnitPriceSet);
    const du = money(node.discountedUnitPriceSet);
    const dua = money(node.discountedUnitPriceAfterAllDiscountsSet);
    const ot = money(node.originalTotalSet);
    const dt = money(node.discountedTotalSet);
    const dtc = money(node.discountedTotalSetWithCodeDiscounts);
    const td = money(node.totalDiscountSet);
    const uot = money(node.unfulfilledOriginalTotalSet);
    const udt = money(node.unfulfilledDiscountedTotalSet);
    const quantityOrdered = Number(node.quantity ?? 0);
    const currentQty =
      node.currentQuantity != null && node.currentQuantity !== undefined
        ? Number(node.currentQuantity)
        : quantityOrdered;
    const remainingQuantity = Number(node.unfulfilledQuantity) || 0;
    const fulfillmentStatus = fulfillmentStatusFromRemaining(remainingQuantity, currentQty);
    await session.run(
      `MERGE (o:ShopifyOrder { id: $orderId })
       MERGE (li:ShopifyOrderLineItem { id: $lineItemId })
       SET li.orderId = $orderId,
           li.orderName = $orderName,
           li.orderCreatedAt = $orderCreatedAt,
           li.lineItemName = $lineItemName,
           li.productTitle = $productTitle,
           li.productGraphId = $productGraphId,
           li.variantGraphId = $variantGraphId,
           li.variantTitle = $variantTitle,
           li.variantSku = $variantSku,
           li.sku = $sku,
           li.vendor = $vendor,
           li.quantity = $quantity,
           li.currentQuantity = $currentQuantity,
           li.refundableQuantity = $refundableQuantity,
           li.nonFulfillableQuantity = $nonFulfillableQuantity,
           li.isGiftCard = $isGiftCard,
           li.merchantEditable = $merchantEditable,
           li.requiresShipping = $requiresShipping,
           li.restockable = $restockable,
           li.taxable = $taxable,
           li.remainingQuantity = $remainingQuantity,
           li.properties = $properties,
           li.fulfillmentStatus = $fulfillmentStatus,
           li.originalUnitAmount = $originalUnitAmount,
           li.originalUnitCurrency = $originalUnitCurrency,
           li.discountedUnitAmount = $discountedUnitAmount,
           li.discountedUnitCurrency = $discountedUnitCurrency,
           li.discountedUnitAfterAllAmount = $discountedUnitAfterAllAmount,
           li.discountedUnitAfterAllCurrency = $discountedUnitAfterAllCurrency,
           li.originalTotalAmount = $originalTotalAmount,
           li.originalTotalCurrency = $originalTotalCurrency,
           li.discountedTotalAmount = $discountedTotalAmount,
           li.discountedTotalCurrency = $discountedTotalCurrency,
           li.discountedTotalCodeAmount = $discountedTotalCodeAmount,
           li.discountedTotalCodeCurrency = $discountedTotalCodeCurrency,
           li.totalDiscountAmount = $totalDiscountAmount,
           li.totalDiscountCurrency = $totalDiscountCurrency,
           li.unfulfilledOriginalTotalAmount = $unfulfilledOriginalTotalAmount,
           li.unfulfilledOriginalTotalCurrency = $unfulfilledOriginalTotalCurrency,
           li.unfulfilledDiscountedTotalAmount = $unfulfilledDiscountedTotalAmount,
           li.unfulfilledDiscountedTotalCurrency = $unfulfilledDiscountedTotalCurrency,
           li.subscriptionContractId = $subscriptionContractId,
           li.subscriptionContractStatus = $subscriptionContractStatus,
           li.staffMemberId = $staffMemberId,
