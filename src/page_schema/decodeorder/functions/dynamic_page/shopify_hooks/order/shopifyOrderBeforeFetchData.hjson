           li.lineImageUrl = $lineImageUrl
       MERGE (o)-[:HAS_LINE_ITEM]->(li)`,
      {
        orderId,
        lineItemId,
        orderName,
        orderCreatedAt,
        lineItemName: node.name || node.title || "",
        productTitle: node.title || "",
        productGraphId: productId,
        variantGraphId: variantId,
        variantTitle,
        variantSku,
        sku: node.sku || "",
        vendor: node.vendor || "",
        quantity: quantityOrdered,
        currentQuantity: currentQty,
        refundableQuantity: Number(node.refundableQuantity ?? 0),
        nonFulfillableQuantity: Number(node.nonFulfillableQuantity ?? 0),
