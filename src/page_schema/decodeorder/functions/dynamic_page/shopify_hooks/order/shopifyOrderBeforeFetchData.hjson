        discountedUnitAfterAllAmount: dua.amount,
        discountedUnitAfterAllCurrency: dua.currency,
        originalTotalAmount: ot.amount,
        originalTotalCurrency: ot.currency,
        discountedTotalAmount: dt.amount,
        discountedTotalCurrency: dt.currency,
        discountedTotalCodeAmount: dtc.amount,
        discountedTotalCodeCurrency: dtc.currency,
        totalDiscountAmount: td.amount,
        totalDiscountCurrency: td.currency,
        unfulfilledOriginalTotalAmount: uot.amount,
        unfulfilledOriginalTotalCurrency: uot.currency,
        unfulfilledDiscountedTotalAmount: udt.amount,
        unfulfilledDiscountedTotalCurrency: udt.currency,
        subscriptionContractId: node.contract?.id || "",
        subscriptionContractStatus: node.contract?.status ? String(node.contract.status) : "",
        staffMemberId: node.staffMember?.id || "",
        staffMemberName: node.staffMember?.name || "",
        staffMemberEmail: node.staffMember?.email || "",
        customAttributesJson: safeJson(attrs),
        discountAllocationsJson: safeJson(node.discountAllocations),
        dutiesJson: safeJson(node.duties),
