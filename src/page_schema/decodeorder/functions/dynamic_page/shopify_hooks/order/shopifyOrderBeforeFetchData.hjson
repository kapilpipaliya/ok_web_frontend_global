const fetchAllReturnsForOrder = async (adminClient, orderGid, initialReturns) => {
  const nodes = [];
  let fetchErrored = false;
  let nextAfter;
  const ir = initialReturns || { edges: [], pageInfo: {} };
  if (ir.edges && ir.edges.length > 0) {
    for (const e of ir.edges) {
      if (e?.node) nodes.push(e.node);
    }
    if (ir.pageInfo?.hasNextPage === true && ir.pageInfo.endCursor) {
      nextAfter = ir.pageInfo.endCursor;
    } else {
      nextAfter = false;
    }
  } else if (ir.pageInfo?.hasNextPage === true && ir.pageInfo.endCursor) {
    nextAfter = ir.pageInfo.endCursor;
  } else {
    nextAfter = null;
  }
  while (nextAfter !== false) {
    await new Promise((r) => setTimeout(r, 150));
    const resp = await adminClient.graphql(orderReturnsPageQuery, {
      variables: { orderId: orderGid, first: RETURNS_BULK_FIRST, after: nextAfter === null ? null : nextAfter }
    });
    const json = resp instanceof Response ? await resp.json() : resp;
    if (json.errors && json.errors.length > 0) {
      fetchErrored = true;
      console.error(
        "[shopifyOrderBeforeFetchData] order returns pagination error:",
        orderGid,
        json.errors[0]?.message || json.errors[0]
      );
      break;
    }
    const page = json.data?.order?.returns;
    if (!page) {
      fetchErrored = true;
      break;
    }
    for (const e of page.edges || []) {
      if (e?.node) nodes.push(e.node);
    }
    if (page.pageInfo?.hasNextPage === true && page.pageInfo.endCursor) {
      nextAfter = page.pageInfo.endCursor;
    } else {
      nextAfter = false;
    }
    if (page.pageInfo?.hasNextPage === true && !page.pageInfo.endCursor) {
      console.warn("[shopifyOrderBeforeFetchData] returns hasNextPage but no endCursor", orderGid);
      nextAfter = false;
    }
  }
  return { nodes, fetchErrored };
};

const fetchAllReturnLineNodes = async (adminClient, returnGid, initialConn) => {
  const nodes = [];
  let fetchErrored = false;
  let nextAfter;
  if (initialConn == null) {
    nextAfter = null;
  } else if (initialConn.edges && initialConn.edges.length > 0) {
    for (const e of initialConn.edges) {
      if (e?.node && e.node.__typename === "ReturnLineItem") nodes.push(e.node);
    }
    if (initialConn.pageInfo?.hasNextPage === true && initialConn.pageInfo.endCursor) {
      nextAfter = initialConn.pageInfo.endCursor;
    } else {
      nextAfter = false;
    }
  } else if (initialConn.pageInfo?.hasNextPage === true && initialConn.pageInfo.endCursor) {
    nextAfter = initialConn.pageInfo.endCursor;
  } else {
    nextAfter = false;
  }
  while (nextAfter !== false) {
    await new Promise((r) => setTimeout(r, 150));
    const resp = await adminClient.graphql(returnLineItemsPageQuery, {
      variables: { returnId: returnGid, first: RETURN_LINES_FIRST, after: nextAfter === null ? null : nextAfter }
    });
    const json = resp instanceof Response ? await resp.json() : resp;
    if (json.errors && json.errors.length > 0) {
      fetchErrored = true;
      console.error(
        "[shopifyOrderBeforeFetchData] returnLineItems pagination error:",
        returnGid,
        json.errors[0]?.message || json.errors[0]
      );
      break;
    }
    const page = json.data?.return?.returnLineItems;
    if (!page) {
      fetchErrored = true;
      break;
    }
    for (const e of page.edges || []) {
      const n = e?.node;
      if (n && n.__typename === "ReturnLineItem") nodes.push(n);
    }
    if (page.pageInfo?.hasNextPage === true && page.pageInfo.endCursor) {
      nextAfter = page.pageInfo.endCursor;
    } else {
      nextAfter = false;
    }
    if (page.pageInfo?.hasNextPage === true && !page.pageInfo.endCursor) {
      console.warn("[shopifyOrderBeforeFetchData] returnLineItems hasNextPage but no endCursor", returnGid);
      nextAfter = false;
    }
  }
  return { nodes, fetchErrored };
};

const fetchAllReturnRefundsNodes = async (adminClient, returnGid, initialConn) => {
  const nodes = [];
  let fetchErrored = false;
  let nextAfter;
  if (initialConn == null) {
    nextAfter = null;
  } else if (initialConn.edges && initialConn.edges.length > 0) {
    for (const e of initialConn.edges) {
      if (e?.node) nodes.push(e.node);
    }
    if (initialConn.pageInfo?.hasNextPage === true && initialConn.pageInfo.endCursor) {
      nextAfter = initialConn.pageInfo.endCursor;
    } else {
      nextAfter = false;
    }
  } else if (initialConn.pageInfo?.hasNextPage === true && initialConn.pageInfo.endCursor) {
    nextAfter = initialConn.pageInfo.endCursor;
  } else {
    nextAfter = false;
  }
  while (nextAfter !== false) {
    await new Promise((r) => setTimeout(r, 150));
    const resp = await adminClient.graphql(returnRefundsPageQuery, {
      variables: { returnId: returnGid, first: RETURN_REFUNDS_FIRST, after: nextAfter === null ? null : nextAfter }
    });
    const json = resp instanceof Response ? await resp.json() : resp;
    if (json.errors && json.errors.length > 0) {
      fetchErrored = true;
      console.error(
        "[shopifyOrderBeforeFetchData] return refunds pagination error:",
        returnGid,
        json.errors[0]?.message || json.errors[0]
      );
      break;
    }
    const page = json.data?.return?.refunds;
    if (!page) {
      fetchErrored = true;
      break;
    }
    for (const e of page.edges || []) {
      if (e?.node) nodes.push(e.node);
    }
    if (page.pageInfo?.hasNextPage === true && page.pageInfo.endCursor) {
      nextAfter = page.pageInfo.endCursor;
    } else {
      nextAfter = false;
    }
    if (page.pageInfo?.hasNextPage === true && !page.pageInfo.endCursor) {
      console.warn("[shopifyOrderBeforeFetchData] return refunds hasNextPage but no endCursor", returnGid);
      nextAfter = false;
    }
  }
  return { nodes, fetchErrored };
};

