  }
  for (let ridx = 0; ridx < fullReturnsPayload.length; ridx++) {
    const payload = fullReturnsPayload[ridx];
    const returnId = payload.id || "";
    if (!returnId) continue;
    const staff = payload.staffMember || {};
    const returnProps = {
      id: returnId,
      name: payload.name || "",
      status: payload.status ? String(payload.status) : "",
      createdAt: payload.createdAt || "",
      closedAt: payload.closedAt || "",
      requestApprovedAt: payload.requestApprovedAt || "",
      totalQuantity: payload.totalQuantity != null ? Number(payload.totalQuantity) : 0,
      orderId,
      orderName,
      staffMemberId: staff.id || "",
      staffMemberName: staff.name || "",
      refundsJson: safeJson(payload.refunds),
      reverseFulfillmentOrdersJson: safeJson(payload.reverseFulfillmentOrders),
      exchangeLineItemsJson: safeJson(payload.exchangeLineItems),
      returnLineItemsJson: safeJson(payload.returnLineItems)
    };
    await session.run(
      `MERGE (o:ShopifyOrder { id: $orderId })
       MERGE (r:ShopifyReturn { id: $returnId })
       SET r += $props
       MERGE (o)-[:HAS_RETURN]->(r)`,
      { orderId, returnId, props: returnProps }
    );
    for (let idx = 0; idx < payload.returnLineItems.length; idx++) {
      const node = payload.returnLineItems[idx];
      const lineItemId = node.id || returnId + "-line-" + idx;
      const li = node.fulfillmentLineItem?.lineItem || {};
      const lineTitle = li.title || li.name || "";
      const pt = money(node.withCodeDiscountedTotalPriceSet);
      const lineProps = {
        id: lineItemId,
        returnId,
        returnName: returnProps.name,
        orderId,
        orderName,
        quantity: node.quantity != null ? Number(node.quantity) : 0,
        processableQuantity: node.processableQuantity != null ? Number(node.processableQuantity) : 0,
        processedQuantity: node.processedQuantity != null ? Number(node.processedQuantity) : 0,
        refundableQuantity: node.refundableQuantity != null ? Number(node.refundableQuantity) : 0,
        refundedQuantity: node.refundedQuantity != null ? Number(node.refundedQuantity) : 0,
        unprocessedQuantity: node.unprocessedQuantity != null ? Number(node.unprocessedQuantity) : 0,
        customerNote: node.customerNote || "",
        returnReasonNote: node.returnReasonNote || "",
        lineTotalAmount: pt.amount,
        lineTotalCurrency: pt.currency,
        lineItemGraphId: li.id || "",
        lineItemTitle: lineTitle
      };
      await session.run(
        `MERGE (li:ShopifyReturnLineItem { id: $lineItemId })
         SET li += $lineProps`,
        { lineItemId, lineProps }
      );
    }
  }
}
