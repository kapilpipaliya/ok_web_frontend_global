{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Syncs Shopify orders and line items before fetching order or line-item tables. Skips Shopify API when loading line items filtered by a single orderId (Neo4j only).
        body:
          '''const { tableVertexLabel, filters = {}, sort = {}, shop: contextShop } = args.contextData;
const isOrderTable = tableVertexLabel === "ShopifyOrder";
const isLineTable = tableVertexLabel === "ShopifyOrderLineItem";
if (!isOrderTable && !isLineTable) return;

const hasOrderIdFilter =
  filters &&
  filters.orderId != null &&
  String(filters.orderId).length > 0;
if (isLineTable && hasOrderIdFilter) {
  console.log("[shopifyOrderBeforeFetchData] skip Shopify sync (single-order line items from graph)");
  return;
}

const shop = contextShop || args.shop;
if (!shop) {
  console.warn("shopifyOrderBeforeFetchData: shop is required");
  return;
}

// Derive fulfillment status from FulfillmentOrderLineItem.remainingQuantity.
const fulfillmentStatusFromRemaining = (remainingQuantity, quantity) => {
  const remaining = Number(remainingQuantity) || 0;
  const qty = Number(quantity) || 0;
  if (remaining <= 0) return "FULFILLED";
  if (qty > 0 && remaining < qty) return "PARTIALLY_FULFILLED";
  return "UNFULFILLED";
};

// Sum FulfillmentOrderLineItem.remainingQuantity per LineItem id (same line split across multiple FOs adds up).
// No fulfillmentOrders → empty map → caller uses order line quantity as remaining (nothing allocated to FO yet).
const getRemainingByLineItemId = (order) => {
  const map = {};
  const fos = order.fulfillmentOrders?.edges || [];
  for (const foEdge of fos) {
    const items = foEdge.node?.lineItems?.edges || [];
    for (const edge of items) {
      const node = edge.node;
      const id = node?.lineItem?.id;
      if (id) map[id] = (map[id] || 0) + (Number(node.remainingQuantity) || 0);
    }
  }
  return map;
};

const logFoPartialCoverage = (orderId, orderName, lineNodes, remainingByLineId, foEdgeCount) => {
  if (foEdgeCount <= 0 || !lineNodes?.length) return;
  let linesWithFoAggregate = 0;
  let linesDefaultingToQty = 0;
  for (const node of lineNodes) {
    const id = node.id;
    if (!id) continue;
    const agg = remainingByLineId[id];
    if (agg !== undefined && agg !== null) linesWithFoAggregate++;
    else linesDefaultingToQty++;
  }
  if (linesDefaultingToQty > 0) {
    console.log("[shopifyOrderBeforeFetchData] FO partial coverage: some line items not in FO aggregate (using order qty as remaining)", {
      orderId,
      orderName,
      fulfillmentOrderCount: foEdgeCount,
      lineItemsWithFoRemainingSum: linesWithFoAggregate,
      lineItemsMissingFromFoMap: linesDefaultingToQty
    });
  }
};

console.log("[shopifyOrderBeforeFetchData] contextData:", { shop, filters, sort });

const shopify = await args.getShopifyClient();
let admin;
try {
  const authResult = await shopify.unauthenticated.admin(shop);
  admin = authResult.admin;
} catch (e) {
  console.log("[shopifyOrderBeforeFetchData] Shopify admin auth failed:", e?.message || e);
  return;
}
if (!admin) {
  console.log("[shopifyOrderBeforeFetchData] no admin client for shop:", shop);
  return;
}

const statusFilter = filters.status || "ALL";
let queryString = "";
if (statusFilter === "UNFULFILLED") queryString = "fulfillment_status:unfulfilled";
else if (statusFilter === "OPEN") queryString = "status:open";
const dateFrom = filters.dateFrom || null;
const dateTo = filters.dateTo || null;
if (dateFrom) queryString = queryString ? queryString + " AND created_at:>=" + dateFrom : "created_at:>=" + dateFrom;
if (dateTo) queryString = queryString ? queryString + " AND created_at:<=" + dateTo : "created_at:<=" + dateTo;
console.log("[shopifyOrderBeforeFetchData] queryString:", queryString || "(none)");

// Bulk orders query must stay under Shopify single-query cost limit (~1000); line items + FOs are loaded per order.
const BULK_LINE_ITEMS_FIRST = 50;
const LINE_ITEMS_FIRST = 250;
const FULFILLMENT_ORDERS_FIRST = 250;
const FULFILLMENT_LINE_ITEMS_FIRST = 250;
const ORDERS_PAGE_SIZE = 25;

const LINE_ITEM_NODE_FIELDS = `
                id
                name
                title
                quantity
                sku
                vendor
                originalUnitPriceSet { shopMoney { amount currencyCode } }
                discountedUnitPriceSet { shopMoney { amount currencyCode } }
                originalTotalSet { shopMoney { amount currencyCode } }
                discountedTotalSet { shopMoney { amount currencyCode } }
                variant {
                  id
                  title
                  sku
                }
                product {
                  id
                  title
                }
                customAttributes {
                  key
                  value
                }`;

const ordersQuery =
  `
  query getOrders($first: Int!, $query: String, $sortKey: OrderSortKeys, $reverse: Boolean) {
    orders(first: $first, query: $query, sortKey: $sortKey, reverse: $reverse) {
      edges {
        node {
          id
          name
          createdAt
          updatedAt
          displayFulfillmentStatus
          displayFinancialStatus
          email
          phone
          processedAt
          cancelledAt
          closed
          note
          tags
          subtotalPriceSet { shopMoney { amount currencyCode } }
          totalPriceSet { shopMoney { amount currencyCode } }
          totalTaxSet { shopMoney { amount currencyCode } }
          totalShippingPriceSet { shopMoney { amount currencyCode } }
          taxesIncluded
          fullyPaid
          test
          lineItems(first: ` +
  BULK_LINE_ITEMS_FIRST +
  `) {
            pageInfo {
              hasNextPage
              endCursor
            }
            edges {
              node {` +
  LINE_ITEM_NODE_FIELDS +
  `
              }
            }
          }
        }
      }
      pageInfo {
        hasNextPage
        endCursor
      }
    }
  }`.trim();

const orderLineItemsPageQuery =
  `
  query OrderLineItemsPage($orderId: ID!, $first: Int!, $after: String) {
    order(id: $orderId) {
      lineItems(first: $first, after: $after) {
        pageInfo {
          hasNextPage
          endCursor
        }
        edges {
          node {` +
  LINE_ITEM_NODE_FIELDS +
  `
          }
        }
      }
    }
  }`.trim();

const orderFulfillmentOrdersPageQuery =
  `
  query OrderFulfillmentOrdersPage($orderId: ID!, $first: Int!, $after: String) {
    order(id: $orderId) {
      fulfillmentOrders(first: $first, after: $after) {
        pageInfo {
          hasNextPage
          endCursor
        }
        edges {
          node {
            id
            lineItems(first: ` +
  FULFILLMENT_LINE_ITEMS_FIRST +
  `) {
              pageInfo {
                hasNextPage
                endCursor
              }
              edges {
                node {
                  remainingQuantity
                  lineItem {
                    id
                  }
                }
              }
            }
          }
        }
      }
    }
  }`.trim();

const fulfillmentOrderLineItemsPageQuery =
  `
  query FulfillmentOrderLineItemsPage($id: ID!, $first: Int!, $after: String) {
    node(id: $id) {
      ... on FulfillmentOrder {
        lineItems(first: $first, after: $after) {
          pageInfo {
            hasNextPage
            endCursor
          }
          edges {
            node {
              remainingQuantity
              lineItem {
                id
              }
            }
          }
        }
      }
    }
  }`.trim();

const fetchAllFulfillmentOrderLineItemEdges = async (adminClient, foGid, initialLineItems) => {
  const edgesOut = [];
  let nextAfter;
  if (initialLineItems?.edges?.length > 0) {
    for (const e of initialLineItems.edges) edgesOut.push(e);
    if (initialLineItems.pageInfo?.hasNextPage === true && initialLineItems.pageInfo.endCursor) {
      nextAfter = initialLineItems.pageInfo.endCursor;
    } else {
      nextAfter = false;
    }
  } else {
    nextAfter = null;
  }
  while (nextAfter !== false) {
    await new Promise((r) => setTimeout(r, 150));
    const resp = await adminClient.graphql(fulfillmentOrderLineItemsPageQuery, {
      variables: { id: foGid, first: FULFILLMENT_LINE_ITEMS_FIRST, after: nextAfter }
    });
    const json = resp instanceof Response ? await resp.json() : resp;
    if (json.errors && json.errors.length > 0) {
      console.error(
        "[shopifyOrderBeforeFetchData] fulfillmentOrder lineItems pagination error:",
        foGid,
        json.errors[0]?.message || json.errors[0]
      );
      break;
    }
    const page = json.data?.node?.lineItems;
    if (!page) break;
    for (const e of page.edges || []) edgesOut.push(e);
    if (page.pageInfo?.hasNextPage === true && page.pageInfo.endCursor) {
      nextAfter = page.pageInfo.endCursor;
    } else {
      nextAfter = false;
    }
    if (page.pageInfo?.hasNextPage === true && !page.pageInfo.endCursor) {
      console.warn("[shopifyOrderBeforeFetchData] FO lineItems hasNextPage but no endCursor", foGid);
      nextAfter = false;
    }
  }
  return edgesOut;
};

const fetchAllFulfillmentOrdersForOrder = async (adminClient, orderGid, initialFulfillmentOrders) => {
  const foEdges = [];
  let fetchErrored = false;
  let nextAfter;
  if (initialFulfillmentOrders?.edges?.length > 0) {
    for (const e of initialFulfillmentOrders.edges) foEdges.push(e);
    if (initialFulfillmentOrders.pageInfo?.hasNextPage === true && initialFulfillmentOrders.pageInfo.endCursor) {
      nextAfter = initialFulfillmentOrders.pageInfo.endCursor;
    } else {
      nextAfter = false;
    }
  } else {
    nextAfter = null;
  }
  while (nextAfter !== false) {
    await new Promise((r) => setTimeout(r, 150));
    const resp = await adminClient.graphql(orderFulfillmentOrdersPageQuery, {
      variables: { orderId: orderGid, first: FULFILLMENT_ORDERS_FIRST, after: nextAfter }
    });
    const json = resp instanceof Response ? await resp.json() : resp;
    if (json.errors && json.errors.length > 0) {
      fetchErrored = true;
      console.error(
        "[shopifyOrderBeforeFetchData] order fulfillmentOrders pagination error:",
        orderGid,
        json.errors[0]?.message || json.errors[0]
      );
      break;
    }
    const page = json.data?.order?.fulfillmentOrders;
    if (!page) {
      fetchErrored = true;
      break;
    }
    for (const e of page.edges || []) foEdges.push(e);
    if (page.pageInfo?.hasNextPage === true && page.pageInfo.endCursor) {
      nextAfter = page.pageInfo.endCursor;
    } else {
      nextAfter = false;
    }
    if (page.pageInfo?.hasNextPage === true && !page.pageInfo.endCursor) {
      console.warn("[shopifyOrderBeforeFetchData] fulfillmentOrders hasNextPage but no endCursor", orderGid);
      nextAfter = false;
    }
  }
  for (const fe of foEdges) {
    const n = fe?.node;
    if (!n?.id) continue;
    const allLiEdges = await fetchAllFulfillmentOrderLineItemEdges(adminClient, n.id, n.lineItems);
    n.lineItems = { edges: allLiEdges };
  }
  return { edges: foEdges, fetchErrored };
};

const fetchAllLineItemNodes = async (adminClient, orderGid, initialLineItems) => {
  const nodes = [];
  let fetchErrored = false;
  let nextAfter;
  if (initialLineItems?.edges?.length > 0) {
    for (const e of initialLineItems.edges) {
      if (e?.node) nodes.push(e.node);
    }
    if (initialLineItems.pageInfo?.hasNextPage === true && initialLineItems.pageInfo.endCursor) {
      nextAfter = initialLineItems.pageInfo.endCursor;
    } else {
      nextAfter = false;
    }
  } else {
    nextAfter = null;
  }
  while (nextAfter !== false) {
    await new Promise((r) => setTimeout(r, 150));
    const resp = await adminClient.graphql(orderLineItemsPageQuery, {
      variables: { orderId: orderGid, first: LINE_ITEMS_FIRST, after: nextAfter }
    });
    const json = resp instanceof Response ? await resp.json() : resp;
    if (json.errors && json.errors.length > 0) {
      fetchErrored = true;
      console.error(
        "[shopifyOrderBeforeFetchData] order lineItems pagination error:",
        orderGid,
        json.errors[0]?.message || json.errors[0]
      );
      break;
    }
    const page = json.data?.order?.lineItems;
    if (!page) {
      fetchErrored = true;
      break;
    }
    for (const e of page.edges || []) {
      if (e?.node) nodes.push(e.node);
    }
    if (page.pageInfo?.hasNextPage === true && page.pageInfo.endCursor) {
      nextAfter = page.pageInfo.endCursor;
    } else {
      nextAfter = false;
    }
    if (page.pageInfo?.hasNextPage === true && !page.pageInfo.endCursor) {
      console.warn("[shopifyOrderBeforeFetchData] lineItems hasNextPage but no endCursor", orderGid);
      nextAfter = false;
    }
  }
  return { nodes, fetchErrored };
};
const sortCol = sort && sort.column;
const sortKey =
  sortCol === "orderName" || sortCol === "name" ? "ORDER_NUMBER" : "CREATED_AT";
const reverse = sort.direction === "desc";

let allOrders = [];
let cursor = null;
let hasNextPage = true;
while (hasNextPage) {
  const variables = { first: ORDERS_PAGE_SIZE, query: queryString || null, sortKey, reverse };
  if (cursor) variables.after = cursor;
  if (!cursor) {
    console.log("[shopifyOrderBeforeFetchData] query (copy for manual test):\n", ordersQuery);
    console.log("[shopifyOrderBeforeFetchData] variables:", JSON.stringify(variables, null, 2));
  }
  const response = await admin.graphql(ordersQuery, { variables });
  const apiResponse = response instanceof Response ? await response.json() : response;
  if (!cursor) {
    console.log("[shopifyOrderBeforeFetchData] first page response:", {
      errors: apiResponse.errors,
      edgesCount: apiResponse.data?.orders?.edges?.length ?? 0,
      hasNextPage: apiResponse.data?.orders?.pageInfo?.hasNextPage
    });
  }
  if (apiResponse.errors && apiResponse.errors.length > 0) {
    console.error("[shopifyOrderBeforeFetchData] GraphQL error:", apiResponse.errors[0].message || "unknown");
    return;
  }
  const edges = apiResponse.data?.orders?.edges || [];
  allOrders = allOrders.concat(edges.map((e) => e.node));
  hasNextPage = apiResponse.data?.orders?.pageInfo?.hasNextPage === true;
  cursor = apiResponse.data?.orders?.pageInfo?.endCursor || null;
  if (!cursor) break;
  await new Promise((r) => setTimeout(r, 200));
}
console.log("[shopifyOrderBeforeFetchData] fetched orders:", allOrders.length, "total from API");

const money = (set) => {
  const m = set?.shopMoney;
  return { amount: m?.amount ?? "", currency: m?.currencyCode ?? "" };
};

const session = args.session;
for (const order of allOrders) {
  const orderId = order.id || "";
  const orderName = order.name || "";
  const orderCreatedAt = order.createdAt || "";
  const orderUpdatedAt = order.updatedAt || orderCreatedAt;
  const tagsArr = order.tags;
  const tagsStr = Array.isArray(tagsArr) ? tagsArr.join(", ") : tagsArr || "";
  const sub = money(order.subtotalPriceSet);
  const tot = money(order.totalPriceSet);
  const tax = money(order.totalTaxSet);
  const ship = money(order.totalShippingPriceSet);
  let lineNodes;
  let lineItemsFetchErrored = false;
  let fulfillmentOrdersFetchErrored = false;
  if (orderId && admin) {
    const lineRes = await fetchAllLineItemNodes(admin, orderId, order.lineItems);
    lineNodes = lineRes.nodes;
    lineItemsFetchErrored = lineRes.fetchErrored;
    const foRes = await fetchAllFulfillmentOrdersForOrder(admin, orderId, order.fulfillmentOrders);
    order.fulfillmentOrders = { edges: foRes.edges };
    fulfillmentOrdersFetchErrored = foRes.fetchErrored;
  } else {
    lineNodes = order.lineItems?.edges?.map((e) => e.node) || [];
  }
  if (lineItemsFetchErrored) {
    console.warn("[shopifyOrderBeforeFetchData] line items list may be incomplete (pagination error)", {
      shop,
      orderId,
      orderName
    });
  }
  if (lineNodes.length >= LINE_ITEMS_FIRST) {
    console.log("[shopifyOrderBeforeFetchData] metric: orderLineItemsCountAtOrAbovePageCap", {
      shop,
      orderId,
      orderName,
      lineItemsCount: lineNodes.length,
      pageCap: LINE_ITEMS_FIRST
    });
  }
  const remainingByLineId = getRemainingByLineItemId(order);
  const foEdgeCount = order.fulfillmentOrders?.edges?.length ?? 0;
  if (fulfillmentOrdersFetchErrored) {
    console.warn("[shopifyOrderBeforeFetchData] fulfillment orders may be incomplete (pagination error)", {
      shop,
      orderId,
      orderName,
      fulfillmentOrderCount: foEdgeCount
    });
  }
  if (foEdgeCount >= FULFILLMENT_ORDERS_FIRST) {
    console.log("[shopifyOrderBeforeFetchData] metric: orderFulfillmentOrderCountAtOrAbovePageCap", {
      shop,
      orderId,
      orderName,
      fulfillmentOrderCount: foEdgeCount,
      pageCap: FULFILLMENT_ORDERS_FIRST
    });
  }
  logFoPartialCoverage(orderId, orderName, lineNodes, remainingByLineId, foEdgeCount);
  await session.run(
    `MERGE (o:ShopifyOrder { id: $id })
     SET o.name = $name,
         o.createdAt = $createdAt,
         o.updatedAt = $updatedAt,
         o.displayFulfillmentStatus = $displayFulfillmentStatus,
         o.displayFinancialStatus = $displayFinancialStatus,
         o.email = $email,
         o.phone = $phone,
         o.processedAt = $processedAt,
         o.cancelledAt = $cancelledAt,
         o.closed = $closed,
         o.note = $note,
         o.tags = $tags,
         o.subtotalAmount = $subtotalAmount,
         o.subtotalCurrency = $subtotalCurrency,
         o.totalPriceAmount = $totalPriceAmount,
         o.totalPriceCurrency = $totalPriceCurrency,
         o.totalTaxAmount = $totalTaxAmount,
         o.totalShippingAmount = $totalShippingAmount,
         o.taxesIncluded = $taxesIncluded,
         o.fullyPaid = $fullyPaid,
         o.testOrder = $testOrder,
         o.lineItemsCount = $lineItemsCount`,
    {
      id: orderId,
      name: orderName,
      createdAt: orderCreatedAt,
      updatedAt: orderUpdatedAt,
      displayFulfillmentStatus: order.displayFulfillmentStatus || "",
      displayFinancialStatus: order.displayFinancialStatus || "",
      email: order.email || "",
      phone: order.phone || "",
      processedAt: order.processedAt || "",
      cancelledAt: order.cancelledAt || "",
      closed: order.closed === true,
      note: order.note || "",
      tags: tagsStr,
      subtotalAmount: sub.amount,
      subtotalCurrency: sub.currency,
      totalPriceAmount: tot.amount,
      totalPriceCurrency: tot.currency,
      totalTaxAmount: tax.amount,
      totalShippingAmount: ship.amount,
      taxesIncluded: order.taxesIncluded === true,
      fullyPaid: order.fullyPaid === true,
      testOrder: order.test === true,
      lineItemsCount: lineNodes.length
    }
  );
  for (let idx = 0; idx < lineNodes.length; idx++) {
    const node = lineNodes[idx];
    const lineItemId = node.id || orderId + "-" + idx;
    const attrs = node.customAttributes || [];
    const propertiesText = attrs.map((a) => (a.key || "") + ": " + (a.value || "")).filter(Boolean).join(" | ");
    const variantTitle = node.variant && node.variant.title ? node.variant.title : "";
    const variantSku = node.variant?.sku || "";
    const variantId = node.variant?.id || "";
    const productId = node.product?.id || "";
    const ou = money(node.originalUnitPriceSet);
    const du = money(node.discountedUnitPriceSet);
    const ot = money(node.originalTotalSet);
    const dt = money(node.discountedTotalSet);
    const qty = node.quantity ?? 0;
    const remainingFromFo = remainingByLineId[node.id];
    // Not in FO map: no FOs yet, or line not on any FO row (see logFoPartialCoverage); use full line qty.
    const remainingQuantity =
      remainingFromFo !== undefined && remainingFromFo !== null
        ? Number(remainingFromFo) || 0
        : qty;
    const fulfillmentStatus = fulfillmentStatusFromRemaining(remainingQuantity, qty);
    await session.run(
      `MERGE (o:ShopifyOrder { id: $orderId })
       MERGE (li:ShopifyOrderLineItem { id: $lineItemId })
       SET li.orderId = $orderId,
           li.orderName = $orderName,
           li.orderCreatedAt = $orderCreatedAt,
           li.lineItemName = $lineItemName,
           li.productTitle = $productTitle,
           li.productGraphId = $productGraphId,
           li.variantGraphId = $variantGraphId,
           li.variantTitle = $variantTitle,
           li.variantSku = $variantSku,
           li.sku = $sku,
           li.vendor = $vendor,
           li.quantity = $quantity,
           li.remainingQuantity = $remainingQuantity,
           li.properties = $properties,
           li.fulfillmentStatus = $fulfillmentStatus,
           li.originalUnitAmount = $originalUnitAmount,
           li.originalUnitCurrency = $originalUnitCurrency,
           li.discountedUnitAmount = $discountedUnitAmount,
           li.discountedUnitCurrency = $discountedUnitCurrency,
           li.originalTotalAmount = $originalTotalAmount,
           li.originalTotalCurrency = $originalTotalCurrency,
           li.discountedTotalAmount = $discountedTotalAmount,
           li.discountedTotalCurrency = $discountedTotalCurrency
       MERGE (o)-[:HAS_LINE_ITEM]->(li)`,
      {
        orderId,
        lineItemId,
        orderName,
        orderCreatedAt,
        lineItemName: node.name || node.title || "",
        productTitle: node.title || "",
        productGraphId: productId,
        variantGraphId: variantId,
        variantTitle,
        variantSku,
        sku: node.sku || "",
        vendor: node.vendor || "",
        quantity: qty,
        remainingQuantity,
        properties: propertiesText,
        fulfillmentStatus,
        originalUnitAmount: ou.amount,
        originalUnitCurrency: ou.currency,
        discountedUnitAmount: du.amount,
        discountedUnitCurrency: du.currency,
        originalTotalAmount: ot.amount,
        originalTotalCurrency: ot.currency,
        discountedTotalAmount: dt.amount,
        discountedTotalCurrency: dt.currency
      }
    );
  }
}
'''
        key: shopifyOrderBeforeFetchData
      }
    }
  ]
  edges: []
}