{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Attempts to sync Shopify purchase orders via Admin GraphQL purchaseOrders. If the field is unavailable (undocumented or extra scopes), logs and skips without failing the page. Categories still work for existing graph rows.
        body:
          '''const { tableVertexLabel, shop: contextShop } = args.contextData;
if (tableVertexLabel !== "ShopifyPurchaseOrder") return;

const shop = contextShop || args.shop;
if (!shop) {
  console.warn("[shopifyPurchaseOrderBeforeFetchData] shop is required");
  return;
}

const shopify = await args.getShopifyClient();
let admin;
try {
  const authResult = await shopify.unauthenticated.admin(shop);
  admin = authResult.admin;
} catch (e) {
  console.log("[shopifyPurchaseOrderBeforeFetchData] Shopify admin auth failed:", e?.message || e);
  return;
}
if (!admin) {
  console.log("[shopifyPurchaseOrderBeforeFetchData] no admin client for shop:", shop);
  return;
}

const PAGE_SIZE = 25;
const purchaseOrdersQuery =
  `
  query PurchaseOrdersSync($first: Int!, $after: String) {
    purchaseOrders(first: $first, after: $after) {
      pageInfo {
        hasNextPage
        endCursor
      }
      edges {
        node {
          id
          name
          status
          createdAt
          updatedAt
          note
          referenceName
          tags
        }
      }
    }
  }`.trim();

const probeResp = await admin.graphql(purchaseOrdersQuery, {
  variables: { first: 1, after: null }
});
const probeJson = probeResp instanceof Response ? await probeResp.json() : probeResp;
if (probeJson.errors && probeJson.errors.length > 0) {
  console.warn(
    "[shopifyPurchaseOrderBeforeFetchData] Skipping sync (GraphQL purchaseOrders unavailable or missing scope):",
    probeJson.errors[0]?.message || probeJson.errors[0]
  );
  return;
}
if (!probeJson.data || probeJson.data.purchaseOrders == null) {
  console.warn("[shopifyPurchaseOrderBeforeFetchData] Skipping sync: purchaseOrders field missing on QueryRoot");
  return;
}

const strJoinTags = (tags) =>
  Array.isArray(tags) ? tags.filter((x) => x != null && x !== "").join(", ") : "";

let cursor = null;
let hasNextPage = true;
const session = args.session;
let total = 0;

while (hasNextPage) {
  const response = await admin.graphql(purchaseOrdersQuery, {
    variables: { first: PAGE_SIZE, after: cursor || null }
  });
  const apiResponse = response instanceof Response ? await response.json() : response;
  if (apiResponse.errors && apiResponse.errors.length > 0) {
    console.error(
      "[shopifyPurchaseOrderBeforeFetchData] GraphQL error:",
      apiResponse.errors[0]?.message || "unknown"
    );
    return;
  }
  const conn = apiResponse.data?.purchaseOrders;
  const edges = conn?.edges || [];
  for (const e of edges) {
    const node = e?.node;
    if (!node?.id) continue;
    const props = {
      id: node.id,
      name: node.name || "",
      status: node.status ? String(node.status) : "",
      createdAt: node.createdAt || "",
      updatedAt: node.updatedAt || "",
      note: node.note || "",
      referenceName: node.referenceName || "",
      tags: strJoinTags(node.tags)
    };
    await session.run(`MERGE (p:ShopifyPurchaseOrder { id: $id })
     SET p += $props`, { id: node.id, props });
    total++;
  }
  hasNextPage = conn?.pageInfo?.hasNextPage === true;
  cursor = conn?.pageInfo?.endCursor || null;
  if (!cursor) break;
  await new Promise((r) => setTimeout(r, 200));
}

console.log("[shopifyPurchaseOrderBeforeFetchData] synced purchase orders:", total);
'''
        key: shopifyPurchaseOrderBeforeFetchData
      }
    }
  ]
  edges: []
}
