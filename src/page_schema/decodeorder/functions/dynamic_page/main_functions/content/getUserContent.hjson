{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Fetches user content with filtering, sorting, and search support. Works with any tableVertexLabel.
        body:
          '''
// Get current authenticated user from session
const actualUser = await args.getUserFromSession();
if (!actualUser) {
  return {
    success: false,
    message: "User session not found. Please log in and try again.",
    data: []
  };
}

// Get effective user (handles admin impersonation)
const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

// Extract parameters
const { 
  tableVertexLabel, 
  search, 
  filters = {}, 
  sort = {},
  categoryId,
  showUnassigned,
  parentVertexLabel,
  toParentEdgeType,
  enableUserScoping,
  hooks,
  elementIds,
  onlyNotQueued,
  relationshipPropertyBindings
} = args.contextData;

const getGraphPayload = (nodes, rels) => ({
  vertexes: nodes || {},
  edges: rels || {},
  deleted_vertexes: Array.isArray(args.context?.deletedVertexes) ? args.context.deletedVertexes : [],
  deleted_edges: Array.isArray(args.context?.deletedEdges) ? args.context.deletedEdges : []
});

// Optional: client passes bindings from table config (form fields with selectConfig.edgeOnly + relationshipType, plus config.relationshipPropertyBindings).
const hydrateRelationshipSelectProps = (items, rels, bindings) => {
  if (!Array.isArray(bindings) || bindings.length === 0 || !Array.isArray(items)) return;
  for (let vi = 0; vi < items.length; vi++) {
    const v = items[vi];
    if (!v?.P || !v?.OUT) continue;
    for (let bi = 0; bi < bindings.length; bi++) {
      const row = bindings[bi];
      const prop = row?.prop;
      const rel = row?.rel;
      if (!prop || !rel) continue;
      const outArr = v.OUT[rel];
      if (!Array.isArray(outArr) || outArr.length === 0) {
        v.P[prop] = null;
        continue;
      }
      const edgeObj = rels[outArr[0]];
      if (edgeObj && edgeObj.E != null) v.P[prop] = edgeObj.E;
      else v.P[prop] = null;
    }
  }
};

const buildRelationshipPropertyBindingsFromTableConfig = (config) => {
  if (!config || typeof config !== "object") return [];
  const fields = [];
  const groups = config.formConfig?.groups;
  if (Array.isArray(groups)) {
    for (let gi = 0; gi < groups.length; gi++) {
      const g = groups[gi]?.fields;
      if (!Array.isArray(g)) continue;
      for (let fi = 0; fi < g.length; fi++) fields.push(g[fi]);
    }
  }
  const seen = new Set();
  const bindings = [];
  const addBinding = (prop, rel) => {
    if (!prop || !rel) return;
    const k = `${prop}\0${rel}`;
    if (seen.has(k)) return;
    seen.add(k);
    bindings.push({ prop, rel });
  };
  for (let i = 0; i < fields.length; i++) {
    const f = fields[i];
    if (f?.type === "select" && f.selectConfig?.relationshipType && f.selectConfig?.edgeOnly === true) {
      addBinding(f.key, f.selectConfig.relationshipType);
    }
  }
  const cols = config.columns;
  if (Array.isArray(cols)) {
    for (let ci = 0; ci < cols.length; ci++) {
      const c = cols[ci];
      if (c?.type === "select" && c.selectConfig?.relationshipType && c.selectConfig?.edgeOnly === true) {
        addBinding(c.key, c.selectConfig.relationshipType);
      }
    }
  }
  const extra = config.relationshipPropertyBindings;
  if (Array.isArray(extra)) {
    for (let j = 0; j < extra.length; j++) {
      const row = extra[j];
      addBinding(row?.prop, row?.rel);
    }
  }
  return bindings;
};

const fetchTableSettingConfigObject = async (label) => {
  const uuid = user?.P?.uuid;
  if (!uuid || !label) return null;
  const userKey = `${label}_settings`;
  let res = await args.session.run(
    `MATCH (u:User {uuid: $uuid})-[:UserSetting]->(s:Setting {key: $key}) RETURN s.config AS cfg LIMIT 1`,
    { uuid, key: userKey }
  );
  let cfg = res.records[0]?.get("cfg");
  if (cfg == null) {
    const defaultKey = `${label}_settings_default`;
    res = await args.session.run(
      `MATCH (s:Setting {key: $key}) RETURN s.config AS cfg LIMIT 1`,
      { key: defaultKey }
    );
    cfg = res.records[0]?.get("cfg");
  }
  if (cfg == null) return null;
  const str = typeof cfg === "string" ? cfg : String(cfg);
  if (!str.trim()) return null;
  try {
    const fn = new Function(str);
    const o = fn();
    return o && typeof o === "object" ? o : null;
  } catch (e) {
    console.warn("getUserContent: Setting.config eval failed", e);
    return null;
  }
};

const resolveRelationshipPropertyBindings = async (label) => {
  if (Array.isArray(relationshipPropertyBindings)) {
    return relationshipPropertyBindings;
  }
  const configObj = await fetchTableSettingConfigObject(label);
  return buildRelationshipPropertyBindingsFromTableConfig(configObj);
};

if (!tableVertexLabel || typeof tableVertexLabel !== "string") {
  return {
    success: false,
    message: "tableVertexLabel is required and must be a string",
    data: []
  };
}

const effectiveRelationshipPropertyBindings = await resolveRelationshipPropertyBindings(tableVertexLabel);

// Lightweight path: return only rows that are no longer queued (for background refresh without full reload)
if (onlyNotQueued === true && Array.isArray(elementIds) && elementIds.length > 0) {
  const query = `
  MATCH (c:${tableVertexLabel})
  WHERE elementId(c) IN $elementIds
  AND (c.syncStatus IS NULL OR c.syncStatus <> 'queued')
  OPTIONAL MATCH (c)-[r]->(related)
  RETURN c, r, related
  `;
  const queryResult = await args.session.run(query, { elementIds });
  args.processResult(queryResult.records, args.context, ['c', 'related'], 'r');
  const nodes = args.context.nodes || {};
  const rels = args.context.relationships || {};
  const items = Object.values(nodes).filter(v => v.L && v.L.includes(tableVertexLabel));
  hydrateRelationshipSelectProps(items, rels, effectiveRelationshipPropertyBindings);
  return {
    success: true,
    data: items,
    relatedVertices: Object.values(nodes).filter(v => !v.L || !v.L.includes(tableVertexLabel)),
    graph: getGraphPayload(nodes, rels),
    message: `Found ${items.length} row(s) no longer queued`
  };
}

// Determine vertex label and relationship type based on tableVertexLabel
const vertexLabel = tableVertexLabel;
// Relationship type is "User" + vertexLabel (e.g., "UserBook", "UserAudioVideo", "UserCategory")
const relationshipType = `User${vertexLabel}`;
const uncategorizedVertexId = '_' + vertexLabel + '_uncategorized';
const categoryIdIsSyntheticUncategorized = !!(categoryId && categoryId === uncategorizedVertexId);
const applyUnassignedCategoryScope =
  !!(parentVertexLabel && toParentEdgeType && (showUnassigned === true || categoryIdIsSyntheticUncategorized));
const useRealCategoryGraphMatch =
  !!(categoryId && parentVertexLabel && toParentEdgeType && !categoryIdIsSyntheticUncategorized);

// Build WHERE clause for filters
const whereConditions = [];
const queryParams = enableUserScoping ? { userUuid: user.P.uuid } : {};

// Add search filter
if (search && search.trim()) {
  const searchTerm = search.trim().toLowerCase();
  whereConditions.push(`(
    toLower(COALESCE(c.fileName, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.name, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.description, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.title, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.subTitle, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.event, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.language, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.orderName, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.productTitle, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.lineItemName, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.variantTitle, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.sku, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.vendor, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.email, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.username, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.displayFinancialStatus, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.displayFulfillmentStatus, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.tags, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.note, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.customerDisplayName, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.status, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.draftOrderName, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.partNo, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.supplierName, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.supplierCode, '')) CONTAINS $searchTerm
  )`);
  queryParams.searchTerm = searchTerm;
}

// Add column filters
if (filters && typeof filters === "object") {
  for (const [key, value] of Object.entries(filters)) {
    if (value !== undefined && value !== null && value !== "") {
      const paramKey = `filter_${key}`;
      // Support both single values and arrays (for multiple select filters)
      if (Array.isArray(value) && value.length > 0) {
        whereConditions.push(`c.${key} IN $${paramKey}`);
        queryParams[paramKey] = value;
      } else if (!Array.isArray(value)) {
        whereConditions.push(`c.${key} = $${paramKey}`);
        queryParams[paramKey] = value;
      }
    }
  }
}

let whereClause = whereConditions.length > 0 
  ? "WHERE " + whereConditions.join(" AND ")
  : "";

// Build ORDER BY clause
let orderByClause = "";
if (sort && sort.column) {
  const direction = sort.direction === "desc" ? "DESC" : "ASC";
  orderByClause = `ORDER BY c.${sort.column} ${direction}`;
} else {
  // Default sorting - try name first, then title, then createdAt
  orderByClause = "ORDER BY COALESCE(c.fileName, c.name, c.title, '') ASC, c.createdAt DESC";
}

// Build category filter if provided (synthetic uncategorized id uses unassigned scope, not elementId(cat))
let categoryFilter = "";
if (useRealCategoryGraphMatch) {
  categoryFilter = `
  MATCH (cat:${parentVertexLabel})
  WHERE elementId(cat) = $categoryId
  MATCH (c)-[:${toParentEdgeType}]->(cat)`;
  queryParams.categoryId = categoryId;
} else if (applyUnassignedCategoryScope) {
  const unassignedCondition = `NOT EXISTS {
    MATCH (c)-[:${toParentEdgeType}]->(cat:${parentVertexLabel})
  }`;
  if (whereClause) {
    whereClause = whereClause + " AND " + unassignedCondition;
  } else {
    whereClause = "WHERE " + unassignedCondition;
  }
}

// Execute beforeFetchData hooks
await args.executeHooks(hooks?.beforeFetchData, {
  tableVertexLabel,
  search,
  filters,
  sort,
  categoryId,
  showUnassigned,
  parentVertexLabel,
  toParentEdgeType,
  enableUserScoping
});

// Optimized query with indexed user lookup first and related vertices
let query = "";
if (!enableUserScoping) {
  if (useRealCategoryGraphMatch) {
    // Query with category filter - content points to category: content-[toParentEdgeType]->category
    query = `
    MATCH (cat:${parentVertexLabel})
    WHERE elementId(cat) = $categoryId
    MATCH (c:${vertexLabel})-[catRel:${toParentEdgeType}]->(cat)
    ${whereClause}
    OPTIONAL MATCH (c)-[r]->(related)
    ${orderByClause}
    RETURN c, r, related
    `;
  } else {
    // Standard query without category filter
    query = `
    MATCH (c:${vertexLabel})
    ${whereClause}
    OPTIONAL MATCH (c)-[r]->(related)
    ${orderByClause}
    RETURN c, r, related
    `;
  }
} else {
  if (useRealCategoryGraphMatch) {
    // Query with category filter - content points to category: content-[toParentEdgeType]->category
    query = `
    MATCH (u:User {uuid: $userUuid})
    MATCH (cat:${parentVertexLabel})
    WHERE elementId(cat) = $categoryId
    MATCH (c:${vertexLabel})-[catRel:${toParentEdgeType}]->(cat)
    MATCH (u)-[:${relationshipType}]->(c)
    ${whereClause}
    OPTIONAL MATCH (c)-[r]->(related)
    ${orderByClause}
    RETURN c, r, related
    `;
  } else {
    // Standard query without category filter
    query = `
    MATCH (u:User {uuid: $userUuid})
    MATCH (u)-[:${relationshipType}]->(c:${vertexLabel})
    ${whereClause}
    OPTIONAL MATCH (c)-[r]->(related)
    ${orderByClause}
    RETURN c, r, related
    `;
  }
}

const queryResult = await args.session.run(query, queryParams);

// Use processResult to populate graph structure (nodes + relationships)
if (!args.context.nodes) args.context.nodes = {};
if (!args.context.relationships) args.context.relationships = {};
args.processResult(queryResult.records, args.context, ['c', 'related'], 'r');
const nodes = args.context.nodes || {};
const rels = args.context.relationships || {};
const items = Object.values(nodes).filter(v => v.L && v.L.includes(vertexLabel));
hydrateRelationshipSelectProps(items, rels, effectiveRelationshipPropertyBindings);

const result = {
  success: true,
  data: items,
  relatedVertices: Object.values(nodes).filter(v => !v.L || !v.L.includes(vertexLabel)),
  graph: getGraphPayload(nodes, rels),
  message: `Found ${items.length} ${tableVertexLabel} item${items.length !== 1 ? 's' : ''}`
};

// Execute afterFetchData hooks
await args.executeHooks(hooks?.afterFetchData, {
  tableVertexLabel,
  search,
  filters,
  sort,
  categoryId,
  showUnassigned,
  parentVertexLabel,
  toParentEdgeType,
  enableUserScoping,
  result: result
});

return result;
'''
        key: getUserContent
      }
    }
  ]
  edges: []
}