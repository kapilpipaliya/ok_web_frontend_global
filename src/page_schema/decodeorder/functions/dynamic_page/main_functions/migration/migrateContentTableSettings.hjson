    { key: "acceptAutomaticDiscounts", label: "Auto discounts", type: "badge", width: "120px", valueAccessor: (row) => (row.P?.acceptAutomaticDiscounts ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "info"], no: ["No", "neutral"] } },
    { key: "allowDiscountCodesInCheckout", label: "Codes at checkout", type: "badge", width: "130px", valueAccessor: (row) => (row.P?.allowDiscountCodesInCheckout ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "success"], no: ["No", "neutral"] } },
