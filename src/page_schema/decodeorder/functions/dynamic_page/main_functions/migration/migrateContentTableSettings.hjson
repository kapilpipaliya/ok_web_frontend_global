        { key: "unfulfilledDiscountedTotalAmount", label: "Unfulf. disc.", type: "text", width: "120px", valueAccessor: (row) => { const a = row.P?.unfulfilledDiscountedTotalAmount; const c = row.P?.unfulfilledDiscountedTotalCurrency || ""; return a != null && a !== "" ? String(a) + " " + c : ""; } },
