    hooks: {
      // Hooks for creating category - creates collection in Shopify (menu jobs enqueued from within)
      afterCreate: ["shopifyProductCategoryAfterCreate"],
      // Hooks for updating category - updates collection in Shopify (menu jobs enqueued from within)
      afterUpdate: ["shopifyProductCategoryAfterUpdate"],
      // Hooks for deleting category - deletes collection in Shopify (menu jobs enqueued from within)
      afterDelete: ["shopifyProductCategoryAfterDelete"],
      // Hooks for moving category - updates menus when category is moved
      afterMoveCategory: ["shopifyMenuAfterMoveCategory"]
    }
  }
};`
  },
  {
    key: 'Support_settings_default',
    tableVertexLabel: 'Support',
    icon: '💬',
    name: 'Support',
    config: `return {
  title: "Support Tickets",
  label: "Support Ticket",
  icon: "carbon:chat",
  hideExportButtons: false,
  hideImportButtons: true,
  hideSettingsButton: false,
  columns: [
    {
      key: "shop",
      label: "Shop",
      type: "text",
      width: "220px"
    },
    {
      key: "subject",
      label: "Subject",
      type: "text",
      width: "260px",
      required: false
    },
    {
      key: "email",
      label: "Email",
      type: "text",
      width: "220px"
    },
    {
      key: "unreadForAdmin",
      label: "Unread",
      type: "number",
      width: "90px"
    },
    {
      key: "createdAt",
      label: "Created",
      type: "date",
      width: "160px",
      valueAccessor: (row) => row.P?.createdAt || row.createdAt
    }
  ],
  rowHeight: 60,
  showRowNumber: true,
  showSelection: false,
  showActions: false,
  showEditButton: false,
  rowClickable: true,
  resizableColumns: true,
  columnWidths: { __rowNumber: "40px" },
  formConfig: null,
  uniqueKeys: [],
  usePolarisUI: false,
  enableUserScopingForSidebar: false,
  enableUserScopingForContent: false,
  enableLocalFilters: true,
  enableLocalSort: true,
  hooks: {},
  sidebar: {
    enabled: false
  },
  onRowClick: (row, args) => {
    const supportTicketVertexId = row?.id;
    if (!supportTicketVertexId) {
      return;
    }
    const basePath = "/ShopifySupportConversation";
    const searchParams = args.searchParams || {};
    const nextParams = { ...searchParams, supportId: supportTicketVertexId };
    const query = Object.entries(nextParams)
      .filter(([, value]) => value != null && value !== "")
      .map(([key, value]) => \`\${encodeURIComponent(key)}=\${encodeURIComponent(String(value))}\`)
      .join("&");
    const href = query ? \`\${basePath}?\${query}\` : basePath;

    if (args.navigate) {
      args.navigate(href);
    } else if (typeof window !== "undefined") {
      window.location.href = href;
    }
  }
};`
  },
  {
    key: 'ShopifyOrder_settings_default',
    tableVertexLabel: 'ShopifyOrder',
    icon: '📦',
    name: 'ShopifyOrder',
    config: `return {
  title: "Orders",
  label: "Order",
  icon: "carbon:shopping-cart",
  hideImportButtons: true,
  hideExportButtons: true,
  hideSettingsButton: false,
  showActions: false,
  showEditButton: false,
  onRowClick: (row, args) => {
    const orderVertexId = row?.P?.id ?? row?.id;
    if (!orderVertexId || typeof window === "undefined") {
      return;
    }
    const shopifyNumericSuffix = /([0-9]+)$/;
    const orderIdMatch = String(orderVertexId).match(shopifyNumericSuffix);
    const numericOrderId = orderIdMatch ? orderIdMatch[1] : "";
    if (!numericOrderId) {
      return;
    }
    let shopifyAdminOrigin =
      window.shopify && window.shopify.origin ? String(window.shopify.origin) : "";
    if (!shopifyAdminOrigin) {
      return;
    }
    if (shopifyAdminOrigin.endsWith("/")) {
      shopifyAdminOrigin = shopifyAdminOrigin.slice(0, -1);
    }
    const orderAdminUrl = shopifyAdminOrigin + "/orders/" + numericOrderId;
    window.open(orderAdminUrl, "_blank", "noopener,noreferrer");
  },
  columns: [
    { key: "name", label: "Order", type: "text", width: "120px", valueAccessor: (row) => row.P?.name },
    { key: "createdAt", label: "Created", type: "date", width: "130px", valueAccessor: (row) => row.P?.createdAt },
    { key: "processedAt", label: "Processed", type: "date", width: "130px", valueAccessor: (row) => row.P?.processedAt },
    { key: "displayFulfillmentStatus", label: "Fulfillment", type: "badge", width: "120px", valueAccessor: (row) => row.P?.displayFulfillmentStatus, badgeKeyCase: "lower", badgeToneMap: { fulfilled: ["Fulfilled", "success"], unfulfilled: ["Unfulfilled", "warning"], partial: ["Partial", "info"], restocked: ["Restocked", "neutral"], pending_fulfillment: ["Pending", "warning"], scheduled: ["Scheduled", "info"], on_hold: ["On hold", "caution"] } },
    { key: "displayFinancialStatus", label: "Payment", type: "badge", width: "120px", valueAccessor: (row) => row.P?.displayFinancialStatus, badgeKeyCase: "lower", badgeToneMap: { paid: ["Paid", "success"], pending: ["Pending", "warning"], authorized: ["Authorized", "info"], partially_paid: ["Partial", "info"], refunded: ["Refunded", "neutral"], voided: ["Voided", "critical"], partially_refunded: ["Part ref", "caution"] } },
    { key: "total", label: "Total", type: "text", width: "130px", valueAccessor: (row) => { const a = row.P?.totalPriceAmount; const c = row.P?.totalPriceCurrency || ""; return a != null && a !== "" ? String(a) + " " + c : ""; } },
    { key: "subtotalAmount", label: "Subtotal", type: "text", width: "130px", valueAccessor: (row) => { const a = row.P?.subtotalAmount; const c = row.P?.subtotalCurrency || ""; return a != null && a !== "" ? String(a) + " " + c : ""; } },
    { key: "totalTaxAmount", label: "Tax", type: "text", width: "90px", valueAccessor: (row) => row.P?.totalTaxAmount },
    { key: "totalShippingAmount", label: "Shipping", type: "text", width: "90px", valueAccessor: (row) => row.P?.totalShippingAmount },
    { key: "lineItemsCount", label: "Lines", type: "number", width: "70px", valueAccessor: (row) => row.P?.lineItemsCount },
    { key: "email", label: "Email", type: "text", width: "200px", valueAccessor: (row) => row.P?.email },
    { key: "phone", label: "Phone", type: "text", width: "120px", valueAccessor: (row) => row.P?.phone },
    { key: "tags", label: "Tags", type: "text", width: "180px", valueAccessor: (row) => row.P?.tags },
    { key: "fullyPaid", label: "Paid", type: "badge", width: "80px", valueAccessor: (row) => (row.P?.fullyPaid ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "success"], no: ["No", "warning"] } },
    { key: "testOrder", label: "Test", type: "badge", width: "70px", valueAccessor: (row) => (row.P?.testOrder ? "test" : "live"), badgeKeyCase: "lower", badgeToneMap: { test: ["Test", "warning"], live: ["Live", "success"] } },
    { key: "closed", label: "Closed", type: "badge", width: "80px", valueAccessor: (row) => (row.P?.closed ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "neutral"], no: ["No", "info"] } },
    { key: "cancelledAt", label: "Cancelled", type: "date", width: "120px", valueAccessor: (row) => row.P?.cancelledAt },
    { key: "note", label: "Note", type: "text", width: "220px", valueAccessor: (row) => row.P?.note }
  ],
  rowHeight: 44,
  showRowNumber: true,
  showSelection: true,
  resizableColumns: true,
  columnWidths: { __selection: "36px", __rowNumber: "36px", __expand: "32px" },
  enableLocalFilters: true,
  enableLocalSort: true,
  usePolarisUI: true,
  rowExpansion: {
    childVertexLabel: "ShopifyOrderLineItem",
    childParentFilterKey: "orderId",
    parentIdField: "id",
    expansionPanelHeight: 380,
    expansionPanelMaxHeight: 520,
    expandAccordionMaxWidth: 768,
    expandOneRowAtATime: false,
    nestedTitle: "Line items",
    emptyNestedText: "No line items for this order.",
    nestedLoadingText: "Loading line items…",
    nestedSort: { column: "productTitle", direction: "asc" },
    nestedColumns: [
      { key: "orderName", label: "Order", type: "text", width: "100px", valueAccessor: (row) => row.P?.orderName },
      {
        key: "lineItemName",
        label: "Line name",
        type: "text",
        width: "160px",
        valueAccessor: (row) => row.P?.lineItemName,
        overflowEllipsis: true,
        render: (value, row) => {
          const productGraphId = row?.P?.productGraphId;
          const variantGraphId = row?.P?.variantGraphId;
          const shopifyNumericSuffix = /([0-9]+)$/;
          const productNumericMatch =
            productGraphId != null
              ? String(productGraphId).match(shopifyNumericSuffix)
              : null;
          const variantNumericMatch =
            variantGraphId != null
              ? String(variantGraphId).match(shopifyNumericSuffix)
              : null;
          const displayLabel =
            value != null && value !== "" ? String(value) : "—";
          if (!productNumericMatch || !variantNumericMatch) {
            return displayLabel;
          }
          let shopifyAdminOrigin =
            typeof window !== "undefined" &&
            window.shopify &&
            window.shopify.origin
              ? String(window.shopify.origin)
              : "";
          if (shopifyAdminOrigin.endsWith("/")) {
            shopifyAdminOrigin = shopifyAdminOrigin.slice(0, -1);
          }
          if (!shopifyAdminOrigin) {
            return displayLabel;
          }
          const productAdminId = productNumericMatch[1];
          const variantAdminId = variantNumericMatch[1];
          const productVariantAdminUrl =
            shopifyAdminOrigin +
            "/products/" +
            productAdminId +
            "/variants/" +
            variantAdminId;
          return {
            type: "textLink",
            text: displayLabel,
            href: productVariantAdminUrl
          };
        }
      },
      { key: "productTitle", label: "Product", type: "text", width: "160px", valueAccessor: (row) => row.P?.productTitle },
      { key: "productGraphId", label: "Product ID", type: "text", width: "200px", valueAccessor: (row) => row.P?.productGraphId, overflowEllipsis: true },
      { key: "variantTitle", label: "Variant", type: "text", width: "120px", valueAccessor: (row) => row.P?.variantTitle, overflowEllipsis: true },
      { key: "variantGraphId", label: "Variant ID", type: "text", width: "200px", valueAccessor: (row) => row.P?.variantGraphId, overflowEllipsis: true },
      { key: "sku", label: "SKU", type: "text", width: "100px", valueAccessor: (row) => row.P?.sku },
      { key: "variantSku", label: "Var. SKU", type: "text", width: "100px", valueAccessor: (row) => row.P?.variantSku },
      { key: "vendor", label: "Vendor", type: "text", width: "110px", valueAccessor: (row) => row.P?.vendor },
      { key: "quantity", label: "Qty", type: "number", width: "100px", valueAccessor: (row) => row.P?.quantity },
      { key: "remainingQuantity", label: "Remaining", type: "number", width: "90px", valueAccessor: (row) => row.P?.remainingQuantity },
      { key: "originalUnitAmount", label: "Orig. unit", type: "text", width: "130px", valueAccessor: (row) => { const a = row.P?.originalUnitAmount; const c = row.P?.originalUnitCurrency || ""; return a != null && a !== "" ? String(a) + " " + c : ""; } },
      { key: "discountedUnitAmount", label: "Disc. unit", type: "text", width: "130px", valueAccessor: (row) => { const a = row.P?.discountedUnitAmount; const c = row.P?.discountedUnitCurrency || ""; return a != null && a !== "" ? String(a) + " " + c : ""; } },
      { key: "originalTotalAmount", label: "Orig. total", type: "text", width: "130px", valueAccessor: (row) => { const a = row.P?.originalTotalAmount; const c = row.P?.originalTotalCurrency || ""; return a != null && a !== "" ? String(a) + " " + c : ""; } },
      { key: "discountedTotalAmount", label: "Disc. total", type: "text", width: "130px", valueAccessor: (row) => { const a = row.P?.discountedTotalAmount; const c = row.P?.discountedTotalCurrency || ""; return a != null && a !== "" ? String(a) + " " + c : ""; } },
      { key: "properties", label: "Properties", type: "text", width: "200px", valueAccessor: (row) => row.P?.properties },
      { key: "fulfillmentStatus", label: "Fulfillment", type: "badge", width: "110px", valueAccessor: (row) => row.P?.fulfillmentStatus, badgeToneMap: { FULFILLED: ["Fulfilled", "success"], UNFULFILLED: ["Unfulfilled", "warning"], PARTIALLY_FULFILLED: ["Partial", "info"] } },
      { key: "orderCreatedAt", label: "Order date", type: "date", width: "120px", valueAccessor: (row) => row.P?.orderCreatedAt }
    ]
  },
  sidebar: {
    enabled: true,
    parentVertexLabel: "ShopifyOrderCategory",
    toParentEdgeType: "OrderCategory",
    rootKeys: {},
    label: "Category",
    loadFullTree: true,
    formConfig: {
      gridColumns: 1,
      groups: [
        {
          key: "basic",
          title: "Basic Information",
          gridColumns: 2,
          fields: [
            {
              key: "name",
              label: "Name",
              type: "text",
              required: true,
              maxLength: 255,
              colSpan: 2
            }
          ]
        }
      ]
    }
