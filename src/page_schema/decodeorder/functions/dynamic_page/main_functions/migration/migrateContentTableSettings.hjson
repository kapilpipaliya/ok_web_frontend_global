    { key: "totalPriceShopMoney", label: "Total (shop)", type: "text", width: "120px", valueAccessor: (row) => { const a = row.P?.totalPriceAmount; const c = row.P?.totalPriceCurrency || ""; return a != null && a !== "" ? String(a) + (c ? " " + c : "") : ""; } },
    { key: "subtotalAmount", label: "Subtotal (customer)", type: "text", width: "140px", valueAccessor: (row) => { const pa = row.P?.subtotalPresentmentAmount; const pc = row.P?.subtotalPresentmentCurrency || ""; const sa = row.P?.subtotalAmount; const sc = row.P?.subtotalCurrency || ""; if (pa != null && pa !== "") return String(pa) + (pc ? " " + pc : ""); if (sa != null && sa !== "") return String(sa) + (sc ? " " + sc : ""); return ""; } },
