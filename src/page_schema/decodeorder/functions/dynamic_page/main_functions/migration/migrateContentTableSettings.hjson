{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Migrates or creates default table configuration settings for Book, AudioVideo, Category, ShopifyProduct, Shopify orders/draft orders, Support, and ShopifyShop. Updates existing settings if they already exist.
        body:
          '''
/**
 * Migration: Content Table Settings
 *
 * This migration creates or updates default table configuration settings
 * for Book and AudioVideo content types.
 *
 * Parameters (via args.contextData):
 * - dryRun: boolean (optional) - If true, only report what would be migrated without making changes
 *
 * Returns:
 * - Statistics about the migration
 */

const { dryRun = false } = args.contextData;

console.log(`🚀 Starting content table settings migration (dryRun: ${dryRun})`);

// Define settings configurations
const settingsConfigs = [
  {
    key: 'ShopifyProduct_settings_default',
    tableVertexLabel: 'ShopifyProduct',
    icon: '🛍️',
    name: 'ShopifyProduct',
    config: `return {
  title: "Products",
  label: "Product",
  icon: "carbon:shopping-bag",
  hideExportButtons: true,
  hideImportButtons: true,
  hideSettingsButton: false,
  columns: [
    {
      key: "preview",
      label: "Preview",
      type: "imagePreview",
      width: "100px",
      sortable: false,
      valueAccessor: (row) => {
        // Try to parse media JSON string first
        const mediaStr = row.P?.media || row.media;
        if (mediaStr && typeof mediaStr === 'string') {
          try {
            const mediaArray = JSON.parse(mediaStr);
            if (Array.isArray(mediaArray) && mediaArray.length > 0) {
              // Get first image from media array
              const firstMedia = mediaArray[0];
              if (firstMedia?.preview?.image?.url) {
                return firstMedia.preview.image.url;
              }
              if (firstMedia?.preview?.image?.src) {
                return firstMedia.preview.image.src;
              }
            }
          } catch (e) {
            console.warn("Failed to parse media JSON:", e);
          }
        }
        // Fallback: Try to get the first image from Shopify product images array
        const images = row.P?.images || row.images;
        if (images && Array.isArray(images) && images.length > 0) {
          return images[0].src || images[0].url || images[0];
        }
        // Fallback to featuredImage if available
        return row.P?.featuredImage || row.featuredImage || row.P?.image?.src || row.image?.src || null;
      }
    },
    {
      key: "title",
      label: "Title",
      type: "text",
      width: "250px",
      required: true
    },
    {
      key: "status",
      label: "Status",
      type: "badge",
      width: "120px",
      badgeToneMap: {
        ACTIVE: ["Active", "success"],
        DRAFT: ["Draft", "info"],
        ARCHIVED: ["Archived", "critical"]
      }
    },
    {
      key: "syncStatus",
      label: "Sync",
      type: "badge",
      width: "100px",
      valueAccessor: (row) => row.P?.syncStatus,
      badgeKeyCase: "lower",
      badgeToneMap: {
        complete: ["Synced", "success"],
        queued: ["Syncing", "warning"],
        failed: ["Failed", "critical"]
      },
      badgeTitleAccessor: (row) => row?.P?.syncError || undefined
    },
    {
      key: "createdAt",
      label: "Created",
      type: "date",
      width: "150px",
      valueAccessor: (row) => row.P?.createdAt
    },
    {
      key: "updatedAt",
      label: "Updated",
      type: "date",
      width: "150px",
      valueAccessor: (row) => row.P?.updatedAt
    }
  ],
  rowHeight: 80,
  showRowNumber: true,
  showSelection: true,
  showActions: false,
  showEditButton: false,
  rowClickable: true,
  resizableColumns: true,
  columnWidths: { __selection: "36px", __rowNumber: "36px" },
  formConfig: {
    gridColumns: 2,
    groups: [
      {
        key: "basic",
        title: "Product Details",
        gridColumns: 2,
        fields: [
          {
            key: "title",
            label: "Title",
            type: "text",
            required: true,
            maxLength: 255,
            colSpan: 2
          }
        ]
      }
    ]
  },
  uniqueKeys: [],
  usePolarisUI: true,
  // Filters use Polaris search field (s-search-field) for select and date when usePolarisUI is true
  enableUserScopingForSidebar: false,
  enableUserScopingForContent: false,
  enableLocalFilters: true,
  enableLocalSort: true,
  refetchIntervalWhenQueued: 5000,
  hooks: {
    // Hooks for fetching data - syncs Shopify products when fetching uncategorized
    beforeFetchData: "shopifyProductBeforeFetchData",
    // afterFetchData: ["shopifyProductAfterFetchData", "shopifyProductLogFetch"],
    // Hooks for creating items
    // beforeCreate: "shopifyProductBeforeCreate",
    // Hooks for creating - creates product in Shopify when new product is added
    afterCreate: "shopifyProductAfterCreate",
    // Hooks for updating items
    // beforeUpdate: "shopifyProductBeforeUpdate",
    // Hooks for updating - updates product in Shopify when product is updated
    afterUpdate: "shopifyProductAfterUpdate",
    // Hooks for deleting items
    // beforeDelete: "shopifyProductBeforeDelete",
    // Hooks for deleting - deletes product from Shopify when product is deleted
    afterDelete: "shopifyProductAfterDelete",
    // Hooks for moving items to category
    // beforeMoveItemsToCategory: "shopifyProductBeforeMoveItemsToCategory",
    // Hooks for moving items to category - updates Shopify product tags
    afterMoveItemsToCategory: "shopifyProductAfterMoveItemsToCategory",
    // Hooks for import/export operations
    // beforeImport: "shopifyProductBeforeImport",
    // afterImport: ["shopifyProductAfterImport", "shopifyProductLogImport"],
    // beforeExport: "shopifyProductBeforeExport",
    // afterExport: "shopifyProductAfterExport",
    // Hooks for relationship and vertex operations
    // beforeCreateRelationship: "shopifyProductBeforeCreateRelationship",
    // Hooks for creating relationship - adds category tag to Shopify product
    afterCreateRelationship: "shopifyProductAfterCreateRelationship",
    // beforeGetUserVertices: "shopifyProductBeforeGetUserVertices",
    // afterGetUserVertices: "shopifyProductAfterGetUserVertices",
    // beforeGetVertexChildren: "shopifyProductBeforeGetVertexChildren",
    // afterGetVertexChildren: ["shopifyProductAfterGetVertexChildren", "shopifyProductLogGetChildren"]
  },
  editLink: {
    icon: "carbon:edit",
    getHref: (row) => {
      const raw = row.P?.id ?? '';
      const num = typeof raw === 'number' ? String(raw) : (String(raw).match(/\\/Product\\/(\\d+)$/)?.[1] ?? String(raw).match(/^(\\d+)$/)?.[1] ?? raw);
      const origin = typeof window !== 'undefined' && window.shopify?.origin ? window.shopify.origin : '';
      return \`\${origin}/admin/products/\${num}\`;
    },
    onClick: (row, e) => {
      var productId = row && row.P && row.P.id
      if (productId && typeof window !== "undefined" && window.shopify && window.shopify.intents && window.shopify.intents.invoke) {
        window.shopify.intents.invoke("edit:shopify/Product", { value: productId })
      }
    },
    label: "Products page",
    target: "_top",
    rel: "noopener noreferrer",
    style: "color: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; font-size: 14px;"
  },
  onEdit: (row, args) => {
    var productId = row && row.P && row.P.id
    if (productId && typeof window !== "undefined" && window.shopify && window.shopify.intents && window.shopify.intents.invoke) {
      window.shopify.intents.invoke("edit:shopify/Product", { value: productId })
    }
  },
  onAfterAdd: (result, args) => {
    if (result?.success && result?.data) {
      const productId = result.data.P?.id;
      if (productId && typeof window !== 'undefined' && window.shopify?.config?.shop) {
        const shopDomain = window.shopify.config.shop;
        if (window.shopify?.environment?.embedded && args?.navigate) {
          args.navigate(\`/admin/products/\${productId}\`);
        } else {
          window.open(\`https://\${shopDomain}/admin/products/\${productId}\`, '_blank');
        }
      }
    }
  },
  onAfterEdit: (result, args) => {
    // Optional: Handle after edit action
    // For example, refresh data or navigate
  },
  onAfterDelete: (result, row, args) => {
    // Optional: Handle after delete action
    // For example, refresh data or navigate
  },
  sidebar: {
    enabled: true,
    parentVertexLabel: "ShopifyProductCategory",
    toParentEdgeType: "ProductCategory",
    rootKeys: {},
    label: "Category",
    loadFullTree: true,
    refetchIntervalWhenQueued: 5000,
    formConfig: {
      gridColumns: 1,
      groups: [
        {
          key: "basic",
          title: "Basic Information",
          gridColumns: 2,
          fields: [
            {
              key: "name",
              label: "Name",
              type: "text",
              required: true,
              maxLength: 255,
              colSpan: 2
            }
          ]
        }
      ]
    },
    hooks: {
      // Hooks for creating category - creates collection in Shopify (menu jobs enqueued from within)
      afterCreate: ["shopifyProductCategoryAfterCreate"],
      // Hooks for updating category - updates collection in Shopify (menu jobs enqueued from within)
      afterUpdate: ["shopifyProductCategoryAfterUpdate"],
      // Hooks for deleting category - deletes collection in Shopify (menu jobs enqueued from within)
      afterDelete: ["shopifyProductCategoryAfterDelete"],
      // Hooks for moving category - updates menus when category is moved
      afterMoveCategory: ["shopifyMenuAfterMoveCategory"]
    }
  }
};`
  },
  {
    key: 'ShopifyProductCategory_settings_default',
    tableVertexLabel: 'ShopifyProductCategory',
    icon: '📂',
    name: 'ShopifyProductCategory',
    config: `return {
  title: "Shopify Product Categories",
  columns: [
    {
