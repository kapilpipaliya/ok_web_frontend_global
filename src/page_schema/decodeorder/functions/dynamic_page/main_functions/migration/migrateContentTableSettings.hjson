{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Migrates or creates default table configuration settings for Book, AudioVideo, Category, ShopifyProduct, Shopify orders/draft orders (orders sync includes return data for ShopifyReturn), inventory items, inventory transfers, Support, and ShopifyShop. Updates existing settings if they already exist.
        body:
          '''
/**
 * Migration: Content Table Settings
 *
 * This migration creates or updates default table configuration settings
 * for Book and AudioVideo content types.
 *
 * Parameters (via args.contextData):
 * - dryRun: boolean (optional) - If true, only report what would be migrated without making changes
 *
 * Returns:
 * - Statistics about the migration
 */

const { dryRun = false } = args.contextData;

console.log(`🚀 Starting content table settings migration (dryRun: ${dryRun})`);

// Define settings configurations
const settingsConfigs = [
  {
    key: 'ShopifyProduct_settings_default',
    tableVertexLabel: 'ShopifyProduct',
    icon: '🛍️',
    name: 'ShopifyProduct',
    config: `return {
  title: "Products",
  label: "Product",
  icon: "carbon:shopping-bag",
  hideExportButtons: true,
  hideImportButtons: true,
  hideSettingsButton: false,
  columns: [
    {
      key: "preview",
      label: "Preview",
      type: "imagePreview",
      width: "100px",
      sortable: false,
      valueAccessor: (row) => {
        // Try to parse media JSON string first
        const mediaStr = row.P?.media || row.media;
        if (mediaStr && typeof mediaStr === 'string') {
          try {
            const mediaArray = JSON.parse(mediaStr);
            if (Array.isArray(mediaArray) && mediaArray.length > 0) {
              // Get first image from media array
              const firstMedia = mediaArray[0];
              if (firstMedia?.preview?.image?.url) {
                return firstMedia.preview.image.url;
              }
              if (firstMedia?.preview?.image?.src) {
                return firstMedia.preview.image.src;
              }
            }
          } catch (e) {
            console.warn("Failed to parse media JSON:", e);
          }
        }
        // Fallback: Try to get the first image from Shopify product images array
        const images = row.P?.images || row.images;
        if (images && Array.isArray(images) && images.length > 0) {
          return images[0].src || images[0].url || images[0];
        }
        // Fallback to featuredImage if available
        return row.P?.featuredImage || row.featuredImage || row.P?.image?.src || row.image?.src || null;
      }
    },
    {
      key: "title",
      label: "Title",
      type: "text",
      width: "250px",
      required: true
    },
    {
      key: "status",
      label: "Status",
      type: "badge",
      width: "120px",
      badgeToneMap: {
        ACTIVE: ["Active", "success"],
        DRAFT: ["Draft", "info"],
        ARCHIVED: ["Archived", "critical"]
      }
    },
    {
      key: "syncStatus",
      label: "Sync",
      type: "badge",
      width: "100px",
      valueAccessor: (row) => row.P?.syncStatus,
      badgeKeyCase: "lower",
      badgeToneMap: {
        complete: ["Synced", "success"],
        queued: ["Syncing", "warning"],
        failed: ["Failed", "critical"]
      },
      badgeTitleAccessor: (row) => row?.P?.syncError || undefined
    },
    {
      key: "createdAt",
      label: "Created",
      type: "date",
      width: "150px",
      valueAccessor: (row) => row.P?.createdAt
    },
    {
      key: "updatedAt",
      label: "Updated",
      type: "date",
      width: "150px",
      valueAccessor: (row) => row.P?.updatedAt
    }
  ],
  rowHeight: 80,
  showRowNumber: true,
  showSelection: true,
  showActions: false,
  showEditButton: false,
  rowClickable: true,
  resizableColumns: true,
  columnWidths: { __selection: "36px", __rowNumber: "36px" },
  formConfig: {
    gridColumns: 2,
    groups: [
      {
        key: "basic",
        title: "Product Details",
        gridColumns: 2,
        fields: [
          {
            key: "title",
            label: "Title",
            type: "text",
            required: true,
            maxLength: 255,
            colSpan: 2
          }
        ]
      }
    ]
  },
  uniqueKeys: [],
  usePolarisUI: true,
  // Filters use Polaris search field (s-search-field) for select and date when usePolarisUI is true
  enableUserScopingForSidebar: false,
  enableUserScopingForContent: false,
  enableLocalFilters: true,
  enableLocalSort: true,
  refetchIntervalWhenQueued: 5000,
  hooks: {
    // Hooks for fetching data - syncs Shopify products when fetching uncategorized
    beforeFetchData: "shopifyProductBeforeFetchData",
    // afterFetchData: ["shopifyProductAfterFetchData", "shopifyProductLogFetch"],
    // Hooks for creating items
    // beforeCreate: "shopifyProductBeforeCreate",
    // Hooks for creating - creates product in Shopify when new product is added
    afterCreate: "shopifyProductAfterCreate",
    // Hooks for updating items
    // beforeUpdate: "shopifyProductBeforeUpdate",
    // Hooks for updating - updates product in Shopify when product is updated
    afterUpdate: "shopifyProductAfterUpdate",
    // Hooks for deleting items
    // beforeDelete: "shopifyProductBeforeDelete",
    // Hooks for deleting - deletes product from Shopify when product is deleted
    afterDelete: "shopifyProductAfterDelete",
    // Hooks for moving items to category
    // beforeMoveItemsToCategory: "shopifyProductBeforeMoveItemsToCategory",
    // Hooks for moving items to category - updates Shopify product tags
    afterMoveItemsToCategory: "shopifyProductAfterMoveItemsToCategory",
    // Hooks for import/export operations
    // beforeImport: "shopifyProductBeforeImport",
    // afterImport: ["shopifyProductAfterImport", "shopifyProductLogImport"],
    // beforeExport: "shopifyProductBeforeExport",
    // afterExport: "shopifyProductAfterExport",
    // Hooks for relationship and vertex operations
    // beforeCreateRelationship: "shopifyProductBeforeCreateRelationship",
    // Hooks for creating relationship - adds category tag to Shopify product
    afterCreateRelationship: "shopifyProductAfterCreateRelationship",
    // beforeGetUserVertices: "shopifyProductBeforeGetUserVertices",
    // afterGetUserVertices: "shopifyProductAfterGetUserVertices",
    // beforeGetVertexChildren: "shopifyProductBeforeGetVertexChildren",
    // afterGetVertexChildren: ["shopifyProductAfterGetVertexChildren", "shopifyProductLogGetChildren"]
  },
  editLink: {
    icon: "carbon:edit",
    getHref: (row) => {
      const raw = row.P?.id ?? '';
      const num = typeof raw === 'number' ? String(raw) : (String(raw).match(/\\/Product\\/(\\d+)$/)?.[1] ?? String(raw).match(/^(\\d+)$/)?.[1] ?? raw);
      const origin = typeof window !== 'undefined' && window.shopify?.origin ? window.shopify.origin : '';
      return \`\${origin}/admin/products/\${num}\`;
    },
    onClick: (row, e) => {
      var productId = row && row.P && row.P.id
      if (productId && typeof window !== "undefined" && window.shopify && window.shopify.intents && window.shopify.intents.invoke) {
        window.shopify.intents.invoke("edit:shopify/Product", { value: productId })
      }
    },
    label: "Products page",
    target: "_top",
    rel: "noopener noreferrer",
    style: "color: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; font-size: 14px;"
  },
  onEdit: (row, args) => {
    var productId = row && row.P && row.P.id
    if (productId && typeof window !== "undefined" && window.shopify && window.shopify.intents && window.shopify.intents.invoke) {
      window.shopify.intents.invoke("edit:shopify/Product", { value: productId })
    }
  },
  onAfterAdd: (result, args) => {
    if (result?.success && result?.data) {
      const productId = result.data.P?.id;
      if (productId && typeof window !== 'undefined' && window.shopify?.config?.shop) {
        const shopDomain = window.shopify.config.shop;
        if (window.shopify?.environment?.embedded && args?.navigate) {
          args.navigate(\`/admin/products/\${productId}\`);
        } else {
          window.open(\`https://\${shopDomain}/admin/products/\${productId}\`, '_blank');
        }
      }
    }
  },
  onAfterEdit: (result, args) => {
    // Optional: Handle after edit action
    // For example, refresh data or navigate
  },
  onAfterDelete: (result, row, args) => {
    // Optional: Handle after delete action
    // For example, refresh data or navigate
  },
  sidebar: {
    enabled: true,
    parentVertexLabel: "ShopifyProductCategory",
    toParentEdgeType: "ProductCategory",
    rootKeys: {},
    label: "Category",
    loadFullTree: true,
    refetchIntervalWhenQueued: 5000,
    formConfig: {
      gridColumns: 1,
      groups: [
        {
          key: "basic",
          title: "Basic Information",
          gridColumns: 2,
          fields: [
            {
              key: "name",
              label: "Name",
              type: "text",
              required: true,
              maxLength: 255,
              colSpan: 2
            }
          ]
        }
      ]
    },
    hooks: {
      // Hooks for creating category - creates collection in Shopify (menu jobs enqueued from within)
      afterCreate: ["shopifyProductCategoryAfterCreate"],
      // Hooks for updating category - updates collection in Shopify (menu jobs enqueued from within)
      afterUpdate: ["shopifyProductCategoryAfterUpdate"],
      // Hooks for deleting category - deletes collection in Shopify (menu jobs enqueued from within)
      afterDelete: ["shopifyProductCategoryAfterDelete"],
      // Hooks for moving category - updates menus when category is moved
      afterMoveCategory: ["shopifyMenuAfterMoveCategory"]
    }
  }
};`
  },
  {
    key: 'ShopifyProductCategory_settings_default',
    tableVertexLabel: 'ShopifyProductCategory',
    icon: '📂',
    name: 'ShopifyProductCategory',
    config: `return {
  title: "Shopify Product Categories",
  columns: [
    {
      key: "name",
      label: "Name",
      type: "text",
      width: "200px",
      required: true
    },
    {
      key: "key",
      label: "Key",
      type: "text",
      width: "150px"
    },
    {
      key: "handle",
      label: "Handle",
      type: "text",
      width: "200px"
    }
  ],
  rowHeight: 50,
  showRowNumber: true,
  showSelection: true,
  showActions: true,
  resizableColumns: true,
  columnWidths: { __selection: "36px", __rowNumber: "36px" },
  formConfig: {
    gridColumns: 1,
    groups: [
      {
        key: "basic",
        title: "Basic Information",
        gridColumns: 2,
        fields: [
          {
            key: "name",
            label: "Name",
            type: "text",
            required: true,
            maxLength: 255,
            colSpan: 2
          },
          {
            key: "key",
            label: "Key",
            type: "text",
            maxLength: 100,
            colSpan: 2
          },
          {
            key: "handle",
            label: "Handle",
            type: "text",
            maxLength: 255,
            colSpan: 2
          }
        ]
      }
    ]
  },
  uniqueKeys: [],
  usePolarisUI: true,
  sidebar: {
    enabled: true,
    parentVertexLabel: "ShopifyProductCategory",
    toParentEdgeType: "ParentCategory",
    rootKeys: {},
    label: "Category",
    formConfig: {
      gridColumns: 1,
      groups: [
        {
          key: "basic",
          title: "Basic Information",
          gridColumns: 2,
          fields: [
            {
              key: "name",
              label: "Name",
              type: "text",
              required: true,
              maxLength: 255,
              colSpan: 2
            }
          ]
        }
      ]
    },
    hooks: {
      // Hooks for creating category - creates collection in Shopify (menu jobs enqueued from within)
      afterCreate: ["shopifyProductCategoryAfterCreate"],
      // Hooks for updating category - updates collection in Shopify (menu jobs enqueued from within)
      afterUpdate: ["shopifyProductCategoryAfterUpdate"],
      // Hooks for deleting category - deletes collection in Shopify (menu jobs enqueued from within)
      afterDelete: ["shopifyProductCategoryAfterDelete"],
      // Hooks for moving category - updates menus when category is moved
      afterMoveCategory: ["shopifyMenuAfterMoveCategory"]
    }
  }
};`
  },
  {
    key: 'Support_settings_default',
    tableVertexLabel: 'Support',
    icon: '💬',
    name: 'Support',
    config: `return {
  title: "Support Tickets",
  label: "Support Ticket",
  icon: "carbon:chat",
  hideExportButtons: false,
  hideImportButtons: true,
  hideSettingsButton: false,
  columns: [
    {
      key: "shop",
      label: "Shop",
      type: "text",
      width: "220px"
    },
    {
      key: "subject",
      label: "Subject",
      type: "text",
      width: "260px",
      required: false
    },
    {
      key: "email",
      label: "Email",
      type: "text",
      width: "220px"
    },
    {
      key: "unreadForAdmin",
      label: "Unread",
      type: "number",
      width: "90px"
    },
    {
      key: "createdAt",
      label: "Created",
      type: "date",
      width: "160px",
      valueAccessor: (row) => row.P?.createdAt || row.createdAt
    }
  ],
  rowHeight: 60,
  showRowNumber: true,
  showSelection: false,
  showActions: false,
  showEditButton: false,
  rowClickable: true,
  resizableColumns: true,
  columnWidths: { __rowNumber: "40px" },
  formConfig: null,
  uniqueKeys: [],
  usePolarisUI: false,
  enableUserScopingForSidebar: false,
  enableUserScopingForContent: false,
  enableLocalFilters: true,
  enableLocalSort: true,
  hooks: {},
  sidebar: {
    enabled: false
  },
  onRowClick: (row, args) => {
    const supportTicketVertexId = row?.id;
    if (!supportTicketVertexId) {
      return;
    }
    const basePath = "/ShopifySupportConversation";
    const searchParams = args.searchParams || {};
    const nextParams = { ...searchParams, supportId: supportTicketVertexId };
    const query = Object.entries(nextParams)
      .filter(([, value]) => value != null && value !== "")
      .map(([key, value]) => \`\${encodeURIComponent(key)}=\${encodeURIComponent(String(value))}\`)
      .join("&");
    const href = query ? \`\${basePath}?\${query}\` : basePath;

    if (args.navigate) {
      args.navigate(href);
    } else if (typeof window !== "undefined") {
      window.location.href = href;
    }
  }
};`
  },
  {
    key: 'ShopifyOrder_settings_default',
    tableVertexLabel: 'ShopifyOrder',
    icon: '📦',
    name: 'ShopifyOrder',
    config: `return {
  title: "Orders",
  label: "Order",
  icon: "carbon:shopping-cart",
  hideImportButtons: true,
  hideExportButtons: true,
  hideSettingsButton: false,
  showActions: false,
  showEditButton: false,
  onRowClick: (row, args) => {
    const orderVertexId = row?.P?.id ?? row?.id;
    if (!orderVertexId || typeof window === "undefined") {
      return;
    }
    const shopifyNumericSuffix = /([0-9]+)$/;
    const orderIdMatch = String(orderVertexId).match(shopifyNumericSuffix);
    const numericOrderId = orderIdMatch ? orderIdMatch[1] : "";
    if (!numericOrderId) {
      return;
    }
    let shopifyAdminOrigin =
      window.shopify && window.shopify.origin ? String(window.shopify.origin) : "";
    if (!shopifyAdminOrigin) {
      return;
    }
    if (shopifyAdminOrigin.endsWith("/")) {
      shopifyAdminOrigin = shopifyAdminOrigin.slice(0, -1);
    }
    const orderAdminUrl = shopifyAdminOrigin + "/orders/" + numericOrderId;
    window.open(orderAdminUrl, "_blank", "noopener,noreferrer");
  },
  columns: [
    { key: "name", label: "Order", type: "text", width: "120px", valueAccessor: (row) => row.P?.name },
    { key: "createdAt", label: "Created", type: "date", width: "130px", valueAccessor: (row) => row.P?.createdAt },
    { key: "processedAt", label: "Processed", type: "date", width: "130px", valueAccessor: (row) => row.P?.processedAt },
    { key: "displayFulfillmentStatus", label: "Fulfillment", type: "badge", width: "120px", valueAccessor: (row) => row.P?.displayFulfillmentStatus, badgeKeyCase: "lower", badgeToneMap: { fulfilled: ["Fulfilled", "success"], unfulfilled: ["Unfulfilled", "warning"], partial: ["Partial", "info"], restocked: ["Restocked", "neutral"], pending_fulfillment: ["Pending", "warning"], scheduled: ["Scheduled", "info"], on_hold: ["On hold", "caution"] } },
    { key: "displayFinancialStatus", label: "Payment", type: "badge", width: "120px", valueAccessor: (row) => row.P?.displayFinancialStatus, badgeKeyCase: "lower", badgeToneMap: { paid: ["Paid", "success"], pending: ["Pending", "warning"], authorized: ["Authorized", "info"], partially_paid: ["Partial", "info"], refunded: ["Refunded", "neutral"], voided: ["Voided", "critical"], partially_refunded: ["Part ref", "caution"] } },
    { key: "total", label: "Total", type: "text", width: "130px", valueAccessor: (row) => { const a = row.P?.totalPriceAmount; const c = row.P?.totalPriceCurrency || ""; return a != null && a !== "" ? String(a) + " " + c : ""; } },
    { key: "subtotalAmount", label: "Subtotal", type: "text", width: "130px", valueAccessor: (row) => { const a = row.P?.subtotalAmount; const c = row.P?.subtotalCurrency || ""; return a != null && a !== "" ? String(a) + " " + c : ""; } },
    { key: "totalTaxAmount", label: "Tax", type: "text", width: "90px", valueAccessor: (row) => row.P?.totalTaxAmount },
    { key: "totalShippingAmount", label: "Shipping", type: "text", width: "90px", valueAccessor: (row) => row.P?.totalShippingAmount },
    { key: "lineItemsCount", label: "Lines", type: "number", width: "70px", valueAccessor: (row) => row.P?.lineItemsCount },
    { key: "email", label: "Email", type: "text", width: "200px", valueAccessor: (row) => row.P?.email },
    { key: "phone", label: "Phone", type: "text", width: "120px", valueAccessor: (row) => row.P?.phone },
    { key: "tags", label: "Tags", type: "text", width: "180px", valueAccessor: (row) => row.P?.tags },
    { key: "fullyPaid", label: "Paid", type: "badge", width: "80px", valueAccessor: (row) => (row.P?.fullyPaid ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "success"], no: ["No", "warning"] } },
    { key: "testOrder", label: "Test", type: "badge", width: "70px", valueAccessor: (row) => (row.P?.testOrder ? "test" : "live"), badgeKeyCase: "lower", badgeToneMap: { test: ["Test", "warning"], live: ["Live", "success"] } },
    { key: "closed", label: "Closed", type: "badge", width: "80px", valueAccessor: (row) => (row.P?.closed ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "neutral"], no: ["No", "info"] } },
    { key: "cancelledAt", label: "Cancelled", type: "date", width: "120px", valueAccessor: (row) => row.P?.cancelledAt },
    { key: "closedAt", label: "Closed", type: "date", width: "120px", valueAccessor: (row) => row.P?.closedAt },
    { key: "note", label: "Note", type: "text", width: "220px", valueAccessor: (row) => row.P?.note },
    { key: "confirmationNumber", label: "Confirmation #", type: "text", width: "120px", valueAccessor: (row) => row.P?.confirmationNumber },
    { key: "legacyResourceId", label: "REST id", type: "text", width: "100px", valueAccessor: (row) => row.P?.legacyResourceId },
    { key: "orderNumber", label: "Order #", type: "text", width: "90px", valueAccessor: (row) => row.P?.orderNumber },
    { key: "currencyCode", label: "Currency", type: "text", width: "80px", valueAccessor: (row) => row.P?.currencyCode },
    { key: "presentmentCurrencyCode", label: "Presentment", type: "text", width: "100px", valueAccessor: (row) => row.P?.presentmentCurrencyCode },
    { key: "clientIp", label: "Client IP", type: "text", width: "120px", valueAccessor: (row) => row.P?.clientIp },
    { key: "customerLocale", label: "Locale", type: "text", width: "80px", valueAccessor: (row) => row.P?.customerLocale },
    { key: "poNumber", label: "PO #", type: "text", width: "100px", valueAccessor: (row) => row.P?.poNumber },
    { key: "sourceName", label: "Source", type: "text", width: "100px", valueAccessor: (row) => row.P?.sourceName },
    { key: "sourceIdentifier", label: "Source ID", type: "text", width: "120px", valueAccessor: (row) => row.P?.sourceIdentifier },
    { key: "discountCode", label: "Discount code", type: "text", width: "120px", valueAccessor: (row) => row.P?.discountCode },
    { key: "discountCodes", label: "Discount codes", type: "text", width: "160px", valueAccessor: (row) => row.P?.discountCodes },
    { key: "returnStatus", label: "Return status", type: "text", width: "120px", valueAccessor: (row) => row.P?.returnStatus },
    { key: "returnsCount", label: "Returns #", type: "number", width: "80px", valueAccessor: (row) => row.P?.returnsCount },
    { key: "cancelReason", label: "Cancel reason", type: "text", width: "120px", valueAccessor: (row) => row.P?.cancelReason },
    { key: "confirmed", label: "Inventory reserved", type: "badge", width: "120px", valueAccessor: (row) => (row.P?.confirmed ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "success"], no: ["No", "neutral"] } },
    { key: "edited", label: "Edited", type: "badge", width: "80px", valueAccessor: (row) => (row.P?.edited ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "warning"], no: ["No", "neutral"] } },
    { key: "fulfillable", label: "Fulfillable", type: "badge", width: "100px", valueAccessor: (row) => (row.P?.fulfillable ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "info"], no: ["No", "neutral"] } },
    { key: "refundable", label: "Refundable", type: "badge", width: "100px", valueAccessor: (row) => (row.P?.refundable ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "info"], no: ["No", "neutral"] } },
    { key: "requiresShipping", label: "Req. shipping", type: "badge", width: "110px", valueAccessor: (row) => (row.P?.requiresShipping ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "info"], no: ["No", "neutral"] } },
    { key: "unpaid", label: "Unpaid", type: "badge", width: "80px", valueAccessor: (row) => (row.P?.unpaid ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "warning"], no: ["No", "success"] } },
    { key: "capturable", label: "Capturable", type: "badge", width: "100px", valueAccessor: (row) => (row.P?.capturable ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "warning"], no: ["No", "neutral"] } },
    { key: "canMarkAsPaid", label: "Can mark paid", type: "badge", width: "110px", valueAccessor: (row) => (row.P?.canMarkAsPaid ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "info"], no: ["No", "neutral"] } },
    { key: "canNotifyCustomer", label: "Can notify", type: "badge", width: "100px", valueAccessor: (row) => (row.P?.canNotifyCustomer ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "success"], no: ["No", "neutral"] } },
    { key: "billingAddressMatchesShippingAddress", label: "Bill=ship addr", type: "badge", width: "120px", valueAccessor: (row) => (row.P?.billingAddressMatchesShippingAddress ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "neutral"], no: ["No", "info"] } },
    { key: "customerAcceptsMarketing", label: "Marketing opt-in", type: "badge", width: "130px", valueAccessor: (row) => (row.P?.customerAcceptsMarketing ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "info"], no: ["No", "neutral"] } },
    { key: "taxExempt", label: "Tax exempt", type: "badge", width: "100px", valueAccessor: (row) => (row.P?.taxExempt ? "yes" : "no"), badgeKeyCase: "lower", badgeToneMap: { yes: ["Yes", "info"], no: ["No", "neutral"] } },
