    name: 'ShopifyDraftOrder',
    config: `return {
  title: "Draft orders",
  label: "Draft order",
  icon: "carbon:document-add",
  hideImportButtons: true,
  hideExportButtons: true,
  hideSettingsButton: false,
  showActions: false,
  showEditButton: false,
  onRowClick: (row, args) => {
    const draftOrderVertexId = row?.P?.id ?? row?.id;
    if (!draftOrderVertexId || typeof window === "undefined") {
      return;
    }
    const shopifyNumericSuffix = /([0-9]+)$/;
    const draftOrderIdMatch = String(draftOrderVertexId).match(shopifyNumericSuffix);
    const numericDraftOrderId = draftOrderIdMatch ? draftOrderIdMatch[1] : "";
    if (!numericDraftOrderId) {
      return;
    }
    let shopifyAdminOrigin =
      window.shopify && window.shopify.origin ? String(window.shopify.origin) : "";
    if (!shopifyAdminOrigin) {
      return;
    }
    if (shopifyAdminOrigin.endsWith("/")) {
      shopifyAdminOrigin = shopifyAdminOrigin.slice(0, -1);
    }
    const draftOrderAdminUrl =
      shopifyAdminOrigin + "/draft_orders/" + numericDraftOrderId;
    window.open(draftOrderAdminUrl, "_blank", "noopener,noreferrer");
  },
  columns: [
    { key: "name", label: "Draft", type: "text", width: "120px", valueAccessor: (row) => row.P?.name },
    { key: "status", label: "Status", type: "badge", width: "130px", valueAccessor: (row) => row.P?.status, badgeKeyCase: "lower", badgeToneMap: { open: ["Open", "info"], invoice_sent: ["Invoice sent", "warning"], completed: ["Completed", "success"] } },
