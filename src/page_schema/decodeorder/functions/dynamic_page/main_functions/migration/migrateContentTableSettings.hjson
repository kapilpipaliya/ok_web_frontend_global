      { key: "returnLineItemsJson", label: "ReturnLineItems (JSON)", type: "text", width: "260px", valueAccessor: (row) => row.P?.returnLineItemsJson, overflowEllipsis: true },
      { key: "refundsJson", label: "Refunds (JSON)", type: "text", width: "240px", valueAccessor: (row) => row.P?.refundsJson, overflowEllipsis: true },
      { key: "reverseFulfillmentOrdersJson", label: "ReverseFulfillmentOrders (JSON)", type: "text", width: "280px", valueAccessor: (row) => row.P?.reverseFulfillmentOrdersJson, overflowEllipsis: true },
      { key: "exchangeLineItemsJson", label: "ExchangeLineItems (JSON)", type: "text", width: "260px", valueAccessor: (row) => row.P?.exchangeLineItemsJson, overflowEllipsis: true },
      { key: "id", label: "Return ID", type: "text", width: "220px", valueAccessor: (row) => row.P?.id, overflowEllipsis: true }
      ],
      getNestedRows: (parentRow) => {
        const rowsJson = parentRow?.P?.returnsJson;
        let rows = [];
        try {
          const parsed = JSON.parse(rowsJson || "[]");
          if (Array.isArray(parsed)) {
            rows = parsed
              .map((ret, idx) => {
                const returnLineItems = Array.isArray(ret?.returnLineItems) ? ret.returnLineItems : [];
                const refunds = Array.isArray(ret?.refunds) ? ret.refunds : [];
                const rfos = Array.isArray(ret?.reverseFulfillmentOrders) ? ret.reverseFulfillmentOrders : [];
                const exchanges = Array.isArray(ret?.exchangeLineItems) ? ret.exchangeLineItems : [];
                if (returnLineItems.length === 0) return null;
                return {
                  id: ret?.id || ("return-" + idx),
                  P: {
                    id: ret?.id || "",
                    name: ret?.name || "",
                    status: ret?.status || "",
                    createdAt: ret?.createdAt || "",
                    totalQuantity: ret?.totalQuantity != null ? Number(ret.totalQuantity) : 0,
                    returnLineItemsCount: returnLineItems.length,
                    refundsCount: refunds.length,
                    reverseFulfillmentOrdersCount: rfos.length,
                    exchangeLineItemsCount: exchanges.length,
                    returnLineItemsJson: JSON.stringify(returnLineItems),
                    refundsJson: JSON.stringify(refunds),
                    reverseFulfillmentOrdersJson: JSON.stringify(rfos),
                    exchangeLineItemsJson: JSON.stringify(exchanges)
                  }
                };
              })
              .filter(Boolean);
          }
        } catch (e) {}
        return rows;
      }
    }
  ],
  sidebar: {
    enabled: true,
    parentVertexLabel: "ShopifyOrderCategory",
    toParentEdgeType: "OrderCategory",
    rootKeys: {},
    label: "Category",
    loadFullTree: true,
    formConfig: {
      gridColumns: 1,
      groups: [
        {
          key: "basic",
          title: "Basic Information",
          gridColumns: 2,
          fields: [
            {
              key: "name",
              label: "Name",
              type: "text",
              required: true,
              maxLength: 255,
              colSpan: 2
            }
          ]
        }
      ]
    }
  },
  hooks: {
    beforeFetchData: "shopifyOrderBeforeFetchData"
  }
};`
  },
