{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: ConversationMessage
      }
    },
    {
      id: "2"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 1
        css:
          '''
const messageItem = c.message;
const rowJustify = messageItem ? f.getRowJustify?.(messageItem) : "flex-start";
return `._id {
  display: flex;
  margin-bottom: 0.35rem;
  justify-content: ${rowJustify};
}`;
'''
        props:
          '''
const messageItem = c.message;
if (!messageItem) return { as: "div" };
const messageType = f.getMessageType?.(messageItem) || "customer_message";
const ownMessage = f.isOwnMessage?.(messageItem) === true;
return {
  as: "div",
  "data-message-type": messageType,
  "data-own": ownMessage ? "true" : "false"
};'''
      }
    },
    {
      id: "3"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 1
        css:
          '''
const messageItem = c.message;
const messageType = messageItem ? f.getMessageType?.(messageItem) : "customer_message";
const ownMessage = messageItem ? f.isOwnMessage?.(messageItem) === true : false;
return `._id {
  max-width: 80%;
  padding: 0.5rem 0.75rem;
  border-radius: 0.75rem;
  font-size: 0.875rem;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
}

._id[data-message-type="internal_note"] {
  background: ${t.var.color.background_light_300};
  color: ${t.var.color.text};
  border: 1px dashed ${t.var.color.warning};
}

._id[data-own="true"]:not([data-message-type="internal_note"]) {
  background: ${t.var.color.primary};
  color: ${t.var.color.primary_text};
}

._id[data-own="false"]:not([data-message-type="internal_note"]) {
  background: ${t.var.color.background_light_200};
  color: ${t.var.color.background_light_200_text};
}`;
'''
        props:
          '''
const messageItem = c.message;
if (!messageItem) return { as: "div" };
const messageType = f.getMessageType?.(messageItem) || "customer_message";
const ownMessage = f.isOwnMessage?.(messageItem) === true;
return {
  as: "div",
  "data-message-type": messageType,
  "data-own": ownMessage ? "true" : "false"
};'''
      }
    },
    {
      id: "4"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 1
        props:
          '''
const messageItem = c.message;
return {
  as: "div",
  text: messageItem?.P?.message || ""
};'''
      }
    },
    {
      id: "5"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 2
        css:
          '''
return `._id {
  margin-top: 0.25rem;
  font-size: 0.75rem;
  opacity: 0.8;
}`;
'''
        props:
          '''
const messageItem = c.message;
const createdAt = messageItem?.P?.createdAt;
const messageType = messageItem ? f.getMessageType?.(messageItem) : "";
const label = messageType === "internal_note" ? "Internal • " : "";
return {
  as: "div",
  text:
    label +
    (f.formatMessageTime?.(createdAt) ||
      f.formatTimestamp?.(createdAt) ||
      "")
};'''
      }
    }
  ],
  edges: [
    { id: "e1", T: "Attr", S: "1", E: "2" },
    { id: "e2", T: "Attr", S: "2", E: "3" },
    { id: "e3", T: "Attr", S: "3", E: "4" },
    { id: "e4", T: "Attr", S: "3", E: "5" }
  ]
}