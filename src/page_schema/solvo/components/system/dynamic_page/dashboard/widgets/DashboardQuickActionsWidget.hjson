{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: DashboardQuickActionsWidget
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const widgetConfig = c.props?.widgetConfig || {};
const actions = Array.isArray(widgetConfig.actions) ? widgetConfig.actions : [];
return {
  as: "div",
  loop: true,
  contextName: "quickAction",
  data: actions
};
'''
        css:
          '''
return `._id {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}`;
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const action = c.quickAction || {};
const href = String(action.href || action.to || "").trim();
return {
  as: "button",
  text: action.label || action.key || "Action",
  onClick: () => {
    if (!href || href === "#") return;
    if (action.openInNewTab === true || action.external === true) {
      window.open(href, "_blank", "noopener,noreferrer");
      return;
    }
    _.navigate(href);
  }
};
'''
        css:
          '''
return `._id {
  border: 1px solid ${t.var.color.border};
  background: ${t.var.color.primary};
  color: ${t.var.color.primary_text};
  border-radius: 0.375rem;
  padding: 0.375rem 0.75rem;
  font-size: 0.8125rem;
  cursor: pointer;
}`;
'''
      }
    }
  ]
  edges: [
    { id: "e1", T: "Attr", S: "1", E: "2" }
    { id: "e2", T: "Attr", S: "2", E: "3" }
  ]
}
