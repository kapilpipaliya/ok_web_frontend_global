    }
  ],
  edges: [
    { id: "e1", T: "Attr", S: "1", E: "2" },
    { id: "e_close", T: "Attr", S: "2", E: "close" },
    { id: "e0", T: "Attr", S: "2", E: "c1" },
    { id: "e2", T: "Attr", S: "2", E: "c2" },
    { id: "e4", T: "Attr", S: "2", E: "5" },
    { id: "e5", T: "Attr", S: "2", E: "c3" },
    { id: "e11", T: "Attr", S: "2", E: "c4" },
    { id: "e14", T: "Attr", S: "2", E: "c5" },
    { id: "e17", T: "Attr", S: "2", E: "c6" },
    { id: "ev0", T: "ComponentVariant", S: "1", E: "v0" },
    { id: "ev1", T: "ComponentVariant", S: "1", E: "v1" },
