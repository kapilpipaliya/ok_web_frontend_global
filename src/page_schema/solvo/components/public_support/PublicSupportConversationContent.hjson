{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: PublicSupportConversationContent
        dynamicComponent: ConversationCredentialsNotice, ConversationHeader, ConversationTimeline, ConversationComposer, ConversationStatusBar, ConversationInternalNoteComposer
        fns:
          '''
const [ticketVertex, setTicketVertex] = args.createSignal(null);
const [messages, setMessages] = args.createSignal([]);
const [isLoadingConversation, setIsLoadingConversation] = args.createSignal(false);
const [replyMessageText, setReplyMessageText] = args.createSignal("");
const [internalNoteText, setInternalNoteText] = args.createSignal("");
const [isSendingReply, setIsSendingReply] = args.createSignal(false);
const [isSendingInternalNote, setIsSendingInternalNote] = args.createSignal(false);
const [isBusyStatus, setIsBusyStatus] = args.createSignal(false);
const [showInternalNoteForm, setShowInternalNoteForm] = args.createSignal(false);

// --- useConversationCapabilities ---
const getCapabilities = () => {
  const viewerRole = args.contextData.props?.viewerRole === "customer" ? "customer" : "admin";
  const showInternalNoteProp = args.contextData.props?.showInternalNote !== false;
  return {
    viewerRole,
    useTokenAuth: viewerRole === "customer",
    useTicketIdAuth: viewerRole === "admin",
    markAsReadFor: viewerRole === "customer" ? "customer" : "admin",
    canReply: () => true,
    canReplyWhenClosed: () => false,
    canCloseTicket: () => true,
    canReopenTicket: () => viewerRole === "customer",
    canInternalNote: () => viewerRole === "admin" && showInternalNoteProp,
    canSeeInternalNotes: () => viewerRole === "admin"
  };
};

// --- useConversationAuth ---
const getTicketId = () => {
  const ticketIdFromProps = args.contextData.props?.ticketId;
  if (ticketIdFromProps != null && ticketIdFromProps !== "") {
    return String(ticketIdFromProps);
  }
  const ticketIdFromSearch = args.searchParams?.ticketId || args.searchParams?.supportId;
  if (ticketIdFromSearch != null && ticketIdFromSearch !== "") {
    return String(ticketIdFromSearch);
  }
  return "";
};

const getSerial = () => {
  const serialFromProps = args.contextData.props?.serial;
  if (serialFromProps != null && serialFromProps !== "") {
    return String(serialFromProps).trim();
  }
  if (args.searchParams?.serial) {
    return String(args.searchParams.serial).trim();
  }
  const path = args.location?.pathname || "";
  const prefix = "/support/ticket/";
  if (path.startsWith(prefix)) {
    return decodeURIComponent(path.slice(prefix.length).split("/")[0] || "").trim();
  }
  return "";
};

const getToken = () => {
  const tokenFromProps = args.contextData.props?.token;
  if (tokenFromProps != null && tokenFromProps !== "") {
    return String(tokenFromProps).trim();
  }
  return String(args.searchParams?.token || "").trim();
};

const buildAuthContext = () => {
  const capabilities = getCapabilities();
  if (capabilities.useTokenAuth) {
    return { serial: getSerial(), token: getToken() };
  }
  return { ticketId: getTicketId() };
};

const hasCredentials = () => {
  const capabilities = getCapabilities();
  if (capabilities.useTokenAuth) {
    return Boolean(getSerial() && getToken());
  }
  return Boolean(getTicketId());
};

// --- useConversationMessages ---
const getMessageType = (messageItem) => {
  if (!messageItem?.P) return "customer_message";
  if (messageItem.P.messageType) {
    return String(messageItem.P.messageType);
  }
  if (messageItem.P.internalOnly === true || messageItem.P.senderType === "internal") {
    return "internal_note";
  }
  if (messageItem.P.senderType === "admin") {
    return "admin_reply";
  }
  return "customer_message";
};

const normalizeMessage = (messageItem) => {
  if (!messageItem?.P) return messageItem;
  const messageType = getMessageType(messageItem);
  return {
    ...messageItem,
    P: {
      ...messageItem.P,
      messageType
    }
  };
};

const getViewerIdentity = () => {
  const capabilities = getCapabilities();
  return capabilities.useTokenAuth ? "customer" : "admin";
};

const isOwnMessage = (messageItem) => {
  const messageType = getMessageType(messageItem);
  const viewerIdentity = getViewerIdentity();
  if (messageType === "internal_note") {
    return viewerIdentity === "admin";
  }
  if (messageType === "admin_reply") {
    return viewerIdentity === "admin";
  }
  return viewerIdentity === "customer";
};

const getRowJustify = (messageItem) => {
  const ownMessage = isOwnMessage(messageItem);
  const viewerIdentity = getViewerIdentity();
  if (viewerIdentity === "customer") {
    return ownMessage ? "flex-end" : "flex-start";
  }
  return ownMessage ? "flex-start" : "flex-end";
};

const getVisibleMessages = () => {
  const capabilities = getCapabilities();
  const list = messages() || [];
  if (capabilities.canSeeInternalNotes()) {
    return list;
  }
  return list.filter((messageItem) => getMessageType(messageItem) !== "internal_note");
};

const formatTimestamp = (timestamp) => {
  if (!timestamp) return "";
  try {
    const date = new Date(timestamp);
    const now = new Date();
    const diffMs = now - date;
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);

    if (diffMins < 1) return "Just now";
    if (diffMins < 60) return `${diffMins}m ago`;
    if (diffHours < 24) return `${diffHours}h ago`;
    if (diffDays === 1) return "Yesterday";
    if (diffDays < 7) return `${diffDays}d ago`;
    return date.toLocaleDateString("en-US", { month: "short", day: "numeric" });
  } catch (error) {
    return String(timestamp);
  }
};

const formatMessageTime = (timestamp) => {
  if (!timestamp) return "";
  try {
    const date = new Date(timestamp);
    const now = new Date();
    const isToday = date.toDateString() === now.toDateString();
    if (isToday) {
      return date.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
    }
    return (
      date.toLocaleDateString("en-US", { month: "short", day: "numeric" }) +
      " " +
      date.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" })
    );
  } catch (error) {
    return String(timestamp);
  }
};

const getMetaLineText = () => {
  const ticket = ticketVertex();
  const capabilities = getCapabilities();
  if (!ticket) {
    return capabilities.useTokenAuth
      ? "A valid ticket link is required."
      : "Select a ticket to view the conversation.";
  }
  if (capabilities.useTokenAuth) {
    const status = ticket.P?.status || "open";
    const createdAt = ticket.P?.createdAt || ticket.P?.updatedAt;
    const createdText = formatTimestamp(createdAt);
    return createdText ? `Status: ${status} • Opened ${createdText}` : `Status: ${status}`;
  }
  return `${ticket.P?.customerEmail || ""} • ${ticket.P?.status || "open"} • ${ticket.P?.shop || "—"}`;
};

// --- ticket derived state ---
const getTicketState = () => {
  const ticket = ticketVertex();
  const capabilities = getCapabilities();
  const isClosed = ticket?.P?.status === "closed";
  const canSendMessage =
    capabilities.canReply() && (!isClosed || capabilities.canReplyWhenClosed());
  return {
    isClosed,
    canSendMessage,
    canShowComposer: canSendMessage,
    canCloseTicket: capabilities.canCloseTicket() && !isClosed,
    canReopenTicket: capabilities.canReopenTicket() && isClosed,
    canShowInternalNoteTools: capabilities.canInternalNote()
  };
};

// --- useConversationApi ---
const executeServer = (functionName, contextData) =>
  args.executeNamedServerFunction({ functionName, contextData });

const parseServerResult = (response) => {
  const result = response?.result || response;
  if (response?.error || result?.success === false) {
    return {
      ok: false,
      message: response?.error || result?.message || "Request failed."
    };
  }
  return { ok: true, data: result?.data || {} };
};

const conversationApi = {
  load: async () => {
    const capabilities = getCapabilities();
    return executeServer("publicSupportGetConversation", {
      ...buildAuthContext(),
      markAsReadFor: capabilities.markAsReadFor
    });
  },
  reply: async (message) => {
    const capabilities = getCapabilities();
    if (capabilities.useTokenAuth) {
      return executeServer("publicSupportReplyAsCustomer", {
        ...buildAuthContext(),
        message
      });
    }
    return executeServer("publicSupportReplyAsAdmin", {
      ...buildAuthContext(),
      message
    });
  },
  addInternalNote: async (message) => {
    return executeServer("publicSupportAddInternalNote", {
      ...buildAuthContext(),
      message
    });
  },
  close: async () => {
    const capabilities = getCapabilities();
    const auth = buildAuthContext();
    if (capabilities.useTokenAuth) {
      return executeServer("publicSupportCloseTicket", {
        ...auth,
        closedBy: "customer"
      });
    }
    return executeServer("publicSupportCloseTicket", auth);
  },
  reopen: async () => {
    return executeServer("publicSupportReopenTicket", {
      ...buildAuthContext(),
      reopenedBy: "customer"
    });
  }
};

const loadConversation = async () => {
  if (!hasCredentials()) {
    setTicketVertex(null);
    setMessages([]);
    setIsLoadingConversation(false);
    return;
  }

  setIsLoadingConversation(true);
  try {
    const response = await conversationApi.load();
    const parsed = parseServerResult(response);
    if (!parsed.ok) {
      args.showErrorToast?.(parsed.message || "Failed to load conversation.");
      return;
    }

    const ticket = parsed.data?.ticket || null;
    const apiMessages = Array.isArray(parsed.data?.messages) ? parsed.data.messages : [];

    const allMessages = [];
    const initialMessage = ticket?.P?.initialMessage || ticket?.P?.message;
    if (ticket && initialMessage) {
      allMessages.push(
        normalizeMessage({
          P: {
            message: initialMessage,
            createdAt: ticket.P.createdAt || ticket.P.updatedAt,
            senderType: "customer",
            messageType: "customer_message"
          }
        })
      );
    }
    for (let index = 0; index < apiMessages.length; index++) {
      const messageItem = normalizeMessage(apiMessages[index]);
      const duplicateInitial =
        allMessages.length === 1 &&
        messageItem?.P?.message === initialMessage &&
        getMessageType(messageItem) === "customer_message";
      if (!duplicateInitial) {
        allMessages.push(messageItem);
      }
    }

    setTicketVertex(ticket);
    setMessages(allMessages);
  } catch (error) {
    console.error("PublicSupportConversationContent.loadConversation", error);
    args.showErrorToast?.("Failed to load conversation.");
  } finally {
    setIsLoadingConversation(false);
  }
};

const sendReply = async () => {
  const message = String(replyMessageText() || "").trim();
  const ticketState = getTicketState();
  if (!message || !hasCredentials() || !ticketState.canSendMessage) return;

  setIsSendingReply(true);
  try {
    const response = await conversationApi.reply(message);
    const parsed = parseServerResult(response);
    if (!parsed.ok) {
      args.showErrorToast?.(parsed.message || "Failed to send reply.");
      return;
    }

    const replyVertex = parsed.data?.reply;
    if (replyVertex) {
      setMessages([...(messages() || []), normalizeMessage(replyVertex)]);
    } else {
      await loadConversation();
    }
    setReplyMessageText("");
    args.showSuccessToast?.("Reply sent.");
  } finally {
    setIsSendingReply(false);
  }
};

const addInternalNote = async () => {
  const capabilities = getCapabilities();
  if (!capabilities.canInternalNote()) return;

  const message = String(internalNoteText() || "").trim();
  if (!message || !hasCredentials()) return;

  setIsSendingInternalNote(true);
  try {
    const response = await conversationApi.addInternalNote(message);
    const parsed = parseServerResult(response);
    if (!parsed.ok) {
      args.showErrorToast?.(parsed.message || "Failed to add note.");
      return;
    }
    setInternalNoteText("");
    setShowInternalNoteForm(false);
    await loadConversation();
    args.showSuccessToast?.("Internal note added.");
  } finally {
    setIsSendingInternalNote(false);
  }
};

const closeTicket = async () => {
  const ticketState = getTicketState();
  if (!hasCredentials() || !ticketState.canCloseTicket) return;

  setIsBusyStatus(true);
  setIsSendingReply(true);
  try {
    const response = await conversationApi.close();
    const parsed = parseServerResult(response);
    if (!parsed.ok) {
      args.showErrorToast?.(parsed.message || "Failed to close ticket.");
      return;
    }

    if (parsed.data?.ticket) {
      setTicketVertex(parsed.data.ticket);
    } else {
      await loadConversation();
    }
    args.showSuccessToast?.("Ticket closed.");
  } finally {
    setIsBusyStatus(false);
    setIsSendingReply(false);
  }
};

const reopenTicket = async () => {
  const ticketState = getTicketState();
  if (!hasCredentials() || !ticketState.canReopenTicket) return;

  setIsBusyStatus(true);
  try {
    const response = await conversationApi.reopen();
    const parsed = parseServerResult(response);
    if (!parsed.ok) {
      args.showErrorToast?.(parsed.message || "Failed to reopen ticket.");
      return;
    }

    if (parsed.data?.ticket) {
      setTicketVertex(parsed.data.ticket);
    } else {
      await loadConversation();
    }
    args.showSuccessToast?.("Ticket reopened.");
  } finally {
    setIsBusyStatus(false);
  }
};

args.createEffect(() => {
  if (!hasCredentials()) {
    setTicketVertex(null);
    setMessages([]);
    return;
  }
  void loadConversation();
});

return {
  ticketVertex,
  messages,
  isLoadingConversation,
  replyMessageText,
  setReplyMessageText,
  internalNoteText,
  setInternalNoteText,
  isSendingReply,
  isSendingInternalNote,
  isBusyStatus,
  showInternalNoteForm,
  setShowInternalNoteForm,
  getCapabilities,
  getTicketState,
  conversationApi,
  hasCredentials,
  getMessageType,
  isOwnMessage,
  getRowJustify,
  getVisibleMessages,
  getMetaLineText,
  formatTimestamp,
  formatMessageTime,
  sendReply,
  addInternalNote,
  closeTicket,
  reopenTicket
};
'''
      }
    },
    {
      id: "2"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 1
        key: public_support_conversation_content_root
        css:
          '''
return `._id {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding: ${args.contextData.props?.compact === true ? "0.75rem 1rem 1rem" : "0 0 0.25rem"};
  color: ${args.theme.var.color.text};
  overflow: hidden;
  position: relative;
}`;
'''
        props:
          '''return { as: "div" };'''
      }
    },
    {
      id: "5"
      L: Attr
      P: {
        componentName: LoadingSpinner
        displayOrder: 3
        props:
          '''return {
  size: "medium",
  color: "primary",
  hide: !args.fns.isLoadingConversation?.()
};'''
      }
    },
    {
      id: "close"
      L: Attr
      P: {
        componentName: IconButton
        displayOrder: 0
        css:
          '''
return `._id {
  position: absolute;
  top: 0.5rem;
  right: 0.5rem;
  z-index: 2;
}`;
'''
        props:
          '''
const onClose = args.contextData.props?.onClose;
return {
  hide: args.contextData.props?.showCloseButton !== true,
  icon: "carbon:close",
  width: 22,
  height: 22,
  variant: "ghost",
  ariaLabel: "Close",
  title: "Close",
  onClick: () => onClose?.()
};'''
      }
    },
    {
      id: "c1"
      L: Attr
      P: {
        componentName: ConversationCredentialsNotice
        displayOrder: 1
      }
    },
    {
      id: "c2"
      L: Attr
      P: {
        componentName: ConversationHeader
        displayOrder: 2
        props:
          '''return {
  hideHeader: args.contextData.props?.hideHeader === true
};'''
      }
    },
    {
      id: "c3"
      L: Attr
      P: {
        componentName: ConversationTimeline
        displayOrder: 5
      }
    },
    {
      id: "c4"
      L: Attr
      P: {
        componentName: ConversationComposer
        displayOrder: 6
      }
    },
    {
      id: "c5"
      L: Attr
      P: {
        componentName: ConversationStatusBar
        displayOrder: 7
      }
    },
    {
      id: "c6"
      L: Attr
      P: {
        componentName: ConversationInternalNoteComposer
        displayOrder: 8
      }
    },
    {
      id: "v0"
      L: ComponentVariant
      P: {
        type: string
        key: viewerRole
        defValue: admin
      }
    },
    {
