{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: DashboardDevtools
        fns:
          '''
const TABS = [
  { id: "overview", label: "Overview" },
  { id: "widgets", label: "Widgets" },
  { id: "subscriptions", label: "Subscriptions" },
  { id: "executions", label: "Executions" },
  { id: "timeline", label: "Timeline" },
  { id: "graph", label: "Graph" },
  { id: "cache", label: "Cache" }
];

const [activeTab, setActiveTab] = args.createSignal("overview");
const [filterText, setFilterText] = args.createSignal("");

const getRuntime = () => {
  const fromProps = args.contextData.props?.dashboardRuntime;
  if (typeof fromProps === "function") return fromProps();
  return null;
};

const formatJson = (value) => {
  try {
    return JSON.stringify(value, null, 2);
  } catch (error) {
    return String(value);
  }
};

const countGraphVertices = () => {
  const vertexes = args.graph?.vertexes || {};
  const byLabel = {};
  const ids = Object.keys(vertexes);
  for (let index = 0; index < ids.length; index++) {
    const vertex = vertexes[ids[index]];
    const labels = Array.isArray(vertex?.L) ? vertex.L : [vertex?.L].filter(Boolean);
    for (let li = 0; li < labels.length; li++) {
      const label = String(labels[li]);
      byLabel[label] = (byLabel[label] || 0) + 1;
    }
  }
  return { total: ids.length, byLabel };
};

const buildSnapshot = () => {
  const runtime = getRuntime();
  if (!runtime) return {};
  const widgets = {};
  const widgetList = runtime.widgets || [];
  for (let index = 0; index < widgetList.length; index++) {
    const widget = widgetList[index];
    const ui = runtime.store?.getWidgetState?.(widget.id) || {};
    widgets[widget.id] = {
      type: widget.type,
      widgetStateVertexId: runtime.store?.getWidgetStateVertexId?.(widget.id),
      dataResultVertexId: ui.dataResultVertexId,
      rowVertexIds: ui.rowVertexIds || [],
      lifecycle: ui.lifecycle,
      loading: ui.loading,
      error: ui.error,
      empty: ui.empty,
      dataVersion: ui.dataVersion,
      signatures: runtime.subscriptionGraph?.getWidgetSignatures?.(widget.id) || [],
      logicalKeys: runtime.subscriptionGraph?.getWidgetLogicalKeys?.(widget.id) || []
    };
  }
  const dependencyGraph = (runtime.subscriptionGraph?.getAllSubscriptions?.() || []).map((sub) => ({
    widgetId: sub.widgetId,
    querySignatures: sub.querySignatures,
    logicalKeys: sub.logicalKeys
  }));

  const invalidationId =
    args.searchParams?.invalidationId ||
    args.contextData.props?.waterfallInvalidationId ||
    null;

  const runtimeTimeline = runtime.runtimeEventLog?.getTimeline?.() || [];
  const waterfall = invalidationId
    ? runtime.runtimeEventLog?.getWaterfall?.(invalidationId) || []
    : runtimeTimeline.slice(-60);

  const cacheEntries = [];
  const cache = runtime.dashboardCache;
  if (cache?.widget) {
    for (const [widgetId, row] of cache.widget.entries()) {
      cacheEntries.push({
        widgetId,
        signature: row.lastSignature,
        fetchedAt: row.entry.fetchedAt,
        expiresAt: row.entry.expiresAt,
        expired: row.entry.expiresAt != null && Date.now() > row.entry.expiresAt
      });
    }
  }

  return {
    scope: runtime.runtimeScope,
    lifetimeTree: runtime.lifetimeTree?.getTreeSnapshot?.() || null,
    resourceOwnership: runtime.resourceOwnership?.getSnapshot?.() || [],
    filters: runtime.store?.filters?.(),
    timeRange: runtime.store?.timeRange?.(),
    scheduler: runtime.scheduler?.getState?.() || null,
    compressionPending: runtime.invalidationCompression?.getPending?.() || null,
    executionTimeline: runtime.executionCoordinator?.getTimeline?.() || [],
    runtimeTimeline,
    executionWaterfall: waterfall,
    telemetry: runtime.runtimeTelemetry?.snapshot?.() || runtime.devtools?.snapshot?.()?.telemetry || null,
    dependencyGraph,
    widgets,
    graphStats: countGraphVertices(),
    cacheEntries,
    devtools: runtime.devtools?.snapshot?.() || null
  };
};

const getTabPayload = (tabId) => {
  const snapshot = buildSnapshot();
  if (tabId === "overview") {
    return {
      scope: snapshot.scope,
      filters: snapshot.filters,
      timeRange: snapshot.timeRange,
      scheduler: snapshot.scheduler,
      compressionPending: snapshot.compressionPending,
      telemetry: snapshot.telemetry
    };
  }
  if (tabId === "widgets") return snapshot.widgets;
  if (tabId === "subscriptions") return snapshot.dependencyGraph;
  if (tabId === "executions") {
    return {
      timeline: snapshot.executionTimeline,
      waterfall: snapshot.executionWaterfall
    };
  }
  if (tabId === "timeline") return snapshot.runtimeTimeline;
  if (tabId === "graph") return snapshot.graphStats;
  if (tabId === "cache") return snapshot.cacheEntries;
  return snapshot;
};

const getFilteredTabText = () => {
  const tab = activeTab();
  let payload = getTabPayload(tab);
  const query = String(filterText() || "").trim().toLowerCase();
  if (!query) return formatJson(payload);
  const raw = formatJson(payload);
  const lines = raw.split("\n");
  const matched = lines.filter((line) => line.toLowerCase().includes(query));
  return matched.length > 0 ? matched.join("\n") : formatJson({ tab, message: "No lines matched filter" });
};

const copySnapshot = async () => {
  const text = formatJson(buildSnapshot());
  if (typeof navigator !== "undefined" && navigator.clipboard?.writeText) {
    await navigator.clipboard.writeText(text);
    args.showSuccessToast?.("Devtools snapshot copied");
  }
};

const downloadSnapshot = () => {
  const text = formatJson(buildSnapshot());
  const blob = new Blob([text], { type: "application/json" });
  const url = URL.createObjectURL(blob);
  const anchor = document.createElement("a");
  anchor.href = url;
  anchor.download = `dashboard-devtools-${Date.now()}.json`;
  anchor.click();
  URL.revokeObjectURL(url);
};

return {
  TABS,
  activeTab,
  setActiveTab,
  filterText,
  setFilterText,
  getRuntime,
  formatJson,
  buildSnapshot,
  getTabPayload,
  getFilteredTabText,
  copySnapshot,
  downloadSnapshot
};
'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
