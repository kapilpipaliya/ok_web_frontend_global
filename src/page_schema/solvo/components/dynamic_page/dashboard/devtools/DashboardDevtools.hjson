  background: ${args.theme.var.color.background};
  border-top: 2px solid ${args.theme.var.color.primary};
  box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.15);
  font-family: ui-monospace, monospace;
  font-size: 0.7rem;
}`;
'''
      }
    }
