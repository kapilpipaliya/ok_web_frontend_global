  border-bottom: 1px solid ${args.theme.var.color.border};
  background: ${args.theme.var.color.background_light_100};
}`;
'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
return {
  as: "div",
  loop: true,
  contextName: "devtoolsTab",
  data: args.fns.TABS
};
'''
        css:
          '''
return `._id {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
  padding: 0.375rem 0.75rem;
  border-bottom: 1px solid ${args.theme.var.color.border};
}`;
'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const tab = args.contextData.devtoolsTab;
const isActive = args.fns.activeTab() === tab.id;
return {
  as: "button",
  type: "button",
  text: tab.label,
  onClick: () => args.fns.setActiveTab(tab.id)
};
'''
        css:
          '''
const tab = args.contextData.devtoolsTab;
const isActive = args.fns.activeTab() === tab.id;
return `._id {
  border: 1px solid ${isActive ? args.theme.var.color.primary : args.theme.var.color.border};
  background: ${isActive ? args.theme.var.color.primary_light_200 : args.theme.var.color.background};
  color: ${isActive ? args.theme.var.color.primary_text : args.theme.var.color.text};
  border-radius: 0.25rem;
  padding: 0.2rem 0.5rem;
  font-size: 0.65rem;
  cursor: pointer;
}`;
'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        props:
          '''
return {
  as: "div"
};
'''
        css:
          '''
return `._id {
  display: flex;
  gap: 0.5rem;
  padding: 0.375rem 0.75rem;
  align-items: center;
  border-bottom: 1px solid ${args.theme.var.color.border};
}`;
'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "input",
  type: "text",
  placeholder: "Filter JSON lines…",
  value: args.fns.filterText(),
  onInput: (e) => args.fns.setFilterText(e?.target?.value ?? "")
};
'''
        css:
          '''
return `._id {
