{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: DashboardWidgetShell
        fns:
          '''
const getWidgetConfig = () => args.contextData.props?.widgetConfig || null;
const getRuntime = () => {
  const fromProps = args.contextData.props?.dashboardRuntime;
  if (typeof fromProps === "function") return fromProps();
  return null;
};

const getWidgetUi = () => {
  const widgetConfig = getWidgetConfig();
  const runtime = getRuntime();
  if (!widgetConfig || !runtime?.store) return { loading: true };
  const state = runtime.store.getWidgetState(widgetConfig.id) || { loading: true };
  return {
    ...state,
    widgetStateVertexId: runtime.store.getWidgetStateVertexId(widgetConfig.id)
  };
};

const isCrudWidget = () => getWidgetConfig()?.type === "crudTable";

const isEditMode = () => {
  const runtime = getRuntime();
  return runtime?.isEditMode?.() === true;
};

const canHideWidgets = () => {
  const runtime = getRuntime();
  return isEditMode() && runtime?.config?.personalization?.allowHideWidgets === true;
};

const isWidgetHidden = () => {
  const widgetConfig = getWidgetConfig();
  const runtime = getRuntime();
  if (!widgetConfig || !runtime) return false;
  return runtime.isWidgetHidden?.(widgetConfig.id) === true;
};

const toggleWidgetHidden = () => {
  const widgetConfig = getWidgetConfig();
  const runtime = getRuntime();
  if (!widgetConfig || !runtime?.runtimeApi?.toggleWidgetHidden) return;
  const hidden = runtime.isWidgetHidden?.(widgetConfig.id) === true;
  runtime.runtimeApi.toggleWidgetHidden(widgetConfig.id, !hidden);
};

const refreshWidget = async () => {
  const widgetConfig = getWidgetConfig();
  const runtime = getRuntime();
  if (!widgetConfig || !runtime?.runtimeApi) return;
  if (isCrudWidget()) {
    runtime.runtimeApi.refreshCrudWidget(widgetConfig.id);
    return;
  }
  await runtime.runtimeApi.refreshWidget(widgetConfig.id, {
    reason: "manual_refresh",
    bypassCache: true
  });
};

return {
  getWidgetConfig,
  getRuntime,
  getWidgetUi,
  isCrudWidget,
  isEditMode,
  canHideWidgets,
  isWidgetHidden,
  toggleWidgetHidden,
  refreshWidget
};
'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: widget_shell_root
        props:
          '''
return { as: "section" };
'''
        css:
          '''
const widgetConfig = args.fns.getWidgetConfig();
const theme = widgetConfig?.theme || {};
const surface = theme.surface === "subdued"
  ? args.theme.var.color.background_light_100
  : args.theme.var.color.background;
const hiddenInEdit =
  args.fns.isEditMode?.() === true && args.fns.isWidgetHidden?.() === true;
return `._id {
  display: flex;
  flex-direction: column;
  height: 100%;
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.75rem;
  background: ${surface};
  box-shadow: 0 1px 2px rgba(0,0,0,0.06);
  overflow: hidden;
  ${hiddenInEdit ? `
    opacity: 0.55;
    border-style: dashed;
  ` : ""}
}`;
'''
      }
    }
