return {
  as: "div",
  style: args.fns.getLayoutStyle(widgetConfig),
  class: editMode ? "dashboard-widget-edit-item" : ""
};
'''
        css:
          '''
const editMode = args.fns.isEditMode?.() === true;
return `._id {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 0;
  ${editMode ? `
    outline: 1px solid ${args.theme.var.color.primary_light_300};
    border-radius: 0.5rem;
  ` : ""}
}`;
'''
      }
    }
