{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: DashboardLayoutRenderer
        fns:
          '''
const getRuntime = () => args.contextData.props?.dashboardRuntime?.() || null;

const getLayoutStyle = (widgetConfig) => {
  const runtime = getRuntime();
  if (!runtime) return "";
  const layout = runtime.resolveWidgetLayout(widgetConfig);
  const columns = Number(runtime.config.layout.columns || 12);
  const rowHeight = Number(runtime.config.layout.rowHeight || 80);
  const gap = Number(runtime.config.layout.gap || 16);
  return `
    grid-column: ${layout.x + 1} / span ${layout.w};
    grid-row: ${layout.y + 1} / span ${layout.h};
    min-height: ${layout.h * rowHeight}px;
  `;
};

const isEditMode = () => {
  const runtime = getRuntime();
  return runtime?.isEditMode?.() === true && runtime?.config?.personalization?.allowMoveWidgets !== false;
};

const startLayoutDrag = (widgetConfig, event) => {
  if (!isEditMode()) return;
  event.preventDefault();
  const runtime = getRuntime();
  if (!runtime?.runtimeApi?.updateWidgetLayout) return;
  const startX = event.clientX;
  const startY = event.clientY;
  const startLayout = runtime.resolveWidgetLayout(widgetConfig);
  const columns = Number(runtime.config.layout.columns || 12);
  const rowHeight = Number(runtime.config.layout.rowHeight || 80);
  const gap = Number(runtime.config.layout.gap || 16);
  const gridEl = event.currentTarget?.closest?.("[data-dashboard-grid]");
  const gridWidth = gridEl?.clientWidth || 1200;
  const colStep = (gridWidth - (columns - 1) * gap) / columns + gap;
  let pendingLayout = null;

  const onMove = (moveEvent) => {
    const deltaX = moveEvent.clientX - startX;
    const deltaY = moveEvent.clientY - startY;
    const dx = Math.round(deltaX / colStep);
    const dy = Math.round(deltaY / (rowHeight + gap));
    const nextX = Math.max(0, Math.min(columns - startLayout.w, startLayout.x + dx));
    const nextY = Math.max(0, startLayout.y + dy);
    pendingLayout = { x: nextX, y: nextY, w: startLayout.w, h: startLayout.h };
    runtime.runtimeApi.updateWidgetLayout(widgetConfig.id, pendingLayout, { persist: false });
  };

  const onUp = () => {
    window.removeEventListener("mousemove", onMove);
    window.removeEventListener("mouseup", onUp);
    if (pendingLayout) {
      runtime.runtimeApi.updateWidgetLayout(widgetConfig.id, pendingLayout, { persist: true });
    }
  };
  window.addEventListener("mousemove", onMove);
  window.addEventListener("mouseup", onUp);
};

const startLayoutResize = (widgetConfig, event) => {
  if (!isEditMode()) return;
  event.preventDefault();
  event.stopPropagation();
  const runtime = getRuntime();
  if (!runtime?.runtimeApi?.updateWidgetLayout) return;
  const startX = event.clientX;
  const startY = event.clientY;
  const startLayout = runtime.resolveWidgetLayout(widgetConfig);
  const columns = Number(runtime.config.layout.columns || 12);
  const rowHeight = Number(runtime.config.layout.rowHeight || 80);
  const gap = Number(runtime.config.layout.gap || 16);
  const gridEl = event.currentTarget?.closest?.("[data-dashboard-grid]");
  const gridWidth = gridEl?.clientWidth || 1200;
  const colStep = (gridWidth - (columns - 1) * gap) / columns + gap;
  let pendingLayout = null;

  const onMove = (moveEvent) => {
    const deltaX = moveEvent.clientX - startX;
    const deltaY = moveEvent.clientY - startY;
    const dw = Math.round(deltaX / colStep);
    const dh = Math.round(deltaY / (rowHeight + gap));
    const minW = startLayout.minW || 1;
    const minH = startLayout.minH || 1;
    const nextW = Math.max(minW, Math.min(columns - startLayout.x, startLayout.w + dw));
    const nextH = Math.max(minH, startLayout.h + dh);
    pendingLayout = { x: startLayout.x, y: startLayout.y, w: nextW, h: nextH };
    runtime.runtimeApi.updateWidgetLayout(widgetConfig.id, pendingLayout, { persist: false });
  };

  const onUp = () => {
    window.removeEventListener("mousemove", onMove);
    window.removeEventListener("mouseup", onUp);
    if (pendingLayout) {
      runtime.runtimeApi.updateWidgetLayout(widgetConfig.id, pendingLayout, { persist: true });
    }
  };
  window.addEventListener("mousemove", onMove);
  window.addEventListener("mouseup", onUp);
};

return { getRuntime, getLayoutStyle, isEditMode, startLayoutDrag, startLayoutResize };
'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: dashboard_grid
        props:
          '''
const runtime = args.fns.getRuntime();
const widgets = runtime?.getDisplayWidgets?.() || runtime?.widgets || [];
return {
  as: "div",
  hide: !runtime,
  loop: true,
  contextName: "dashboardWidget",
  data: widgets,
  "data-dashboard-grid": "true"
};
'''
        css:
          '''
const runtime = args.fns.getRuntime();
const columns = Number(runtime?.config?.layout?.columns || 12);
const gap = Number(runtime?.config?.layout?.gap || 16);
const editMode = args.fns.isEditMode?.() === true;
return `._id {
  display: grid;
  grid-template-columns: repeat(${columns}, minmax(0, 1fr));
  gap: ${gap}px;
  width: 100%;
  align-items: stretch;
  ${editMode ? "outline: 1px dashed " + args.theme.var.color.border + ";" : ""}
}`;
'''
      }
    }
