{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: ContentModal
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        css:
          '''
return `._id {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  animation: contentModalFadeIn 0.2s ease;
}

@keyframes contentModalFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@media (max-width: 768px) {
  ._id {
    padding: 0;
    align-items: flex-end;
  }
}`;
'''
        props:
          '''return {
  as: "div",
  hide: args.contextData.props?.isOpen !== true,
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      args.contextData.props?.onClose?.();
    }
  }
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        css:
          '''
const maxWidth = args.contextData.props?.maxWidth || "880px";
return `._id {
  background: ${args.theme.var.color.background};
  border-radius: 0.75rem;
  width: 100%;
  max-width: ${maxWidth};
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.12);
  animation: contentModalSlideUp 0.28s ease;
  overflow: hidden;
}

@keyframes contentModalSlideUp {
  from {
    opacity: 0;
    transform: translateY(16px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-width: 768px) {
  ._id {
    max-width: 100%;
    max-height: 100vh;
    height: 100vh;
    border-radius: 0;
  }
}`;
'''
        props:
          '''return {
  as: "div",
  onClick: (e) => e.stopPropagation()
};'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        css:
          '''
return `._id {
  padding: 1rem 1.25rem;
  border-bottom: 1px solid ${args.theme.var.color.border};
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  flex-shrink: 0;
}`;
'''
        props:
          '''return {
  as: "header",
  hide: args.contextData.props?.showTitle === false
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        css:
          '''
return `._id {
  font-size: 1.125rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
  margin: 0;
  line-height: 1.35;
}`;
'''
        props:
          '''return {
  as: "h2",
  hide: args.contextData.props?.showTitle === false,
  text: args.contextData.props?.title || "Dialog"
};'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
const onClose = args.contextData.props?.onClose;
const usePolaris = args.contextData.props?.usePolarisUI === true;
return {
  as: "icon",
  icon: "carbon:close",
  width: 22,
  height: 22,
  hide: usePolaris,
  onClick: () => onClose?.()
};'''
      }
    }
    {
      id: "6p"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
const onClose = args.contextData.props?.onClose;
return {
  as: "s-button",
  "attr:variant": "plain",
  "attr:icon": "x",
  "attr:accessibilityLabel": "Close",
  hide: args.contextData.props?.usePolarisUI !== true,
  onClick: () => onClose?.()
};'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        css:
          '''
return `._id {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}`;
'''
        props:
          '''return {
  as: "div"
};'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        displayOrder: 1
        slot: children
        componentName: Slot
      }
    }
    {
      id: "v1"
      L: ComponentVariant
      P: {
        type: boolean
        key: isOpen
        defValue: false
      }
    }
    {
      id: "v2"
      L: ComponentVariant
      P: {
        type: function
        key: onClose
      }
    }
    {
      id: "v3"
      L: ComponentVariant
      P: {
        type: string
        key: title
      }
    }
    {
      id: "v4"
      L: ComponentVariant
      P: {
        type: string
        key: maxWidth
        defValue: "880px"
      }
    }
    {
      id: "v5"
      L: ComponentVariant
      P: {
        type: boolean
        key: usePolarisUI
        defValue: false
      }
    }
    {
      id: "v6"
      L: ComponentVariant
      P: {
        type: boolean
        key: showTitle
        defValue: true
      }
    }
  ]
  edges: [
    { id: "e1", T: "Attr", S: "1", E: "2" }
