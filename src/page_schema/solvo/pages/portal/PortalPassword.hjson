{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        signinRequired: true
        fns:
          '''
const [currentPassword, setCurrentPassword] = args.createSignal("");
const [newPassword, setNewPassword] = args.createSignal("");
const [confirmPassword, setConfirmPassword] = args.createSignal("");
const [showCurrent, setShowCurrent] = args.createSignal(false);
const [showNew, setShowNew] = args.createSignal(false);
const [showConfirm, setShowConfirm] = args.createSignal(false);
const [loading, setLoading] = args.createSignal(false);

const policyRowsSpec = [
  { message: "Passwords must be at least 8 characters long.", r: /.{8,}/ },
  { message: "Password must include at least one uppercase letter.", r: /[A-Z]/ },
  { message: "Password must include at least one lowercase letter.", r: /[a-z]/ },
  { message: "Password must include at least one number.", r: /[0-9]/ },
  {
    message: "Password must include at least one special character.",
    r: /[!@#$%^&*(),.?":{}|<>]/
  }
];

const passwordError = (pw) => {
  const s = String(pw || "");
  for (let i = 0; i < policyRowsSpec.length; i++) {
    if (!policyRowsSpec[i].r.test(s)) return policyRowsSpec[i].message;
  }
  return null;
};

const submit = async () => {
  const uuid = args.user?.P?.uuid;
  if (!uuid) {
    args.showErrorToast?.("Not signed in.");
    return;
  }
  const cur = String(currentPassword());
  const neu = String(newPassword());
  const conf = String(confirmPassword());
  if (!cur.trim()) {
    args.showErrorToast?.("Please enter current password");
    return;
  }
  if (!neu.trim()) {
    args.showErrorToast?.("Please enter new password");
    return;
  }
  if (!conf.trim()) {
    args.showErrorToast?.("Please confirm new password");
    return;
  }
  const e1 = passwordError(cur);
  if (e1) {
    args.showErrorToast?.("Current " + e1);
    return;
  }
  const e2 = passwordError(neu);
  if (e2) {
    args.showErrorToast?.("New " + e2);
    return;
  }
  if (neu.trim() !== conf.trim()) {
    args.showErrorToast?.("New and confirm passwords do not match");
    return;
  }
  if (neu.trim() === cur.trim()) {
    args.showErrorToast?.("New password cannot match current password");
    return;
  }
  try {
    setLoading(true);
    await args.postAPI("/api/auth/changePassword", {
      currentPassword: cur,
      newPassword: neu,
      uuid: String(uuid).trim()
    });
    args.showSuccessToast?.("Password changed successfully");
    args.navigate("/auth/signin");
  } catch (e) {
    args.showErrorToast?.(e instanceof Error ? e.message : "Request failed");
  } finally {
    setLoading(false);
  }
};

const getPasswordPolicyRows = () => {
  const pw = String(newPassword());
  const hasInput = pw.length > 0;
  return policyRowsSpec.map((row) => ({
    message: row.message,
    met: row.r.test(pw),
    hasInput
  }));
};

const getPasswordHintTriggerIcon = () => {
  const pw = String(newPassword()).trim();
  if (!pw.length) return "ph:question";
  if (policyRowsSpec.every((x) => x.r.test(pw))) return "ph:check-circle";
  return "ph:warning-circle";
};

const getPasswordHintTriggerTint = () => {
  const pw = String(newPassword()).trim();
  if (!pw.length) return args.theme.var.color.text_light_500;
  if (policyRowsSpec.every((x) => x.r.test(pw))) return args.theme.var.color.success;
  return args.theme.var.color.warning;
};

return {
  currentPassword,
  setCurrentPassword,
  newPassword,
  setNewPassword,
  confirmPassword,
  setConfirmPassword,
  showCurrent,
  setShowCurrent,
  showNew,
  setShowNew,
  showConfirm,
  setShowConfirm,
  loading,
  submit,
  getPasswordPolicyRows,
  getPasswordHintTriggerIcon,
  getPasswordHintTriggerTint
};
'''
        title: Change password
        url: /portal/password
        key: PortalPassword
        props:
          '''return {
  isNoPermissionCheck: true,
  onMount: () => {
    if (!args.user) {
      args.navigate("/auth/signin", { replace: true });
    }
  }
};'''
      }
