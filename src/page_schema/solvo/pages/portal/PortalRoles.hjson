{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns:
          '''
const checkAdminRole = () => {
  const userRoles = args.user?.OUT?.UserRole || [];
  return userRoles.some((edgeId) => {
    const edge = args.graph.edges[edgeId];
    const role = args.graph.vertexes[edge?.E];
    return role?.P?.key === "Admin";
  });
};

return {
  enabled: () => true,
  checkAdminRole,
  executeYTOFunction: (functionName, contextData) =>
    args.executeNamedServerFunction({ functionName, contextData: contextData || {} })
};
'''
        title: Roles
        url: /portal/roles
        key: PortalRoles
        props:
          '''return {
  isNoPermissionCheck: true,
  onMount: () => {
    if (!args.user) {
      args.navigate("/auth/signin", { replace: true });
      return;
    }
    if (!args.fns.checkAdminRole?.()) {
      args.showErrorToast?.("Admin access required");
      args.navigate("/portal/tickets", { replace: true });
    }
  }
};'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        css:
          '''return `._id {
  width: 100%;
  max-width: none;
  margin: 0;
  text-align: left;
}`;'''
        props:
          '''return {
  as: "section"
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 1
        componentName: DynamicPage
        key: portal_roles_dynamic_page
        props:
          '''return {
  tableVertexLabel: "Role",
  tableSettingsLabel: "Role",
  loadFromSetting: true,
  hide: !args.fns.checkAdminRole?.()
};'''
      }
    }
    {
      id: "layout"
      L: PageLayout
      P: {
        componentName: PortalLayout
      }
    }
  ]
  edges: [
    {
      id: e_page_root
      T: Attr
      S: "1"
      E: "2"
    }
    {
      id: e_root_dynamic
      T: Attr
      S: "2"
      E: "5"
    }
    {
      id: e_layout
      T: PageLayout
      S: "1"
      E: "layout"
    }
  ]
}
