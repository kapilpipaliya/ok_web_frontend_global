{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        signinRequired: true
        fns:
          '''
return {
  executeYTOFunction: (functionName, contextData) =>
    s({ functionName, contextData: contextData || {} })
};
'''
        title: My files
        url: /portal/files
        key: PortalFiles
        props:
          '''return {
  isNoPermissionCheck: true,
  onMount: () => {
    if (!_.user) {
      _.navigate("/auth/signin", { replace: true });
    }
  }
};'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        css:
          '''return `._id {
  width: 100%;
  max-width: none;
  margin: 0;
  text-align: left;
}`;'''
        props:
          '''return {
  as: "section"
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 1
        componentName: DynamicPage
        key: portal_files_dynamic_page
        props:
          '''return {
  tableVertexLabel: "File",
  tableSettingsLabel: "FilePortal",
  loadFromSetting: true
};'''
      }
    }
    {
      id: "layout"
      L: PageLayout
      P: {
        componentName: PortalLayout
      }
    }
  ]
  edges: [
    {
      id: e_page_root
      T: Attr
      S: "1"
      E: "2"
    }
    {
      id: e_root_dynamic
      T: Attr
      S: "2"
      E: "5"
    }
    {
      id: e_layout
