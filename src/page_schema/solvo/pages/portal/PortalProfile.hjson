{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        signinRequired: true
        fns:
          '''
const [username, setUsername] = args.createSignal("");
const [email, setEmail] = args.createSignal("");
const [saveLoading, setSaveLoading] = args.createSignal(false);
const [saveSuccess, setSaveSuccess] = args.createSignal(false);

const pendingEmail = () => {
  const p = args.user?.P?.pendingEmail;
  return p != null && String(p).trim() !== "" ? String(p).trim() : "";
};

const syncFromUser = () => {
  const u = args.user?.P;
  if (!u) return;
  setUsername(String(u.username ?? ""));
  setEmail(String(u.email ?? ""));
};

const emailOk = (s) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(s || "").trim());

const saveProfile = async () => {
  const u = args.user?.P;
  if (!u?.uuid) {
    args.showErrorToast?.("Not signed in.");
    return;
  }
  if (!String(username()).trim()) {
    args.showErrorToast?.("Please enter username");
    return;
  }
  if (!String(email()).trim()) {
    args.showErrorToast?.("Please enter email");
    return;
  }
  if (!emailOk(email())) {
    args.showErrorToast?.("Please enter a valid email");
    return;
  }
  try {
    setSaveLoading(true);
    setSaveSuccess(false);
    const res = await args.postAPI("/api/auth/updateProfile", {
      email: String(email()).trim(),
      username: String(username()).trim(),
      uuid: String(u.uuid).trim(),
    });
    args.showSuccessToast?.(
      (typeof res.message === "string" && res.message) || "Profile updated successfully"
    );
    setSaveSuccess(true);
  } catch (e) {
    args.showErrorToast?.(e instanceof Error ? e.message : "Save failed");
  } finally {
    setSaveLoading(false);
  }
};

const resendConfirmation = async () => {
  try {
    const res = await args.postAPI("/api/auth/resendEmailConfirmation", {});
    args.showSuccessToast?.(
      (typeof res.message === "string" && res.message) ||
        "Confirmation email has been resent"
    );
  } catch (e) {
    args.showErrorToast?.(e instanceof Error ? e.message : "Request failed");
  }
};

const profileImageUploadConfiguration = {
  accept: "image/png,image/jpeg,image/jpg,image/webp,image/gif",
  uploadUrl: "/api/file/upload",
  attachUploadedFileToFieldKey: "profileImage",
  hidePreview: false,
  enableDragDrop: true,
  pickButtonLabel: "Change profile photo",
  pickButtonVariant: "secondary",
  fullWidth: false,
  previewMinHeight: "10rem",
  successToastMessage: "File uploaded",
  onUploadSuccess: async ({ uploadedId, callbacks, configuration, syncPreview, showSuccess }) => {
    const fieldKey = configuration.attachUploadedFileToFieldKey;
    if (fieldKey && typeof callbacks.setFieldValue === "function") {
      callbacks.setFieldValue(fieldKey, uploadedId);
    }
    syncPreview(uploadedId);
    showSuccess();
  },
};

const profileImageFormConfiguration = {
  groups: [
    {
      key: "profile_photo",
      title: "Profile photo",
      gridColumns: 1,
      fields: [
        {
          dataType: "file",
          renderer: "graphFileUpload",
          key: "profileImageShopUpload",
          uploadConfiguration: profileImageUploadConfiguration,
        },
        {
          dataType: "relation",
          renderer: "embeddedVertexPicker",
          key: "profileImage",
          label: "Or choose from My files",
          required: true,
          helpText: "Upload an image above, or pick a row in the list below, then press Use selection.",
          selectConfig: {
            label: "File",
            relationshipType: "UserProfileImage",
            edgeOnly: true,
            propertyOnly: false
          },
          pickerConfiguration: {
            fieldLabel: "Or choose from My files",
            chooseButtonLabel: "Select file…",
            clearButtonLabel: "Clear",
            modalTitle: "Choose a file",
            modalHintEmpty: "Select a file using the checkbox, then confirm.",
            modalHintSelected: "Selected: {name} — confirm or choose another file.",
            selectionMode: "single",
            confirmButtonLabel: "Use selection",
            cancelButtonLabel: "Cancel",
            closeButtonLabel: "Close",
            selectRowMessage: "Select a row in the list first.",
            invalidTypeMessage: "This type does not match the configured selection.",
            usePolarisUI: true,
            targetVertexLabels: ["File"],
            fileDownloadUrlPrefix: "/api/file/download",
            showImagePreview: true,
            buildSecondaryLabelFromVertex: true,
            pickerBodyProps: {
              tableVertexLabel: "File",
              tableSettingsLabel: "FilePortal",
              loadFromSetting: true
            }
          }
        }
      ]
    }
  ]
};

const profileImageElementIdFromSavePayload = (savePayload) => {
  const rel = savePayload?.relationships?.profileImage;
  if (rel?.targetIds?.length > 0) {
    const fromRel = String(rel.targetIds[0]).trim();
    if (fromRel !== "") return fromRel;
  }
  const formVertex = savePayload?.vertex;
  const edgeIds = formVertex?.OUT?.UserProfileImage;
  if (Array.isArray(edgeIds) && edgeIds.length > 0) {
    const edge = args.graph?.edges?.[edgeIds[0]];
    if (edge?.E != null && String(edge.E).trim() !== "") {
      return String(edge.E).trim();
    }
  }
  return "";
};

const saveProfileImageForm = async (savePayload) => {
  const formVertex = savePayload?.vertex;
  const selectedProfileImageElementId = profileImageElementIdFromSavePayload(savePayload);
  if (!selectedProfileImageElementId) {
    args.showErrorToast?.("Select or upload a profile photo first.");
    return false;
  }
  const authenticatedUserUuid =
    formVertex?.P?.uuid != null ? String(formVertex.P.uuid).trim() : "";
  if (!authenticatedUserUuid) {
    args.showErrorToast?.("Missing account id.");
    return false;
  }
  try {
    const response = await args.postAPI("/api/auth/updateProfileImage", {
      profileImage: selectedProfileImageElementId,
      uuid: authenticatedUserUuid
    });
    if (response?.graph && typeof response.graph === "object") {
      args.setGraphData(0, response.graph, {});
    }
    args.showSuccessToast?.(
      (typeof response.message === "string" && response.message) || "Profile photo updated"
    );
    return true;
  } catch (error) {
    args.showErrorToast?.(error instanceof Error ? error.message : "Save failed");
    return false;
  }
};

const mergeProfileImageFileVertex = () => {
  const currentUser = args.user;
  if (!currentUser) return;
  const profileImageFileVertex = args.evalExpression("->UserProfileImage", {
    graph: args.graph,
    vertexes: [currentUser],
  })?.[0];
  if (profileImageFileVertex?.id == null) return;
  if (!args.graph.vertexes[profileImageFileVertex.id]) {
    args.setGraphData(0, { vertexes: { [profileImageFileVertex.id]: profileImageFileVertex } }, {});
  }
};

return {
  username,
  setUsername,
  email,
  setEmail,
  saveLoading,
  saveSuccess,
  pendingEmail,
  syncFromUser,
  saveProfile,
  resendConfirmation,
  profileImageFormConfiguration,
  saveProfileImageForm,
  mergeProfileImageFileVertex,
};
'''
        title: Profile
        url: /portal/profile
        key: PortalProfile
        dynamicComponent: FloatingHelpTooltip, VertexPicker, FileUploader, FormManagement
        props:
          '''return {
  isNoPermissionCheck: true,
  onMount: () => {
    if (!args.user) {
      args.navigate("/auth/signin", { replace: true });
      return;
    }
    args.fns.syncFromUser();
    args.fns.mergeProfileImageFileVertex?.();
  }
};'''
      }
    }
