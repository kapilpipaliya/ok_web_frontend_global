        props:
          '''const currentUser = args.user;
const initialUserVertexForProfileImageForm =
  currentUser != null
    ? {
        id: currentUser.id,
        L: currentUser.L,
        IN: currentUser.IN,
        OUT: currentUser.OUT,
        P: args.klona(currentUser.P),
      }
    : null;
return {
  formConfig: args.fns.profileImageFormConfiguration,
  initialVertex: initialUserVertexForProfileImageForm,
  vertexLabel: "User",
  mode: "edit",
  onSave: args.fns.saveProfileImageForm,
  afterSuccessfulSave: "reinitialize",
  hide: initialUserVertexForProfileImageForm == null,
  class: "portal-profile-image-form"
};'''
