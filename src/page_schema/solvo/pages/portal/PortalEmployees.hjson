{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns:
          '''
const checkAdminRole = () => {
  const userRoles = _.user?.OUT?.UserRole || [];
  return userRoles.some((edgeId) => {
    const edge = g.edges[edgeId];
    const role = g.vertexes[edge?.E];
    return role?.P?.key === "Admin";
  });
};

return {
  enabled: () => true,
  checkAdminRole,
  executeYTOFunction: (functionName, contextData) =>
    s({ functionName, contextData: contextData || {} })
};
'''
        title: Employees
        url: /portal/employees
        key: PortalEmployees
        props:
          '''return {
  isNoPermissionCheck: true,
  onMount: () => {
    if (!_.user) {
      _.navigate("/auth/signin", { replace: true });
      return;
    }
    if (!f.checkAdminRole?.()) {
      _.showErrorToast?.("Admin access required");
      _.navigate("/portal/tickets", { replace: true });
    }
  }
};'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        css:
          '''return `._id {
  width: 100%;
  max-width: none;
  margin: 0;
  text-align: left;
}`;'''
        props:
          '''return {
  as: "section"
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 1
        componentName: DynamicPage
        key: portal_employees_dynamic_page
        props:
          '''return {
  tableVertexLabel: "User",
  tableSettingsLabel: "Employee",
  loadFromSetting: true,
  hide: !f.checkAdminRole?.()
};'''
      }
    }
    {
      id: "layout"
      L: PageLayout
      P: {
        componentName: PortalLayout
      }
    }
  ]
  edges: [
    {
      id: e_page_root
      T: Attr
      S: "1"
      E: "2"
    }
    {
      id: e_root_dynamic
      T: Attr
      S: "2"
      E: "5"
    }
    {
      id: e_layout
      T: PageLayout
      S: "1"
      E: "layout"
    }
  ]
}
