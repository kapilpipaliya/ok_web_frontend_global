{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        fns: return { enabled: () => true }
        title: Blogs - Solvo Support Tickets & Helpdesk
        key: Blogs
        url: /blogs
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  max-width: 800px;
  margin: 0 auto;
  padding: ${t.var.spacing?.lg || "2rem"};
  color: ${t.var.color.text};
}

@media (max-width: 768px) {
  ._id {
    padding: ${t.var.spacing?.md || "1rem"};
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div"
}'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 2rem;
  font-weight: 700;
  color: ${t.var.color.text};
  margin: 0 0 1rem 0;
}

@media (max-width: 768px) {
  ._id {
    font-size: 1.75rem;
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "h1",
  text: "Blogs"
}'''
      }
    }
    {
      id: "4"
