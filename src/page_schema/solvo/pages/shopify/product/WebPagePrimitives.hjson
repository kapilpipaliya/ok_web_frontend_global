{
  vertexes: [
    {
      id: "page_root"
      L: Page
      P: {
        key: WebPagePrimitives
        title: Webpage primitives — live reference
        url: /webpage-primitives
        public: true
        fns:
          '''
return {
  enabled: () => true,
  executeYTOFunction: (functionName, contextData) =>
    s({
      functionName,
      contextData: contextData || {}
    })
};
'''
        props:
          '''return { isNoPermissionCheck: true };'''
      }
    }
    {
      id: "meta_desc"
      L: Attr
      P: {
        displayOrder: 0
        componentName: Html
        props:
          '''return {
  as: "meta",
  name: "description",
  content: "Live gallery of every Solvo webpage primitive: props, demos, and example JSON configuration."
};'''
      }
    }
    {
      id: "dynamic_page_attr"
      L: Attr
      P: {
        displayOrder: 1
        componentName: DynamicPage
        key: webpage_primitives_dynamic_page
        props:
          '''
return {
  tableVertexLabel: "WebPagePrimitives",
  tableSettingsLabel: "WebPagePrimitives",
  loadFromSetting: true,
  pageMode: "webpage"
};
'''
      }
    }
  ]
  edges: [
    { id: "e0", T: "Attr", S: "page_root", E: "meta_desc" }
    { id: "e1", T: "Attr", S: "page_root", E: "dynamic_page_attr" }
  ]
}
