        css:
          '''return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${args.theme.var.color.text_light_500};
  margin: 0;
}`;'''
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "p",
  text: "To upgrade, downgrade, or cancel your plan, or to update your payment method, go to Settings > Billing in your Shopify admin."
}'''
