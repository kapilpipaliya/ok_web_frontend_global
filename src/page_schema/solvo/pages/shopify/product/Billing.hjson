        css:
          '''return `._id {
  font-size: 1.25rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
  margin: 0 0 0.5rem 0;
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "h2",
  text: "Manage your subscription"
}'''
