{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        fns: return { enabled: () => true }
        title: Billing - Solvo Support Tickets & Helpdesk
        key: Billing
        url: /billing
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  max-width: 800px;
  margin: 0 auto;
  padding: ${args.theme.var.spacing?.lg || "2rem"};
  color: ${args.theme.var.color.text};
}

@media (max-width: 768px) {
  ._id {
    padding: ${args.theme.var.spacing?.md || "1rem"};
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div"
}'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 2rem;
  font-weight: 700;
  color: ${args.theme.var.color.text};
  margin: 0 0 1rem 0;
}

@media (max-width: 768px) {
  ._id {
    font-size: 1.75rem;
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "h1",
  text: "Billing & plans"
}'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 1rem;
  line-height: 1.6;
  color: ${args.theme.var.color.text_light_500};
  margin-bottom: 1.5rem;
}`;'''
        displayOrder: 2
        textType: markdown
        componentName: Html
        text: Billing for the **Solvo – Support Tickets & Helpdesk** app is managed through your Shopify admin. Your current plan, payment method, and invoices are available in your Shopify billing settings.
        props:
          '''return {
  as: "div",
}'''
      }
    }
    {
      id: "5"
      L: Attr
