{
  vertexes: [
    {
      id: "page_root"
      L: Page
      P: {
        key: SupportOverview
        title: Support Overview
        url: /overview
        fns:
          '''
return {
  enabled: () => true,
  executeYTOFunction: (functionName, contextData) =>
    args.executeNamedServerFunction({
      functionName,
      contextData: contextData || {}
    })
};
'''
        props:
          '''return {
  isNoPermissionCheck: true
};'''
      }
    }
    {
      id: "dynamic_page_attr"
      L: Attr
      P: {
        displayOrder: 1
        componentName: DynamicPage
        key: support_overview_dynamic_page
        props:
          '''
return {
  tableVertexLabel: "SupportOverview",
  tableSettingsLabel: "SupportOverview",
  loadFromSetting: true,
  pageMode: "dashboard"
};
'''
      }
    }
    {
      id: "layout"
      L: PageLayout
      P: {
        componentName: ShopifyLayout
        displayOrder: 1
      }
    }
  ]
  edges: [
    { id: "e1", T: "Attr", S: "page_root", E: "dynamic_page_attr" }
    { id: "e2", T: "PageLayout", S: "page_root", E: "layout" }
  ]
}
