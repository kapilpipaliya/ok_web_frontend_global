{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        key: SolvoPublicSupportTickets
        title: Public Support Tickets
        url: /public-support/tickets
        fns:
          '''
return {
  enabled: () => true,
  executeYTOFunction: (functionName, contextData) =>
    args.executeNamedServerFunction({ functionName, contextData: contextData || {} })
};
'''
        props:
          '''return {
  isNoPermissionCheck: true
};'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        key: public_support_page_root
        componentName: Html
        displayOrder: 1
        fns:
          '''
const [conversationTicketId, setConversationTicketId] = args.createSignal(null);
const [conversationTicketSerial, setConversationTicketSerial] = args.createSignal("");
const [conversationTicketSubject, setConversationTicketSubject] = args.createSignal("");
const [conversationModalOpen, setConversationModalOpen] = args.createSignal(false);

const openConversationForRow = (ticketRow) => {
  const ticketId = ticketRow?.id;
  if (!ticketId) return;
  setConversationTicketId(String(ticketId));
  setConversationTicketSerial(String(ticketRow?.P?.serial || ""));
  setConversationTicketSubject(String(ticketRow?.P?.subject || ""));
  setConversationModalOpen(true);
};

const closeConversationModal = () => {
  setConversationModalOpen(false);
  setConversationTicketId(null);
  setConversationTicketSerial("");
  setConversationTicketSubject("");
};

return {
  conversationTicketId,
  conversationTicketSerial,
  conversationTicketSubject,
  conversationModalOpen,
  openConversationForRow,
  closeConversationModal,
  openConversationInNewTab: (ticketRow) => {
    const ticketId = ticketRow?.id;
    if (!ticketId) return;
    const url = `/public-support/conversation?ticketId=${encodeURIComponent(String(ticketId))}`;
    if (typeof window !== "undefined" && typeof window.open === "function") {
      window.open(url, "_blank", "noopener,noreferrer");
      return;
    }
    args.navigate?.(url);
  }
};
'''
        props:
          '''return {
  as: "section"
};'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        key: public_support_table
        componentName: DynamicPage
        displayOrder: 1
        props:
          '''return {
  tableVertexLabel: "PublicSupportTicket",
  tableSettingsLabel: "PublicSupportTicket",
  loadFromSetting: true,
  rowClickable: true,
  onRowClick: (ticketRow) => args.fns.openConversationForRow?.(ticketRow),
  actionHandlers: {
    conversation: async (ticketRow) => {
      args.fns.openConversationForRow?.(ticketRow);
    }
  }
};'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        key: public_support_conversation_modal
        componentName: ContentModal
        displayOrder: 2
        props:
          '''
const ticketSerial = args.fns.conversationTicketSerial?.();
const ticketSubject = args.fns.conversationTicketSubject?.();
const title = ticketSerial && ticketSubject
  ? `${ticketSerial}: ${ticketSubject}`
  : ticketSerial || "Support conversation";

return {
  isOpen: args.fns.conversationModalOpen?.() === true,
  title,
  showTitle: false,
  usePolarisUI: true,
  onClose: () => args.fns.closeConversationModal?.()
};'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        key: public_support_conversation_content
        slotName: children
        componentName: PublicSupportConversationContent
        displayOrder: 1
        props:
          '''return {
  viewerRole: "admin",
  ticketId: args.fns.conversationTicketId?.(),
  compact: true,
  showCloseButton: true,
  onClose: () => args.fns.closeConversationModal?.()
};'''
      }
    }
    {
      id: "layout"
      L: PageLayout
      P: {
        componentName: ShopifyLayout
      }
    }
  ]
  edges: [
    {
      id: e1
      T: Attr
      S: "1"
      E: "2"
    }
    {
      id: e2
      T: Attr
      S: "2"
      E: "3"
    }
    {
      id: e3
      T: Attr
      S: "2"
      E: "4"
    }
    {
      id: e4
      T: Attr
      S: "4"
      E: "5"
    }
    {
      id: e_layout
      T: PageLayout
      S: "1"
      E: "layout"
    }
  ]
}
