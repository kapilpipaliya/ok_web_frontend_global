{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns:
          '''
const isInIframe = args.atom(false);
const [loading, setLoading] = args.createSignal(false);
const [dashboard, setDashboard] = args.createSignal(null);

const loadDashboard = async () => {
  try {
    setLoading(true);
    const res = await args.executeNamedServerFunction({
      functionName: "getDashboard",
      contextData: {}
    });
    const ok = res?.result?.success !== false && !res?.error;
    if (!ok) {
      args.showErrorToast?.(res?.error || res?.result?.error || "Failed to load dashboard");
      setDashboard(null);
      return;
    }
    setDashboard(res?.result?.data || null);
  } finally {
    setLoading(false);
  }
};

return {
  enabled: () => true,
  isInIframe,
  loading,
  dashboard,
  loadDashboard
};
'''
        title: Dashboard
        key: Dashboard
        url: /app
        props:
          '''return {
  isNoPermissionCheck: true,
  onMount: () => {
    args.fns.isInIframe(window.self !== window.top);
    if (args.fns.isInIframe()) args.fns.loadDashboard();
  }
}'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id{
  max-width: 1100px;
  margin: 0 auto;
  padding: ${args.theme.var.spacing?.lg || "2rem"};
}
@media (max-width: 768px){
  ._id{ padding: ${args.theme.var.spacing?.md || "1rem"}; }
}`;'''
        displayOrder: 1
        componentName: Html
        key: root
        props:
          '''return {
  as: "main",
  hide: !args.fns.isInIframe()
}'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id{
  font-size: 1.75rem;
  font-weight: 700;
  margin: 0 0 0.5rem 0;
  color: ${args.theme.var.color.text};
}`;'''
        displayOrder: 1
        componentName: Html
        key: h1
        props:
          '''return {
  as: "h1",
  text: "Support dashboard"
}'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''return `._id{
  color: ${args.theme.var.color.muted};
  margin: 0 0 1.25rem 0;
  font-size: 0.95rem;
}`;'''
        displayOrder: 2
        componentName: Html
        key: sub
        props:
          '''return {
  as: "p",
  text: ""
}'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id{
  margin: 0 0 1.25rem 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}`;'''
        displayOrder: 3
        componentName: Html
        key: portal_signin
        props:
          '''const d = args.fns.dashboard?.();
const path = d?.portalSignInPath || "";
const href = typeof d?.portalSignInUrl === "string" && d.portalSignInUrl.length > 0 ? d.portalSignInUrl : "";
const show = args.fns.isInIframe() && !!path && !!href && href !== "#";
return {
  as: "s-button",
  "attr:variant": "secondary",
  text: "Portal Signin",
  hide: !show,
  onClick: () => {
    if (href && href !== "#") {
      window.open(href, "_blank", "noopener,noreferrer");
    }
  }
};'''
      }
    }
    {
      id: "6"
      L: PageLayout
      P: {
        componentName: ShopifyLayout
      }
    }
  ]
  edges: [
