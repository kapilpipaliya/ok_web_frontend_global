{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: pollDashboardRealtimeEvents
        description: Polls backend change watermarks and returns invalidation targets for dashboard realtime bridge (no row patching).
        body:
          '''
const actualUser = await args.getUserFromSession();
if (!actualUser) {
  return { success: false, message: "Authentication required", data: null };
}

await args.getEffectiveUser(args.session, actualUser, args.contextData);

const { dashboardKey, channel, watermark, realtimeConfig } = args.contextData || {};
const channelKey = String(channel || realtimeConfig?.channel || "").trim();
if (!channelKey) {
  return { success: false, message: "channel is required", data: null };
}

const nowIso = new Date().toISOString();
const sinceIso =
  typeof watermark === "string" && watermark.trim() !== ""
    ? watermark.trim()
    : new Date(Date.now() - 60000).toISOString();

const CHANNEL_REGISTRY = {
  publicSupportTickets: {
    realtimeLogicalKey: "realtime:publicSupportTickets",
    entities: [
      {
        vertexLabel: "PublicSupportTicket",
        timestampField: "updatedAt",
        logicalKeys: [
          "public_support_tickets",
          "ticket_status_counts",
          "open_tickets_recent",
          "entity:PublicSupportTicket"
        ]
      }
    ]
  }
};

const registry = CHANNEL_REGISTRY[channelKey];
if (!registry) {
  return {
    success: false,
    message: `Unknown realtime channel: ${channelKey}. Register it in CHANNEL_REGISTRY.`,
    data: null
  };
}

const events = [];
const logicalKeySet = new Set([registry.realtimeLogicalKey]);
const querySignatureSet = new Set();

for (let entityIndex = 0; entityIndex < registry.entities.length; entityIndex++) {
  const entityConfig = registry.entities[entityIndex];
  const vertexLabel = entityConfig.vertexLabel;
  const timestampField = entityConfig.timestampField || "updatedAt";
  if (!vertexLabel || !/^[A-Za-z][A-Za-z0-9_]*$/.test(vertexLabel)) continue;
  if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(timestampField)) continue;

  const cypher = `
    MATCH (v:${vertexLabel})
    WHERE v.${timestampField} IS NOT NULL
      AND v.${timestampField} > datetime($sinceIso)
    RETURN elementId(v) AS id, v.${timestampField} AS changedAt
    ORDER BY changedAt DESC
    LIMIT 100
  `;

  let records = [];
  try {
    const result = await args.session.run(cypher, { sinceIso });
    records = result.records || [];
  } catch (error) {
    console.error("pollDashboardRealtimeEvents query error:", vertexLabel, error);
    continue;
  }

  for (let recordIndex = 0; recordIndex < records.length; recordIndex++) {
    const record = records[recordIndex];
    const entityId = record.get("id");
    events.push({
      type: "ENTITY_UPDATED",
      entityType: vertexLabel,
      entityId: entityId != null ? String(entityId) : undefined,
      channel: channelKey,
      changedAt: record.get("changedAt")
    });
  }

  if (records.length > 0) {
    const keys = Array.isArray(entityConfig.logicalKeys) ? entityConfig.logicalKeys : [];
    for (let keyIndex = 0; keyIndex < keys.length; keyIndex++) {
      logicalKeySet.add(String(keys[keyIndex]));
    }
  }
}

const hasChanges = events.length > 0;

return {
  success: true,
  data: {
    watermark: nowIso,
    hasChanges,
    events,
    invalidation: {
      logicalKeys: [...logicalKeySet],
      querySignatures: [...querySignatureSet]
    },
    channel: channelKey,
    dashboardKey: dashboardKey || null,
    polledAt: nowIso,
    since: sinceIso
  }
};
'''
      }
    }
  ]
  edges: []
}
