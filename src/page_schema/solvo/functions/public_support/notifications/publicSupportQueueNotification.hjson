{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: publicSupportQueueNotification
        description: Adds a public support notification event to the BullMQ queue.
        body:
          '''
const queueName = "solvo-public-support-notifications";
const { eventType, ticketId, messageId, serial, assigneeUserId } = c || {};

if (!eventType || !ticketId) {
  return { success: false, message: "eventType and ticketId are required" };
}

const getRedisConnection = () => {
  return _.bullmq.redisConnection || {
    host: process.env.REDIS_HOST || "localhost",
    port: parseInt(process.env.REDIS_PORT || "6379"),
    maxRetriesPerRequest: null,
    enableReadyCheck: false,
    maxLoadingRetryTime: 5000,
    retryStrategy(times) {
      if (times > 3) return null;
      return Math.min(times * 200, 2000);
    }
  };
};

const { Queue } = _.bullmq;
const queue = new Queue(queueName, { connection: getRedisConnection() });

try {
  const safeSerial = String(serial || ticketId).replace(/[^a-z0-9_-]/gi, "-");
  const job = await queue.add(
    "public-support-event",
    {
      eventType,
      ticketId,
      messageId: messageId || null,
      serial: serial || null,
      assigneeUserId: assigneeUserId || null,
      subDomain: _.subDomain,
      rawSubDomain: _.rawSubDomain || null
    },
    {
      attempts: 3,
      backoff: { type: "exponential", delay: 5000 },
      removeOnComplete: 100,
      removeOnFail: false,
      jobId: `${eventType}-${safeSerial}-${Date.now()}`
    }
  );

  return {
    success: true,
    data: { jobId: job?.id, queueName },
    message: "Support notification queued"
  };
} finally {
  try { await queue.close(); } catch {}
}
'''
      }
    }
  ]
  edges: []
}
