{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: publicSupportReplyAsCustomer
        description: Adds a customer reply to a public support ticket using serial and access token.
        body:
          '''
const { serial, token, message, attachments } = c || {};
const safeSerial = String(serial || "").trim();
const safeToken = String(token || "").trim();
const safeMessage = String(message || "").trim().slice(0, 8000);

if (!safeSerial || !safeToken) {
  return { success: false, message: "Ticket serial and token are required." };
}
if (!safeMessage) {
  return { success: false, message: "Reply message is required." };
}

const result = await _.session.run(
  `
  MATCH (t:PublicSupportTicket {serial: $serial, ticketAccessToken: $token})
  WHERE coalesce(t.status, 'open') <> 'closed'
  CREATE (m:PublicSupportMessage {
    ticketSerial: t.serial,
    senderType: 'customer',
    authorName: t.customerName,
    authorEmail: t.customerEmail,
    message: $message,
    attachmentsJson: $attachmentsJson,
    createdAt: $now,
    updatedAt: $now
  })
  CREATE (t)-[:PublicSupportTicketMessage]->(m)
  SET t.updatedAt = $now,
      t.lastMessageAt = $now,
      t.lastMessageSender = 'customer',
      t.unreadForAdmin = coalesce(t.unreadForAdmin, 0) + 1
  RETURN t, m
  `,
  {
    serial: safeSerial,
    token: safeToken,
    message: safeMessage,
    attachmentsJson: JSON.stringify(attachments || []),
    now: new Date().toISOString()
  }
);

if (!result.records || result.records.length === 0) {
  return { success: false, message: "Ticket not found or already closed." };
}

const ticket = _.convertNodeToJson(result.records[0].get("t"));
const reply = _.convertNodeToJson(result.records[0].get("m"));

try {
  await s({
    functionName: "publicSupportQueueNotification",
    contextData: {
      eventType: "customer_replied",
      ticketId: ticket.id,
      messageId: reply.id,
      serial: ticket.P?.serial
    }
  });
} catch (e) {
  console.error("publicSupportReplyAsCustomer: failed to queue notification", e);
}

return {
  success: true,
  message: "Reply sent successfully.",
  data: { ticket, reply }
};
'''
      }
    }
  ]
  edges: []
}
