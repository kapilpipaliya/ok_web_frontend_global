{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: publicSupportAddInternalNote
        description: Adds an admin-only internal note to a public support ticket.
        body:
          '''
const { ticketId, serial, message } = args.contextData || {};
const safeMessage = String(message || "").trim().slice(0, 8000);

if (!safeMessage) return { success: false, message: "Internal note is required." };

const user = args.getUserFromSession ? await args.getUserFromSession() : null;
if (!user) return { success: false, message: "Admin access is required." };

const authorEmail = String(user.P?.email || "support@localhost").slice(0, 320);
const authorName = String(user.P?.name || user.P?.username || "Support").slice(0, 160);
const now = new Date().toISOString();

let result;
if (ticketId) {
  result = await args.session.run(
    `
    MATCH (t:PublicSupportTicket)
    WHERE elementId(t) = $ticketId
    CREATE (m:PublicSupportMessage {
      ticketSerial: t.serial,
      senderType: 'internal',
      internalOnly: true,
      authorName: $authorName,
      authorEmail: $authorEmail,
      message: $message,
      createdAt: $now,
      updatedAt: $now
    })
    CREATE (t)-[:PublicSupportTicketMessage]->(m)
    SET t.updatedAt = $now
    RETURN t, m
    `,
    { ticketId: String(ticketId), authorName, authorEmail, message: safeMessage, now }
  );
} else if (serial) {
  result = await args.session.run(
    `
    MATCH (t:PublicSupportTicket {serial: $serial})
    CREATE (m:PublicSupportMessage {
      ticketSerial: t.serial,
      senderType: 'internal',
      internalOnly: true,
      authorName: $authorName,
      authorEmail: $authorEmail,
      message: $message,
      createdAt: $now,
      updatedAt: $now
    })
    CREATE (t)-[:PublicSupportTicketMessage]->(m)
    SET t.updatedAt = $now
    RETURN t, m
    `,
    { serial: String(serial), authorName, authorEmail, message: safeMessage, now }
  );
} else {
  return { success: false, message: "ticketId or serial is required." };
}

if (!result.records || result.records.length === 0) {
  return { success: false, message: "Support ticket not found." };
}

return {
  success: true,
  message: "Internal note added.",
  data: {
    ticket: args.convertNodeToJson(result.records[0].get("t")),
    note: args.convertNodeToJson(result.records[0].get("m"))
  }
};
'''
      }
    }
  ]
  edges: []
}
