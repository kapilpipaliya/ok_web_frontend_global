{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: publicSupportGetConversation
        description: Loads a public support ticket conversation by secure token or admin ticket id.
        body:
          '''
const { serial, token, ticketId, markAsReadFor } = args.contextData || {};

const normalizedSerial = serial ? String(serial).trim() : "";
const normalizedToken = token ? String(token).trim() : "";
const normalizedTicketId = ticketId ? String(ticketId).trim() : "";

let result;
if (normalizedToken && normalizedSerial) {
  result = await args.session.run(
    `
    MATCH (t:PublicSupportTicket {serial: $serial, ticketAccessToken: $token})
    OPTIONAL MATCH (t)-[:PublicSupportTicketMessage]->(m:PublicSupportMessage)
    WHERE m IS NULL OR coalesce(m.internalOnly, false) <> true
    RETURN t, m
    ORDER BY m.createdAt ASC
    `,
    { serial: normalizedSerial, token: normalizedToken }
  );
} else if (normalizedTicketId) {
  const user = args.getUserFromSession ? await args.getUserFromSession() : null;
  if (!user) {
    return { success: false, message: "Admin access is required." };
  }
  result = await args.session.run(
    `
    MATCH (t:PublicSupportTicket)
    WHERE elementId(t) = $ticketId
    OPTIONAL MATCH (t)-[:PublicSupportTicketMessage]->(m:PublicSupportMessage)
    RETURN t, m
    ORDER BY m.createdAt ASC
    `,
    { ticketId: normalizedTicketId }
  );
} else {
  return { success: false, message: "serial/token or ticketId is required." };
}

if (!result.records || result.records.length === 0) {
  return { success: false, message: "Support ticket not found." };
}

const ticketNode = result.records[0].get("t");
const ticket = ticketNode ? args.convertNodeToJson(ticketNode) : null;
const messages = [];
for (let i = 0; i < result.records.length; i++) {
  const mNode = result.records[i].get("m");
  if (!mNode) continue;
  messages.push(args.convertNodeToJson(mNode));
}

if (ticket?.id && (markAsReadFor === "customer" || markAsReadFor === "admin")) {
  try {
    if (markAsReadFor === "customer") {
      await args.session.run(
        `MATCH (t:PublicSupportTicket) WHERE elementId(t) = $ticketId SET t.unreadForCustomer = 0 RETURN t`,
        { ticketId: ticket.id }
      );
    } else {
      await args.session.run(
        `MATCH (t:PublicSupportTicket) WHERE elementId(t) = $ticketId SET t.unreadForAdmin = 0 RETURN t`,
        { ticketId: ticket.id }
      );
    }
  } catch (e) {
    console.warn("publicSupportGetConversation: failed to mark read", e);
  }
}

return {
  success: true,
  data: {
    ticket,
    messages
  },
  message: "Support conversation loaded."
};
'''
      }
    }
  ]
  edges: []
}
