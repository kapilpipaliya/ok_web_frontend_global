async function ensureGlobalSetting() {
  if (dryRun) return;
  await args.session.run(
    `
    MERGE (g:GlobalSetting {key: 'Default'})
    ON CREATE SET g.createdAt = datetime(), g.name = 'Default'
    SET g.updatedAt = datetime()
    RETURN g
    `
  );
}

async function processSetting(setting) {
  const { key, tableVertexLabel, icon, name, config } = setting;
  const checkResult = await args.session.run(`MATCH (s:Setting {key: $key}) RETURN s`, { key });
  const exists = checkResult.records.length > 0;

  if (!dryRun) {
    if (exists) {
      await args.session.run(
        `MATCH (s:Setting {key: $key})
         SET s.config = $config,
             s.type = 'table_config',
             s.tableVertexLabel = $tableVertexLabel,
             s.icon = $icon,
             s.name = $name,
             s.updatedAt = datetime()
         RETURN s`,
        { key, tableVertexLabel, icon, name, config }
      );
    } else {
      await args.session.run(
        `CREATE (s:Setting {
          key: $key,
          type: 'table_config',
          tableVertexLabel: $tableVertexLabel,
          config: $config,
          icon: $icon,
          name: $name,
          createdAt: datetime(),
          updatedAt: datetime()
        })
        RETURN s`,
        { key, tableVertexLabel, icon, name, config }
      );
    }
  }

  return exists ? { created: 0, updated: 1 } : { created: 1, updated: 0 };
}

async function processSettingsPageConfig(setting) {
  const { key, settingsPageId, name, config } = setting;
  const checkResult = await args.session.run(`MATCH (s:Setting {key: $key}) RETURN s`, { key });
  const exists = checkResult.records.length > 0;

  if (!dryRun) {
    if (exists) {
      await args.session.run(
        `MATCH (s:Setting {key: $key})
         SET s.config = $config,
             s.type = 'settings_page_config',
             s.settingsPageId = $settingsPageId,
             s.name = $name,
             s.updatedAt = datetime()
         RETURN s`,
        { key, settingsPageId, name, config }
      );
    } else {
      await args.session.run(
        `CREATE (s:Setting {
          key: $key,
          type: 'settings_page_config',
          settingsPageId: $settingsPageId,
          config: $config,
          name: $name,
          createdAt: datetime(),
          updatedAt: datetime()
        })
        RETURN s`,
        { key, settingsPageId, name, config }
      );
    }
  }

  return exists ? { created: 0, updated: 1 } : { created: 1, updated: 0 };
}

async function processDefaultSectionDocument(doc) {
  if (dryRun) {
    return { created: 1, updated: 0 };
  }
  const valuesJson = JSON.stringify(doc.values || {});
  const result = await args.session.run(
    `
    MATCH (g:GlobalSetting {key: 'Default'})
    OPTIONAL MATCH (g)-[:GlobalSettingHasSettingsSection]->(existing:SettingsSectionDocument {pageId: $pageId, sectionId: $sectionId})
    WITH g, existing
    FOREACH (_ IN CASE WHEN existing IS NULL THEN [1] ELSE [] END |
      CREATE (g)-[:GlobalSettingHasSettingsSection]->(:SettingsSectionDocument {
        pageId: $pageId,
        sectionId: $sectionId,
        scopeVertexLabel: 'GlobalSetting',
        scopeId: 'Default',
        values: $valuesJson,
        version: 1,
        createdAt: $now,
        updatedAt: $now,
        createdBy: 'migration',
        updatedBy: 'migration'
      })
    )
    RETURN existing IS NULL AS created
    `,
    { pageId: doc.pageId, sectionId: doc.sectionId, valuesJson, now: nowIso() }
  );

  const created = result.records[0]?.get("created") === true;
  return created ? { created: 1, updated: 0 } : { created: 0, updated: 0 };
}

const SEED_TICKET_SOURCE = "migration_seed";
const SEED_STATUSES = ["open", "pending", "closed"];
const SEED_SUBJECTS = [
  "Order not received",
  "Wrong item shipped",
  "Refund request",
  "Damaged product",
  "Shipping delay",
  "Account login issue",
  "Discount code not working",
  "Cancel order",
  "Exchange size",
  "Billing question"
];
const SEED_FIRST_NAMES = ["Alex", "Jordan", "Sam", "Taylor", "Morgan", "Casey", "Riley", "Jamie", "Avery", "Quinn"];
const SEED_LAST_NAMES = ["Lee", "Patel", "Garcia", "Kim", "Nguyen", "Brown", "Davis", "Wilson", "Martinez", "Clark"];
const SEED_MESSAGES = [
  "Hi, I placed an order last week and have not received a shipping confirmation yet.",
  "The package arrived but one item was missing from the box.",
  "I would like to return this item and get a refund to my original payment method.",
  "The product arrived with visible damage on the corner.",
  "Tracking has not updated in several days — can you check with the carrier?",
  "I cannot log into my account after resetting my password.",
  "The promo code from your newsletter says it is invalid at checkout.",
  "Please cancel order #{{order}} before it ships.",
  "I need to exchange for a different size if possible.",
  "I was charged twice for the same order — please advise."
];

const randomInt = (min, max) => min + Math.floor(Math.random() * (max - min + 1));

const randomIsoInYear = (year) => {
  const start = Date.UTC(year, 0, 1);
  const end = Date.UTC(year + 1, 0, 1);
  return new Date(start + Math.floor(Math.random() * (end - start))).toISOString();
};

const pick = (arr) => arr[randomInt(0, arr.length - 1)];

async function seedPublicSupportTickets() {
  const targetCount = Math.max(0, Math.min(Number(seedTicketCount) || 0, 10000));
  if (!seedTickets || targetCount === 0) {
    return { seeded: 0, skipped: true, reason: "disabled" };
  }

  const existingResult = await args.session.run(
    `MATCH (t:PublicSupportTicket {source: $source}) RETURN count(t) AS c`,
    { source: SEED_TICKET_SOURCE }
  );
  const rawExisting = existingResult.records[0]?.get("c");
  const existing = typeof rawExisting?.toNumber === "function" ? rawExisting.toNumber() : Number(rawExisting || 0);

  if (!forceReseedTickets && existing >= targetCount) {
    return { seeded: 0, skipped: true, reason: "already_seeded", existing, targetCount };
  }

  const toCreate = forceReseedTickets ? targetCount : targetCount - existing;
  const seedYear = new Date().getFullYear();
  const serialPrefix = "SOL";

  if (dryRun) {
    return {
      seeded: 0,
      wouldSeed: toCreate,
      skipped: false,
      existing,
      targetCount,
      seedYear
    };
  }

  if (forceReseedTickets && existing > 0) {
    await args.session.run(
      `
      MATCH (t:PublicSupportTicket {source: $source})
      OPTIONAL MATCH (t)-[:PublicSupportTicketMessage]->(m:PublicSupportMessage)
      DETACH DELETE m, t
      `,
      { source: SEED_TICKET_SOURCE }
    );
  }

  const startIndex = forceReseedTickets ? 1 : existing + 1;
  const BATCH_SIZE = 50;
  let seeded = 0;

  for (let offset = 0; offset < toCreate; offset += BATCH_SIZE) {
    const batchLen = Math.min(BATCH_SIZE, toCreate - offset);
    const batch = [];
    for (let b = 0; b < batchLen; b++) {
      const idx = startIndex + offset + b;
      const serial = `${serialPrefix}-SEED-${String(idx).padStart(6, "0")}`;
      const token = args.crypto.randomBytes(16).toString("hex");
      const status = pick(SEED_STATUSES);
      const createdAt = randomIsoInYear(seedYear);
      const subject = pick(SEED_SUBJECTS);
      const customerName = `${pick(SEED_FIRST_NAMES)} ${pick(SEED_LAST_NAMES)}`;
      const customerEmail = `seed.customer${idx}@example.com`;
      const orderNumber = Math.random() < 0.65 ? `#${1000 + randomInt(1, 99999)}` : "";
      const messageTemplate = pick(SEED_MESSAGES);
      const initialMessage = messageTemplate.replace("{{order}}", orderNumber || "unknown");
      const unreadForAdmin = status === "open" && Math.random() < 0.35 ? 1 : 0;
      batch.push({
        serial,
        token,
        status,
        subject,
        customerName,
        customerEmail,
        orderNumber,
        initialMessage,
        createdAt,
        updatedAt: createdAt,
        lastMessageAt: createdAt,
        trackingUrl: `/support/ticket?serial=${encodeURIComponent(serial)}&token=${encodeURIComponent(token)}`,
        emailThreadSubject: `[${serial}] ${subject}`,
        unreadForAdmin,
        unreadForCustomer: 0,
        fieldsJson: "{}",
        attachmentsJson: "[]"
      });
    }

    await args.session.run(
      `
      UNWIND $batch AS row
      CREATE (t:PublicSupportTicket {
        serial: row.serial,
        ticketAccessToken: row.token,
        status: row.status,
        subject: row.subject,
        customerName: row.customerName,
        customerEmail: row.customerEmail,
        orderNumber: row.orderNumber,
        initialMessage: row.initialMessage,
        fieldsJson: row.fieldsJson,
        source: $source,
        sourceUrl: '',
        trackingUrl: row.trackingUrl,
        emailThreadSubject: row.emailThreadSubject,
        unreadForAdmin: row.unreadForAdmin,
        unreadForCustomer: row.unreadForCustomer,
        lastMessageSender: 'customer',
        createdAt: datetime(row.createdAt),
        updatedAt: datetime(row.updatedAt),
        lastMessageAt: datetime(row.lastMessageAt)
      })
      CREATE (m:PublicSupportMessage {
        ticketSerial: row.serial,
        senderType: 'customer',
        authorName: row.customerName,
        authorEmail: row.customerEmail,
        message: row.initialMessage,
        attachmentsJson: row.attachmentsJson,
        createdAt: datetime(row.createdAt),
        updatedAt: datetime(row.updatedAt)
      })
      CREATE (t)-[:PublicSupportTicketMessage]->(m)
      `,
      { batch, source: SEED_TICKET_SOURCE }
    );
    seeded += batchLen;
  }

  return { seeded, skipped: false, existing, targetCount, seedYear };
}

const stats = {
  created: 0,
  updated: 0,
  total: settingsConfigs.length + settingsPageConfigs.length + defaultSectionDocuments.length,
  tableConfigs: settingsConfigs.length,
  settingsPageConfigs: settingsPageConfigs.length,
  defaultSectionDocuments: defaultSectionDocuments.length
};

await ensureGlobalSetting();

for (let i = 0; i < settingsConfigs.length; i++) {
  const r = await processSetting(settingsConfigs[i]);
  stats.created += r.created;
  stats.updated += r.updated;
}

for (let j = 0; j < settingsPageConfigs.length; j++) {
  const r = await processSettingsPageConfig(settingsPageConfigs[j]);
  stats.created += r.created;
  stats.updated += r.updated;
}

for (let k = 0; k < defaultSectionDocuments.length; k++) {
  const r = await processDefaultSectionDocument(defaultSectionDocuments[k]);
  stats.created += r.created;
  stats.updated += r.updated;
}

const ticketSeedStats = await seedPublicSupportTickets();
stats.ticketSeed = ticketSeedStats;

const ticketSeedNote = ticketSeedStats.skipped
  ? ticketSeedStats.reason === "already_seeded"
    ? ` Tickets: ${ticketSeedStats.existing} seed rows already present (skipped).`
    : ""
  : dryRun
    ? ` Would seed ${ticketSeedStats.wouldSeed || 0} tickets across ${ticketSeedStats.seedYear}.`
    : ` Seeded ${ticketSeedStats.seeded || 0} tickets across ${ticketSeedStats.seedYear}.`;

return {
  success: true,
  message: (dryRun
    ? `Solvo settings migration dry run. Would touch ${stats.total} settings.`
    : `Solvo settings migration complete. Created ${stats.created}, updated ${stats.updated}.`) + ticketSeedNote,
  stats
};
'''
