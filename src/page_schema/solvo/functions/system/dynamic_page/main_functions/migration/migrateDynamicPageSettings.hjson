{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: migrateDynamicPageSettings
        description: Seeds shared DynamicPage table configs (employees, roles, time, tasks, files, settings, Shopify shops), Solvo public support configs, support settings page config, default GlobalSetting support documents, and optional demo PublicSupportTicket rows.
        body:
          '''
/**
 * Solvo - migrate default DynamicPage table settings.
 * contextData: {
 *   dryRun?: boolean,
 *   seedTickets?: boolean,
 *   seedTicketCount?: number,
 *   forceReseedTickets?: boolean
 * }
 */

const {
  dryRun = false,
  seedTickets = true,
  seedTicketCount = 1000,
  forceReseedTickets = false
} = args.contextData || {};
console.log(`Solvo settings migration (dryRun: ${dryRun}, seedTickets: ${seedTickets}, seedTicketCount: ${seedTicketCount})`);

const nowIso = () => new Date().toISOString();

const defaultPublicSupportFormConfig = {
  gridColumns: 2,
  groups: [
    {
      key: "customer",
      title: "Contact details",
      gridColumns: 2,
      fields: [
        { key: "customerName", label: "Name", dataType: "text", renderer: "text", required: true, colSpan: 1, validation: { maxLength: 120 } },
        { key: "customerEmail", label: "Email", dataType: "email", renderer: "text", required: true, colSpan: 1, validation: { email: true, maxLength: 320 } },
        { key: "orderNumber", label: "Order number", dataType: "text", renderer: "text", required: false, colSpan: 1, validation: { maxLength: 80 } },
        { key: "subject", label: "Subject", dataType: "text", renderer: "text", required: true, colSpan: 2, validation: { maxLength: 200 } },
        { key: "message", label: "How can we help?", dataType: "text", renderer: "textArea", required: true, colSpan: 2, validation: { maxLength: 4000 } }
      ]
    }
  ]
};

const defaultSupportSystem = {
  enabled: true,
  serialPrefix: "SOL",
  allowGuestTickets: true,
  allowTicketCloseByCustomer: true,
  sendEmailNotifications: true,
  publicTrackingEnabled: true,
  defaultTicketStatus: "open",
  portalLinkEnabled: true,
  portalLinkLabel: "Staff portal",
  portalSignInPath: "/auth/signin",
  portalBaseUrl: ""
};

const defaultSupportTheme = {
  theme: {
    modalWidth: 640,
    showLogo: true,
    logoPosition: "top",
    customCss: ""
  }
};

const defaultEmailSettings = {
  enabled: true,
  sendTicketCreatedToCustomer: true,
  sendCustomerReplyToMerchant: true,
  sendAdminReplyToCustomer: true,
  sendTicketClosedToCustomer: true,
  sendTicketAssignedToAssignee: true,
  merchantEmail: "",
  replyToEmail: "",
  fromName: "Solvo Support",
  keepSameSubjectThread: true
};

const fieldSettingsJson = JSON.stringify(defaultPublicSupportFormConfig, null, 2);
const themeJson = JSON.stringify(defaultSupportTheme.theme, null, 2);

const settingsConfigs = [

  {
