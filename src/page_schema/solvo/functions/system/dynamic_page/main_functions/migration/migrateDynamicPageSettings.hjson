    key: "support_dashboard",
    title: "Support Overview",
    subtitle: "Live ticket metrics and queue health",
    version: 1,
    mode: "view",
    meta: {
      createdBy: "migration",
      updatedAt: "${new Date().toISOString()}",
      version: 1
    },
    layout: {
      componentName: "Grid",
      columns: 12,
      rowHeight: 80,
      gap: 16,
      responsive: {
        xl: { columns: 12 },
        lg: { columns: 12 },
        md: { columns: 8 },
        sm: { columns: 4 }
      }
    },
    filters: [
      {
        key: "dateRange",
        label: "Date range",
        type: "dateRange",
        default: "last_year",
        options: [
          { value: "all_time", label: "All time" },
          { value: "last_7_days", label: "Last 7 days" },
          { value: "last_30_days", label: "Last 30 days" },
          { value: "last_90_days", label: "Last 90 days" },
          { value: "last_year", label: "Last year" }
        ]
      },
      {
        key: "status",
        label: "Status",
        componentName: "Select",
        default: "",
        options: [
          { value: "", label: "All statuses" },
          { value: "open", label: "Open" },
          { value: "pending", label: "Pending" },
          { value: "closed", label: "Closed" }
        ]
      }
    ],
    permissions: { roles: [] },
    realtime: {
      enabled: true,
      channel: "supportOverview",
      logicalKey: "realtime:supportOverview",
      pollingIntervalMs: 30000,
      staleWhileRevalidate: true,
      entities: [
        {
          vertexLabel: "PublicSupportTicket",
          timestampField: "updatedAt",
          logicalKeys: [
            "public_support_tickets",
            "ticket_status_counts",
            "open_tickets_recent",
            "entity:PublicSupportTicket"
          ]
        }
      ]
    },
    devtools: { enabled: false },
    scheduler: { debounceMs: 50, batchWindowMs: 16 },
    personalization: { allowMoveWidgets: true, allowHideWidgets: true, saveLayouts: true },
    theme: { surface: "default", padding: "md", borderRadius: "lg", shadow: "sm" },
    analytics: { enabled: false },
    entityDrawer: {
      enabled: true,
      defaultView: "detail",
      openOnRowSelect: false,
      entityProfiles: {
        PublicSupportTicket: {
          crudConfigRef: "PublicSupportTicket",
          titleField: "ticketSerial",
          subtitleField: "status",
          fullPageHref: "/admin/support/ticket/{{entityId}}"
        }
      }
    },
    headerActions: [
      {
        key: "staffPortal",
        type: "settingsLink",
        resolveFunction: "getPortalLink",
        enabledField: "portalLinkEnabled",
        labelField: "portalLinkLabel",
        hrefField: "portalSignInUrl",
        openInNewTab: true,
        showInIframeOnly: true,
        variant: "secondary"
      }
    ],
    widgets: [
      {
        id: "openTickets",
        type: "metricCard",
        logicalQueryKeys: ["ticket_status_counts", "realtime:supportOverview"],
        title: "Open Tickets",
        subtitle: "Currently open",
        layout: { x: 0, y: 0, w: 3, h: 2 },
        dataSource: {
          type: "neo4j",
          query: {
            vertex: "PublicSupportTicket",
            timestampField: "createdAt",
            filters: [{ field: "status", operator: "eq", value: "open" }],
            aggregation: { type: "count" }
          },
          cache: { ttl: 60 }
        },
        trend: { compareTo: "previous_period", showSparkline: false }
      },
      {
        id: "pendingTickets",
        type: "metricCard",
        title: "Pending",
        layout: { x: 3, y: 0, w: 3, h: 2 },
        dataSource: {
          type: "neo4j",
          query: {
            vertex: "PublicSupportTicket",
            timestampField: "createdAt",
            filters: [{ field: "status", operator: "eq", value: "pending" }],
            aggregation: { type: "count" }
          }
        }
      },
      {
        id: "closedTickets",
        type: "metricCard",
        title: "Closed",
        layout: { x: 6, y: 0, w: 3, h: 2 },
        dataSource: {
          type: "neo4j",
          query: {
            vertex: "PublicSupportTicket",
            timestampField: "createdAt",
            filters: [{ field: "status", operator: "eq", value: "closed" }],
            aggregation: { type: "count" }
          }
        }
      },
      {
        id: "ticketStatusChart",
        componentName: "Chart",
        logicalQueryKeys: ["ticket_status_counts", "realtime:supportOverview"],
        title: "Tickets by status",
        chartType: "bar",
        layout: { x: 0, y: 2, w: 8, h: 4 },
        dataSource: {
          type: "neo4j",
          query: {
            vertex: "PublicSupportTicket",
            timestampField: "createdAt",
            limit: 200
          },
          transform: [{ type: "groupBy", field: "status" }]
        },
        interactions: [
          {
            trigger: "click",
            type: "SET_FILTER",
            payload: { status: "{{clicked.value}}" }
          }
        ]
      },
      {
        id: "supportShortcuts",
        type: "quickActions",
        title: "Shortcuts",
        layout: { x: 8, y: 2, w: 4, h: 2 },
        actions: [
          { key: "allTickets", label: "All tickets", to: "/admin/support/tickets" },
          { key: "settings", label: "Settings", to: "/portal/settings" }
        ]
      },
      {
        id: "dashboardHelp",
        componentName: "Markdown",
        title: "Notes",
        layout: { x: 8, y: 4, w: 4, h: 2 },
        content: "This dashboard is config-driven. Widget data is loaded via **executeDashboardDataSource** on the server."
      },
      {
        id: "ticketsTable",
        type: "crudTable",
        logicalQueryKeys: ["open_tickets_recent", "public_support_tickets", "realtime:supportOverview"],
        title: "Recent tickets",
        layout: { x: 0, y: 6, w: 12, h: 6 },
        crudConfigRef: "PublicSupportTicket",
        viewModes: ["table"],
        queryOverrides: {
          filters: [
            { field: "status", operator: "neq", value: "closed" }
          ],
          limit: 10,
          sort: [
            { field: "lastMessageAt", direction: "desc" }
          ]
        },
        interactions: [
          {
            trigger: "rowClick",
            type: "OPEN_ENTITY_DRAWER",
            payload: {
              entityType: "PublicSupportTicket",
              entityId: "{{row.id}}",
              view: "detail"
            }
          }
        ]
      }
    ]
  }
};`
  },
];

