    { key: "status", label: "Status", dataType: "text", renderer: "badge", width: "130px", badgeKeyCase: "lower", badgeToneMap: { active: ["Active", "success"], inactive: ["Inactive", "critical"], invited: ["Invited", "attention"] } },
