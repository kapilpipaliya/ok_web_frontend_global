{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: getDashboard
        description: Dashboard For Solvo.
        body:
          '''
const dbName = String(args.subDomain || args.rawSubDomain || "").trim();
if (!dbName) {
  return { success: false, error: "Shop database subdomain is required." };
}
const portalSignInPath = `/auth/signin`;
const portalSignInUrl = `https://${dbName}.decodecommerce.com${portalSignInPath}`;

return {
  success: true,
  data: {
    portalSignInPath,
    portalSignInUrl
  }
};
'''
      }
    }
  ]
  edges: []
}
