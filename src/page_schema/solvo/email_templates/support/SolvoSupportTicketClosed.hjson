{
  vertexes: [
    {
      id: "template"
      L: EmailTemplate
      P: {
        key: SolvoSupportTicketClosed
        title: Ticket Closed
        description: Sent when a public support request is closed.
      }
    }
    {
      id: "root"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 1
        props:
          '''return {
  as: "div"
};'''
        css:
          '''return `._id {
  min-height: 100vh;
  background-color: ${t.var.color.background_hex};
  color: ${t.var.color.text_hex};
  padding: 32px;
}`;'''
      }
    }
    {
      id: "container"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 1
        props:
          '''return {
  as: "div"
};'''
        css:
          '''return `._id {
  max-width: 600px;
  margin: auto;
  padding: 32px;
  background-color: ${t.var.color.background_light_100_hex};
  color: ${t.var.color.text_hex};
}`;'''
      }
    }
    {
      id: "logoSection"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 1
        props:
          '''return {
  as: "div"
};'''
      }
    }
    {
      id: "logoLink"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 1
        props:
          '''return {
  as: "a",
  href: "/"
};'''
      }
    }
    {
      id: "logoImg"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 1
        props:
          '''return {
  alt: "Logo",
  as: "img",
  src: (typeof window !== "undefined" ? window.location.origin : "") + "/api/file/downloadCompanyRectangularLogo"
};'''
        css:
          '''return `._id {
  height: 80px;
  margin-bottom: 24px;
}`;'''
      }
    }
    {
      id: "logoHr"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 2
        props:
          '''return {
  as: "hr"
};'''
        css:
          '''return `._id {
  border: none;
  border-top: 1px solid ${t.var.color.border_hex};
  margin-top: 24px;
  margin-bottom: 24px;
}`;'''
      }
    }
    {
      id: "content"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 2
        props:
          '''return {
  as: "div"
};'''
        css:
          '''return `._id {
  color: ${t.var.color.text_hex};
}`;'''
      }
    }
    {
      id: "title"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 1
        props:
          '''return {
  as: "h1",
  text: "Ticket closed"
};'''
        css:
          '''return `._id {
  color: ${t.var.color.text_hex};
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 16px;
}`;'''
      }
    }
    {
      id: "serialRow"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 2
        props:
          '''return {
  as: "p",
  text: `Ticket: ${_.searchParams?.serial || ""}`,
  hide: () => !_.searchParams?.serial
};'''
        css:
          '''return `._id {
  color: ${t.var.color.text_hex};
  margin-bottom: 16px;
}`;'''
      }
    }
    {
      id: "subjectRow"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 3
        props:
          '''return {
  as: "p",
  text: `Subject: ${_.searchParams?.subject || ""}`,
  hide: () => !_.searchParams?.subject
};'''
        css:
          '''return `._id {
  color: ${t.var.color.text_hex};
  margin-bottom: 16px;
}`;'''
      }
    }
    {
      id: "intro"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 4
        props:
          '''return {
  as: "p",
  text: "This support request is now closed. You can reopen it from the tracking page if you still need help."
};'''
        css:
          '''return `._id {
  color: ${t.var.color.text_hex};
  margin-bottom: 16px;
}`;'''
      }
    }
    {
      id: "link"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 5
        props:
          '''return {
  as: "a",
  href: _.searchParams?.trackingUrl || "#",
  text: "Open tracking page",
  hide: () => !_.searchParams?.trackingUrl
};'''
        css:
          '''return `._id {
  color: ${t.var.color.primary_hex};
  font-weight: 500;
  text-decoration: none;
}`;'''
      }
    }
    {
      id: "footer"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 3
        props:
          '''return {
  as: "div"
};'''
        css:
          '''return `._id {
  margin-top: 32px;
  text-align: center;
}`;'''
      }
    }
    {
      id: "footerText"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 1
        props:
          '''return {
  as: "p",
  text: `© 2025 ${_.globalSetting?.P?.appName || "Solvo"}. All rights reserved.`
};'''
        css:
          '''return `._id {
  color: ${t.var.color.text_light_200_hex};
  font-size: 12px;
}`;'''
      }
    }
  ]
  edges: [
    { id: "e1", T: "Attr", S: "template", E: "root" }
    { id: "e2", T: "Attr", S: "root", E: "container" }
    { id: "e3", T: "Attr", S: "container", E: "logoSection" }
    { id: "e4", T: "Attr", S: "logoSection", E: "logoLink" }
    { id: "e5", T: "Attr", S: "logoLink", E: "logoImg" }
    { id: "e6", T: "Attr", S: "logoSection", E: "logoHr" }
    { id: "e7", T: "Attr", S: "container", E: "content" }
    { id: "e8", T: "Attr", S: "content", E: "title" }
    { id: "e9", T: "Attr", S: "content", E: "serialRow" }
    { id: "e10", T: "Attr", S: "content", E: "subjectRow" }
    { id: "e11", T: "Attr", S: "content", E: "intro" }
    { id: "e12", T: "Attr", S: "content", E: "link" }
    { id: "e13", T: "Attr", S: "container", E: "footer" }
    { id: "e14", T: "Attr", S: "footer", E: "footerText" }
  ]
}
