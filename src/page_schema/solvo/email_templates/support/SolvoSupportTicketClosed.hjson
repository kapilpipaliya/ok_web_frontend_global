{
  vertexes: [
    {
      id: "template"
      L: EmailTemplate
      P: {
        key: SolvoSupportTicketClosed
        title: Ticket Closed
        description: Sent when a public support request is closed.
      }
    }
    {
      id: "root"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 1
        props:
          '''return {
  as: "div"
};'''
        css:
          '''return `._id {
  max-width: 640px;
  margin: 0 auto;
  padding: 24px;
  font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
  color: ${args.theme.var.color.text};
}`;'''
      }
    }
    {
      id: "title"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 1
        props:
          '''return {
  as: "h1",
  text: `Ticket ${args.searchParams?.serial || ""} closed`
};'''
      }
    }
    {
      id: "body"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 2
        props:
          '''return {
  as: "p",
  text: "This support request is now closed. You can reopen it from the tracking page if you still need help."
};'''
      }
    }
    {
      id: "link"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 3
        props:
          '''return {
  as: "a",
  href: args.searchParams?.trackingUrl || "#",
  text: "Open tracking page"
};'''
      }
    }
  ]
  edges: [
    {
      id: e1
      T: Attr
      S: "template"
      E: "root"
    }
    {
      id: e2
      T: Attr
      S: "root"
      E: "title"
    }
    {
      id: e3
      T: Attr
      S: "root"
      E: "body"
    }
    {
      id: e4
      T: Attr
      S: "root"
      E: "link"
    }
  ]
}
