{
  vertexes: [
    {
      id: "template"
      L: EmailTemplate
      P: {
        key: SolvoSupportAdminReply
        title: Support Team Replied
        description: Sent to the customer when merchant/staff replies to a public support request.
      }
    }
    {
      id: "root"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 1
        props:
          '''return {
  as: "div"
};'''
        css:
          '''return `._id {
  max-width: 640px;
  margin: 0 auto;
  padding: 24px;
  font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
  color: ${args.theme.var.color.text};
}`;'''
      }
    }
    {
      id: "title"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 1
        props:
          '''return {
  as: "h1",
  text: `Support team replied to ${args.searchParams?.serial || "your request"}`
};'''
      }
    }
    {
      id: "body"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 2
        props:
          '''return {
  as: "p",
  text: args.searchParams?.message || ""
};'''
      }
    }
    {
      id: "link"
      L: Attr
      P: {
        componentName: Html
        displayOrder: 3
        props:
          '''return {
  as: "a",
  href: args.searchParams?.trackingUrl || "#",
  text: "View conversation"
};'''
      }
    }
  ]
  edges: [
    {
      id: e1
      T: Attr
      S: "template"
      E: "root"
    }
    {
      id: e2
      T: Attr
      S: "root"
      E: "title"
    }
    {
      id: e3
      T: Attr
      S: "root"
      E: "body"
    }
    {
      id: e4
      T: Attr
      S: "root"
      E: "link"
    }
  ]
}
