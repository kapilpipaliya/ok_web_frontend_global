{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: VirtualList
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        fns:
          '''
// Get props from context reactively. Prefer getItems (function) so parent can pass a getter and subscription stays in VirtualList (avoids parent re-render on expand/collapse).
const getItems = () => {
  const getter = args.contextData.props?.getItems;
  if (typeof getter === 'function') return getter() || [];
  return args.contextData.props?.items || [];
};
const getItemHeight = () => args.contextData.props?.itemHeight || 90;
const getHeightAtIndex = (i, items) => {
  const fn = args.contextData.props?.getItemHeightAt;
  if (typeof fn === 'function') {
    const h = fn(i, items[i]);
    if (typeof h === 'number' && !isNaN(h) && h >= 0) return h;
  }
  const uniform = getItemHeight();
  return typeof uniform === 'function' ? uniform() : uniform;
};
const getOverscan = () => args.contextData.props?.overscan || 5;
const getOnScrollCallback = () => args.contextData.props?.onScroll;

// Prefix offsets for variable row heights: offsets[i] = start Y of item i
const getOffsetsAndTotal = () => {
  const items = getItems();
  const n = items.length;
  const offsets = new Array(n + 1);
  offsets[0] = 0;
  for (let i = 0; i < n; i++) {
    offsets[i + 1] = offsets[i] + getHeightAtIndex(i, items);
  }
  return { offsets, total: n === 0 ? 0 : offsets[n], n };
};

const findStartIndex = (scroll, offsets, n) => {
  if (n === 0) return 0;
  let lo = 0;
  let hi = n - 1;
  while (lo < hi) {
    const mid = Math.floor((lo + hi) / 2);
    if (offsets[mid + 1] <= scroll) lo = mid + 1;
    else hi = mid;
  }
  return lo;
};

// Virtualization state
const [scrollTop, setScrollTop] = args.createSignal(0);
const [scrollElement, setScrollElement] = args.createSignal(null);

// Calculate visible range from items (parent passes final display list)
const getVisibleRange = () => {
  const el = scrollElement();
  const scroll = scrollTop();
  const items = getItems();
  const overscan = getOverscan();
  const { offsets, total, n } = getOffsetsAndTotal();

  // Use default container height if element not yet available
  const containerHeight = el?.clientHeight || 600;

  if (n === 0) return { start: 0, end: -1 };

  const startIndex = Math.max(0, findStartIndex(scroll, offsets, n) - overscan);
  const bottomY = scroll + containerHeight;
  const pad = 200;
  let endIndex = startIndex;
  for (let j = startIndex; j < n; j++) {
    if (offsets[j] >= bottomY + pad) break;
    endIndex = j;
  }
  endIndex = Math.min(n - 1, endIndex + overscan);

  return { start: startIndex, end: endIndex };
};

// Cache virtual item objects by stable key so Solid For reuses same refs and does not remove/add all rows on expand/collapse
let virtualItemCache = {};
const getStableKey = (item, index) => {
  const id = item?.id ?? (item?.P && item?.id);
  if (id != null) return String(id);
  return 'i-' + index;
};
// Get virtual items to render (index, start, size); reuse cached object refs by key so list does not remount
const getVirtualItems = () => {
  const { start, end } = getVisibleRange();
  const items = getItems();
  const virtualItems = [];
  const { offsets, n } = getOffsetsAndTotal();
  const usedKeys = new Set();

  for (let i = start; i <= end && i < n; i++) {
    const key = getStableKey(items[i], i);
    usedKeys.add(key);
    const h = getHeightAtIndex(i, items);
    const rowStart = offsets[i];
    let v = virtualItemCache[key];
    if (v) {
      v.index = i;
      v.start = rowStart;
      v.size = h;
      v.rowData = items[i];
    } else {
      v = { index: i, start: rowStart, size: h, rowData: items[i] };
      virtualItemCache[key] = v;
    }
    virtualItems.push(v);
  }
  // Drop cache entries no longer in use to avoid unbounded growth
  Object.keys(virtualItemCache).forEach(k => { if (!usedKeys.has(k)) delete virtualItemCache[k]; });

  return virtualItems;
};

// Total height of all items
const getTotalSize = () => getOffsetsAndTotal().total;

// Scroll handler: currentTarget is correct when the listener is attached to a parent scrollport (e.g. table 40wrap).
const handleScroll = (e) => {
  const t = e.currentTarget ?? e.target;
  setScrollTop(t.scrollTop);

  // Call custom onScroll callback if provided
  const onScrollCallback = getOnScrollCallback();
  if (onScrollCallback) {
    onScrollCallback(e);
  }
};

// Optional keyboard nav: when getActiveIndex/setActiveIndex/getItemRef are provided, handle Arrow keys and Space
const getActiveIndex = () => args.contextData.props?.getActiveIndex?.() ?? -1;
const setActiveIndex = (n) => args.contextData.props?.setActiveIndex?.(n);
const getItemCount = () => (getItems()?.length ?? 0);
const getItemRef = (index) => args.contextData.props?.getItemRef?.(index);
const getScrollToItemHeight = () => {
  const h = getItemHeight();
  return typeof h === 'function' ? h() : h;
};

const focusRowAtIndex = (index) => {
  if (index < 0) return;
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      const rowEl = getItemRef(index);
      if (rowEl && typeof rowEl.focus === 'function') rowEl.focus();
    });
  });
};

const scrollToIndexAndFocus = (nextIndex) => {
  if (nextIndex < 0) return;
  const container = scrollElement();
  const items = getItems();
  const { offsets, n } = getOffsetsAndTotal();
  if (container && nextIndex < n) {
    const rowTop = offsets[nextIndex];
    const rowH = getHeightAtIndex(nextIndex, items);
    const rowBottom = rowTop + rowH;
    const scroll = scrollTop();
    const viewTop = scroll;
    const viewBottom = scroll + container.clientHeight;
    const isVisible = rowTop >= viewTop && rowBottom <= viewBottom;
    if (!isVisible) {
      const targetScroll = rowTop;
      const maxScroll = Math.max(0, container.scrollHeight - container.clientHeight);
      container.scrollTop = Math.max(0, Math.min(targetScroll, maxScroll));
    }
  }
  focusRowAtIndex(nextIndex);
};

const handleListKeyDown = (e) => {
  const key = e.key;
  const len = getItemCount();
  const current = getActiveIndex();

  if (key === "ArrowDown") {
    e.preventDefault();
    const nextIndex = len === 0 ? -1 : Math.min(current + 1, len - 1);
    if (e.shiftKey) {
      const onShiftArrow = args.contextData.props?.onShiftArrow;
      if (onShiftArrow && nextIndex >= 0) onShiftArrow(current, nextIndex);
    } else {
      args.contextData.props?.clearSelectionAnchor?.();
    }
    setActiveIndex(nextIndex);
    if (nextIndex >= 0) scrollToIndexAndFocus(nextIndex);
    focusRowAtIndex(nextIndex);
    return;
  }
  if (key === "ArrowUp") {
    e.preventDefault();
    const nextIndex = Math.max(-1, current - 1);
    if (e.shiftKey) {
      const onShiftArrow = args.contextData.props?.onShiftArrow;
      if (onShiftArrow && nextIndex >= 0) onShiftArrow(current, nextIndex);
    } else {
      args.contextData.props?.clearSelectionAnchor?.();
    }
    setActiveIndex(nextIndex);
    if (nextIndex >= 0) scrollToIndexAndFocus(nextIndex);
    focusRowAtIndex(nextIndex);
    return;
  }
  if (key === " " || key === "Spacebar") {
    const onSpaceKey = args.contextData.props?.onSpaceKey;
    if (onSpaceKey && current >= 0) {
      e.preventDefault();
      onSpaceKey(current);
    }
    return;
  }
  if (key === "ArrowLeft" || key === "ArrowRight") {
    const onExpandCollapse = args.contextData.props?.onExpandCollapse;
    if (onExpandCollapse && current >= 0) {
      const items = getItems();
      const row = items[current];
      const expandableGroup = row?._isParent === true && row._parentKey != null;
      const expandableRow = row?.id && args.contextData.props?.rowHasExpansion?.(row) === true;
      if (expandableGroup || expandableRow) {
        e.preventDefault();
        onExpandCollapse(current, key === "ArrowLeft" ? "collapse" : "expand");
        requestAnimationFrame(() => requestAnimationFrame(() => focusRowAtIndex(current)));
      }
    }
  }
};

const useListKeyNav = () =>
  typeof args.contextData.props?.setActiveIndex === 'function' &&
  typeof args.contextData.props?.getItemRef === 'function';

// Table passes getScrollContainerElement (40wrap): attach scroll listener there so scrollTop matches virtualization.
// When unset, the list uses its own root ref + onScroll (default VirtualList behavior).
args.createEffect(() => {
  const getter = args.contextData.props?.getScrollContainerElement;
  if (typeof getter !== "function") return;
  const el = getter();
  if (!el) return;
  setScrollElement(el);
  const handler = (e) => handleScroll(e);
  el.addEventListener("scroll", handler, { passive: true });
  args.onCleanup(() => {
    el.removeEventListener("scroll", handler);
  });
});

return {
  scrollTop,
  setScrollTop,
  scrollElement,
  setScrollElement,
  getVisibleRange,
  getVirtualItems,
  getTotalSize,
  handleScroll,
  getItems,
  handleListKeyDown,
  useListKeyNav
};
'''
        componentName: Html
        props:
          '''
const containerClass = args.contextData.props?.class || "";
const tabIndex = args.contextData.props?.tabIndex;
const externalOnKeyDown = args.contextData.props?.onKeyDown;
const role = args.contextData.props?.role;
const ariaLabel = args.contextData.props?.["attr:aria-label"];
const useKeyNav = args.fns.useListKeyNav?.();

const onKeyDown = useKeyNav ? args.fns.handleListKeyDown : externalOnKeyDown;
const extScroll = args.contextData.props?.getScrollContainerElement;
const useExternalVerticalScroll = typeof extScroll === "function";
// Table: min width so the scrollport gets horizontal overflow (absolute rows do not widen the flow).
const mw = args.contextData.props?.contentMinWidthPx;
const minWStyle =
  typeof mw === "number" && mw > 0 ? `min-width: ${mw}px;width:100%;box-sizing:border-box;` : undefined;

return {
  as: "div",
  class: containerClass,
  ref: useExternalVerticalScroll ? undefined : args.fns.setScrollElement,
  onScroll: useExternalVerticalScroll ? undefined : args.fns.handleScroll,
  //...(tabIndex !== undefined && { tabIndex }),
  ...(onKeyDown && { onKeyDown }),
  ...(role && { role }),
  ...(ariaLabel && { "attr:aria-label": ariaLabel }),
  ...(minWStyle ? { style: minWStyle } : {})
};
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''
return `._id {
  position: relative;
  width: 100%;
  height: ${args.fns.getTotalSize()}px;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
// Inner height spacer: optional min-width from parent so total scroll width includes wide grids.
const mw = args.contextData.props?.contentMinWidthPx;
const spacerMin = typeof mw === "number" && mw > 0 ? `min-width: ${mw}px;` : "";
return {
  as: "div",
  ...(spacerMin ? { style: spacerMin } : {})
};
'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        contextName: virtualItem
        loop: true
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  data: args.fns.getVirtualItems()
};
'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 2
        slot: children
        componentName: Slot
      }
    }
    {
      id: "6"
      L: ComponentVariant
      P: {
        type: string
        key: containerClass
        defValue: ""
      }
    }
    {
      id: "7"
      L: ComponentVariant
      P: {
        type: number
        key: itemHeight
        defValue: 90
      }
    }
    {
      id: "8"
      L: ComponentVariant
      P: {
        type: number
        key: overscan
        defValue: 15
      }
    }
    {
      id: "9"
