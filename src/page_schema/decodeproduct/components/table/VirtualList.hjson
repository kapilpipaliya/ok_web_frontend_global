      P: {
        type: function
        key: onScroll
      }
    }
    {
      id: "9b"
      L: ComponentVariant
      P: {
        type: function
        key: getItemHeightAt
      }
    }
    {
      id: "10"
      L: ComponentVariant
      P: {
        type: array
        key: items
        defValue: []
      }
    }
  ]
