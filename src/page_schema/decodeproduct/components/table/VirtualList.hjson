      P: {
        type: number
        key: itemHeight
        defValue: 90
      }
    }
    {
      id: "8"
      L: ComponentVariant
      P: {
        type: number
        key: overscan
        defValue: 5
      }
    }
    {
      id: "9"
      L: ComponentVariant
      P: {
        type: function
        key: onScroll
      }
    }
    {
      id: "10"
      L: ComponentVariant
      P: {
        type: array
        key: items
        defValue: []
      }
    }
  ]
