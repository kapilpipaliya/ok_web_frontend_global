    {
      id: "2"
      L: Attr
      P: {
        css:
          '''
// Access props reactively
const variant = args.contextData.props?.variant || "primary";
const fullWidth = args.contextData.props?.fullWidth || false;
const size = args.contextData.props?.size || "md";

// Size styles using existing theme values
const sizeStyles = {
  xs: {
    padding: `${args.theme.var.spacing.xxs} ${args.theme.var.spacing.xs}`,
    fontSize: args.theme.var.fontSize.xs,
    borderRadius: args.theme.var.borderRadius.sm,
    gap: args.theme.var.spacing.xxs
  },
  sm: {
    padding: `${args.theme.var.spacing.xs} ${args.theme.var.spacing.sm}`,
    fontSize: args.theme.var.fontSize.sm,
    borderRadius: args.theme.var.borderRadius.sm,
    gap: args.theme.var.spacing.xs
  },
  md: {
    padding: `${args.theme.var.spacing.sm} ${args.theme.var.spacing.md}`,
    fontSize: args.theme.var.fontSize.md,
    borderRadius: args.theme.var.borderRadius.md,
    gap: args.theme.var.spacing.sm
  },
  lg: {
    padding: `${args.theme.var.spacing.md} ${args.theme.var.spacing.lg}`,
    fontSize: args.theme.var.fontSize.lg,
    borderRadius: args.theme.var.borderRadius.md,
    gap: args.theme.var.spacing.md
  }
};

const sizeConfig = sizeStyles[size] || sizeStyles.md;

// Base styles
let baseStyles = `
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: ${sizeConfig.gap};
  padding: ${sizeConfig.padding};
  border-radius: ${sizeConfig.borderRadius};
  font-weight: 500;
  font-size: ${sizeConfig.fontSize};
  cursor: pointer;
  transition: all ${args.theme.var.animation.fast} ease;
  border: none;
  ${fullWidth ? 'width: 100%;' : ''}

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  &:not(:disabled):active {
    transform: scale(0.95);
  }
`;

// Variant-specific styles
let variantStyles = '';

if (variant === 'primary') {
  variantStyles = `
    background: ${args.theme.var.color.primary};
    color: ${args.theme.var.color.primary_text};

    &:not(:disabled):hover {
      background: ${args.theme.var.color.primary_dark_200};
    }
  `;
} else if (variant === 'success') {
  variantStyles = `
    background: ${args.theme.var.color.success};
    color: ${args.theme.var.color.success_text};

    &:not(:disabled):hover {
      background: ${args.theme.var.color.success_dark_200};
      color: ${args.theme.var.color.success_dark_200_text};
    }
  `;
} else if (variant === 'secondary') {
  variantStyles = `
    background: none;
    color: ${args.theme.var.color.muted};
    border: 1px solid ${args.theme.var.color.border};

    &:not(:disabled):hover {
      background: ${args.theme.var.color.background_dark_200};
      color: ${args.theme.var.color.text};
    }
  `;
} else if (variant === 'danger') {
  variantStyles = `
    background: ${args.theme.var.color.background};
    color: ${args.theme.var.color.error};
    border: 1px solid ${args.theme.var.color.error};

    &:not(:disabled):hover {
      background: ${args.theme.var.color.error};
      color: ${args.theme.var.color.error_text};
    }
  `;
}

return `._id {
  ${baseStyles}
  ${variantStyles}
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
// Access props reactively
const text = args.contextData.props?.text || "Button";
const type = args.contextData.props?.type || "button";
const disabled = args.contextData.props?.disabled || args.contextData.props?.loading || false;
const onClick = args.contextData.props?.onClick || (() => {});
const loading = args.contextData.props?.loading || false;
const className = args.contextData.props?.class

return {
  as: "button",
  class: className,
  type: type,
  disabled: disabled,
  onClick: onClick,
  "aria-busy": loading ? "true" : "false"
};
'''
      }
