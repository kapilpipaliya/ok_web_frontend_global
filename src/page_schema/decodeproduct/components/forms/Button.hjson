      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const leftIcon = args.contextData.props?.leftIcon;
const iconSize = args.contextData.props?.iconSize;
const buttonSize = args.contextData.props?.size || "md";
// Use iconSize if provided, otherwise use button size
const effectiveSize = iconSize || buttonSize;

const sizeStyles = {
  xs: 14,
  sm: 16,
  md: 20,
  lg: 24
};

const iconSizePx = sizeStyles[effectiveSize] || sizeStyles.md;

return {
  as: "icon",
  icon: leftIcon,
  width: iconSizePx,
  height: iconSizePx,
  hide: !leftIcon
};
'''
      }
