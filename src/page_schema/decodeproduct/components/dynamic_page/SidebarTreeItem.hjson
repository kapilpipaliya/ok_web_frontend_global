    {
      id: "3"
      L: Attr
      P: {
        css:
          '''
const isHovered = args.fns.isSelected();
const isDirectMatch = args.fns.isDirectMatch();
const isAncestorOfMatch = args.fns.isAncestorOfMatch?.() ?? false;
const isDragOver = args.fns.isDragOver();
const isValidDrop = args.fns.isValidDrop?.() ?? true;
const isDragging = args.fns.isDragging?.() || false;
const item = args.fns.getItem();
const rootKeys = args.contextData.props?.sidebarConfig?.rootKeys || {};
const rootKey = rootKeys.key;
const isRoot = item?.P?.key === rootKey || item?.P?.key === 'uncategorized';
const isQueued = args.fns.isQueued?.() ?? false;

// Determine drag over styling based on validation
let dragOverStyle = "";
if (isDragOver) {
  if (isValidDrop) {
    // Valid drop: green border and subtle green background
    dragOverStyle = `background-color: ${args.theme.var.color.success_light_200}; border: 2px dashed ${args.theme.var.color.success_light_200};`;
  } else {
    // Invalid drop: red border and red background with opacity
    dragOverStyle = `background-color: ${args.theme.var.color.error_light_200}; border: 2px dashed ${args.theme.var.color.error_light_200}; cursor: not-allowed;`;
  }
}

// Compute background color variable based on state
let backgroundColor = "";
if (dragOverStyle.includes('background-color')) {
  // The dragOverStyle already sets background color, so don't override
  // No action needed since dragOverStyle will apply its background 
} else if (isHovered) {
  backgroundColor = args.theme.var.color.background_dark_150;
} else if (isDirectMatch) {
  backgroundColor = args.theme.var.color.primary_light_500;
//} else if (!isDirectMatch && isAncestorOfMatch) {
//  backgroundColor = args.theme.var.color.primary_light_600;
} 

// Compose the style string
return `._id {
  align-items: center;
  cursor: ${isRoot || isQueued ? 'default' : isDragging ? 'grabbing' : isDragOver && !isValidDrop ? 'not-allowed' : 'grab'};
  display: flex;
  gap: 0.375rem;
  font-size: 14px;
  font-weight: ${args.fns.hasChildren() ? "bold" : "normal"};
  width: 100%;
  border-radius: ${args.fns.hasChildren() ? "5px" : "0 5px 5px 0"};
  ${backgroundColor ? `background-color: ${backgroundColor};
  ${isDirectMatch ? " font-weight: bold;" : ""}` : ""}
  ${dragOverStyle}
  ${isDragging ? `opacity: 0.5;` : ""}
  padding: 2px 0;
  transition: all 0.15s ease-in-out;
  ${args.fns.hasChildren() ? "" : `border-left: 1px dashed ${args.theme.var.color.border};`}
  
  &:hover {
    background-color: ${args.theme.var.color.background_dark_150};
  }
  
  &:hover .tree-item-actions {
    opacity: 1;
    visibility: visible;
  }
}`;
'''
        displayOrder: 1
        componentName: Html
        key: tree_item_content
        props:
          '''
const item = args.fns.getItem();
const isRoot = item?.id === 'uncategorized';
const isDragging = args.fns.isDragging?.() || false;
const isDragOver = args.fns.isDragOver?.() || false;
const isValidDrop = args.fns.isValidDrop?.() ?? true;

return {
  as: "div",
  onClick: args.fns.handleItemClick,
  ref: (el) => {
    if (el) {
      // Initialize both draggable and drop target on the same element
      if (!isRoot && args.fns.initDraggable) {
        args.fns.initDraggable(el);
      }
      if (args.fns.initDropTarget) {
        args.fns.initDropTarget(el);
      }
    } else {
      // Cleanup on unmount (ref called with null)
      if (args.fns.cleanupDragAndDrop) {
        args.fns.cleanupDragAndDrop();
      }
    }
  },
  onCleanup: () => {
    // Ensure drag-and-drop listeners are removed on unmount (backup if ref(null) not called)
    if (args.fns.cleanupDragAndDrop) {
      args.fns.cleanupDragAndDrop();
    }
  },
  style: isDragging ? { opacity: 0.5 } : {}
};
'''
