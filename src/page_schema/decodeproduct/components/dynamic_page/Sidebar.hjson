{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''
const getParentVertexLabel = () => args.fns.getSidebarConfig()?.parentVertexLabel;
const getToParentEdgeType = () => args.fns.getSidebarConfig()?.toParentEdgeType;
const getRootKeys = () => args.fns.getSidebarConfig()?.rootKeys || {};
const getFormConfig = () => args.fns.getSidebarConfig()?.formConfig;
const getSidebarLabel = () => args.fns.getSidebarConfig()?.label || args.fns.getSidebarConfig()?.parentVertexLabel;

const getTableVertexLabel = () => args.contextData.props?.tableVertexLabel;
const getRelationshipType = () => args.contextData.props?.relationshipType;

// State management - using graph for data, signals only for UI state
const [expandedKeys, setExpandedKeys] = args.createSignal([]);
const [selectedItem, setSelectedItem] = args.createSignal(null);
const [sidebarLoading, setSidebarLoading] = args.createSignal(false);
const [operationLoading, setOperationLoading] = args.createSignal(false);
const [isAddRootModalOpen, setIsAddRootModalOpen] = args.createSignal(false);

// Graph namespace for sidebar data
const SIDEBAR_NAMESPACE = "sidebar";
const getSidebarNamespace = (key) => `${SIDEBAR_NAMESPACE}_${key}`;

// Fetch root vertices and store in graph
// options.preserveExpanded: when true, do not reset expandedKeys (e.g. after adding a category)
const fetchRoot = async (options) => {
  const parentVertexLabel = getParentVertexLabel();
  const toParentEdgeType = getToParentEdgeType();
  const rootKeys = getRootKeys();

  if (!parentVertexLabel || !toParentEdgeType) {
    return;
  }

  setSidebarLoading(true);
  try {
    const tableVertexLabel = getTableVertexLabel();
    const relationshipType = getRelationshipType();
    
    const enableUserScoping = args.contextData.props?.enableUserScoping === true;
    
    const sidebarContextData = {
      parentVertexLabel,
      toParentEdgeType,
      rootKeys,
      tableVertexLabel,
      relationshipType,
      enableUserScoping,
      loadFullTree: args.fns.getSidebarConfig()?.loadFullTree === true,
      hooks: args.contextData.props?.hooks
    };
    const result = await args.executeNamedServerFunction({
      functionName: "getSidebarTreeRoots",
      contextData: sidebarContextData
    });

    // Check for errors and show toast
    const errorMessage = args.fns.extractError?.(result, true, "Failed to load root vertices");
    if (errorMessage) {
      return;
    }

    if (result?.result?.success && result.result.data) {
      const rootItems = result.result.data;
      
      if (result.graph && result.graph.vertexes) {
        args.setGraphData(0, result.graph, {});
      }
      
      if (!options?.preserveExpanded) {
        setExpandedKeys([]);
      }
      
      // Restore selection from URL (vertex id) so reload activates same category
      const initialCategoryId = args.contextData.props?.initialCategoryId;
      if (initialCategoryId && args.graph?.vertexes?.[initialCategoryId]) {
        const vertex = args.graph.vertexes[initialCategoryId];
        let parent = getParentCategory(initialCategoryId);
        while (parent && parent.id) {
          setExpandedKeys(keys => keys.includes(parent.id) ? keys : [...keys, parent.id]);
          parent = getParentCategory(parent.id);
        }
        handleItemSelect(vertex);
      } else if (rootItems.length > 0 && !selectedItem()) {
        const firstRootItem = rootItems[0];
        handleItemSelect(firstRootItem);
      }
    }
  } catch (error) {
    console.error("Error fetching root:", error);
    args.showErrorToast?.("Failed to load sidebar data");
  } finally {
    setSidebarLoading(false);
  }
};

// Fetch children for a specific parent and store in graph
const fetchChildren = async (parentId, forceRefresh = false) => {
  const parentVertexLabel = getParentVertexLabel();
  const toParentEdgeType = getToParentEdgeType();

  if (!parentVertexLabel || !toParentEdgeType || !parentId) {
    return [];
  }

  // Check graph first using evalExpression (unless forcing refresh)
  if (!forceRefresh) {
    const parentVertex = args.graph.vertexes[parentId];
    if (parentVertex) {
      // Use evalExpression to get children from graph
      // Relationship direction: child-[toParentEdgeType]->parent, so use <- to get children
      const children = args.evalExpression(
        `<-${toParentEdgeType}`,
        { graph: args.graph, setGraph: args.setGraph, vertexes: [parentVertex] }
      ) || [];
      if (children.length > 0) {
        return children;
      }
    }
  }

  try {
    const tableVertexLabel = getTableVertexLabel();
    const relationshipType = getRelationshipType();
    
    const enableUserScoping = args.contextData.props?.enableUserScoping === true;
    
    const result = await args.executeNamedServerFunction({
      functionName: "getVertexChildren",
      contextData: {
        parentVertexLabel,
        toParentEdgeType,
        parentId,
        tableVertexLabel,
        relationshipType,
        enableUserScoping,
        hooks: args.contextData.props?.hooks
      }
    });

    if (result?.result?.success && result.result.data) {
      // Store children in graph
      if (result.graph && result.graph.vertexes) {
        args.setGraphData(0, result.graph, {});
      }
      
      // Return children using evalExpression from graph
      // Relationship direction: child-[toParentEdgeType]->parent, so use <- to get children
      const parentVertex = args.graph.vertexes[parentId];
      if (parentVertex) {
        const children = args.evalExpression(
          `<-${toParentEdgeType}`,
          { graph: args.graph, setGraph: args.setGraph, vertexes: [parentVertex] }
        ) || [];
        return children;
      }
    }
  } catch (error) {
    console.error("Error fetching children:", error);
  }

  return [];
};

// Helper function to get sortable name from item
const getItemSortName = (item) => {
  if (!item) return "";
  return item.P?.name || item.P?.title || item.P?.key || "";
};

// Helper function to check if item is Uncategorized
const isUncategorized = (item) => {
  if (!item) return false;
  return item.P?.key === 'uncategorized' || item.id === 'uncategorized' || 
         item.P?.name?.toLowerCase() === 'uncategorized' || 
         item.P?.title?.toLowerCase() === 'uncategorized';
};

// Common function to sort items (Uncategorized first, then alphabetically)
const sortItems = (items) => {
  if (!items || !Array.isArray(items)) return items;
  return [...items].sort((a, b) => {
    const isAUncategorized = isUncategorized(a);
    const isBUncategorized = isUncategorized(b);
    
    // Uncategorized items come first
    if (isAUncategorized && !isBUncategorized) return -1;
    if (!isAUncategorized && isBUncategorized) return 1;
    
    // Both are uncategorized or both are not - sort alphabetically
    const nameA = getItemSortName(a);
    const nameB = getItemSortName(b);
    return nameA.localeCompare(nameB);
  });
};

// Get children for a specific parent using evalExpression (reactive)
const getChildren = (parentId) => {
  if (!parentId) return [];
  const toParentEdgeType = getToParentEdgeType();
  // Access graph reactively
  const graph = args.graph;
  const parentVertex = graph.vertexes[parentId];
  if (!parentVertex) return [];
  
  // Use evalExpression to get children via incoming edge
  // Relationship direction: child-[toParentEdgeType]->parent, so use <- to get children
  // Expression format: ->EdgeType (outgoing) or <-EdgeType (incoming)
  const children = args.evalExpression(
    `<-${toParentEdgeType}`,
    { graph: args.graph, setGraph: args.setGraph, vertexes: [parentVertex] }
  ) || [];
  
  return sortItems(children);
};

// Get loading state - not needed with graph, but kept for compatibility
const getLoadingState = (parentId) => {
  return false; // Graph updates are synchronous
};

// Get root items computed from graph (GraphData: vertexes VertexMap, optional vertexLabelIdMap).
// Roots = vertices with parentVertexLabel and no incoming toParentEdgeType + uncategorized.
const getRoot = () => {
  const toParentEdgeType = getToParentEdgeType();
  const parentVertexLabel = getParentVertexLabel();
  const graph = args.graph;
  const vertexes = graph?.vertexes;
  if (!vertexes || !toParentEdgeType) return sortItems([]);
  const labelIds = graph.vertexLabelIdMap?.[parentVertexLabel];
  const candidateIds = Array.isArray(labelIds) ? labelIds : Object.keys(vertexes).filter(id => vertexes[id]?.L?.includes(parentVertexLabel));
  const rootIds = candidateIds.filter(id => vertexes[id] != null && (id === 'uncategorized' || !(vertexes[id].OUT?.[toParentEdgeType]?.length)));
  const rootItems = rootIds.map(id => vertexes[id]).filter(v => v != null);
  return sortItems(rootItems);
};

// Toggle expand/collapse
const toggleExpand = async (itemId) => {
  const currentExpanded = expandedKeys();
  const isExpanded = currentExpanded.includes(itemId);

  if (isExpanded) {
    setExpandedKeys(currentExpanded.filter(id => id !== itemId));
  } else {
    setExpandedKeys([...currentExpanded, itemId]);
    // Always fetch children when expanding (cache will be checked inside fetchChildren)
    await fetchChildren(itemId);
  }
};

// Handle item selection
const handleItemSelect = (item) => {
  setSelectedItem(item);
  // Call onItemSelect if provided via props
  if (args.contextData.props?.onItemSelect) {
    args.contextData.props.onItemSelect(item);
  }
};

// Handle opening add root modal
const handleOpenAddRootModal = () => {
  setIsAddRootModalOpen(true);
};

// Handle closing add root modal
const handleCloseAddRootModal = () => {
  setIsAddRootModalOpen(false);
};

// Handle saving root item (preserve expanded state so tree does not collapse)
const handleAddRootSave = async (savedVertex) => {
  await fetchRoot({ preserveExpanded: true });
  setIsAddRootModalOpen(false);
};

// Update a specific item in the tree (for edits) - graph is automatically updated
const updateItemInTree = (updatedVertex) => {
  if (!updatedVertex || !updatedVertex.id) return;

  // Update vertex in graph using replaceVertexProperties
  args.replaceVertexProperties(0, updatedVertex.id, args.graph, args.setGraph, { ...updatedVertex.P });

  // Root vertices signal only stores IDs, so no need to update it on edit
  // The graph update will automatically reflect in getRoot() since it reads from graph

  // Update selectedItem if it's the currently selected item
  const currentSelected = selectedItem();
  if (currentSelected && currentSelected.id === updatedVertex.id) {
    setSelectedItem(updatedVertex);
  }
};


// Remove a specific item from the tree (for deletes) - using graph
const removeItemFromTree = (itemId) => {
  if (!itemId) return;

  // Find parent of deleted item using graph traversal
  const toParentEdgeType = getToParentEdgeType();
  const deletedVertex = args.graph.vertexes[itemId];
  let parentItem = null;
  
  if (deletedVertex && deletedVertex.IN && deletedVertex.IN[toParentEdgeType]) {
    const parentIds = deletedVertex.IN[toParentEdgeType];
    if (parentIds.length > 0) {
      parentItem = args.graph.vertexes[parentIds[0]];
    }
  }

  // Remove vertex from graph (getRoot() is computed from graph so roots update automatically)
  args.deleteVertex(0, itemId, args.graph, args.setGraph);

  // Select parent item if it exists, otherwise clear selection
  const currentSelected = selectedItem();
  if (currentSelected && currentSelected.id === itemId) {
    if (parentItem) {
      setSelectedItem(parentItem);
      // Also call onItemSelect if provided
      if (args.contextData.props?.onItemSelect) {
        args.contextData.props.onItemSelect(parentItem);
      }
    } else {
      setSelectedItem(null);
    }
  }
};

// Helper function to get all visible items in tree order (for navigation)
const getAllVisibleItems = () => {
  const rootItems = getRoot();
  const expandedKeysList = expandedKeys();
  const toParentEdgeType = getToParentEdgeType();
  
  const result = [];
  
  const traverse = (items) => {
    for (const item of items) {
      if (!item) continue;
      result.push(item);
      
      // If item is expanded, add its children recursively
      if (Array.isArray(expandedKeysList) && expandedKeysList.includes(item.id)) {
        // Use getChildren function to get children
        const children = getChildren(item.id) || [];
        
        // Recursively traverse children
        if (children.length > 0) {
          traverse(children);
        }
      }
    }
  };
  
  traverse(rootItems);
  return result;
};

// Helper function to get parent category
const getParentCategory = (itemId) => {
  if (!itemId) return null;
  const toParentEdgeType = getToParentEdgeType();
  if (!toParentEdgeType) return null;
  
  const item = args.graph?.vertexes?.[itemId];
  if (!item) return null;
  
  // Relationship: child-[toParentEdgeType]->parent
  // Use ->toParentEdgeType to get parent
  const parent = args.evalExpression(
    `->${toParentEdgeType}`,
    { graph: args.graph, setGraph: args.setGraph, vertexes: [item] }
  );
  
  return parent && parent.length > 0 ? parent[0] : null;
};

// Helper function to get first child
const getFirstChild = (itemId) => {
  if (!itemId) return null;
  const children = getChildren(itemId) || [];
  return children.length > 0 ? children[0] : null;
};

// Navigate to adjacent category (for selection, not moving)
const navigateToCategory = async (direction) => {
  const currentSelected = selectedItem();
  if (!currentSelected) return;
  
  const allItems = getAllVisibleItems();
  const currentIndex = allItems.findIndex(i => i.id === currentSelected.id);
  
  if (currentIndex === -1) return;
  
  let targetItem = null;
  const expandedKeysList = expandedKeys();
  
  switch (direction) {
    case 'up':
      // Select previous item
      if (currentIndex > 0) {
        targetItem = allItems[currentIndex - 1];
      }
      break;
      
    case 'down':
      // Select next item
      if (currentIndex < allItems.length - 1) {
        targetItem = allItems[currentIndex + 1];
      }
      break;
      
    case 'left':
      // Collapse if expanded, or select parent
      const isExpanded = Array.isArray(expandedKeysList) && expandedKeysList.includes(currentSelected.id);
      if (isExpanded) {
        await toggleExpand(currentSelected.id);
      } else {
        // Select parent
        const parent = getParentCategory(currentSelected.id);
        if (parent) {
          targetItem = parent;
        }
      }
      break;
      
    case 'right':
      // Expand if collapsed, or select first child
      const isExpanded2 = Array.isArray(expandedKeysList) && expandedKeysList.includes(currentSelected.id);
      if (!isExpanded2) {
        await toggleExpand(currentSelected.id);
      } else {
        // Select first child
        const firstChild = getFirstChild(currentSelected.id);
        if (firstChild) {
          targetItem = firstChild;
        }
      }
      break;
  }
  
  // Select the target item if found
  if (targetItem) {
    handleItemSelect(targetItem);
  }
};

// Keyboard event handler for sidebar
const handleSidebarKeyDown = async (e) => {
  // Only handle if sidebar has focus and no modal is open
  const currentSelected = selectedItem();
  if (!currentSelected) return;
  
  // Handle keyboard shortcuts for navigation/selection
  switch (e.key) {
    case 'ArrowUp':
      e.preventDefault();
      e.stopPropagation();
      await navigateToCategory('up');
      break;
      
    case 'ArrowDown':
      e.preventDefault();
      e.stopPropagation();
      await navigateToCategory('down');
      break;
      
    case 'ArrowLeft':
      e.preventDefault();
      e.stopPropagation();
      await navigateToCategory('left');
      break;
      
    case 'ArrowRight':
      e.preventDefault();
      e.stopPropagation();
      await navigateToCategory('right');
      break;
      
    case 'Enter':
      // Select/activate the current item (same as clicking)
      e.preventDefault();
      e.stopPropagation();
      // handleItemSelect is already called, but we can trigger any additional action if needed
      break;
      
    case 'Escape':
      // Cancel any ongoing operation (if needed)
      e.preventDefault();
      e.stopPropagation();
      break;
      
    default:
      // Let other keys pass through
      return;
  }
};

// Initialize on mount
const initialize = async () => {
  await fetchRoot();
};

return {
  getRoot,
  expandedKeys,
  setExpandedKeys,
  selectedItem,
  setSelectedItem,
  sidebarLoading,
  setSidebarLoading,
  fetchRoot,
  fetchChildren,
  toggleExpand,
  handleItemSelect,
  initialize,
  getParentVertexLabel,
  getToParentEdgeType,
  getRootKeys,
  getTableVertexLabel,
  getRelationshipType,
  getSidebarLabel,
  isAddRootModalOpen,
  setIsAddRootModalOpen,
  handleOpenAddRootModal,
  handleCloseAddRootModal,
  handleAddRootSave,
  updateItemInTree,
  removeItemFromTree,
  getChildren,
  getLoadingState,
  getOnMoveItemsToCategory: () => args.contextData.props?.onMoveItemsToCategory,
  getAllVisibleItems,
  navigateToCategory,
  handleSidebarKeyDown,
  getHooks: () => args.contextData.props?.hooks,
  operationLoading,
  setOperationLoading
};
