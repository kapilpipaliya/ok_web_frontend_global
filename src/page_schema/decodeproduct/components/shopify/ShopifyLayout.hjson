{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''const executeYTOFunction = async (functionName, contextData = {}) => {
  return await args.executeNamedServerFunction({
    functionName,
    contextData: {
      ...contextData,
    }
  });
};

// Create signals for loading state and auth data
const [isLoading, setIsLoading] = args.createSignal(true);
const [authData, setAuthData] = args.createSignal(null);
const [authError, setAuthError] = args.createSignal(null);

// Function to fetch auth data
const fetchAuthData = async () => {
  try {
    setIsLoading(true);
    setAuthError(null);

    const searchParams = args.untrack(() => ({...args.searchParams}));

    // Call the named server function "authShopifyAdminRequest"
    const result = await args.executeNamedServerFunction(
      {
        functionName: "authShopifyAdminRequest",
        contextData: {
          searchParams,
        },
      }, 
      {
        useSessionShop: false
      }
    );

    if (result?.error || result?.result?.success === false) {
      console.error("Shopify auth failed:", result?.error || result?.result?.error);
      const errorMessage = result?.error || result?.result?.error || "Shopify auth failed";
      setAuthError(errorMessage);
      setAuthData({
        data: null,
        error: errorMessage,
        needsOAuth: result?.result?.needsOAuth || false,
        redirectUrl: result?.result?.redirectUrl,
      });
      return;
    }

    const authResult = {
      data: result?.result,
      needsOAuth: result?.result?.needsOAuth || false,
      redirectUrl: result?.result?.redirectUrl,
    };

    setAuthData(authResult);

    // Check if OAuth redirect is needed
    if (authResult?.needsOAuth && authResult?.redirectUrl) {
      // Redirect to OAuth begin endpoint
      window.location.href = authResult.redirectUrl;
    }
  } catch (err) {
    console.error("Error fetching Shopify auth data:", err);
    const errorMessage = err?.message || "Failed to authenticate with Shopify";
    setAuthError(errorMessage);
    setAuthData({
      data: null,
      error: errorMessage,
      needsOAuth: false,
      redirectUrl: null,
    });
  } finally {
    setIsLoading(false);
  }
};

// Handle Shopify navigate event
// when route is loaded outside the Shopify admin, then the user will be redirected to the Shopify admin
const handleNavigate = (event) => {
  const href = event.target?.getAttribute('href');
  if (href) {
    args.navigate(href);
  }
};

// Fetch auth data and register event listener on mount
const onMount = () => {
  fetchAuthData();
  document.addEventListener('shopify:navigate', handleNavigate);
};

// Unregister event listener on cleanup
const onCleanup = () => {
  document.removeEventListener('shopify:navigate', handleNavigate);
};

return {
  executeYTOFunction,
  isLoading,
  setIsLoading,
  authData,
  setAuthData,
  authError,
  setAuthError,
  fetchAuthData,
  handleNavigate,
  onMount,
  onCleanup
}'''
        title: ShopifyLayout
        key: ShopifyLayout
        props:
          '''return {
  onMount: args.fns.onMount,
  onCleanup: args.fns.onCleanup
}'''
      }
    }
