{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job to create or update the master Shopify menu containing all top-level categories.
        body:
          '''
const { menuTitle = "Categories", menuHandle = "categories" } = c;

const shop = c.shop;
if (!shop) { console.log('createAllCategoriesMenu: shop not available in contextData'); return { success: false, error: "shop is required" }; }

try {
  const helpers = await s(
    { functionName: 'shopifyQueueHelpers', contextData: {} }
  );
  if (!helpers.result?.success) {
    return { success: false, error: "Failed to get queue helpers" };
  }
  const queueName = 'processCreateAllCategoriesMenu';
  const queue = helpers.result.data.createShopifyQueue(_, queueName);
  await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    menuTitle,
    menuHandle
  });
  await queue.close();
  return { success: true, message: "Job enqueued to create/update all categories menu" };
} catch (error) {
  console.error("createAllCategoriesMenu: Failed to enqueue job", error);
  return { success: false, error: error.message };
}
'''
        key: createAllCategoriesMenu
      }
    }
  ]
  edges: []
}
