{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job to delete or update Shopify menus when a category is deleted.
        body:
          '''
const { parentVertexLabel, vertexId, operation, result, outgoingEdges, incomingEdges } = c;

if (parentVertexLabel !== 'ShopifyProductCategory' || operation !== 'delete') return;

const shop = c.shop;
if (!shop) { console.log('shopifyMenuAfterDelete: shop not available in contextData'); return; }

try {
  const helpers = await s(
    { functionName: 'shopifyQueueHelpers', contextData: {} }
  );
  if (!helpers.result?.success) return;
  const queueName = 'processShopifyMenuAfterDelete';
  const queue = helpers.result.data.createShopifyQueue(_, queueName);
  const job = await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    parentVertexLabel,
    vertexId,
    operation,
    result,
    outgoingEdges,
    incomingEdges
  });
  await queue.close();
  const jobId = job?.id;
  if (vertexId && jobId) {
    await _.session.run(
      `MATCH (n:ShopifyProductCategory) WHERE elementId(n) = $elementId SET n.syncStatus = $status, n.syncJobId = $jobId, n.updatedAt = datetime()`,
      { elementId: vertexId, status: 'queued', jobId }
    );
  }
} catch (error) {
  console.error("shopifyMenuAfterDelete: Failed to enqueue job", error);
}
'''
        key: shopifyMenuAfterDelete
      }
    }
  ]
  edges: []
}
