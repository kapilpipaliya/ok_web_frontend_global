{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job to update Shopify menu for top-level category when a category is updated.
        body:
          '''
const { parentVertexLabel, vertexId, name, operation, result } = c;

if (parentVertexLabel !== 'ShopifyProductCategory' || operation !== 'update') return;

const shop = c.shop;
if (!shop) { console.log('shopifyMenuAfterUpdate: shop not available in contextData'); return; }

try {
  const helpers = await s(
    { functionName: 'shopifyQueueHelpers', contextData: {} }
  );
  if (!helpers.result?.success) return;
  const queueName = 'processShopifyMenuAfterUpdate';
  const queue = helpers.result.data.createShopifyQueue(_, queueName);
  const job = await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    parentVertexLabel,
    vertexId,
    name,
    operation,
    result
  });
  await queue.close();
  const jobId = job?.id;
  if (vertexId && jobId) {
    await _.session.run(
      `MATCH (n:ShopifyProductCategory) WHERE elementId(n) = $elementId SET n.syncStatus = $status, n.syncJobId = $jobId, n.updatedAt = datetime()`,
      { elementId: vertexId, status: 'queued', jobId }
    );
  }
  const r = c?.result;
  if (r?.data?.P && typeof r.data.P === 'object') {
    r.data.P.syncStatus = 'queued';
    if (jobId) r.data.P.syncJobId = jobId;
  }
} catch (error) {
  console.error("shopifyMenuAfterUpdate: Failed to enqueue job", error);
}
'''
        key: shopifyMenuAfterUpdate
      }
    }
  ]
  edges: []
}
