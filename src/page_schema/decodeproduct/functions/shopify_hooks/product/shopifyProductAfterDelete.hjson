{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job to delete a product in Shopify when a ShopifyProduct is deleted.
        body:
          '''
const { tableVertexLabel, operation, elementId, result, fromWebhook, payload } = c;

const shop = c.shop;
if (!shop) { console.log('shopifyProductAfterDelete: shop not available in contextData'); return; }

const helpers = await s(
  { functionName: 'shopifyQueueHelpers', contextData: {} }
);
if (!helpers.result?.success) return;

const queueName = 'processShopifyProductAfterDelete';

if (fromWebhook && payload) {
  try {
    const queue = helpers.result.data.createShopifyQueue(_, queueName);
    await helpers.result.data.addShopifyJob(queue, queueName, { shop, payload, fromWebhook: true });
    await queue.close();
    console.log('shopifyProductAfterDelete: webhook job enqueued for', shop);
  } catch (error) {
    console.error('shopifyProductAfterDelete: Failed to enqueue webhook job', error);
    throw error;
  }
  return;
}

if (tableVertexLabel !== 'ShopifyProduct' || operation !== 'delete') return;

const deletedData = result?.data;
const productData = deletedData?.P || {};
if (!productData.id) return;

try {
  const queue = helpers.result.data.createShopifyQueue(_, queueName);
  const job = await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    tableVertexLabel,
    operation,
    elementId,
    result
  });
  await queue.close();
  const jobId = job?.id;
  if (elementId && jobId) {
    await _.session.run(
      `MATCH (n:ShopifyProduct) WHERE elementId(n) = $elementId SET n.syncStatus = $status, n.syncJobId = $jobId, n.updatedAt = datetime()`,
      { elementId, status: 'queued', jobId }
    );
  }
} catch (error) {
  console.error("shopifyProductAfterDelete: Failed to enqueue job", error);
}
'''
        key: shopifyProductAfterDelete
      }
    }
  ]
  edges: []
}
