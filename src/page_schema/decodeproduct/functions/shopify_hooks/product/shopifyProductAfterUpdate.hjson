{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job to update a product in Shopify when a ShopifyProduct is updated.
        body:
          '''
const { tableVertexLabel, operation, elementId, data, result, fromWebhook, payload } = args.contextData;

const shop = args.contextData.shop;
if (!shop) { console.log('shopifyProductAfterUpdate: shop not available in contextData'); return; }

const helpers = await args.executeNamedServerFunction(
  { functionName: 'shopifyQueueHelpers', contextData: {} }
);
if (!helpers.result?.success) return;

const queueName = 'processShopifyProductAfterUpdate';

if (fromWebhook && payload) {
  try {
    const queue = helpers.result.data.createShopifyQueue(args, queueName);
    await helpers.result.data.addShopifyJob(queue, queueName, { shop, payload, fromWebhook: true });
    await queue.close();
    console.log('shopifyProductAfterUpdate: webhook job enqueued for', shop);
  } catch (error) {
    console.error('shopifyProductAfterUpdate: Failed to enqueue webhook job', error);
    throw error;
  }
  return;
}

if (tableVertexLabel !== 'ShopifyProduct' || operation !== 'update') return;
const vertex = data?.vertex;
const formData = vertex?.P || {};
if (!formData.id) return;

try {
  const queue = helpers.result.data.createShopifyQueue(args, queueName);
  const job = await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    tableVertexLabel,
    operation,
    elementId,
    data,
    result
  });
  await queue.close();
  const jobId = job?.id;
  if (elementId && jobId) {
    await args.session.run(
      `MATCH (n:ShopifyProduct) WHERE elementId(n) = $elementId SET n.syncStatus = $status, n.syncJobId = $jobId, n.updatedAt = datetime()`,
      { elementId, status: 'queued', jobId }
    );
  }
  const r = args.contextData?.result;
  if (r?.data?.P && typeof r.data.P === 'object') {
    r.data.P.syncStatus = 'queued';
    if (jobId) r.data.P.syncJobId = jobId;
  }
} catch (error) {
  console.error("shopifyProductAfterUpdate: Failed to enqueue job", error);
}
'''
        key: shopifyProductAfterUpdate
      }
    }
  ]
  edges: []
}
