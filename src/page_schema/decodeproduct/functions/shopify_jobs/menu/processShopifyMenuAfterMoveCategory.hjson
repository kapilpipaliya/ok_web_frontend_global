{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Background job: updates Shopify menus when a category is moved (from/to top-level).
        body:
          '''
const QUEUE_NAME = 'processShopifyMenuAfterMoveCategory';

const helpers = await args.executeNamedServerFunction(
  { functionName: 'shopifyQueueHelpers', contextData: {} },
  { functionLookupSubDomain: args.subDomain }
);
if (!helpers.result?.success) {
  console.error('Shopify queue helpers init failed', helpers.result?.error);
  throw new Error('Shopify queue helpers initialization failed');
}
const h = helpers.result.data;
const runWithSession = h.runWithSession;

const doJob = async (args, jobData, dbSession, subDomain) => {
  const { parentVertexLabel, categoryId, newParentId, oldParentId, toParentEdgeType, shop } = jobData;
  if (parentVertexLabel !== 'ShopifyProductCategory') return;
  try {
    if (oldParentId && oldParentId !== 'root' && oldParentId !== 'uncategorized') {
      const oldParentResult = await h.updateTopLevelCategoryMenuLogic(args, dbSession, { categoryElementId: oldParentId, shop });
      if (oldParentResult?.success) console.log(`✅ ${oldParentResult.message}`);
    } else if (!oldParentId || oldParentId === 'root' || oldParentId === 'uncategorized') {
      const movedCategoryResult = await dbSession.run(
        `MATCH (category:ShopifyProductCategory) WHERE elementId(category) = $categoryId
         RETURN category.menuId as menuId, category.name as name, category.id as shopifyId`,
        { categoryId }
      );
      if (movedCategoryResult.records.length > 0) {
        const record = movedCategoryResult.records[0];
        const menuId = record.get('menuId');
        const categoryName = record.get('name');
        const shopifyId = record.get('shopifyId');
        if (menuId && shopifyId) {
          const deleteResult = await h.deleteShopifyMenuLogic(args, dbSession, { menuId, categoryElementId: categoryId, shop });
          if (deleteResult?.success) console.log(`✅ Deleted menu for root category "${categoryName}" that is no longer top-level`);
        }
      }
    }
    const movedCategoryResult = await h.updateTopLevelCategoryMenuLogic(args, dbSession, { categoryElementId: categoryId, shop });
    if (movedCategoryResult?.success) {
      console.log(`✅ ${movedCategoryResult.message}`);
      if (categoryId) await dbSession.run(`MATCH (c:ShopifyProductCategory) WHERE elementId(c) = $elementId SET c.syncStatus = 'complete', c.updatedAt = datetime()`, { elementId: categoryId });
      if (shop) {
        try {
          const q = h.createShopifyQueue(args, 'processCreateAllCategoriesMenu');
          await h.addShopifyJob(q, 'processCreateAllCategoriesMenu', { shop, menuTitle: 'Categories', menuHandle: 'categories' });
          await q.close();
        } catch (e) {
          console.error('createAllCategoriesMenu enqueue:', e);
        }
      }
    } else {
      const errMsg = (movedCategoryResult?.error && (typeof movedCategoryResult.error === 'string' ? movedCategoryResult.error : movedCategoryResult.error?.message || String(movedCategoryResult.error))) || 'Menu update failed';
      if (categoryId) await dbSession.run(`MATCH (c:ShopifyProductCategory) WHERE elementId(c) = $elementId SET c.syncStatus = 'failed', c.syncError = $syncError, c.updatedAt = datetime()`, { elementId: categoryId, syncError: errMsg.substring(0, 2000) });
    }
    console.log(`✅ Menu updates complete after category move`);
  } catch (error) {
    console.error("processShopifyMenuAfterMoveCategory: Error", error);
    const errMsg = error?.message || String(error);
    if (categoryId) await dbSession.run(`MATCH (c:ShopifyProductCategory) WHERE elementId(c) = $elementId SET c.syncStatus = 'failed', c.syncError = $syncError, c.updatedAt = datetime()`, { elementId: categoryId, syncError: errMsg.substring(0, 2000) });
  }
};

if (args.contextData?.action === 'start') {
  const { Worker } = args.bullmq;
  const connection = h.getRedisConnection();
  if (!connection || !connection.host) throw new Error('Invalid Redis connection for Shopify jobs');
  let workerInstance;
  try {
    workerInstance = new Worker(QUEUE_NAME, async (job) => {
      await runWithSession(args, job.data.shop, async (dbSession, subDomain) => {
        await doJob(args, job.data, dbSession, subDomain);
      });
    }, { connection, concurrency: 2, lockDuration: 120000 });
    workerInstance.on('failed', (job, err) => console.error('processShopifyMenuAfterMoveCategory: Job failed', job?.id, err?.message));
    workerInstance.on('error', (err) => console.error('processShopifyMenuAfterMoveCategory: Worker error', err?.message));
    return { stop: async (force = false) => { if (workerInstance) await workerInstance.close(force); } };
  } catch (error) {
    console.error('processShopifyMenuAfterMoveCategory: Failed to create worker', error);
    if (workerInstance) { try { await workerInstance.close(); } catch (e) {} }
    throw error;
  }
}
'''
        key: processShopifyMenuAfterMoveCategory
      }
    }
  ]
  edges: []
}
