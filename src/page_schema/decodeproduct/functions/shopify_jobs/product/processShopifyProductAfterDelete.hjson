{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Background job: deletes a product in Shopify when a ShopifyProduct is deleted.
        body:
          '''
const QUEUE_NAME = 'processShopifyProductAfterDelete';

const doJob = async (_, jobData, dbSession) => {
  const { tableVertexLabel, operation, elementId, result, shop, fromWebhook, payload } = jobData;

  if (fromWebhook && payload) {
    const h = await s(
      { functionName: 'shopifyQueueHelpers', contextData: {} },
      { functionLookupSubDomain: 'decodeproduct' }
    );
    if (!h?.result?.success) return;
    const id = h.result.data.ensureProductGid(payload.admin_graphql_api_id || payload.id);
    if (!id) return;
    await dbSession.run(`MATCH (p:ShopifyProduct { id: $id }) DETACH DELETE p`, { id });
    console.log(`processShopifyProductAfterDelete (webhook): removed product ${id} for ${shop}`);
    return;
  }

  if (tableVertexLabel !== 'ShopifyProduct' || operation !== 'delete') return;

  const deletedData = result?.data;
  const productData = deletedData?.P || {};
  const shopifyProductId = productData.id;

  if (!shopifyProductId) {
    console.log("processShopifyProductAfterDelete: Product doesn't have Shopify ID, skipping");
    return;
  }

  const shopify = await _.getShopifyClient();
  let admin;
  try {
    const authResult = await shopify.unauthenticated.admin(shop);
    admin = authResult.admin;
  } catch (authError) {
    console.error("processShopifyProductAfterDelete: unauthenticated.admin failed", authError);
    return;
  }
  if (!admin) return;

  try {
    const deleteProductMutation = `
      mutation productDelete($id: ID!) {
        productDelete(input: { id: $id }) {
          deletedProductId
          userErrors { field message }
        }
      }
    `;
    const response = await admin.graphql(deleteProductMutation, { variables: { id: shopifyProductId } });
    let apiResponse = response instanceof Response ? await response.json() : response;
    if (apiResponse.errors && apiResponse.errors.length > 0) {
      console.error("processShopifyProductAfterDelete: GraphQL errors:", apiResponse.errors);
      return;
    }
    const userErrors = apiResponse.data?.productDelete?.userErrors || [];
    if (userErrors.length > 0) {
      console.error("processShopifyProductAfterDelete: User errors:", userErrors);
      return;
    }
    const deletedProductId = apiResponse.data?.productDelete?.deletedProductId;
    if (deletedProductId) console.log(`✅ Deleted product in Shopify: ${deletedProductId}`);
  } catch (error) {
    console.error("processShopifyProductAfterDelete: Error", error);
    // Vertex already deleted from graph so syncError cannot be set
  }
};

const helpers = await s(
  { functionName: 'shopifyQueueHelpers', contextData: {} },
  { functionLookupSubDomain: _.subDomain }
);
if (!helpers.result?.success) {
  console.error('Shopify queue helpers init failed', helpers.result?.error);
  throw new Error('Shopify queue helpers initialization failed');
}
const runWithSession = helpers.result.data.runWithSession;

if (c?.action === 'start') {
  const { Worker } = _.bullmq;
  const connection = helpers.result.data.getRedisConnection();
  if (!connection || !connection.host) throw new Error('Invalid Redis connection for Shopify jobs');
  let workerInstance;
  try {
    workerInstance = new Worker(QUEUE_NAME, async (job) => {
      await runWithSession(_, job.data.shop, async (dbSession) => {
        await doJob(_, job.data, dbSession);
      });
    }, { connection, concurrency: 2, lockDuration: 120000 });
    workerInstance.on('failed', (job, err) => console.error('processShopifyProductAfterDelete: Job failed', job?.id, err?.message));
    workerInstance.on('error', (err) => console.error('processShopifyProductAfterDelete: Worker error', err?.message));
    return { stop: async (force = false) => { if (workerInstance) await workerInstance.close(force); } };
  } catch (error) {
    console.error('processShopifyProductAfterDelete: Failed to create worker', error);
    if (workerInstance) { try { await workerInstance.close(); } catch (e) {} }
    throw error;
  }
}
'''
        key: processShopifyProductAfterDelete
      }
    }
  ]
  edges: []
}
