{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Background job: updates a product in Shopify when a ShopifyProduct is updated.
        body:
          '''
const QUEUE_NAME = 'processShopifyProductAfterUpdate';

const doJob = async (_, jobData, dbSession) => {
  const { tableVertexLabel, operation, elementId, data: vertexPayload, result, shop, fromWebhook, payload } = jobData;

  if (fromWebhook && payload) {
    const h = await s(
      { functionName: 'shopifyQueueHelpers', contextData: {} },
      { functionLookupSubDomain: 'decodeproduct' }
    );
    if (!h?.result?.success) return;
    const propsFromWebhookPayload = h.result.data.propsFromWebhookPayload;
    const props = propsFromWebhookPayload(payload);
    const id = props.id;
    if (!id) return;
    await dbSession.run(
      `MERGE (p:ShopifyProduct { id: $id })
       ON CREATE SET p.createdAt = datetime(), p.updatedAt = datetime()
       SET p += $props, p.updatedAt = datetime()`,
      { id, props }
    );
    console.log(`processShopifyProductAfterUpdate (webhook): synced product ${id} for ${shop}`);
    return;
  }

  if (tableVertexLabel !== 'ShopifyProduct' || operation !== 'update') return;
  const vertex = vertexPayload?.vertex;
  const formData = vertex?.P || {};
  const shopifyProductId = formData.id;
  if (!shopifyProductId) { console.log("processShopifyProductAfterUpdate: Product doesn't have Shopify ID, skipping"); return; }
  const shopify = await _.getShopifyClient();
  let admin;
  try { const authResult = await shopify.unauthenticated.admin(shop); admin = authResult.admin; } catch (authError) {
    console.error("processShopifyProductAfterUpdate: unauthenticated.admin failed", authError);
    const errMsg = (authError?.message || String(authError)).substring(0, 2000);
    if (elementId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'failed', p.syncError = $syncError, p.updatedAt = datetime()`, { elementId, syncError: errMsg });
    return;
  }
  if (!admin) {
    if (elementId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'failed', p.syncError = $syncError, p.updatedAt = datetime()`, { elementId, syncError: 'Shopify admin client unavailable' });
    return;
  }
  const title = formData.title || formData.name || 'Untitled Product';
  const descriptionHtml = formData.descriptionHtml || formData.description || '';
  const vendor = formData.vendor || '';
  const productType = formData.productType || '';
  const status = formData.status || 'DRAFT';
  const tags = formData.tags || [];
  const updateProductMutation = `mutation productUpdate($input: ProductInput!) { productUpdate(input: $input) { product { id title handle status } userErrors { field message } } }`;
  const productInput = { id: shopifyProductId, title, descriptionHtml, vendor, productType, status, tags };
  const variables = { input: productInput };
  try {
    const response = await admin.graphql(updateProductMutation, { variables });
    let apiResponse = response instanceof Response ? await response.json() : response;
    if (apiResponse.errors && apiResponse.errors.length > 0) {
      const errMsg = JSON.stringify(apiResponse.errors).substring(0, 2000);
      if (elementId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'failed', p.syncError = $syncError, p.updatedAt = datetime()`, { elementId, syncError: errMsg });
      return;
    }
    const userErrors = apiResponse.data?.productUpdate?.userErrors || [];
    if (userErrors.length > 0) {
      const errMsg = JSON.stringify(userErrors).substring(0, 2000);
      if (elementId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'failed', p.syncError = $syncError, p.updatedAt = datetime()`, { elementId, syncError: errMsg });
      return;
    }
    const updatedProduct = apiResponse.data?.productUpdate?.product;
    if (!updatedProduct) {
      if (elementId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'failed', p.syncError = $syncError, p.updatedAt = datetime()`, { elementId, syncError: 'No product in response' });
      return;
    }
    const shopifyHandle = updatedProduct.handle;
    if (elementId && shopifyHandle) {
      await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.handle = $handle, p.syncStatus = 'complete', p.updatedAt = datetime()`, { elementId, handle: shopifyHandle });
      if (result?.data?.P) result.data.P.handle = shopifyHandle;
      console.log(`✅ Updated product in Shopify: ${shopifyProductId}`);
    }
  } catch (error) { console.error("processShopifyProductAfterUpdate: Error", error); const errMsg = error?.message || String(error); if (elementId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'failed', p.syncError = $syncError, p.updatedAt = datetime()`, { elementId, syncError: errMsg.substring(0, 2000) }); }
};

const helpers = await s(
  { functionName: 'shopifyQueueHelpers', contextData: {} },
  { functionLookupSubDomain: _.subDomain }
);
if (!helpers.result?.success) {
  console.error('Shopify queue helpers init failed', helpers.result?.error);
  throw new Error('Shopify queue helpers initialization failed');
}
const runWithSession = helpers.result.data.runWithSession;

if (c?.action === 'start') {
  const { Worker } = _.bullmq;
  const connection = helpers.result.data.getRedisConnection();
  if (!connection || !connection.host) throw new Error('Invalid Redis connection for Shopify jobs');
  let workerInstance;
  try {
    workerInstance = new Worker(QUEUE_NAME, async (job) => {
      await runWithSession(_, job.data.shop, async (dbSession) => {
        await doJob(_, job.data, dbSession);
      });
    }, { connection, concurrency: 2, lockDuration: 120000 });
    workerInstance.on('failed', (job, err) => console.error('processShopifyProductAfterUpdate: Job failed', job?.id, err?.message));
    workerInstance.on('error', (err) => console.error('processShopifyProductAfterUpdate: Worker error', err?.message));
    return { stop: async (force = false) => { if (workerInstance) await workerInstance.close(force); } };
  } catch (error) {
    console.error('processShopifyProductAfterUpdate: Failed to create worker', error);
    if (workerInstance) { try { await workerInstance.close(); } catch (e) {} }
    throw error;
  }
}
'''
        key: processShopifyProductAfterUpdate
      }
    }
  ]
  edges: []
}
