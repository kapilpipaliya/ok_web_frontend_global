{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Background job: adds category name as tag to Shopify product when product is added to a category.
        body:
          '''
const QUEUE_NAME = 'processShopifyProductAfterCreateRelationship';

const doJob = async (args, jobData, dbSession) => {
  const { contentLabel, contentId, categoryId, categoryLabel, shop } = jobData;
  if (contentLabel !== 'ShopifyProduct') return;
  if (!categoryId || categoryId === 'uncategorized') return;

  const shopify = await args.getShopifyClient();
  let admin;
  try {
    const authResult = await shopify.unauthenticated.admin(shop);
    admin = authResult.admin;
  } catch (authError) {
    console.error("processShopifyProductAfterCreateRelationship: unauthenticated.admin failed", authError);
    const errMsg = (authError?.message || String(authError)).substring(0, 2000);
    if (contentId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'failed', p.syncError = $syncError, p.updatedAt = datetime()`, { elementId: contentId, syncError: errMsg });
    return;
  }
  if (!admin) {
    if (contentId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'failed', p.syncError = $syncError, p.updatedAt = datetime()`, { elementId: contentId, syncError: 'Shopify admin client unavailable' });
    return;
  }

  const combinedResult = await dbSession.run(
    `MATCH (cat:${categoryLabel}) WHERE elementId(cat) = $categoryId
     WITH cat.name as categoryName
     MATCH (p:ShopifyProduct) WHERE elementId(p) = $contentId
     RETURN categoryName, p.id as shopifyId`,
    { categoryId, contentId }
  );
  if (combinedResult.records.length === 0) {
    if (contentId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'failed', p.syncError = $syncError, p.updatedAt = datetime()`, { elementId: contentId, syncError: 'Product or category not found' });
    return;
  }
  const row = combinedResult.records[0];
  const categoryName = row.get('categoryName') || null;
  const shopifyId = row.get('shopifyId');
  if (!categoryName) {
    console.warn("processShopifyProductAfterCreateRelationship: Could not find category name");
    return;
  }
  if (!shopifyId) {
    if (contentId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'failed', p.syncError = $syncError, p.updatedAt = datetime()`, { elementId: contentId, syncError: 'Product has no Shopify ID' });
    return;
  }

  const h = helpers.result.data;
  try {
    const tagsMap = await h.batchGetProductTags(admin, [shopifyId]);
    const currentTags = tagsMap.get(shopifyId) || [];
    let updatedTags = [...currentTags];
    if (!updatedTags.includes(categoryName)) updatedTags.push(categoryName);
    const updates = [{ shopifyId, tags: updatedTags, elementId: contentId }];
    const { success: successList, failed: failedList } = await h.batchUpdateProductTags(admin, updates);
    if (failedList.length > 0) {
      const errMsg = failedList[0].error || 'Tag update failed';
      if (contentId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'failed', p.syncError = $syncError, p.updatedAt = datetime()`, { elementId: contentId, syncError: errMsg.substring(0, 2000) });
      return;
    }
    if (contentId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'complete', p.updatedAt = datetime()`, { elementId: contentId });
    console.log(`✅ Added category tag "${categoryName}" to product ${shopifyId}`);
  } catch (error) {
    console.error("processShopifyProductAfterCreateRelationship: Error", error);
    const errMsg = error?.message || String(error);
    if (contentId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'failed', p.syncError = $syncError, p.updatedAt = datetime()`, { elementId: contentId, syncError: errMsg.substring(0, 2000) });
  }
};

const helpers = await args.executeNamedServerFunction(
  { functionName: 'shopifyQueueHelpers', contextData: {} },
  { functionLookupSubDomain: args.subDomain }
);
if (!helpers.result?.success) {
  console.error('Shopify queue helpers init failed', helpers.result?.error);
  throw new Error('Shopify queue helpers initialization failed');
}
const runWithSession = helpers.result.data.runWithSession;

if (args.contextData?.action === 'start') {
  const { Worker } = args.bullmq;
  const connection = helpers.result.data.getRedisConnection();
  if (!connection || !connection.host) throw new Error('Invalid Redis connection for Shopify jobs');
  let workerInstance;
  try {
    workerInstance = new Worker(QUEUE_NAME, async (job) => {
      await runWithSession(args, job.data.shop, async (dbSession) => {
        await doJob(args, job.data, dbSession);
      });
    }, { connection, concurrency: 2, lockDuration: 120000 });
    workerInstance.on('failed', (job, err) => console.error('processShopifyProductAfterCreateRelationship: Job failed', job?.id, err?.message));
    workerInstance.on('error', (err) => console.error('processShopifyProductAfterCreateRelationship: Worker error', err?.message));
    return { stop: async (force = false) => { if (workerInstance) await workerInstance.close(force); } };
  } catch (error) {
    console.error('processShopifyProductAfterCreateRelationship: Failed to create worker', error);
    if (workerInstance) { try { await workerInstance.close(); } catch (e) {} }
    throw error;
  }
}
'''
        key: processShopifyProductAfterCreateRelationship
      }
    }
  ]
  edges: []
}
