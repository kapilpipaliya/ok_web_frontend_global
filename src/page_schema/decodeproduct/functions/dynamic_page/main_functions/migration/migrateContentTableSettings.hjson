        fields: [
          {
            key: "title",
            label: "Title",
            type: "text",
            required: true,
            maxLength: 255,
            colSpan: 2
          },
          {
            key: "handle",
            label: "Handle",
            type: "text",
            colSpan: 2
          },
          {
            key: "status",
            label: "Status",
            type: "text"
          },
          {
            key: "syncStatus",
            label: "Sync Status",
            type: "text"
          }
        ]
      }
    ]
  },
  uniqueKeys: [],
  usePolarisUI: true,
  // Filters use Polaris search field (s-search-field) for select and date when usePolarisUI is true
  enableUserScopingForSidebar: false,
  enableUserScopingForContent: false,
  enableLocalFilters: true,
  enableLocalSort: true,
  refetchIntervalWhenQueued: 5000,
  hooks: {
    // Hooks for fetching data - syncs Shopify products when fetching uncategorized
    beforeFetchData: "shopifyProductBeforeFetchData",
    // afterFetchData: ["shopifyProductAfterFetchData", "shopifyProductLogFetch"],
    // Hooks for creating items
    // beforeCreate: "shopifyProductBeforeCreate",
    // Hooks for creating - creates product in Shopify when new product is added
    afterCreate: "shopifyProductAfterCreate",
    // Hooks for updating items
    // beforeUpdate: "shopifyProductBeforeUpdate",
    // Hooks for updating - updates product in Shopify when product is updated
    afterUpdate: "shopifyProductAfterUpdate",
    // Hooks for deleting items
    // beforeDelete: "shopifyProductBeforeDelete",
    // Hooks for deleting - deletes product from Shopify when product is deleted
    afterDelete: "shopifyProductAfterDelete",
    // Hooks for moving items to category
    // beforeMoveItemsToCategory: "shopifyProductBeforeMoveItemsToCategory",
    // Hooks for moving items to category - updates Shopify product tags
    afterMoveItemsToCategory: "shopifyProductAfterMoveItemsToCategory",
    // Hooks for import/export operations
    // beforeImport: "shopifyProductBeforeImport",
    // afterImport: ["shopifyProductAfterImport", "shopifyProductLogImport"],
    // beforeExport: "shopifyProductBeforeExport",
    // afterExport: "shopifyProductAfterExport",
    // Hooks for relationship and vertex operations
    // beforeCreateRelationship: "shopifyProductBeforeCreateRelationship",
    // Hooks for creating relationship - adds category tag to Shopify product
    afterCreateRelationship: "shopifyProductAfterCreateRelationship",
    // beforeGetUserVertices: "shopifyProductBeforeGetUserVertices",
    // afterGetUserVertices: "shopifyProductAfterGetUserVertices",
    // beforeGetVertexChildren: "shopifyProductBeforeGetVertexChildren",
    // afterGetVertexChildren: ["shopifyProductAfterGetVertexChildren", "shopifyProductLogGetChildren"]
  },
  sidebar: {
    enabled: true,
    parentVertexLabel: "ShopifyProductCategory",
    toParentEdgeType: "ProductCategory",
    rootKeys: {},
    label: "Category",
    loadFullTree: true,
    refetchIntervalWhenQueued: 5000,
    formConfig: {
      gridColumns: 1,
      groups: [
        {
          key: "basic",
          title: "Basic Information",
          gridColumns: 2,
          fields: [
            {
              key: "name",
              label: "Name",
              type: "text",
              required: true,
              maxLength: 255,
              colSpan: 2
            }
          ]
        }
      ]
    },
    hooks: {
      // Hooks for creating category - creates collection in Shopify (menu jobs enqueued from within)
      afterCreate: ["shopifyProductCategoryAfterCreate"],
      // Hooks for updating category - updates collection in Shopify (menu jobs enqueued from within)
      afterUpdate: ["shopifyProductCategoryAfterUpdate"],
      // Hooks for deleting category - deletes collection in Shopify (menu jobs enqueued from within)
      afterDelete: ["shopifyProductCategoryAfterDelete"],
      // Hooks for moving category - updates menus when category is moved
      afterMoveCategory: ["shopifyMenuAfterMoveCategory"]
    }
  }
};`
  },
