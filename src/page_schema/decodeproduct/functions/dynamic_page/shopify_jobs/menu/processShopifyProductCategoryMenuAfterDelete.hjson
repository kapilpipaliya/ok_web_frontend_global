{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Background job: deletes or updates Shopify menus when a category is deleted.
        body:
          '''
const QUEUE_NAME = 'processShopifyProductCategoryMenuAfterDelete';

const doJob = async (args, jobData, dbSession, subDomain, h) => {
  const { parentVertexLabel, vertexId, operation, result, outgoingEdges, incomingEdges, shop } = jobData;
  if (parentVertexLabel !== 'ShopifyProductCategory' || operation !== 'delete') return;
  try {
    const deletedData = result?.data;
    const categoryData = deletedData?.P || {};
    const deletedMenuId = categoryData.menuId;
    const deletedName = categoryData.name;
    if (deletedMenuId) {
      const deleteResult = await h.deleteShopifyMenuLogic(args, dbSession, { menuId: deletedMenuId, categoryElementId: vertexId, shop });
      if (deleteResult?.success) console.log(`✅ Deleted menu for top-level category "${deletedName}"`);
      else console.error("processShopifyProductCategoryMenuAfterDelete: Failed to delete menu:", deleteResult?.error);
      return;
    }
    const affectedCategoryIds = new Set();
    if (outgoingEdges && Array.isArray(outgoingEdges)) {
      for (const edge of outgoingEdges) {
        if (edge && edge.type === 'ProductCategory' && edge.targetLabel === 'ShopifyProductCategory' && edge.from === vertexId && edge.to) affectedCategoryIds.add(edge.to);
      }
    }
    if (incomingEdges && Array.isArray(incomingEdges)) {
      for (const edge of incomingEdges) {
        if (edge && edge.type === 'ProductCategory' && edge.sourceLabel === 'ShopifyProductCategory' && edge.to === vertexId && edge.from) affectedCategoryIds.add(edge.from);
      }
    }
    for (const affectedCategoryId of affectedCategoryIds) {
      const menuResult = await h.updateTopLevelCategoryMenuLogic(args, dbSession, { categoryElementId: affectedCategoryId, shop });
      if (menuResult?.success) {
        console.log(`✅ ${menuResult.message}`);
        await dbSession.run(`MATCH (c:ShopifyProductCategory) WHERE elementId(c) = $elementId SET c.syncStatus = 'complete', c.updatedAt = datetime()`, { elementId: affectedCategoryId });
      } else if (menuResult?.action !== 'skipped') {
        console.warn("processShopifyProductCategoryMenuAfterDelete: Failed to update menu:", menuResult?.error);
        await dbSession.run(`MATCH (c:ShopifyProductCategory) WHERE elementId(c) = $elementId SET c.syncStatus = 'failed', c.updatedAt = datetime()`, { elementId: affectedCategoryId });
      }
    }
  } catch (error) {
    console.error("processShopifyProductCategoryMenuAfterDelete: Error", error);
    if (vertexId) { try { await dbSession.run(`MATCH (c:ShopifyProductCategory) WHERE elementId(c) = $elementId SET c.syncStatus = 'failed', c.updatedAt = datetime()`, { elementId: vertexId }); } catch (e) {} }
  }
};

if (args.contextData?.action === 'start') {
  const helpers = await args.executeNamedServerFunction(
    { functionName: 'shopifyQueueHelpers', contextData: {} },
    { functionLookupSubDomain: args.subDomain }
  );
  if (!helpers.result?.success) {
    console.error('Shopify queue helpers init failed', helpers.result?.error);
    throw new Error('Shopify queue helpers initialization failed');
  }
  const { Worker } = args.bullmq;
  const connection = helpers.result.data.getRedisConnection();
  if (!connection || !connection.host) throw new Error('Invalid Redis connection for Shopify jobs');
  const runWithSession = helpers.result.data.runWithSession;
  const h = helpers.result.data;
  let workerInstance;
  try {
    workerInstance = new Worker(QUEUE_NAME, async (job) => {
      await runWithSession(args, job.data.shop, async (dbSession, subDomain) => {
        await doJob(args, job.data, dbSession, subDomain, h);
      });
    }, { connection, concurrency: 2 });
    workerInstance.on('failed', (job, err) => console.error('processShopifyProductCategoryMenuAfterDelete: Job failed', job?.id, err?.message));
    workerInstance.on('error', (err) => console.error('processShopifyProductCategoryMenuAfterDelete: Worker error', err?.message));
    return { stop: async (force = false) => { if (workerInstance) await workerInstance.close(force); } };
  } catch (error) {
    console.error('processShopifyProductCategoryMenuAfterDelete: Failed to create worker', error);
    if (workerInstance) { try { await workerInstance.close(); } catch (e) {} }
    throw error;
  }
}

const helpers = await args.executeNamedServerFunction(
  { functionName: 'shopifyQueueHelpers', contextData: {} },
  { functionLookupSubDomain: args.subDomain }
);
if (!helpers.result?.success) throw new Error('Shopify queue helpers initialization failed');
const h = helpers.result.data;
await helpers.result.data.runWithSession(args, args.contextData.shop, async (dbSession, subDomain) => {
  await doJob(args, args.contextData, dbSession, subDomain, h);
});
'''
        key: processShopifyProductCategoryMenuAfterDelete
      }
    }
  ]
  edges: []
}
