{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Background job: updates a collection in Shopify when a ShopifyProductCategory is modified; updates product tags if name changed.
        body:
          '''
const QUEUE_NAME = 'processShopifyProductCategoryAfterUpdate';

const helpers = await args.executeNamedServerFunction(
  { functionName: 'shopifyQueueHelpers', contextData: {} },
  { functionLookupSubDomain: args.subDomain }
);
if (!helpers.result?.success) {
  console.error('Shopify queue helpers init failed', helpers.result?.error);
  throw new Error('Shopify queue helpers initialization failed');
}
const h = helpers.result.data;
const runWithSession = h.runWithSession;

const doJob = async (args, jobData, dbSession) => {
  const { parentVertexLabel, name, vertexId, operation, result, oldData, shop } = jobData;
  if (parentVertexLabel !== 'ShopifyProductCategory' || operation !== 'update') return;

  const shopify = args.getShopifyClient();
  let admin;
  try {
    const authResult = await shopify.unauthenticated.admin(shop);
    admin = authResult.admin;
  } catch (authError) {
    console.error("processShopifyProductCategoryAfterUpdate: unauthenticated.admin failed", authError);
    const errMsg = (authError?.message || String(authError)).substring(0, 2000);
    if (vertexId) await dbSession.run(`MATCH (c:ShopifyProductCategory) WHERE elementId(c) = $elementId SET c.syncStatus = 'failed', c.syncError = $syncError, c.updatedAt = datetime()`, { elementId: vertexId, syncError: errMsg });
    return;
  }
  if (!admin) {
    if (vertexId) await dbSession.run(`MATCH (c:ShopifyProductCategory) WHERE elementId(c) = $elementId SET c.syncStatus = 'failed', c.syncError = $syncError, c.updatedAt = datetime()`, { elementId: vertexId, syncError: 'Shopify admin client unavailable' });
    return;
  }

  const vertex = result?.data;
  const categoryData = vertex?.P || {};
  const shopifyCollectionId = categoryData.id;
  const oldCategoryName = oldData?.P?.name || null;
  const newCategoryName = name;
  const nameChanged = oldCategoryName && oldCategoryName !== newCategoryName;

  if (!shopifyCollectionId) {
    console.warn("processShopifyProductCategoryAfterUpdate: No Shopify collection ID for category vertexId=", vertexId, ", skipping");
    if (vertexId) await dbSession.run(`MATCH (c:ShopifyProductCategory) WHERE elementId(c) = $elementId SET c.syncStatus = 'failed', c.syncError = $syncError, c.updatedAt = datetime()`, { elementId: vertexId, syncError: 'No Shopify collection ID' });
    return;
  }


  try {
    const updateCollectionMutation = `
      mutation collectionUpdate($input: CollectionInput!) {
        collectionUpdate(input: $input) {
          collection { id handle title }
          userErrors { field message }
        }
      }
    `;
    const variables = {
      input: {
        id: shopifyCollectionId,
        title: name,
        descriptionHtml: `<p>Products for ${name}</p>`,
        seo: { title: name, description: `Products for ${name}` },
        ruleSet: { rules: [{ column: "TAG", relation: "EQUALS", condition: name }], appliedDisjunctively: false }
      }
    };
    const response = await admin.graphql(updateCollectionMutation, { variables });
    let apiResponse = response instanceof Response ? await response.json() : response;
    if (apiResponse.errors && apiResponse.errors.length > 0) {
      const errMsg = JSON.stringify(apiResponse.errors).substring(0, 2000);
      if (vertexId) await dbSession.run(`MATCH (c:ShopifyProductCategory) WHERE elementId(c) = $elementId SET c.syncStatus = 'failed', c.syncError = $syncError, c.updatedAt = datetime()`, { elementId: vertexId, syncError: errMsg });
      return;
    }
    const userErrors = apiResponse.data?.collectionUpdate?.userErrors || [];
    if (userErrors.length > 0) {
      const errMsg = JSON.stringify(userErrors).substring(0, 2000);
      if (vertexId) await dbSession.run(`MATCH (c:ShopifyProductCategory) WHERE elementId(c) = $elementId SET c.syncStatus = 'failed', c.syncError = $syncError, c.updatedAt = datetime()`, { elementId: vertexId, syncError: errMsg });
      return;
    }
    const updatedCollection = apiResponse.data?.collectionUpdate?.collection;
    if (!updatedCollection) {
      if (vertexId) await dbSession.run(`MATCH (c:ShopifyProductCategory) WHERE elementId(c) = $elementId SET c.syncStatus = 'failed', c.syncError = $syncError, c.updatedAt = datetime()`, { elementId: vertexId, syncError: 'No collection in response' });
      return;
    }
    if (nameChanged && newCategoryName) {
      const updateProductTagsForCategoryNameChange = async (categoryId, oldName, newName, adminInstance) => {
        if (!categoryId || !newName) return;
        const productsResult = await dbSession.run(
          `MATCH (p:ShopifyProduct)-[:ProductCategory]->(cat:ShopifyProductCategory)
           WHERE elementId(cat) = $categoryId RETURN elementId(p) as elementId, p.id as shopifyId`,
          { categoryId }
        );
        const products = [];
        for (const record of productsResult.records) {
          const shopifyId = record.get('shopifyId');
          if (shopifyId) products.push({ elementId: record.get('elementId'), shopifyId });
        }
        if (products.length === 0) return;
        const shopifyIds = products.map(p => p.shopifyId);
        const tagsMap = await h.batchGetProductTags(adminInstance, shopifyIds);
        const updates = [];
        for (const p of products) {
          const currentTags = tagsMap.get(p.shopifyId) || [];
          let updatedTags = [...currentTags];
          if (oldName && updatedTags.includes(oldName)) updatedTags = updatedTags.filter(tag => tag !== oldName);
          if (newName && !updatedTags.includes(newName)) updatedTags.push(newName);
          if (JSON.stringify([...currentTags].sort()) === JSON.stringify([...updatedTags].sort())) continue;
          updates.push({ shopifyId: p.shopifyId, tags: updatedTags, elementId: p.elementId });
        }
        if (updates.length === 0) return;
        const { success: successList, failed: failedList } = await h.batchUpdateProductTags(adminInstance, updates);
        for (const u of successList) {
          if (u.elementId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'complete', p.updatedAt = datetime()`, { elementId: u.elementId });
        }
        for (const u of failedList) {
          if (u.elementId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'failed', p.syncError = $syncError, p.updatedAt = datetime()`, { elementId: u.elementId, syncError: (u.error || 'Tag update failed').substring(0, 2000) });
        }
      };
      await updateProductTagsForCategoryNameChange(vertexId, oldCategoryName, newCategoryName, admin);
      if (h && shop) {
        try {
          const qMenu = h.createShopifyQueue(args, 'processShopifyMenuAfterUpdate');
          await h.addShopifyJob(qMenu, 'processShopifyMenuAfterUpdate', { shop, parentVertexLabel: 'ShopifyProductCategory', vertexId, name, operation: 'update', result });
          await qMenu.close();
        } catch (e) {
          console.error('processShopifyMenuAfterUpdate enqueue:', e);
        }
        try {
          const q = h.createShopifyQueue(args, 'processCreateAllCategoriesMenu');
          await h.addShopifyJob(q, 'processCreateAllCategoriesMenu', { shop, menuTitle: 'Categories', menuHandle: 'categories' });
          await q.close();
        } catch (e) {
          console.error('createAllCategoriesMenu enqueue:', e);
        }
      }
    }
    const shopifyHandle = updatedCollection.handle;
    if (vertexId) {
      await dbSession.run(
        `MATCH (c:ShopifyProductCategory) WHERE elementId(c) = $elementId SET c.syncStatus = 'complete', c.syncError = $syncError, c.updatedAt = datetime()${shopifyHandle ? ', c.handle = $handle' : ''}`,
        { elementId: vertexId, syncError: null, ...(shopifyHandle ? { handle: shopifyHandle } : {}) }
      );
      if (result?.data?.P && shopifyHandle) result.data.P.handle = shopifyHandle;
    }
  } catch (error) {
    console.error("processShopifyProductCategoryAfterUpdate: Error", error);
    const errMsg = error?.message || String(error);
    if (vertexId) await dbSession.run(`MATCH (c:ShopifyProductCategory) WHERE elementId(c) = $elementId SET c.syncStatus = 'failed', c.syncError = $syncError, c.updatedAt = datetime()`, { elementId: vertexId, syncError: errMsg.substring(0, 2000) });
  }
};

if (args.contextData?.action === 'start') {
  const { Worker } = args.bullmq;
  const connection = h.getRedisConnection();
  if (!connection || !connection.host) throw new Error('Invalid Redis connection for Shopify jobs');
  let workerInstance;
  try {
    workerInstance = new Worker(QUEUE_NAME, async (job) => {
      await runWithSession(args, job.data.shop, async (dbSession) => {
        await doJob(args, job.data, dbSession);
      });
    }, { connection, concurrency: 2, lockDuration: 120000 });
    workerInstance.on('failed', (job, err) => console.error('processShopifyProductCategoryAfterUpdate: Job failed', job?.id, err?.message));
    workerInstance.on('error', (err) => console.error('processShopifyProductCategoryAfterUpdate: Worker error', err?.message));
    return { stop: async (force = false) => { if (workerInstance) await workerInstance.close(force); } };
  } catch (error) {
    console.error('processShopifyProductCategoryAfterUpdate: Failed to create worker', error);
    if (workerInstance) { try { await workerInstance.close(); } catch (e) {} }
    throw error;
  }
}
'''
        key: processShopifyProductCategoryAfterUpdate
      }
    }
  ]
  edges: []
}
