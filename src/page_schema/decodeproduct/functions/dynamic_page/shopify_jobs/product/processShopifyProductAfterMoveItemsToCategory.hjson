{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Background job: updates Shopify product tags when products are moved to a category (remove old tag, add new).
        body:
          '''
const QUEUE_NAME = 'processShopifyProductAfterMoveItemsToCategory';

const doJob = async (args, jobData, dbSession) => {
  const { contentLabel, contentIds, categoryId, categoryLabel, relationshipType, sourceCategoryId, shop } = jobData;
  if (contentLabel !== 'ShopifyProduct') return;

  const isUncategorized = !categoryId || categoryId === 'uncategorized';

  const shopify = args.getShopifyClient();
  let admin;
  try {
    const authResult = await shopify.unauthenticated.admin(shop);
    admin = authResult.admin;
  } catch (authError) {
    console.error("processShopifyProductAfterMoveItemsToCategory: unauthenticated.admin failed", authError);
    const errMsg = (authError?.message || String(authError)).substring(0, 2000);
    if (contentIds?.length) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) IN $contentIds SET p.syncStatus = 'failed', p.syncError = $syncError, p.updatedAt = datetime()`, { contentIds, syncError: errMsg });
    return;
  }
  if (!admin) {
    if (contentIds?.length) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) IN $contentIds SET p.syncStatus = 'failed', p.syncError = $syncError, p.updatedAt = datetime()`, { contentIds, syncError: 'Shopify admin client unavailable' });
    return;
  }

  let newCategoryName = null;
  if (!isUncategorized) {
    const categoryResult = await dbSession.run(
      `MATCH (cat:${categoryLabel}) WHERE elementId(cat) = $categoryId RETURN cat.name as name`,
      { categoryId }
    );
    if (categoryResult.records.length > 0) newCategoryName = categoryResult.records[0].get('name') || null;
    if (!newCategoryName) return;
  }

  let oldCategoryName = null;
  if (sourceCategoryId && sourceCategoryId !== 'uncategorized') {
    const oldCategoryResult = await dbSession.run(
      `MATCH (cat:${categoryLabel}) WHERE elementId(cat) = $sourceCategoryId RETURN cat.name as name`,
      { sourceCategoryId }
    );
    if (oldCategoryResult.records.length > 0) oldCategoryName = oldCategoryResult.records[0].get('name') || null;
  }

  if (isUncategorized && !oldCategoryName) return;
  if (!isUncategorized && !newCategoryName) return;

  const productsResult = await dbSession.run(
    `MATCH (p:ShopifyProduct) WHERE elementId(p) IN $contentIds RETURN elementId(p) as elementId, p.id as shopifyId`,
    { contentIds }
  );
  const products = [];
  for (const record of productsResult.records) {
    const shopifyId = record.get('shopifyId');
    if (shopifyId) products.push({ elementId: record.get('elementId'), shopifyId });
  }
  if (products.length === 0) return;

  const h = helpers.result.data;
  const shopifyIds = products.map(p => p.shopifyId);
  const tagsMap = await h.batchGetProductTags(admin, shopifyIds);
  const updates = [];
  for (const p of products) {
    const currentTags = tagsMap.get(p.shopifyId) || [];
    let updatedTags = [...currentTags];
    if (oldCategoryName) updatedTags = updatedTags.filter(tag => tag !== oldCategoryName);
    if (!isUncategorized && newCategoryName && !updatedTags.includes(newCategoryName)) updatedTags.push(newCategoryName);
    if (JSON.stringify([...currentTags].sort()) === JSON.stringify([...updatedTags].sort())) continue;
    updates.push({ shopifyId: p.shopifyId, tags: updatedTags, elementId: p.elementId });
  }
  if (updates.length === 0) {
    console.log(`✅ Tag update skipped (no changes needed) for ${products.length} product(s)`);
    return;
  }
  const { success: successList, failed: failedList } = await h.batchUpdateProductTags(admin, updates);
  for (const u of successList) {
    if (u.elementId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'complete', p.updatedAt = datetime()`, { elementId: u.elementId });
  }
  for (const u of failedList) {
    if (u.elementId) await dbSession.run(`MATCH (p:ShopifyProduct) WHERE elementId(p) = $elementId SET p.syncStatus = 'failed', p.syncError = $syncError, p.updatedAt = datetime()`, { elementId: u.elementId, syncError: (u.error || 'Tag update failed').substring(0, 2000) });
  }
  console.log(`✅ Tag update complete for ${successList.length} product(s)${failedList.length > 0 ? `, ${failedList.length} failed` : ''}`);
};

const helpers = await args.executeNamedServerFunction(
  { functionName: 'shopifyQueueHelpers', contextData: {} },
  { functionLookupSubDomain: args.subDomain }
);
if (!helpers.result?.success) {
  console.error('Shopify queue helpers init failed', helpers.result?.error);
  throw new Error('Shopify queue helpers initialization failed');
}
const runWithSession = helpers.result.data.runWithSession;

if (args.contextData?.action === 'start') {
  const { Worker } = args.bullmq;
  const connection = helpers.result.data.getRedisConnection();
  if (!connection || !connection.host) throw new Error('Invalid Redis connection for Shopify jobs');
  let workerInstance;
  try {
    workerInstance = new Worker(QUEUE_NAME, async (job) => {
      await runWithSession(args, job.data.shop, async (dbSession) => {
        await doJob(args, job.data, dbSession);
      });
    }, { connection, concurrency: 2, lockDuration: 120000 });
    workerInstance.on('failed', (job, err) => console.error('processShopifyProductAfterMoveItemsToCategory: Job failed', job?.id, err?.message));
    workerInstance.on('error', (err) => console.error('processShopifyProductAfterMoveItemsToCategory: Worker error', err?.message));
    return { stop: async (force = false) => { if (workerInstance) await workerInstance.close(force); } };
  } catch (error) {
    console.error('processShopifyProductAfterMoveItemsToCategory: Failed to create worker', error);
    if (workerInstance) { try { await workerInstance.close(); } catch (e) {} }
    throw error;
  }
}
'''
        key: processShopifyProductAfterMoveItemsToCategory
      }
    }
  ]
  edges: []
}
