{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job to create Shopify menu for top-level category when a category is created.
        body:
          '''
const { parentVertexLabel, vertexId, name, parentId, result } = args.contextData;

if (parentVertexLabel !== 'ShopifyProductCategory') return;

const shopify = args.getShopifyClient();
let shop;
try {
  const event = args.getRequestEvent();
  if (!event) throw new Error("No request context available");
  const authResult = await shopify.authenticate.admin(event.request);
  shop = authResult.session.shop;
} catch (authError) {
  console.error("shopifyProductCategoryMenuAfterCreate: Shopify authentication failed", authError);
  return;
}
if (!shop) return;

try {
  const helpers = await args.executeNamedServerFunction(
    { functionName: 'shopifyQueueHelpers', contextData: {} },
    { functionLookupSubDomain: 'decodeproduct' }
  );
  if (!helpers.result?.success) return;
  if (vertexId) {
    await args.session.run(
      `MATCH (n:ShopifyProductCategory) WHERE elementId(n) = $elementId SET n.syncStatus = $status, n.updatedAt = datetime()`,
      { elementId: vertexId, status: 'queued' }
    );
  }
  const queueName = 'processShopifyProductCategoryMenuAfterCreate';
  const queue = helpers.result.data.createShopifyQueue(args, queueName);
  await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    parentVertexLabel,
    vertexId,
    name,
    parentId,
    result
  });
  await queue.close();
} catch (error) {
  console.error("shopifyProductCategoryMenuAfterCreate: Failed to enqueue job", error);
}
'''
        key: shopifyProductCategoryMenuAfterCreate
      }
    }
  ]
  edges: []
}
