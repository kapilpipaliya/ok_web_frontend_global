{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Updates a Shopify menu for a parent category with all nested children.
        body:
          '''
// Extract parameters
const { categoryElementId, categoryName, menuId } = args.contextData;

if (!categoryElementId || !categoryName || !menuId) {
  return {
    success: false,
    error: "categoryElementId, categoryName, and menuId are required"
  };
}

const shopify = await args.getShopifyClient();
let admin;
const shop = args.contextData.shop;
if (shop) {
  try {
    const authResult = await shopify.unauthenticated.admin(shop);
    admin = authResult.admin;
  } catch (authError) {
    console.error("updateShopifyMenuForCategory: Shopify unauthenticated.admin failed", authError);
    return { success: false, error: "Shopify authentication failed" };
  }
}
if (!shop || !admin) {
  return { success: false, error: "shop and admin are required (request context or contextData.shop)" };
}

try {
  const menuTitle = categoryName;

  // Build nested menu structure with all levels of children
  const nestedResult = await args.executeNamedServerFunction({
    functionName: "buildNestedMenuItems",
    contextData: {
      parentElementId: categoryElementId
    }
  }, { functionLookupSubDomain: 'decodeproduct' });
  
  const menuItems = nestedResult.result?.success ? (nestedResult.result.menuItems || []) : [];

  // Update menu
  const updateMenuMutation = `
    mutation menuUpdate($id: ID!, $title: String!, $items: [MenuItemUpdateInput!]!) {
      menuUpdate(id: $id, title: $title, items: $items) {
        menu {
          id
          handle
          title
          items {
            id
            title
            type
            resourceId
          }
        }
        userErrors {
          field
          message
        }
      }
    }
  `;

  const updateResponse = await admin.graphql(updateMenuMutation, {
    variables: { 
      id: menuId,
      title: menuTitle,
      items: menuItems
    }
  });
  
  let updateApiResponse;
  if (updateResponse instanceof Response) {
    updateApiResponse = await updateResponse.json();
  } else {
    updateApiResponse = updateResponse;
  }

  if (updateApiResponse.errors && updateApiResponse.errors.length > 0) {
    console.error("Shopify GraphQL errors:", updateApiResponse.errors);
    return {
      success: false,
      error: "Shopify GraphQL errors",
      details: updateApiResponse.errors
    };
  }

  const userErrors = updateApiResponse.data?.menuUpdate?.userErrors || [];
  if (userErrors.length > 0) {
    // Check if the error is "Menu does not exist"
    const menuNotFoundError = userErrors.find(
      error => error.message && error.message.toLowerCase().includes('menu does not exist')
    );

    if (menuNotFoundError) {
      console.log("Menu does not exist, creating new menu instead...");
      // Create menu instead of updating
      const createResult = await args.executeNamedServerFunction({
        functionName: "createShopifyMenuForCategory",
        contextData: {
          categoryElementId: categoryElementId,
          categoryName: categoryName,
          shop: args.contextData?.shop
        }
      }, { functionLookupSubDomain: 'decodeproduct' });

      if (createResult.result?.success) {
        return {
          success: true,
          menu: createResult.result.menu,
          menuId: createResult.result.menuId,
          menuHandle: createResult.result.menuHandle
        };
      } else {
        return {
          success: false,
          error: "Failed to create menu after update failed",
          details: createResult.result?.error || createResult.result
        };
      }
    }

    // Other errors - return them
    console.error("User errors updating menu:", userErrors);
    return {
      success: false,
      error: "User errors updating menu",
      details: userErrors
    };
  }

  const updatedMenu = updateApiResponse.data?.menuUpdate?.menu;
  if (!updatedMenu) {
    return {
      success: false,
      error: "Menu update succeeded but no menu returned"
    };
  }

  // Update parent category with menu info
  await args.session.run(
    `MATCH (c:ShopifyProductCategory)
     WHERE elementId(c) = $elementId
     SET c.menuId = $menuId,
         c.menuHandle = $menuHandle,
         c.updatedAt = datetime()`,
    {
      elementId: categoryElementId,
      menuId: updatedMenu.id,
      menuHandle: updatedMenu.handle
    }
  );

  return {
    success: true,
    menu: updatedMenu,
    menuId: updatedMenu.id,
    menuHandle: updatedMenu.handle
  };
} catch (error) {
  console.error("updateShopifyMenuForCategory: Error updating menu:", error);
  return {
    success: false,
    error: error.message || "Error updating menu"
  };
}
'''
        key: updateShopifyMenuForCategory
      }
    }
  ]
  edges: []
}

