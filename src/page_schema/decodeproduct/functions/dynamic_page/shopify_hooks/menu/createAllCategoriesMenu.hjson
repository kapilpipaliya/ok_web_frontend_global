{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job to create or update the master Shopify menu containing all top-level categories.
        body:
          '''
const { menuTitle = "Categories", menuHandle = "categories" } = args.contextData;

const shopify = args.getShopifyClient();
let shop;
try {
  const event = args.getRequestEvent();
  if (!event) throw new Error("No request context available");
  const authResult = await shopify.authenticate.admin(event.request);
  shop = authResult.session.shop;
} catch (authError) {
  console.error("createAllCategoriesMenu: Shopify authentication failed", authError);
  return { success: false, error: "Shopify authentication failed" };
}
if (!shop) {
  return { success: false, error: "shop is required" };
}

try {
  const helpers = await args.executeNamedServerFunction(
    { functionName: 'shopifyQueueHelpers', contextData: {} },
    { functionLookupSubDomain: 'decodeproduct' }
  );
  if (!helpers.result?.success) {
    return { success: false, error: "Failed to get queue helpers" };
  }
  const queueName = 'processCreateAllCategoriesMenu';
  const queue = helpers.result.data.createShopifyQueue(args, queueName);
  await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    menuTitle,
    menuHandle
  });
  await queue.close();
  return { success: true, message: "Job enqueued to create/update all categories menu" };
} catch (error) {
  console.error("createAllCategoriesMenu: Failed to enqueue job", error);
  return { success: false, error: error.message };
}
'''
        key: createAllCategoriesMenu
      }
    }
  ]
  edges: []
}
