{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job to create Shopify menu for top-level category when a category is created.
        body:
          '''
const { parentVertexLabel, vertexId, name, parentId, result } = args.contextData;

if (parentVertexLabel !== 'ShopifyProductCategory') return;

const shop = args.contextData.shop;
if (!shop) { console.log('shopifyMenuAfterCreate: shop not available in contextData'); return; }

try {
  const helpers = await args.executeNamedServerFunction(
    { functionName: 'shopifyQueueHelpers', contextData: {} },
    { functionLookupSubDomain: 'decodeproduct' }
  );
  if (!helpers.result?.success) return;
  const queueName = 'processShopifyMenuAfterCreate';
  const queue = helpers.result.data.createShopifyQueue(args, queueName);
  const job = await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    parentVertexLabel,
    vertexId,
    name,
    parentId,
    result
  });
  await queue.close();
  const jobId = job?.id;
  if (vertexId && jobId) {
    await args.session.run(
      `MATCH (n:ShopifyProductCategory) WHERE elementId(n) = $elementId SET n.syncStatus = $status, n.syncJobId = $jobId, n.updatedAt = datetime()`,
      { elementId: vertexId, status: 'queued', jobId }
    );
  }
  const r = args.contextData?.result;
  if (r?.data?.P && typeof r.data.P === 'object') {
    r.data.P.syncStatus = 'queued';
    if (jobId) r.data.P.syncJobId = jobId;
  }
} catch (error) {
  console.error("shopifyMenuAfterCreate: Failed to enqueue job", error);
}
'''
        key: shopifyMenuAfterCreate
      }
    }
  ]
  edges: []
}
