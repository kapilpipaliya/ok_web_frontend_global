{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Updates a Shopify menu for a top-level parent category when a category is updated. The menu contains all children categories as menu items linking to collections.
        body:
          '''
// Only process if parentVertexLabel is 'ShopifyProductCategory' and operation is 'update'
const { parentVertexLabel, vertexId, name, operation, result } = args.contextData;

if (parentVertexLabel !== 'ShopifyProductCategory' || operation !== 'update') {
  // Not updating a ShopifyProductCategory, skip
  return;
}

console.log(`📋 Updating Shopify menu for top-level category...`);

try {
  // Use common function to update top-level category menu
  const menuResult = await args.executeNamedServerFunction({
    functionName: "updateTopLevelCategoryMenu",
    contextData: {
      categoryElementId: vertexId
    }
  });

  if (menuResult.result?.success) {
    console.log(`✅ ${menuResult.result.message}`);
  } else {
    console.error("shopifyProductCategoryMenuAfterUpdate: Failed to update menu:", menuResult.result?.error);
  }
} catch (error) {
  console.error("shopifyProductCategoryMenuAfterUpdate: Error updating menu in Shopify:", error);
}
'''
        key: shopifyProductCategoryMenuAfterUpdate
      }
    }
  ]
  edges: []
}
