{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job to delete a product in Shopify when a ShopifyProduct is deleted.
        body:
          '''
const { tableVertexLabel, operation, elementId, result } = args.contextData;

if (tableVertexLabel !== 'ShopifyProduct' || operation !== 'delete') return;

const deletedData = result?.data;
const productData = deletedData?.P || {};
if (!productData.id) return;

const shopify = args.getShopifyClient();
let shop;
try {
  const event = args.getRequestEvent();
  if (!event) throw new Error("No request context available");
  const authResult = await shopify.authenticate.admin(event.request);
  shop = authResult.session.shop;
} catch (authError) {
  console.error("shopifyProductAfterDelete: Shopify authentication failed", authError);
  return;
}
if (!shop) return;

try {
  const helpers = await args.executeNamedServerFunction(
    { functionName: 'shopifyQueueHelpers', contextData: {} },
    { functionLookupSubDomain: 'decodeproduct' }
  );
  if (!helpers.result?.success) return;
  if (elementId) {
    await args.session.run(
      `MATCH (n:ShopifyProduct) WHERE elementId(n) = $elementId SET n.syncStatus = $status, n.updatedAt = datetime()`,
      { elementId, status: 'queued' }
    );
  }
  const queueName = 'processShopifyProductAfterDelete';
  const queue = helpers.result.data.createShopifyQueue(args, queueName);
  await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    tableVertexLabel,
    operation,
    elementId,
    result
  });
  await queue.close();
} catch (error) {
  console.error("shopifyProductAfterDelete: Failed to enqueue job", error);
}
'''
        key: shopifyProductAfterDelete
      }
    }
  ]
  edges: []
}
