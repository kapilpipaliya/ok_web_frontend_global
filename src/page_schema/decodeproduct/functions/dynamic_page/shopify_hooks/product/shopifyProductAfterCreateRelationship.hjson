{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job to add category tag to Shopify product when product is added to a category.
        body:
          '''
const { contentLabel, contentId, categoryId, categoryLabel } = args.contextData;

if (contentLabel !== 'ShopifyProduct') return;
if (!categoryId || categoryId === 'uncategorized') return;

const shop = args.contextData.shop;
if (!shop) return;

try {
  const helpers = await args.executeNamedServerFunction(
    { functionName: 'shopifyQueueHelpers', contextData: {} },
    { functionLookupSubDomain: 'decodeproduct' }
  );
  if (!helpers.result?.success) return;
  if (contentId) {
    await args.session.run(
      `MATCH (n:ShopifyProduct) WHERE elementId(n) = $elementId SET n.syncStatus = $status, n.updatedAt = datetime()`,
      { elementId: contentId, status: 'queued' }
    );
  }
  const queueName = 'processShopifyProductAfterCreateRelationship';
  const queue = helpers.result.data.createShopifyQueue(args, queueName);
  await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    contentLabel,
    contentId,
    categoryId,
    categoryLabel
  });
  await queue.close();
  const r = args.contextData?.result;
  if (r?.data?.P && typeof r.data.P === 'object') r.data.P.syncStatus = 'queued';
} catch (error) {
  console.error("shopifyProductAfterCreateRelationship: Failed to enqueue job", error);
}
'''
        key: shopifyProductAfterCreateRelationship
      }
    }
  ]
  edges: []
}
