{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job to create a product in Shopify when a new ShopifyProduct is added.
        body:
          '''
const { tableVertexLabel, operation, elementId, data, result } = args.contextData;

if (tableVertexLabel !== 'ShopifyProduct' || operation !== 'create') return;

const vertex = data?.vertex;
const formData = vertex?.P || {};
if (formData.id) return;

const shopify = args.getShopifyClient();
let shop;
try {
  const event = args.getRequestEvent();
  if (!event) throw new Error("No request context available");
  const authResult = await shopify.authenticate.admin(event.request);
  shop = authResult.session.shop;
} catch (authError) {
  console.error("shopifyProductAfterCreate: Shopify authentication failed", authError);
  return;
}
if (!shop) return;

try {
  const helpers = await args.executeNamedServerFunction(
    { functionName: 'shopifyQueueHelpers', contextData: {} },
    { functionLookupSubDomain: 'decodeproduct' }
  );
  if (!helpers.result?.success) return;
  if (elementId) {
    await args.session.run(
      `MATCH (n:ShopifyProduct) WHERE elementId(n) = $elementId SET n.syncStatus = $status, n.updatedAt = datetime()`,
      { elementId, status: 'queued' }
    );
  }
  const queueName = 'processShopifyProductAfterCreate';
  const queue = helpers.result.data.createShopifyQueue(args, queueName);
  await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    tableVertexLabel,
    operation,
    elementId,
    data,
    result
  });
  await queue.close();
} catch (error) {
  console.error("shopifyProductAfterCreate: Failed to enqueue job", error);
}
'''
        key: shopifyProductAfterCreate
      }
    }
  ]
  edges: []
}
