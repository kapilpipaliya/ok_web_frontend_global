{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job to update Shopify product tags when products are moved to a category.
        body:
          '''
const { contentLabel, contentIds, categoryId, categoryLabel, relationshipType, sourceCategoryId } = args.contextData;

if (contentLabel !== 'ShopifyProduct') return;

const shop = args.contextData.shop;
if (!shop) return;

try {
  const helpers = await args.executeNamedServerFunction(
    { functionName: 'shopifyQueueHelpers', contextData: {} },
    { functionLookupSubDomain: 'decodeproduct' }
  );
  if (!helpers.result?.success) return;
  if (contentIds && Array.isArray(contentIds)) {
    for (const elementId of contentIds) {
      await args.session.run(
        `MATCH (n:ShopifyProduct) WHERE elementId(n) = $elementId SET n.syncStatus = $status, n.updatedAt = datetime()`,
        { elementId, status: 'queued' }
      );
    }
  }
  const queueName = 'processShopifyProductAfterMoveItemsToCategory';
  const queue = helpers.result.data.createShopifyQueue(args, queueName);
  await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    contentLabel,
    contentIds,
    categoryId,
    categoryLabel,
    relationshipType,
    sourceCategoryId
  });
  await queue.close();
  const r = args.contextData?.result;
  if (r?.data?.P && typeof r.data.P === 'object') r.data.P.syncStatus = 'queued';
} catch (error) {
  console.error("shopifyProductAfterMoveItemsToCategory: Failed to enqueue job", error);
}
'''
        key: shopifyProductAfterMoveItemsToCategory
      }
    }
  ]
  edges: []
}
