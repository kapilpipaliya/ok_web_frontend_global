{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job to update a collection in Shopify when a ShopifyProductCategory is modified.
        body:
          '''
const { parentVertexLabel, name, vertexId, operation, result, oldData, shop } = args.contextData;
if (parentVertexLabel !== 'ShopifyProductCategory' || operation !== 'update') return;
if (!shop) return;

try {
  const helpers = await args.executeNamedServerFunction(
    { functionName: 'shopifyQueueHelpers', contextData: {} },
    { functionLookupSubDomain: 'decodeproduct' }
  );
  if (!helpers.result?.success) return;
  if (vertexId) {
    await args.session.run(
      `MATCH (n:ShopifyProductCategory) WHERE elementId(n) = $elementId SET n.syncStatus = $status, n.updatedAt = datetime()`,
      { elementId: vertexId, status: 'queued' }
    );
  }
  const queueName = 'processShopifyProductCategoryAfterUpdate';
  const queue = helpers.result.data.createShopifyQueue(args, queueName);
  await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    parentVertexLabel,
    name,
    vertexId,
    operation,
    result,
    oldData
  });
  await queue.close();
  const r = args.contextData?.result;
  if (r?.data?.P && typeof r.data.P === 'object') r.data.P.syncStatus = 'queued';
} catch (error) {
  console.error("shopifyProductCategoryAfterUpdate: Failed to enqueue job", error);
}
'''
        key: shopifyProductCategoryAfterUpdate
      }
    }
  ]
  edges: []
}
