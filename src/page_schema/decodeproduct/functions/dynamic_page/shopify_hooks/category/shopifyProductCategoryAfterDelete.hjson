{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job to delete a collection in Shopify when a ShopifyProductCategory is deleted.
        body:
          '''
const { parentVertexLabel, vertexId, operation, result } = args.contextData;

if (parentVertexLabel !== 'ShopifyProductCategory' || operation !== 'delete') return;

const deletedData = result?.data;
const categoryData = deletedData?.P || {};
if (!categoryData.id) return;

const shop = args.contextData.shop;
if (!shop) { console.log('shopifyProductCategoryAfterDelete: shop not available in contextData'); return; }

try {
  const helpers = await args.executeNamedServerFunction(
    { functionName: 'shopifyQueueHelpers', contextData: {} },
    { functionLookupSubDomain: 'decodeproduct' }
  );
  if (!helpers.result?.success) return;
  const queueName = 'processShopifyProductCategoryAfterDelete';
  const queue = helpers.result.data.createShopifyQueue(args, queueName);
  const job = await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    parentVertexLabel,
    vertexId,
    operation,
    result
  });
  await queue.close();
  const jobId = job?.id;
  if (vertexId && jobId) {
    await args.session.run(
      `MATCH (n:ShopifyProductCategory) WHERE elementId(n) = $elementId SET n.syncStatus = $status, n.syncJobId = $jobId, n.updatedAt = datetime()`,
      { elementId: vertexId, status: 'queued', jobId }
    );
  }
} catch (error) {
  console.error("shopifyProductCategoryAfterDelete: Failed to enqueue job", error);
}
'''
        key: shopifyProductCategoryAfterDelete
      }
    }
  ]
  edges: []
}
