  padding: ${args.theme.var.spacing.md};
  border-radius: ${args.theme.var.borderRadius.md};
  cursor: grab;
  transition: all ${args.theme.var.animation.normal} ease;
  user-select: none;
}

._id:hover {
  background: ${args.theme.var.color.primary_light_100};
  transform: translateY(-2px);
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

._id:active {
  cursor: grabbing;
}

@media (max-width: 768px) {
  ._id {
    padding: ${args.theme.var.spacing.sm};
  }
}`;'''
      }
