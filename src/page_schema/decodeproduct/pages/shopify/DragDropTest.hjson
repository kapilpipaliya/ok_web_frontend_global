{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns: return { enabled: () => true }
        title: DragDropTest
        url: /app/test
        key: DragDropTest
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: container
        fns:
          '''// Initial source items
const initialSourceItems = [
  { id: 1, name: "Item 1", description: "First draggable item" },
  { id: 2, name: "Item 2", description: "Second draggable item" },
  { id: 3, name: "Item 3", description: "Third draggable item" },
  { id: 4, name: "Item 4", description: "Fourth draggable item" },
  { id: 5, name: "Item 5", description: "Fifth draggable item" },
  { id: 6, name: "Item 6", description: "Sixth draggable item" }
];

// State management
const [sourceItems, setSourceItems] = args.createSignal([...initialSourceItems]);
const [droppedItems, setDroppedItems] = args.createSignal([]);
const [draggedItemId, setDraggedItemId] = args.createSignal(null);
const [isDragOver, setIsDragOver] = args.createSignal(false);
const draggableCleanups = new Map();
const dropTargetCleanup = { current: null };

// Get source items
const getSourceItems = () => {
  return sourceItems();
};

// Get dropped items
const getDroppedItems = () => {
  return droppedItems();
};

// Initialize draggable for an element
const initDraggable = (element, itemId) => {
  if (!element) return;
  
  // Clean up existing draggable if any
  const existingCleanup = draggableCleanups.get(itemId);
  if (existingCleanup) {
    existingCleanup();
  }
  
  const cleanup = args.draggable({
    element,
    getInitialData: () => ({
      type: 'item',
      id: itemId
    }),
    onDragStart: (event) => {
      setDraggedItemId(itemId);
      if (element) {
        element.style.opacity = '0.5';
      }
    },
    onDrop: (event) => {
      setDraggedItemId(null);
      if (element) {
        element.style.opacity = '1';
      }
    }
  });
  
  draggableCleanups.set(itemId, cleanup);
  return cleanup;
};

// Initialize drop target
const initDropTarget = (element) => {
  if (!element) return;
  
  // Clean up existing drop target if any
  if (dropTargetCleanup.current) {
    dropTargetCleanup.current();
  }

  const cleanup = args.dropTargetForElements({
    element,
    getData: () => ({}),
    canDrop: (args) => {
      const source = args.source;
      const data = source.data;
      return data && data.type === 'item';
    },
    onDragEnter: () => {
      setIsDragOver(true);
    },
    onDrag: () => {
      setIsDragOver(true);
    },
    onDragLeave: () => {
      setIsDragOver(false);
    },
    onDrop: (event) => {
      setIsDragOver(false);
      
      const source = event.source;
      const data = source.data;
      
      if (data && data.type === 'item' && data.id) {
        const itemId = data.id;
        const sourceItemsList = sourceItems();
        const droppedItemsList = droppedItems();
        
        // Find the item in source items
        const itemIndex = sourceItemsList.findIndex(item => item.id === itemId);
        if (itemIndex === -1) return;
        
        const item = sourceItemsList[itemIndex];
        
        // Remove from source and add to dropped
        const newSourceItems = sourceItemsList.filter(item => item.id !== itemId);
        const newDroppedItems = [...droppedItemsList, item];
        
        setSourceItems(newSourceItems);
        setDroppedItems(newDroppedItems);
        
        args.showSuccessToast?.(`${item.name} dropped successfully!`);
      }
    },
    onDropTargetChange: (event) => {
      setIsDragOver(event.isActive);
    }
  });
  
  dropTargetCleanup.current = cleanup;
  return cleanup;
};

// Reset items
const resetItems = () => {
  setSourceItems([...initialSourceItems]);
  setDroppedItems([]);
  setDraggedItemId(null);
  setIsDragOver(false);
  args.showSuccessToast?.('Items reset successfully!');
};

// Get draggable style
const getDraggableStyle = (itemId) => {
  if (draggedItemId() === itemId) {
    return { opacity: 0.5 };
  }
  return {};
};

// Get stats text
const getStatsText = () => {
  const sourceCount = sourceItems().length;
  const droppedCount = droppedItems().length;
  return `Source: ${sourceCount} items | Dropped: ${droppedCount} items`;
};

return {
  getSourceItems,
  getDroppedItems,
  initDraggable,
  initDropTarget,
  resetItems,
  getDraggableStyle,
  getStatsText,
  isDragOver,
  draggedItemId
};'''
        props:
          '''return {
  as: "div"
}'''
        css:
          '''return `._id {
  min-height: 100vh;
  padding: ${args.theme.var.spacing.lg};
  background: ${args.theme.var.color.background};
  display: flex;
  flex-direction: column;
  gap: ${args.theme.var.spacing.xl};
}

@media (max-width: 768px) {
  ._id {
    padding: ${args.theme.var.spacing.md};
    gap: ${args.theme.var.spacing.lg};
  }
}`;'''
      }
    }
