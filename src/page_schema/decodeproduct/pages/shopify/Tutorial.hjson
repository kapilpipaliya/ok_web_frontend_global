{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns: return { enabled: () => true }
        title: Tutorial - Shopify Products Organizer
        url: /app/support/tutorial
        key: ShopifyTutorial
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div"
}'''
        css:
          '''return `._id {
  max-width: 800px;
  margin: 0 auto;
  padding: ${args.theme.var.spacing?.lg || "2rem"};
  color: ${args.theme.var.color.text};
}

@media (max-width: 768px) {
  ._id {
    padding: ${args.theme.var.spacing?.md || "1rem"};
  }
}`;'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "h1",
  text: "Tutorial"
}'''
        css:
          '''return `._id {
  font-size: 2rem;
  font-weight: 700;
  color: ${args.theme.var.color.text};
  margin: 0 0 1rem 0;
}

@media (max-width: 768px) {
  ._id {
    font-size: 1.75rem;
  }
}`;'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "p",
  text: "Follow these steps to get the most out of the Shopify Products Organizer app."
}'''
        css:
          '''return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin-bottom: 1.5rem;
}`;'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        props:
          '''return {
  as: "div"
}'''
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}`;'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        loop: true
        contextName: step
        props:
          '''return {
  as: "div",
  data: [
    { num: 1, title: "Connect your store", body: "Go to Settings and connect your Shopify store. Authorize the app when prompted. Wait for the initial sync to complete." },
    { num: 2, title: "Explore the products table", body: "Open the main products table. Try filtering and searching. Click a row to open the detail modal and edit product info." },
    { num: 3, title: "Adjust table settings", body: "Use table settings to choose which columns to show, column order, and default sort. Save your preferences for next time." },
    { num: 4, title: "Create a support request if needed", body: "If you run into issues or have a feature idea, go to the Support page and create a new request. Our team will reply in the same thread." }
  ]
}'''
        css:
          '''return `._id {
  border-radius: 0.75rem;
  border: 1px solid ${args.theme.var.color.border};
  padding: 1rem;
  background: ${args.theme.var.color.background_light_100};
  display: flex;
  gap: 1rem;
}`;'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const s = args.contextData.step;
return {
  as: "div",
  text: s?.num != null ? String(s.num) : ""
};
'''
        css:
          '''
return `._id {
  flex-shrink: 0;
  width: 2rem;
  height: 2rem;
  border-radius: 9999px;
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  font-size: 0.875rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}`;
'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "div"
}'''
        css:
          '''return `._id {
  flex: 1;
  min-width: 0;
}`;'''
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const s = args.contextData.step;
return {
  as: "h3",
  text: s?.title || ""
};
'''
        css:
          '''
return `._id {
  font-size: 1rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
  margin: 0 0 0.35rem 0;
}`;
'''
      }
    }
    {
      id: "10"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
const s = args.contextData.step;
return {
  as: "p",
  text: s?.body || ""
};
'''
        css:
          '''
return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin: 0;
}`;
'''
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        displayOrder: 4
        componentName: Html
        props:
          '''return {
  as: "p",
  text: "Need more help? Visit the Support page to create a request and talk to our team."
}'''
        css:
          '''return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin-top: 1.5rem;
}`;'''
      }
    }
    {
      id: "12"
      L: PageLayout
      P: {
        componentName: ShopifyLayout
      }
    }
  ]
  edges: [
    {
      id: e2
      T: Attr
      S: "1"
      E: "2"
    }
    {
      id: e3
      T: Attr
      S: "2"
      E: "3"
    }
