        css:
          '''return `._id {
  max-width: 800px;
  margin: 0 auto;
  padding: ${t.var.spacing?.lg || "2rem"};
  color: ${t.var.color.text};
}

@media (max-width: 768px) {
  ._id {
    padding: ${t.var.spacing?.md || "1rem"};
  }
}`;'''
        displayOrder: 1
        fns:
          '''
const [expandedIndex, setExpandedIndex] = _.createSignal(null);
const toggleExpanded = (index) => {
  setExpandedIndex((prev) => (prev === index ? null : index));
};
return {
  expandedIndex,
  setExpandedIndex,
  toggleExpanded
};
'''
        componentName: Html
        key: unique_1
        props:
          '''return {
  as: "div"
}'''
