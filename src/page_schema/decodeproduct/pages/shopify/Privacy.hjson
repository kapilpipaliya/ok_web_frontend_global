          '''return {
  as: "p",
  text: "Shopify Products Organizer is committed to protecting your privacy. This policy describes how we collect, use, and protect information when you use our app within your Shopify admin."
}'''
        css:
          '''return `._id {
  font-size: 0.9375rem;
