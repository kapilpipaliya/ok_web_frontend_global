{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns: return { enabled: () => true }
        title: Privacy Policy - Shopify Products Organizer
        url: /app2/privacy
        key: ShopifyPrivacy
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div"
}'''
        css:
          '''return `._id {
  max-width: 800px;
  margin: 0 auto;
  padding: ${args.theme.var.spacing?.lg || "2rem"};
  color: ${args.theme.var.color.text};
}

@media (max-width: 768px) {
  ._id {
    padding: ${args.theme.var.spacing?.md || "1rem"};
  }
}`;'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "h1",
  text: "Privacy Policy"
}'''
        css:
          '''return `._id {
  font-size: 2rem;
  font-weight: 700;
  color: ${args.theme.var.color.text};
  margin: 0 0 0.5rem 0;
}

@media (max-width: 768px) {
  ._id {
    font-size: 1.75rem;
  }
}`;'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''const d = new Date();
const lastUpdated = "Last updated: " + d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
return {
  as: "p",
  text: lastUpdated
}'''
        css:
          '''return `._id {
  color: ${args.theme.var.color.muted};
  font-style: italic;
  margin: 0 0 1.5rem 0;
  font-size: 0.9375rem;
}`;'''
      }
    }
