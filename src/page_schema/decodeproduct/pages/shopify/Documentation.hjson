    {
      id: "22"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "p",
  text: "When you add, edit, or delete a product here, the app updates your Shopify store for you—in the background. The same goes for categories and menus: when you create or change them in the app, the app keeps your Shopify store in sync. You don't have to do anything extra; it happens automatically."
}'''
        css:
          '''return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin: 0 0 0.5rem 0;
}`;'''
      }
    }
    {
      id: "23"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        props:
          '''return {
  as: "p",
  text: "Products: Add a new product and it will appear in your Shopify store. Edit one and the changes go to Shopify. Delete one and it's removed from Shopify. When you put products into categories or move them between categories, the app updates everything in your store to match."
}'''
        css:
          '''return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin: 0 0 0.5rem 0;
}`;'''
