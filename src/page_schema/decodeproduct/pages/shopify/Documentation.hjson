      id: "7"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "p",
  text: "First, connect your Shopify store in Settings. Once connected, your products and collections show up automatically. Use the main table to view, search, and edit your products. You can also create your own pages and forms to organize things the way you like."
}'''
        css:
          '''return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin: 0;
