{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns: return { enabled: () => true }
        title: Documentation - Shopify Products Organizer
        url: /app/support/docs
        key: ShopifyDocumentation
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div"
}'''
        css:
          '''return `._id {
  max-width: 800px;
  margin: 0 auto;
  padding: ${args.theme.var.spacing?.lg || "2rem"};
  color: ${args.theme.var.color.text};
}

@media (max-width: 768px) {
  ._id {
    padding: ${args.theme.var.spacing?.md || "1rem"};
  }
}`;'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "h1",
  text: "Documentation"
}'''
        css:
          '''return `._id {
  font-size: 2rem;
  font-weight: 700;
  color: ${args.theme.var.color.text};
  margin: 0 0 1rem 0;
}

@media (max-width: 768px) {
  ._id {
    font-size: 1.75rem;
  }
}`;'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "p",
  text: "This guide explains how to use the app in plain language. You don't need any technical knowledge—just follow along."
}'''
        css:
          '''return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin-bottom: 1.5rem;
}`;'''
      }
    }
    {
      id: "16"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        props:
          '''return {
  as: "div"
}'''
        css:
          '''return `._id {
  margin-bottom: 1.25rem;
}`;'''
      }
    }
    {
      id: "17"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "h2",
  text: "Getting around the app"
}'''
        css:
          '''return `._id {
  font-size: 1.25rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
  margin: 0 0 0.5rem 0;
}`;'''
      }
    }
    {
      id: "18"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "p",
  text: "At the top of the app you'll see a menu with links: Products, Support, FAQ, Documentation, Tutorial, Billing, and Privacy. Click any link to go to that section. The big area below the menu shows the page you chose. You're always in the same app—only the main area changes when you click a different link."
}'''
        css:
          '''return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin: 0 0 0.5rem 0;
}`;'''
      }
    }
    {
      id: "19"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        props:
          '''return {
  as: "p",
  text: "Products is where you see and manage your product list. Support is where you send a message to our team or see replies. FAQ, Documentation, and Tutorial are help pages you can read anytime. Billing and Privacy are for your subscription and our privacy policy. You can bookmark or share a page if you want to come back to it later."
}'''
        css:
          '''return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin: 0;
}`;'''
      }
    }
