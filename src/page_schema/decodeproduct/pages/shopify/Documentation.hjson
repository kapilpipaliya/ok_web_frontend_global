    }
    {
      id: "24"
      L: Attr
      P: {
        displayOrder: 4
        componentName: Html
        props:
          '''return {
  as: "p",
  text: "Categories and menus: When you create a category, the app can add it to your store's navigation. When you change or remove a category, the app updates or removes that part of the menu in Shopify. Any time you create, edit, delete, or move a menu, the app keeps your store's navigation in sync. All of this happens in the background so the app stays quick and easy to use."
}'''
        css:
          '''return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin: 0;
}`;'''
