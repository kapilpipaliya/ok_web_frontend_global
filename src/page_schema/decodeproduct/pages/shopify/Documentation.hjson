        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "p",
  text: "The products table shows all your Shopify products in a list. You can search and filter to find what you need. Click a cell to edit it, or open a product to see and edit all its details. In table settings you choose which columns appear and how the list is sorted."
}'''
        css:
          '''return `._id {
  font-size: 0.9375rem;
