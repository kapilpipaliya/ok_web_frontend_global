return {
  as: "div",
  "data-disabled": hasTicket ? "false" : "true"
};
'''
        css:
          '''
return `._id {
  margin-top: 0.5rem;
  display: flex;
  gap: 0.4rem;
}

._id[data-disabled="true"] {
  opacity: 0.6;
}`;
'''
      }
    }
    {
      id: "7_right_reply_input"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const value = args.fns.replyText?.() || "";
const disabled = !args.fns.selectedTicketId?.();
return {
  as: "textarea",
  rows: 2,
  placeholder: disabled ? "Select a request to reply" : "Type your reply...",
  disabled,
  value,
  onInput: (e) => args.fns.setReplyText?.(e.target.value)
};
'''
        css:
          '''
return `._id {
  flex: 1;
  padding: 0.5rem 0.75rem;
  border-radius: 0.5rem;
  border: 1px solid ${args.theme.var.color.border};
  font-size: 0.875rem;
  resize: vertical;
}`;
'''
      }
    }
    {
      id: "7_right_reply_button"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
const disabled =
  !args.fns.selectedTicketId?.() ||
  !(args.fns.replyText?.() || "").trim();
const sending = args.fns.sendingReply?.();

return {
  as: "button",
  type: "button",
  text: sending ? "Sending..." : "Send",
  disabled,
  onClick: async () => {
    await args.fns.sendReply?.();
  }
};
'''
        css:
          '''
return `._id {
  padding: 0.45rem 0.9rem;
  border-radius: 9999px;
  border: none;
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  font-size: 0.875rem;
  font-weight: 500;
  align-self: flex-end;
  cursor: pointer;
}`;
'''
      }
