const t = args.contextData.ticket;
if (!t) return {};
const selectedId = args.fns.selectedTicketId?.();
const isSelected = selectedId && t.id === selectedId;
const unread = t.P?.unreadForShop || 0;

return {
  as: "button",
  type: "button",
  onClick: () => args.fns.handleSelectTicket?.(t),
  "data-selected": isSelected ? "true" : "false",
  "data-unread": unread > 0 ? "true" : "false"
};
'''
