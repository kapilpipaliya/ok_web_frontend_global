  cursor: pointer;
}

._id[data-selected="true"] {
  background: ${args.theme.var.color.primary_light_200};
  color: ${args.theme.var.color.primary_light_200_text};
}

._id[data-unread="true"] {
  font-weight: 600;
}`;
