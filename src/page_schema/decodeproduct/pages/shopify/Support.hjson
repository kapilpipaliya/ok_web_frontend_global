    }
    {
      id: "7_right_conversation_bubble"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const m = args.contextData.message;
if (!m) return {};
const sender = m.P?.senderType || (m.P?.email === "Support" ? "admin" : "shop");
const isShop = sender === "shop";

const createdAt = m.P?.createdAt;
let createdText = "";
if (createdAt) {
  try {
    createdText = new Date(createdAt).toLocaleString();
  } catch (e) {
    createdText = String(createdAt);
  }
}

return {
  as: "div",
  "data-sender": isShop ? "shop" : "admin",
  text: ""
};
'''
        css:
          '''
return `._id {
  max-width: 80%;
  padding: 0.5rem 0.75rem;
  border-radius: 0.75rem;
  font-size: 0.875rem;
  line-height: 1.5;
}

._id[data-sender="shop"] {
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
}

._id[data-sender="admin"] {
  background: ${args.theme.var.color.background_light_200};
  color: ${args.theme.var.color.background_light_200_text};
}`;
'''
      }
    }
    {
      id: "7_right_conversation_bubble_text"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const m = args.contextData.message;
return {
  as: "div",
  text: m?.P?.message || ""
};
'''
      }
    }
    {
      id: "7_right_conversation_bubble_meta"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
const m = args.contextData.message;
const createdAt = m?.P?.createdAt;
let createdText = "";
if (createdAt) {
  try {
    const date = new Date(createdAt);
    const now = new Date();
    const isToday = date.toDateString() === now.toDateString();
    
    if (isToday) {
      // Show time only for today's messages
      createdText = date.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
    } else {
      // Show short date + time for older messages
      createdText = date.toLocaleDateString("en-US", { month: "short", day: "numeric" }) + " " + 
                    date.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
    }
  } catch (e) {
    createdText = String(createdAt);
  }
}

return {
  as: "div",
  text: createdText || ""
};
'''
        css:
          '''
return `._id {
  margin-top: 0.25rem;
  font-size: 0.75rem;
  opacity: 0.8;
}`;
'''
      }
    }
    {
      id: "7_right_reply_box"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        props:
