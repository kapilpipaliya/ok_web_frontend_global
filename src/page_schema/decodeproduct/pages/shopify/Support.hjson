{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns: return { enabled: () => true }
        title: Support - Shopify Products Organizer
        url: /app2/support
        key: ShopifySupport
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: support_root
        fns:
          '''
// Signals for support tickets and conversation
const [tickets, setTickets] = args.createSignal([]);
const [selectedTicketId, setSelectedTicketId] = args.createSignal(null);
const [selectedTicket, setSelectedTicket] = args.createSignal(null);
const [messages, setMessages] = args.createSignal([]);

// UI state
const [loadingTickets, setLoadingTickets] = args.createSignal(false);
const [loadingConversation, setLoadingConversation] = args.createSignal(false);
const [creatingTicket, setCreatingTicket] = args.createSignal(false);
const [sendingReply, setSendingReply] = args.createSignal(false);

// New ticket form
const [newName, setNewName] = args.createSignal("");
const [newEmail, setNewEmail] = args.createSignal("");
const [newSubject, setNewSubject] = args.createSignal("");
const [newMessage, setNewMessage] = args.createSignal("");

// Reply box
const [replyText, setReplyText] = args.createSignal("");

const loadTickets = async () => {
  setLoadingTickets(true);
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "shopifySupportListTickets",
      contextData: {}
    });

    if (result?.error || result?.result?.success === false) {
      const message =
        result?.error ||
        result?.result?.message ||
        "Failed to load support requests.";
      args.showErrorToast?.(message);
      return;
    }

    const data = result?.result?.data?.tickets;
    if (Array.isArray(data)) {
      setTickets(data);
    } else {
      setTickets([]);
    }
  } catch (error) {
    console.error("Support.loadTickets error:", error);
    args.showErrorToast?.("Failed to load support requests.");
  } finally {
    setLoadingTickets(false);
  }
};

const loadConversation = async (ticketId) => {
  if (!ticketId) return;

  setLoadingConversation(true);
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "shopifySupportGetConversation",
      contextData: {
        ticketId,
        markAsReadFor: "shop"
      }
    });

    if (result?.error || result?.result?.success === false) {
      const message =
        result?.error ||
        result?.result?.message ||
        "Failed to load conversation.";
      args.showErrorToast?.(message);
      return;
    }

    const payload = result?.result?.data || {};
    const ticket = payload.ticket || null;
    const msgs = Array.isArray(payload.messages) ? payload.messages : [];

    // Prepend the initial ticket message as the first message in the conversation
    const allMessages = [];
    if (ticket && ticket.P?.message) {
      allMessages.push({
        P: {
          message: ticket.P.message,
          createdAt: ticket.P.createdAt || ticket.P.updatedAt,
          email: ticket.P.email || "",
          name: ticket.P.name || "",
          senderType: "shop"
        }
      });
    }
    allMessages.push(...msgs);

    setSelectedTicket(ticket);
    setSelectedTicketId(ticket?.id || ticketId);
    setMessages(allMessages);
  } catch (error) {
    console.error("Support.loadConversation error:", error);
    args.showErrorToast?.("Failed to load conversation.");
  } finally {
    setLoadingConversation(false);
  }
};

const handleSelectTicket = async (ticket) => {
  if (!ticket) return;
  const ticketId = ticket.id;
  if (!ticketId) return;

  await loadConversation(ticketId);

  if (args.setSearchParams) {
    const current = args.searchParams || {};
    args.setSearchParams(
      { ...current, supportId: ticketId },
      { replace: true }
    );
  }
};

const initializeSupport = async () => {
  await loadTickets();
  const supportId = args.searchParams?.supportId;
  if (supportId && typeof supportId === "string") {
    await loadConversation(supportId);
  }
};

const createTicket = async () => {
  const subject = (newSubject() || "").trim();
  const message = (newMessage() || "").trim();
  const name = (newName() || "").trim();
  const email = (newEmail() || "").trim();

  if (!message) {
    args.showErrorToast?.("Please enter a message.");
    return;
  }

  setCreatingTicket(true);
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "shopifySupportCreateTicket",
      contextData: {
        subject,
        message,
        name: name || undefined,
        email: email || undefined
      }
    });

    if (result?.error || result?.result?.success === false) {
      const errorMessage =
        result?.error ||
        result?.result?.message ||
        "Failed to create support request.";
      args.showErrorToast?.(errorMessage);
      return;
    }

    args.showSuccessToast?.("Support request created.");

    // Clear form
    setNewSubject("");
    setNewMessage("");

    const ticket = result?.result?.data?.ticket;

    await loadTickets();

    if (ticket && ticket.id) {
      await loadConversation(ticket.id);
      if (args.setSearchParams) {
        const current = args.searchParams || {};
        args.setSearchParams(
          { ...current, supportId: ticket.id },
          { replace: true }
        );
      }
    }
  } catch (error) {
    console.error("Support.createTicket error:", error);
    args.showErrorToast?.("Failed to create support request.");
  } finally {
    setCreatingTicket(false);
  }
};

const sendReply = async () => {
  const ticketId = selectedTicketId();
  const text = (replyText() || "").trim();

  if (!ticketId) {
    args.showErrorToast?.("Please select a request first.");
    return;
  }
  if (!text) {
    return;
  }

  setSendingReply(true);
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "shopifySupportReplyAsShop",
      contextData: {
        ticketId,
        message: text
      }
    });

    if (result?.error || result?.result?.success === false) {
      const errorMessage =
        result?.error ||
        result?.result?.message ||
        "Failed to send reply.";
      args.showErrorToast?.(errorMessage);
      return;
    }

    const reply = result?.result?.data?.reply;
    if (reply) {
      const current = messages() || [];
      // Preserve the initial ticket message (first item) when adding new reply
      // Initial message is identified by having senderType "shop" and no id property
      const initialMessage = current.length > 0 && current[0]?.P?.senderType === "shop" && !current[0]?.id ? current[0] : null;
      const otherMessages = initialMessage ? current.slice(1) : current;
      setMessages(initialMessage ? [initialMessage, ...otherMessages, reply] : [...otherMessages, reply]);
    } else {
      await loadConversation(ticketId);
    }

    setReplyText("");
    args.showSuccessToast?.("Reply sent.");
  } catch (error) {
    console.error("Support.sendReply error:", error);
    args.showErrorToast?.("Failed to send reply.");
  } finally {
    setSendingReply(false);
  }
};

const formatTimestamp = (timestamp) => {
  if (!timestamp) return "";
  try {
    const date = new Date(timestamp);
    const now = new Date();
    const diffMs = now - date;
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);
    
    if (diffMins < 1) {
      return "Just now";
    } else if (diffMins < 60) {
      return `${diffMins}m ago`;
    } else if (diffHours < 24) {
      return `${diffHours}h ago`;
    } else if (diffDays === 1) {
      return "Yesterday";
    } else if (diffDays < 7) {
      return `${diffDays}d ago`;
    } else {
      // Format as short date: "Jan 15" or "Dec 3"
      return date.toLocaleDateString("en-US", { month: "short", day: "numeric" });
    }
  } catch (e) {
    return String(timestamp);
  }
};

return {
  tickets,
  selectedTicket,
  selectedTicketId,
  messages,
  loadingTickets,
  loadingConversation,
  creatingTicket,
  sendingReply,
  newName,
  setNewName,
  newEmail,
  setNewEmail,
  newSubject,
  setNewSubject,
  newMessage,
  setNewMessage,
  replyText,
  setReplyText,
  formatTimestamp,
  initializeSupport,
  loadTickets,
  loadConversation,
  handleSelectTicket,
  createTicket,
  sendReply
};
'''
        props:
          '''
