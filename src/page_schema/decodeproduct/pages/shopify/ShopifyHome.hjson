    }
    {
      id: "12"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 1rem;
  line-height: 1.6;
  color: ${args.theme.var.color.text};
  margin: 0 0 0.5rem 0;
}`;'''
        displayOrder: 2
        textType: markdown
        componentName: Html
        text:
          '''**Nested categories**: Organize your products in a hierarchy of categories. Add categories, build a parent-child tree, and assign products to categories. Choose a category to see its products—so you can browse and manage your catalog by category instead of one long list.
'''
        props:
          '''return {
  as: "p",
}'''
      }
    }
    {
      id: "13"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 1rem;
  line-height: 1.6;
  color: ${args.theme.var.color.text};
  margin: 0 0 0.5rem 0;
}`;'''
        displayOrder: 3
        textType: markdown
        componentName: Html
        text:
          '''**Automatic Collection & Menu Sync**:
for each category a Shopify collection is created and for each root level category a Shopify menu is created, so you can use it in theme settings.
All changes stay automatically synced with your store — when you update categories, collections and menus are updated instantly to match.'''
        props:
          '''return {
  as: "p",
}'''
      }
    }
    {
      id: "14"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 1rem;
  line-height: 1.6;
  color: ${args.theme.var.color.text};
  margin: 0 0 0.5rem 0;
}`;'''
        displayOrder: 4
        textType: markdown
        componentName: Html
        text: **Video guides:** Watch tutorials and updates on our [YouTube channel](https://www.youtube.com/@DecodeProductsOrganizer/videos).
        props:
          '''return {
  as: "p",
}'''
      }
    }
    {
      id: "15"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 1rem;
  line-height: 1.6;
  color: ${args.theme.var.color.text};
  margin: 0 0 0.5rem 0;
}`;'''
        displayOrder: 5
        textType: markdown
        componentName: Html
        text:
          '''**Settings:** Choose which columns to show so the table fits how you work.
you can customize the functionality of the app by changing settings. for more help contact us at [Support](/support) page in Shopify admin.'''
        props:
          '''return {
  as: "p",
}'''
      }
    }
    {
