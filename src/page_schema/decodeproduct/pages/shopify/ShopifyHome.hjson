{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns: return { enabled: () => true }
        title: Decode Products Organizer – Organize and manage your Shopify products
        url: /
        key: ShopifyHome
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "meta_desc"
      L: Attr
      P: {
        displayOrder: 0
        componentName: Html
        props:
          '''return {
  as: "meta",
  name: "description",
  content: "Decode Products Organizer helps you organize your Shopify product catalog in nested categories. View products by category. Available in the Shopify App Store."
}'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "main"
}'''
        css:
          '''return `._id {
  max-width: 800px;
  margin: 0 auto;
  padding: ${args.theme.var.spacing?.lg || "2rem"};
  color: ${args.theme.var.color.text};
}

@media (max-width: 768px) {
  ._id {
    padding: ${args.theme.var.spacing?.md || "1rem"};
  }
}`;'''
      }
    }
    {
      id: "3"
