          '''
return `._id.workshop-sidebar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding: 1rem 0.75rem;
  border-bottom: 1px solid ${t.var.color.border_light_200};
  min-height: 3.5rem;
}`;
'''
      }
    }
