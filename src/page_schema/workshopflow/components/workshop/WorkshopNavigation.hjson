  class: "workshop-nav-item-row"
};
'''
        css:
          '''
return `._id.workshop-nav-item-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 0.25rem;
  width: 100%;
  min-width: 0;
}`;
'''
      }
    }
    {
      id: "nav_p_help"
      L: Attr
      P: {
        displayOrder: 2
        componentName: WorkshopDocHelpPopover
        props:
          '''
const item = args.contextData.menuItem;
return {
  helpTitle: item?.label || "Help",
  helpBody: item?.helpBody || "",
  placement: "right-start",
  tooltipGroup: "workshop-doc-help"
};
'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const item = args.contextData.menuItem;
const href = item?.href || "/";
const active = args.fns.isActive(href);
return {
  as: "a",
  href,
  text: args.fns.collapsed() ? "" : item?.label,
  title: item?.label,
  class: `workshop-nav-link ${active ? "is-active" : ""}`,
  onClick: (event) => {
    event.preventDefault();
    args.navigate(href);
  }
};
'''
        css:
          '''
return `._id.workshop-nav-link {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  min-height: 2.25rem;
  padding: 0.5rem 0.625rem;
  border-radius: 0.5rem;
  color: ${args.theme.var.color.text};
  text-decoration: none;
  cursor: pointer;
  font-size: 0.9375rem;
  font-weight: 500;
}

._id.workshop-nav-link:hover {
  background: ${args.theme.var.color.background_light_200};
}

._id.workshop-nav-link.is-active {
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
}`;
'''
      }
    }
