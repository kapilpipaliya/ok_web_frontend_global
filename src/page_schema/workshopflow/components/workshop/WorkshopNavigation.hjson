{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: WorkshopNavigation
        title: WorkshopNavigation
        fns:
          '''
const [sidebarWidth, setSidebarWidth] = args.createSignal(280);
const [collapsed, setCollapsed] = args.createSignal(false);
const [isResizing, setIsResizing] = args.createSignal(false);

const minWidth = 220;
const maxWidth = 420;

const workshopNavHelpById = {
  home: "Landing page with shortcuts into Workshop. Use the sidebar to open any module.",
  dashboard: "Overview and KPIs. Open operational modules from here or the sidebar.",
  appointments: "Book visits before they become repair orders. Customer, vehicle, bay, service, and technician links are graph edges. Numbers use reference sequences from Settings.",
  repairs: "Repair orders from open through closed. Optional appointment, nested part lines, and inventory links.",
  inventory: "Parts catalog with stock, reorder, cost, and price. Sidebar categories and supplier directory link.",
  billing: "Invoices tied to repair orders with line items (part, labor, fee) and payment-related totals.",
  customers: "Customer directory with unique numbers; used across appointments, repairs, and billing.",
  technicians: "Technician roster, skills, rates, and status. Assign on appointments and repairs.",
  services: "Service catalog for scheduling and quoting.",
  suppliers: "Vendors linked from inventory and purchasing workflows.",
  bays: "Service bays or ramps for scheduling.",
  skills: "Skill catalog for technician primary skills.",
  vehicles: "Vehicle registry linked from appointments and repairs.",
  payments: "Payments applied to invoices; can drive invoice payment status via hooks.",
  docs: "User guide with field-level help for each module.",
  reports: "Charts and analytics from workshop report configuration.",
  settings: "Picklists, reference sequences, and workshop defaults."
};

const withHelp = (item) => ({
  ...item,
  helpBody: item.helpBody || workshopNavHelpById[item.id] || ""
});

const primaryMenuItems = () => [
  withHelp({ id: "home", label: "Home", href: "/workshop", icon: "ph:house" }),
  withHelp({ id: "dashboard", label: "Dashboard", href: "/workshop/dashboard", icon: "ph:gauge" }),
  withHelp({ id: "appointments", label: "Appointments", href: "/workshop/appointments", icon: "ph:calendar-check" }),
  withHelp({ id: "repairs", label: "Repairs", href: "/workshop/repairs", icon: "ph:wrench" }),
  withHelp({ id: "inventory", label: "Inventory", href: "/workshop/inventory", icon: "ph:package" }),
  withHelp({ id: "billing", label: "Billing", href: "/workshop/billing", icon: "ph:receipt" }),
  withHelp({ id: "customers", label: "Customers", href: "/workshop/customers", icon: "ph:users-three" }),
  withHelp({ id: "technicians", label: "Technicians", href: "/workshop/technicians", icon: "ph:hard-hat" }),
  withHelp({ id: "services", label: "Services", href: "/workshop/services", icon: "ph:toolbox" }),
  withHelp({ id: "suppliers", label: "Suppliers", href: "/workshop/suppliers", icon: "ph:truck" }),
  withHelp({ id: "bays", label: "Service bays", href: "/workshop/bays", icon: "ph:warehouse" }),
  withHelp({ id: "skills", label: "Skills", href: "/workshop/skills", icon: "ph:graduation-cap" }),
  withHelp({ id: "vehicles", label: "Vehicles", href: "/workshop/vehicles", icon: "ph:car" }),
  withHelp({ id: "payments", label: "Payments", href: "/workshop/payments", icon: "ph:currency-circle-dollar" })
];

const bottomMenuItems = () => [
  withHelp({ id: "docs", label: "Documentation", href: "/workshop/docs", icon: "ph:book-open" }),
  withHelp({ id: "reports", label: "Reports", href: "/workshop/reports", icon: "ph:chart-line-up" }),
  withHelp({ id: "settings", label: "Settings", href: "/workshop/settings", icon: "ph:gear-six" })
];

const getSidebarWidth = () => (collapsed() ? 64 : sidebarWidth());
const toggleCollapsed = () => setCollapsed((v) => !v);
const isActive = (href) => (args.location?.pathname || "").startsWith(href);

const handleResizeMove = (event) => {
  if (!isResizing() || collapsed()) return;
  const nextWidth = Math.min(maxWidth, Math.max(minWidth, event.clientX));
  setSidebarWidth(nextWidth);
};

const handleResizeEnd = () => setIsResizing(false);

const startResize = (event) => {
  if (collapsed()) return;
  event.preventDefault();
  setIsResizing(true);
};

return {
  primaryMenuItems,
  bottomMenuItems,
  getSidebarWidth,
  toggleCollapsed,
  collapsed,
  isActive,
  startResize,
  handleResizeMove,
  handleResizeEnd
};
'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "workshop-layout-root",
  onMount: () => {
    window.addEventListener("mousemove", args.fns.handleResizeMove);
    window.addEventListener("mouseup", args.fns.handleResizeEnd);
  },
  onCleanup: () => {
    window.removeEventListener("mousemove", args.fns.handleResizeMove);
    window.removeEventListener("mouseup", args.fns.handleResizeEnd);
  }
};
'''
        css:
          '''
return `._id.workshop-layout-root {
  display: flex;
  width: 100%;
  min-height: 100vh;
  background: ${args.theme.var.color.background};
}`;
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "aside",
  class: `workshop-sidebar ${args.fns.collapsed() ? "is-collapsed" : ""}`,
  style: `width: ${args.fns.getSidebarWidth()}px;`
};
'''
        css:
          '''
return `._id.workshop-sidebar {
  position: relative;
  display: flex;
  flex-direction: column;
  border-right: 1px solid ${args.theme.var.color.border_light_200};
  background: ${args.theme.var.color.background_light_100};
  color: ${args.theme.var.color.text};
  transition: width 0.2s ease;
  overflow: hidden;
}

._id.workshop-sidebar.is-collapsed {
  align-items: center;
}`;
'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "workshop-sidebar-header"
};
'''
        css:
          '''
return `._id.workshop-sidebar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding: 1rem 0.75rem;
  border-bottom: 1px solid ${args.theme.var.color.border_light_200};
  min-height: 3.5rem;
}`;
'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div",
  text: args.fns.collapsed() ? "WS" : "Workshop",
  class: "workshop-logo"
};
'''
        css:
          '''
return `._id.workshop-logo {
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: ${args.theme.var.color.primary};
}`;
'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
return {
  as: "button",
  text: args.fns.collapsed() ? ">" : "<",
  class: "workshop-toggle-btn",
  onClick: args.fns.toggleCollapsed
};
'''
        css:
          '''
return `._id.workshop-toggle-btn {
  border: 1px solid ${args.theme.var.color.border_light_300};
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
  border-radius: 0.375rem;
  width: 1.75rem;
  height: 1.75rem;
  cursor: pointer;
}`;
'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "workshop-nav-list",
  contextName: "menuItem",
  loop: true,
  data: args.fns.primaryMenuItems()
};
'''
        css:
          '''
return `._id.workshop-nav-list {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  gap: 0.375rem;
  padding: 0.75rem;
  overflow-y: auto;
}`;
'''
      }
    }
    {
      id: "nav_p_row"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
