          '''
return {
  as: "button",
  text: f.collapsed() ? ">" : "<",
  class: "workshop-toggle-btn",
  onClick: f.toggleCollapsed
};
'''
        css:
          '''
return `._id.workshop-toggle-btn {
  border: 1px solid ${t.var.color.border_light_300};
  background: ${t.var.color.background};
  color: ${t.var.color.text};
  border-radius: 0.375rem;
  width: 1.75rem;
  height: 1.75rem;
  cursor: pointer;
}`;
'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "workshop-nav-list",
  contextName: "menuItem",
  loop: true,
  data: f.menuItems()
};
'''
        css:
          '''
return `._id.workshop-nav-list {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  padding: 0.75rem;
  overflow-y: auto;
}`;
'''
      }
