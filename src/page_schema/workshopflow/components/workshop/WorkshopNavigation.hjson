{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: WorkshopNavigation
        title: WorkshopNavigation
        fns:
          '''
const [sidebarWidth, setSidebarWidth] = _.createSignal(280);
const [collapsed, setCollapsed] = _.createSignal(false);
const [isResizing, setIsResizing] = _.createSignal(false);

const minWidth = 220;
const maxWidth = 420;

const menuItems = () => [
  { label: "Home", href: "/workshop", icon: "ph:house" },
  { label: "Documentation", href: "/workshop/docs", icon: "ph:book-open" },
  { label: "Dashboard", href: "/workshop/dashboard", icon: "ph:gauge" },
  { label: "Reports", href: "/workshop/reports", icon: "ph:chart-line-up" },
  { label: "Settings", href: "/workshop/settings", icon: "ph:gear-six" },
  { label: "Appointments", href: "/workshop/appointments", icon: "ph:calendar-check" },
  { label: "Repairs", href: "/workshop/repairs", icon: "ph:wrench" },
  { label: "Inventory", href: "/workshop/inventory", icon: "ph:package" },
  { label: "Billing", href: "/workshop/billing", icon: "ph:receipt" },
  { label: "Customers", href: "/workshop/customers", icon: "ph:users-three" },
  { label: "Technicians", href: "/workshop/technicians", icon: "ph:hard-hat" },
  { label: "Services", href: "/workshop/services", icon: "ph:toolbox" },
  { label: "Suppliers", href: "/workshop/suppliers", icon: "ph:truck" },
  { label: "Service bays", href: "/workshop/bays", icon: "ph:warehouse" },
  { label: "Skills", href: "/workshop/skills", icon: "ph:graduation-cap" },
  { label: "Vehicles", href: "/workshop/vehicles", icon: "ph:car" },
  { label: "Payments", href: "/workshop/payments", icon: "ph:currency-circle-dollar" }
];

const getSidebarWidth = () => (collapsed() ? 64 : sidebarWidth());
const toggleCollapsed = () => setCollapsed((v) => !v);
const isActive = (href) => (_.location?.pathname || "").startsWith(href);

const handleResizeMove = (event) => {
  if (!isResizing() || collapsed()) return;
  const nextWidth = Math.min(maxWidth, Math.max(minWidth, event.clientX));
  setSidebarWidth(nextWidth);
};

const handleResizeEnd = () => setIsResizing(false);

const startResize = (event) => {
  if (collapsed()) return;
  event.preventDefault();
  setIsResizing(true);
};

return {
  menuItems,
  getSidebarWidth,
  toggleCollapsed,
  collapsed,
  isActive,
  startResize,
  handleResizeMove,
  handleResizeEnd
};
'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "workshop-layout-root",
  onMount: () => {
    window.addEventListener("mousemove", f.handleResizeMove);
    window.addEventListener("mouseup", f.handleResizeEnd);
  },
  onCleanup: () => {
    window.removeEventListener("mousemove", f.handleResizeMove);
    window.removeEventListener("mouseup", f.handleResizeEnd);
  }
};
'''
        css:
          '''
return `._id.workshop-layout-root {
  display: flex;
  width: 100%;
  min-height: 100vh;
  background: ${t.var.color.background};
}`;
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "aside",
  class: `workshop-sidebar ${f.collapsed() ? "is-collapsed" : ""}`,
  style: `width: ${f.getSidebarWidth()}px;`
};
'''
        css:
          '''
return `._id.workshop-sidebar {
  position: relative;
  display: flex;
  flex-direction: column;
  border-right: 1px solid ${t.var.color.border_light_200};
  background: ${t.var.color.background_light_100};
  color: ${t.var.color.text};
  transition: width 0.2s ease;
  overflow: hidden;
}

._id.workshop-sidebar.is-collapsed {
  align-items: center;
}`;
'''
      }
    }
