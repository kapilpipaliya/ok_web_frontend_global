    {
      id: "8"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const item = c.menuItem;
const href = item?.href || "/";
const active = f.isActive(href);
return {
  as: "a",
  href,
  text: f.collapsed() ? "" : item?.label,
  title: item?.label,
  class: `workshop-nav-link ${active ? "is-active" : ""}`,
  onClick: (event) => {
    event.preventDefault();
    _.navigate(href);
  }
};
'''
        css:
          '''
return `._id.workshop-nav-link {
  display: flex;
  align-items: center;
  min-height: 2.25rem;
  padding: 0.5rem 0.625rem;
  border-radius: 0.5rem;
  color: ${t.var.color.text};
  text-decoration: none;
  cursor: pointer;
  font-size: 0.9375rem;
  font-weight: 500;
}

._id.workshop-nav-link:hover {
  background: ${t.var.color.background_light_200};
}

._id.workshop-nav-link.is-active {
  background: ${t.var.color.primary};
  color: ${t.var.color.primary_text};
}`;
'''
      }
