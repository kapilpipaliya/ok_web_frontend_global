return {
  as: "nav"
};
''',
        css: '''
return `._id {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 72px;
  background: ${args.theme.var.color.background};
  border-top: 1px solid ${args.theme.var.color.border};
  z-index: 1;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.1);
  padding: ${args.theme.var.spacing.sm} 0;
}

._id .slider-container {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 ${args.theme.var.spacing.sm};
  width: 100%;
}

/* Make each nav item equally distributed */
._id .slider-container > * {
  flex: 1;
  display: flex;
  justify-content: center;
  min-width: 0;
}

/* Responsive adjustment - hide on desktop */
@media (min-width: 768px) {
  ._id {
    display: none;
  }
}`;
'''
      }
    },
    {
      id: "nav_slider_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
