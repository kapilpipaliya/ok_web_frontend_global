{
  vertexes: [
    {
      id: "layout_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "ConfirmProvider"
      }
    },
    {
      id: "favicon_link",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "link",
  rel: "icon",
  href: "/api/file/downloadCompanyFavicon"
};
'''
      }
    },
    {
      id: "layout_wrapper",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        fns: '''
// Workshop app — align with WorkshopNavigation routes (/workshop/…)
const navigationSections = [
  {
    id: "main",
    title: null,
    items: [
      {
        id: "home",
        href: "/workshop",
        label: "Home",
        icon: "ph:house",
        title: "Workshop home",
        pathCheck: (pathname) => pathname === "/workshop" || pathname === "/workshop/"
      },
      {
        id: "docs",
        href: "/workshop/docs",
        label: "Documentation",
        icon: "ph:book-open",
        title: "Help and documentation",
        pathCheck: (pathname) => pathname.startsWith("/workshop/docs")
      },
      {
        id: "dashboard",
        href: "/workshop/dashboard",
        label: "Dashboard",
        icon: "ph:gauge",
        title: "Workshop overview and KPIs",
        pathCheck: (pathname) => pathname.startsWith("/workshop/dashboard")
      },
      {
        id: "reports",
        href: "/workshop/reports",
        label: "Reports",
        icon: "ph:chart-line-up",
        title: "Charts and analytics",
        pathCheck: (pathname) => pathname.startsWith("/workshop/reports")
      },
      {
        id: "settings",
        href: "/workshop/settings",
        label: "Settings",
        icon: "ph:gear-six",
        title: "Workshop settings and picklists",
        pathCheck: (pathname) => pathname.startsWith("/workshop/settings")
      }
    ]
  },
  {
    id: "operations",
    title: "Operations",
    items: [
      {
        id: "appointments",
        href: "/workshop/appointments",
        label: "Appointments",
        icon: "ph:calendar-check",
        title: "Schedule and appointments",
        pathCheck: (pathname) => pathname.startsWith("/workshop/appointments")
      },
      {
        id: "repairs",
        href: "/workshop/repairs",
        label: "Repairs",
        icon: "ph:wrench",
        title: "Repair orders",
        pathCheck: (pathname) => pathname.startsWith("/workshop/repairs")
      },
      {
        id: "inventory",
        href: "/workshop/inventory",
        label: "Inventory (parts)",
        icon: "ph:package",
        title: "Inventory (parts)",
        pathCheck: (pathname) => pathname.startsWith("/workshop/inventory")
      },
      {
        id: "billing",
        href: "/workshop/billing",
        label: "Billing",
        icon: "ph:receipt",
        title: "Invoices",
        pathCheck: (pathname) => pathname.startsWith("/workshop/billing")
      },
      {
        id: "payments",
        href: "/workshop/payments",
        label: "Payments",
        icon: "ph:currency-circle-dollar",
        title: "Payments",
        pathCheck: (pathname) => pathname.startsWith("/workshop/payments")
      }
    ]
  },
  {
    id: "directory",
    title: "Directory",
    items: [
      {
        id: "customers",
        href: "/workshop/customers",
        label: "Customers",
        icon: "ph:users-three",
        title: "Customer records",
        pathCheck: (pathname) => pathname.startsWith("/workshop/customers")
      },
      {
        id: "technicians",
        href: "/workshop/technicians",
        label: "Technicians",
        icon: "ph:hard-hat",
        title: "Technicians",
        pathCheck: (pathname) => pathname.startsWith("/workshop/technicians")
      },
      {
        id: "services",
        href: "/workshop/services",
        label: "Services",
        icon: "ph:toolbox",
        title: "Service catalog",
        pathCheck: (pathname) => pathname.startsWith("/workshop/services")
      },
      {
        id: "suppliers",
        href: "/workshop/suppliers",
        label: "Suppliers",
        icon: "ph:truck",
        title: "Vendors and suppliers",
        pathCheck: (pathname) => pathname.startsWith("/workshop/suppliers")
      },
      {
        id: "bays",
        href: "/workshop/bays",
        label: "Service bays",
        icon: "ph:warehouse",
        title: "Bays and ramps",
        pathCheck: (pathname) => pathname.startsWith("/workshop/bays")
      },
      {
        id: "skills",
        href: "/workshop/skills",
        label: "Skills",
        icon: "ph:graduation-cap",
        title: "Technician skills catalog",
        pathCheck: (pathname) => pathname.startsWith("/workshop/skills")
      },
      {
        id: "vehicles",
        href: "/workshop/vehicles",
        label: "Vehicles",
        icon: "ph:car",
        title: "Vehicle registry",
        pathCheck: (pathname) => pathname.startsWith("/workshop/vehicles")
      }
    ]
  },
  {
    id: "other",
    title: null,
    hasBorder: true,
    items: [
      {
        id: "logout",
        href: "/auth/logout",
        label: "Logout",
        icon: "carbon:logout",
        title: "Sign out of your account",
        isButton: true,
        isDanger: true
      }
    ]
  }
];

const mobileNavigationItems = [
  {
    id: "home",
    href: "/workshop",
    label: "Home",
    icon: "ph:house",
    title: "Workshop home",
    pathCheck: (pathname) => pathname === "/workshop" || pathname === "/workshop/"
  },
  {
    id: "dashboard",
    href: "/workshop/dashboard",
    label: "Dashboard",
    icon: "ph:gauge",
    title: "Overview",
    pathCheck: (pathname) => pathname.startsWith("/workshop/dashboard")
  },
  {
    id: "appointments",
    href: "/workshop/appointments",
    label: "Appts",
    icon: "ph:calendar-check",
    title: "Appointments",
    pathCheck: (pathname) => pathname.startsWith("/workshop/appointments")
  },
  {
    id: "repairs",
    href: "/workshop/repairs",
    label: "Repairs",
    icon: "ph:wrench",
    title: "Repairs",
    pathCheck: (pathname) => pathname.startsWith("/workshop/repairs")
  },
  {
    id: "billing",
    href: "/workshop/billing",
    label: "Billing",
    icon: "ph:receipt",
    title: "Billing",
    pathCheck: (pathname) => pathname.startsWith("/workshop/billing")
  }
];

return {
  navigationSections,
  mobileNavigationItems
};
''',
        props: '''
return {
  as: "div"
};
'''
      }
    },
    {
      id: "layout_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
}

@media (min-width: 768px) {
  ._id {
    flex-direction: row;
  }
}`;
'''
      }
    },
    {
      id: "main_content",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "main"
};
''',
        css: '''
return `._id {
  flex: 1;
  padding-bottom: 80px;
  overflow-y: auto;
  position: relative;
}

@media (min-width: 768px) {
  ._id {
    padding-bottom: 0;
    margin-left: 240px;
  }
}`;
'''
      }
    },
    {
      id: "slot_main",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Slot",
        slot: "1children"
      }
    },
    {
      id: "navigation_overlay",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
// Navigation overlay during route changes (ConfirmProvider)
// This controls when the overlay should be visible
const isNavigating = args.fns.isNavigating?.();

return {
  as: "div",
  style: {
    // Show overlay during navigation, hide when complete
    // Uses flex to center the loading spinner
    display: isNavigating ? 'flex' : 'none'
  }
};
''',
        css: '''
return `._id {
  /* Full-screen overlay positioning */
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;

  /* Match theme background for seamless appearance */
  background: ${args.theme.var.color.background};

  /* Position spinner at top instead of center */
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: ${args.theme.var.spacing.xxl};

  /* High z-index to appear above all content */
  z-index: 1;

  /* Start invisible and fade in smoothly */
  opacity: 0;
  animation: fadeIn 0.2s ease-out forwards;
}

/* Smooth fade-in animation for overlay appearance */
@keyframes fadeIn {
  to {
    opacity: 1;
  }
}`;
'''
      }
    },
    {
      id: "navigation_spinner",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "LoadingSpinner",
        props: '''
return {
  size: "medium",
  color: "primary"
};
'''
      }
    },
    {
      id: "left_nav",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "nav"
};
''',
        css: '''
return `._id {
  display: none;
}

@media (min-width: 768px) {
  ._id {
    display: flex;
    position: fixed;
    top: 0;
    left: 0;
    width: 240px;
    height: 100vh;
    background: ${args.theme.var.color.background};
    border-right: 1px solid ${args.theme.var.color.border};
    flex-direction: column;
    padding: ${args.theme.var.spacing.xl} ${args.theme.var.spacing.lg};
    z-index: 1;
    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.1);
  }
}`;
'''
      }
    },
    {
      id: "left_nav_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  margin-bottom: ${args.theme.var.spacing.xl};
  padding-bottom: ${args.theme.var.spacing.lg};
  border-bottom: 1px solid ${args.theme.var.color.border};
}`;
'''
      }
    },
    {
      id: "left_nav_logo",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: "Workshop"
};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.xl};
  font-weight: 700;
  color: ${args.theme.var.color.text};
  margin: 0;
  display: flex;
  align-items: center;
  gap: ${args.theme.var.spacing.sm};
}`;
'''
      }
    },
    {
      id: "left_nav_menu",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: ${args.theme.var.spacing.lg};
}`;
'''
      }
    },
    {
      id: "nav_sections_loop",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "navSection",
        loop: true,
        props: '''
const sections = args.fns.navigationSections;
return {
  as: "div",
  data: sections
};
''',
        css: '''
return `._id {
  display: contents;
}`;
'''
      }
    },
    {
      id: "nav_section",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const section = args.contextData.navSection;
const hasBorder = section.hasBorder;
return {
  as: "div"
};
'''
      }
    },
    {
      id: "nav_section_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const section = args.contextData.navSection;
const title = section.title;
return {
  as: "h3",
  text: title,
  hide: !title
};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.sm};
  font-weight: 600;
  color: ${args.theme.var.color.muted};
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin: 0 0 ${args.theme.var.spacing.sm} 0;
  padding: 0 ${args.theme.var.spacing.md};
}`;
'''
      }
    },
    {
      id: "nav_section_list",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const section = args.contextData.navSection;
return {
  as: "ul"
};
''',
        css: '''
const section = args.contextData.navSection;
const hasBorder = section.hasBorder;
return `._id {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: ${args.theme.var.spacing.xs};
  ${hasBorder ? `padding-top: ${args.theme.var.spacing.md}; border-top: 1px solid ${args.theme.var.color.border};` : ''}
}`;
'''
      }
    },
    {
      id: "nav_items_loop",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "navItem",
        loop: true,
        props: '''
const section = args.contextData.navSection;
const items = section.items;
return {
  as: "li",
  data: items
};
''',
        css: '''
return `._id {
  margin: 0;
}`;
'''
      }
    },
    {
      id: "nav_item_link",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.navItem;
const isActive = item.pathCheck ? item.pathCheck(args.location.pathname) : false;
const isButton = item.isButton;
const isDanger = item.isDanger;

return {
  as: isButton ? "button" : "a",
  href: !isButton ? item.href : undefined,
  "aria-label": item.label,
  title: item.title,
  onClick: (e) => {
    e.preventDefault();
    args.fns.navigateTo?.(item.href);
  }
};
''',
        css: '''
const item = args.contextData.navItem;
const isActive = item.pathCheck ? item.pathCheck(args.location.pathname) : false;
const isButton = item.isButton;
const isDanger = item.isDanger;

return `._id {
  display: flex;
  align-items: center;
  gap: ${args.theme.var.spacing.md};
  padding: ${args.theme.var.spacing.sm} ${args.theme.var.spacing.md};
  border-radius: ${args.theme.var.borderRadius.md};
  background: ${isActive ? args.theme.var.color.background_light_200 : 'transparent'};
  color: ${isDanger ? args.theme.var.color.error : (isActive ? args.theme.var.color.primary : args.theme.var.color.text)};
  text-decoration: none;
  font-weight: ${isActive ? '600' : '500'};
  transition: all ${args.theme.var.animation.fast} ease;
  ${isButton ? `
    border: none;
    font-size: inherit;
    font-family: inherit;
    cursor: pointer;
    width: 100%;
    text-align: left;
  ` : ''}

  &:hover {
    background: ${isDanger ? args.theme.var.color.error_light_100 : args.theme.var.color.background_light_200};
    color: ${isDanger ? args.theme.var.color.error_dark_200 : args.theme.var.color.primary};
  }
  
  ${isButton ? `
    &:active {
      transform: scale(0.98);
    }
  ` : ''}
}`;
'''
      }
    },
    {
      id: "nav_item_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
