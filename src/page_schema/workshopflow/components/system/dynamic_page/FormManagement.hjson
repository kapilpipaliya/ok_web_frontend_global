          '''
const inModal = c.props?.inModal === true;
const lg = t.var.spacing.lg;
const md = t.var.spacing.md;
return `._id {
  padding: ${md} ${lg};
  border-top: 1px solid ${t.var.color.border};
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: ${md};
  ${inModal ? `
  margin-left: -${lg};
  margin-right: -${lg};
  margin-bottom: -${lg};
  padding-left: ${lg};
  padding-right: ${lg};
  padding-bottom: ${lg};
  ` : ''}
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''
return {
  as: "div",
  hide: f.getMode?.() === "view" || c.props?.hideActionsBar === true
};
'''
      }
