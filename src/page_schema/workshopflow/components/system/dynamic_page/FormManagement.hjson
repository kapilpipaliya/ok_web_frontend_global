    {
      id: "14"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Button
        props:
          '''
const onClose = c.props?.onClose;

const handleCancel = () => {
  // Cleanup transaction if needed
  const txnId = f.formTxnId();
  if (txnId && txnId > 0) {
    _.revertTransaction(txnId);
    f.setFormTxnId(0);
  }

  if (onClose) {
    onClose();
  }
};

return {
  variant: "secondary",
  onClick: handleCancel,
  text: "Cancel",
  disabled: f.isSubmitting(),
  hide: f.getUsePolarisUI?.() === true
};
'''
      }
