          '''
const columnDef = args.contextData.nestedLineColumn;
const lineEntryContext = args.contextData.lineEntry;
const resolvedLineVertex = args.fns.resolveLineRowVertex(lineEntryContext);
const lineIndex = lineEntryContext?.index ?? 0;
const selectCfg = args.fns.mergeLineTargetSelectConfig(columnDef);
const linkForColumn = args.fns.resolveLineTargetLinkForColumn(columnDef);
const labelFieldRaw = selectCfg.labelField != null ? String(selectCfg.labelField).trim() : "";
const labelTemplateRaw =
  selectCfg.labelTemplate != null ? String(selectCfg.labelTemplate).trim() : "";
const tomSelectLabelKey =
  labelFieldRaw === ""
    ? "id"
    : String(labelFieldRaw).includes(".")
      ? String(labelFieldRaw)
      : "P." + labelFieldRaw;
const linkedTargetVertexId = resolvedLineVertex
  ? args.fns.lineTargetValueForLine(resolvedLineVertex, columnDef)
  : "";
const vertexListLabel =
  selectCfg.label != null && String(selectCfg.label).trim() !== ""
    ? String(selectCfg.label).trim()
    : linkForColumn
      ? linkForColumn.targetLabel
      : "";
const neighborFilter = selectCfg.neighborFilter;
let neighborFromElementId = "";
if (neighborFilter && neighborFilter.anchorRelationshipType) {
  const anchorCol = {
    columnType: "lineTarget",
    targetRelationshipType: String(neighborFilter.anchorRelationshipType).trim(),
  };
  neighborFromElementId = resolvedLineVertex
    ? String(args.fns.lineTargetValueForLine(resolvedLineVertex, anchorCol) || "").trim()
    : "";
}
const scopedFromPage = args.fns.getProps().enableUserScopingForContent;
const useUserScopingForVertices =
  scopedFromPage === true ||
  (scopedFromPage === undefined && selectCfg.enableUserScoping === true);
const functionContext = {
  label: vertexListLabel,
  search: selectCfg.search != null ? String(selectCfg.search) : "",
  limit: selectCfg.limit != null ? Number(selectCfg.limit) : undefined,
  relationshipType: selectCfg.relationshipType,
  enableUserScoping: useUserScopingForVertices,
};
if (neighborFilter && neighborFilter.outgoingRelationshipType) {
  functionContext.neighborFromElementId = neighborFromElementId;
  functionContext.neighborOutgoingRelationshipType = String(
    neighborFilter.outgoingRelationshipType,
  ).trim();
  const userPath = neighborFilter.userPathToAnchor;
  if (userPath && userPath.relationshipType && userPath.anchorLabel) {
    functionContext.neighborUserPathRelationshipType = String(userPath.relationshipType).trim();
    functionContext.neighborUserPathAnchorLabel = String(userPath.anchorLabel).trim();
  }
}
const neighborBlocksOptions =
  !!(neighborFilter && neighborFilter.outgoingRelationshipType) && !neighborFromElementId;
return {
  functionName: "getUserVertices",
  value: linkedTargetVertexId ? String(linkedTargetVertexId) : "",
  onChange: (nextTargetId, tomSelectOption) =>
    args.fns.patchCell(lineIndex, columnDef, nextTargetId || "", tomSelectOption),
  singularName: selectCfg.singularName != null ? String(selectCfg.singularName) : "",
  pluralName: selectCfg.pluralName != null ? String(selectCfg.pluralName) : "",
  valueKey: "id",
  labelKey: tomSelectLabelKey,
  labelTemplate: labelTemplateRaw || undefined,
  functionContext,
  placeholder:
    columnDef.placeholder != null && String(columnDef.placeholder).trim() !== ""
      ? String(columnDef.placeholder).trim()
      : selectCfg.placeholder != null && String(selectCfg.placeholder).trim() !== ""
        ? String(selectCfg.placeholder).trim()
        : selectCfg.singularName != null
          ? String(selectCfg.singularName)
          : columnDef.label != null
            ? String(columnDef.label)
            : "",
  disabled: args.fns.isDisabled() || neighborBlocksOptions,
  hide: (functionArguments) => {
    const columnDefFromContext = functionArguments.contextData.nestedLineColumn;
    const lineEntryFromContext = functionArguments.contextData.lineEntry;
    if (functionArguments.fns.isFileAttachmentsColumn(columnDefFromContext)) return true;
    if (!functionArguments.fns.isLineTargetPickerColumn(columnDefFromContext)) return true;
    const resolvedLineVertexForVisibility =
      functionArguments.fns.resolveLineRowVertex(lineEntryFromContext);
    return !functionArguments.fns.showLineTargetPickerColumn(
      columnDefFromContext,
      resolvedLineVertexForVisibility,
    );
  }
};
'''
