{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: FormNestedLineItems
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        fns:
          '''
const getProps = () => args.contextData.props || {};
const getField = () => getProps().field || {};
const getNestedLineItemsConfig = () => getField().nestedLineItemsConfig || {};

const getColumns = () => {
  const nestedLineItemsConfig = getNestedLineItemsConfig();
  const lineColumns = nestedLineItemsConfig.lineColumns;
  return Array.isArray(lineColumns) ? lineColumns : [];
};

const gridTemplateColumns = () => {
  const columnDefinitions = getColumns();
  if (columnDefinitions.length === 0) return "minmax(4rem, 1fr)";
  return columnDefinitions
    .map((columnDef) =>
      columnDef.gridMinmax != null && String(columnDef.gridMinmax).trim() !== ""
        ? String(columnDef.gridMinmax).trim()
        : "minmax(5rem, 1fr)",
    )
    .join(" ");
};

const getColumnSelectOptions = (columnDef) => {
  if (!columnDef || columnDef.columnType !== "select") return [];
  const nestedLineItemsConfig = getNestedLineItemsConfig();
  const optionsSourceKey = columnDef.optionsKey || "options";
  const optionsFromConfig =
    nestedLineItemsConfig[optionsSourceKey] != null
      ? nestedLineItemsConfig[optionsSourceKey]
      : columnDef.options;
  return Array.isArray(optionsFromConfig) ? optionsFromConfig : [];
};

const isLineTargetPickerColumn = (columnDef) =>
  columnDef && columnDef.columnType === "lineTarget";

const isFileAttachmentsColumn = (columnDef) =>
  columnDef && columnDef.columnType === "fileAttachments";

const fileAttachmentsMaxFiles = (columnDef) => {
  const configuredMax = columnDef?.fileAttachmentsConfig?.maxFiles;
  return configuredMax != null && Number.isFinite(Number(configuredMax))
    ? Math.max(0, Math.floor(Number(configuredMax)))
    : 20;
};

const fileAttachmentsAccept = (columnDef) => {
  const configuredAccept = columnDef?.fileAttachmentsConfig?.accept;
  return configuredAccept != null && String(configuredAccept).trim() !== ""
    ? String(configuredAccept).trim()
    : undefined;
};

const mergeLineTargetSelectConfig = (columnDef) => {
  const root = getNestedLineItemsConfig().lineTargetSelectConfig || {};
  const col = columnDef?.lineTargetSelectConfig || {};
  return { ...root, ...col };
};

const resolveLineTargetLinkForColumn = (columnDef) => {
  const cfg = getNestedLineItemsConfig();
  const rawLinks = cfg.lineTargetLinks;
  if (!Array.isArray(rawLinks) || rawLinks.length === 0) return null;
  const relPick =
    columnDef &&
    columnDef.targetRelationshipType != null &&
    String(columnDef.targetRelationshipType).trim() !== ""
      ? String(columnDef.targetRelationshipType).trim()
      : null;
  if (relPick) {
    const found = rawLinks.find(
      (entry) => entry && String(entry.relationshipType || "").trim() === relPick,
    );
    if (!found || !found.relationshipType || !found.targetLabel) return null;
    return {
      relationshipType: String(found.relationshipType),
      targetLabel: String(found.targetLabel),
    };
  }
  const rawIndex = columnDef != null ? columnDef.lineTargetLinkIndex : null;
  const idx =
    rawIndex != null && Number.isFinite(Number(rawIndex)) ? Math.floor(Number(rawIndex)) : null;
  if (idx != null && idx >= 0 && idx < rawLinks.length) {
    const entry = rawLinks[idx];
    if (!entry || !entry.relationshipType || !entry.targetLabel) return null;
    return {
      relationshipType: String(entry.relationshipType),
      targetLabel: String(entry.targetLabel),
    };
  }
  const first = rawLinks[0];
  if (!first || !first.relationshipType || !first.targetLabel) return null;
  return {
    relationshipType: String(first.relationshipType),
    targetLabel: String(first.targetLabel),
  };
};

const showLineTargetPickerColumn = (columnDef, rowVertex) => {
  if (!isLineTargetPickerColumn(columnDef)) return false;
  if (!resolveLineTargetLinkForColumn(columnDef)) return false;
  const visibilityFieldKey = columnDef.showWhenField;
  const visibilityValues = columnDef.showWhenValues;
  if (
    visibilityFieldKey != null &&
    String(visibilityFieldKey).trim() !== "" &&
    Array.isArray(visibilityValues) &&
    visibilityValues.length > 0
  ) {
    const propertyValue = rowVertex?.P?.[visibilityFieldKey];
    const normalizedPropertyValue = String(propertyValue ?? "").trim().toLowerCase();
    return visibilityValues.some(
      (allowedValue) => String(allowedValue).trim().toLowerCase() === normalizedPropertyValue,
    );
  }
  return true;
};

const resolveLineRowVertex = (lineEntryContext) => {
  const lineVertexId = lineEntryContext?.row?.id;
  if (lineVertexId && args.graph.vertexes[lineVertexId]) return args.graph.vertexes[lineVertexId];
  return lineEntryContext?.row;
};

const sortedLineVertices = () => getProps().getRows?.() || [];

const rowEntries = () => {
  const lineVertices = sortedLineVertices();
  return lineVertices.map((lineVertex, lineIndex) => ({ row: lineVertex, index: lineIndex }));
};

// Form txn for nested-line edits. File vertices use txn 0 (persist on cancel); line→File edges use ensureTxn() so revert drops the link only.
const ensureTxn = () => {
  const formTxnId = getProps().getFormTxnId?.();
  if (formTxnId != null && formTxnId > 0) return formTxnId;
  return getProps().ensureTxn?.();
};

const clearOutgoingLineTargetsByTypes = (lineVertex, relationshipTypes) => {
  const txnId = ensureTxn();
  if (!txnId || !lineVertex?.id) return;
  const relTypes = Array.isArray(relationshipTypes) ? relationshipTypes : [];
  const lineVertexFresh = args.graph.vertexes[lineVertex.id] || lineVertex;
  for (let relIndex = 0; relIndex < relTypes.length; relIndex++) {
    const rt = String(relTypes[relIndex] || "").trim();
    if (!rt) continue;
    const existingEdgeIds = lineVertexFresh.OUT?.[rt];
    if (!Array.isArray(existingEdgeIds)) continue;
    for (let edgeIndex = 0; edgeIndex < existingEdgeIds.length; edgeIndex++) {
      args.deleteEdge(txnId, existingEdgeIds[edgeIndex], args.graph, args.setGraph);
    }
  }
};

const detachAndDeleteLineVertex = (lineVertex) => {
  const txnId = ensureTxn();
  if (!txnId || !lineVertex?.id) return;
  const lineVertexId = lineVertex.id;
  const collectEdgeIds = (vertex) => {
    const allEdgeIds = [];
    if (vertex?.OUT) {
      for (const relationshipType of Object.keys(vertex.OUT)) {
        const outgoingEdgeIds = vertex.OUT[relationshipType];
        if (Array.isArray(outgoingEdgeIds)) allEdgeIds.push(...outgoingEdgeIds);
      }
    }
    if (vertex?.IN) {
      for (const relationshipType of Object.keys(vertex.IN)) {
        const incomingEdgeIds = vertex.IN[relationshipType];
        if (Array.isArray(incomingEdgeIds)) allEdgeIds.push(...incomingEdgeIds);
      }
    }
    return allEdgeIds;
  };
  let detachPassCount = 0;
  while (detachPassCount++ < 80) {
    const vertexFromGraph = args.graph.vertexes[lineVertexId];
    if (!vertexFromGraph) return;
    const edgeIdsToRemove = collectEdgeIds(vertexFromGraph);
    if (edgeIdsToRemove.length === 0) break;
    for (let edgeIndex = 0; edgeIndex < edgeIdsToRemove.length; edgeIndex++) {
      args.deleteEdge(txnId, edgeIdsToRemove[edgeIndex], args.graph, args.setGraph);
    }
  }
  args.deleteVertex(txnId, lineVertexId, args.graph, args.setGraph);
};

const setLineTargetVertexForColumn = (lineVertex, targetVertexId, columnDef, tomSelectOption) => {
  const txnId = ensureTxn();
  if (!txnId || !lineVertex?.id) return;
  const link = resolveLineTargetLinkForColumn(columnDef);
  if (!link) return;
  const relationshipType = link.relationshipType;
  const lineVertexFresh = args.graph.vertexes[lineVertex.id] || lineVertex;
  const existingEdgeIds = lineVertexFresh.OUT?.[relationshipType];
  if (Array.isArray(existingEdgeIds)) {
    for (const existingEdgeId of [...existingEdgeIds]) {
      args.deleteEdge(txnId, existingEdgeId, args.graph, args.setGraph);
    }
  }
  const trimmedTargetId = targetVertexId != null ? String(targetVertexId).trim() : "";
  const optionVertex = tomSelectOption && tomSelectOption.vertex;
  if (
    trimmedTargetId &&
    !args.graph.vertexes[trimmedTargetId] &&
    optionVertex &&
    optionVertex.id != null &&
    String(optionVertex.id) === trimmedTargetId &&
    Array.isArray(optionVertex.L) &&
    optionVertex.P != null
  ) {
    const optionVertexTxn = optionVertex.L.includes("File") ? 0 : txnId;
    args.addNewVertex(optionVertexTxn, optionVertex, args.graph, args.setGraph);
  }
  if (trimmedTargetId && args.graph.vertexes[trimmedTargetId]) {
    const newEdgeId = args.generateNewVertexId(args.graph, args.setGraph);
    const newEdge = args.newEdge(
      newEdgeId,
      relationshipType,
      {},
      lineVertexFresh.id,
      trimmedTargetId,
    );
    args.addNewEdge(txnId, newEdge, args.graph, args.setGraph);
  }
};

const patchLineP = (lineIndex, patch) => {
  const lines = sortedLineVertices();
  const lineVertex = lines[lineIndex];
  if (!lineVertex?.id) return;
  const txnId = ensureTxn();
  if (!txnId) return;
  if (patch && typeof patch === "object" && Object.keys(patch).length > 0) {
    args.mergeVertexProperties(txnId, lineVertex.id, args.graph, args.setGraph, patch);
  }
};

const patchCell = (lineIndex, columnDef, cellValue, tomSelectOption) => {
  if (!columnDef) return;
  if (isFileAttachmentsColumn(columnDef)) return;
  if (isLineTargetPickerColumn(columnDef)) {
    const lines = sortedLineVertices();
    const lineVertex = lines[lineIndex];
    if (!lineVertex?.id) return;
    const txnId = ensureTxn();
    if (!txnId) return;
    const lineVertexForTarget = args.graph.vertexes[lineVertex.id] || lineVertex;
    setLineTargetVertexForColumn(lineVertexForTarget, cellValue, columnDef, tomSelectOption);
    const clearTypes = columnDef.lineTargetOnChangeClearRelationshipTypes;
    if (Array.isArray(clearTypes) && clearTypes.length > 0) {
      clearOutgoingLineTargetsByTypes(lineVertexForTarget, clearTypes);
    }
    return;
  }
  if (columnDef.columnType === "actions") return;
  if (!columnDef.key || String(columnDef.key).startsWith("_")) return;
  const propertyPatch = { [columnDef.key]: cellValue };
  patchLineP(lineIndex, propertyPatch);
};

const lineTargetValueForLine = (rowVertex, columnDef) => {
  if (!rowVertex?.id) return "";
  const lineVertexFromGraph = args.graph.vertexes[rowVertex.id] || rowVertex;
  const link = resolveLineTargetLinkForColumn(columnDef);
  if (!link) return "";
  const relType = link.relationshipType;
  const targetLabel = link.targetLabel;
  if (!relType || !lineVertexFromGraph.OUT?.[relType]) return "";
  const edgeIds = lineVertexFromGraph.OUT[relType];
  for (let edgeIndex = 0; edgeIndex < edgeIds.length; edgeIndex++) {
    const edge = args.graph.edges[edgeIds[edgeIndex]];
    if (!edge) continue;
    const targetVertex = args.graph.vertexes[edge.E];
    if (targetVertex && !targetVertex.L?.includes(targetLabel)) continue;
    return edge.E;
  }
  return "";
};

const fileAttachmentEntries = (lineIndex, columnDef) => {
  if (!isFileAttachmentsColumn(columnDef)) return [];
  const link = resolveLineTargetLinkForColumn(columnDef);
  if (!link) return [];
  const lines = sortedLineVertices();
  const lineVertex = lines[lineIndex];
  if (!lineVertex?.id) return [];
  const lineFresh = args.graph.vertexes[lineVertex.id] || lineVertex;
  if (!lineFresh?.OUT?.[link.relationshipType]) return [];
  const edgeIds = lineFresh.OUT[link.relationshipType];
  const attachmentEntries = [];
  for (let edgeIndex = 0; edgeIndex < edgeIds.length; edgeIndex++) {
    const edge = args.graph.edges[edgeIds[edgeIndex]];
    if (!edge) continue;
    const targetVertex = args.graph.vertexes[edge.E];
    if (!targetVertex?.L?.includes(link.targetLabel)) continue;
    attachmentEntries.push({
      fileId: edge.E,
      fileName:
        targetVertex.P?.fileName != null
          ? String(targetVertex.P.fileName)
          : String(edge.E).slice(0, 12),
    });
  }
  return attachmentEntries;
};

const mergeUploadGraphIntoTxn = (txnId, payload) => {
  const fileIds = [];
  if (!payload || typeof payload !== "object") return fileIds;
  const uploadGraph = payload.graph;
  if (!uploadGraph || typeof uploadGraph !== "object") return fileIds;
  const uploadVertexes = uploadGraph.vertexes;
  if (uploadVertexes && typeof uploadVertexes === "object" && !Array.isArray(uploadVertexes)) {
    const uploadVertexList = Object.values(uploadVertexes);
    for (let vertexIndex = 0; vertexIndex < uploadVertexList.length; vertexIndex++) {
      const uploadVertex = uploadVertexList[vertexIndex];
      if (!uploadVertex || uploadVertex.id == null) continue;
      if (!args.graph.vertexes[uploadVertex.id]) {
        const uploadVertexTxn =
          Array.isArray(uploadVertex.L) && uploadVertex.L.includes("File") ? 0 : txnId;
        args.addNewVertex(uploadVertexTxn, uploadVertex, args.graph, args.setGraph);
      }
      if (Array.isArray(uploadVertex.L) && uploadVertex.L.includes("File")) {
        fileIds.push(String(uploadVertex.id));
      }
    }
  }
  const uploadEdges = uploadGraph.edges;
  if (uploadEdges && typeof uploadEdges === "object" && !Array.isArray(uploadEdges)) {
    const uploadEdgeList = Object.values(uploadEdges);
    for (let edgeIndex = 0; edgeIndex < uploadEdgeList.length; edgeIndex++) {
      const uploadEdge = uploadEdgeList[edgeIndex];
      if (!uploadEdge || uploadEdge.id == null || args.graph.edges[uploadEdge.id]) continue;
      args.addNewEdge(0, uploadEdge, args.graph, args.setGraph);
    }
  }
  return fileIds;
};

const linkFileToLineVertex = (lineIndex, columnDef, fileId, optionVertex) => {
  const txnId = ensureTxn();
  if (!txnId) return;
  const lines = sortedLineVertices();
  const lineVertex = lines[lineIndex];
  if (!lineVertex?.id) return;
  const lineFresh = args.graph.vertexes[lineVertex.id] || lineVertex;
  const link = resolveLineTargetLinkForColumn(columnDef);
  if (!link) return;
  const maxFiles = fileAttachmentsMaxFiles(columnDef);
  const existingAttachments = fileAttachmentEntries(lineIndex, columnDef);
  const trimmedFileId = fileId != null ? String(fileId).trim() : "";
  if (!trimmedFileId) return;
  if (existingAttachments.some((attachment) => attachment.fileId === trimmedFileId)) return;
  if (maxFiles > 0 && existingAttachments.length >= maxFiles) {
    args.showErrorToast?.(`At most ${maxFiles} file(s) for this row`);
    return;
  }
  if (
    !args.graph.vertexes[trimmedFileId] &&
    optionVertex &&
    String(optionVertex.id) === trimmedFileId &&
    Array.isArray(optionVertex.L) &&
    optionVertex.P != null
  ) {
    args.addNewVertex(0, optionVertex, args.graph, args.setGraph);
  }
  if (!args.graph.vertexes[trimmedFileId]) return;
  const newEdgeId = args.generateNewVertexId(args.graph, args.setGraph);
  const newEdge = args.newEdge(newEdgeId, link.relationshipType, {}, lineFresh.id, trimmedFileId);
  args.addNewEdge(txnId, newEdge, args.graph, args.setGraph);
};

const removeFileAttachmentFromLine = (lineIndex, columnDef, fileId) => {
  const txnId = ensureTxn();
  if (!txnId) return;
  const lines = sortedLineVertices();
  const lineVertex = lines[lineIndex];
  if (!lineVertex?.id) return;
  const link = resolveLineTargetLinkForColumn(columnDef);
  if (!link) return;
  const lineFresh = args.graph.vertexes[lineVertex.id] || lineVertex;
  const edgeIds = lineFresh.OUT?.[link.relationshipType];
  if (!Array.isArray(edgeIds)) return;
  const trimmedFileId = fileId != null ? String(fileId).trim() : "";
  for (let edgeIndex = 0; edgeIndex < edgeIds.length; edgeIndex++) {
    const edge = args.graph.edges[edgeIds[edgeIndex]];
    if (!edge || edge.E !== trimmedFileId) continue;
    args.deleteEdge(txnId, edgeIds[edgeIndex], args.graph, args.setGraph);
    break;
  }
};

const handleNestedLineFilesUpload = async (lineIndex, columnDef, inputEvent) => {
  const input = inputEvent?.target;
  const fileList = input?.files;
  if (!fileList || fileList.length === 0) return;
  const txnId = ensureTxn();
  if (!txnId) return;
  try {
    for (let fileIndex = 0; fileIndex < fileList.length; fileIndex++) {
      const maxFiles = fileAttachmentsMaxFiles(columnDef);
      const currentAttachments = fileAttachmentEntries(lineIndex, columnDef);
      if (maxFiles > 0 && currentAttachments.length >= maxFiles) {
        args.showErrorToast?.(`At most ${maxFiles} file(s) for this row`);
        break;
      }
      const formData = new FormData();
      formData.append("file", fileList[fileIndex]);
      const uploadResponse = await fetch("/api/file/upload", {
        method: "POST",
        body: formData,
        credentials: "include",
      });
      const payload = await uploadResponse.json();
      if (!uploadResponse.ok || payload?.error) {
        args.showErrorToast?.(
          String(payload?.error || uploadResponse.statusText || "Upload failed"),
        );
        break;
      }
      const mergedFileIds = mergeUploadGraphIntoTxn(txnId, payload);
      for (let mergedIdIndex = 0; mergedIdIndex < mergedFileIds.length; mergedIdIndex++) {
        linkFileToLineVertex(lineIndex, columnDef, mergedFileIds[mergedIdIndex], null);
      }
    }
  } catch (uploadError) {
    args.showErrorToast?.(uploadError?.message || "Upload failed");
  }
  if (input) input.value = "";
};

const addRow = () => {
  const parentVertex = getProps().getParentVertex?.();
  if (!parentVertex?.id) return;
  const txnId = ensureTxn();
  if (!txnId) return;
  const nestedLineItemsConfig = getNestedLineItemsConfig();
  const childLabel = nestedLineItemsConfig.childLabel;
  const parentToChildRelationshipType = nestedLineItemsConfig.parentToChildRelationshipType;
  const parentElementIdPropertyKey = nestedLineItemsConfig.parentElementIdPropOnChild;
  if (!childLabel || !parentToChildRelationshipType || !parentElementIdPropertyKey) return;
  const displayOrder = Date.now();
  const newLineProperties = { [parentElementIdPropertyKey]: parentVertex.id, displayOrder };
  const columnDefinitions = getColumns();
  for (let columnIndex = 0; columnIndex < columnDefinitions.length; columnIndex++) {
    const columnDef = columnDefinitions[columnIndex];
    if (!columnDef || columnDef.columnType === "actions" || isLineTargetPickerColumn(columnDef) || isFileAttachmentsColumn(columnDef)) continue;
    if (!columnDef.key || String(columnDef.key).startsWith("_")) continue;
    if (columnDef.defaultValue !== undefined) newLineProperties[columnDef.key] = columnDef.defaultValue;
  }
  const defaultNewLinePropertiesOverlay = nestedLineItemsConfig.defaultNewLineProperties;
  if (defaultNewLinePropertiesOverlay && typeof defaultNewLinePropertiesOverlay === "object") {
    for (const propertyKey of Object.keys(defaultNewLinePropertiesOverlay)) {
      newLineProperties[propertyKey] = defaultNewLinePropertiesOverlay[propertyKey];
    }
  }
  const newLineVertexId = args.generateNewVertexId(args.graph, args.setGraph);
  const newLineVertex = args.newVertex(newLineVertexId, [childLabel], newLineProperties);
  args.addNewVertex(txnId, newLineVertex, args.graph, args.setGraph);
  const newParentToChildEdgeId = args.generateNewVertexId(args.graph, args.setGraph);
  const parentToChildEdge = args.newEdge(
    newParentToChildEdgeId,
    parentToChildRelationshipType,
    {},
    parentVertex.id,
    newLineVertexId,
  );
  args.addNewEdge(txnId, parentToChildEdge, args.graph, args.setGraph);
};

const removeRow = (lineIndex) => {
  const lines = sortedLineVertices();
  const lineVertexToRemove = lines[lineIndex];
  if (!lineVertexToRemove) return;
  const resolveId = getProps().resolveNestedLineSourceElementId;
  const idForServerDelete =
    typeof resolveId === "function"
      ? resolveId(lineVertexToRemove.id)
      : lineVertexToRemove.id;
  if (idForServerDelete) getProps().markDeleted?.(idForServerDelete);
  detachAndDeleteLineVertex(lineVertexToRemove);
};

const selectFallback = (columnDef, selectedValueRaw) => {
  if (selectedValueRaw != null && String(selectedValueRaw).trim() !== "") return String(selectedValueRaw).trim();
  if (
    columnDef.selectFallbackValue != null &&
    String(columnDef.selectFallbackValue).trim() !== ""
  ) {
    return String(columnDef.selectFallbackValue).trim();
  }
  if (columnDef.defaultValue !== undefined) return String(columnDef.defaultValue);
  return "";
};

return {
  getProps,
  getField,
  getNestedLineItemsConfig,
  getColumns,
  gridTemplateColumns,
  getColumnSelectOptions,
  isLineTargetPickerColumn,
  showLineTargetPickerColumn,
  resolveLineTargetLinkForColumn,
  rowEntries,
  patchCell,
  patchLineP,
  lineTargetValueForLine,
  addRow,
  removeRow,
  selectFallback,
  resolveLineRowVertex,
  mergeLineTargetSelectConfig,
  clearOutgoingLineTargetsByTypes,
  isDisabled: () => getProps().disabled === true,
  isFileAttachmentsColumn,
  fileAttachmentEntries,
  fileAttachmentsMaxFiles,
  fileAttachmentsAccept,
  handleNestedLineFilesUpload,
  linkFileToLineVertex,
  removeFileAttachmentFromLine
};
'''
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "fm-nested-line-items"
};
'''
        css:
          '''
return [
  `._id.fm-nested-line-items {
  display: flex;
  flex-direction: column;
  gap: ${args.theme.var.spacing.sm};
  width: 100%;
}`,
  `._id.fm-nested-line-items .fm-nested-line-header-row,
._id.fm-nested-line-items .fm-nested-line-row {
  display: grid;
  grid-template-columns: var(--fm-nl-cols, minmax(4rem, 1fr));
  gap: ${args.theme.var.spacing.sm};
}`,
  `._id.fm-nested-line-items .fm-nested-line-header-row {
  align-items: center;
}`,
  `._id.fm-nested-line-items .fm-nested-line-row {
  align-items: start;
}`,
  `._id.fm-nested-line-items .fm-nested-line-cell {
  min-width: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}`,
  `._id.fm-nested-line-items .fm-nested-line-cell-error {
  font-size: ${args.theme.var.fontSize.xs};
  color: ${args.theme.var.color.error};
  line-height: 1.3;
  min-height: 1rem;
}`,
  `._id.fm-nested-line-items .fm-nested-line-row:focus-within {
  position: relative;
  z-index: 4;
}`,
  `._id.fm-nested-line-items .ts-dropdown .ts-dropdown-content {
  max-height: min(50vh, 20rem);
}`,
  `._id.fm-nested-line-items .fm-nl-fa-input {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}`,
  `._id.fm-nested-line-items .fm-nl-fa-list {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  width: 100%;
}`,
  `._id.fm-nested-line-items .fm-nl-fa-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  font-size: ${args.theme.var.fontSize.sm};
  color: ${args.theme.var.color.text};
}`,
  `._id.fm-nested-line-items .fm-nl-fa-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}`
];
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Button
        props:
          '''
return {
  variant: "secondary",
  text: "Add line",
  type: "button",
  disabled: args.fns.isDisabled(),
  onClick: () => args.fns.addRow()
};
'''
      }
    }
    {
      id: "4w"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "fm-nested-line-table",
  style: { "--fm-nl-cols": args.fns.gridTemplateColumns() }
};
'''
        css:
          '''
return `._id.fm-nested-line-table {
  width: 100%;
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.375rem;
  overflow: visible;
  display: flex;
  flex-direction: column;
}`;
'''
      }
    }
    {
      id: "4h"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "fm-nested-line-header-row",
  role: "row"
};
'''
        css:
          '''
return `._id.fm-nested-line-header-row {
  padding: ${args.theme.var.spacing.sm};
  background: ${args.theme.var.color.background_light_100};
  border-bottom: 1px solid ${args.theme.var.color.border};
