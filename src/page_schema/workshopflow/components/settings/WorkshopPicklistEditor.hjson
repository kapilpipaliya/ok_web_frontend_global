{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: WorkshopPicklistEditor
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        fns:
          '''
const picklistKey = () => String(args.contextData.props?.picklistKey || "").trim();

const [options, setOptions] = args.createSignal([]);
const [optionVertexLabel, setOptionVertexLabel] = args.createSignal(null);
const [loading, setLoading] = args.createSignal(false);
const [saving, setSaving] = args.createSignal(false);

const getRows = () =>
  options().map((v, i) => ({
    value: v?.P?.value != null ? String(v.P.value) : "",
    label: v?.P?.label != null ? String(v.P.label) : "",
    _idx: i
  }));

const loadPicklist = async () => {
  const key = picklistKey();
  if (!key) return;
  setLoading(true);
  try {
    const res = await args.executeNamedServerFunction({
      functionName: "getWorkshopPicklist",
      contextData: { picklistKey: key }
    });
    if (res?.error) {
      args.showErrorToast?.(String(res.error));
      return;
    }
    const inner = res?.result;
    if (!inner?.success) {
      args.showErrorToast?.(inner?.message || "Failed to load picklist");
      return;
    }
    const d = inner.data || {};
    const verts = Array.isArray(d.optionVertexes) ? d.optionVertexes : [];
    setOptions(args.klona(verts));
    const srvLbl =
      d.optionVertexLabel != null && String(d.optionVertexLabel).trim()
        ? String(d.optionVertexLabel).trim()
        : "";
    if (!srvLbl) {
      args.showErrorToast?.("Missing optionVertexLabel from server");
      setOptionVertexLabel(null);
    } else {
      setOptionVertexLabel(srvLbl);
    }
  } catch (err) {
    args.showErrorToast?.(err?.message || "Failed to load picklist");
  } finally {
    setLoading(false);
  }
};

const savePicklist = async () => {
  const key = picklistKey();
  if (!key) return;
  setSaving(true);
  try {
    const cleaned = getRows().map((row, i) => ({
      value: String(row.value != null ? row.value : "").trim(),
      label: String(row.label != null ? row.label : "").trim(),
      displayOrder: (i + 1) * 10
    }));
    const res = await args.executeNamedServerFunction({
      functionName: "saveWorkshopPicklist",
      contextData: {
        picklistKey: key,
        options: cleaned
      }
    });
    if (res?.error) {
      args.showErrorToast?.(String(res.error));
      return;
    }
    const inner = res?.result;
    if (!inner?.success) {
      args.showErrorToast?.(inner?.message || "Save failed");
      return;
    }
    args.showSuccessToast?.(inner.message || "Picklist saved");
    await loadPicklist();
  } catch (err) {
    args.showErrorToast?.(err?.message || "Save failed");
  } finally {
    setSaving(false);
  }
};

const addRow = () => {
  const lbl = optionVertexLabel();
  if (!lbl) {
    args.showErrorToast?.("Load the picklist before adding rows");
    return;
  }
  setOptions([
    ...options(),
    {
      id: `draft:${Date.now()}:${Math.random().toString(36).slice(2, 9)}`,
      L: [lbl],
      P: { value: "", label: "" },
      IN: {},
      OUT: {}
    }
  ]);
};

const removeRow = (idx) => {
  setOptions(options().filter((_, i) => i !== idx));
};

const updateRow = (idx, patch) => {
  setOptions(
    options().map((v, i) => {
      if (i !== idx) return v;
      const nextP = { ...(v.P || {}) };
      if (Object.prototype.hasOwnProperty.call(patch, "value")) {
        nextP.value = patch.value;
      }
      if (Object.prototype.hasOwnProperty.call(patch, "label")) {
        nextP.label = patch.label;
      }
      return { ...v, P: nextP };
    })
  );
};

const moveRowUp = (idx) => {
  const arr = options();
  if (idx <= 0) return;
  const next = arr.slice();
  const t = next[idx - 1];
  next[idx - 1] = next[idx];
  next[idx] = t;
  setOptions(next);
};

const moveRowDown = (idx) => {
  const arr = options();
  if (idx >= arr.length - 1) return;
  const next = arr.slice();
  const t = next[idx + 1];
  next[idx + 1] = next[idx];
  next[idx] = t;
  setOptions(next);
};

const rowCount = () => options().length;

return {
  picklistKey,
  getRows,
  loadPicklist,
  savePicklist,
  addRow,
  removeRow,
  updateRow,
  moveRowUp,
  moveRowDown,
  rowCount,
  picklistHeading: () =>
    String(args.contextData.props?.defaultTitle || args.contextData.props?.pageTitle || "")
      .trim() || picklistKey(),
  optionVertexLabelStr: () => optionVertexLabel() || "",
  loading,
  saving,
  isLoading: () => loading(),
  isSaving: () => saving()
};
'''
