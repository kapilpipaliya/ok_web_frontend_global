{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: WorkshopReferenceSequenceEditor
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        fns:
          '''
const sequenceKey = () => String(c.props?.sequenceKey || "").trim();

const neoStr = (v) => {
  if (v == null) return "";
  if (typeof v.toNumber === "function") return String(v.toNumber());
  return String(v);
};

const [prefix, setPrefix] = _.createSignal("");
const [suffix, setSuffix] = _.createSignal("");
const [startingNumber, setStartingNumber] = _.createSignal("1000");
const [incrementStep, setIncrementStep] = _.createSignal("1");
const [formatStr, setFormatStr] = _.createSignal("{prefix}{number}{suffix}");
const [resetRule, setResetRule] = _.createSignal("never");
const [numberPadding, setNumberPadding] = _.createSignal("0");
const [currentNumberDisp, setCurrentNumberDisp] = _.createSignal("—");
const [loading, setLoading] = _.createSignal(false);
const [saving, setSaving] = _.createSignal(false);

const loadSequence = async () => {
  const key = sequenceKey();
  if (!key) return;
  setLoading(true);
  try {
    const res = await s({
      functionName: "getWorkshopReferenceSequences",
      contextData: {}
    });
    if (res?.error) {
      _.showErrorToast?.(String(res.error));
      return;
    }
    const inner = res?.result;
    if (!inner?.success) {
      _.showErrorToast?.(inner?.message || "Failed to load sequences");
      return;
    }
    const list = inner.data?.sequences || [];
    const row = list.find((v) => String(v?.P?.key || "") === key);
    if (!row) {
      _.showErrorToast?.("Sequence not found: " + key);
      return;
    }
    const P = row.P || {};
    setPrefix(String(P.prefix ?? ""));
    setSuffix(String(P.suffix ?? ""));
    setStartingNumber(String(neoStr(P.startingNumber) || "1000"));
    setIncrementStep(String(neoStr(P.incrementStep) || "1"));
    setFormatStr(String(P.format || "{prefix}{number}{suffix}"));
    setResetRule(String(P.resetRule || "never").toLowerCase());
    setNumberPadding(String(neoStr(P.numberPadding) || "0"));
    const cn = P.currentNumber;
    if (cn === undefined || cn === null || cn === "") {
      setCurrentNumberDisp("Not reserved yet (starts at next save/reserve)");
    } else {
      setCurrentNumberDisp(neoStr(cn));
    }
  } catch (err) {
    _.showErrorToast?.(err?.message || "Failed to load sequence");
  } finally {
    setLoading(false);
  }
};

const saveSequence = async (opts) => {
  const key = sequenceKey();
  if (!key) return;
  setSaving(true);
  try {
    const res = await s({
      functionName: "saveWorkshopReferenceSequence",
      contextData: {
        key,
        prefix: prefix(),
        suffix: suffix(),
        startingNumber: Number(startingNumber()),
        incrementStep: Number(incrementStep()),
        format: formatStr(),
        resetRule: resetRule(),
        numberPadding: Number(numberPadding()),
        resetCounter: opts?.resetCounter === true
      }
    });
    if (res?.error) {
      _.showErrorToast?.(String(res.error));
      return;
    }
    const inner = res?.result;
    if (!inner?.success) {
      _.showErrorToast?.(inner?.message || "Save failed");
      return;
    }
    _.showSuccessToast?.(inner.message || "Saved");
    await loadSequence();
  } catch (err) {
    _.showErrorToast?.(err?.message || "Save failed");
  } finally {
    setSaving(false);
  }
};

const onResetCounter = () => {
  if (typeof globalThis.confirm === "function") {
    const ok = globalThis.confirm(
      "Reset the counter so the next reserved number uses the starting number rules? This does not change existing records."
    );
    if (!ok) return;
  }
  void saveSequence({ resetCounter: true });
};

return {
  sequenceKey,
  sectionTitle: () =>
    String(c.props?.sectionTitle || "").trim() || "Reference number",
  description: () => String(c.props?.description || "").trim(),
  prefix,
  setPrefix,
  suffix,
  setSuffix,
  startingNumber,
  setStartingNumber,
  incrementStep,
  setIncrementStep,
  formatStr,
  setFormatStr,
  resetRule,
  setResetRule,
  numberPadding,
  setNumberPadding,
  currentNumberDisp,
  loading,
  saving,
  loadSequence,
  saveSequence,
  onResetCounter,
  isLoading: () => loading(),
  isSaving: () => saving()
};
'''
        css:
          '''
return `._id.workshop-refseq-editor {
  background: ${t.var.color.background_light_100};
  border: 1px solid ${t.var.color.border};
  border-radius: ${t.var.borderRadius.lg};
  padding: ${t.var.spacing.lg};
  margin-bottom: ${t.var.spacing.lg};
  max-width: 960px;
}`;
'''
        componentName: Html
        props:
          '''
const sk = String(c.props?.sequenceKey || "").trim();
return {
  as: "div",
  class: "workshop-refseq-editor",
  hide: !sk,
  onMount: () => {
    if (sk) f.loadSequence();
  }
};
'''
