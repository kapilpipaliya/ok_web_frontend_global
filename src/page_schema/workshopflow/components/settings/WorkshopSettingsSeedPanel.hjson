return {
  variant: "danger",
  text: "Force / replace",
  disabled: args.fns.busy(),
  onClick: () => {
    if (
      typeof window !== "undefined" &&
      !window.confirm(
        "Overwrite picklist options for the selected keys? This deletes existing option nodes for those labels and recreates defaults."
      )
    ) {
      return;
    }
    args.fns.runSeed("force");
  }
};
'''
