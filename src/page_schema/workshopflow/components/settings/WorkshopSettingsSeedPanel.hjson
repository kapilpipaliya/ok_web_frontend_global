{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: WorkshopSettingsSeedPanel
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        fns:
          '''
const [keysFilter, setKeysFilter] = args.createSignal("");
const [lastMessage, setLastMessage] = args.createSignal("");
const [busy, setBusy] = args.createSignal(false);

const parseKeys = () => {
  const raw = keysFilter().trim();
  if (!raw) return null;
  return raw
    .split(/[,\s]+/)
    .map((s) => s.trim())
    .filter(Boolean);
};

const runSeed = async (mode) => {
  setBusy(true);
  setLastMessage("");
  try {
    const keys = parseKeys();
    const res = await args.executeNamedServerFunction({
      functionName: "seedWorkshopPicklists",
      contextData: keys && keys.length ? { mode, keys } : { mode }
    });
    if (res?.error) {
      setLastMessage("Error: " + String(res.error));
      args.showErrorToast?.(String(res.error));
      return;
    }
    const inner = res?.result;
    if (!inner?.success) {
      const msg = inner?.message || "Seed failed";
      setLastMessage(msg);
      args.showErrorToast?.(msg);
      return;
    }
    const d = inner.data || {};
    const summary = `Created: ${d.created ?? 0}, updated: ${d.updated ?? 0}, skipped: ${d.skipped ?? 0}`;
    setLastMessage((inner.message || "Done") + " — " + summary);
    args.showSuccessToast?.(inner.message || "Picklists updated");
  } catch (e) {
    setLastMessage(e?.message || "Seed failed");
    args.showErrorToast?.(e?.message || "Seed failed");
  } finally {
    setBusy(false);
  }
};

return {
  keysFilter,
  setKeysFilter,
  lastMessage,
  busy,
  runSeed
};
'''
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "workshop-seed-panel"
};
'''
        css:
          '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: ${args.theme.var.spacing.md};
  max-width: 720px;
}`;
'''
      }
    }
