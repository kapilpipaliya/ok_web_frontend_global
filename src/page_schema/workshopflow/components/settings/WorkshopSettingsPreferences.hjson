{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: WorkshopSettingsPreferences
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        fns:
          '''
const [timezoneData, setTimezoneData] = args.createSignal(null);
const [selectedTimezone, setSelectedTimezone] = args.createSignal("");
const [tzLoading, setTzLoading] = args.createSignal(true);
const [tzSaving, setTzSaving] = args.createSignal(false);

const fetchTimezones = async () => {
  try {
    const response = await args.executeNamedServerFunction({
      functionName: "getAvailableTimezones",
      contextData: {}
    });
    if (response?.error) return null;
    if (response?.result?.success) return response.result.data;
    return null;
  } catch {
    return null;
  }
};

const saveTimezoneApi = async (timezone) => {
  try {
    const response = await args.executeNamedServerFunction({
      functionName: "updateUserTimezone",
      contextData: { timezone }
    });
    if (response?.error) {
      args.showErrorToast?.(String(response.error));
      return false;
    }
    if (response?.result?.success) {
      args.showSuccessToast?.(response.result.message || "Timezone updated");
      return true;
    }
    args.showErrorToast?.(response?.result?.message || "Failed to update timezone");
    return false;
  } catch (error) {
    args.showErrorToast?.(error?.message || "Error updating timezone");
    return false;
  }
};

const tzOptions = () => {
  const d = timezoneData();
  const raw = d?.allTimezones;
  if (!Array.isArray(raw)) return [];
  return raw.map((t) =>
    typeof t === "string"
      ? { value: t, label: t }
      : { value: t.value || t.id || "", label: t.label || t.value || t.id || "" }
  );
};

const loadTz = async () => {
  setTzLoading(true);
  const data = await fetchTimezones();
  if (data) {
    setTimezoneData(data);
    setSelectedTimezone(data.currentTimezone || "");
  }
  setTzLoading(false);
};

const handleSaveTimezone = async () => {
  setTzSaving(true);
  try {
    const ok = await saveTimezoneApi(selectedTimezone());
    if (ok) await loadTz();
  } finally {
    setTzSaving(false);
  }
};

return {
  timezoneData,
  selectedTimezone,
  setSelectedTimezone,
  tzLoading,
  tzSaving,
  tzOptions,
  loadTz,
  handleSaveTimezone
};
'''
        componentName: Html
        props:
          '''
