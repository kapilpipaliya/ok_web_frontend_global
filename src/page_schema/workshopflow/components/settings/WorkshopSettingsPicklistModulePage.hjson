      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div",
  class: "workshop-settings-layout"
};
'''
        css:
          '''
return `._id.workshop-settings-layout {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
  width: 100%;
  min-height: 60vh;
  padding: ${args.theme.var.spacing.md};
}

@media (min-width: 769px) {
  ._id.workshop-settings-layout {
    flex-wrap: nowrap;
  }
}`;
'''
      }
