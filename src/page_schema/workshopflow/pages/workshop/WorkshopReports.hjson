      P: {
        access: FULL
      }
    }
    {
      id: "3"
      L: Page
      P: {
        signinRequired: true
        title: Workshop Reports
        url: /workshop/reports
        key: WorkshopReports
        fns:
          '''
return {
  enabled: true
};
'''
        props:
          '''
return {
  isNoPermissionCheck: true
};
'''
      }
    }
    {
      id: "9"
      L: PageLayout
      P: {
        displayOrder: 1
        componentName: WorkshopLayout
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        key: reports_shell
        componentName: Html
        props:
          '''
return {
  as: "div",
  onMount: () => {
    args.fns.loadCharts();
  }
};
'''
        css:
          '''
return `._id {
  padding: 1rem;
  max-width: 1200px;
  margin: 0 auto;
  min-height: 60vh;
}`;
'''
        fns:
          '''
const [rangePreset, setRangePreset] = args.createSignal("30d");
const [chartsBundle, setChartsBundle] = args.createSignal(null);
const [loading, setLoading] = args.createSignal(false);

const loadCharts = async (presetOverride) => {
  const preset = presetOverride != null ? presetOverride : rangePreset();
  setLoading(true);
  try {
    const raw = await args.executeNamedServerFunction({
      functionName: "getConfigurableGraphData",
      contextData: {
        rangePreset: preset,
        graphKeys: "all",
        settingKey: "WorkshopReports_charts_default",
        enableUserScoping: true,
        operation: "data"
      }
    });
    if (raw?.error) {
      setChartsBundle(null);
      args.showErrorToast(typeof raw.error === "string" ? raw.error : "Failed to load workshop reports");
      return;
    }
    const result = raw?.result != null ? raw.result : raw;
    if (result?.success && result?.data?.charts) {
      setChartsBundle(result.data.charts);
    } else {
      setChartsBundle(null);
      args.showErrorToast(result?.message || "Failed to load workshop reports");
    }
  } catch (error) {
    setChartsBundle(null);
    args.showErrorToast(error?.message || "Failed to load workshop reports");
  } finally {
    setLoading(false);
  }
};

const chartEntry = (key) => {
  const b = chartsBundle();
  return b?.[key] || null;
};

const setRangeAndLoad = (preset) => {
  setRangePreset(preset);
  loadCharts(preset);
};

const tabStyle = (preset) => {
  const active = rangePreset() === preset;
  return {
    padding: "0.4rem 0.75rem",
    "border-radius": "0.375rem",
    border: active
      ? `1px solid ${args.theme.var.color.primary}`
      : `1px solid ${args.theme.var.color.border_light_200}`,
    background: active
      ? args.theme.var.color.background_light_200
      : args.theme.var.color.background,
    color: args.theme.var.color.text,
    cursor: "pointer"
  };
};

return {
  rangePreset,
  setRangePreset,
  chartsBundle,
  loading,
  loadCharts,
  chartEntry,
  setRangeAndLoad,
  tabStyle
};
'''
      }
    }
    {
      id: "h1"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "h1",
  text: "Workshop reports",
  style: { margin: "0 0 0.5rem 0", "font-size": "1.5rem", "font-weight": "700", color: args.theme.var.color.text }
};
'''
      }
    }
    {
