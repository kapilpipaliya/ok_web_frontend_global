  textType: "markdown",
  text: `- Schedule appointments and assign bays and technicians.
- Track repair orders from diagnosis through billing.
- Manage parts stock and reorder levels.
- Create invoices and record payments with clear status.`
};'''
        css:
          '''return `._id.workshop-marketing-features {
  margin: 0;
  line-height: 1.65;
  color: ${args.theme.var.color.text};
}
._id.workshop-marketing-features ul {
  margin: 0;
  padding-left: 1.25rem;
}`;'''
