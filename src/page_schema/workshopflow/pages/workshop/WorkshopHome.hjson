  color: ${args.theme.var.color.text};
  font-size: 0.9rem;
  line-height: 1.5;
}
._id.workshop-step-card p {
  margin: 0 0 0.35rem 0;
}
._id.workshop-step-card p:last-child {
  margin-bottom: 0;
}`;'''
