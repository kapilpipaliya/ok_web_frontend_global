        componentName: Html
        key: home_flow_support
        props:
          '''return {
  as: "div",
  class: "workshop-flowchart-support"
};'''
        css:
          '''return `._id.workshop-flowchart-support {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  justify-content: center;
  gap: 0.75rem;
  margin: 0 0 1rem;
  padding: 0.75rem;
  border-radius: 0.5rem;
  border: 1px dashed ${args.theme.var.color.border_light_300};
  background: ${args.theme.var.color.background_light_100};
}
._id .workshop-flowchart-support-title {
  width: 100%;
  text-align: center;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: ${args.theme.var.color.text_light_500};
  margin-bottom: 0.25rem;
}
._id .workshop-flowchart-pill {
  flex: 1 1 8rem;
  max-width: 14rem;
  padding: 0.5rem 0.65rem;
  border-radius: 0.375rem;
  font-size: 0.8125rem;
  line-height: 1.4;
  color: ${args.theme.var.color.text};
  background: ${args.theme.var.color.background};
  border: 1px solid ${args.theme.var.color.border_light_200};
  text-align: center;
}`;'''
