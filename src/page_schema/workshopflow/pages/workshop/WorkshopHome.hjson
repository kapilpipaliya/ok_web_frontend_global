    {
      id: "12"
      L: Attr
      P: {
        displayOrder: 7
        componentName: Html
        key: home_flowchart_track
        props:
          '''return {
  as: "div",
  class: "workshop-flowchart-track"
};'''
        css:
          '''return [
  `._id.workshop-flowchart-track {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.2rem;
    margin: 0 0 0.75rem;
    padding: 1rem 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid ${args.theme.var.color.border_light_200};
    background: ${args.theme.var.color.background_light_100};
  }`,
  `.workshop-flowchart-step {
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid ${args.theme.var.color.border_light_300};
    background: ${args.theme.var.color.background};
    font-weight: 600;
    font-size: 0.8125rem;
    color: ${args.theme.var.color.text};
    text-align: center;
    min-width: 5.5rem;
  }`,
  `.workshop-flowchart-arrow {
    color: ${args.theme.var.color.text_light_500};
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1;
    padding: 0 0.1rem;
    user-select: none;
  }`,
  `@media (max-width: 640px) {
    ._id.workshop-flowchart-track {
      flex-direction: column;
    }
    .workshop-flowchart-arrow {
      transform: rotate(90deg);
      padding: 0.15rem 0;
    }
  }`
];'''
      }
    }
