  gap: 0.75rem;
  margin-bottom: 2rem;
}`;'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: home_btn_dashboard
        props:
          '''return {
  as: "a",
  href: "/workshop/dashboard",
  text: "Open app",
  class: "workshop-btn-primary",
  onClick: (e) => { e.preventDefault(); args.navigate("/workshop/dashboard"); }
};'''
        css:
          '''return `._id.workshop-btn-primary {
  display: inline-block;
  padding: 0.625rem 1.125rem;
  border-radius: 0.5rem;
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
}`;'''
      }
    }
