{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        key: WorkshopHome
        title: Workshopflow
        url: /workshop
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: PageLayout
      P: {
        displayOrder: 1
        componentName: WorkshopLayout
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: home_root
        props:
          '''return {
  as: "div",
  class: "workshop-marketing-root"
};'''
        css:
          '''return `._id.workshop-marketing-root {
  max-width: 52rem;
  margin: 0 auto;
  padding: 1.5rem 1rem 3rem;
}`;'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: home_hero_title
        props:
          '''return {
  as: "h1",
  text: "Workshopflow",
  class: "workshop-marketing-title"
};'''
        css:
          '''return `._id.workshop-marketing-title {
  font-size: clamp(1.75rem, 4vw, 2.25rem);
  font-weight: 700;
  color: ${args.theme.var.color.text};
  margin: 0 0 0.75rem;
}`;'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        key: home_hero_sub
        props:
          '''return {
  as: "p",
  text: "Run your car workshop from one place: scheduling, repairs, parts inventory, billing, and payments.",
  class: "workshop-marketing-lead"
};'''
        css:
          '''return `._id.workshop-marketing-lead {
  font-size: 1.0625rem;
  line-height: 1.55;
  color: ${args.theme.var.color.text_light_500};
  margin: 0 0 1.5rem;
}`;'''
      }
    }
