{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        key: WorkshopDocsRepairs
        title: Repairs — Workshopflow help
        url: /workshop/docs/repairs
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: PageLayout
      P: {
        displayOrder: 1
        componentName: WorkshopLayout
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return { as: "div", class: "workshop-doc-root" };'''
        css:
          '''return `._id.workshop-doc-root { max-width: 48rem; margin: 0 auto; padding: 1rem 1rem 2.5rem; }`;'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return { as: "h1", text: "Repair orders", class: "workshop-doc-h1" };'''
        css:
          '''return `._id.workshop-doc-h1 { font-size: 1.5rem; font-weight: 700; margin: 0 0 0.75rem; color: ${t.var.color.text}; }`;'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "a",
  href: "/workshop/docs",
  text: "Back to user guide",
  class: "workshop-doc-back",
  onClick: (e) => { e.preventDefault(); _.navigate("/workshop/docs"); }
};'''
        css:
          '''return `._id.workshop-doc-back { display: inline-block; margin-bottom: 1rem; color: ${t.var.color.primary}; font-weight: 600; text-decoration: none; cursor: pointer; }`;'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        props:
          '''return {
  as: "p",
  class: "workshop-doc-body",
  text: "Repair orders track work in the bay. Repair number is unique. Move status forward: Open, Diagnosing, Waiting Parts, Ready For Billing, Closed. Invalid jumps are blocked. Ready For Billing requires labor hours and a positive cost estimate or actual. Closed requires a linked invoice."
};'''
        css:
          '''return `._id.workshop-doc-body { margin: 0 0 1rem; line-height: 1.6; color: ${t.var.color.text}; }`;'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 4
        componentName: Html
        props:
          '''return {
  as: "h2",
  text: "Form fields",
  class: "workshop-doc-h2"
};'''
        css:
          '''return `._id.workshop-doc-h2 { font-size: 1.125rem; font-weight: 700; margin: 1rem 0 0.5rem; color: ${t.var.color.text}; }`;'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        displayOrder: 5
        componentName: Html
        props:
          '''return {
  as: "div",
  class: "workshop-doc-body workshop-doc-table",
  textType: "markdown",
  text: `| Field | What to enter | Example |
| --- | --- | --- |
| Repair # | Unique repair number | RO-24019 |
| Appointment | Link source appointment (optional) | AP-10045 (select) |
| Status | Repair stage | Diagnosing |
| Technician | Assigned mechanic (optional) | Alex (select) |
| Customer | Linked customer (required) | Maria Gomez (select) |
| Vehicle Plate | Vehicle plate | ABC-1234 |
| Diagnosis | Findings after inspection | Front pads worn out |
| Parts Used | JSON list of parts and qty | \`[{"partNo":"BP-01","qty":1}]\` |
| Labor Hours | Total labor time | 1.5 |
| Estimated Cost | Planned total | 150.00 |
| Actual Cost | Final total | 165.00 |
| Completed At | Completion date | 2026-04-05 |`
};'''
        css:
          '''return `._id.workshop-doc-body { margin: 0; line-height: 1.6; color: ${t.var.color.text}; }
._id.workshop-doc-table {
  margin: 0;
  background: ${t.var.color.background_light_100};
  border: 1px solid ${t.var.color.border_light_200};
  border-radius: 0.5rem;
  padding: 0.75rem;
}
._id.workshop-doc-table table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.82rem;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
}
._id.workshop-doc-table th,
._id.workshop-doc-table td {
  border: 1px solid ${t.var.color.border_light_200};
  padding: 0.35rem 0.5rem;
  text-align: left;
  vertical-align: top;
}
._id.workshop-doc-table th {
  background: ${t.var.color.background_light_200};
  font-weight: 600;
}`;'''
      }
    }
  ]
  edges: [
    { id: "e1", T: "PageLayout", S: "1", E: "2" }
    { id: "e2", T: "Attr", S: "1", E: "3" }
    { id: "e3", T: "Attr", S: "3", E: "4" }
    { id: "e4", T: "Attr", S: "3", E: "5" }
    { id: "e5", T: "Attr", S: "3", E: "6" }
    { id: "e6", T: "Attr", S: "3", E: "7" }
    { id: "e7", T: "Attr", S: "3", E: "8" }
  ]
}
