{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        key: WorkshopDocsIndex
        title: Workshopflow User Guide
        url: /workshop/docs
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: PageLayout
      P: {
        displayOrder: 1
        componentName: WorkshopLayout
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: docs_index_root
        props:
          '''return { as: "div", class: "workshop-doc-root" };'''
        css:
          '''return `._id.workshop-doc-root { max-width: 48rem; margin: 0 auto; padding: 1rem 1rem 2.5rem; }`;'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "h1",
  text: "User guide",
  class: "workshop-doc-h1"
};'''
        css:
          '''return `._id.workshop-doc-h1 { font-size: 1.5rem; font-weight: 700; margin: 0 0 0.5rem; color: ${args.theme.var.color.text}; }`;'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "p",
  text: "Choose a topic below. Each page explains the form fields and how to use that part of the app.",
  class: "workshop-doc-p"
};'''
        css:
          '''return `._id.workshop-doc-p { margin: 0 0 1rem; line-height: 1.55; color: ${args.theme.var.color.text_light_500}; }`;'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        key: docs_links
        props:
          '''return { as: "div", class: "workshop-doc-links" };'''
        css:
          '''return `._id.workshop-doc-links { display: flex; flex-direction: column; gap: 0.5rem; }`;'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "a",
  href: "/workshop/docs/getting-started",
  text: "Getting started",
  class: "workshop-doc-link",
  onClick: (e) => { e.preventDefault(); args.navigate("/workshop/docs/getting-started"); }
};'''
        css:
          '''return `._id.workshop-doc-link { color: ${args.theme.var.color.primary}; font-weight: 600; text-decoration: none; cursor: pointer; }`;'''
