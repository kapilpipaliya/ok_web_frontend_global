{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        key: WorkshopDocsIndex
        title: Workshopflow User Guide
        url: /workshop/docs
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: PageLayout
      P: {
        displayOrder: 1
        componentName: WorkshopLayout
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: docs_index_root
        props:
          '''return { as: "div", class: "workshop-doc-root" };'''
        css:
          '''return `._id.workshop-doc-root { max-width: 48rem; margin: 0 auto; padding: 1rem 1rem 2.5rem; }`;'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "h1",
  text: "User guide",
  class: "workshop-doc-h1"
};'''
        css:
          '''return `._id.workshop-doc-h1 { font-size: 1.5rem; font-weight: 700; margin: 0 0 0.5rem; color: ${args.theme.var.color.text}; }`;'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "p",
          text: "Choose a topic below. Each page explains the form fields and how to use that part of the app. Hover the help icon beside a topic for a short summary (only one tip stays open at a time).",
  class: "workshop-doc-p"
};'''
        css:
          '''return `._id.workshop-doc-p { margin: 0 0 1rem; line-height: 1.55; color: ${args.theme.var.color.muted}; }`;'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        key: docs_links_wrap
        props:
          '''return { as: "div", class: "workshop-doc-links" };'''
        css:
          '''return `._id.workshop-doc-links {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}`;'''
      }
    }
    {
      id: "6a"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        key: docs_topic_loop
        props:
          '''return {
  as: "div",
  class: "workshop-doc-link-row",
  contextName: "docTopic",
  loop: true,
  data: [
    {
      href: "/workshop/docs/getting-started",
      label: "Getting started",
      helpTitle: "Getting started",
      helpBody: "Sign in to open Workshop. The sidebar lists every module. Tables support search, sort, filters, and Add to create rows. Click a row to view or edit. Resize or collapse the sidebar from the header controls."
    },
    {
      href: "/workshop/docs/dashboard",
      label: "Dashboard",
      helpTitle: "Dashboard",
      helpBody: "High-level overview and KPIs for the shop. Use it as a launch point into appointments, repairs, and billing. Charts on Reports use workshop data for the selected time range."
    },
    {
      href: "/workshop/docs/appointments",
      label: "Appointments",
      helpTitle: "Appointments",
      helpBody: "Book visits before they become repair orders. Appointment numbers are unique (reference sequence in Settings). Customer, vehicle, bay, service, and technician links are stored as graph edges, not plain ID fields. Status follows your appointment picklist."
    },
    {
      href: "/workshop/docs/repairs",
      label: "Repairs",
      helpTitle: "Repair orders",
      helpBody: "Track jobs from open through closed. Link an optional appointment, customer, and vehicle. Parts lines can tie to inventory with quantities and pricing. Hooks can update related records when status changes."
    },
    {
      href: "/workshop/docs/inventory",
      label: "Inventory",
      helpTitle: "Inventory",
      helpBody: "Parts catalog with stock, reorder level, costs, and sell price. Categories use the same sidebar folder model as other modules. Supplier is an edge-linked directory record."
    },
    {
      href: "/workshop/docs/billing",
      label: "Billing (invoices)",
      helpTitle: "Billing",
      helpBody: "Create invoices linked to a repair order. Lines support part, labor, and fee types; part lines can reference inventory. Subtotal, tax, discount, and total drive payment status."
    },
    {
      href: "/workshop/docs/customers",
      label: "Customers",
      helpTitle: "Customers",
      helpBody: "Customer directory with unique customer numbers (reference sequence). Used by appointments, repairs, and invoices. Categories organize records in the sidebar."
    },
    {
      href: "/workshop/docs/technicians",
      label: "Technicians",
      helpTitle: "Technicians",
      helpBody: "Technician roster with optional primary skill link, hourly rate, and status from your technician picklist. Assign technicians on appointments and repairs."
    },
    {
      href: "/workshop/docs/services",
      label: "Services",
      helpTitle: "Services",
      helpBody: "Service catalog for menus and scheduling: code, name, duration, base price, and category. Hooks can keep display fields in sync after saves."
    },
    {
      href: "/workshop/docs/payments",
      label: "Payments",
      helpTitle: "Payments",
      helpBody: "Record payments against invoices. Amount, method, and date post to the ledger; hooks can roll up invoice payment status (unpaid, partial, paid)."
    }
   ]
};'''
        css:
          '''return `._id.workshop-doc-link-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 0.75rem;
  width: 100%;
  box-sizing: border-box;
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  border: 1px solid ${args.theme.var.color.border_light_200};
  background: ${args.theme.var.color.background_light_100};
}`;'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const topic = args.contextData.docTopic;
const href = topic?.href || "/";
return {
  as: "a",
  href,
  text: topic?.label || "",
  class: "workshop-doc-link",
  onClick: (e) => { e.preventDefault(); args.navigate(href); }
};
'''
        css:
          '''return `._id.workshop-doc-link {
  min-width: 0;
  color: ${args.theme.var.color.primary};
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  line-height: 1.4;
  word-break: break-word;
}`;'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        displayOrder: 2
        componentName: WorkshopDocHelpPopover
        props:
          '''
const topic = args.contextData.docTopic;
return {
  helpTitle: topic?.helpTitle || topic?.label || "Help",
  helpBody: topic?.helpBody || "",
  placement: "bottom-start",
  tooltipGroup: "workshop-doc-help"
};
'''
      }
    }
  ]
  edges: [
    { id: "e1", T: "PageLayout", S: "1", E: "2" }
    { id: "e2", T: "Attr", S: "1", E: "3" }
    { id: "e3", T: "Attr", S: "3", E: "4" }
    { id: "e4", T: "Attr", S: "3", E: "5" }
    { id: "e5", T: "Attr", S: "3", E: "6" }
    { id: "e5a", T: "Attr", S: "6", E: "6a" }
    { id: "e6", T: "Attr", S: "6a", E: "7" }
    { id: "e7", T: "Attr", S: "6a", E: "8" }
  ]
}
