{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        key: WorkshopDocsDashboard
        title: Dashboard — Workshopflow help
        url: /workshop/docs/dashboard
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: PageLayout
      P: {
        displayOrder: 1
        componentName: WorkshopLayout
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return { as: "div", class: "workshop-doc-root" };'''
        css:
          '''return `._id.workshop-doc-root { max-width: 48rem; margin: 0 auto; padding: 1rem 1rem 2.5rem; }`;'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return { as: "h1", text: "Dashboard", class: "workshop-doc-h1" };'''
        css:
          '''return `._id.workshop-doc-h1 { font-size: 1.5rem; font-weight: 700; margin: 0 0 0.75rem; color: ${t.var.color.text}; }`;'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''return {
  as: "a",
  href: "/workshop/docs",
  text: "Back to user guide",
  class: "workshop-doc-back",
  onClick: (e) => { e.preventDefault(); _.navigate("/workshop/docs"); }
};'''
        css:
          '''return `._id.workshop-doc-back { display: inline-block; margin-bottom: 1rem; color: ${t.var.color.primary}; font-weight: 600; text-decoration: none; cursor: pointer; }`;'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 3
        componentName: Html
        props:
          '''return {
  as: "p",
  class: "workshop-doc-body",
  text: "The Dashboard shows four KPI cards that load when you open the page. Scheduled or in-progress appointments: counts WorkshopAppointment rows in active statuses. Open repair orders: repairs not yet closed. Low stock inventory: parts at or below reorder level. Invoices not fully paid: invoices where payment is not complete. Use the sidebar to open each module for detail work."
};'''
        css:
          '''return `._id.workshop-doc-body { margin: 0; line-height: 1.6; color: ${t.var.color.text}; }`;'''
      }
    }
  ]
  edges: [
    { id: "e1", T: "PageLayout", S: "1", E: "2" }
    { id: "e2", T: "Attr", S: "1", E: "3" }
    { id: "e3", T: "Attr", S: "3", E: "4" }
    { id: "e4", T: "Attr", S: "3", E: "5" }
    { id: "e5", T: "Attr", S: "3", E: "6" }
  ]
}
