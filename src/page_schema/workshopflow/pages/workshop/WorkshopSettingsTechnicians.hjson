{
  vertexes: [
    {
      id: "1"
      L: Role
      P: {
        key: Admin
      }
    }
    {
      id: "2"
      L: RolePage
      P: {
        access: FULL
      }
    }
    {
      id: "3"
      L: Page
      P: {
        signinRequired: true
        fns:
          '''
return {
  enabled: true,
  executeYTOFunction: (functionName, contextData) =>
    s({
      functionName,
      contextData: contextData || {}
    })
};
'''
        title: Technicians settings
        url: /workshop/settings/technicians
        key: WorkshopSettingsTechnicians
      }
    }
    {
      id: "4"
      L: PageLayout
      P: {
        displayOrder: 1
        componentName: WorkshopLayout
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        displayOrder: 1
        componentName: WorkshopSettingsPicklistModulePage
        props:
          '''
return {
  picklistKey: "technician_status",
  pageTitle: "Technicians",
  defaultTitle: "Technician status",
  description:
    "Technician availability (active, on leave, inactive). Used by the technicians form and table badges."
};
'''
      }
    }
  ]
  edges: [
    { id: "wst1", T: "RolePage", S: "1", E: "2" }
    { id: "wst2", T: "RolePagePage", S: "2", E: "3" }
    { id: "wst3", T: "PageLayout", S: "3", E: "4" }
    { id: "wst4", T: "Attr", S: "3", E: "5" }
  ]
}
