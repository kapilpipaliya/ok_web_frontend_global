'''
        title: Workshop Dashboard
        url: /workshop/dashboard
        key: WorkshopDashboard
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''
return `._id {
  display: grid;
  grid-template-columns: repeat(2, minmax(14rem, 1fr));
  gap: 1rem;
  padding: 1rem;
}

@media (max-width: 768px) {
  ._id {
    grid-template-columns: 1fr;
  }
}`;
'''
        displayOrder: 1
        fns:
          '''
const [stats, setStats] = _.createSignal({
  appointments: 0,
  openRepairs: 0,
  lowStockItems: 0,
  unpaidInvoices: 0
});
const [loading, setLoading] = _.createSignal(false);

const loadStats = async () => {
  setLoading(true);
  try {
    const result = await s({
      functionName: "getWorkshopDashboardStats",
      contextData: {}
    });
    if (result?.success && result?.data) {
      setStats(result.data);
    }
  } catch (error) {
    _.showErrorToast(error?.message || "Failed to load workshop dashboard stats");
  } finally {
    setLoading(false);
  }
};

return {
  stats,
  loading,
  loadStats
};
'''
        componentName: Html
        key: dashboard_container
        props:
          '''
return {
  as: "div",
  onMount: () => {
    f.loadStats();
  }
};
'''
      }
    }
