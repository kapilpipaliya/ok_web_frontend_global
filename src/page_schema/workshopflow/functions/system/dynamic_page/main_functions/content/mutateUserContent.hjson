{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Creates, updates, or deletes user content. Works with any tableVertexLabel.
        body:
          '''
// Get current authenticated user from session
const actualUser = await args.getUserFromSession();
if (!actualUser) {
  return {
    success: false,
    message: "User session not found. Please log in and try again."
  };
}

// Get effective user (handles admin impersonation)
const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

// Extract parameters
// Format: data is an object with { vertex, relationships, nestedLineSync? }
// nestedLineSync entries: childLabel, parentToChildRelationshipType, parentElementIdPropOnChild, rows, deletedLineIds,
// nestedLineItemsSyncRules, lineTargetLinks (array; each entry: relationshipType, targetLabel, rowIdKeys, requiredMode?, requiredWhenField?, requiredWhenValues?).
const inputData = args.contextData.data || {};
const vertex = inputData.vertex;
const relationships = inputData.relationships || {};
const nestedLineSync = inputData.nestedLineSync || {};
const {
  tableVertexLabel,
  operation,
  elementId,
  uniqueKeys = [],
  enableUserScoping,
  hooks,
  nestedLinePropertyStripKeys = [],
  graphSliceOutgoingRelationshipTypes,
  graphSliceIncomingRelationshipTypes
} = args.contextData;

const normalizeRelTypeList = (x) =>
  Array.isArray(x)
    ? x.map((t) => (t != null ? String(t).trim() : "")).filter((t) => t !== "")
    : [];
const graphSliceOutgoingNormalized = normalizeRelTypeList(graphSliceOutgoingRelationshipTypes);
const graphSliceIncomingNormalized = normalizeRelTypeList(graphSliceIncomingRelationshipTypes);
const sliceRelOut = graphSliceOutgoingNormalized;
const sliceRelIn = graphSliceIncomingNormalized;

const nestedLineStripFromConfig = Array.isArray(nestedLinePropertyStripKeys)
  ? nestedLinePropertyStripKeys.map((k) => String(k))
  : [];
const NESTED_LINE_STRIP_KEYS = new Set([...Object.keys(nestedLineSync), ...nestedLineStripFromConfig]);

const getTargetVertexIdFromLineRow = (lineRow, rowIdKeys) => {
  if (!Array.isArray(rowIdKeys) || rowIdKeys.length === 0) return null;
  for (let keyIndex = 0; keyIndex < rowIdKeys.length; keyIndex++) {
    const propertyKey = rowIdKeys[keyIndex];
    const rawValue = lineRow[propertyKey];
    if (rawValue != null && !Array.isArray(rawValue) && String(rawValue).trim() !== "")
      return String(rawValue).trim();
  }
  return null;
};

const getTargetVertexIdsFromLineRow = (lineRow, link) => {
  if (!lineRow || !link) return [];
  if (link.multiple === true) {
    const rowIdKeys = link.rowIdKeys || [];
    if (rowIdKeys.length === 0) return [];
    const primaryRowIdKey = rowIdKeys[0];
    const rawIdsValue = lineRow[primaryRowIdKey];
    if (Array.isArray(rawIdsValue)) {
      return rawIdsValue
        .map((elementId) => String(elementId).trim())
        .filter((elementId) => elementId !== "");
    }
    if (rawIdsValue != null && String(rawIdsValue).trim() !== "") {
      const trimmedString = String(rawIdsValue).trim();
      try {
        const parsed = JSON.parse(trimmedString);
        if (Array.isArray(parsed)) {
          return parsed
            .map((elementId) => String(elementId).trim())
            .filter((elementId) => elementId !== "");
        }
      } catch (_ignoredInvalidJson) {}
      return [trimmedString];
    }
    return [];
  }
  const one = getTargetVertexIdFromLineRow(lineRow, link.rowIdKeys || []);
  return one ? [one] : [];
};

const normalizeLineTargetLinks = (spec) => {
  const rawLinks = spec.lineTargetLinks;
  if (!Array.isArray(rawLinks) || rawLinks.length === 0) return [];
  return rawLinks
    .map((link) => {
      if (!Array.isArray(link.rowIdKeys) || link.rowIdKeys.length === 0) return null;
      const rowIdKeys = link.rowIdKeys.map((rowIdKey) => String(rowIdKey));
      const relationshipType = link.relationshipType != null ? String(link.relationshipType).trim() : "";
      const targetLabel = link.targetLabel != null ? String(link.targetLabel).trim() : "";
      if (!relationshipType || !targetLabel) return null;
      return {
        relationshipType,
        targetLabel,
        rowIdKeys,
        multiple: link.multiple === true,
        requiredMode: link.requiredMode != null ? String(link.requiredMode) : "never",
        requiredWhenField: link.requiredWhenField != null ? link.requiredWhenField : undefined,
        requiredWhenValues: link.requiredWhenValues != null ? link.requiredWhenValues : undefined,
      };
    })
    .filter((normalizedLink) => normalizedLink != null);
};

const lineTargetLinkRowContextApplies = (lineRow, link) => {
  const mode = link.requiredMode || "never";
  if (mode !== "when") return true;
  const whenFieldKey = link.requiredWhenField;
  const whenValues = Array.isArray(link.requiredWhenValues) ? link.requiredWhenValues : [];
  if (whenFieldKey == null || String(whenFieldKey).trim() === "" || whenValues.length === 0) {
    return true;
  }
  const fieldRawValue = lineRow[whenFieldKey];
  const normalizedFieldValue = String(fieldRawValue ?? "").trim().toLowerCase();
  return whenValues.some(
    (allowedValue) => String(allowedValue).trim().toLowerCase() === normalizedFieldValue,
  );
};

const rowPassesNestedLineSyncRules = (lineRow, nestedLineItemsSyncRules, lineTargetLinks) => {
  if (!nestedLineItemsSyncRules || typeof nestedLineItemsSyncRules !== "object") {
    nestedLineItemsSyncRules = {};
  }

  const quantityFieldKey =
    nestedLineItemsSyncRules.quantityFieldKey != null
      ? String(nestedLineItemsSyncRules.quantityFieldKey)
      : null;
  const quantityRule = nestedLineItemsSyncRules.quantityRule;
  if (quantityFieldKey && quantityRule && typeof quantityRule === "object") {
    const quantityValue = Number(lineRow[quantityFieldKey]);
    const compareOp = quantityRule.op;
    const compareTo = Number(quantityRule.value);
    if (compareOp === ">") {
      if (!Number.isFinite(quantityValue) || !(quantityValue > compareTo)) return false;
    } else if (compareOp === ">=") {
      if (!Number.isFinite(quantityValue) || !(quantityValue >= compareTo)) return false;
    } else if (compareOp === "<") {
      if (!Number.isFinite(quantityValue) || !(quantityValue < compareTo)) return false;
    } else if (compareOp === "<=") {
      if (!Number.isFinite(quantityValue) || !(quantityValue <= compareTo)) return false;
    } else if (compareOp === "==") {
      if (!Number.isFinite(quantityValue) || quantityValue !== compareTo) return false;
    }
  }

  const requiredFieldKeys = Array.isArray(nestedLineItemsSyncRules.rowRequiredFields)
    ? nestedLineItemsSyncRules.rowRequiredFields
    : [];
  for (let fieldIndex = 0; fieldIndex < requiredFieldKeys.length; fieldIndex++) {
    const requiredKey = requiredFieldKeys[fieldIndex];
    if (String(lineRow[requiredKey] ?? "").trim() === "") return false;
  }

  const links = Array.isArray(lineTargetLinks) ? lineTargetLinks : [];
  for (let linkIndex = 0; linkIndex < links.length; linkIndex++) {
    const link = links[linkIndex];
    const mode = link.requiredMode || "never";
    if (link.multiple === true) {
      const ids = lineTargetLinkRowContextApplies(lineRow, link)
        ? getTargetVertexIdsFromLineRow(lineRow, link)
        : [];
      if (mode === "always" && ids.length === 0) return false;
      if (mode === "when") {
        const whenFieldKey = link.requiredWhenField;
        const whenValues = Array.isArray(link.requiredWhenValues) ? link.requiredWhenValues : [];
        if (whenFieldKey != null && String(whenFieldKey).trim() !== "" && whenValues.length > 0) {
          const fieldRawValue = lineRow[whenFieldKey];
          const normalizedFieldValue = String(fieldRawValue ?? "").trim().toLowerCase();
          const fieldMatchesWhen = whenValues.some(
            (allowedValue) => String(allowedValue).trim().toLowerCase() === normalizedFieldValue,
          );
          if (fieldMatchesWhen && ids.length === 0) return false;
        }
      }
      continue;
    }
    const targetVertexId = getTargetVertexIdFromLineRow(lineRow, link.rowIdKeys);
    if (mode === "always") {
      if (!targetVertexId) return false;
    } else if (mode === "when") {
      const whenFieldKey = link.requiredWhenField;
      const whenValues = Array.isArray(link.requiredWhenValues) ? link.requiredWhenValues : [];
      if (whenFieldKey != null && String(whenFieldKey).trim() !== "" && whenValues.length > 0) {
        const fieldRawValue = lineRow[whenFieldKey];
        const normalizedFieldValue = String(fieldRawValue ?? "").trim().toLowerCase();
        const fieldMatchesWhen = whenValues.some(
          (allowedValue) => String(allowedValue).trim().toLowerCase() === normalizedFieldValue,
        );
        if (fieldMatchesWhen && !targetVertexId) return false;
      }
    }
  }

  return true;
};

const buildChildLineProps = (lineRow, parentElementIdPropOnChild, parentElementId, lineTargetLinks) => {
  const propertyKeysToSkip = new Set(["id", "_key", "_draft"]);
  const links = Array.isArray(lineTargetLinks) ? lineTargetLinks : [];
  for (let skipIndex = 0; skipIndex < links.length; skipIndex++) {
    const rowIdKeys = links[skipIndex].rowIdKeys || [];
    for (let keyIndex = 0; keyIndex < rowIdKeys.length; keyIndex++) {
      propertyKeysToSkip.add(String(rowIdKeys[keyIndex]));
    }
  }
  const lineVertexProps = {};
  for (const [propertyKey, propertyValue] of Object.entries(lineRow || {})) {
    if (propertyKeysToSkip.has(propertyKey)) continue;
    if (propertyValue === undefined || propertyValue === null || propertyValue === "") continue;
    lineVertexProps[propertyKey] = propertyValue;
  }
  lineVertexProps[parentElementIdPropOnChild] = parentElementId;
  return lineVertexProps;
};

const stripRelationshipFieldKeysFromProps = (props, relationships) => {
  if (!props || typeof props !== "object" || !relationships || typeof relationships !== "object")
    return;
  for (const fieldKey of Object.keys(relationships)) {
    delete props[fieldKey];
  }
};

/** Deletes relationships by Neo4j element id and appends those ids to removedEdgeIds for the client graph merge. */
const deleteTrackedRelationships = async (session, removedEdgeIds, relationshipElementIds) => {
  if (!Array.isArray(relationshipElementIds) || relationshipElementIds.length === 0) return;
  if (Array.isArray(removedEdgeIds)) {
    for (let i = 0; i < relationshipElementIds.length; i++) {
      removedEdgeIds.push(String(relationshipElementIds[i]));
    }
  }
  await session.run(
    `MATCH ()-[relationship]-()
     WHERE elementId(relationship) IN $relationshipElementIds
     DELETE relationship`,
    { relationshipElementIds }
  );
};

const syncNestedLineCollections = async (session, params) => {
  const {
    parentElementId,
    parentLabel,
    nestedLineSync: syncMap,
    enableUserScoping,
    userUuid,
    userRelationshipType,
    nestedLineRemovedEdgeIds
  } = params;
  if (!syncMap || typeof syncMap !== "object") return;
  if (!parentElementId) return;

  for (const [, spec] of Object.entries(syncMap)) {
    if (!spec || typeof spec !== "object") continue;
    const childLabel = spec.childLabel;
    const parentToChildRelationshipType = spec.parentToChildRelationshipType;
    const parentElementIdPropOnChild = spec.parentElementIdPropOnChild;
    const nestedLineItemsSyncRules = spec.nestedLineItemsSyncRules;
    const lineTargetLinks = normalizeLineTargetLinks(spec);
    const rows = Array.isArray(spec.rows) ? spec.rows : [];
    const deletedLineIds = Array.isArray(spec.deletedLineIds) ? spec.deletedLineIds : [];
    if (!childLabel || !parentToChildRelationshipType || !parentElementIdPropOnChild) continue;

    if (enableUserScoping) {
      const ownershipCheck = await session.run(
        `MATCH (u:User {uuid: $uuid})-[:${userRelationshipType}]->(p:${parentLabel})
         WHERE elementId(p) = $pid
         RETURN p LIMIT 1`,
        { uuid: userUuid, pid: parentElementId }
      );
      if (ownershipCheck.records.length === 0) continue;
    }

    for (let deleteIndex = 0; deleteIndex < deletedLineIds.length; deleteIndex++) {
      const lineElementId = deletedLineIds[deleteIndex];
      if (lineElementId == null || lineElementId === "") continue;
      await session.run(
        `MATCH (p:${parentLabel})-[:${parentToChildRelationshipType}]->(line:${childLabel})
         WHERE elementId(p) = $pid AND elementId(line) = $lid
         DETACH DELETE line`,
        { pid: parentElementId, lid: String(lineElementId) }
      );
    }

    for (let rowIndex = 0; rowIndex < rows.length; rowIndex++) {
      const lineRow = rows[rowIndex];
      if (!lineRow || typeof lineRow !== "object") continue;
      if (!rowPassesNestedLineSyncRules(lineRow, nestedLineItemsSyncRules, lineTargetLinks)) continue;

      const existingLineElementId =
        lineRow.id != null && String(lineRow.id).trim() !== "" ? String(lineRow.id).trim() : null;

      let persistedLineElementId = null;

      if (existingLineElementId) {
        const lineVertexProps = buildChildLineProps(
          lineRow,
          parentElementIdPropOnChild,
          parentElementId,
          lineTargetLinks,
        );
        delete lineVertexProps.createdAt;
        const updateResult = await session.run(
          `MATCH (p:${parentLabel})-[:${parentToChildRelationshipType}]->(line:${childLabel})
           WHERE elementId(p) = $pid AND elementId(line) = $lid
           SET line += $props, line.updatedAt = datetime()
           RETURN elementId(line) AS lid`,
          { pid: parentElementId, lid: existingLineElementId, props: lineVertexProps }
        );
        if (updateResult.records.length > 0) {
          persistedLineElementId = existingLineElementId;
        } else {
          const nowIso = new Date().toISOString();
          const createProps = buildChildLineProps(
            lineRow,
            parentElementIdPropOnChild,
            parentElementId,
            lineTargetLinks,
          );
          createProps.createdAt = nowIso;
          createProps.updatedAt = nowIso;
          const createLineResult = await session.run(
            `MATCH (p:${parentLabel})
             WHERE elementId(p) = $pid
             CREATE (line:${childLabel} $props)
             CREATE (p)-[:${parentToChildRelationshipType}]->(line)
             RETURN elementId(line) AS lid`,
            { pid: parentElementId, props: createProps }
          );
          const newLid = createLineResult.records[0]?.get("lid");
          persistedLineElementId = newLid != null ? String(newLid) : null;
        }
      } else {
        const nowIso = new Date().toISOString();
        const lineVertexProps = buildChildLineProps(
          lineRow,
          parentElementIdPropOnChild,
          parentElementId,
          lineTargetLinks,
        );
        lineVertexProps.createdAt = nowIso;
        lineVertexProps.updatedAt = nowIso;
        const createLineResult = await session.run(
          `MATCH (p:${parentLabel})
           WHERE elementId(p) = $pid
           CREATE (line:${childLabel} $props)
           CREATE (p)-[:${parentToChildRelationshipType}]->(line)
           RETURN elementId(line) AS lid`,
          { pid: parentElementId, props: lineVertexProps }
        );
        const newLineElementId = createLineResult.records[0]?.get("lid");
        persistedLineElementId = newLineElementId != null ? String(newLineElementId) : null;
      }

      if (persistedLineElementId && lineTargetLinks.length > 0) {
        const loadRelationshipIdsByTargetElementId = async (lineTargetLink) => {
          const relationshipTypeForLink = lineTargetLink.relationshipType;
          const targetLabelForLink = lineTargetLink.targetLabel;
          const existingRelationshipsResult = await session.run(
            `MATCH (line:${childLabel})-[relationship:${relationshipTypeForLink}]->(target:${targetLabelForLink})
             WHERE elementId(line) = $lineElementId
             RETURN elementId(target) AS targetElementId, elementId(relationship) AS relationshipElementId`,
            { lineElementId: persistedLineElementId }
          );
          const relationshipIdsByTargetElementId = new Map();
          for (
            let recordIndex = 0;
            recordIndex < existingRelationshipsResult.records.length;
            recordIndex++
          ) {
            const targetElementIdRaw =
              existingRelationshipsResult.records[recordIndex].get("targetElementId");
            const relationshipElementIdRaw =
              existingRelationshipsResult.records[recordIndex].get("relationshipElementId");
            if (targetElementIdRaw == null || relationshipElementIdRaw == null) continue;
            const targetElementId = String(targetElementIdRaw);
            const relationshipElementId = String(relationshipElementIdRaw);
            if (!relationshipIdsByTargetElementId.has(targetElementId)) {
              relationshipIdsByTargetElementId.set(targetElementId, []);
            }
            relationshipIdsByTargetElementId.get(targetElementId).push(relationshipElementId);
          }
          return relationshipIdsByTargetElementId;
        };

        for (let linkIndex = 0; linkIndex < lineTargetLinks.length; linkIndex++) {
          const lineTargetLink = lineTargetLinks[linkIndex];
          const relationshipType = lineTargetLink.relationshipType;
          const targetVertexLabel = lineTargetLink.targetLabel;
          const linkContextAppliesToRow = lineTargetLinkRowContextApplies(lineRow, lineTargetLink);
          const desiredTargetIdsFromRow = linkContextAppliesToRow
            ? getTargetVertexIdsFromLineRow(lineRow, lineTargetLink)
            : [];
          const desiredTargetElementIdSet = new Set(
            desiredTargetIdsFromRow
              .map((rawTargetId) => String(rawTargetId))
              .filter((trimmedId) => trimmedId !== ""),
          );
          const relationshipIdsByTargetElementId =
            await loadRelationshipIdsByTargetElementId(lineTargetLink);

          const relationshipElementIdsToRemove = [];
          for (const [targetElementId, idsForTarget] of relationshipIdsByTargetElementId.entries()) {
            if (!desiredTargetElementIdSet.has(targetElementId)) {
              relationshipElementIdsToRemove.push(...idsForTarget);
            }
          }
          await deleteTrackedRelationships(
            session,
            nestedLineRemovedEdgeIds,
            relationshipElementIdsToRemove,
          );

          const targetElementIdsMissingFromGraph = [];
          for (const desiredTargetElementId of desiredTargetElementIdSet) {
            if (!relationshipIdsByTargetElementId.has(desiredTargetElementId)) {
              targetElementIdsMissingFromGraph.push(desiredTargetElementId);
            }
          }
          if (targetElementIdsMissingFromGraph.length > 0) {
            await session.run(
              `MATCH (line:${childLabel})
               WHERE elementId(line) = $lineElementId
               UNWIND $targetElementIds AS targetElementId
               MATCH (targetVertex:${targetVertexLabel})
               WHERE elementId(targetVertex) = targetElementId
               MERGE (line)-[:${relationshipType}]->(targetVertex)`,
              {
                lineElementId: persistedLineElementId,
                targetElementIds: targetElementIdsMissingFromGraph
              }
            );
          }
        }
      }
    }
  }
};

// Extract form data from vertex
if (!vertex || !vertex.P) {
  return {
    success: false,
    message: `${tableVertexLabel || 'Content'} data is required`
  };
}
const formData = vertex.P;

if (!tableVertexLabel || typeof tableVertexLabel !== "string") {
  return {
    success: false,
    message: "tableVertexLabel is required and must be a string"
  };
}

if (!operation || !["create", "update", "delete"].includes(operation)) {
  return {
    success: false,
    message: "Invalid operation. Must be 'create', 'update', or 'delete'"
  };
}

// Determine vertex label and relationship type based on tableVertexLabel
const vertexLabel = tableVertexLabel;
// Relationship type is "User" + vertexLabel (e.g., "UserBook", "UserAudioVideo", "UserCategory")
const relationshipType = `User${vertexLabel}`;

const getGraphPayloadForSave = (nodes, rels, deleted_edges) => ({
  vertexes: nodes || {},
  edges: rels || {},
  deleted_vertexes: [],
  deleted_edges: Array.isArray(deleted_edges) ? deleted_edges : []
});

const buildSavedContentGraphSlice = async (elementId) => {
  if (!elementId) return null;
  const relOut = sliceRelOut;
  const relIn = sliceRelIn;
  const useRelFilter = relOut.length > 0 || relIn.length > 0;
  const sliceContext = { nodes: {}, relationships: {} };

  const outBlock =
    !useRelFilter || relOut.length > 0
      ? !useRelFilter
        ? `OPTIONAL MATCH (c)-[r]->(related)
      OPTIONAL MATCH (related)-[r2]->(related2)`
        : `OPTIONAL MATCH (c)-[r]->(related)
      WHERE type(r) IN $relTypesOut
      OPTIONAL MATCH (related)-[r2]->(related2)
      WHERE type(r2) IN $relTypesOut`
      : "";
  const inBlock =
    !useRelFilter || relIn.length > 0
      ? !useRelFilter
        ? `OPTIONAL MATCH (relatedIn)-[rIn]->(c)
      OPTIONAL MATCH (relatedIn)-[rIn2]->(relatedIn2)`
        : `OPTIONAL MATCH (relatedIn)-[rIn]->(c)
      WHERE type(rIn) IN $relTypesIn
      OPTIONAL MATCH (relatedIn)-[rIn2]->(relatedIn2)
      WHERE type(rIn2) IN $relTypesIn`
      : "";

  const nodeLabels = ["c"];
  const relLabels = [];
  if (outBlock) {
    nodeLabels.push("related", "related2");
    relLabels.push("r", "r2");
  }
  if (inBlock) {
    nodeLabels.push("relatedIn", "relatedIn2");
    relLabels.push("rIn", "rIn2");
  }

  const params = { elementId };
  if (useRelFilter && relOut.length > 0) params.relTypesOut = relOut;
  if (useRelFilter && relIn.length > 0) params.relTypesIn = relIn;

  let q;
  if (!enableUserScoping) {
    q = `
      MATCH (c:${vertexLabel})
      WHERE elementId(c) = $elementId
      ${outBlock}
      ${inBlock}
      RETURN ${[...nodeLabels, ...relLabels].join(", ")}
    `;
  } else {
    params.userUuid = user.P.uuid;
    q = `
      MATCH (u:User {uuid: $userUuid})-[:${relationshipType}]->(c:${vertexLabel})
      WHERE elementId(c) = $elementId
      ${outBlock}
      ${inBlock}
      RETURN ${[...nodeLabels, ...relLabels].join(", ")}
    `;
  }

  const gr = await args.session.run(q, params);
  args.processResult(gr.records, sliceContext, nodeLabels, relLabels);
  const nodes = sliceContext.nodes || {};
  const rels = sliceContext.relationships || {};
  return getGraphPayloadForSave(nodes, rels, []);
};

// Execute before hooks based on operation
if (operation === "create") {
  await args.executeHooks(hooks?.beforeCreate, {
    tableVertexLabel,
    operation,
    elementId,
    data: inputData,
    uniqueKeys,
    enableUserScoping
  });
} else if (operation === "update") {
  await args.executeHooks(hooks?.beforeUpdate, {
    tableVertexLabel,
    operation,
    elementId,
    data: inputData,
    uniqueKeys,
    enableUserScoping
  });
} else if (operation === "delete") {
  await args.executeHooks(hooks?.beforeDelete, {
    tableVertexLabel,
    operation,
    elementId,
    data: inputData,
    uniqueKeys,
    enableUserScoping
  });
}

try {
  if (operation === "create") {
    // Validate unique keys if provided
    if (uniqueKeys && Array.isArray(uniqueKeys) && uniqueKeys.length > 0) {
      // Build WHERE clause for unique key validation
      const uniqueConditions = uniqueKeys.map(key => {
        const value = formData[key];
        if (value === null || value === undefined || value === "") {
          return null; // Skip null/empty values in unique check
        }
        return `c.${key} = $unique_${key}`;
      }).filter(condition => condition !== null);

      if (uniqueConditions.length > 0) {
        // Check for existing records with same unique key values
        let checkQuery;
        let checkParams;
        if (!enableUserScoping) {
          checkQuery = `
            MATCH (c:${vertexLabel})
            WHERE ${uniqueConditions.join(" AND ")}
            RETURN c
            LIMIT 1
          `;
          checkParams = {};
        } else {
          checkQuery = `
            MATCH (u:User {uuid: $userUuid})-[:${relationshipType}]->(c:${vertexLabel})
            WHERE ${uniqueConditions.join(" AND ")}
            RETURN c
            LIMIT 1
          `;
          checkParams = { userUuid: user.P.uuid };
        }
        uniqueKeys.forEach(key => {
          if (formData[key] !== null && formData[key] !== undefined && formData[key] !== "") {
            checkParams[`unique_${key}`] = formData[key];
          }
        });

        const checkResult = await args.session.run(checkQuery, checkParams);
        if (checkResult.records.length > 0) {
          const conflictingKeys = uniqueKeys.filter(key => 
            formData[key] !== null && formData[key] !== undefined && formData[key] !== ""
          );
          return {
            success: false,
            message: `Record with ${conflictingKeys.join(", ")} already exists`
          };
        }
      }
    }

    // Build properties object (exclude id/elementId from formData)
    const { id, elementId: dataElementId, ...dataWithoutId } = formData;
    const properties = {
      ...dataWithoutId,
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString()
    };
    NESTED_LINE_STRIP_KEYS.forEach((k) => {
      delete properties[k];
    });
    stripRelationshipFieldKeysFromProps(properties, relationships);

    // Create vertex and relationship in a single optimized transaction
    let createQuery;
    let createParams;
    if (!enableUserScoping) {
      createQuery = `
        CREATE (c:${vertexLabel} $properties)
        RETURN c
      `;
      createParams = { properties };
    } else {
      createQuery = `
        MATCH (u:User {uuid: $userUuid})
        CREATE (c:${vertexLabel} $properties)
        CREATE (u)-[:${relationshipType} {createdAt: datetime()}]->(c)
        RETURN c
      `;
      createParams = {
        userUuid: user.P.uuid,
        properties
      };
    }

    const result = await args.session.run(createQuery, createParams);

    if (result.records.length === 0) {
      return {
        success: false,
        message: "Failed to create content"
      };
    }

    // Use processResult to populate graph structure
    const vertices = args.processResult(result.records, args.context, 'c');
    const createdContent = vertices[0];
    const createdElementId = createdContent.id;

    // Handle relationships if provided (batched by relationshipType + targetLabel)
    // Format: { fieldKey: { relationshipType, targetLabel, targetId } }
    if (relationships && typeof relationships === "object") {
      const validatedRelationshipEntries = [];
      for (const [fieldKey, relationshipPayload] of Object.entries(relationships)) {
        if (!relationshipPayload?.relationshipType || !relationshipPayload?.targetLabel) continue;
        if (Array.isArray(relationshipPayload.targetIds) && relationshipPayload.targetIds.length > 0) {
          for (let targetIndex = 0; targetIndex < relationshipPayload.targetIds.length; targetIndex++) {
            const rawTargetId = relationshipPayload.targetIds[targetIndex];
            if (rawTargetId != null && String(rawTargetId).trim() !== "") {
              validatedRelationshipEntries.push({
                ...relationshipPayload,
                fieldKey,
                targetId: String(rawTargetId).trim()
              });
            }
          }
        } else if (relationshipPayload.targetId && String(relationshipPayload.targetId).trim() !== "") {
          validatedRelationshipEntries.push({ ...relationshipPayload, fieldKey });
        }
      }
      const byTypeAndLabel = new Map();
      for (const relationshipEntry of validatedRelationshipEntries) {
        const batchDir = relationshipEntry.relationshipDirection === "in" ? "in" : "out";
        const groupKey = `${relationshipEntry.relationshipType}|${relationshipEntry.targetLabel}|${batchDir}`;
        if (!byTypeAndLabel.has(groupKey)) byTypeAndLabel.set(groupKey, []);
        byTypeAndLabel.get(groupKey).push({ targetId: relationshipEntry.targetId, fieldKey: relationshipEntry.fieldKey });
      }
      for (const [groupKey, groupEntries] of byTypeAndLabel) {
        const parts = groupKey.split("|");
        const batchRelationshipType = parts[0];
        const batchTargetLabel = parts[1];
        const batchDir = parts[2] === "in" ? "in" : "out";
        const targetIds = groupEntries.map(entry => entry.targetId);
        try {
          if (batchDir === "in") {
            await args.session.run(
              `UNWIND $targetIds as targetId
               MATCH (c:${vertexLabel}) WHERE elementId(c) = $contentId
               MATCH (target:${batchTargetLabel}) WHERE elementId(target) = targetId
               MERGE (target)-[r:${batchRelationshipType}]->(c)
               ON CREATE SET r.createdAt = datetime()
               RETURN count(r) as created`,
              { contentId: createdElementId, targetIds }
            );
          } else {
            await args.session.run(
              `UNWIND $targetIds as targetId
               MATCH (c:${vertexLabel}) WHERE elementId(c) = $contentId
               MATCH (target:${batchTargetLabel}) WHERE elementId(target) = targetId
               MERGE (c)-[r:${batchRelationshipType}]->(target)
               ON CREATE SET r.createdAt = datetime()
               RETURN count(r) as created`,
              { contentId: createdElementId, targetIds }
            );
          }
        } catch (relError) {
          console.error(`Error creating relationships for ${batchRelationshipType}->${batchTargetLabel}:`, relError);
        }
      }
    }

    const nestedLineRemovedEdgeIds = [];
    try {
      await syncNestedLineCollections(args.session, {
        parentElementId: createdElementId,
        parentLabel: vertexLabel,
        nestedLineSync,
        enableUserScoping,
        userUuid: user.P.uuid,
        userRelationshipType: relationshipType,
        nestedLineRemovedEdgeIds
      });
    } catch (nestedErr) {
      console.error("syncNestedLineCollections (create):", nestedErr);
    }

    const savedGraph = await buildSavedContentGraphSlice(createdElementId);
    if (nestedLineRemovedEdgeIds.length > 0) {
      savedGraph.deleted_edges = [...new Set(nestedLineRemovedEdgeIds)];
    }

    const createResult = {
      success: true,
      data: createdContent,
      graph: savedGraph,
      message: `${vertexLabel} created successfully`
    };
    
    // Execute afterCreate hooks
    await args.executeHooks(hooks?.afterCreate, {
      tableVertexLabel,
      operation,
      elementId: createdElementId,
      data: inputData,
      uniqueKeys,
      enableUserScoping,
      result: createResult
    });
    
    return createResult;

  } else if (operation === "update") {
    // Update existing content
    // Get elementId from vertex if available, otherwise use elementId parameter
    const updateElementId = elementId || vertex?.id;
    if (!updateElementId) {
      return {
        success: false,
        message: "elementId is required for update operation"
      };
    }

    // Validate unique keys if provided (excluding current record)
    if (uniqueKeys && Array.isArray(uniqueKeys) && uniqueKeys.length > 0) {
      const uniqueConditions = uniqueKeys.map(key => {
        const value = formData[key];
        if (value === null || value === undefined || value === "") {
          return null;
        }
        return `c.${key} = $unique_${key}`;
      }).filter(condition => condition !== null);

      if (uniqueConditions.length > 0) {
        // Check for existing records with same unique key values (excluding current record)
        let checkQuery;
        let checkParams;
        if (!enableUserScoping) {
          checkQuery = `
            MATCH (c:${vertexLabel})
            WHERE elementId(c) <> $elementId AND ${uniqueConditions.join(" AND ")}
            RETURN c
            LIMIT 1
          `;
          checkParams = { elementId: updateElementId };
        } else {
          checkQuery = `
            MATCH (u:User {uuid: $userUuid})-[:${relationshipType}]->(c:${vertexLabel})
            WHERE elementId(c) <> $elementId AND ${uniqueConditions.join(" AND ")}
            RETURN c
            LIMIT 1
          `;
          checkParams = { userUuid: user.P.uuid, elementId: updateElementId };
        }
        uniqueKeys.forEach(key => {
          if (formData[key] !== null && formData[key] !== undefined && formData[key] !== "") {
            checkParams[`unique_${key}`] = formData[key];
          }
        });

        const checkResult = await args.session.run(checkQuery, checkParams);
        if (checkResult.records.length > 0) {
          const conflictingKeys = uniqueKeys.filter(key => 
            formData[key] !== null && formData[key] !== undefined && formData[key] !== ""
          );
          return {
            success: false,
            message: `Record with ${conflictingKeys.join(", ")} already exists`
          };
        }
      }
    }

    // Build update properties (exclude id, elementId, createdAt)
    const { id, elementId: dataElementId, createdAt, ...dataWithoutId } = formData;
    const updateProperties = {
      ...dataWithoutId,
      updatedAt: new Date().toISOString()
    };

    // Remove undefined/null values
    const cleanProperties = {};
    for (const [k, v] of Object.entries(updateProperties)) {
      if (v !== undefined && v !== null) {
        cleanProperties[k] = v;
      }
    }
    NESTED_LINE_STRIP_KEYS.forEach((k) => {
      delete cleanProperties[k];
    });
    stripRelationshipFieldKeysFromProps(cleanProperties, relationships);

    // Update vertex with ownership verification in single query
    let updateQuery;
    let updateParams;
    if (!enableUserScoping) {
      updateQuery = `
        MATCH (c:${vertexLabel})
        WHERE elementId(c) = $elementId
        SET c += $properties
        RETURN c
      `;
      updateParams = {
        elementId: updateElementId,
        properties: cleanProperties
      };
    } else {
      updateQuery = `
        MATCH (u:User {uuid: $userUuid})-[:${relationshipType}]->(c:${vertexLabel})
        WHERE elementId(c) = $elementId
        SET c += $properties
        RETURN c
      `;
      updateParams = {
        userUuid: user.P.uuid,
        elementId: updateElementId,
        properties: cleanProperties
      };
    }

    const result = await args.session.run(updateQuery, updateParams);

    if (result.records.length === 0) {
      return {
        success: false,
        message: "Failed to update content"
      };
    }

    // Use processResult to populate graph structure
    const vertices = args.processResult(result.records, args.context, 'c');
    const updatedContent = vertices[0];

    // Handle relationships if provided: diff by target — keep existing edges, delete only removed, MERGE missing.
    // Format: { fieldKey: { relationshipType, targetLabel, targetId } } or { ..., targetIds: string[] }
    const contentRelationshipRemovedEdgeIds = [];
    if (relationships && typeof relationships === "object") {
      for (const [fieldKey, relationshipPayload] of Object.entries(relationships)) {
        if (!relationshipPayload?.relationshipType || !relationshipPayload?.targetLabel) continue;
        const relDir = relationshipPayload.relationshipDirection === "in" ? "in" : "out";
        try {
          let normalizedTargetIds = [];
          if (Array.isArray(relationshipPayload.targetIds) && relationshipPayload.targetIds.length > 0) {
            normalizedTargetIds = relationshipPayload.targetIds
              .map((rawId) => (rawId != null ? String(rawId).trim() : ""))
              .filter((trimmedId) => trimmedId !== "");
          } else if (
            relationshipPayload.targetId != null &&
            String(relationshipPayload.targetId).trim() !== ""
          ) {
            normalizedTargetIds = [String(relationshipPayload.targetId).trim()];
          }
          const desiredTargetElementIdSet = new Set(normalizedTargetIds);

          const existingRelationshipsResult = await args.session.run(
            relDir === "in"
              ? `MATCH (target:${relationshipPayload.targetLabel})-[relationship:${relationshipPayload.relationshipType}]->(c:${vertexLabel})
                 WHERE elementId(c) = $contentId
                 RETURN elementId(target) AS targetElementId, elementId(relationship) AS relationshipElementId`
              : `MATCH (c:${vertexLabel})-[relationship:${relationshipPayload.relationshipType}]->(target:${relationshipPayload.targetLabel})
                 WHERE elementId(c) = $contentId
                 RETURN elementId(target) AS targetElementId, elementId(relationship) AS relationshipElementId`,
            { contentId: updateElementId }
          );
          const relationshipIdsByTargetElementId = new Map();
          for (
            let recordIndex = 0;
            recordIndex < existingRelationshipsResult.records.length;
            recordIndex++
          ) {
            const targetElementIdRaw =
              existingRelationshipsResult.records[recordIndex].get("targetElementId");
            const relationshipElementIdRaw =
              existingRelationshipsResult.records[recordIndex].get("relationshipElementId");
            if (targetElementIdRaw == null || relationshipElementIdRaw == null) continue;
            const targetElementId = String(targetElementIdRaw);
            const relationshipElementId = String(relationshipElementIdRaw);
            if (!relationshipIdsByTargetElementId.has(targetElementId)) {
              relationshipIdsByTargetElementId.set(targetElementId, []);
            }
            relationshipIdsByTargetElementId.get(targetElementId).push(relationshipElementId);
          }

          const relationshipElementIdsToRemove = [];
          for (const [targetElementId, idsForTarget] of relationshipIdsByTargetElementId.entries()) {
            if (!desiredTargetElementIdSet.has(targetElementId)) {
              relationshipElementIdsToRemove.push(...idsForTarget);
            }
          }
          await deleteTrackedRelationships(
            args.session,
            contentRelationshipRemovedEdgeIds,
            relationshipElementIdsToRemove,
          );

          const targetElementIdsMissingFromGraph = [];
          for (const desiredTargetElementId of desiredTargetElementIdSet) {
            if (!relationshipIdsByTargetElementId.has(desiredTargetElementId)) {
              targetElementIdsMissingFromGraph.push(desiredTargetElementId);
            }
          }
          if (targetElementIdsMissingFromGraph.length === 0) continue;

          if (relDir === "in") {
            await args.session.run(
              `UNWIND $targetIds AS targetId
               MATCH (c:${vertexLabel})
               WHERE elementId(c) = $contentId
               MATCH (target:${relationshipPayload.targetLabel})
               WHERE elementId(target) = targetId
               MERGE (target)-[r:${relationshipPayload.relationshipType}]->(c)
               ON CREATE SET r.createdAt = datetime()
               ON MATCH SET r.updatedAt = datetime()
               RETURN count(r) AS n`,
              { contentId: updateElementId, targetIds: targetElementIdsMissingFromGraph }
            );
          } else {
            await args.session.run(
              `UNWIND $targetIds AS targetId
               MATCH (c:${vertexLabel})
               WHERE elementId(c) = $contentId
               MATCH (target:${relationshipPayload.targetLabel})
               WHERE elementId(target) = targetId
               MERGE (c)-[r:${relationshipPayload.relationshipType}]->(target)
               ON CREATE SET r.createdAt = datetime()
               ON MATCH SET r.updatedAt = datetime()
               RETURN count(r) AS n`,
              { contentId: updateElementId, targetIds: targetElementIdsMissingFromGraph }
            );
          }
        } catch (relError) {
          console.error(`Error updating relationship for ${fieldKey}:`, relError);
        }
      }
    }

    const nestedLineRemovedEdgeIds = [];
    try {
      await syncNestedLineCollections(args.session, {
        parentElementId: updateElementId,
        parentLabel: vertexLabel,
        nestedLineSync,
        enableUserScoping,
        userUuid: user.P.uuid,
        userRelationshipType: relationshipType,
        nestedLineRemovedEdgeIds
      });
    } catch (nestedErr) {
      console.error("syncNestedLineCollections (update):", nestedErr);
    }

    const savedGraph = await buildSavedContentGraphSlice(updateElementId);
    const allRemovedRelationshipIds = [
      ...new Set([...contentRelationshipRemovedEdgeIds, ...nestedLineRemovedEdgeIds])
    ];
    if (allRemovedRelationshipIds.length > 0) {
      savedGraph.deleted_edges = allRemovedRelationshipIds;
    }

    const updateResult = {
      success: true,
      data: updatedContent,
      graph: savedGraph,
      message: `${vertexLabel} updated successfully`
    };
    
    // Execute afterUpdate hooks
    await args.executeHooks(hooks?.afterUpdate, {
      tableVertexLabel,
      operation,
      elementId: updateElementId,
      data: inputData,
      uniqueKeys,
      enableUserScoping,
      result: updateResult
    });
    
    return updateResult;

  } else if (operation === "delete") {
    // Delete content - elementId can come from elementId parameter or vertex.id/vertex.elementId
    const deleteElementId = elementId || (vertex ? (vertex.elementId || vertex.id) : null);
    if (!deleteElementId) {
      return {
        success: false,
        message: "elementId is required for delete operation"
      };
    }

    // Get the vertex data before deletion for hooks (if needed)
    // We need to fetch it before deletion to get properties like Shopify ID
    let deletedVertexData = null;
    try {
      const fetchQuery = !enableUserScoping
        ? `MATCH (c:${vertexLabel}) WHERE elementId(c) = $elementId RETURN c`
        : `MATCH (u:User {uuid: $userUuid})-[:${relationshipType}]->(c:${vertexLabel}) WHERE elementId(c) = $elementId RETURN c`;
      const fetchParams = enableUserScoping ? { elementId: deleteElementId, userUuid: user.P.uuid } : { elementId: deleteElementId };
      const fetchResult = await args.session.run(fetchQuery, fetchParams);
      if (fetchResult.records.length > 0) {
        const vertexNode = fetchResult.records[0].get('c');
        deletedVertexData = args.convertNodeToJson(vertexNode);
      }
    } catch (e) {
      console.warn("Failed to fetch vertex data before deletion for hooks:", e);
    }

    // Verify ownership and delete in single optimized query
    let deleteQuery;
    let deleteParams;
    if (!enableUserScoping) {
      deleteQuery = `
        MATCH (c:${vertexLabel})
        WHERE elementId(c) = $elementId
        DETACH DELETE c
        RETURN count(c) as deleted
      `;
      deleteParams = { elementId: deleteElementId };
    } else {
      deleteQuery = `
        MATCH (u:User {uuid: $userUuid})-[r:${relationshipType}]->(c:${vertexLabel})
        WHERE elementId(c) = $elementId
        DETACH DELETE c, r
        RETURN count(c) as deleted
      `;
      deleteParams = {
        userUuid: user.P.uuid,
        elementId: deleteElementId
      };
    }

    const result = await args.session.run(deleteQuery, deleteParams);

    const deleted = result.records[0]?.get('deleted') || 0;

    if (deleted === 0) {
      return {
        success: false,
        message: "Content not found or you don't have permission to delete it"
      };
    }

    const deleteResult = {
      success: true,
      message: `${vertexLabel} deleted successfully`,
      data: deletedVertexData ? { P: deletedVertexData.P } : null
    };
    
    // Execute afterDelete hooks
    await args.executeHooks(hooks?.afterDelete, {
      tableVertexLabel,
      operation,
      elementId: deleteElementId,
      data: inputData,
      uniqueKeys,
      enableUserScoping,
      result: deleteResult
    });
    
    return deleteResult;
  }
} catch (error) {
  console.error(`Error in mutateUserContent (${operation}):`, error);
  return {
    success: false,
    message: error.message || `Failed to ${operation} ${tableVertexLabel}`
  };
}
'''
        key: mutateUserContent
      }
    }
  ]
  edges: []
}