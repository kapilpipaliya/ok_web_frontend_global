{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Fetches user's vertices of a specific label with optional search and relationship filtering
        body:
          '''
// Get current authenticated user from session
const actualUser = await args.getUserFromSession();
if (!actualUser) {
  return {
    success: false,
    message: "User session not found. Please log in and try again.",
    data: []
  };
}

// Get effective user (handles admin impersonation)
const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

// Extract parameters
const {
  label,
  userUuid,
  search = "",
  limit = 100,
  relationshipType,
  enableUserScoping,
  hooks,
  neighborFromElementId,
  neighborOutgoingRelationshipType,
  neighborUserPathRelationshipType,
  neighborUserPathAnchorLabel,
} = args.contextData;

if (!label) {
  return {
    success: false,
    message: "Label is required",
    data: []
  };
}

// Use provided userUuid or current user's uuid (only if scoping is enabled)
const targetUserUuid = enableUserScoping ? (userUuid || user.P.uuid) : null;

// Execute beforeGetUserVertices hooks
await args.executeHooks(hooks?.beforeGetUserVertices, {
  label,
  userUuid: targetUserUuid,
  search,
  limit,
  relationshipType,
  enableUserScoping,
  neighborFromElementId,
  neighborOutgoingRelationshipType,
});

const neighborId =
  neighborFromElementId != null && String(neighborFromElementId).trim() !== ""
    ? String(neighborFromElementId).trim()
    : "";
const neighborOutRel =
  neighborOutgoingRelationshipType != null && String(neighborOutgoingRelationshipType).trim() !== ""
    ? String(neighborOutgoingRelationshipType).trim()
    : "";
const userPathRel =
  neighborUserPathRelationshipType != null && String(neighborUserPathRelationshipType).trim() !== ""
    ? String(neighborUserPathRelationshipType).trim()
    : "";
const userPathAnchorLabel =
  neighborUserPathAnchorLabel != null && String(neighborUserPathAnchorLabel).trim() !== ""
    ? String(neighborUserPathAnchorLabel).trim()
    : "";

// Build query
let query;
let params = { limit: args.neo4jDriver.int(limit) };

// --- Neighbor-filtered list (e.g. variants under a selected product): anchor -(outRel)-> v:label
if (neighborOutRel) {
  if (!neighborId) {
    const empty = {
      success: true,
      data: [],
      message: `No anchor selected for ${label} neighbor filter`,
    };
    await args.executeHooks(hooks?.afterGetUserVertices, {
      label,
      userUuid: targetUserUuid,
      search,
      limit,
      relationshipType,
      enableUserScoping,
      result: empty,
    });
    return empty;
  }
  params.neighborId = neighborId;
  const hasSearch = !!(search && String(search).trim());
  if (hasSearch) {
    params.searchTerm = String(search).trim().toLowerCase();
  }
  const scopedNeighbor =
    enableUserScoping === true && userPathRel && userPathAnchorLabel;
  if (enableUserScoping === true && neighborOutRel && !scopedNeighbor) {
    const empty = {
      success: true,
      data: [],
      message: "Neighbor filter with user scoping requires neighborUserPathRelationshipType and neighborUserPathAnchorLabel",
    };
    await args.executeHooks(hooks?.afterGetUserVertices, {
      label,
      userUuid: targetUserUuid,
      search,
      limit,
      relationshipType,
      enableUserScoping,
      result: empty,
    });
    return empty;
  }
  if (scopedNeighbor) {
    params.userUuid = targetUserUuid;
    query = `
      MATCH (u:User {uuid: $userUuid})-[:${userPathRel}]->(anchor:${userPathAnchorLabel})
      WHERE elementId(anchor) = $neighborId
      MATCH (anchor)-[:${neighborOutRel}]->(v:${label})
    `;
  } else {
    query = `
      MATCH (anchor)
      WHERE elementId(anchor) = $neighborId
      MATCH (anchor)-[:${neighborOutRel}]->(v:${label})
    `;
  }
  if (hasSearch) {
    query += `
      WHERE (
        toLower(COALESCE(v.name, '')) CONTAINS $searchTerm OR
        toLower(COALESCE(v.title, '')) CONTAINS $searchTerm OR
        toLower(COALESCE(v.description, '')) CONTAINS $searchTerm OR
        toLower(COALESCE(v.sku, '')) CONTAINS $searchTerm OR
        toLower(COALESCE(v.productCode, '')) CONTAINS $searchTerm OR
        toLower(COALESCE(v.fileName, '')) CONTAINS $searchTerm
      )
    `;
  }
  query += `
    RETURN DISTINCT v
    ORDER BY COALESCE(v.sku, v.name, v.title, v.fileName, '') ASC
    LIMIT $limit
  `;
} else if (!enableUserScoping) {
  // No user scoping - fetch all vertices of the label
  query = `
    MATCH (v:${label})
  `;
  // Add search filter if provided
  if (search && search.trim()) {
    const searchTerm = search.trim().toLowerCase();
    query += `
    WHERE toLower(COALESCE(v.name, '')) CONTAINS $searchTerm OR
          toLower(COALESCE(v.title, '')) CONTAINS $searchTerm OR
          toLower(COALESCE(v.description, '')) CONTAINS $searchTerm OR
          toLower(COALESCE(v.sku, '')) CONTAINS $searchTerm OR
          toLower(COALESCE(v.productCode, '')) CONTAINS $searchTerm OR
          toLower(COALESCE(v.fileName, '')) CONTAINS $searchTerm
  `;
    params.searchTerm = searchTerm;
  }
  query += `
  RETURN v
  ORDER BY COALESCE(v.name, v.title, v.sku, v.fileName, '') ASC
  LIMIT $limit
`;
} else {
  // User scoping enabled - filter by user relationship
  params.userUuid = targetUserUuid;

  if (relationshipType) {
    // Query with specific relationship type
    query = `
      MATCH (u:User {uuid: $userUuid})-[:${relationshipType}]->(v:${label})
    `;
  } else {
    // Auto-detect relationship: User + Label (e.g., UserBook, UserAudioVideo)
    const autoRelationship = `User${label}`;
    query = `
      MATCH (u:User {uuid: $userUuid})-[:${autoRelationship}]->(v:${label})
    `;
  }
  if (search && search.trim()) {
    const searchTerm = search.trim().toLowerCase();
    query += `
    WHERE toLower(COALESCE(v.name, '')) CONTAINS $searchTerm OR
          toLower(COALESCE(v.title, '')) CONTAINS $searchTerm OR
          toLower(COALESCE(v.description, '')) CONTAINS $searchTerm OR
          toLower(COALESCE(v.sku, '')) CONTAINS $searchTerm OR
          toLower(COALESCE(v.productCode, '')) CONTAINS $searchTerm OR
          toLower(COALESCE(v.fileName, '')) CONTAINS $searchTerm
  `;
    params.searchTerm = searchTerm;
  }
  query += `
  RETURN v
  ORDER BY COALESCE(v.name, v.title, v.sku, v.fileName, '') ASC
  LIMIT $limit
`;
}

const result = await args.session.run(query, params);

// Use processResult to populate graph structure
const vertices = args.processResult(result.records, args.context, 'v');

const resultData = {
  success: true,
  data: vertices,
  message: `Found ${vertices.length} ${label} vertices`
};

// Execute afterGetUserVertices hooks
await args.executeHooks(hooks?.afterGetUserVertices, {
  label,
  userUuid: targetUserUuid,
  search,
  limit,
  relationshipType,
  enableUserScoping,
  result: resultData
});

return resultData;
'''
        key: getUserVertices
      }
    }
  ]
  edges: []
}