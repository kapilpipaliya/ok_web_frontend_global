  enableLocalFilters: true,
  enableLocalSort: true,
  hooks: {},
  sidebar: {
    enabled: false
  },
  onRowClick: (row, _) => {
    if (!row?.id) return;
    const ticketId = row.id;
    const basePath = "/ShopifySupportConversation";
    const searchParams = _.searchParams || {};
    const nextParams = { ...searchParams, supportId: ticketId };
    const query = Object.entries(nextParams)
      .filter(([, value]) => value != null && value !== "")
      .map(([key, value]) => \`\${encodeURIComponent(key)}=\${encodeURIComponent(String(value))}\`)
      .join("&");
    const href = query ? \`\${basePath}?\${query}\` : basePath;

    if (_.navigate) {
      _.navigate(href);
    } else if (typeof window !== "undefined") {
      window.location.href = href;
    }
  }
};`
  }
];

// Reports / chart queries: consumed by getConfigurableGraphData (Setting key must match default there)
const workshopReportsChartsSetting = {
  key: "WorkshopReports_charts_default",
  type: "workshop_reports_charts",
  name: "Workshop reports charts",
  config: `return {
  graphs: {
    workshopAppointmentsByStatus: {
      title: "Appointments by status",
      chartType: "pie",
      datasetLabel: "Appointments",
      description: "Appointments in the selected period grouped by status.",
      cypher: "MATCH (a:WorkshopAppointment) WHERE coalesce(toString(a.scheduledAt), toString(a.createdAt), '') >= $since RETURN coalesce(toLower(toString(a.status)), 'unknown') AS label, count(*) AS value ORDER BY value DESC",
      cypherScoped: "MATCH (u:User {uuid: $userUuid})-[:UserWorkshopAppointment]->(a:WorkshopAppointment) WHERE coalesce(toString(a.scheduledAt), toString(a.createdAt), '') >= $since RETURN coalesce(toLower(toString(a.status)), 'unknown') AS label, count(*) AS value ORDER BY value DESC"
    },
    workshopRepairsByStatus: {
      title: "Repair orders by status",
      chartType: "bar",
      datasetLabel: "Repairs",
      description: "Open and historical repair orders by workflow status.",
      cypher: "MATCH (r:RepairOrder) WHERE coalesce(toString(r.createdAt), toString(r.updatedAt), '') >= $since RETURN coalesce(toLower(toString(r.status)), 'unknown') AS label, count(*) AS value ORDER BY value DESC",
      cypherScoped: "MATCH (u:User {uuid: $userUuid})-[:UserRepairOrder]->(r:RepairOrder) WHERE coalesce(toString(r.createdAt), toString(r.updatedAt), '') >= $since RETURN coalesce(toLower(toString(r.status)), 'unknown') AS label, count(*) AS value ORDER BY value DESC"
    },
    workshopInvoiceTotalsByMonth: {
      title: "Invoice totals by month",
      chartType: "bar",
      datasetLabel: "Total amount",
      description: "Sum of invoice totals aggregated by year-month (YYYY-MM).",
      cypher: "MATCH (w:WorkshopInvoice) WHERE coalesce(toString(w.invoiceDate), toString(w.createdAt), '') >= $since WITH substring(coalesce(toString(w.invoiceDate), toString(w.createdAt), ''), 0, 7) AS label, sum(toFloat(coalesce(w.totalAmount, 0))) AS value WHERE label <> '' RETURN label, value ORDER BY label",
      cypherScoped: "MATCH (u:User {uuid: $userUuid})-[:UserWorkshopInvoice]->(w:WorkshopInvoice) WHERE coalesce(toString(w.invoiceDate), toString(w.createdAt), '') >= $since WITH substring(coalesce(toString(w.invoiceDate), toString(w.createdAt), ''), 0, 7) AS label, sum(toFloat(coalesce(w.totalAmount, 0))) AS value WHERE label <> '' RETURN label, value ORDER BY label"
    },
    workshopPaymentsByMethod: {
      title: "Payments by method",
      chartType: "pie",
      datasetLabel: "Payments",
      description: "Payment records grouped by tender type.",
      cypher: "MATCH (p:WorkshopPayment) WHERE coalesce(toString(p.paymentDate), toString(p.createdAt), '') >= $since RETURN coalesce(toLower(toString(p.method)), 'other') AS label, count(*) AS value ORDER BY value DESC",
      cypherScoped: "MATCH (u:User {uuid: $userUuid})-[:UserWorkshopPayment]->(p:WorkshopPayment) WHERE coalesce(toString(p.paymentDate), toString(p.createdAt), '') >= $since RETURN coalesce(toLower(toString(p.method)), 'other') AS label, count(*) AS value ORDER BY value DESC"
    }
  }
};`
};

// Helper: non-table Setting (reports chart registry)
async function processExtraSetting(setting) {
  const { key, type, name, config } = setting;
  console.log(`Processing ${name} (${key})...`);

  const checkResult = await _.session.run(`MATCH (s:Setting {key: $key}) RETURN s`, { key });
  const exists = checkResult.records.length > 0;

  if (!dryRun) {
    if (exists) {
      await _.session.run(
        `MATCH (s:Setting {key: $key})
         SET s.config = $config,
             s.type = $type,
             s.updatedAt = datetime()
         REMOVE s.tableVertexLabel
         RETURN s`,
        { key, config, type }
      );
      console.log(`Updated existing ${name}`);
      return { created: 0, updated: 1 };
    }
    await _.session.run(
      `CREATE (s:Setting {
        key: $key,
        type: $type,
        config: $config,
        createdAt: datetime(),
        updatedAt: datetime()
      })
      RETURN s`,
      { key, type, config }
    );
    console.log(`Created new ${name}`);
    return { created: 1, updated: 0 };
  }
  if (exists) {
    console.log(`Would update existing ${name}`);
    return { created: 0, updated: 1 };
  }
  console.log(`Would create new ${name}`);
  return { created: 1, updated: 0 };
}

// Helper function to process a single setting
async function processSetting(setting) {
  const { key, tableVertexLabel, icon, name, config } = setting;

  console.log(`Processing ${name} settings (${icon})...`);

  // Check if setting exists
  const checkResult = await _.session.run(
    `MATCH (s:Setting {key: $key}) RETURN s`,
    { key }
  );

  const exists = checkResult.records.length > 0;

  if (!dryRun) {
    if (exists) {
      // Update existing
      await _.session.run(
        `MATCH (s:Setting {key: $key})
         SET s.config = $config,
             s.type = 'table_config',
             s.tableVertexLabel = $tableVertexLabel,
             s.updatedAt = datetime()
         RETURN s`,
        { key, config, tableVertexLabel }
      );
      console.log(`Updated existing ${name} settings`);
      return { created: 0, updated: 1 };
    } else {
      // Create new
      await _.session.run(
        `CREATE (s:Setting {
          key: $key,
          type: 'table_config',
          tableVertexLabel: $tableVertexLabel,
          config: $config,
          createdAt: datetime(),
          updatedAt: datetime()
        })
        RETURN s`,
        { key, config, tableVertexLabel }
      );
      console.log(`Created new ${name} settings`);
      return { created: 1, updated: 0 };
    }
  } else {
    // Dry run - just report
    if (exists) {
      console.log(`Would update existing ${name} settings`);
      return { created: 0, updated: 1 };
    } else {
      console.log(`Would create new ${name} settings`);
      return { created: 1, updated: 0 };
    }
  }
}

// Process all settings
const stats = {
  created: 0,
  updated: 0,
  total: settingsConfigs.length,
  reportsChartsCreated: 0,
  reportsChartsUpdated: 0
};

for (let i = 0; i < settingsConfigs.length; i++) {
  const setting = settingsConfigs[i];
  const result = await processSetting(setting);

  stats.created += result.created;
  stats.updated += result.updated;
}

const reportsChartsResult = await processExtraSetting(workshopReportsChartsSetting);
stats.reportsChartsCreated = reportsChartsResult.created;
stats.reportsChartsUpdated = reportsChartsResult.updated;

// Workshop picklists for optionsPicklist-backed form fields (create missing only; no user session required)
const WORKSHOP_PICKLIST_NEO_LABEL = {
  appointment_status: "AppointmentStatus",
  repair_status: "RepairStatus",
  invoice_payment_status: "InvoicePaymentStatus",
  technician_status: "TechnicianStatus",
  payment_method: "PaymentMethod",
  inventory_stock_status: "InventoryStockStatus",
  customer_status: "CustomerStatus",
  service_status: "ServiceStatus",
  supplier_type: "SupplierType"
};

let picklistsSeeded = 0;
if (!dryRun) {
  const PICKLIST_SEED = [
    {
      picklistKey: "appointment_status",
      title: "Appointment status",
      options: [
        { value: "scheduled", label: "Scheduled", displayOrder: 10 },
        { value: "in-progress", label: "In Progress", displayOrder: 20 },
        { value: "completed", label: "Completed", displayOrder: 30 },
        { value: "cancelled", label: "Cancelled", displayOrder: 40 }
      ]
    },
    {
      picklistKey: "repair_status",
      title: "Repair order status",
      options: [
        { value: "open", label: "Open", displayOrder: 10 },
        { value: "diagnosing", label: "Diagnosing", displayOrder: 20 },
        { value: "waiting-parts", label: "Waiting Parts", displayOrder: 30 },
        { value: "ready-billing", label: "Ready For Billing", displayOrder: 40 },
        { value: "closed", label: "Closed", displayOrder: 50 },
        { value: "cancelled", label: "Cancelled", displayOrder: 60 }
      ]
    },
    {
      picklistKey: "invoice_payment_status",
      title: "Invoice payment status",
      options: [
        { value: "unpaid", label: "Unpaid", displayOrder: 10 },
        { value: "partial", label: "Partially Paid", displayOrder: 20 },
        { value: "paid", label: "Paid", displayOrder: 30 }
      ]
    },
    {
      picklistKey: "technician_status",
      title: "Technician status",
      options: [
        { value: "active", label: "Active", displayOrder: 10 },
        { value: "leave", label: "On Leave", displayOrder: 20 },
        { value: "inactive", label: "Inactive", displayOrder: 30 }
      ]
    },
    {
      picklistKey: "payment_method",
      title: "Payment method",
      options: [
        { value: "cash", label: "Cash", displayOrder: 10 },
        { value: "card", label: "Card", displayOrder: 20 },
        { value: "transfer", label: "Transfer", displayOrder: 30 },
        { value: "mobile", label: "Mobile", displayOrder: 40 }
      ]
    },
    {
      picklistKey: "inventory_stock_status",
      title: "Inventory stock status",
      options: [
        { value: "in-stock", label: "In stock", displayOrder: 10 },
        { value: "low", label: "Low stock", displayOrder: 20 },
        { value: "out-of-stock", label: "Out of stock", displayOrder: 30 },
        { value: "ordered", label: "On order", displayOrder: 40 }
      ]
    },
    {
      picklistKey: "customer_status",
      title: "Customer status",
      options: [
        { value: "active", label: "Active", displayOrder: 10 },
        { value: "inactive", label: "Inactive", displayOrder: 20 },
        { value: "vip", label: "VIP", displayOrder: 30 }
      ]
    },
    {
      picklistKey: "service_status",
      title: "Service status",
      options: [
        { value: "active", label: "Active", displayOrder: 10 },
        { value: "seasonal", label: "Seasonal", displayOrder: 20 },
        { value: "archived", label: "Archived", displayOrder: 30 }
      ]
    },
    {
      picklistKey: "supplier_type",
      title: "Supplier type",
      options: [
        { value: "distributor", label: "Distributor", displayOrder: 10 },
        { value: "oem", label: "OEM", displayOrder: 20 },
        { value: "local", label: "Local vendor", displayOrder: 30 },
        { value: "other", label: "Other", displayOrder: 40 }
      ]
    }
  ];

  for (const def of PICKLIST_SEED) {
    const sk = def.picklistKey.replace(/[^a-z0-9_]/gi, "_").toLowerCase();
    const neoLabel = WORKSHOP_PICKLIST_NEO_LABEL[sk];
    if (!neoLabel) {
      console.warn(`Skipping picklist seed: unmapped picklistKey ${def.picklistKey}`);
      continue;
    }
    const cntRes = await _.session.run(
      `MATCH (o:\`${neoLabel}\`) RETURN count(o) AS c`,
      {}
    );
    const existing =
      cntRes.records[0]?.get("c")?.toNumber?.() ??
      Number(cntRes.records[0]?.get("c")) ??
      0;
    if (existing > 0) continue;

    for (let oi = 0; oi < def.options.length; oi++) {
      const opt = def.options[oi];
      await _.session.run(
        `CREATE (o:\`${neoLabel}\` {
             value: $value,
             label: $label,
             displayOrder: $displayOrder,
             createdAt: datetime(),
             updatedAt: datetime()
           })`,
        {
          value: opt.value,
          label: opt.label,
          displayOrder: opt.displayOrder
        }
      );
    }
    picklistsSeeded++;
    console.log(`Seeded ${neoLabel} (${def.options.length} option vertices)`);
  }
}

// ==========================================
// Reference sequences (MERGE defaults only — no content backfill)
// ==========================================
let referenceSequencesSeeded = 0;
const REFERENCE_SEQUENCE_DEFAULTS = [
  {
    key: "WorkshopAppointment.appointmentNo",
    prefix: "APT-",
    suffix: "",
    startingNumber: 1000,
    incrementStep: 1,
    format: "{prefix}{number}{suffix}",
    resetRule: "never"
  },
  {
    key: "WorkshopInvoice.invoiceNo",
    prefix: "INV-",
    suffix: "",
    startingNumber: 1000,
    incrementStep: 1,
    format: "{prefix}{number}{suffix}",
    resetRule: "never"
  },
  {
    key: "RepairOrder.repairNo",
    prefix: "RO-",
    suffix: "",
    startingNumber: 1000,
    incrementStep: 1,
    format: "{prefix}{number}{suffix}",
    resetRule: "never"
  },
  {
    key: "WorkshopPayment.paymentNo",
    prefix: "PAY-",
    suffix: "",
    startingNumber: 1000,
    incrementStep: 1,
    format: "{prefix}{number}{suffix}",
    resetRule: "never"
  },
  {
    key: "WorkshopCustomer.customerNo",
    prefix: "CUS-",
    suffix: "",
    startingNumber: 1000,
    incrementStep: 1,
    format: "{prefix}{number}{suffix}",
    resetRule: "never"
  },
  {
    key: "WorkshopSupplier.supplierCode",
    prefix: "VEN-",
    suffix: "",
    startingNumber: 1000,
    incrementStep: 1,
    format: "{prefix}{number}{suffix}",
    resetRule: "never"
  },
  {
    key: "InventoryProduct.productCode",
    prefix: "PRD-",
    suffix: "",
    startingNumber: 1000,
    incrementStep: 1,
    format: "{prefix}{number}{suffix}",
    resetRule: "never"
  }
];

if (!dryRun) {
  for (let ri = 0; ri < REFERENCE_SEQUENCE_DEFAULTS.length; ri++) {
    const row = REFERENCE_SEQUENCE_DEFAULTS[ri];
    await _.session.run(
      `
      MERGE (s:WorkshopReferenceSequence {key: $key})
      ON CREATE SET
        s.prefix = $prefix,
        s.suffix = $suffix,
        s.startingNumber = toInteger($startingNumber),
        s.incrementStep = toInteger($incrementStep),
        s.format = $format,
        s.resetRule = $resetRule,
        s.numberPadding = 0,
        s.createdAt = datetime(),
        s.updatedAt = datetime()
      `,
      {
        key: row.key,
        prefix: row.prefix,
        suffix: row.suffix,
        startingNumber: row.startingNumber,
        incrementStep: row.incrementStep,
        format: row.format,
        resetRule: row.resetRule
      }
    );
    referenceSequencesSeeded++;
  }
  console.log(`Reference sequences MERGE completed (${REFERENCE_SEQUENCE_DEFAULTS.length} keys)`);
}

// ==========================================
// Summary
// ==========================================
console.log("Migration Summary");
console.log(`Created: ${stats.created}`);
console.log(`Updated: ${stats.updated}`);
console.log(`Total processed: ${stats.total}`);
console.log(`Picklists seeded (new keys): ${picklistsSeeded}`);
console.log(`Reference sequence keys MERGE run: ${referenceSequencesSeeded}`);

return {
  success: true,
  message: dryRun
    ? "Dry run completed - no changes made"
    : "Workshop content table settings migration completed successfully",
