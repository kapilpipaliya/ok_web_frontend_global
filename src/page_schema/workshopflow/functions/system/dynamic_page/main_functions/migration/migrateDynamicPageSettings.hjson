alue: 1, gridMinmax: "minmax(3.25rem, 0.45fr)" }, { key: "unitPrice", label: "Unit price", columnType: "number", placeholder: "Unit price", min: 0, step: 0.01, defaultValue: 0, gridMinmax: "minmax(4.25rem, 0.55fr)" }, { key: "_actions", label: "", columnType: "actions", gridMinmax: "minmax(3.75rem, auto)" }] } },
