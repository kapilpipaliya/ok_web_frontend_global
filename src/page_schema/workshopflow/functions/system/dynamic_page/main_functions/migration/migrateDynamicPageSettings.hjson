{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Migrates or creates default workshop table configuration settings. Updates existing settings if they already exist.
        body:
          '''
/**
 * Migration: Content Table Settings
 *
 * This migration creates or updates default table configuration settings
 * for workshop management modules, plus the workshop reports chart registry
 * (`WorkshopReports_charts_default`, type `workshop_reports_charts`) for `getConfigurableGraphData`.
 *
 * Table config drives DynamicPage → getUserContent / mutateUserContent:
 * - Select fields with selectConfig.edgeOnly + relationshipType define FK hydration (relationshipPropertyBindings).
 * - nestedLineItems fields define parent property keys stripped on save (nestedLinePropertyStripKeys); optional extra keys: nestedLinePropertyStripKeys on the config object.
 * - Optional relationshipPropertyBindings: [{ prop, rel }] for edges not declared as edgeOnly selects.
 * - Sidebar: each list uses its own category label and item edge (e.g. WorkshopAppointmentCategory + WorkshopAppointmentCategoryItem); Inventory/Service keep InventoryCategory/ServiceCategory. Use `sidebar.rootKeys: {}` so getSidebarTreeRoots does not filter roots to a single property match (e.g. only key "root"); user-created top-level categories then load after refresh. The MERGE’d default folder still uses key "root" for the seeded “All …” node.
 * - getUserContent: when relationshipPropertyBindings is not passed, bindings are derived from this Setting (user key then _default).
 *
 * Parameters (via c):
 * - dryRun: boolean (optional) - If true, only report what would be migrated without making changes
 *
 * Returns:
 * - Statistics about the migration
 */

const { dryRun = false } = c;

console.log(`Starting workshop content settings migration (dryRun: ${dryRun})`);

// Define settings configurations
const settingsConfigs = [
  {
    key: 'WorkshopAppointment_settings_default',
    tableVertexLabel: 'WorkshopAppointment',
    icon: 'Calendar',
    name: 'Workshop Appointments',
    config: `return {
  title: "Appointments",
  label: "Appointment",
  icon: "ph:calendar-check",
  actions: [
    { key: "edit", type: "edit" },
    { key: "delete", type: "delete", confirm: { title: "Delete?", message: "This cannot be undone.", confirmText: "Delete", cancelText: "Cancel", variant: "danger" } }
  ],
  rowClickable: true,
  showRowNumber: true,
  columns: [
    { key: "appointmentNo", label: "Appointment #", dataType: "text", renderer: "text", width: "140px" },
    { key: "scheduledAt", label: "Scheduled At", dataType: "date", renderer: "date", width: "180px" },
    { key: "customerId", label: "Customer", dataType: "relation", renderer: "text", width: "180px", selectConfig: { label: "WorkshopCustomer", labelField: "name", relationshipType: "AppointmentCustomer", limit: 100, edgeOnly: true } },
    { key: "vehicleId", label: "Vehicle", dataType: "relation", renderer: "text", width: "120px", selectConfig: { label: "WorkshopVehicle", labelField: "plate", relationshipType: "AppointmentVehicle", limit: 200, edgeOnly: true } },
    { key: "serviceId", label: "Service", dataType: "relation", renderer: "text", width: "180px", selectConfig: { label: "WorkshopService", labelField: "name", relationshipType: "AppointmentService", limit: 100, edgeOnly: true } },
    { key: "assignedTechnicianId", label: "Technician", dataType: "relation", renderer: "text", width: "150px", selectConfig: { label: "WorkshopTechnician", labelField: "name", relationshipType: "AppointmentTechnician", limit: 100, edgeOnly: true } },
    { key: "status", label: "Status", dataType: "text", renderer: "badge", width: "120px", badgeKeyCase: "lower", badgeToneMap: { scheduled: ["Scheduled", "info"], "in-progress": ["In Progress", "warning"], completed: ["Completed", "success"], cancelled: ["Cancelled", "critical"] } },
    { key: "serviceBayId", label: "Bay", dataType: "relation", renderer: "text", width: "120px", selectConfig: { label: "WorkshopServiceBay", labelField: "name", relationshipType: "AppointmentServiceBay", limit: 100, edgeOnly: true } }
  ],
  rowHeight: 52,
  showSelection: true,
  resizableColumns: true,
  enableLocalFilters: true,
  enableLocalSort: true,
  formConfig: {
    gridColumns: 2,
    groups: [
      {
        key: "schedule",
        title: "Schedule",
        gridColumns: 2,
        fields: [
          { key: "appointmentNo", label: "Appointment #", dataType: "text", renderer: "text", required: true, colSpan: 1, tooltip: "Unique booking reference shown in the table, printouts, and linked repair orders. Auto-assigned from reference sequences (Workshop Settings → Appointments).", autoReferenceSequenceKey: "WorkshopAppointment.appointmentNo", disabled: (ctx) => ctx.mode === "create" },
          { key: "status", label: "Status", dataType: "select", renderer: "select", required: true, optionsPicklist: { picklistKey: "appointment_status" }, colSpan: 1, tooltip: "Lifecycle of this visit: scheduled, in progress, completed, or cancelled. Options are configured under Workshop Settings → Appointments." },
          { key: "scheduledAt", label: "Scheduled At", dataType: "date", renderer: "date", required: true, colSpan: 1, tooltip: "Date (and time if your workflow stores it) when the vehicle is expected. Use for scheduling and reminders." },
          { key: "serviceBayId", label: "Service Bay", dataType: "select", renderer: "select", selectConfig: { label: "WorkshopServiceBay", labelField: "name", relationshipType: "AppointmentServiceBay", limit: 100, edgeOnly: true }, colSpan: 1, tooltip: "Bay or ramp from Directory → Service bays. Stored as a graph edge; the table shows the bay name." }
        ]
      },
      {
        key: "vehicleCustomer",
        title: "Vehicle and Customer",
        gridColumns: 2,
        fields: [
          { key: "customerId", label: "Customer", dataType: "select", renderer: "select", required: true, selectConfig: { label: "WorkshopCustomer", labelField: "name", relationshipType: "AppointmentCustomer", limit: 100, edgeOnly: true }, colSpan: 1, tooltip: "Links this appointment to a customer record. The graph stores the relationship; pick the customer from the list." },
          { key: "customerPhone", label: "Phone", dataType: "text", renderer: "text", colSpan: 1, tooltip: "Contact number for this visit. Can differ from the customer record if you track a mobile for the day." },
          { key: "vehicleId", label: "Vehicle", dataType: "select", renderer: "select", selectConfig: { label: "WorkshopVehicle", labelField: "plate", relationshipType: "AppointmentVehicle", limit: 200, edgeOnly: true }, colSpan: 1, tooltip: "Registered vehicle record (Directory → Vehicles). Plate and model sync to this row for the schedule grid." },
          { key: "vehiclePlate", label: "Plate (override)", dataType: "text", renderer: "text", colSpan: 1, tooltip: "Optional override if no vehicle record is linked, or for temporary plates." },
          { key: "vehicleModel", label: "Vehicle Model", dataType: "text", renderer: "text", colSpan: 1, tooltip: "Make, model, and year or a short description (e.g. Toyota Corolla 2020). Filled from the vehicle record when linked." },
          { key: "serviceId", label: "Service", dataType: "select", renderer: "select", selectConfig: { label: "WorkshopService", labelField: "name", relationshipType: "AppointmentService", limit: 100, edgeOnly: true }, colSpan: 1, tooltip: "Optional link to a catalog service for pricing and reporting." },
          { key: "assignedTechnicianId", label: "Technician", dataType: "select", renderer: "select", selectConfig: { label: "WorkshopTechnician", labelField: "name", relationshipType: "AppointmentTechnician", limit: 100, edgeOnly: true }, colSpan: 1, tooltip: "Primary technician assigned to this appointment." },
          { key: "complaint", label: "Customer Complaint", dataType: "text", renderer: "textArea", colSpan: 2, tooltip: "What the customer reported: symptoms, noises, or work requested. Visible when opening a repair from this appointment." }
        ]
      }
    ]
  },
  uniqueKeys: ["appointmentNo"],
  sidebar: {
    enabled: true,
    parentVertexLabel: "WorkshopAppointmentCategory",
    toParentEdgeType: "WorkshopAppointmentCategoryItem",
    rootKeys: {},
    label: "Appointment categories",
    formConfig: {
      gridColumns: 1,
      groups: [
        {
          key: "basic",
          title: "Folder",
          gridColumns: 2,
          fields: [
            { key: "name", label: "Name", dataType: "text", renderer: "text", required: true, colSpan: 2, tooltip: "Sidebar folder name." },
            { key: "key", label: "Key", dataType: "text", renderer: "text", colSpan: 2, tooltip: "Optional stable key (lowercase, hyphens)." },
            { key: "displayOrder", label: "Sort order", dataType: "number", renderer: "number", colSpan: 2, tooltip: "Lower numbers sort first among siblings." }
          ]
        }
      ]
    }
  },
  hooks: {
    afterCreate: ["workshopAfterAppointmentCreate"]
  }
};`
  },
  {
