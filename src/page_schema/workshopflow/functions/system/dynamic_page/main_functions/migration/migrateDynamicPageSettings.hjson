          { key: "appointmentId", label: "Appointment", dataType: "select", renderer: "select", selectConfig: { label: "WorkshopAppointment", labelField: "appointmentNo", relationshipType: "RepairAppointment", limit: 100, edgeOnly: true }, colSpan: 1, tooltip: "Optional link to the booking this job came from. Leave empty for walk-in work." },
