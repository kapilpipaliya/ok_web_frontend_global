{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: getWorkshopReferenceSequences
        description: Returns all WorkshopReferenceSequence nodes as vertex-shaped rows (ordered by key).
        body:
          '''
const actualUser = await _.getUserFromSession();
if (!actualUser) {
  return { success: false, message: "Not authenticated", data: { sequences: [] } };
}

const res = await _.session.run(
  `MATCH (s:WorkshopReferenceSequence)
   RETURN s
   ORDER BY coalesce(s.key, "") ASC`,
  {}
);

const sequences = _.processResult(res.records, _.context, "s");

return {
  success: true,
  data: { sequences }
};
'''
      }
    }
  ]
  edges: []
}
