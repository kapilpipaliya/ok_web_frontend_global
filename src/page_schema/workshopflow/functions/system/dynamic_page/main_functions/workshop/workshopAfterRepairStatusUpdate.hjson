{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: workshopAfterRepairStatusUpdate
        description: Hook that creates draft invoice, restores inventory when leaving closed, and delegates closed-state deduction to workshopDeductInventoryForClosedRepair.
        body:
          '''
const elementId = args.contextData?.elementId;
if (!elementId) return { success: true, message: "No repair id provided" };

let repairResult = await args.session.run(
  `
  MATCH (r:RepairOrder)
  WHERE elementId(r) = $elementId
  RETURN r
  LIMIT 1
  `,
  { elementId }
);

if (repairResult.records.length === 0) {
  return { success: true, message: "Repair order not found" };
}

let repairNode = repairResult.records[0].get("r");
let repair = args.convertNodeToJson(repairNode);
let status = String(repair.P?.status || "").toLowerCase();

if (status !== "closed" && repair.P?.inventoryDeductedAt) {
  const rst = await args.executeNamedServerFunction({
    functionName: "workshopRestoreInventoryRepairPartLines",
    contextData: { repairElementId: elementId }
  });
  const rr = rst?.result ?? rst;
  if (rr && rr.success === false) {
    throw new Error(rr.message || "Failed to restore inventory for reopened repair");
  }
  repairResult = await args.session.run(
    `
    MATCH (r:RepairOrder)
    WHERE elementId(r) = $elementId
    RETURN r
    LIMIT 1
    `,
    { elementId }
  );
  repairNode = repairResult.records[0].get("r");
  repair = args.convertNodeToJson(repairNode);
  status = String(repair.P?.status || "").toLowerCase();
}

if (status !== "ready-billing" && status !== "closed") {
  return { success: true, message: "Repair not ready for billing" };
}

const repairNo = repair.P?.repairNo;
if (!repairNo) return { success: true, message: "Repair missing number" };

const existingInvoice = await args.session.run(
  `
  MATCH (i:WorkshopInvoice {repairNo: $repairNo})
  RETURN i
  LIMIT 1
  `,
  { repairNo }
);

if (existingInvoice.records.length > 0) {
  // Continue to inventory deduction checks for closed repairs.
} else {
  const resInv = await args.executeNamedServerFunction({
    functionName: "reserveWorkshopReferenceNumber",
    contextData: { sequenceKey: "WorkshopInvoice.invoiceNo" }
  });
  if (resInv?.error || !resInv?.result?.success) {
    return {
      success: false,
      message:
        resInv?.result?.message ||
        resInv?.error ||
        "Could not allocate invoice number (configure Billing → reference sequence)"
    };
  }
  const invoiceNo = resInv.result.data?.value;
  if (!invoiceNo) {
    return { success: false, message: "Reserve returned empty invoice number" };
  }
  const estimate = Number(repair.P?.actualCost || repair.P?.estimatedCost || 0);
  const invoiceDate = new Date().toISOString().slice(0, 10);

  await args.session.run(
    `
    MATCH (r:RepairOrder)
    WHERE elementId(r) = $elementId
    OPTIONAL MATCH (r)-[:RepairCustomer]->(cust:WorkshopCustomer)
    CREATE (i:WorkshopInvoice {
      invoiceNo: $invoiceNo,
      repairNo: $repairNo,
      customerName: coalesce(cust.name, r.customerName, ""),
      invoiceDate: $invoiceDate,
      subTotal: $subTotal,
      taxAmount: 0,
      discountAmount: 0,
      totalAmount: $subTotal,
      paidAmount: 0,
      paymentStatus: "unpaid",
      createdAt: datetime(),
      updatedAt: datetime()
    })
    MERGE (r)-[:RepairOrderInvoice]->(i)
    RETURN i
    `,
    {
      elementId,
      invoiceNo,
      repairNo,
      subTotal: estimate,
      invoiceDate
    }
  );
}

if (status === "closed") {
  const ded = await args.executeNamedServerFunction({
    functionName: "workshopDeductInventoryForClosedRepair",
    contextData: { repairElementId: elementId }
  });
  const dr = ded?.result ?? ded;
  if (dr && dr.success === false) {
    throw new Error(dr.message || "Inventory deduction failed");
  }
}

return { success: true, message: "Repair automation processed successfully" };
'''
      }
    }
  ]
  edges: []
}
