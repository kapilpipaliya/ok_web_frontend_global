{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        key: workshopAfterPaymentCreate
        description: Hook that recalculates linked invoice payment status after payment create or update (amount or invoice link).
        body:
          '''
const elementId = c?.elementId;
if (!elementId) return { success: true, message: "No payment id provided" };

const paymentResult = await _.session.run(
  `
  MATCH (p:WorkshopPayment)
  WHERE elementId(p) = $elementId
  OPTIONAL MATCH (p)-[:PaymentInvoice]->(i:WorkshopInvoice)
  RETURN p, i
  LIMIT 1
  `,
  { elementId }
);

if (paymentResult.records.length === 0) {
  return { success: true, message: "Payment not found" };
}

const paymentNode = paymentResult.records[0].get("p");
const invoiceNode = paymentResult.records[0].get("i");

if (!paymentNode) {
  return { success: true, message: "Payment not found" };
}

if (!invoiceNode) {
  return { success: true, message: "No linked invoice for payment" };
}

const invoiceNo = invoiceNode.properties?.invoiceNo;
if (!invoiceNo) return { success: true, message: "Invoice number not found" };

const totalsResult = await _.session.run(
  `
  MATCH (i:WorkshopInvoice {invoiceNo: $invoiceNo})
  OPTIONAL MATCH (p:WorkshopPayment)-[:PaymentInvoice]->(i)
  RETURN i, coalesce(sum(toFloat(p.amount)), 0) as paid
  LIMIT 1
  `,
  { invoiceNo }
);

if (totalsResult.records.length === 0) {
  return { success: true, message: "Invoice not found while recalculating" };
}

const invoice = totalsResult.records[0].get("i");
const paid = Number(totalsResult.records[0].get("paid") || 0);
const totalAmount = Number(invoice.properties.totalAmount || 0);

let paymentStatus = "unpaid";
if (paid > 0 && paid < totalAmount) paymentStatus = "partial";
if (totalAmount > 0 && paid >= totalAmount) paymentStatus = "paid";

await _.session.run(
  `
  MATCH (i:WorkshopInvoice {invoiceNo: $invoiceNo})
  SET i.paidAmount = $paid,
      i.paymentStatus = $paymentStatus,
      i.updatedAt = datetime()
  RETURN i
  `,
  {
    invoiceNo,
    paid,
    paymentStatus
  }
);

return {
  success: true,
  message: "Invoice payment totals recalculated from payment records"
};
'''
      }
    }
  ]
  edges: []
}
