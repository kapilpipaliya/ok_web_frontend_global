{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        fns: return { enabled: () => true }
        title: FAQ - Decode Files Organizer
        key: ShopifyFileFAQ
        url: /faq
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''return `._id {
  max-width: 800px;
  margin: 0 auto;
  padding: ${t.var.spacing?.lg || "2rem"};
  color: ${t.var.color.text};
}

@media (max-width: 768px) {
  ._id {
    padding: ${t.var.spacing?.md || "1rem"};
  }
}`;'''
        displayOrder: 1
        fns:
          '''
const [expandedIndex, setExpandedIndex] = _.createSignal(null);
const toggleExpanded = (index) => {
  setExpandedIndex((prev) => (prev === index ? null : index));
};
return {
  expandedIndex,
  setExpandedIndex,
  toggleExpanded
};
'''
        componentName: Html
        key: faq_root
        props:
          '''return {
  as: "div"
}'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 2rem;
  font-weight: 700;
  color: ${t.var.color.text};
  margin: 0 0 1rem 0;
}

@media (max-width: 768px) {
  ._id {
    font-size: 1.75rem;
  }
}`;'''
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "h1",
  text: "Frequently asked questions"
}'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 1rem;
  line-height: 1.6;
  color: ${t.var.color.text_light_500};
  margin-bottom: 1.5rem;
}`;'''
        displayOrder: 2
        textType: markdown
        componentName: Html
        text:
          '''Common questions about the **Decode Files Organizer** app.
'''
        props:
          '''return {
  as: "div",
}'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''return `._id {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}`;'''
        displayOrder: 3
        componentName: Html
        props:
          '''return {
  as: "div"
}'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        contextName: faqItem
        css:
          '''return `._id {
  border-radius: 0.75rem;
  border: 1px solid ${t.var.color.border};
  background: ${t.var.color.background_light_100};
  overflow: hidden;
}`;'''
        loop: true
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "div",
  data: [
    { index: 0, q: "How do I organize files into categories?", a: "Use the sidebar to add categories and subcategories. Select a category to see its files. You can move files between categories using the table actions or drag and drop where supported." },
    { index: 1, q: "Can I add custom columns to the files table?", a: "Yes. On the Files page, click Settings. In the configuration, under the columns key, add the required column. Column keys should match the data you want to display." }
  ]
}'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''
return `._id {
  width: 100%;
  text-align: left;
  font-size: 1rem;
  font-weight: 600;
  color: ${t.var.color.text};
  margin: 0;
  padding: 1rem 2.5rem 1rem 1rem;
  border: none;
  background: transparent;
  cursor: pointer;
  position: relative;
}

._id::after {
  content: "";
  position: absolute;
  right: 1rem;
  top: 50%;
  transform: translateY(-50%) rotate(45deg);
  width: 0.5rem;
  height: 0.5rem;
  border-right: 2px solid ${t.var.color.text};
  border-bottom: 2px solid ${t.var.color.text};
  transition: transform 0.2s ease;
}

._id[data-expanded="true"]::after {
  transform: translateY(-50%) rotate(225deg);
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const item = c.faqItem;
const index = item?.index ?? -1;
const isExpanded = f.expandedIndex?.() === index;
return {
  as: "button",
  type: "button",
  text: item?.q || "",
  "data-expanded": isExpanded ? "true" : "false",
  onClick: () => f.toggleExpanded?.(index)
};
'''
      }
    }
    {
      id: "8"
      L: Attr
      P: {
        css:
          '''
return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${t.var.color.text_light_500};
  margin: 0;
  padding: 0 1rem 1rem 1rem;
  border-top: 1px solid ${t.var.color.border};
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''
const item = c.faqItem;
const index = item?.index ?? -1;
return {
  as: "p",
  text: item?.a || "",
  show: () => f.expandedIndex?.() === index
};
'''
      }
    }
    {
      id: "9"
      L: Attr
      P: {
        css:
          '''return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${t.var.color.text_light_500};
  margin-top: 1.5rem;
}`;'''
        displayOrder: 4
        textType: markdown
        componentName: Html
        text:
          '''Need more help? Visit the [Support](/support) page to create a request and talk to our team.
'''
        props:
          '''return {
  as: "div",
}'''
      }
    }
    {
      id: "10"
      L: PageLayout
      P: {
        componentName: ShopifyLayout
      }
    }
  ]
  edges: [
    {
      id: e1
