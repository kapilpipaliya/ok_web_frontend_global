{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        public: true
        fns: return { enabled: () => true }
        title: Decode Files Organizer – Organize and manage your Shopify files
        key: ShopifyFileHome
        url: /
        props:
          '''return {
  isNoPermissionCheck: true
}'''
      }
    }
    {
      id: "2"
