      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''return {
  as: "meta",
  name: "description",
  content: "Decode Files Organizer helps you organize your Shopify file catalog in nested categories. View files by category. Available in the Shopify App Store."
}'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''return `._id {
  max-width: 800px;
  margin: 0 auto;
  padding: ${args.theme.var.spacing?.lg || "2rem"};
  color: ${args.theme.var.color.text};
}

@media (max-width: 768px) {
  ._id {
    padding: ${args.theme.var.spacing?.md || "1rem"};
  }
}`;'''
        displayOrder: 3
        componentName: Html
        props:
          '''return {
  as: "main"
}'''
      }
    }
    {
      id: "4"
      L: Attr
