}`;'''
        displayOrder: 4
        textType: markdown
        componentName: Html
        text:
          '''**Support and help:** Use the [Support](/support) page to contact the team, and check [FAQ](/faq), [Documentation](/docs), and [Tutorial](/tutorial) from the app for answers and step-by-step guidance.
'''
        props:
          '''return {
  as: "p",
}'''
