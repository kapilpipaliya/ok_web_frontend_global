      P: {
        css:
          '''return `._id {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin: 0;
}`;'''
        displayOrder: 2
        textType: markdown
        componentName: Html
        text:
          '''First, go to the Shopify App Store and install the **Decode Files Organizer** app. After you authorize it, open the app from your Shopify admin. Your files will sync from Shopify into the app. Use the sidebar to add categories and assign files to them. Click a file row to open it in Shopify admin.
'''
        props:
          '''return {
  as: "p",
}'''
      }
    }
    {
