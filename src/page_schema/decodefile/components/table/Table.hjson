        displayOrder: 1
        componentName: Html
        props:
          '''
const showSelection = args.fns.getShowSelection();
const selected = args.fns.getSelectedRows();
const filtered = args.fns.filteredData();
const allSelected = filtered.length > 0 && filtered.every(row => row.id && selected.has(row.id));
// const usePolaris = args.fns.getUsePolarisUI?.() === true;
const usePolaris = false;

return {
  as: usePolaris ? "s-checkbox" : "input",
  type: usePolaris ? undefined : "checkbox",
  "attr:checked": usePolaris && allSelected ? true : undefined,
  "attr:accessibilityLabel": usePolaris ? "Select all rows" : undefined,
  checked: usePolaris ? undefined : allSelected,
  onChange: usePolaris ? (e) => {
    const checked = e.target?.checked ?? e.detail?.checked ?? !allSelected;
    if (checked) args.fns.selectAllRows();
    else args.fns.clearSelection();
  } : () => {
    if (allSelected) args.fns.clearSelection();
    else args.fns.selectAllRows();
  },
  hide: !showSelection
};
'''
      }
    }
