{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        dynamicComponent: TomSelect
        fns:
          '''

const getColumns = () => {
  const base = args.fns.prop('columns') || [];
  const groupBy = getGroupByConfig();
  if (groupBy) return [{ key: '__expand', type: 'expand', width: '32px', label: '' }, ...base];
  return base;
};

const getRowHeight = () => args.fns.prop('rowHeight') || 36;
const getTitle = () => args.fns.prop('title');
const getSearchPlaceholder = () => args.fns.prop('searchPlaceholder') || "Search...";
const getAdditionalFilters = () => args.fns.prop('additionalFilters') || [];
const getCustomActions = () => args.fns.prop('customActions') || [];
const getBatchActions = () => args.fns.prop('batchActions') || [];
const getShowRowNumber = () => args.fns.prop('showRowNumber') || false;
const getHideColumns = () => args.fns.prop('hideColumns') || [];

const getUniqueKeys = () => args.fns.prop('uniqueKeys') || [];
const getShowAddButton = () => args.fns.prop('showAddButton') ?? true;
const getShowEditButton = () => args.fns.prop('showEditButton') ?? true;
const getShowSelection = () => args.fns.prop('showSelection');
const getShowActions = () => args.fns.prop('showActions');
const getResizableColumns = () => args.fns.prop('resizableColumns') ?? true;
const getHideExportButtons = () => args.fns.prop('hideExportButtons') ?? false;
const getHideImportButtons = () => args.fns.prop('hideImportButtons') ?? false;
const getHideSettingsButton = () => args.fns.prop('hideSettingsButton') ?? false;
const getIcon = () => args.fns.prop('icon');
const getLabel = () => args.fns.prop('label');
const getAddButtonLabel = () => {
  const label = getLabel();
  return label ? `Add new ${label}` : "Add New Item";
};
const getOnEdit = () => args.fns.prop('onEdit');
const getOnAfterAdd = () => args.fns.prop('onAfterAdd');
const getOnAfterEdit = () => args.fns.prop('onAfterEdit');
const getOnAdd = () => args.fns.prop('onAdd');
const getOnDelete = () => args.fns.prop('onDelete');
const getOnAfterDelete = () => args.fns.prop('onAfterDelete');
const getRowClickable = () => args.fns.prop('rowClickable') === true;
const getOnRowClick = () => args.fns.prop('onRowClick');

const [data, setData] = args.createSignal([]);
const [filteredData, setFilteredData] = args.createSignal([]);

const getGroupByConfig = () => args.fns.prop('groupBy') || null;
const [collapsedKeys, setCollapsedKeys] = args.createStore({});
const toggleExpanded = (key) => {
  if (collapsedKeys[key]) {
    setCollapsedKeys(key, undefined);
  } else {
    setCollapsedKeys(key, true);
  }
};
// Cache row objects by id so same row keeps same ref; cells then don't re-render when only expand/collapse changes
let displayRowCache = {};
const buildDisplayData = (filtered, groupByKey, collapsedObj) => {
  if (!filtered || filtered.length === 0) return [];
  const getKey = (row) => {
    const val = row?.P?.[groupByKey] ?? row?.[groupByKey];
    return val != null ? String(val) : '';
  };
  const groups = new Map();
  const keyOrder = [];
  for (const row of filtered) {
    const k = getKey(row);
    if (!groups.has(k)) {
      groups.set(k, []);
      keyOrder.push(k);
    }
    groups.get(k).push(row);
  }
  const result = [];
  const usedIds = new Set();
  for (const key of keyOrder) {
    const rows = groups.get(key) || [];
    const first = rows[0];
    const parentId = 'group-' + key;
    usedIds.add(parentId);
    let parentRow = displayRowCache[parentId];
    if (parentRow) {
      parentRow._isParent = true;
      parentRow._parentKey = key;
      parentRow.P = first?.P ? { ...first.P } : { [groupByKey]: key };
    } else {
      parentRow = { id: parentId, _isParent: true, _parentKey: key, P: first?.P ? { ...first.P } : { [groupByKey]: key } };
      displayRowCache[parentId] = parentRow;
    }
    result.push(parentRow);
    if (!collapsedObj[key]) {
      for (const r of rows) {
        const id = r?.id ?? r?.P?.id;
        const rowId = id != null ? String(id) : 'row-' + key + '-' + result.length;
        usedIds.add(rowId);
        let childRow = displayRowCache[rowId];
        if (childRow) {
          Object.assign(childRow, { ...r, _isParent: false, _parentKey: key });
        } else {
          childRow = { ...r, _isParent: false, _parentKey: key };
          displayRowCache[rowId] = childRow;
        }
        result.push(childRow);
      }
    }
  }
  Object.keys(displayRowCache).forEach(k => { if (!usedIds.has(k)) delete displayRowCache[k]; });
  return result;
};
const getDisplayData = () => {
  const g = getGroupByConfig();
  const filtered = filteredData() || [];
  if (!g) return filtered;
  const key = typeof g === 'string' ? g : (g.key || '');
  if (!key) return filtered;
  return buildDisplayData(filtered, key, collapsedKeys);
};

const [searchTerm, setSearchTerm] = args.createSignal("");
const [columnFilters, setColumnFilters] = args.createStore({});
const [sortConfig, setSortConfig] = args.createStore({ column: null, direction: null });
// Get selected rows functions from props (always provided by parent)
const getSelectedRows = () => {
  const propFn = args.contextData.props?.getSelectedRows;
  if (!propFn) {
    console.warn("getSelectedRows not provided to Table component");
    return new Set();
  }
  return propFn();
};

// Selection filtered to current display data - avoids stale selection (e.g. after move or category switch)
const getEffectiveSelectedRows = () => {
  const selected = getSelectedRows();
  const displayed = getDisplayData();
  const currentIds = new Set((displayed || []).map(r => r?.id).filter(Boolean));
  if (currentIds.size === 0) return new Set();
  return new Set([...selected].filter(id => currentIds.has(id)));
};
const setSelectedRows = (newSelected) => {
  const propFn = args.contextData.props?.setSelectedRows;
  if (!propFn) {
    console.warn("setSelectedRows not provided to Table component");
    return;
  }
  propFn(newSelected);
};
const clearSelectedRows = () => {
  const propFn = args.contextData.props?.clearSelectedRows;
  if (!propFn) {
    console.warn("clearSelectedRows not provided to Table component");
    return;
  }
  propFn();
};
const [isModalOpen, setIsModalOpen] = args.createSignal(false);
const [modalMode, setModalMode] = args.createSignal("add"); // "add" or "edit"
const [editingRow, setEditingRow] = args.createSignal(null);
const [formData, setFormData] = args.createStore({});
const [isImportModalOpen, setIsImportModalOpen] = args.createSignal(false);
const [importData, setImportData] = args.createSignal("");
const [columnWidths, setColumnWidths] = args.createStore({});
const [isResizing, setIsResizing] = args.createSignal(false);
const pollRef = { id: null };
const rowRefs = {};
const setRowRef = (index, el) => {
  if (el) rowRefs[index] = el;
  else delete rowRefs[index];
};
const getRowRef = (index) => rowRefs[index];

// Initialize from query parameters
const initializeFromQueryParams = () => {
  const searchParams = args.searchParams || {};
  if (searchParams.search) {
    setSearchTerm(searchParams.search);
  }
  if (searchParams.filters) {
    try {
      const filters = JSON.parse(searchParams.filters);
      setColumnFilters(filters);
      // Apply filters after restoring from URL
      // Use setTimeout to ensure store update is complete
      setTimeout(() => {
        applyLocalFilters();
      }, 0);
    } catch (e) {
      console.error("Error parsing filters from query:", e);
    }
  }
  if (searchParams.sort) {
    try {
      const sort = JSON.parse(searchParams.sort);
      setSortConfig(sort);
    } catch (e) {
      console.error("Error parsing sort from query:", e);
    }
  }
};

// Update query parameters
const updateQueryParams = () => {
  const params = {};
  // Handle searchTerm
  if (searchTerm()) {
    params.search = searchTerm();
  } else {
    // Clear search param if searchTerm is empty
    params.search = undefined;
  }
  // Handle filters
  const filters = Object.keys(columnFilters).length > 0 ? JSON.stringify(columnFilters) : null;
  if (filters) {
    params.filters = filters;
  } else {
    // Clear filters param if no filters
    params.filters = undefined;
  }
  // Handle sort
  const sort = sortConfig.column ? JSON.stringify(sortConfig) : null;
  if (sort) {
    params.sort = sort;
  } else {
    // Clear sort param if no sort
    params.sort = undefined;
  }
  args.setSearchParams?.(params, { replace: true });
};



// Apply local filters (for table header row filters)
const applyLocalFilters = () => {
  const dataSource = data();
  let filtered = [...dataSource];

  // Apply search term
  if (searchTerm()) {
    const term = searchTerm().toLowerCase();
    const columns = getColumns().filter(col => !shouldHideColumn(col));

    filtered = filtered.filter(row => {
      // Only check values for visible columns, not keys
      for (const col of columns) {
        // Skip special/row number columns
        if (col.key === "__rowNumber" || col.type === "rowNumber") {
          continue;
        }
        const cellValue = getCellValue(row, col);
        if (
          cellValue !== null &&
          cellValue !== undefined &&
          String(cellValue).toLowerCase().includes(term)
        ) {
          return true;
        }
      }
      return false;
    });
  }

  // Apply column filters
  const columns = getColumns();
  filtered = filtered.filter(row => {
    for (const col of columns) {
      const filterValue = columnFilters[col.key];
      if (filterValue !== undefined && filterValue !== null && filterValue !== "") {
        // Skip rowNumber filter - it's calculated, not a property
        if (col.key === "__rowNumber" || col.type === "rowNumber") {
          continue;
        }
        const cellValue = getCellValue(row, col);
        if (col.type === "text") {
          // Support both single value and array (for multiple select filters)
          if (Array.isArray(filterValue)) {
            if (filterValue.length === 0) {
              return true; // No filter applied
            }
            // Check if cell value matches any of the selected filter values
            const cellValueStr = String(cellValue || "").toLowerCase();
            const matches = filterValue.some(fv => 
              cellValueStr.includes(String(fv).toLowerCase())
            );
            if (!matches) {
              return false;
            }
          } else {
            // Single value filter
            if (!String(cellValue || "").toLowerCase().includes(String(filterValue).toLowerCase())) {
              return false;
            }
          }
        } else if (col.type === "select") {
          // Support both single value and array (multiple select)
          if (Array.isArray(filterValue)) {
            if (filterValue.length === 0 || !filterValue.includes(cellValue)) {
              return false;
            }
          } else {
            if (cellValue !== filterValue) {
              return false;
            }
          }
        } else if (col.type === "checkbox") {
          if (cellValue !== filterValue) {
            return false;
          }
        } else if (col.type === "date" || col.type === "isoDateTime") {
          // Date filtering logic
          const filterDate = new Date(filterValue);
          const cellDate = new Date(cellValue);
          if (isNaN(filterDate.getTime()) || isNaN(cellDate.getTime())) {
            return false;
          }
          // Simple date comparison - can be enhanced
          if (Math.abs(cellDate - filterDate) > 86400000) { // More than 1 day difference
            return false;
          }
        } else if (col.type === "badge") {
          // Badge columns: partial match on raw value or display label (e.g. "Act" matches "Active")
          const cellVal = cellValue != null ? String(cellValue) : "";
          const cellKey = col.badgeKeyCase === "lower" ? cellVal.toLowerCase() : cellVal;
          const cellLabel = (col.badgeToneMap && col.badgeToneMap[cellValue] && Array.isArray(col.badgeToneMap[cellValue])) ? col.badgeToneMap[cellValue][0] : cellVal;
          const cellLabelNorm = col.badgeKeyCase === "lower" ? String(cellLabel).toLowerCase() : cellLabel;
          const matchOne = (fv) => {
            const fk = col.badgeKeyCase === "lower" ? String(fv).toLowerCase() : String(fv);
            if (!fk) return true;
            return cellKey.includes(fk) || cellLabelNorm.includes(fk);
          };
          if (Array.isArray(filterValue)) {
            if (filterValue.length === 0) return true;
            if (!filterValue.some(matchOne)) return false;
          } else {
            if (!matchOne(filterValue)) return false;
          }
        }
      }
    }
    return true;
  });

  // Apply sorting
  if (sortConfig.column) {
    const sortColumn = columns.find(col => col.key === sortConfig.column);
    if (sortColumn) {
      filtered.sort((a, b) => {
        const aVal = getCellValue(a, sortColumn);
        const bVal = getCellValue(b, sortColumn);
        if (aVal === bVal) return 0;
        const comparison = aVal > bVal ? 1 : -1;
        return sortConfig.direction === "asc" ? comparison : -comparison;
      });
    }
  }

  setFilteredData(filtered);
};

// Update category contentCount based on fetched data length when local filters are enabled
const updateCategoryCountFromFetchedData = (fetchedData, categoryItem) => {
  // Use the category item passed from fetchData, not the currently selected item
  // This ensures we update the count for the category that was actually fetched
  if (!categoryItem) return;
  
  const config = args.fns.evaluateConfig?.() || {};
  const sidebarConfig = config?.sidebar;
  if (!sidebarConfig) return;
  
  const rootKeys = sidebarConfig.rootKeys || {};
  const rootKey = rootKeys.key;
  
  // Determine category ID from the category item that was used for fetching
  const isUncategorized = categoryItem.P?.key === rootKey || categoryItem.P?.key === 'uncategorized' || categoryItem.id === 'uncategorized';
  const categoryId = isUncategorized ? 'uncategorized' : categoryItem.id;
  
  if (!categoryId) return;
  
  // Get current count from graph
  let currentCount = 0;
  if (isUncategorized) {
    const uncategorizedVertex = args.graph?.vertexes?.['uncategorized'];
    currentCount = uncategorizedVertex?.P?.contentCount ?? 0;
  } else {
    const categoryVertex = args.graph?.vertexes?.[categoryId];
    currentCount = categoryVertex?.P?.contentCount ?? 0;
  }
  
  // Update count if different - use fetched data length (before filtering)
  const fetchedLength = fetchedData?.length ?? 0;
  if (currentCount !== fetchedLength) {
    if (isUncategorized) {
      const uncategorizedVertex = args.graph?.vertexes?.['uncategorized'];
      if (uncategorizedVertex) {
        args.mergeVertexProperties(0, 'uncategorized', args.graph, args.setGraph, {
          contentCount: fetchedLength
        });
      }
    } else {
      const categoryVertex = args.graph?.vertexes?.[categoryId];
      if (categoryVertex) {
        args.mergeVertexProperties(0, categoryId, args.graph, args.setGraph, {
          contentCount: fetchedLength
        });
      }
    }
  }
};

const debouncedSetSearchTerm = args.debounce(value => {
  setSearchTerm(value);
  
  // Check if local filters are enabled
  const config = args.fns.evaluateConfig?.() || {};
  const enableLocalFilters = config?.enableLocalFilters === true;
  
  if (enableLocalFilters) {
    // Apply local filters only
    applyLocalFilters();
  } else {
    // Server-side search - trigger search
    handleSearch();
  }
  updateQueryParams();
}, 500);

// Get cell value from row
const getCellValue = (row, column) => {
  if (column.valueAccessor) {
    return column.valueAccessor(row);
  }
  if (column.key.includes(".")) {
    const keys = column.key.split(".");
    let value = row;
    for (const key of keys) {
      value = value?.[key];
      if (value === undefined) return null;
    }
    return value;
  }
  if (row.P) {
    return row.P[column.key];
  }
  return row[column.key];
};

// Render cell content based on column type
const renderCellContent = (row, column, rowIndex) => {
  if (column.type === 'expand' || column.key === '__expand') {
    const parentKey = row._parentKey;
    const isParent = row._isParent === true;
    const isExpanded = parentKey != null && !collapsedKeys[parentKey];
    return { type: 'expand', isParent, isExpanded, parentKey, onToggle: () => toggleExpanded(parentKey) };
  }
  const value = getCellValue(row, column);

  if (column.type === "rowNumber") {
    return rowIndex + 1;
  }

  if (column.render) {
    return column.render(value, row, column);
  }

  if (column.type === "checkbox") {
    return value ? "✓" : "";
  }

  if (column.type === "image" || column.type === "imagePreview") {
    const imageUrl = value || column.defaultImage;
    return imageUrl ? { type: "image", url: imageUrl, alt: column.alt || "" } : "";
  }

  if (column.type === "youtubeLink") {
    const videoId = value || column.videoIdAccessor?.(row);
    if (!videoId) return "";
    return { type: "youtubeLink", videoId };
  }

  if (column.type === "downloadLink") {
    const url = value || column.urlAccessor?.(row);
    const icon = column.icon || "carbon:download";
    if (!url) return "";
    return { type: "downloadLink", url, icon };
  }

  if (column.type === "duration") {
    if (!value) return "";
    const seconds = typeof value === "number" ? value : parseInt(value);
    if (isNaN(seconds)) return value;
    const hours = Math.floor(seconds / 3600);
    const minutes = Math.floor((seconds % 3600) / 60);
    const secs = seconds % 60;
    if (hours > 0) {
      return `${hours}:${String(minutes).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
    }
    return `${minutes}:${String(secs).padStart(2, "0")}`;
  }

  if (column.type === "date") {
    if (!value) return "";
    const date = new Date(value);
    if (isNaN(date.getTime())) return value;
    return date.toLocaleDateString();
  }

  if (column.type === "isoDateTime") {
    if (!value) return "";
    const date = new Date(value);
    if (isNaN(date.getTime())) return value;
    return date.toLocaleString();
  }

  if (column.type === "join") {
    if (!value || !Array.isArray(value)) return "";
    const separator = column.separator || ", ";
    const displayKey = column.displayKey || "name";
    return value.map(item => {
      if (typeof item === "string") return item;
      if (item.P) return item.P[displayKey] || item.P.name || "";
      return item[displayKey] || item.name || "";
    }).join(separator);
  }

  if (column.type === "actions") {
    return { type: "actions", row, column };
  }

  if (column.type === "badge") {
    const map = column.badgeToneMap || {};
    const v = (value || "").toString();
    const key = (column.badgeKeyCase === "lower" ? v.toLowerCase() : v);
    const entry = map[key];
    const [text, tone] = Array.isArray(entry) ? entry : [v || "", "neutral"];
    return { type: "badge", text, tone };
  }

  // Default: return as string
  return value !== null && value !== undefined ? String(value) : "";
};

// Handle sort
const handleSort = (column) => {
  // Don't allow sorting for rowNumber columns
  if (column.type === "rowNumber" || column.key === "__rowNumber") return;
  if (column.sortable === false) return;

  // If clicking the same column that's already sorted
  if (sortConfig.column === column.key) {
    // If currently ascending, switch to descending
    if (sortConfig.direction === "asc") {
      setSortConfig({ column: column.key, direction: "desc" });
    } 
    // If currently descending, clear the sort
    else if (sortConfig.direction === "desc") {
      setSortConfig({ column: null, direction: null });
    }
  } else {
    // New column, start with ascending
    setSortConfig({ column: column.key, direction: "asc" });
  }

  // Check if local sort is enabled
  const config = args.fns.evaluateConfig?.() || {};
  const enableLocalSort = config?.enableLocalSort === true;
  
  if (enableLocalSort) {
    // Apply local sort only
    applyLocalFilters();
  } else {
    // Server-side sort - trigger search
    handleSearch();
  }
  updateQueryParams();
};

// Get unique values for a column
const getUniqueColumnValues = (column) => {
  const allData = data();
  const uniqueValues = new Set();

  allData.forEach(row => {
    const value = getCellValue(row, column);
    if (value !== null && value !== undefined && value !== "") {
      uniqueValues.add(String(value));
    }
  });

  return Array.from(uniqueValues).sort();
};

// Common function to create select filter component props
const getSelectFilterProps = (columnKey, filterValue, options) => {
  // Normalize filterValue to array for multiple select
  // Ensure values match option values exactly
  // If "_All_VALUES_" is present, don't include it in the display value
  let normalizedValue = Array.isArray(filterValue) 
    ? filterValue.filter(v => v !== null && v !== undefined && v !== "" && v !== "_All_VALUES_")
    : (filterValue && filterValue !== "_All_VALUES_" ? [filterValue] : []);
  
  // If filter is cleared (undefined), pass empty array to clear TomSelect
  // TomSelect needs empty array for multiple mode to show as cleared
  const displayValue = filterValue === undefined ? [] : normalizedValue;
  
  // Check if filter is currently empty
  const isFilterEmpty = filterValue === undefined || 
    (Array.isArray(filterValue) && filterValue.length === 0) ||
    filterValue === null || filterValue === "";

  return {
    componentName: "TomSelect",
    value: displayValue,
    onChange: (newValue) => {
      // If "All" is selected
      if (Array.isArray(newValue) && newValue.includes("_All_VALUES_")) {
        // clear all filters
        handleColumnFilterChange(columnKey, ["_All_VALUES_"]);
      } else {
        handleColumnFilterChange(columnKey, newValue);
      }
    },
    options: options,
    search: options.length > 10, // Enable search if many options
    multiple: true
  };
};

// Handle column filter change
const handleColumnFilterChange = (columnKey, value) => {
  // Handle array values (multiple select)
  let filterValue;
  setColumnFilters(columnKey, value ? JSON.parse(JSON.stringify(value)) : value);
  if (Array.isArray(value)) {
    // If "_All_VALUES_" is selected, clear all filters for this column
    if (value.includes("_All_VALUES_")) {
      filterValue = undefined;
    } else {
      // Remove "_All_VALUES_" if present and filter out empty values
      const filtered = value.filter(v => v !== "_All_VALUES_" && v !== "" && v !== null && v !== undefined);
      filterValue = filtered.length === 0 ? undefined : filtered;
    }
  } else {
    // Single value - clear if "All" or empty
    filterValue = value === "_All_VALUES_" || value === "" || value === null || value === undefined ? undefined : value;
  }

  if (filterValue === undefined) {
    // Remove the filter key from columnFilters
    setColumnFilters(columnKey, undefined);
  }

  // Check if local filters are enabled
  const config = args.fns.evaluateConfig?.() || {};
  const enableLocalFilters = config?.enableLocalFilters === true;
  
  if (enableLocalFilters) {
    // Apply local filters only
    applyLocalFilters();
  } else {
    // Server-side filters - trigger search
    handleSearch();
  }
  updateQueryParams();
};

// Background poll: fetch only queued row ids and merge updates (no full reload, no loader)
const pollQueuedRows = async () => {
  const config = args.fns.evaluateConfig?.() || {};
  const intervalMs = config?.refetchIntervalWhenQueued;
  const currentData = data();
  const queuedIds = (Array.isArray(currentData) ? currentData : [])
    .filter(r => (r.P?.syncStatus) === 'queued')
    .map(r => r.id)
    .filter(id => id !== undefined && id !== null);
  if (queuedIds.length === 0 || !intervalMs) return;
  const refresh = args.fns.refreshQueuedRows;
  if (!refresh || typeof refresh !== 'function') return;
  try {
    const result = await refresh(queuedIds);
    const updated = result?.data;
    if (Array.isArray(updated) && updated.length > 0) {
      const updatedMap = new Map(updated.map(row => [row.id, row]));
      const newData = currentData.map(row => updatedMap.get(row.id) || row);
      setData(newData);
      applyLocalFilters();
      const stillQueued = newData.some(r => (r.P?.syncStatus) === 'queued');
      if (stillQueued && pollRef.id === null) {
        pollRef.id = setTimeout(() => {
          pollRef.id = null;
          pollQueuedRows();
        }, intervalMs);
      }
    } else {
      if (pollRef.id === null) {
        pollRef.id = setTimeout(() => {
          pollRef.id = null;
          pollQueuedRows();
        }, intervalMs);
      }
    }
  } catch (e) {
    console.error("pollQueuedRows:", e);
    if (pollRef.id === null) {
      pollRef.id = setTimeout(() => {
        pollRef.id = null;
        pollQueuedRows();
      }, intervalMs);
    }
  }
};

// Start background poll when any row has syncStatus 'queued'. Pass optional data array to check; if omitted, uses current data().
const startPollIfQueued = (dataToCheck) => {
  const rows = dataToCheck !== undefined ? dataToCheck : data();
  if (pollRef.id) {
    clearTimeout(pollRef.id);
    pollRef.id = null;
  }
  const config = args.fns.evaluateConfig?.() || {};
  const intervalMs = config?.refetchIntervalWhenQueued;
  const refresh = args.fns.refreshQueuedRows;
  const hasQueued = Array.isArray(rows) && rows.some(r => (r.P?.syncStatus) === 'queued');
  if (intervalMs && refresh && typeof refresh === 'function' && hasQueued) {
    pollRef.id = setTimeout(() => {
      pollRef.id = null;
      pollQueuedRows();
    }, intervalMs);
  }
};

// Handle search
const handleSearch = () => {
  const config = args.fns.evaluateConfig?.() || {};
  const enableLocalFilters = config?.enableLocalFilters === true;
  const enableLocalSort = config?.enableLocalSort === true;
  
  // If local filters/sort are enabled, fetch all data and apply locally
  // Otherwise, pass filters/sort to server
  args.fns.fetchData(
    enableLocalFilters ? undefined : searchTerm(), 
    enableLocalFilters ? undefined : columnFilters, 
    enableLocalSort ? undefined : sortConfig, 
    (data, categoryItem) => {
      setData(data);
      
      // Update category count with fetched data length if local filters are enabled
      // Pass the categoryItem that was used for fetching, not the currently selected item
      if (enableLocalFilters) {
        updateCategoryCountFromFetchedData(data, categoryItem);
      }
      
      // Always apply local filters if enabled, or if server didn't filter
      if (enableLocalFilters || enableLocalSort) {
        applyLocalFilters();
      } else {
        // Server already filtered, just set filtered data to match data
        setFilteredData(data);
      }
      
      startPollIfQueued(data);
    }
  );
};

// Handle row selection (using vertex IDs)
const toggleRowSelection = (vertexId) => {
  const currentSelected = getSelectedRows();
  const newSelected = new Set(currentSelected);
  if (newSelected.has(vertexId)) {
    newSelected.delete(vertexId);
  } else {
    newSelected.add(vertexId);
  }
  setSelectedRows(newSelected);
};

const selectAllRows = () => {
  const displayed = getDisplayData();
  const allVertexIds = new Set((displayed || []).map(row => row.id).filter(id => id !== undefined && id !== null));
  setSelectedRows(allVertexIds);
};

const clearSelection = () => {
  clearSelectedRows();
};

// Shift+Arrow: anchor index for range selection (null when not extending)
const [selectionAnchorIndex, setSelectionAnchorIndex] = args.createSignal(null);
const clearSelectionAnchor = () => setSelectionAnchorIndex(null);
const selectRange = (fromIndex, toIndex) => {
  const displayed = getDisplayData();
  if (!displayed || displayed.length === 0) return;
  const lo = Math.max(0, Math.min(fromIndex, toIndex));
  const hi = Math.min(displayed.length - 1, Math.max(fromIndex, toIndex));
  const ids = [];
  for (let i = lo; i <= hi; i++) {
    const r = displayed[i];
    if (r?.id) ids.push(r.id);
  }
  setSelectedRows(new Set(ids));
};
const handleShiftArrow = (currentIndex, nextIndex) => {
  if (!getShowSelection()) return;
  let anchor = selectionAnchorIndex();
  if (anchor == null) {
    anchor = currentIndex;
    setSelectionAnchorIndex(anchor);
  }
  selectRange(anchor, nextIndex);
  setActiveRowId(getDisplayData()?.[nextIndex]?.id ?? null);
};

// Keyboard: active row by id (null = none); index derived from data so no createEffect needed
const [activeRowId, setActiveRowId] = args.createSignal(null);
const getActiveRowIndex = () => {
  const id = activeRowId();
  if (id == null) return -1;
  const displayed = getDisplayData();
  const idx = (displayed && displayed.findIndex((r) => r && r.id === id)) ?? -1;
  return idx >= 0 ? idx : -1;
};

// Handle add/edit
const handleAdd = async () => {
  const onAdd = getOnAdd();
  
  // If onAdd function is provided, call it instead of opening modal
  if (onAdd && typeof onAdd === 'function') {
    try {
      await onAdd();
      return;
    } catch (error) {
      console.error("Error in onAdd function:", error);
      args.showErrorToast?.(error?.message || "Failed to execute add action");
      return;
    }
  }
  
  // Default behavior: open add modal
  setModalMode("add");
  setEditingRow(null);
  setFormData(null);
  setIsModalOpen(true);
};

const handleEdit = async (row) => {
  const onEdit = getOnEdit();
  
  // If onEdit function is provided, call it instead of opening modal
  if (onEdit && typeof onEdit === 'function') {
    try {
      await onEdit(row, args);
      return;
    } catch (error) {
      console.error("Error in onEdit function:", error);
      args.showErrorToast?.(error?.message || "Failed to execute edit action");
      return;
    }
  }
  
  // Default behavior: open edit modal
  setModalMode("edit");
  setEditingRow(row);
  // Set form data directly from row vertex
  setFormData(row);
  setIsModalOpen(true);
};

const handleViewRow = (row) => {
  setModalMode("view");
  setEditingRow(row);
  setFormData(row);
  setIsModalOpen(true);
};

const handleSave = async (formDataToSave) => {
  const formConfig = args.fns.getFormConfig();
  if (!formConfig?.saveFunction) {
    args.showErrorToast?.("Save function not configured");
    return;
  }

  try {
    args.fns.setLoading(true);
    const result = await formConfig.saveFunction({
      mode: modalMode(),
      data: formDataToSave,
      originalRow: editingRow()
    });

    if (result?.success) {
      args.showSuccessToast?.(
        modalMode() === "add" ? "Item added successfully" : "Item updated successfully"
      );
      setIsModalOpen(false);
      // Optimistic update
      if (modalMode() === "add") {
        setData([...data(), result.data]);
        
        // Check if onAfterAdd function is provided
        const onAfterAdd = getOnAfterAdd();
        if (onAfterAdd && typeof onAfterAdd === 'function') {
          try {
            await onAfterAdd(result, args);
          } catch (error) {
            console.error("Error in onAfterAdd function:", error);
            args.showErrorToast?.(error?.message || "Failed to execute after add action");
          }
        }
      } else {
        const updated = data().map(row => 
          row.id === editingRow()?.id ? result.data : row
        );
        setData(updated);
        
        // Check if onAfterEdit function is provided
        const onAfterEdit = getOnAfterEdit();
        if (onAfterEdit && typeof onAfterEdit === 'function') {
          try {
            await onAfterEdit(result, args);
          } catch (error) {
            console.error("Error in onAfterEdit function:", error);
            args.showErrorToast?.(error?.message || "Failed to execute after edit action");
          }
        }
      }
      applyLocalFilters();
      startPollIfQueued();
      return true;
    } else {
      const errorMsg = result?.message || result?.error || "Failed to save";
      args.showErrorToast?.(errorMsg);
      return false;
    }
  } catch (error) {
    console.error("Error saving:", error);
    const errorMsg = error?.message || error?.error || "Failed to save item";
    args.showErrorToast?.(errorMsg);
    return false;
  } finally {
    args.fns.setLoading(false);
  }
};

// Handle delete
const handleDelete = async (row) => {
  const onDelete = getOnDelete();
  
  // If onDelete function is provided, call it instead of default delete
  if (onDelete && typeof onDelete === 'function') {
    try {
      await onDelete(row);
      return;
    } catch (error) {
      console.error("Error in onDelete function:", error);
      args.showErrorToast?.(error?.message || "Failed to execute delete action");
      return;
    }
  }
  
  // Default behavior: use formConfig saveFunction
  const formConfig = args.fns.getFormConfig();
  if (!formConfig?.saveFunction) {
    args.showErrorToast?.("Delete function not configured");
    return;
  }

  // Use rbConfirm if available
  const rbConfirm = args.contextData?.confirmContext?.rbConfirm || args.fns?.rbConfirm;
  if (rbConfirm) {
    const confirmed = await rbConfirm({
      title: "Delete Item",
      message: "Are you sure you want to delete this item? This action cannot be undone.",
      confirmText: "Delete",
      cancelText: "Cancel",
      variant: "danger"
    });
    if (!confirmed) {
      return;
    }
  } else {
    // Fallback to browser confirm
    if (!confirm("Are you sure you want to delete this item?")) {
      return;
    }
  }

  try {
    args.fns.setLoading(true);
    // For delete, pass the row as vertex in the new data format
    const deleteData = {
      vertex: row,
      relationships: {}
    };
    const result = await formConfig.saveFunction({
      mode: "delete",
      data: deleteData,
      originalRow: row
    });

    if (result?.success) {
      const label = getLabel();
      args.showSuccessToast?.(label ? `${label} deleted successfully` : "Item deleted successfully");
      // Remove from data
      const updated = data().filter(item => item.id !== row.id);
      setData(updated);
      applyLocalFilters(updated);
      
      // Check if onAfterDelete function is provided
      const onAfterDelete = getOnAfterDelete();
      if (onAfterDelete && typeof onAfterDelete === 'function') {
        try {
          await onAfterDelete(result, row, args);
        } catch (error) {
          console.error("Error in onAfterDelete function:", error);
          args.showErrorToast?.(error?.message || "Failed to execute after delete action");
        }
      }
    } else {
      const errorMsg = result?.message || result?.error || "Failed to delete";
      args.showErrorToast?.(errorMsg);
    }
  } catch (error) {
    console.error("Error deleting:", error);
    const errorMsg = error?.message || error?.error || "Failed to delete item";
    args.showErrorToast?.(errorMsg);
  } finally {
    args.fns.setLoading(false);
  }
};





// Check if column should be hidden
const shouldHideColumn = (column) => {
  const hideColumns = getHideColumns();
  if (typeof hideColumns === "function") {
    return hideColumns(column);
  }
  return hideColumns.includes(column.key);
};

// Get column width (from state, config, or defaults)
const getColumnWidth = (columnKey) => {
  const storedWidth = columnWidths[columnKey];
  if (storedWidth) {
    return storedWidth;
  }
  const configWidths = args.fns.prop('columnWidths');
  if (configWidths && configWidths[columnKey]) {
    return configWidths[columnKey];
  }
  if (columnKey === "__selection" || columnKey === "__rowNumber") {
    return "36px";
  }
  if (columnKey === "__actions") {
    return "120px";
  }
  const columns = getColumns();
  const column = columns.find(col => col.key === columnKey);
  return column?.width || "100px";
};

// Get grid template columns
const getGridTemplateColumns = () => {
  const columns = getColumns();
  const showRowNumber = getShowRowNumber();
  const showSelection = getShowSelection();
  const showActions = getShowActions();
  let template = "";

  // Add selection column if enabled
  if (showSelection) {
    template += `${getColumnWidth("__selection")} `;
  }

  // Add actions column if enabled and form config exists
  if (showActions && args.fns.getFormConfig()) {
    template += `${getColumnWidth("__actions")} `;
  }

  if (showRowNumber) {
    template += `${getColumnWidth("__rowNumber")} `;
  }

  columns.forEach(col => {
    if (!shouldHideColumn(col)) {
      template += `${getColumnWidth(col.key)} `;
    }
  });

  return template.trim();
};

// Create resize handler for a column
const createResizeHandler = (columnKey) => {
  return (e) => {
    e.preventDefault();
    e.stopPropagation();

    // Get current width
    const currentWidth = getColumnWidth(columnKey);
    let startWidth = 50;
    if (currentWidth && currentWidth !== "1fr") {
      const match = currentWidth.match(/(\d+)px/);
      if (match) {
        startWidth = parseInt(match[1]);
      }
    }

    const startX = e.clientX || e.touches?.[0]?.clientX || 0;

    const minWidth = (columnKey === "__selection" || columnKey === "__rowNumber") ? 36 : 50;
    const handleMouseMove = (moveEvent) => {
      const clientX = moveEvent.clientX || moveEvent.touches?.[0]?.clientX || startX;
      const deltaX = clientX - startX;
      const newWidth = Math.max(minWidth, startWidth + deltaX);
      setColumnWidths({ ...columnWidths, [columnKey]: `${newWidth}px` });
    };

    const handleMouseUp = () => {
      document.removeEventListener('mousemove', handleMouseMove);
      document.removeEventListener('mouseup', handleMouseUp);
      document.removeEventListener('touchmove', handleMouseMove);
      document.removeEventListener('touchend', handleMouseUp);
      setIsResizing(false);
    };

    setIsResizing(true);
    document.addEventListener('mousemove', handleMouseMove);
    document.addEventListener('mouseup', handleMouseUp);
    document.addEventListener('touchmove', handleMouseMove);
    document.addEventListener('touchend', handleMouseUp);
  };
};
// Watch for sidebar selection changes and refresh table
const selectedSidebarItem = args.fns.selectedSidebarItem;
args.createEffect(() => {
  const item = selectedSidebarItem?.();
  setActiveRowId(null);
  // When sidebar selection changes, refresh table data
  if (item) {
    handleSearch();
  }
});

// React to parent's rowsToRemove signal (parent-owned state, no reload after move-to-category)
const rowsToRemove = args.contextData.props?.rowsToRemove;
const setRowsToRemove = args.contextData.props?.setRowsToRemove;
if (rowsToRemove && setRowsToRemove) {
  args.createEffect(() => {
    const idsToRemove = rowsToRemove?.();
    if (!idsToRemove || !Array.isArray(idsToRemove) || idsToRemove.length === 0) return;
    const idSet = new Set(idsToRemove);
    const updated = data().filter(row => !idSet.has(row.id));
    setData(updated);
    applyLocalFilters(updated);
    setRowsToRemove(null);
  });
}

// Drag and drop functionality using @atlaskit/pragmatic-drag-and-drop
const tableDraggableCleanups = new Map();
const tableDraggableElements = new Map(); // Store elements by rowId

// Read current rowId from element's data attribute (row re-renders update it when sidebar/data changes)
const getRowIdFromElement = (element) => {
  const id = element?.getAttribute?.('data-row-id');
  return id != null && id !== '' ? id : undefined;
};

// Helper to check if a row can be dragged
const canDragRow = (rowId) => {
  if (!rowId) return false;
  const selected = getEffectiveSelectedRows();
  if (!selected.has(rowId)) return false;
  return selected.size > 0;
};

// Initialize draggable for table row - rowId read from element data-row-id
const initTableDraggable = (element) => {
  if (!element || !args.draggable) return;
  
  // Clean up existing draggable for this element if any
  const existingCleanup = tableDraggableCleanups.get(element);
  if (existingCleanup) {
    existingCleanup();
  }
  
  const cleanup = args.draggable({
    element,
    getInitialData: () => {
      const currentRowId = getRowIdFromElement(element);
      if (!currentRowId || !canDragRow(currentRowId)) {
        return { type: 'table-items', itemIds: [], count: 0 };
      }
      
      const selected = getEffectiveSelectedRows();
      const itemIds = Array.from(selected).filter(id => id !== undefined && id !== null);
      
      return {
        type: 'table-items',
        itemIds,
        count: itemIds.length
      };
    },
    onGenerateDragPreview: ({ nativeSetDragImage }) => {
      // Provide a stable custom preview (pragmatic disables default preview in some setups)
      if (!args.setCustomNativeDragPreview || !nativeSetDragImage) return;
      const currentRowId = getRowIdFromElement(element);
      if (!currentRowId || !canDragRow(currentRowId)) return;

      const selected = getEffectiveSelectedRows();
      const count = selected.size;

      if (!count) return;

      return args.setCustomNativeDragPreview({
        nativeSetDragImage,
        getOffset: args.pointerOutsideOfPreview
          ? args.pointerOutsideOfPreview({ x: "8px", y: "8px" })
          : undefined,
        render: ({ container }) => {
          container.style.boxSizing = "border-box";
          container.style.display = "flex";
          container.style.alignItems = "center";
          container.style.gap = "10px";
          container.style.padding = "10px 12px";
          container.style.borderRadius = "10px";
          container.style.border = `1px solid ${args.theme?.var?.color?.border ?? "rgba(0,0,0,0.2)"}`;
          container.style.background = `${args.theme?.var?.color?.background_light_200 ?? "#fff"}`;
          container.style.color = `${args.theme?.var?.color?.text ?? "#111"}`;
          container.style.boxShadow = "0 10px 28px rgba(0,0,0,0.18)";
          container.style.pointerEvents = "none";
          container.style.fontSize = "14px";
          container.style.fontWeight = "600";
          container.style.maxWidth = "320px";

          const badge = document.createElement("div");
          badge.style.flex = "0 0 auto";
          badge.style.padding = "2px 8px";
          badge.style.borderRadius = "9999px";
          badge.style.background = `${args.theme?.var?.color?.primary ?? "#4f46e5"}`;
          badge.style.color = `${args.theme?.var?.color?.primary_text ?? "#fff"}`;
          badge.style.fontSize = "12px";
          badge.style.fontWeight = "700";
          badge.textContent = String(count);

          const text = document.createElement("div");
          text.style.minWidth = "0";
          text.style.whiteSpace = "nowrap";
          text.style.overflow = "hidden";
          text.style.textOverflow = "ellipsis";
          text.textContent = count === 1 ? "Move 1 item" : `Move ${count} items`;

          container.appendChild(badge);
          container.appendChild(text);
        }
      });
    },
    onDragStart: () => {
      const currentRowId = getRowIdFromElement(element);
      if (!currentRowId || !canDragRow(currentRowId)) return;
      if (element) element.style.opacity = "0.5";
    },
    onDrop: () => {
      if (element) element.style.opacity = "1";
    }
  });
  
  tableDraggableCleanups.set(element, cleanup);
  const rowId = getRowIdFromElement(element);
  if (rowId) tableDraggableElements.set(rowId, element);
  return cleanup;
};

// Cleanup table draggable for a specific element
const cleanupTableDraggable = (element) => {
  if (element) {
    const cleanup = tableDraggableCleanups.get(element);
    if (cleanup) {
      cleanup();
      tableDraggableCleanups.delete(element);
    }
    // Remove from elements map
    tableDraggableElements.forEach((el, rowId) => {
      if (el === element) {
        tableDraggableElements.delete(rowId);
      }
    });
  } else {
    // Cleanup all draggables
    tableDraggableCleanups.forEach((cleanup) => cleanup());
    tableDraggableCleanups.clear();
    tableDraggableElements.clear();
  }
};

const getSelectedItems = () => {
  const selected = getEffectiveSelectedRows();
  const filtered = filteredData();
  const selectedIds = Array.from(selected);
  return (filtered || []).filter(row => selectedIds.includes(row.id));
};

const hasActiveFilters = () => {
  const filters = columnFilters;
  const keys = Object.keys(filters);
  for (const k of keys) {
    const v = filters[k];
    if (v !== undefined && v !== null && v !== "") {
      if (Array.isArray(v)) {
        if (v.length > 0 && !(v.length === 1 && v[0] === "_All_VALUES_")) return true;
      } else return true;
    }
  }
  return false;
};

return {
  getColumns,
  getRowHeight,
  getTitle,
  getSearchPlaceholder,
  getAdditionalFilters,
  getCustomActions,
  getBatchActions,
  getShowRowNumber,
  getHideColumns,
  getShowAddButton,
  getShowEditButton,
  getShowSelection,
  getShowActions,
  getResizableColumns,
  getHideExportButtons,
  getHideImportButtons,
  getHideSettingsButton,
  getIcon,
  hasActiveFilters,
  getLabel,
  getAddButtonLabel,
  getOnEdit,
  getOnAfterAdd,
  getOnAfterEdit,
  getOnAdd,
  getOnDelete,
  getOnAfterDelete,
  getUsePolarisUI: () => args.fns.getUsePolarisUI?.() === true,
  getColumnWidth,
  createResizeHandler,
  columnWidths,
  setColumnWidths,
  isResizing,
  isImportModalOpen,
  setIsImportModalOpen,
  importData,
  setImportData,
  data,
  setData,
  filteredData,
  setFilteredData,
  searchTerm,
  setSearchTerm,
  debouncedSetSearchTerm,
  columnFilters,
  setColumnFilters,
  sortConfig,
  setSortConfig,
  getSelectedRows,
  getEffectiveSelectedRows,
  setSelectedRows,
  clearSelectedRows,
  isModalOpen,
  setIsModalOpen,
  modalMode,
  setModalMode,
  editingRow,
  setEditingRow,
  formData,
  setFormData,
  initializeFromQueryParams,
  updateQueryParams,
  applyLocalFilters,
  getCellValue,
  getUniqueColumnValues,
  handleSort,
  handleColumnFilterChange,
  handleSearch,
  toggleRowSelection,
  selectAllRows,
  clearSelection,
  clearSelectionAnchor,
  handleShiftArrow,
  activeRowId,
  activeRowIndex: getActiveRowIndex,
  setActiveRowIndex: (rowIndex) => setActiveRowId(getDisplayData()?.[rowIndex]?.id ?? null),
  setActiveRowId,
  handleAdd,
  handleEdit,
  handleViewRow,
  getRowClickable,
  getOnRowClick,
  shouldHideColumn,
  getGridTemplateColumns,
  renderCellContent,
  handleSave,
  handleDelete,
  initTableDraggable,
  cleanupTableDraggable,
  getSelectedItems,
  getSelectFilterProps,
  setRowRef,
  getRowRef,
  getDisplayData,
  getGroupByConfig,
  toggleExpanded,
  setCollapsedKeys
};
