const showActions = args.fns.getShowActions();
const hasFormConfig = !!args.fns.getFormConfig();
const virtualItem = args.contextData.virtualItem;
if (!virtualItem) return {};
const rowData = virtualItem.rowData;
const editLink = args.fns.prop('editLink');
const getHrefFn = editLink?.getHref;
const editHref = getHrefFn && typeof getHrefFn === "function" ? getHrefFn(rowData) : (editLink?.href ?? null);
const defaultStyle = "color: " + (args.theme?.var?.color?.primary ?? "inherit") + "; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; font-size: 14px;";
const styleVal = editLink?.style;
const editLinkStyle = typeof styleVal === "function" ? styleVal(rowData) : (styleVal ?? defaultStyle);
const onClickFn = editLink?.getOnClick ?? editLink?.onClick;
const hasCustomOnClick = typeof onClickFn === "function";
const editLinkIcon = editLink?.icon;
const showIconLink = !!editLinkIcon;

return {
  as: "a",
  href: editHref ?? "#",
  target: editLink?.target ?? "_top",
  rel: editLink?.rel ?? "noopener noreferrer",
  text: editLink?.label ?? "Edit",
  onClick: (e) => {
    e.stopPropagation();
    if (hasCustomOnClick) {
      e.preventDefault();
      onClickFn(rowData, e);
    } else if (!editHref) {
      e.preventDefault();
    }
  },
  hide: !hasFormConfig || !showActions || !args.fns.getShowEditButton() || (!editHref && !hasCustomOnClick) || showIconLink,
  style: editLinkStyle
};
'''
