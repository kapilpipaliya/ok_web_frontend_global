      id: "63"
      L: Attr
      P: {
        displayOrder: 8
        componentName: TableSettingsModal
        props:
          '''
const evaluateConfig = args.fns.evaluateConfig;
const config = evaluateConfig();
const getConfigFunction = args.fns.getConfigFunction;

// Get initial config as function body string (from settingsModalInitialConfig, settings, or configFunction)
let initialConfig = "";
try {
  const modalConfig = args.fns.settingsModalInitialConfig?.();
  const currentSettings = modalConfig ?? args.fns.settings();
  // If settings exist and it's a string (raw function body), use it
  if (currentSettings && typeof currentSettings === 'string') {
    initialConfig = currentSettings;
  } else {
    // Fallback to configFunction
    const configFn = getConfigFunction();
    if (configFn) {
      // Get the function as string to extract its body
      const fnString = configFn.toString();
      // Extract function body (everything between { and })
      const match = fnString.match(/\{([\s\S]*)\}/);
      if (match && match[1]) {
        initialConfig = match[1].trim();
      } else {
        // Fallback: call function and convert to return statement
        const configObj = configFn();
        if (configObj) {
          initialConfig = `return ${JSON.stringify(configObj, null, 2)};`;
        }
      }
    } else {
      // Use current effective config as function body
      const configObj = {
        columns: config.columns || [],
        formConfig: config.formConfig || {},
        uniqueKeys: config.uniqueKeys || []
      };
      initialConfig = `return ${JSON.stringify(configObj, null, 2)};`;
    }
  }
} catch (e) {
  console.error("Error getting initial config:", e);
  initialConfig = "return {};";
}

return {
  isOpen: args.fns.isSettingsModalOpen(),
  onClose: () => {
    args.fns.setSettingsModalInitialConfig?.(null);
    args.fns.setIsSettingsModalOpen(false);
  },
  initialConfig: initialConfig,
  onSave: args.fns.handleSaveSettings,
  tableVertexLabel: args.fns.getTableVertexLabel()
};
'''
      }
    }
