const isLoading = args.fns.loading();
return {
  getItems: args.fns.getDisplayData,
  itemHeight: args.fns.getRowHeight(),
  containerClass: "table-body-list",
  hide: isLoading,
  tabIndex: 0,
  role: "listbox",
  "attr:aria-label": "Table rows; Arrow keys to move, Shift+Arrow Up/Down to select range, Left/Right to collapse/expand group, Space to toggle selection",
  getActiveIndex: () => args.fns.activeRowIndex?.(),
  setActiveIndex: (n) => args.fns.setActiveRowIndex?.(n),
  getItemRef: (index) => args.fns.getRowRef?.(index),
  onSpaceKey: (index) => {
    if (!args.fns.getShowSelection?.()) return;
    const displayData = args.fns.getDisplayData();
    const row = displayData[index];
    if (row?.id) args.fns.toggleRowSelection?.(row.id);
  },
  onExpandCollapse: (index, action) => {
    const displayData = args.fns.getDisplayData?.() ?? [];
    const row = displayData[index];
    if (row?._isParent !== true || row._parentKey == null) return;
    const parentKey = row._parentKey;
    const setCollapsedKeysFn = args.fns.setCollapsedKeys;
    if (!setCollapsedKeysFn) return;
    if (action === "collapse") {
      setCollapsedKeysFn(parentKey, true);
    } else {
      setCollapsedKeysFn(parentKey, undefined);
    }
  },
  onShiftArrow: (currentIndex, nextIndex) => args.fns.handleShiftArrow?.(currentIndex, nextIndex),
  clearSelectionAnchor: () => args.fns.clearSelectionAnchor?.()
};
'''
      }
    }
