const column = args.contextData.column;
const resizableColumns = args.fns.getResizableColumns();
const shouldHide = args.fns.shouldHideColumn(column);

// Determine column key for resize
const getColumnKey = () => {
  if (column.key === "__rowNumber" || column.type === "rowNumber") {
    return "__rowNumber";
  }
  return column.key;
};

const columnKey = getColumnKey();
const resizeHandler = args.fns.createResizeHandler(columnKey);

return {
  as: "div",
  hide: !resizableColumns || shouldHide,
  onMouseDown: resizeHandler,
  onTouchStart: resizeHandler
};
