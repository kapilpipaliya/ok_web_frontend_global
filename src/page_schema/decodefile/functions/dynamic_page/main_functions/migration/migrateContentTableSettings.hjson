  uniqueKeys: [],
  usePolarisUI: true,
  sidebar: {
    enabled: true,
    parentVertexLabel: "ShopifyFileCategory",
    toParentEdgeType: "ParentCategory",
    rootKeys: {},
    label: "Category",
    formConfig: {
      gridColumns: 1,
      groups: [
        {
          key: "basic",
          title: "Basic Information",
          gridColumns: 2,
          fields: [
            {
              key: "name",
              label: "Name",
              type: "text",
              required: true,
              maxLength: 255,
              colSpan: 2
            }
          ]
        }
      ]
    },
    hooks: {}
  }
};`
  }
];

// Helper function to process a single setting
async function processSetting(setting) {
  const { key, tableVertexLabel, icon, name, config } = setting;

  console.log(`\n${icon} Processing ${name} settings...`);

  // Check if setting exists
  const checkResult = await args.session.run(
    `MATCH (s:Setting {key: $key}) RETURN s`,
    { key }
  );

  const exists = checkResult.records.length > 0;

  if (!dryRun) {
    if (exists) {
      // Update existing
      await args.session.run(
        `MATCH (s:Setting {key: $key})
         SET s.config = $config,
             s.type = 'table_config',
             s.tableVertexLabel = $tableVertexLabel,
             s.updatedAt = datetime()
         RETURN s`,
        { key, config, tableVertexLabel }
      );
      console.log(`✅ Updated existing ${name} settings`);
      return { created: 0, updated: 1 };
    } else {
      // Create new
      await args.session.run(
        `CREATE (s:Setting {
          key: $key,
          type: 'table_config',
          tableVertexLabel: $tableVertexLabel,
          config: $config,
          createdAt: datetime(),
          updatedAt: datetime()
        })
        RETURN s`,
        { key, config, tableVertexLabel }
      );
      console.log(`✅ Created new ${name} settings`);
      return { created: 1, updated: 0 };
    }
  } else {
    // Dry run - just report
    if (exists) {
      console.log(`📋 Would update existing ${name} settings`);
      return { created: 0, updated: 1 };
    } else {
      console.log(`📋 Would create new ${name} settings`);
      return { created: 1, updated: 0 };
    }
  }
}

// Process all settings
const stats = {
  shopifyFileSettingsCreated: 0,
  shopifyFileSettingsUpdated: 0,
  shopifyFileCategorySettingsCreated: 0,
  shopifyFileCategorySettingsUpdated: 0
};

for (let i = 0; i < settingsConfigs.length; i++) {
  const setting = settingsConfigs[i];
  const result = await processSetting(setting);
  if (setting.tableVertexLabel === 'ShopifyFile') {
    stats.shopifyFileSettingsCreated += result.created;
    stats.shopifyFileSettingsUpdated += result.updated;
  } else if (setting.tableVertexLabel === 'ShopifyFileCategory') {
    stats.shopifyFileCategorySettingsCreated += result.created;
    stats.shopifyFileCategorySettingsUpdated += result.updated;
  }
}

// ==========================================
// Summary
// ==========================================
console.log('\n📊 Migration Summary:');
console.log('==========================================');
console.log(`ShopifyFile settings - Created: ${stats.shopifyFileSettingsCreated}, Updated: ${stats.shopifyFileSettingsUpdated}`);
console.log(`ShopifyFileCategory settings - Created: ${stats.shopifyFileCategorySettingsCreated}, Updated: ${stats.shopifyFileCategorySettingsUpdated}`);
console.log('==========================================');

return {
  success: true,
  message: dryRun
    ? "Dry run completed - no changes made"
    : "File table settings migration completed successfully",
  data: {
    ...stats,
    dryRun
  }
};
'''
        key: migrateContentTableSettings
      }
    }
  ]
  edges: []
}