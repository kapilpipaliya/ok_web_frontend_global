    if (!id) return;
    const origin = typeof window !== 'undefined' && window.shopify?.origin ? window.shopify.origin : '';
    const num = String(id).replace(/^gid:\\/\\/shopify\\/[^/]+\\//, '');
    const href = \`\${origin}/content/files/\${num}?selectedView=all\`;
    if (href && typeof window !== 'undefined') {
      window.open(href, '_blank', 'noopener,noreferrer');
    }
