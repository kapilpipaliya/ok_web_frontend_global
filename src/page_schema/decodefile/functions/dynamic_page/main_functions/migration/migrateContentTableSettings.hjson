            maxLength: 500,
            colSpan: 2
          }
        ]
      }
    ]
  },
  uniqueKeys: [],
  usePolarisUI: true,
  enableUserScopingForSidebar: false,
  enableUserScopingForContent: false,
  enableLocalFilters: true,
  enableLocalSort: true,
  refetchIntervalWhenQueued: 5000,
  hooks: {
    beforeFetchData: "shopifyFileBeforeFetchData",
    afterCreate: "shopifyFileAfterCreate",
    afterUpdate: "shopifyFileAfterUpdate",
    afterDelete: "shopifyFileAfterDelete",
    afterCreateRelationship: "shopifyFileAfterCreateRelationship",
    afterMoveItemsToCategory: "shopifyFileAfterMoveItemsToCategory"
