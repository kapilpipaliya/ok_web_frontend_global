{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Background job: marks file sync complete after file is added to a category (relationship is DB-only; no Shopify file categories).
        body:
          '''
const QUEUE_NAME = 'processShopifyFileAfterCreateRelationship';

const doJob = async (args, jobData, dbSession) => {
  const { contentLabel, contentId, categoryId, shop } = jobData;
  if (contentLabel !== 'ShopifyFile') return;
  if (!categoryId || categoryId === 'uncategorized') return;

  if (contentId) {
    await dbSession.run(
      `MATCH (f:ShopifyFile) WHERE elementId(f) = $elementId SET f.syncStatus = 'complete', f.updatedAt = datetime()`,
      { elementId: contentId }
    );
    console.log(`✅ File ${contentId} added to category (sync complete)`);
  }
};

const helpers = await args.executeNamedServerFunction(
  { functionName: 'shopifyQueueHelpers', contextData: {} },
  { functionLookupSubDomain: args.subDomain }
);
if (!helpers.result?.success) {
  console.error('Shopify queue helpers init failed', helpers.result?.error);
  throw new Error('Shopify queue helpers initialization failed');
}
const runWithSession = helpers.result.data.runWithSession;

if (args.contextData?.action === 'start') {
  const { Worker } = args.bullmq;
  const connection = helpers.result.data.getRedisConnection();
  if (!connection || !connection.host) throw new Error('Invalid Redis connection for Shopify jobs');
  let workerInstance;
  try {
    workerInstance = new Worker(QUEUE_NAME, async (job) => {
      await runWithSession(args, job.data.shop, async (dbSession) => {
        await doJob(args, job.data, dbSession);
      });
    }, { connection, concurrency: 2, lockDuration: 120000 });
    workerInstance.on('failed', (job, err) => console.error('processShopifyFileAfterCreateRelationship: Job failed', job?.id, err?.message));
    workerInstance.on('error', (err) => console.error('processShopifyFileAfterCreateRelationship: Worker error', err?.message));
    return { stop: async (force = false) => { if (workerInstance) await workerInstance.close(force); } };
  } catch (error) {
    console.error('processShopifyFileAfterCreateRelationship: Failed to create worker', error);
    if (workerInstance) { try { await workerInstance.close(); } catch (e) {} }
    throw error;
  }
}
'''
        key: processShopifyFileAfterCreateRelationship
      }
    }
  ]
  edges: []
}
