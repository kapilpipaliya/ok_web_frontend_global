{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job when a ShopifyFile is added to a category (relationship only in DB; no Shopify API for file categories).
        body:
          '''
const { contentLabel, contentId, categoryId, categoryLabel } = c;

if (contentLabel !== 'ShopifyFile') return;
if (!categoryId || categoryId === 'uncategorized') return;

const shop = c.shop;
if (!shop) { console.log('shopifyFileAfterCreateRelationship: shop not available in contextData'); return; }

try {
  const helpers = await s(
    { functionName: 'shopifyQueueHelpers', contextData: {} },
    { functionLookupSubDomain: 'decodefile' }
  );
  if (!helpers.result?.success) return;
  const queueName = 'processShopifyFileAfterCreateRelationship';
  const queue = helpers.result.data.createShopifyQueue(_, queueName);
  const job = await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    contentLabel,
    contentId,
    categoryId,
    categoryLabel
  });
  await queue.close();
  const jobId = job?.id;
  if (contentId && jobId) {
    await _.session.run(
      `MATCH (n:ShopifyFile) WHERE elementId(n) = $elementId SET n.syncStatus = $status, n.syncJobId = $jobId, n.updatedAt = datetime()`,
      { elementId: contentId, status: 'queued', jobId }
    );
  }
  const r = c?.result;
  if (r?.data?.P && typeof r.data.P === 'object') {
    r.data.P.syncStatus = 'queued';
    if (jobId) r.data.P.syncJobId = jobId;
  }
} catch (error) {
  console.error("shopifyFileAfterCreateRelationship: Failed to enqueue job", error);
}
'''
        key: shopifyFileAfterCreateRelationship
      }
    }
  ]
  edges: []
}
