{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job to create a file in Shopify when a new ShopifyFile is added.
        body:
          '''
const { tableVertexLabel, operation, elementId, data, result, fromWebhook, payload } = c;

const shop = c.shop;
if (!shop) { console.log('shopifyFileAfterCreate: shop not available in contextData'); return; }

const helpers = await s(
  { functionName: 'shopifyQueueHelpers', contextData: {} },
  { functionLookupSubDomain: 'decodefile' }
);
if (!helpers.result?.success) return;

const queueName = 'processShopifyFileAfterCreate';

if (fromWebhook && payload) {
  try {
    const queue = helpers.result.data.createShopifyQueue(_, queueName);
    await helpers.result.data.addShopifyJob(queue, queueName, { shop, payload, fromWebhook: true });
    await queue.close();
    console.log('shopifyFileAfterCreate: webhook job enqueued for', shop);
  } catch (error) {
    console.error('shopifyFileAfterCreate: Failed to enqueue webhook job', error);
    throw error;
  }
  return;
}

if (tableVertexLabel !== 'ShopifyFile' || operation !== 'create') return;

const vertex = data?.vertex;
const formData = vertex?.P || {};
if (formData.id) return;

try {
  const queue = helpers.result.data.createShopifyQueue(_, queueName);
  const job = await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    tableVertexLabel,
    operation,
    elementId,
    data,
    result
  });
  await queue.close();
  const jobId = job?.id;
  if (elementId && jobId) {
    await _.session.run(
      `MATCH (n:ShopifyFile) WHERE elementId(n) = $elementId SET n.syncStatus = $status, n.syncJobId = $jobId, n.updatedAt = datetime()`,
      { elementId, status: 'queued', jobId }
    );
  }
  const r = c?.result;
  if (r?.data?.P && typeof r.data.P === 'object') {
    r.data.P.syncStatus = 'queued';
    if (jobId) r.data.P.syncJobId = jobId;
  }
} catch (error) {
  console.error("shopifyFileAfterCreate: Failed to enqueue job", error);
}
'''
        key: shopifyFileAfterCreate
      }
    }
  ]
  edges: []
}
