{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Enqueues background job when ShopifyFiles are moved to a category (relationship only in DB).
        body:
          '''
const { contentLabel, contentIds, categoryId, categoryLabel, relationshipType, sourceCategoryId } = c;

if (contentLabel !== 'ShopifyFile') return;

const shop = c.shop;
if (!shop) { console.log('shopifyFileAfterMoveItemsToCategory: shop not available in contextData'); return; }

try {
  const helpers = await s(
    { functionName: 'shopifyQueueHelpers', contextData: {} },
    { functionLookupSubDomain: 'decodefile' }
  );
  if (!helpers.result?.success) return;
  const queueName = 'processShopifyFileAfterMoveItemsToCategory';
  const queue = helpers.result.data.createShopifyQueue(_, queueName);
  const job = await helpers.result.data.addShopifyJob(queue, queueName, {
    shop,
    contentLabel,
    contentIds,
    categoryId,
    categoryLabel,
    relationshipType,
    sourceCategoryId
  });
  await queue.close();
  const jobId = job?.id;
  if (contentIds && Array.isArray(contentIds) && contentIds.length > 0 && jobId) {
    await _.session.run(
      `UNWIND $contentIds as elementId
       MATCH (n:ShopifyFile) WHERE elementId(n) = elementId
       SET n.syncStatus = $status, n.syncJobId = $jobId, n.updatedAt = datetime()`,
      { contentIds, status: 'queued', jobId }
    );
  }
  const r = c?.result;
  if (r?.data?.P && typeof r.data.P === 'object') {
    r.data.P.syncStatus = 'queued';
    if (jobId) r.data.P.syncJobId = jobId;
  }
} catch (error) {
  console.error("shopifyFileAfterMoveItemsToCategory: Failed to enqueue job", error);
}
'''
        key: shopifyFileAfterMoveItemsToCategory
      }
    }
  ]
  edges: []
}
