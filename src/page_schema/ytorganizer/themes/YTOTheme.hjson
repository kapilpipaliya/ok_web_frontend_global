return {
  var: {
    color: {
      // Primary - YouTube red
      primary: {
        light: "oklch(0.55 0.28 25)",
        dark: "oklch(0.65 0.25 25)"
      },
      // Info - Blue for links and information
      info: {
        light: "oklch(0.60 0.22 240)",
        dark: "oklch(0.70 0.18 240)"
      },
      // Success - Green for completed/watched
      success: {
        light: "oklch(0.65 0.20 145)",
        dark: "oklch(0.75 0.18 145)"
      },
      // Warning - Orange for attention
      warning: {
        light: "oklch(0.75 0.18 70)",
        dark: "oklch(0.80 0.15 70)"
      },
      // Error - Red for errors
      error: {
        light: "oklch(0.60 0.25 25)",
        dark: "oklch(0.70 0.22 25)"
      },
      // Text - High contrast for accessibility
      text: {
        light: "oklch(0.10 0.01 0)",
        dark: "oklch(0.95 0.01 0)"
      },
      // Background - Clean white/dark
      background: {
        light: "oklch(0.99 0.001 0)",
        dark: "oklch(0.08 0.01 0)"
      },
      // Border - Subtle borders
      border: {
        light: "oklch(0.85 0.01 0)",
        dark: "oklch(0.25 0.01 0)"
      },
      // Muted - For secondary text
      muted: {
        light: "oklch(0.55 0.02 0)",
        dark: "oklch(0.50 0.02 0)"
      },
      // Surface - For cards and elevated elements
      surface: {
        light: "oklch(0.98 0.001 0)",
        dark: "oklch(0.12 0.01 0)"
      },
      // Accent - YouTube red accent
      accent: {
        light: "oklch(0.55 0.28 25)",
        dark: "oklch(0.65 0.25 25)"
      },
      // Video background - Dark for video containers
      videoBackground: {
        light: "oklch(0.10 0.01 0)",
        dark: "oklch(0.05 0.01 0)"
      }
    }
  }
};
'''
