{
  "appId": "com.ysaar.app",
  "appName": "YSaar",
  "webDir": "dist",
  "server": {
    "url": "https://ysaar.com/auth/signin",
    "cleartext": true,
    "allowNavigation": [
      "https://ysaar.com/*",
      "https://accounts.google.com/*",
      "https://*.google.com/*"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true
    }
  }
}