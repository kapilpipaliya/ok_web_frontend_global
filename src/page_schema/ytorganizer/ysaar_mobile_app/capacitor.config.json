{
  "appId": "com.ysaar.app",
  "appName": "YSaar",
  "webDir": "dist",
  "server": {
    "url": "https://ysaar.com/home",
    "cleartext": true,
    "allowNavigation": [
      "https://ysaar.com/*",
      "https://accounts.google.com/*",
      "https://*.google.com/*"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#000000",
      "overlaysWebView": true
    }
  }
}
