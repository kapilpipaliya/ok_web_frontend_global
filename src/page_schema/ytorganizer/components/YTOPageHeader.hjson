{
  vertexes: [
    {
      id: "yto_page_header_component",
      L: "Component",
      P: {
        key: "YTOPageHeader"
      }
    },
    {
      id: "yto_page_header_variant_icon",
      L: "ComponentVariant",
      P: {
        key: "icon",
        type: "string",
        defValue: "carbon:logo-youtube"
      }
    },
    {
      id: "yto_page_header_variant_title",
      L: "ComponentVariant",
      P: {
        key: "title",
        type: "string",
        defValue: "YouTube Organizer"
      }
    },
    {
      id: "yto_page_header_variant_stats",
      L: "ComponentVariant",
      P: {
        key: "stats",
        type: "string",
        defValue: null
      }
    },
    {
      id: "yto_page_header_variant_color",
      L: "ComponentVariant",
      P: {
        key: "color",
        type: "string",
        defValue: "primary"
      }
    },
    {
      id: "yto_page_header_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
const color = args.contextData.props?.color || "primary";
return `._id {
  background: ${args.theme.var.color[color]};
  color: ${args.theme.var.color[color + "_text"]};
  padding: 1.5rem;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);

  @media (max-width: 768px) {
    padding: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_page_header_content",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}`;
'''
      }
    },
    {
      id: "yto_page_header_title_section",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}`;
'''
      }
    },
    {
      id: "yto_page_header_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const icon = args.contextData.props?.icon || "carbon:logo-youtube";
return {
  as: "icon",
  icon: icon,
  width: 32,
  height: 32
};
'''
      }
    },
    {
      id: "yto_page_header_title",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const title = args.contextData.props?.title || "YouTube Organizer";
return {
  as: "h1",
  text: title
};
''',
        css: '''
return `._id {
  font-size: 2rem;
  font-weight: 700;
  margin: 0;

  @media (max-width: 768px) {
    font-size: 1.5rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_page_header_stats",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const stats = args.contextData.props?.stats;
return {
  as: "div",
  text: stats || "",
  hide: !stats
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  opacity: 0.9;
  background: rgba(255,255,255,0.1);
  padding: 0.5rem 1rem;
  border-radius: 2rem;

  @media (max-width: 768px) {
    font-size: 0.75rem;
    padding: 0.375rem 0.75rem;
  }
}`;
'''
      }
    }
  ],
  edges: [
    { id: "e1", T: "ComponentVariant", S: "yto_page_header_component", E: "yto_page_header_variant_icon" },
    { id: "e2", T: "ComponentVariant", S: "yto_page_header_component", E: "yto_page_header_variant_title" },
    { id: "e3", T: "ComponentVariant", S: "yto_page_header_component", E: "yto_page_header_variant_stats" },
    { id: "e4", T: "ComponentVariant", S: "yto_page_header_component", E: "yto_page_header_variant_color" },
    { id: "e5", T: "Attr", S: "yto_page_header_component", E: "yto_page_header_root" },
    { id: "e6", T: "Attr", S: "yto_page_header_root", E: "yto_page_header_content" },
    { id: "e7", T: "Attr", S: "yto_page_header_content", E: "yto_page_header_title_section" },
    { id: "e8", T: "Attr", S: "yto_page_header_title_section", E: "yto_page_header_icon" },
    { id: "e9", T: "Attr", S: "yto_page_header_title_section", E: "yto_page_header_title" },
    { id: "e10", T: "Attr", S: "yto_page_header_content", E: "yto_page_header_stats" }
  ]
}