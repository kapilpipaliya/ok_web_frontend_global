{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "YTONoAccountsMessage"
      }
    },
    {
      id: "container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 3rem 2rem;
  text-align: center;
  background: ${args.theme.var.color.background_light_100};
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.75rem;
}`;
'''
      }
    },
    {
      id: "icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "mdi:youtube",
  width: 64,
  height: 64
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.muted};
  margin-bottom: 1rem;
  opacity: 0.5;
}`;
'''
      }
    },
    {
      id: "title",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "h3",
  text: "No YouTube Accounts Connected"
};
''',
        css: '''
return `._id {
  font-size: 1.25rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
  margin: 0 0 0.5rem 0;
}`;
'''
      }
    },
    {
      id: "description",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "You need to connect a YouTube account to start using this app. Please go to Account Settings to connect your YouTube account."
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.muted};
  margin: 0 0 1.5rem 0;
}`;
'''
      }
    },
    {
      id: "action_button",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "YTOButton",
        props: '''
return {
  text: "Go to Account Settings",
  variant: "primary",
  leftIcon: "carbon:settings",
  onClick: () => args.navigate("/accounts")
};
'''
      }
    }
  ],
  edges: [
    { id: "e1", T: "Attr", S: "component_root", E: "container" },
    { id: "e2", T: "Attr", S: "container", E: "icon" },
    { id: "e3", T: "Attr", S: "container", E: "title" },
    { id: "e4", T: "Attr", S: "container", E: "description" },
    { id: "e5", T: "Attr", S: "container", E: "action_button" }
  ]
}
