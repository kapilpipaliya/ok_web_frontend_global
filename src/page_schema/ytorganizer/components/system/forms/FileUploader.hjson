        componentName: Html
        props:
          '''
const cfg = args.fns.getUploadConfiguration?.() ?? {};
return {
  as: "input",
  type: "file",
  accept: cfg.accept || "*/*",
  multiple: cfg.multiple === true,
  disabled: args.contextData.props?.disabled === true,
  style: "display: none;",
  ref: (el) => args.fns.setInputRef?.(el),
  onChange: (event) => {
    const input = event?.target;
    void args.fns.applyFileList?.(input?.files ?? null);
  }
};'''
      }
    }
