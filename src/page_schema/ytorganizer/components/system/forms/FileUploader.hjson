const minHeight = cfg.previewMinHeight || "12.5rem";
return `._id {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: ${minHeight};
  flex: 1;
  box-sizing: border-box;
}`;
'''
        props:
          '''
const cfg = args.fns.getUploadConfiguration?.() ?? {};
const dragEnabled = cfg.enableDragDrop !== false;
return {
  as: "div",
  onClick: () => args.fns.openPicker?.(),
  onDragOver: dragEnabled ? (event) => event?.preventDefault?.() : undefined,
  onDrop: dragEnabled
    ? (event) => {
        event?.preventDefault?.();
        void args.fns.applyFileList?.(event?.dataTransfer?.files ?? null);
      }
    : undefined
};
'''
      }
