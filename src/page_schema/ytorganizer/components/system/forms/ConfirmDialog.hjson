        displayOrder: 1
        componentName: Html
        props:
          '''
const cancelText = c.props?.cancelText || "Cancel";
const onCancel = c.props?.onCancel;
const loading = c.props?.loading || false;
const usePolaris = c.props?.getUsePolarisUI === true;

return {
  as: "button",
  type: "button",
  text: cancelText,
  disabled: loading,
  onClick: () => {
    if (onCancel && !loading) onCancel();
  },
  hide: usePolaris
};
'''
      }
    }
    {
      id: "10_polaris"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const cancelText = c.props?.cancelText || "Cancel";
const onCancel = c.props?.onCancel;
const loading = c.props?.loading || false;

return {
  as: "s-button",
  "attr:variant": "secondary",
  text: cancelText,
  disabled: loading,
  onClick: () => {
    if (onCancel && !loading) onCancel();
  },
  hide: c.props?.getUsePolarisUI !== true
};
'''
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        css:
          '''
const variant = c.props?.variant || "danger";

const variantStyles = {
  danger: {
    background: t.var.color.error,
    backgroundHover: t.var.color.error_dark_200,
    text: t.var.color.error_text,
    focus: t.var.color.error_light_200
  },
  warning: {
    background: t.var.color.warning,
    backgroundHover: t.var.color.warning_dark_200,
    text: t.var.color.warning_text,
    focus: t.var.color.warning_light_200
  },
  primary: {
    background: t.var.color.primary,
    backgroundHover: t.var.color.primary_dark_200,
    text: t.var.color.primary_text,
    focus: t.var.color.primary_light_200
  }
};

const style = variantStyles[variant] || variantStyles.danger;

return `._id {
  min-height: 48px;
  padding: ${t.var.spacing.sm} ${t.var.spacing.lg};
  font-size: 1rem;
  font-weight: 500;
  border: 1px solid transparent;
  border-radius: ${t.var.borderRadius.md};
  background: ${style.background};
  color: ${style.text};
  cursor: pointer;
  transition: all 150ms ease;
  flex: 1;

  &:hover:not(:disabled) {
    background: ${style.backgroundHover};
    transform: translateY(-1px);
  }

  &:focus {
    outline: none;
    box-shadow: 0 0 0 3px ${style.focus};
  }

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }
}

@media (max-width: 768px) {
  ._id {
    padding: ${t.var.spacing.md};
    font-size: 1rem;
  }
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''
const confirmText = c.props?.confirmText || "Confirm";
const onConfirm = c.props?.onConfirm;
const loading = c.props?.loading || false;
const usePolaris = c.props?.getUsePolarisUI === true;
const variant = c.props?.variant || "danger";

return {
  as: "button",
  type: "button",
  text: loading ? "Please wait..." : confirmText,
  disabled: loading,
  onClick: async () => {
    if (onConfirm && !loading) await onConfirm();
  },
  hide: usePolaris
};
'''
      }
    }
    {
      id: "11_polaris"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Html
        props:
          '''
const confirmText = c.props?.confirmText || "Confirm";
const onConfirm = c.props?.onConfirm;
const loading = c.props?.loading || false;
const variant = c.props?.variant || "danger";

const polarisVariant = variant === "danger" ? "primary" : variant === "warning" ? "primary" : "primary";
const polarisTone = variant === "danger" ? "critical" : undefined;

return {
  as: "s-button",
  "attr:variant": polarisVariant,
  "attr:tone": polarisTone,
  text: loading ? "Please wait..." : confirmText,
  disabled: loading,
  onClick: async () => {
    if (onConfirm && !loading) await onConfirm();
  },
  hide: c.props?.getUsePolarisUI !== true
};
'''
      }
    }
