      P: {
        css:
          '''
return `._id {
  min-height: 48px;
  padding: ${t.var.spacing.sm} ${t.var.spacing.lg};
  font-size: 1rem;
  font-weight: 500;
  border: 1px solid ${t.var.color.border};
  border-radius: ${t.var.borderRadius.md};
  background: ${t.var.color.background};
  color: ${t.var.color.text};
  cursor: pointer;
  transition: all 150ms ease;
  flex: 1;

  &:hover:not(:disabled) {
    background: ${t.var.color.background_dark_100};
    border-color: ${t.var.color.border_dark_200};
  }

  &:focus {
    outline: none;
    border-color: ${t.var.color.primary};
    box-shadow: 0 0 0 3px ${t.var.color.primary_light_200};
  }

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
}

@media (max-width: 768px) {
  ._id {
    padding: ${t.var.spacing.md};
    font-size: 1rem;
  }
}`;
