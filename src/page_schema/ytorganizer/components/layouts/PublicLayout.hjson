        fns: '''
// Define navigation links data
const navLinks = [
  {
    id: "pricing",
    text: "Pricing",
    href: "#pricing",
    onClick: (e) => {
      e.preventDefault();
      // Only scroll if on landing page
      if (args.location.pathname === '/') {
        document.getElementById('pricing')?.scrollIntoView({ behavior: 'smooth' });
      } else {
        args.navigate('/#pricing');
      }
    }
  },
  {
    id: "contact",
    text: "Contact",
    onClick: (e) => {
      e.preventDefault();
      args.navigate('/contact');
    }
  },
  {
    id: "privacy",
    text: "Privacy",
    onClick: (e) => {
      e.preventDefault();
      args.navigate('/privacy');
    }
  },
  {
    id: "terms",
    text: "Terms",
    onClick: (e) => {
      e.preventDefault();
      args.navigate('/terms');
    }
  },
  {
    id: "signin",
    text: "Sign In",
    onClick: (e) => {
      e.preventDefault();
      args.navigate('/auth/signin');
    }
  }
];

return {
  navLinks
};
''',
        props: '''
return {
