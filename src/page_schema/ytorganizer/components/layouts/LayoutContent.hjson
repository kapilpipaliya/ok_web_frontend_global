{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''
// Define navigation items for both desktop and mobile menus
// Using createSignal for reactive state management
const navigationSectionsData = [
  {
    id: "main",
    title: null, // No title for main section
    items: [
      {
        id: "home",
        href: "/home",
        label: "Home",
        icon: "carbon:home",
        title: "Dashboard and overview",
        pathCheck: (pathname) => pathname === "/" || pathname === ""
      }
    ]
  },
  {
    id: "youtube",
    title: "YouTube",
    items: [
      {
        id: "search",
        href: "/content?type=search&q=",
        label: "Search",
        icon: "mdi:magnify",
        title: "Search for YouTube channels and playlists",
        pathCheck: (pathname) => pathname === "/content" && args.searchParams?.type === "search"
      },
      {
        id: "channels",
        href: "/content?type=channels",
        label: "Channels",
        icon: "mdi:youtube",
        title: "View and manage YouTube channels",
        pathCheck: (pathname) => pathname === "/content" && args.searchParams?.type === "channels"
      },
      {
        id: "playlists",
        href: "/content?type=playlists",
        label: "Playlists",
        icon: "mdi:playlist-play",
        title: "View and manage YouTube playlists",
        pathCheck: (pathname) => pathname === "/content" && args.searchParams?.type === "playlists"
      },
      {
        id: "favourites",
        href: "/content?type=favourites",
        label: "Favourites",
        icon: "carbon:favorite",
        title: "View your favourite videos, channels and playlists",
        pathCheck: (pathname) => pathname === "/content" && args.searchParams?.type === "favourites"
      }
    ]
  },
  {
    id: "other",
    title: null, // No title for other section
    hasBorder: true,
    items: [
      {
        id: "settings",
        href: "/settings",
        label: "Settings",
        icon: "carbon:settings",
        title: "App configuration and preferences",
        pathCheck: (pathname) => pathname.startsWith("/settings")
      },
      {
        id: "logout",
        href: "/auth/logout",
        label: "Logout",
        icon: "carbon:logout",
        title: "Sign out of your account",
        isButton: true,
        isDanger: true
      }
    ]
  }
];

// Filter navigation sections based on showIf condition
const filteredNavigationSections = navigationSectionsData.filter(section => {
  if (section.showIf && typeof section.showIf === 'function') {
    return section.showIf();
  }
  return true; // Show by default if no showIf condition
});

// Create signal for navigation sections
const [navigationSections, setNavigationSections] = args.createSignal(filteredNavigationSections);

// Define mobile navigation items (subset of desktop items)
const mobileNavigationItemsData = [
  {
    id: "extension_home",
    href: "/content?type=extension",
    label: "Quick Add",
    icon: "carbon:add-alt",
    title: "Quick add channels, playlists, and videos",
    pathCheck: (pathname) => pathname === "/content" && args.searchParams?.type === "extension",
    showIf: () => args.fns.isInIframe?.()
  },
  {
    id: "home",
    href: "/home",
    label: "Home",
    icon: "carbon:home",
    title: "Dashboard and overview",
    pathCheck: (pathname) => pathname === "/" || pathname === ""
  },
  {
    id: "search",
    href: "/content?type=search&q=",
    label: "Search",
    icon: "mdi:magnify",
    title: "Search for YouTube channels and playlists",
    pathCheck: (pathname) => pathname === "/content" && args.searchParams?.type === "search"
  },
  {
    id: "channels",
    href: "/content?type=channels",
    label: "Channels",
    icon: "mdi:youtube",
    title: "View and manage YouTube channels",
    pathCheck: (pathname) => pathname === "/content" && args.searchParams?.type === "channels"
  },
  {
    id: "playlists",
    href: "/content?type=playlists",
    label: "Playlists",
    icon: "mdi:playlist-play",
    title: "View and manage YouTube playlists",
    pathCheck: (pathname) => pathname === "/content" && args.searchParams?.type === "playlists"
  },
  {
    id: "favourites",
    href: "/content?type=favourites",
    label: "Favourites",
    icon: "carbon:favorite",
    title: "View your favourite videos, channels and playlists",
    pathCheck: (pathname) => pathname === "/content" && args.searchParams?.type === "favourites"
  },
  {
    id: "settings",
    href: "/settings",
    label: "Settings",
    icon: "carbon:settings",
    title: "App configuration and preferences",
    pathCheck: (pathname) => pathname.startsWith("/settings")
  },
  {
    id: "admin_dashboard",
    href: "/yto/admin",
    label: "Admin",
    icon: "carbon:dashboard-reference",
    title: "Admin dashboard home",
    pathCheck: (pathname) => pathname === "/yto/admin" || pathname === "/yto/admin/",
    // Only show for admin users
    showIf: () => args.fns.checkAdminRole?.()
  },
];

// Create reactive memo for mobile navigation items
// Automatically updates when isInIframe changes
const mobileNavigationItems = args.createMemo(() => {
  return mobileNavigationItemsData.filter(item => {
    if (item.showIf && typeof item.showIf === 'function') {
      return item.showIf();
    }
    return true; // Show by default if no showIf condition
  });
});

// Quota usage state management
const [quotaUsage, setQuotaUsage] = args.createSignal(null);
const [quotaLoading, setQuotaLoading] = args.createSignal(false);

// Card field setting state management
const [cardFieldSetting, setCardFieldSetting] = args.createSignal();

// Add to playlist modal state
const [isAddToPlaylistModalOpen, setIsAddToPlaylistModalOpen] = args.createSignal(false);
const [playlistModalVideo, setPlaylistModalVideo] = args.createSignal(null);

// Ownership management functions are automatically available from parent Layout via args.fns
// Just create a wrapper for selectOwnership to also refresh quota and card settings
const selectOwnership = async (ownership) => {
  // Call parent's selectOwnership (which handles selection and queue loading)
  await args.fns.selectOwnership?.(ownership);

  // Refresh data for the new ownership
  await fetchQuotaUsage();
  await loadCardFieldSetting();
};


// Fetch shared quota usage from server (10k units/day shared across all ownerships)
const fetchQuotaUsage = async () => {
  // Don't fetch if no ownership selected
  if (!args.fns.getSelectedOwnershipId?.()) {
    return;
  }

  setQuotaLoading(true);
  try {
    const result = await args.fns.executeYTOFunction?.('getSharedQuotaStatus', {});
    if (result?.error) {
      args.showErrorToast(result.error);
    } else if (result?.result?.data) {
      setQuotaUsage(result.result.data);
    }
  } catch (error) {
    console.error('Error fetching shared quota status:', error);
  } finally {
    setQuotaLoading(false);
  }
};

// Check if approaching quota limit (80%)
const isApproachingQuotaLimit = () => {
  const usage = quotaUsage();
  if (!usage || !usage.status) return false;
  return usage.status.isNearLimit;
};

// Check if at quota limit (95%) - should disable actions
const isAtQuotaLimit = () => {
  const usage = quotaUsage();
  if (!usage || !usage.status) return false;
  return usage.status.isAtLimit || usage.status.isCritical;
};

// Get quota reset time (midnight UTC)
const getQuotaResetTime = () => {
  const usage = quotaUsage();
  if (!usage || !usage.reset) {
    // Fallback calculation
    const now = new Date();
    const midnight = new Date(Date.UTC(
      now.getUTCFullYear(),
      now.getUTCMonth(),
      now.getUTCDate() + 1, // Next day
      0, 0, 0, 0 // Midnight
    ));
    const diff = midnight - now;
    const hours = Math.floor(diff / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    return `${hours}h ${minutes}m`;
  }
  return `${usage.reset.inHours}h ${usage.reset.inMinutes}m`;
};

// Get quota usage percentage
const getQuotaUsagePercentage = () => {
  const usage = quotaUsage();
  if (!usage || !usage.quota) return 0;
  return Math.round(usage.quota.percentUsed);
};

// Load card field setting from user setting
const loadCardFieldSetting = async () => {
  try {
    const result = await args.fns.executeYTOFunction?.('getYTOUserSetting', {});
    if (result?.error) {
      args.showErrorToast(result.error);
    } else if (result?.result?.success && result?.result?.data?.setting) {
      const setting = result.result.data.setting;
      if (setting.P.cardFieldSetting) {
        const parsed = typeof setting.P.cardFieldSetting === 'string'
          ? JSON.parse(setting.P.cardFieldSetting)
          : setting.P.cardFieldSetting;
        setCardFieldSetting(parsed);
      }
    }
  } catch (error) {
    console.error('Error loading card field setting:', error);
    // Keep default setting on error
  }
};

// Save card field setting to user setting
const saveCardFieldSetting = async (newSetting) => {
  try {
    // Validate structure
    if (!newSetting || typeof newSetting !== 'object') {
      throw new Error('Invalid card field setting');
    }

    // Ensure all required keys exist
    const validated = {
      video: Array.isArray(newSetting.video) ? newSetting.video : cardFieldSetting().video,
      playlist: Array.isArray(newSetting.playlist) ? newSetting.playlist : cardFieldSetting().playlist,
      channel: Array.isArray(newSetting.channel) ? newSetting.channel : cardFieldSetting().channel
    };

    // Update local state
    setCardFieldSetting(validated);

    // Save to backend
    const result = await args.fns.executeYTOFunction?.('saveYTOUserSetting', {
      setting: {
        cardFieldSetting: validated
      }
    });

    if (result?.error) {
      args.showErrorToast(result.error);
      return false;
    } else if (result?.result?.success) {
      args.showSuccessToast('Card field setting saved successfully');
      return true;
    } else {
      throw new Error('Failed to save setting');
    }
  } catch (error) {
    console.error('Error saving card field setting:', error);
    args.showErrorToast('Failed to save card field setting');
    return false;
  }
};

// Play playlist (loads videos and plays first one)
const playPlaylist = async (playlist) => {
  try {
    const playlistId = playlist?.P?.youtubeId;
    if (!playlistId) {
      args.showErrorToast("Invalid playlist");
      return;
    }

    // Get playlist videos
    const result = await args.fns.executeYTOFunction?.("getPlaylistVideos", { playlistId });

    if (result?.error) {
      args.showErrorToast(result.error);
    } else if (result?.result?.success && result?.result?.data?.videos) {
      const videos = result.result.data.videos;

      if (videos.length === 0) {
        args.showWarningToast("Playlist has no videos");
        return;
      }

      // Play first video using parent's playVideo function
      const firstVideo = videos[0]?.video;
      if (firstVideo && args.fns.playVideo) {
        args.fns.playVideo(firstVideo);

        // Add remaining videos to queue
        const remainingVideos = videos.slice(1).map(v => v.video);
        const currentQueue = args.fns.videoQueue?.() || [];
        if (args.fns.setVideoQueue) {
          // Use internal setter if available, otherwise use addToQueue
          args.fns.setVideoQueue?.([...currentQueue, ...remainingVideos]);
        }

        args.showSuccessToast(`Playing playlist: ${playlist?.P?.title || 'Playlist'}`);
      }
    } else {
      args.showErrorToast("Failed to load playlist videos");
    }
  } catch (error) {
    console.error("Error playing playlist:", error);
    args.showErrorToast("Failed to play playlist");
  }
};

// Add all playlist videos to queue
const addPlaylistToQueue = async (playlist) => {
  try {
    const playlistId = playlist?.P?.youtubeId;
    if (!playlistId) {
      args.showErrorToast("Invalid playlist");
      return;
    }

    // Get playlist videos
    const result = await args.fns.executeYTOFunction?.("getPlaylistVideos", { playlistId });

    if (result?.error) {
      args.showErrorToast(result.error);
    } else if (result?.result?.success && result?.result?.data?.videos) {
      const videos = result.result.data.videos;

      if (videos.length === 0) {
        args.showWarningToast("Playlist has no videos");
        return;
      }

      // Use parent's videoQueue state
      const queue = args.fns.videoQueue?.() || [];
      const newVideos = [];

      // Filter out videos already in queue
      videos.forEach(item => {
        const video = item.video;
        const videoId = video?.P?.youtubeId;
        const alreadyInQueue = queue.some(v => v?.P?.youtubeId === videoId);

        if (!alreadyInQueue && !newVideos.some(v => v?.P?.youtubeId === videoId)) {
          newVideos.push(video);
        }
      });

      if (newVideos.length === 0) {
        args.showWarningToast("All playlist videos are already in queue");
        return;
      }

      // Use parent's setVideoQueue if available
      if (args.fns.setVideoQueue) {
        args.fns.setVideoQueue([...queue, ...newVideos]);
      }
      args.showSuccessToast(`Added ${newVideos.length} video${newVideos.length !== 1 ? 's' : ''} to queue`);
    } else {
      args.showErrorToast("Failed to load playlist videos");
    }
  } catch (error) {
    console.error("Error adding playlist to queue:", error);
    args.showErrorToast("Failed to add playlist to queue");
  }
};

// Add video to playlists
const addVideoToPlaylists = async (data) => {
  try {
    const result = await args.fns.executeYTOFunction?.("addVideoToPlaylists", data);

    if (result?.result?.success) {
      args.showSuccessToast(result.result.message);
      return result.result;
    } else {
      const errorMessage = result?.result?.message || result?.error || "Failed to add video to playlists";
      args.showErrorToast(errorMessage);
      const error = new Error(errorMessage);
      error.toastShown = true;
      throw error;
    }
  } catch (error) {
    // Only show toast for unexpected errors (network, etc.)
    if (!error.toastShown) {
      console.error("Unexpected error adding video to playlists:", error);
      args.showErrorToast("Failed to add video to playlists");
    }
    throw error;
  }
};

// Open add to playlist modal
const openAddToPlaylistModal = (video) => {
  setPlaylistModalVideo(video);
  setIsAddToPlaylistModalOpen(true);
};

// Close add to playlist modal
const closeAddToPlaylistModal = () => {
  setIsAddToPlaylistModalOpen(false);
  setPlaylistModalVideo(null);
};

// Status messages from constants
const STATUS_CONSTANTS = {
  "statuses": {
    "queued": {
      "label": "Queued",
      "message": "Waiting in queue",
      "color": "blue",
      "icon": "carbon:time",
      "canCancel": true,
      "canRetry": false
    },
    "processing": {
      "label": "Processing",
      "message": "Fetching data from YouTube",
      "color": "yellow",
      "icon": "carbon:in-progress",
      "canCancel": true,
      "canRetry": false
    },
    "pending_quota": {
      "label": "Pending Quota",
      "message": "Waiting for quota reset (midnight UTC)",
      "color": "orange",
      "icon": "carbon:pause",
      "canCancel": true,
      "canRetry": true
    },
    "paused": {
      "label": "Paused",
      "message": "Paused by user",
      "color": "gray",
      "icon": "carbon:pause",
      "canCancel": true,
      "canRetry": true
    },
    "completed": {
      "label": "Completed",
      "message": "All data fetched successfully",
      "color": "green",
      "icon": "carbon:checkmark-filled",
      "canCancel": false,
      "canRetry": true
    },
    "completed_with_errors": {
      "label": "Completed with Errors",
      "message": "Completed with some failures",
      "color": "yellow",
      "icon": "carbon:warning-filled",
      "canCancel": false,
      "canRetry": true
    },
    "failed": {
      "label": "Failed",
      "message": "Processing failed",
      "color": "red",
      "icon": "carbon:error-filled",
      "canCancel": false,
      "canRetry": true
    }
  },
  "priorities": {
    "high": {
      "label": "High Priority",
      "color": "red",
      "icon": "carbon:arrow-up",
      "order": 1
    },
    "normal": {
      "label": "Normal Priority",
      "color": "blue",
      "icon": "carbon:minus",
      "order": 2
    },
    "low": {
      "label": "Low Priority",
      "color": "gray",
      "icon": "carbon:arrow-down",
      "order": 3
    }
  }
};

// Get status info
const getStatusInfo = (status) => {
  return STATUS_CONSTANTS.statuses[status] || null;
};

// Get priority info
const getPriorityInfo = (priority) => {
  return STATUS_CONSTANTS.priorities[priority] || null;
};

// Sidebar collapse state management
const [isSidebarCollapsed, setIsSidebarCollapsed] = args.createSignal(false);

const toggleSidebar = async () => {
  const newState = !isSidebarCollapsed();
  setIsSidebarCollapsed(newState);

  // Save to database
  try {
    await args.executeServerFunction('saveSidebarPreference', {
      isCollapsed: newState
    });
  } catch (error) {
    console.error('Failed to save sidebar preference:', error);
  }
};

const loadSidebarState = async () => {
  try {
    const result = await args.executeServerFunction('getSidebarPreference', {});

    if (result.success && result.data) {
      setIsSidebarCollapsed(result.data.isCollapsed);
    }
  } catch (error) {
    console.error('Failed to load sidebar preference:', error);
  }
};

return {
  // Navigation
  navigationSections,
  setNavigationSections,
  mobileNavigationItems,
  // Sidebar
  isSidebarCollapsed,
  toggleSidebar,
  loadSidebarState,
  // Ownership management wrapper (delegates to parent Layout via args.fns)
  selectOwnership,
  // Quota
  quotaUsage,
  quotaLoading,
  fetchQuotaUsage,
  isApproachingQuotaLimit,
  isAtQuotaLimit,
  getQuotaResetTime,
  getQuotaUsagePercentage,
  // Card fields
  cardFieldSetting,
  loadCardFieldSetting,
  saveCardFieldSetting,
  // Playlist actions
  playPlaylist,
  addPlaylistToQueue,
  // Add to playlist modal
  isAddToPlaylistModalOpen,
  playlistModalVideo,
  openAddToPlaylistModal,
  closeAddToPlaylistModal,
  addVideoToPlaylists,
  // Utilities
  getStatusInfo,
  getPriorityInfo
};
'''
        key: LayoutContent
        props:
          '''
return {
  onMount: async () => {
    // Load sidebar state from database
    await args.fns.loadSidebarState();

    // Refresh quota usage and card field setting for current ownership
    // Ownership is already loaded by parent Layout component
    if (args.fns.getSelectedOwnershipId?.()) {
      await args.fns.fetchQuotaUsage();
      await args.fns.loadCardFieldSetting();
    }

    // Refresh quota usage every 5 minutes
    const quotaInterval = setInterval(() => {
      args.fns.fetchQuotaUsage();
    }, 5 * 60 * 1000);

    // Cleanup on unmount
    return () => {
      clearInterval(quotaInterval);
    };
  }
};
'''
      }
    }
