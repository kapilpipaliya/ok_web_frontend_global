        componentName: Html
        props:
          '''
// Get navigation state from ConfirmProvider context
// This controls when the overlay should be visible
const isNavigating = args.fns.isNavigating?.();

return {
  as: "div",
  style: {
    // Show overlay during navigation, hide when complete
    // Uses flex to center the loading spinner
    display: isNavigating ? 'flex' : 'none'
  }
};
'''
      }
    }
    {
      id: "44"
      L: Attr
      P: {
        displayOrder: 1
        componentName: LoadingSpinner
        props:
          '''
return {
  size: "medium",
  color: "primary"
};
'''
      }
    }
    {
      id: "45"
      L: Attr
      P: {
        css:
          '''
return `._id {
  height: 72px;
  background: ${args.theme.var.color.background};
  border-top: 1px solid ${args.theme.var.color.border};
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.1);
  padding: ${args.theme.var.spacing.sm} 0;
  grid-row: 2;
}

._id .slider-container {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 ${args.theme.var.spacing.sm};
  width: 100%;
}

/* Make each nav item equally distributed */
._id .slider-container > * {
  flex: 1;
  display: flex;
  justify-content: center;
  min-width: 0;
}

/* Responsive adjustment - hide on desktop */
@media (min-width: 768px) {
  ._id {
    display: none;
  }
}`;
'''
        displayOrder: 3
        componentName: Html
        props:
          '''
return {
  as: "nav"
};
'''
      }
    }
    {
      id: "46"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div",
  className: "slider-container"
};
'''
      }
    }
    {
      id: "47"
      L: Attr
      P: {
        contextName: mobileNavItem
        css:
          '''
return `._id {
  display: contents;
}`;
'''
        loop: true
        displayOrder: 1
        componentName: Html
        props:
          '''
const items = args.fns.mobileNavigationItems();
return {
  as: "div",
  data: items
};
'''
      }
    }
    {
      id: "48"
      L: Attr
      P: {
        css:
          '''
const item = args.contextData.mobileNavItem;
const isActive = item.pathCheck ? item.pathCheck(args.location.pathname) : false;

return `._id {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: ${args.theme.var.spacing.xs};
  padding: ${args.theme.var.spacing.xs};
  border-radius: ${args.theme.var.borderRadius.sm};
  background: none;
  text-decoration: none;
  cursor: pointer;
  min-height: ${args.theme.var.touch.minTarget};
  color: ${isActive ? args.theme.var.color.primary : args.theme.var.color.muted};
  transition: all ${args.theme.var.animation.fast} ease;
  width: 100%;
  position: relative;

  &:hover {
    background: ${args.theme.var.color.background_light_200};
    color: ${args.theme.var.color.primary};
  }

  &:active {
    transform: scale(0.95);
  }
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const item = args.contextData.mobileNavItem;
const isActive = item.pathCheck ? item.pathCheck(args.location.pathname) : false;
const openInNewTab = item.openInNewTab;

return {
  as: "a",
  href: item.href,
  target: openInNewTab ? "_blank" : undefined,
  rel: openInNewTab ? "noopener noreferrer" : undefined,
  "aria-label": item.label,
  title: item.title,
  onClick: (e) => {
    if (openInNewTab) {
      // Let the browser handle the new tab opening
      return;
    }
    e.preventDefault();
    args.fns.navigateTo?.(item.href);
  }
};
'''
      }
    }
    {
      id: "49"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const item = args.contextData.mobileNavItem;
const iconSize = item.iconSize || 24;
return {
  as: "icon",
  icon: item.icon,
  width: iconSize,
  height: iconSize
};
'''
      }
    }
