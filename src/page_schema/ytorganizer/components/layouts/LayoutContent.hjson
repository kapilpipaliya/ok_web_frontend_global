const item = args.contextData.navItem;
const isActive = item.pathCheck ? item.pathCheck(args.location.pathname) : false;
const isButton = item.isButton;
const isDanger = item.isDanger;
const isCollapsed = args.fns.isSidebarCollapsed?.();

return `._id {
  display: flex;
  align-items: center;
  gap: ${args.theme.var.spacing.md};
  padding: ${args.theme.var.spacing.sm} ${isCollapsed ? args.theme.var.spacing.sm : args.theme.var.spacing.md};
  border-radius: ${args.theme.var.borderRadius.md};
  background: ${isActive ? args.theme.var.color.background_light_200 : 'transparent'};
  color: ${isDanger ? args.theme.var.color.error : (isActive ? args.theme.var.color.primary : args.theme.var.color.text)};
  text-decoration: none;
  font-weight: ${isActive ? '600' : '500'};
  transition: all ${args.theme.var.animation.fast} ease;
  ${isCollapsed ? 'justify-content: center;' : ''}
  ${isButton ? `
    border: none;
    font-size: inherit;
    font-family: inherit;
    cursor: pointer;
    width: 100%;
    text-align: left;
  ` : ''}

  &:hover {
    background: ${isDanger ? args.theme.var.color.error_light_100 : args.theme.var.color.background_light_200};
    color: ${isDanger ? args.theme.var.color.error_light_100_text : args.theme.var.color.primary};
  }

  ${isButton ? `
    &:active {
      transform: scale(0.98);
    }
  ` : ''}
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const item = args.contextData.navItem;
const isActive = item.pathCheck ? item.pathCheck(args.location.pathname) : false;
const isButton = item.isButton;
const isDanger = item.isDanger;
const openInNewTab = item.openInNewTab;

return {
  as: isButton ? "button" : "a",
  href: !isButton ? item.href : undefined,
  target: openInNewTab ? "_blank" : undefined,
  rel: openInNewTab ? "noopener noreferrer" : undefined,
  "aria-label": item.label,
  title: item.title,
  onClick: (e) => {
    if (openInNewTab) {
      // Let the browser handle the new tab opening
      return;
    }
    e.preventDefault();
    args.fns.navigateTo?.(item.href);
  }
};
'''
      }
    }
