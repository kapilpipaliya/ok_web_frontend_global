const isAtLimit = args.fns.isAtQuotaLimit?.();
const resetTime = args.fns.getQuotaResetTime?.();
const usage = args.fns.quotaUsage?.();
const usedQuota = usage?.quota?.used || 0;
const dailyLimit = usage?.quota?.limit || 10000;
const remaining = usage?.quota?.effectiveRemaining || 0;

return {
  as: "span",
  text: isAtLimit
    ? `Shared YouTube API quota nearly exhausted (${usedQuota.toLocaleString()}/${dailyLimit.toLocaleString()} units, ${remaining} remaining). All users share this 10k daily quota. Adding channels and playlists is temporarily disabled. Resets in ${resetTime}.`
    : `Approaching shared YouTube API quota limit (${usedQuota.toLocaleString()}/${dailyLimit.toLocaleString()} units used). All users share this 10k daily quota. Resets in ${resetTime}.`
};
'''
      }
    }
