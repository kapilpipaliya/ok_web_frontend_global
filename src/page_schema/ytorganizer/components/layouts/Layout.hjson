  setVideoQueue: args.fns.setVideoQueue,
  playVideo: args.fns.playVideo,
  removeFromQueue: args.fns.removeFromQueue,
  clearQueue: args.fns.clearQueue,
  reorderQueue: args.fns.reorderQueue,
  getOwnershipId: args.fns.getOwnershipId,
