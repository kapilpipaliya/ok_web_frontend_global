{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''
// Check if user is admin
const checkAdminRole = () => {
  const userRoles = args.user?.OUT?.UserRole || [];
  return userRoles.some(edgeId => {
    const edge = args.graph.edges[edgeId];
    const role = args.graph.vertexes[edge.E];
    return role?.P?.key === "Admin";
  });
};

// Impersonation state management
const [impersonatedUser, setImpersonatedUser] = args.createSignal(null);

// Check if running in iframe (initialized on mount to avoid hydration issues)
const [isInIframe, setIsInIframe] = args.createSignal(false);

// Load impersonation state from sessionStorage (client-side only)
// This is called from onMount to avoid SSR/hydration mismatch
const loadImpersonationState = () => {
  const storedImpersonation = sessionStorage.getItem('yto_impersonatedUser');
  if (storedImpersonation) {
    try {
      setImpersonatedUser(JSON.parse(storedImpersonation));
    } catch (e) {
      // Ignore parsing errors
    }
  }
};

// Exit impersonation
const exitImpersonation = async () => {
  const impersonated = impersonatedUser();
  if (!impersonated) return;

  const result = await args.executeNamedServerFunction({
    functionName: "clearImpersonation",
    contextData: { impersonatedUserUuid: impersonated.P.uuid }
  });

  setImpersonatedUser(null);
  sessionStorage.removeItem('yto_impersonatedUser');
  args.showSuccessToast("Stopped viewing as user");

  // Reload current page to refresh data
  window.location.reload();
};

// YouTube Ownership state management (multi-account support)
const [ownerships, setOwnerships] = args.createSignal([]);
const [selectedOwnership, setSelectedOwnership] = args.createSignal(null);
const [ownershipsLoading, setOwnershipsLoading] = args.createSignal(false);

// Get selected ownershipId for contextData
const getSelectedOwnershipId = () => {
  const ownership = selectedOwnership();
  return ownership?.P?.key || null;
};

// Get impersonatedUserUuid for contextData
const getImpersonatedUserUuid = () => {
  const impersonated = impersonatedUser();
  return impersonated?.P?.uuid || null;
};

// Wrapper for executeNamedServerFunction that automatically includes impersonatedUserUuid and ownershipId
const executeYTOFunction = async (functionName, contextData = {}) => {
  const impersonatedUserUuid = getImpersonatedUserUuid();
  const ownershipId = getSelectedOwnershipId();

  return await args.executeNamedServerFunction({
    functionName,
    contextData: {
      ...contextData,
      // Only add impersonatedUserUuid if it exists (admin is impersonating)
      ...(impersonatedUserUuid ? { impersonatedUserUuid } : {}),
      // Add ownershipId if selected (required for most operations)
      ...(ownershipId ? { ownershipId } : {})
    }
  });
};

// Fetch all YouTube ownerships for the user
const fetchOwnerships = async () => {
  setOwnershipsLoading(true);
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "getAllYouTubeOwnerships",
      contextData: {}
    });

    if (result?.error) {
      args.showErrorToast(result.error);
    } else if (result?.result?.success && result?.result?.data) {
      // Extract ownership objects and connection status
      const ownershipsData = result.result.data;
      const ownershipsList = ownershipsData.map(item => ({
        ...item.ownership,
        _isConnected: item.isConnected // Store connection status
      }));
      setOwnerships(ownershipsList);

      // If no ownership is selected and we have ownerships, select the first connected one
      if (!selectedOwnership() && ownershipsList.length > 0) {
        const connectedOwnerships = ownershipsList.filter(o => o._isConnected);
        const primaryOwnership = connectedOwnerships.find(o => o.P.isPrimary);
        const defaultOwnership = primaryOwnership || connectedOwnerships[0] || ownershipsList[0];
        await selectOwnership(defaultOwnership);
      } else if (selectedOwnership()) {
        // If an ownership is already selected (from sessionStorage),
        // verify it still exists in the fetched list
        const currentOwnershipId = selectedOwnership().P.key;
        const stillExists = ownershipsList.find(o => o.P.key === currentOwnershipId);

        if (!stillExists && ownershipsList.length > 0) {
          // Selected ownership no longer exists, select first available connected ownership
          const connectedOwnerships = ownershipsList.filter(o => o._isConnected);
          const primaryOwnership = connectedOwnerships.find(o => o.P.isPrimary);
          const defaultOwnership = primaryOwnership || connectedOwnerships[0] || ownershipsList[0];
          await selectOwnership(defaultOwnership);
        }
      }
    }
  } catch (error) {
    console.error('Error fetching ownerships:', error);
    args.showErrorToast('Failed to load YouTube accounts');
  } finally {
    setOwnershipsLoading(false);
  }
};

// Select a YouTube ownership (account)
const selectOwnership = async (ownership) => {
  if (!ownership) return;

  setSelectedOwnership(ownership);

  // Save to sessionStorage
  sessionStorage.setItem('yto_selectedOwnership', JSON.stringify(ownership));

  // Update lastSelected on server
  try {
    await args.executeNamedServerFunction({
      functionName: "updateOwnershipLastSelected",
      contextData: { ownershipId: ownership.P.key }
    });
  } catch (error) {
    console.error('Error updating ownership lastSelected:', error);
  }

  // Queue will be loaded automatically by the createEffect below
};

// Load ownership state from sessionStorage
const loadOwnershipState = () => {
  const storedOwnership = sessionStorage.getItem('yto_selectedOwnership');
  if (storedOwnership) {
    try {
      const ownership = JSON.parse(storedOwnership);
      setSelectedOwnership(ownership);
    } catch (e) {
      // Ignore parsing errors
    }
  }
};

// Automatically load queue when ownership changes
args.createEffect(args.on(selectedOwnership, async (ownership) => {
  if (ownership && args.user) {
    await loadQueueFromDatabase();
  }
}, { defer: true }));

// Keep Awake wrapper functions
const keepAwake = async () => {
  await args.KeepAwake.keepAwake();
};

const allowSleep = async () => {
  await args.KeepAwake.allowSleep();
};

const isSupported = async () => {
  const result = await args.KeepAwake.isSupported();
  return result.isSupported;
};

const isKeptAwake = async () => {
  const result = await args.KeepAwake.isKeptAwake();
  return result.isKeptAwake;
};

// Keep Awake management
const enableKeepAwake = async () => {
  try {
    const supported = await isSupported();
    if (!supported) return;

    const alreadyAwake = await isKeptAwake();
    if (alreadyAwake) return;

    await keepAwake();
    console.log('Keep Awake enabled');
  } catch (error) {
    console.error('Error enabling Keep Awake:', error);
  }
};

const disableKeepAwake = async () => {
  try {
    const supported = await isSupported();
    if (!supported) return;

    const awake = await isKeptAwake();
    if (!awake) return;

    await allowSleep();
    console.log('Keep Awake disabled');
  } catch (error) {
    console.error('Error disabling Keep Awake:', error);
  }
};

// Video player state management
const [playerState, setPlayerState] = args.createSignal("closed"); // closed, minimized, maximized
const [currentVideo, setCurrentVideo] = args.createSignal(null);

// Player position and size state
const [playerPosition, setPlayerPosition] = args.createStore({ x: null, y: null });
const [playerSize, setPlayerSize] = args.createStore({ width: 400, height: 250 });

// Video queue state
const [videoQueue, setVideoQueue] = args.createSignal([]);
const [queueLoading, setQueueLoading] = args.createSignal(false);
const [queueOperationLoading, setQueueOperationLoading] = args.createSignal(false);

// Get ownership ID helper
const getOwnershipId = () => {
  return getSelectedOwnershipId();
};

// Load queue from database
const loadQueueFromDatabase = async () => {
  const ownershipId = getOwnershipId();
  if (!ownershipId || !args.user) return;

  setQueueLoading(true);
  try {
    const result = await executeYTOFunction("loadVideoQueue");

    if (result?.result?.success) {
      setVideoQueue(result.result.data || []);
    } else {
      const errorMsg = result?.result?.message || result?.error || `Failed to load video queue`;
      setFormError(errorMsg);
    }
  } catch (error) {
    console.error("Error loading queue from database:", error);
  } finally {
    setQueueLoading(false);
  }
};

// Play video in the player
const playVideo = async (video) => {
  setCurrentVideo(video);
  setPlayerState("minimized");
  await enableKeepAwake();

  // Add video to queue if not already in queue
  await addToQueue(video);
};

// Add video to queue
const addToQueue = async (video) => {
  const queue = videoQueue();
  const videoId = video?.P?.youtubeId;

  // Check if video already in queue
  const alreadyInQueue = queue.some(v => v?.P?.youtubeId === videoId);
  if (alreadyInQueue) {
    args.showWarningToast("Video already in queue");
    return;
  }

  // Optimistic update
  setVideoQueue([...queue, video]);

  // Save to database
  const ownershipId = getOwnershipId();
  if (ownershipId && args.user) {
    setQueueOperationLoading(true);
    try {
      const result = await executeYTOFunction("addVideoToQueue", { video });

      if (result?.result?.success) {
        // Update with server response to ensure consistency
        setVideoQueue(result.result.data || [...queue, video]);
        args.showSuccessToast("Added to queue");
      } else {
        // Rollback on error
        setVideoQueue(queue);
        args.showErrorToast(result?.result?.message || result?.error || "Failed to add to queue");
      }
    } catch (error) {
      // Rollback on error
      setVideoQueue(queue);
      args.showErrorToast("Failed to add to queue");
      console.error("Error saving to queue:", error);
    } finally {
      setQueueOperationLoading(false);
    }
  } else {
    args.showSuccessToast("Added to queue");
  }
};

// Play next video from queue
const playNext = async () => {
  const queue = videoQueue();
  if (queue.length === 0) {
    // Don't close player when queue is empty, just keep current video
    // setPlayerState("closed");
    // setCurrentVideo(null);
    return;
  }

  const nextVideo = queue[0];
  const newQueue = queue.slice(1);

  // Optimistic update
  setCurrentVideo(nextVideo);
  setVideoQueue(newQueue);

  // Save to database (remove first video)
  const ownershipId = getOwnershipId();
  if (ownershipId && args.user) {
    try {
      const result = await executeYTOFunction("removeVideoFromQueue", { position: 0 });

      if (result?.error) {
        args.showErrorToast(result.error);
      } else if (result?.result?.success) {
        // Update with server response to ensure consistency
        setVideoQueue(result.result.data || newQueue);
      }
    } catch (error) {
      console.error("Error updating queue in database:", error);
    }
  }
};

// Remove video from queue
const removeFromQueue = async (index) => {
  const queue = videoQueue();
  const newQueue = [...queue.slice(0, index), ...queue.slice(index + 1)];

  // Optimistic update
  setVideoQueue(newQueue);

  // Save to database
  const ownershipId = getOwnershipId();
  if (ownershipId && args.user) {
    setQueueOperationLoading(true);
    try {
      const result = await executeYTOFunction("removeVideoFromQueue", { position: index });

      if (result?.result?.success) {
        // Update with server response to ensure consistency
        setVideoQueue(result.result.data || newQueue);
        args.showSuccessToast("Removed from queue");
      } else {
        // Rollback on error
        setVideoQueue(queue);
        args.showErrorToast(result?.result?.message || result?.error || "Failed to remove from queue");
      }
    } catch (error) {
      // Rollback on error
      setVideoQueue(queue);
      args.showErrorToast("Failed to remove from queue");
      console.error("Error removing from queue:", error);
    } finally {
      setQueueOperationLoading(false);
    }
  } else {
    args.showSuccessToast("Removed from queue");
  }
};

// Clear entire queue
const clearQueue = async () => {
  const previousQueue = videoQueue();

  // Optimistic update
  setVideoQueue([]);

  // Save to database
  const ownershipId = getOwnershipId();
  if (ownershipId && args.user) {
    setQueueOperationLoading(true);
    try {
      const result = await executeYTOFunction("clearVideoQueue");

      if (result?.result?.success) {
        args.showSuccessToast("Queue cleared");
      } else {
        // Rollback on error
        setVideoQueue(previousQueue);
        args.showErrorToast(result?.result?.message || result?.error || "Failed to clear queue");
      }
    } catch (error) {
      // Rollback on error
      setVideoQueue(previousQueue);
      args.showErrorToast("Failed to clear queue");
      console.error("Error clearing queue:", error);
    } finally {
      setQueueOperationLoading(false);
    }
  } else {
    args.showSuccessToast("Queue cleared");
  }
};

// Reorder video in queue
const reorderQueue = async (fromIndex, toIndex) => {
  const queue = videoQueue();

  // Validate indices
  if (fromIndex < 0 || fromIndex >= queue.length || toIndex < 0 || toIndex >= queue.length) {
    args.showErrorToast("Invalid queue position");
    return;
  }

  if (fromIndex === toIndex) {
    return; // No change needed
  }

  // Optimistic update - reorder the array
  const newQueue = [...queue];
  const [movedVideo] = newQueue.splice(fromIndex, 1);
  newQueue.splice(toIndex, 0, movedVideo);
  setVideoQueue(newQueue);

  // Save to database
  const ownershipId = getOwnershipId();
  if (ownershipId && args.user) {
    setQueueOperationLoading(true);
    try {
      const result = await executeYTOFunction("reorderVideoQueue", { fromPosition: fromIndex, toPosition: toIndex });

      if (result?.result?.success) {
        // Update with server response to ensure consistency
        setVideoQueue(result.result.data || newQueue);
        args.showSuccessToast("Queue reordered");
      } else {
        // Rollback on error
        setVideoQueue(queue);
        args.showErrorToast(result?.result?.message || result?.error || "Failed to reorder queue");
      }
    } catch (error) {
      // Rollback on error
      setVideoQueue(queue);
      args.showErrorToast("Failed to reorder queue");
      console.error("Error reordering queue:", error);
    } finally {
      setQueueOperationLoading(false);
    }
  } else {
    args.showSuccessToast("Queue reordered");
  }
};

// Queue modal state
const [isQueueModalOpen, setIsQueueModalOpen] = args.createSignal(false);

const openQueueModal = () => {
  setIsQueueModalOpen(true);
};

const closeQueueModal = () => {
  setIsQueueModalOpen(false);
};

// Toggle player state
const togglePlayerState = () => {
  const current = playerState();
  if (current === "minimized") {
    setPlayerState("maximized");
  } else if (current === "maximized") {
    setPlayerState("minimized");
  }
};

// Close player
const closePlayer = async () => {
  setPlayerState("closed");
  setCurrentVideo(null);
  await disableKeepAwake();
};

// Feedback modal state management
const [isFeedbackModalOpen, setIsFeedbackModalOpen] = args.createSignal(false);

const openFeedbackModal = () => {
  setIsFeedbackModalOpen(true);
};

const closeFeedbackModal = () => {
  setIsFeedbackModalOpen(false);
};

const submitFeedback = async (data) => {
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "saveFeedback",
      contextData: data
    });

    if (result?.result?.success) {
      args.showSuccessToast(result.result.message || "Feedback submitted successfully");
      return result.result;
    } else {
      args.showErrorToast(result?.result?.message || "Failed to submit feedback");
      return result?.result;
    }
  } catch (error) {
    console.error("Error submitting feedback:", error);
    args.showErrorToast("An error occurred while submitting feedback");
    return { success: false };
  }
};

// Common function to open YouTube URL in same tab (for extension)
const openYouTubeInParentTab = (url) => {
  if (!url) return;

  // Send message to extension if in iframe context
  if (window.parent !== window) {
    // We're in an iframe (extension modal or popup)
    window.parent.postMessage({
      type: 'OPEN_IN_SAME_TAB',
      url: url
    }, '*');
  } else if (window.opener && window.opener.postMessage) {
    // We're in a popup window
    window.opener.postMessage({
      type: 'OPEN_IN_SAME_TAB',
      url: url
    }, '*');
  } else {
    // Fallback to regular navigation
    window.location.href = url;
  }
};

return {
  checkAdminRole,
  impersonatedUser,
  exitImpersonation,
  getImpersonatedUserUuid,
  loadImpersonationState,
  isInIframe,
  setIsInIframe,
  // Ownership management
  ownerships,
  selectedOwnership,
  ownershipsLoading,
  getSelectedOwnershipId,
  executeYTOFunction,
  fetchOwnerships,
  selectOwnership,
  loadOwnershipState,
  // Keep Awake
  keepAwake,
  allowSleep,
  isSupported,
  isKeptAwake,
  enableKeepAwake,
  disableKeepAwake,
  // Video player
  playerState,
  currentVideo,
  playVideo,
  togglePlayerState,
  closePlayer,
  playerPosition,
  setPlayerPosition,
  playerSize,
  setPlayerSize,
  // Video queue
  videoQueue,
  setVideoQueue,
  queueLoading,
  queueOperationLoading,
  getOwnershipId,
  loadQueueFromDatabase,
  addToQueue,
  playNext,
  removeFromQueue,
  clearQueue,
  reorderQueue,
  isQueueModalOpen,
  openQueueModal,
  closeQueueModal,
  // Feedback
  isFeedbackModalOpen,
  openFeedbackModal,
  closeFeedbackModal,
  submitFeedback,
  // Utilities
  openYouTubeInParentTab
};
'''
        key: Layout
        props:
          '''
return {
  onMount: async () => {
    if (typeof window !== 'undefined') {
      args.fns.setIsInIframe?.(window.self !== window.top);
    }

    // Load saved impersonation state from sessionStorage
    args.fns.loadImpersonationState?.();

    // Load saved ownership state from sessionStorage
    args.fns.loadOwnershipState?.();

    // Fetch ownerships (will auto-select and load queue)
    await args.fns.fetchOwnerships?.();
  }
};
'''
      }
