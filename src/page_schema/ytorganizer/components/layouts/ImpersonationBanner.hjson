  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: ${args.theme.var.spacing.md};
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  border-bottom: 2px solid ${args.theme.var.color.warning_dark_200};

  @media (max-width: 768px) {
    flex-direction: column;
    gap: ${args.theme.var.spacing.sm};
    padding: ${args.theme.var.spacing.sm};
  }
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const impersonatedUser = args.contextData.props?.impersonatedUser;
const onExitImpersonation = args.contextData.props?.onExitImpersonation;

if (!impersonatedUser) {
  return { as: "div", hide: true };
}

return {
  as: "div"
};
'''
