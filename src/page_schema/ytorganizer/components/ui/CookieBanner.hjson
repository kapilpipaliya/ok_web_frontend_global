          '''
return `._id {
  display: flex;
  justify-content: flex-end;
}

@media (max-width: 768px) {
  ._id {
    width: 100%;
  }
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''
return {
  as: "div"
};
'''
      }
    }
    {
      id: "11"
      L: Attr
      P: {
        css:
          '''
return `._id {
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  border: none;
  padding: 0.625rem 1.5rem;
  border-radius: 0.5rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}

._id:hover {
  background: ${args.theme.var.color.primary_dark_200};
  color: ${args.theme.var.color.primary_dark_200_text};
  transform: translateY(-1px);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

@media (max-width: 768px) {
  ._id {
    width: 100%;
    padding: 0.75rem 1rem;
  }
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "button",
  text: "Accept Cookies",
  onClick: args.fns.acceptCookies
};
'''
