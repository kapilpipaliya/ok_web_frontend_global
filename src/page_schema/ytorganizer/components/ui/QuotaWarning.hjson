          '''
const data = args.fns.quotaData();
const isOverLimit = data?.isOverLimit || false;
return `._id {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  max-width: 400px;
  background: ${isOverLimit ? args.theme.var.color.error_light_800 : args.theme.var.color.warning_light_800};
  border: 1px solid ${isOverLimit ? args.theme.var.color.error : args.theme.var.color.warning};
  border-radius: 0.75rem;
  padding: 1.25rem;
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
  z-index: 1000;
  animation: slideInUp 0.3s ease;
}

@keyframes slideInUp {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@media (max-width: 768px) {
  ._id {
    bottom: 1rem;
    right: 1rem;
    left: 1rem;
    max-width: none;
  }
}`;
'''
        displayOrder: 1
        fns:
          '''
const [quotaData, setQuotaData] = args.createSignal(null);
const [isLoading, setIsLoading] = args.createSignal(false);
const [showWarning, setShowWarning] = args.createSignal(false);

// Check quota
const checkQuota = async () => {
  try {
    setIsLoading(true);
    const response = await args.executeNamedServerFunction({
      functionName: "getUserSubscription",
      contextData: {}
    });

    if (response.error) {
      console.error("Error checking quota:", response.error);
    } else if (response.result?.success && response.result?.data) {
      setQuotaData(response.result.data);
      // Show warning if approaching or over limit
      setShowWarning(response.result.data.isApproachingLimit || response.result.data.isOverLimit);
    }
  } catch (error) {
    console.error("Error checking quota:", error);
  } finally {
    setIsLoading(false);
  }
};

// Dismiss warning
const dismissWarning = () => {
  setShowWarning(false);
};

return {
  quotaData,
  isLoading,
  showWarning,
  dismissWarning,
  checkQuota
};
'''
        componentName: Html
        props:
          '''
return {
  as: "div",
  hide: () => !args.fns.showWarning(),
  onMount: args.fns.checkQuota
};
'''
      }
    }
