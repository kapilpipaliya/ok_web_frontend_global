  border-radius: 0.375rem;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

._id:hover {
  background: rgba(0, 0, 0, 0.05);
}`;
'''
      }
    }
  ],
  edges: [
