{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: Table
        dynamicComponent: TomSelect
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        displayOrder: 1
        fns:
          '''
const getLoadFromSetting = () => args.contextData.props?.loadFromSetting === true;
const getContentType = () => args.contextData.props?.contentType;
const getConfigFunction = () => args.contextData.props?.configFunction;
const getSettingsFunction = () => {
  const loadFromSetting = getLoadFromSetting();
  if (loadFromSetting) {
    return getGenericSettingsFunction();
  }
  return args.contextData.props?.settingsFunction;
};
const getSaveSettingsFunction = () => {
  const loadFromSetting = getLoadFromSetting();
  if (loadFromSetting) {
    return getGenericSaveSettingsFunction();
  }
  return args.contextData.props?.saveSettingsFunction;
};

// Memoized config accessor (evaluates once per settings change)
const [memoizedConfig, setMemoizedConfig] = args.createSignal(null);
const [memoizedLoadFromSetting, setMemoizedLoadFromSetting] = args.createSignal(false);
const [isSettingsModalOpen, setIsSettingsModalOpen] = args.createSignal(false);
const [settings, setSettings] = args.createSignal(null);
const [evaluatedConfig, setEvaluatedConfig] = args.createSignal(null);

// Evaluate and cache config (memoized)
const evaluateConfig = () => {
  const cached = evaluatedConfig();
  if (cached !== null) return cached;
  
  const loadFromSetting = getLoadFromSetting();
  const currentSettings = settings();
  let config = null;
  
  // If loadFromSetting is true, only use settings (no props fallback)
  if (loadFromSetting) {
    if (currentSettings && typeof currentSettings === 'string') {
      try {
        const configFunction = new Function(currentSettings);
        config = configFunction();
        if (config && typeof config === 'object') {
          setEvaluatedConfig(config);
          return config;
        }
      } catch (error) {
        console.error("Error evaluating settings function body:", error);
      }
    }
    // If loadFromSetting is true but no settings, return empty config
    config = {};
    setEvaluatedConfig(config);
    return config;
  }
  
  // If settings exist and it's a string (function body), evaluate it
  if (currentSettings && typeof currentSettings === 'string') {
    try {
      const configFunction = new Function(currentSettings);
      const evaluated = configFunction();
      if (evaluated && typeof evaluated === 'object') {
        config = {
          columns: evaluated.columns,
          formConfig: evaluated.formConfig,
          uniqueKeys: evaluated.uniqueKeys || []
        };
        setEvaluatedConfig(config);
        return config;
      }
    } catch (error) {
      console.error("Error evaluating settings function body:", error);
    }
  }
  
  // Fallback to configFunction
  const configFn = getConfigFunction();
  if (configFn) {
    try {
      const evaluated = configFn();
      if (evaluated && typeof evaluated === 'object') {
        config = {
          columns: evaluated.columns,
          formConfig: evaluated.formConfig,
          uniqueKeys: evaluated.uniqueKeys || []
        };
        setEvaluatedConfig(config);
        return config;
      }
    } catch (error) {
      console.error("Error evaluating config function:", error);
    }
  }
  
  // Fallback to props
  config = {
    columns: args.contextData.props?.columns || [],
    formConfig: args.contextData.props?.formConfig,
    uniqueKeys: []
  };
  setEvaluatedConfig(config);
  return config;
};

// Update memoized values when settings change
const updateMemoizedConfig = () => {
  const config = evaluateConfig();
  const loadFromSetting = getLoadFromSetting();
  setMemoizedConfig(config);
  setMemoizedLoadFromSetting(loadFromSetting);
};

// Get cached config (only evaluates if cache is invalid)
const getCachedConfig = () => {
  const cached = memoizedConfig();
  if (cached !== null) {
    return { config: cached, loadFromSetting: memoizedLoadFromSetting() };
  }
  updateMemoizedConfig();
  return { config: memoizedConfig(), loadFromSetting: memoizedLoadFromSetting() };
};

// Get props from context or settings (optimized - single config evaluation per render)
const prop = (p) => {
  const { config, loadFromSetting } = getCachedConfig();
  if (loadFromSetting) {
    return config[p];
  }
  return args.contextData.props[p];
};

// Generic wrapper functions (used when loadFromSetting is true)
const getGenericDataFunction = () => {
  const contentType = getContentType();
  if (!contentType) return null;
  
  return async (filters = {}) => {
    try {
      const result = await args.fns.executeYTOFunction("getUserContent", {
        contentType,
        search: filters.search,
        filters: filters.filters,
        sort: filters.sort
      });

      if (result?.error) {
        args.showErrorToast?.(result.error);
        return { data: [] };
      }

      if (result?.result) {
        if (result.result.error) {
          args.showErrorToast?.(result.result.error);
          return { data: [] };
        }
        if (result.result.success && result.result.data) {
          return { data: Array.isArray(result.result.data) ? result.result.data : [] };
        }
      }

      return { data: [] };
    } catch (error) {
      console.error("Error fetching data:", error);
      args.showErrorToast?.("Failed to load data");
      return { data: [] };
    }
  };
};

const getGenericSettingsFunction = () => {
  const contentType = getContentType();
  if (!contentType) return null;
  
  return async () => {
    try {
      const result = await args.fns.executeYTOFunction("getUserContentSetting", {
        contentType,
        key: `${contentType}_settings`
      });
      if (result?.result?.success && result.result.data?.setting) {
        return result.result;
      }
    } catch (error) {
      console.error("Error loading settings:", error);
    }
    return { success: false, data: { setting: null } };
  };
};

const getGenericSaveSettingsFunction = () => {
  const contentType = getContentType();
  if (!contentType) return null;
  
  return async (configText) => {
    try {
      const result = await args.fns.executeYTOFunction("saveUserContentSetting", {
        contentType,
        key: `${contentType}_settings`,
        config: configText
      });
      if (result?.error) {
        return { success: false, message: result.error };
      }
      if (result?.result) {
        if (result.result.error) {
          return { success: false, message: result.result.error };
        }
        if (result.result.success) {
          return { success: true, message: result.result.message || "Settings saved successfully" };
        }
      }
      return { success: false, message: "Failed to save settings" };
    } catch (error) {
      console.error("Error saving settings:", error);
      return { success: false, message: error?.message || "Failed to save settings" };
    }
  };
};

const getGenericImportFunction = () => {
  const contentType = getContentType();
  if (!contentType) return null;
  
  return async ({ data }) => {
    try {
      const result = await args.fns.executeYTOFunction("importUserContent", {
        contentType,
        data
      });

      if (result?.error) {
        return { success: false, message: result.error };
      }

      if (result?.result) {
        if (result.result.error) {
          return { success: false, message: result.result.error };
        }
        if (result.result.success) {
          return { success: true, message: result.result.message };
        }
      }

      return { success: false, message: "Failed to import data" };
    } catch (error) {
      console.error("Error importing data:", error);
      return { success: false, message: error.message || "Failed to import data" };
    }
  };
};

const getGenericExportFunction = () => {
  const contentType = getContentType();
  if (!contentType) return null;
  
  return async ({ data, columns }) => {
    try {
      const sanitizedColumns = JSON.parse(JSON.stringify(columns));
      const result = await args.fns.executeYTOFunction("exportUserContent", {
        contentType,
        format: "csv",
        data: data,
        columns: sanitizedColumns
      });

      if (result?.error) {
        return { success: false, message: result.error };
      }

      if (result?.result) {
        if (result.result.error) {
          return { success: false, message: result.result.error };
        }
        if (result.result.success) {
          return {
            success: true,
            data: result.result.data,
            contentType: result.result.contentType,
            filename: result.result.filename
          };
        }
      }

      return { success: false, message: "Failed to export data" };
    } catch (error) {
      console.error("Error exporting data:", error);
      return { success: false, message: error.message || "Failed to export data" };
    }
  };
};

const getGenericSaveFunction = () => {
  const contentType = getContentType();
  if (!contentType) return null;
  
  return async ({ mode, data, originalRow }) => {
    let uniqueKeys = [];
    const config = evaluateConfig();
    uniqueKeys = config?.uniqueKeys || [];
    
    try {
      const result = await args.fns.executeYTOFunction("mutateUserContent", {
        contentType,
        operation: mode === "add" ? "create" : mode === "edit" ? "update" : "delete",
        data: mode === "delete" ? {} : data,
        elementId: originalRow?.id,
        uniqueKeys: uniqueKeys
      });

      if (result?.error) {
        return { success: false, message: result.error };
      }

      if (result?.result) {
        if (result.result.error) {
          return { success: false, message: result.result.error };
        }
        if (result.result.success) {
          return { success: true, data: result.result.data };
        }
        return { success: false, message: result.result.message || "Failed to save" };
      }

      return { success: false, message: "Failed to save" };
    } catch (error) {
      console.error("Error saving:", error);
      return { success: false, message: error.message || "Failed to save" };
    }
  };
};

// Load settings
const loadSettings = async () => {
  const settingsFn = getSettingsFunction();
  if (!settingsFn) return null;
  
  try {
    const result = await settingsFn();
    if (result?.success && result?.data?.setting) {
      const settingData = result.data.setting.P || {};
      // Get the raw config text (function body) - don't evaluate it
      const configText = settingData.config;
      if (typeof configText === 'string') {
        setSettings(configText);
        setEvaluatedConfig(null); // Clear evaluation cache
        setMemoizedConfig(null); // Clear memoized cache
        return configText;
      }
    }
  } catch (error) {
    console.error("Error loading settings:", error);
  }
  return null;
};

// Initialize settings on mount
const initializeSettings = async () => {
  const settingsFn = getSettingsFunction();
  if (settingsFn) {
    await loadSettings();
    // Initialize memoized config after loading settings
    updateMemoizedConfig();
  } else {
    // Initialize memoized config even without settings
    updateMemoizedConfig();
  }
};

const getColumns = () => prop('columns') || [];
const getDataFunction = () => {
  const { loadFromSetting } = getCachedConfig();
  if (loadFromSetting) {
    return getGenericDataFunction();
  }
  return prop('dataFunction') || args.contextData.props?.dataFunction;
};
const getRowHeight = () => prop('rowHeight') || 50;
const getTitle = () => prop('title');
const getSearchPlaceholder = () => prop('searchPlaceholder') || "Search...";
const getAdditionalFilters = () => prop('additionalFilters') || [];
const getCustomActions = () => prop('customActions') || [];
const getBatchActions = () => prop('batchActions') || [];
const getShowRowNumber = () => prop('showRowNumber') || false;
const getHideColumns = () => prop('hideColumns') || [];
const getFormConfig = () => {
  const formConfig = prop('formConfig');
  const { loadFromSetting } = getCachedConfig();
  if (loadFromSetting && formConfig && !formConfig.saveFunction) {
    // Add generic save function to formConfig when loadFromSetting is true
    return {
      ...formConfig,
      saveFunction: getGenericSaveFunction()
    };
  }
  return formConfig;
};
const getUniqueKeys = () => prop('uniqueKeys') || [];
const getShowAddButton = () => prop('showAddButton') ?? true;
const getShowEditButton = () => prop('showEditButton') ?? true;
const getImportFunction = () => {
  const { loadFromSetting } = getCachedConfig();
  if (loadFromSetting) {
    return getGenericImportFunction();
  }
  return prop('importFunction') || args.contextData.props?.importFunction;
};
const getExportFunction = () => {
  const { loadFromSetting } = getCachedConfig();
  if (loadFromSetting) {
    return getGenericExportFunction();
  }
  return prop('exportFunction') || args.contextData.props?.exportFunction;
};
const getShowSelection = () => prop('showSelection');
const getShowActions = () => prop('showActions');
const getResizableColumns = () => prop('resizableColumns') ?? true;

const [data, setData] = args.createSignal([]);
const [filteredData, setFilteredData] = args.createSignal([]);
const [loading, setLoading] = args.createSignal(false);
const [searchTerm, setSearchTerm] = args.createSignal("");
const [columnFilters, setColumnFilters] = args.createStore({});
const [sortConfig, setSortConfig] = args.createStore({ column: null, direction: null });
const [selectedRows, setSelectedRows] = args.createSignal(new Set());
const [isModalOpen, setIsModalOpen] = args.createSignal(false);
const [modalMode, setModalMode] = args.createSignal("add"); // "add" or "edit"
const [editingRow, setEditingRow] = args.createSignal(null);
const [formData, setFormData] = args.createStore({});
const [isImportModalOpen, setIsImportModalOpen] = args.createSignal(false);
const [importData, setImportData] = args.createSignal("");
const [columnWidths, setColumnWidths] = args.createStore({});
const [isResizing, setIsResizing] = args.createSignal(false);

// Initialize from query parameters
const initializeFromQueryParams = () => {
  const searchParams = args.searchParams || {};
  if (searchParams.search) {
    setSearchTerm(searchParams.search);
  }
  if (searchParams.filters) {
    try {
      const filters = JSON.parse(searchParams.filters);
      setColumnFilters(filters);
    } catch (e) {
      console.error("Error parsing filters from query:", e);
    }
  }
  if (searchParams.sort) {
    try {
      const sort = JSON.parse(searchParams.sort);
      setSortConfig(sort);
    } catch (e) {
      console.error("Error parsing sort from query:", e);
    }
  }
};

// Update query parameters
const updateQueryParams = () => {
  const params = {};
  // Handle searchTerm
  if (searchTerm()) {
    params.search = searchTerm();
  } else {
    // Clear search param if searchTerm is empty
    params.search = undefined;
  }
  // Handle filters
  const filters = Object.keys(columnFilters).length > 0 ? JSON.stringify(columnFilters) : null;
  if (filters) {
    params.filters = filters;
  } else {
    // Clear filters param if no filters
    params.filters = undefined;
  }
  // Handle sort
  const sort = sortConfig.column ? JSON.stringify(sortConfig) : null;
  if (sort) {
    params.sort = sort;
  } else {
    // Clear sort param if no sort
    params.sort = undefined;
  }
  args.setSearchParams?.(params, { replace: true });
};

// Fetch data from server
const fetchData = async (applyFilters = false) => {
  const dataFn = getDataFunction();
  if (!dataFn) return;

  setLoading(true);
  try {
    const result = await dataFn({
      search: applyFilters ? searchTerm() : undefined,
      filters: applyFilters ? columnFilters : undefined,
      sort: applyFilters ? sortConfig : undefined
    });

    if (result?.data) {
      setData(result.data);
      applyLocalFilters(result.data);
    }
  } catch (error) {
    console.error("Error fetching table data:", error);
    args.showErrorToast?.("Failed to load table data");
  } finally {
    setLoading(false);
  }
};

// Apply local filters (for table header row filters)
const applyLocalFilters = (dataToFilter = null) => {
  const dataSource = dataToFilter || data();
  let filtered = [...dataSource];

  // Apply search term
  if (searchTerm()) {
    const term = searchTerm().toLowerCase();
    const columns = getColumns().filter(col => !shouldHideColumn(col));

    filtered = filtered.filter(row => {
      // Only check values for visible columns, not keys
      for (const col of columns) {
        // Skip special/row number columns
        if (col.key === "__rowNumber" || col.type === "rowNumber") {
          continue;
        }
        const cellValue = getCellValue(row, col);
        if (
          cellValue !== null &&
          cellValue !== undefined &&
          String(cellValue).toLowerCase().includes(term)
        ) {
          return true;
        }
      }
      return false;
    });
  }

  // Apply column filters
  const columns = getColumns();
  filtered = filtered.filter(row => {
    for (const col of columns) {
      const filterValue = columnFilters[col.key];
      if (filterValue !== undefined && filterValue !== null && filterValue !== "") {
        // Skip rowNumber filter - it's calculated, not a property
        if (col.key === "__rowNumber" || col.type === "rowNumber") {
          continue;
        }
        const cellValue = getCellValue(row, col);
        if (col.type === "text") {
          if (!String(cellValue || "").toLowerCase().includes(String(filterValue).toLowerCase())) {
            return false;
          }
        } else if (col.type === "select") {
          if (cellValue !== filterValue) {
            return false;
          }
        } else if (col.type === "checkbox") {
          if (cellValue !== filterValue) {
            return false;
          }
        } else if (col.type === "date" || col.type === "isoDateTime") {
          // Date filtering logic
          const filterDate = new Date(filterValue);
          const cellDate = new Date(cellValue);
          if (isNaN(filterDate.getTime()) || isNaN(cellDate.getTime())) {
            return false;
          }
          // Simple date comparison - can be enhanced
          if (Math.abs(cellDate - filterDate) > 86400000) { // More than 1 day difference
            return false;
          }
        }
      }
    }
    return true;
  });

  // Apply sorting
  if (sortConfig.column) {
    const sortColumn = columns.find(col => col.key === sortConfig.column);
    if (sortColumn) {
      filtered.sort((a, b) => {
        const aVal = getCellValue(a, sortColumn);
        const bVal = getCellValue(b, sortColumn);
        if (aVal === bVal) return 0;
        const comparison = aVal > bVal ? 1 : -1;
        return sortConfig.direction === "asc" ? comparison : -comparison;
      });
    }
  }

  setFilteredData(filtered);
};

const debouncedSetSearchTerm = args.debounce(value => {
  setSearchTerm(value);
  applyLocalFilters();
  updateQueryParams();
}, 500);

// Get cell value from row
const getCellValue = (row, column) => {
  if (column.valueAccessor) {
    return column.valueAccessor(row);
  }
  if (column.key.includes(".")) {
    const keys = column.key.split(".");
    let value = row;
    for (const key of keys) {
      value = value?.[key];
      if (value === undefined) return null;
    }
    return value;
  }
  if (row.P) {
    return row.P[column.key];
  }
  return row[column.key];
};

// Render cell content based on column type
const renderCellContent = (row, column, rowIndex) => {
  const value = getCellValue(row, column);

  if (column.type === "rowNumber") {
    return rowIndex + 1;
  }

  if (column.render) {
    return column.render(value, row, column);
  }

  if (column.type === "checkbox") {
    return value ? "✓" : "";
  }

  if (column.type === "image" || column.type === "imagePreview") {
    const imageUrl = value || column.defaultImage;
    return imageUrl ? { type: "image", url: imageUrl, alt: column.alt || "" } : "";
  }

  if (column.type === "youtubeLink") {
    const videoId = value || column.videoIdAccessor?.(row);
    if (!videoId) return "";
    return { type: "youtubeLink", videoId };
  }

  if (column.type === "downloadLink") {
    const url = value || column.urlAccessor?.(row);
    const icon = column.icon || "carbon:download";
    if (!url) return "";
    return { type: "downloadLink", url, icon };
  }

  if (column.type === "duration") {
    if (!value) return "";
    const seconds = typeof value === "number" ? value : parseInt(value);
    if (isNaN(seconds)) return value;
    const hours = Math.floor(seconds / 3600);
    const minutes = Math.floor((seconds % 3600) / 60);
    const secs = seconds % 60;
    if (hours > 0) {
      return `${hours}:${String(minutes).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
    }
    return `${minutes}:${String(secs).padStart(2, "0")}`;
  }

  if (column.type === "date") {
    if (!value) return "";
    const date = new Date(value);
    if (isNaN(date.getTime())) return value;
    return date.toLocaleDateString();
  }

  if (column.type === "isoDateTime") {
    if (!value) return "";
    const date = new Date(value);
    if (isNaN(date.getTime())) return value;
    return date.toLocaleString();
  }

  if (column.type === "join") {
    if (!value || !Array.isArray(value)) return "";
    const separator = column.separator || ", ";
    const displayKey = column.displayKey || "name";
    return value.map(item => {
      if (typeof item === "string") return item;
      if (item.P) return item.P[displayKey] || item.P.name || "";
      return item[displayKey] || item.name || "";
    }).join(separator);
  }

  if (column.type === "actions") {
    return { type: "actions", row, column };
  }

  // Default: return as string
  return value !== null && value !== undefined ? String(value) : "";
};

// Handle sort
const handleSort = (column) => {
  // Don't allow sorting for rowNumber columns
  if (column.type === "rowNumber" || column.key === "__rowNumber") return;
  if (column.sortable === false) return;

  // If clicking the same column that's already sorted
  if (sortConfig.column === column.key) {
    // If currently ascending, switch to descending
    if (sortConfig.direction === "asc") {
      setSortConfig({ column: column.key, direction: "desc" });
    } 
    // If currently descending, clear the sort
    else if (sortConfig.direction === "desc") {
      setSortConfig({ column: null, direction: null });
    }
  } else {
    // New column, start with ascending
    setSortConfig({ column: column.key, direction: "asc" });
  }
  
  applyLocalFilters();
  updateQueryParams();
};

// Get unique values for a column
const getUniqueColumnValues = (column) => {
  const allData = data();
  const uniqueValues = new Set();
  
  allData.forEach(row => {
    const value = getCellValue(row, column);
    if (value !== null && value !== undefined && value !== "") {
      uniqueValues.add(String(value));
    }
  });
  
  return Array.from(uniqueValues).sort();
};

// Handle column filter change
const handleColumnFilterChange = (columnKey, value) => {
  // Clear filter if value is "All" or empty
  const filterValue = value === "_All_VALUES_" || value === "" || value === null || value === undefined ? undefined : value;
  
  if (filterValue === undefined) {
    // Remove the filter key from columnFilters
    setColumnFilters(columnKey, undefined);
  } else {
    setColumnFilters(columnKey, filterValue );
  }
  
  applyLocalFilters();
  updateQueryParams();
};

// Handle search
const handleSearch = () => {
  fetchData(true);
};

// Handle row selection
const toggleRowSelection = (rowIndex) => {
  const newSelected = new Set(selectedRows());
  if (newSelected.has(rowIndex)) {
    newSelected.delete(rowIndex);
  } else {
    newSelected.add(rowIndex);
  }
  setSelectedRows(newSelected);
};

const selectAllRows = () => {
  const allIndices = new Set(filteredData().map((_, i) => i));
  setSelectedRows(allIndices);
};

const clearSelection = () => {
  setSelectedRows(new Set());
};

// Handle add/edit
const handleAdd = () => {
  setModalMode("add");
  setEditingRow(null);
  setFormData({});
  setIsModalOpen(true);
};

const handleEdit = (row) => {
  setModalMode("edit");
  setEditingRow(row);
  // Initialize form data from row
  const columns = getColumns();
  const initialData = {};
  columns.forEach(col => {
    if (col.editable !== false) {
      initialData[col.key] = getCellValue(row, col);
    }
  });
  setFormData(initialData);
  setIsModalOpen(true);
};

const handleSave = async (formDataToSave) => {
  const formConfig = getFormConfig();
  if (!formConfig?.saveFunction) {
    args.showErrorToast?.("Save function not configured");
    return;
  }

  try {
    setLoading(true);
    const result = await formConfig.saveFunction({
      mode: modalMode(),
      data: formDataToSave,
      originalRow: editingRow()
    });

    if (result?.success) {
      args.showSuccessToast?.(
        modalMode() === "add" ? "Item added successfully" : "Item updated successfully"
      );
      setIsModalOpen(false);
      // Optimistic update
      if (modalMode() === "add") {
        setData([...data(), result.data]);
      } else {
        const updated = data().map(row => 
          row.id === editingRow()?.id ? result.data : row
        );
        setData(updated);
      }
      applyLocalFilters();
    } else {
      const errorMsg = result?.message || result?.error || "Failed to save";
      args.showErrorToast?.(errorMsg);
    }
  } catch (error) {
    console.error("Error saving:", error);
    const errorMsg = error?.message || error?.error || "Failed to save item";
    args.showErrorToast?.(errorMsg);
  } finally {
    setLoading(false);
  }
};

// Handle delete
const handleDelete = async (row) => {
  const formConfig = getFormConfig();
  if (!formConfig?.saveFunction) {
    args.showErrorToast?.("Delete function not configured");
    return;
  }

  // Use rbConfirm if available
  const rbConfirm = args.contextData?.confirmContext?.rbConfirm || args.fns?.rbConfirm;
  if (rbConfirm) {
    const confirmed = await rbConfirm({
      title: "Delete Item",
      message: "Are you sure you want to delete this item? This action cannot be undone.",
      confirmText: "Delete",
      cancelText: "Cancel",
      variant: "danger"
    });
    if (!confirmed) {
      return;
    }
  } else {
    // Fallback to browser confirm
    if (!confirm("Are you sure you want to delete this item?")) {
      return;
    }
  }

  try {
    setLoading(true);
    const result = await formConfig.saveFunction({
      mode: "delete",
      data: {},
      originalRow: row
    });

    if (result?.success) {
      args.showSuccessToast?.("Item deleted successfully");
      // Remove from data
      const updated = data().filter(item => item.id !== row.id);
      setData(updated);
      applyLocalFilters(updated);
    } else {
      const errorMsg = result?.message || result?.error || "Failed to delete";
      args.showErrorToast?.(errorMsg);
    }
  } catch (error) {
    console.error("Error deleting:", error);
    const errorMsg = error?.message || error?.error || "Failed to delete item";
    args.showErrorToast?.(errorMsg);
  } finally {
    setLoading(false);
  }
};

// Handle export (all data)
const handleExport = async (data = null) => {
  const exportFn = getExportFunction();
  if (!exportFn) {
    args.showErrorToast?.("Export function not configured");
    return;
  }

  try {
    setLoading(true);
    const columns = getColumns();
    const sanitizedColumns = JSON.parse(JSON.stringify(columns));
    const result = await exportFn({ data, columns: sanitizedColumns }); // null means export all data
    if (result?.success && result?.data) {
      // Fix line endings: replace '\n' with real newlines for CSV/text exports
      let exportData = result.data;
      if (
        typeof exportData === "string" &&
        (result.contentType === "text/csv" || result.contentType === "text/plain" || !result.contentType)
      ) {
        exportData = exportData.replace(/\\n/g, "\n");
      }
      const blob = new Blob([exportData], { type: result.contentType || "text/csv" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = result.filename || "export.csv";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      args.showSuccessToast?.("Export completed successfully");
    } else {
      args.showErrorToast?.(result?.message || "Failed to export data");
    }
  } catch (error) {
    console.error("Error exporting:", error);
    args.showErrorToast?.("Failed to export data");
  } finally {
    setLoading(false);
  }
};


// Handle settings open
const handleOpenSettings = async () => {
  await loadSettings();
  setIsSettingsModalOpen(true);
};

// Handle settings save
const handleSaveSettings = async (configText) => {
  const saveFn = getSaveSettingsFunction();
  if (!saveFn) {
    args.showErrorToast?.("Save settings function not configured");
    return;
  }

  try {
    setLoading(true);
    // Save the raw function body text, not the evaluated config
    const result = await saveFn(configText);
    if (result?.success) {
      args.showSuccessToast?.(result.message || "Settings saved successfully");
      setIsSettingsModalOpen(false);
      setSettings(configText); // Store the raw text
      setEvaluatedConfig(null); // Clear evaluation cache
      setMemoizedConfig(null); // Clear memoized cache
      // Reload data to apply new settings
      await fetchData(false);
    } else {
      args.showErrorToast?.(result?.message || "Failed to save settings");
    }
  } catch (error) {
    console.error("Error saving settings:", error);
    args.showErrorToast?.("Failed to save settings");
  } finally {
    setLoading(false);
  }
};


// Handle import
const handleImport = async () => {
  const importFn = getImportFunction();
  if (!importFn) {
    args.showErrorToast?.("Import function not configured");
    return;
  }

  const dataToImport = importData().trim();
  if (!dataToImport) {
    args.showErrorToast?.("Please provide data to import");
    return;
  }

  try {
    setLoading(true);
    const result = await importFn({ data: dataToImport });
    if (result?.success) {
      args.showSuccessToast?.(result.message || "Import completed successfully");
      setIsImportModalOpen(false);
      setImportData("");
      // Refresh data
      await fetchData(false);
    } else {
      args.showErrorToast?.(result?.message || result?.error || "Failed to import data");
    }
  } catch (error) {
    console.error("Error importing:", error);
    args.showErrorToast?.(error?.message || "Failed to import data");
  } finally {
    setLoading(false);
  }
};

// Check if column should be hidden
const shouldHideColumn = (column) => {
  const hideColumns = getHideColumns();
  if (typeof hideColumns === "function") {
    return hideColumns(column);
  }
  return hideColumns.includes(column.key);
};

// Get column width (from state or config)
const getColumnWidth = (columnKey) => {
  const storedWidth = columnWidths[columnKey];
  if (storedWidth) {
    return storedWidth;
  }
  const columns = getColumns();
  const column = columns.find(col => col.key === columnKey);
  return column?.width || "100px";
};

// Get grid template columns
const getGridTemplateColumns = () => {
  const columns = getColumns();
  const showRowNumber = getShowRowNumber();
  const showSelection = getShowSelection();
  const showActions = getShowActions();
  let template = "";

  // Add selection column if enabled
  if (showSelection) {
    template += `${getColumnWidth("__selection") || "50px"} `;
  }

  // Add actions column if enabled and form config exists
  if (showActions && getFormConfig()) {
    template += `${getColumnWidth("__actions") || "120px"} `;
  }

  if (showRowNumber) {
    template += `${getColumnWidth("__rowNumber") || "50px"} `;
  }

  columns.forEach(col => {
    if (!shouldHideColumn(col)) {
      template += `${getColumnWidth(col.key)} `;
    }
  });

  return template.trim();
};

// Create resize handler for a column
const createResizeHandler = (columnKey) => {
  return (e) => {
    e.preventDefault();
    e.stopPropagation();

    // Get current width
    const currentWidth = getColumnWidth(columnKey);
    let startWidth = 50;
    if (currentWidth && currentWidth !== "1fr") {
      const match = currentWidth.match(/(\d+)px/);
      if (match) {
        startWidth = parseInt(match[1]);
      }
    }

    const startX = e.clientX || e.touches?.[0]?.clientX || 0;

    const handleMouseMove = (moveEvent) => {
      const clientX = moveEvent.clientX || moveEvent.touches?.[0]?.clientX || startX;
      const deltaX = clientX - startX;
      const newWidth = Math.max(50, startWidth + deltaX); // Minimum 50px
      setColumnWidths({ ...columnWidths, [columnKey]: `${newWidth}px` });
    };

    const handleMouseUp = () => {
      document.removeEventListener('mousemove', handleMouseMove);
      document.removeEventListener('mouseup', handleMouseUp);
      document.removeEventListener('touchmove', handleMouseMove);
      document.removeEventListener('touchend', handleMouseUp);
      setIsResizing(false);
    };

    setIsResizing(true);
    document.addEventListener('mousemove', handleMouseMove);
    document.addEventListener('mouseup', handleMouseUp);
    document.addEventListener('touchmove', handleMouseMove);
    document.addEventListener('touchend', handleMouseUp);
  };
};

return {
  getColumns,
  getRowHeight,
  getTitle,
  getSearchPlaceholder,
  getAdditionalFilters,
  getCustomActions,
  getBatchActions,
  getShowRowNumber,
  getHideColumns,
  getFormConfig,
  getShowAddButton,
  getShowEditButton,
  getImportFunction,
