      id: "48"
      L: Attr
      P: {
        slotName: cell
        displayOrder: 1
        componentName: Html
        props:
          '''
const column = args.contextData.column;
const virtualItem = args.contextData.virtualItem;
if (!virtualItem) return {};
const rowIndex = virtualItem.index;
const rowData = args.fns.filteredData()[virtualItem.index];
const cellContent = args.fns.renderCellContent(rowData, column, rowIndex);

// Handle different content types
if (typeof cellContent === "object" && cellContent !== null) {
  if (cellContent.type === "image") {
    return {
      as: "img",
      src: cellContent.url,
      alt: cellContent.alt,
      style: "max-width: 100px; max-height: 50px; object-fit: cover; border-radius: 4px;"
    };
  }
  if (cellContent.type === "youtubeLink") {
    return {
      as: "a",
      href: `https://www.youtube.com/watch?v=${cellContent.videoId}`,
      target: "_blank",
      rel: "noopener noreferrer",
      text: "Watch",
      style: "color: " + args.theme.var.color.primary + "; text-decoration: none;"
    };
  }
  if (cellContent.type === "downloadLink") {
    return {
      as: "a",
      href: cellContent.url,
      download: true,
      style: "color: " + args.theme.var.color.primary + "; text-decoration: none; display: flex; align-items: center; gap: 4px;"
    };
  }
  if (cellContent.type === "actions") {
    const showEditButton = args.fns.getShowEditButton();
    const formConfig = args.fns.getFormConfig();
    const row = cellContent.row;

    return {
      as: "div",
      style: "display: flex; gap: 8px; align-items: center;"
    };
  }
}

// Add edit button if actions column and edit is enabled
if (column.type === "actions" && args.fns.getShowEditButton() && args.fns.getFormConfig()) {
  return {
    as: "div",
    style: "display: flex; gap: 8px; align-items: center;"
  };
}

// Default text rendering
return {
  as: "div",
  text: typeof cellContent === "string" || typeof cellContent === "number" ? String(cellContent) : ""
};
'''
      }
    }
