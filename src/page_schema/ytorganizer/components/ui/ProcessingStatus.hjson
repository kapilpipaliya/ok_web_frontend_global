{
  vertexes: [
    {
      id: "yto_processing_status_component",
      L: "Component",
      P: {
        key: "ProcessingStatus"
      }
    },
    {
      id: "variant_status",
      L: "ComponentVariant",
      P: {
        key: "queueStatus",
        type: "string",
        defValue: "queued",
        description: "Processing queueStatus: queued, processing, pending_quota, paused, completed, completed_with_errors, failed"
      }
    },
    {
      id: "variant_status_queued",
      L: "ComponentVariantOption",
      P: {
        key: "queued",
        value: "queued",
        description: "Item is queued for processing"
      }
    },
    {
      id: "variant_status_processing",
      L: "ComponentVariantOption",
      P: {
        key: "processing",
        value: "processing",
        description: "Item is currently being processed"
      }
    },
    {
      id: "variant_status_pending_quota",
      L: "ComponentVariantOption",
      P: {
        key: "pending_quota",
        value: "pending_quota",
        description: "Waiting for quota reset"
      }
    },
    {
      id: "variant_status_paused",
      L: "ComponentVariantOption",
      P: {
        key: "paused",
        value: "paused",
        description: "Paused by user"
      }
    },
    {
      id: "variant_status_completed",
      L: "ComponentVariantOption",
      P: {
        key: "completed",
        value: "completed",
        description: "Processing completed successfully"
      }
    },
    {
      id: "variant_status_completed_with_errors",
      L: "ComponentVariantOption",
      P: {
        key: "completed_with_errors",
        value: "completed_with_errors",
        description: "Completed with some errors"
      }
    },
    {
      id: "variant_status_failed",
      L: "ComponentVariantOption",
      P: {
        key: "failed",
        value: "failed",
        description: "Processing failed with error"
      }
    },
    {
      id: "variant_progress",
      L: "ComponentVariant",
      P: {
        key: "progress",
        type: "number",
        defValue: 0,
        description: "Progress percentage (0-100)"
      }
    },
    {
      id: "variant_type",
      L: "ComponentVariant",
      P: {
        key: "type",
        type: "string",
        defValue: "channel",
        description: "Type of item: channel or playlist"
      }
    },
    {
      id: "variant_type_channel",
      L: "ComponentVariantOption",
      P: {
        key: "channel",
        value: "channel",
        description: "Channel processing"
      }
    },
    {
      id: "variant_type_playlist",
      L: "ComponentVariantOption",
      P: {
        key: "playlist",
        value: "playlist",
        description: "Playlist processing"
      }
    },
    {
      id: "variant_details",
      L: "ComponentVariant",
      P: {
        key: "details",
        type: "string",
        defValue: "",
        description: "Additional processing details"
      }
    },
    {
      id: "variant_error",
      L: "ComponentVariant",
      P: {
        key: "error",
        type: "string",
        defValue: "",
        description: "Error message for failed queueStatus"
      }
    },
    {
      id: "root_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const queueStatus = args.contextData.props?.queueStatus;

// Hide component if no queueStatus provided
if (!queueStatus) {
  return { hide: true };
}

// Hide if queueStatus is "completed" (only show non-completed statuses)
if (queueStatus === "completed") {
  return { hide: true };
}

return {
  as: "div"
};
''',
        css: '''
const queueStatus = args.contextData.props?.queueStatus;
const statusInfo = args.fns.getStatusInfo?.(queueStatus);

// Map color names to theme colors
const colorMap = {
  blue: args.theme.var.color.info,
  yellow: args.theme.var.color.warning,
  orange: args.theme.var.color.warning,
  gray: args.theme.var.color.muted,
  green: args.theme.var.color.success,
  red: args.theme.var.color.error
};

const borderColor = statusInfo?.color ? colorMap[statusInfo.color] : args.theme.var.color.info;

return `._id {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  background: ${args.theme.var.color.background_light_100};
  border-left: 3px solid ${borderColor};
  border-radius: 0.5rem;
  margin-top: 0.5rem;
  margin-bottom: 0.5rem;
}`;
'''
      }
    },
    {
      id: "icon_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const queueStatus = args.contextData.props?.queueStatus || 'queued';

// Get queueStatus info from constants
const statusInfo = args.fns.getStatusInfo?.(queueStatus);

// Map color names to theme colors
const colorMap = {
  blue: args.theme.var.color.info,
  yellow: args.theme.var.color.warning,
  orange: args.theme.var.color.warning,
  gray: args.theme.var.color.muted,
  green: args.theme.var.color.success,
  red: args.theme.var.color.error
};

// Use icon and color from queueStatus info, fallback to defaults
const icon = statusInfo?.icon || 'carbon:help';
const color = statusInfo?.color ? colorMap[statusInfo.color] : args.theme.var.color.muted;

return {
  as: "icon",
  icon,
  width: 20,
  height: 20,
  style: { color }
};
'''
      }
    },
    {
      id: "content_container",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  flex: 1;
  min-width: 0;
}`;
'''
      }
    },
    {
      id: "status_text",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
// Safely extract all props with defaults
const queueStatus = args.contextData.props?.queueStatus || 'queued';
const type = args.contextData.props?.type || 'channel';
const progress = Math.max(0, Math.min(100, args.contextData.props?.progress || 0));
const details = args.contextData.props?.details || '';

// Get queueStatus info from constants
const statusInfo = args.fns.getStatusInfo?.(queueStatus);

// Build queueStatus text based on queueStatus info
let statusText = '';

if (statusInfo) {
  // Use message from queueStatus constants
  statusText = statusInfo.message;

  // Add progress percentage for processing queueStatus
  if (queueStatus === 'processing' && progress > 0) {
    statusText = `${statusInfo.label} ${type}... ${progress}%`;
  }

  // Add details if available
  if (details) {
    statusText += ` (${details})`;
  }
} else {
  // Fallback for unknown queueStatus
  statusText = `Status: ${queueStatus}`;
}

return {
  as: "div",
  text: statusText
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  font-weight: 500;
  color: ${args.theme.var.color.text};
  margin-bottom: 0.25rem;
}`;
'''
      }
    },
    {
      id: "progress_bar_container",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const queueStatus = args.contextData.props?.queueStatus || 'queued';

// Only show progress bar for queued and processing statuses
const showProgressBar = queueStatus === 'queued' || queueStatus === 'processing';

return {
  as: "div",
  hide: !showProgressBar
};
''',
        css: '''
return `._id {
  width: 100%;
  height: 6px;
  background: ${args.theme.var.color.background_light_300};
  border-radius: 3px;
  overflow: hidden;
}`;
'''
      }
    },
    {
      id: "progress_bar_fill",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
// Clamp progress between 0 and 100
const rawProgress = args.contextData.props?.progress;
const progress = Math.min(Math.max(rawProgress || 0, 0), 100);

return {
  as: "div",
  style: {
    width: `${progress}%`
  }
};
''',
        css: '''
return `._id {
  height: 100%;
  background: ${args.theme.var.color.primary};
  border-radius: 3px;
  transition: width 0.3s ease;
}`;
'''
      }
    },
    {
      id: "error_text",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const queueStatus = args.contextData.props?.queueStatus || '';
const error = args.contextData.props?.error || '';

// Only show error for failed or completed_with_errors queueStatus
if ((queueStatus !== 'failed' && queueStatus !== 'completed_with_errors') || !error) {
  return { hide: true };
}

return {
  as: "div",
  text: error
};
''',
        css: '''
return `._id {
  font-size: 0.8rem;
  color: ${args.theme.var.color.error};
  line-height: 1.4;
  margin-top: 0.375rem;
  font-style: italic;
  word-wrap: break-word;
  overflow-wrap: break-word;
}`;
'''
      }
    }
  ],
  edges: [
    { id: "e1", T: "ComponentVariant", S: "yto_processing_status_component", E: "variant_status" },
    { id: "e2", T: "ComponentVariantOption", S: "variant_status", E: "variant_status_queued" },
    { id: "e3", T: "ComponentVariantOption", S: "variant_status", E: "variant_status_processing" },
    { id: "e3a", T: "ComponentVariantOption", S: "variant_status", E: "variant_status_pending_quota" },
    { id: "e3b", T: "ComponentVariantOption", S: "variant_status", E: "variant_status_paused" },
    { id: "e4", T: "ComponentVariantOption", S: "variant_status", E: "variant_status_completed" },
    { id: "e4a", T: "ComponentVariantOption", S: "variant_status", E: "variant_status_completed_with_errors" },
    { id: "e5", T: "ComponentVariantOption", S: "variant_status", E: "variant_status_failed" },
    { id: "e6", T: "ComponentVariant", S: "yto_processing_status_component", E: "variant_progress" },
    { id: "e7", T: "ComponentVariant", S: "yto_processing_status_component", E: "variant_type" },
    { id: "e8", T: "ComponentVariantOption", S: "variant_type", E: "variant_type_channel" },
    { id: "e9", T: "ComponentVariantOption", S: "variant_type", E: "variant_type_playlist" },
    { id: "e10", T: "ComponentVariant", S: "yto_processing_status_component", E: "variant_details" },
    { id: "e10a", T: "ComponentVariant", S: "yto_processing_status_component", E: "variant_error" },
    { id: "e11", T: "Attr", S: "yto_processing_status_component", E: "root_container" },
    { id: "e12", T: "Attr", S: "root_container", E: "icon_container" },
    { id: "e13", T: "Attr", S: "root_container", E: "content_container" },
    { id: "e14", T: "Attr", S: "content_container", E: "status_text" },
    { id: "e15", T: "Attr", S: "content_container", E: "progress_bar_container" },
    { id: "e16", T: "Attr", S: "progress_bar_container", E: "progress_bar_fill" },
    { id: "e17", T: "Attr", S: "content_container", E: "error_text" }
  ]
}
