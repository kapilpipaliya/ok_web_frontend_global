{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: FloatingMenu
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''
return `._id {
  position: relative;
  display: inline-block;
}`;
'''
        displayOrder: 1
        fns:
          '''
// Menu state management
const [isMenuOpen, setIsMenuOpen] = args.createSignal(false);
const [triggerRef, setTriggerRef] = args.createSignal(null);
const [menuRef, setMenuRef] = args.createSignal(null);
let cleanup = null;

// Setup floating UI positioning with auto-update
const setupFloatingUI = async () => {
  const trigger = triggerRef();
  const menu = menuRef();
  if (!trigger || !menu) return;

  const placement = args.contextData.props?.placement || "bottom-end";

  try {
    const { computePosition, flip, shift, offset, autoUpdate } = args.floatingUI;

    // Function to update position
    const updatePosition = async () => {
      const { x, y } = await computePosition(trigger, menu, {
        placement: placement,
        strategy: 'fixed',
        middleware: [
          offset(4),
          flip(),
          shift({ padding: 8 })
        ]
      });

      Object.assign(menu.style, {
        left: `${x}px`,
        top: `${y}px`,
      });
    };

    // Initial positioning
    await updatePosition();

    // Setup auto-update to handle scroll, resize, and other changes
    cleanup = autoUpdate(trigger, menu, updatePosition, {
      // Options to ensure scroll is tracked
      ancestorScroll: true,
      ancestorResize: true,
      elementResize: true,
      layoutShift: true,
      animationFrame: false
    });
  } catch (e) {
    console.error('Error setting up floating UI:', e);
  }
};

// Toggle menu
const toggleMenu = (e) => {
  e?.preventDefault();
  e?.stopPropagation();
  const newState = !isMenuOpen();
  setIsMenuOpen(newState);
  if (newState) {
    requestAnimationFrame(() => setupFloatingUI());
  } else if (cleanup) {
    cleanup();
    cleanup = null;
  }
};

// Close menu
const closeMenu = () => {
  setIsMenuOpen(false);
  if (cleanup) {
    cleanup();
    cleanup = null;
  }
};

// Handle clicks outside
const handleDocumentClick = (e) => {
  const trigger = triggerRef();
  const menu = menuRef();
  if (!trigger || !menu) return;

  if (!trigger.contains(e.target) && !menu.contains(e.target)) {
    closeMenu();
  }
};

// Setup and cleanup event listeners
const onMount = () => {
  document.addEventListener('click', handleDocumentClick);
  return () => {
    document.removeEventListener('click', handleDocumentClick);
    if (cleanup) {
      cleanup();
    }
  };
};

return {
  isMenuOpen,
  setIsMenuOpen,
  triggerRef,
  setTriggerRef,
  menuRef,
  setMenuRef,
  toggleMenu,
  closeMenu,
  setupFloatingUI,
  onMount
};
'''
        componentName: Html
        props:
          '''
return {
  as: "div",
  onMount: args.fns.onMount
};
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''
return `._id {
  background: none;
  border: none;
  color: ${args.theme.var.color.muted};
  cursor: pointer;
  padding: ${args.theme.var.spacing.xs};
  border-radius: ${args.theme.var.borderRadius.sm};
  transition: all ${args.theme.var.animation.fast} ease;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
}

._id:hover {
  background: ${args.theme.var.color.background_light_200};
  color: ${args.theme.var.color.text};
}

._id:focus {
  outline: 2px solid ${args.theme.var.color.primary};
  outline-offset: 2px;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const triggerIcon = args.contextData.props?.triggerIcon || "carbon:overflow-menu-vertical";

return {
  as: "button",
  "aria-label": "Open menu",
  "aria-expanded": args.fns.isMenuOpen?.() || false,
  onClick: args.fns.toggleMenu,
  ref: args.fns.setTriggerRef
};
'''
      }
    }
    {
