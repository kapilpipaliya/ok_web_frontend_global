      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
const icon = args.contextData.props?.icon;
const size = args.contextData.props?.size || "md";

const sizeStyles = {
  sm: 16,
  md: 20,
  lg: 24
};

const iconSize = sizeStyles[size] || sizeStyles.md;

return {
  as: "icon",
  icon: icon,
  width: iconSize,
  height: iconSize,
  hide: !icon
};
'''
      }
    }
