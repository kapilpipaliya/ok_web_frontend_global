{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: IconButton
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''
const variant = args.contextData.props?.variant || "ghost";
const size = args.contextData.props?.size || "md";
const disabled = args.contextData.props?.disabled || false;

// Size styles
const sizeStyles = {
  sm: {
    padding: args.theme.var.spacing.xs,
    iconSize: 16
  },
  md: {
    padding: args.theme.var.spacing.sm,
    iconSize: 20
  },
  lg: {
    padding: args.theme.var.spacing.md,
    iconSize: 24
  }
};

const sizeConfig = sizeStyles[size] || sizeStyles.md;

// Variant styles
let variantStyles = '';
if (variant === 'ghost') {
  variantStyles = `
    background: transparent;
    color: ${args.theme.var.color.muted};

    &:not(:disabled):hover {
      background: ${args.theme.var.color.background_light_200};
      color: ${args.theme.var.color.text};
    }
  `;
} else if (variant === 'danger') {
  variantStyles = `
    background: transparent;
    color: ${args.theme.var.color.error};

    &:not(:disabled):hover {
      background: ${args.theme.var.color.error_light_100};
      color: ${args.theme.var.color.error};
    }
  `;
} else if (variant === 'primary') {
  variantStyles = `
    background: ${args.theme.var.color.primary};
    color: ${args.theme.var.color.primary_text};

    &:not(:disabled):hover {
      background: ${args.theme.var.color.primary_dark_200};
    }
  `;
}

return `._id {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: ${sizeConfig.padding};
  border: none;
  border-radius: ${args.theme.var.borderRadius.sm};
  cursor: pointer;
  transition: all ${args.theme.var.animation.fast} ease;
  ${variantStyles}

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  &:not(:disabled):active {
    transform: scale(0.95);
  }

  &:focus {
    outline: 2px solid ${args.theme.var.color.primary};
    outline-offset: 2px;
  }
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const icon = args.contextData.props?.icon;
const onClick = args.contextData.props?.onClick || (() => {});
const disabled = args.contextData.props?.disabled || false;
const size = args.contextData.props?.size || "md";
const ariaLabel = args.contextData.props?.ariaLabel || args.contextData.props?.title || "";
const title = args.contextData.props?.title || "";

const sizeStyles = {
  sm: 16,
  md: 20,
  lg: 24
};

const iconSize = sizeStyles[size] || sizeStyles.md;

return {
  as: "button",
  "aria-label": ariaLabel,
  title: title,
  disabled: disabled,
  onClick: onClick
};
'''
      }
    }
    {
      id: "3"
