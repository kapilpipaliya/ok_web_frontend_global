{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''
// Get props from context
const getItem = () => args.contextData.props?.item;
const getExpandedKeys = () => args.contextData.props?.expandedKeys || [];
const getSelectedItem = () => args.contextData.props?.selectedItem;
const getOnToggleExpand = () => args.contextData.props?.onToggleExpand;
const getOnItemSelect = () => args.contextData.props?.onItemSelect;
const getFetchChildren = () => args.contextData.props?.fetchChildren;
const getParentVertexLabel = () => args.contextData.props?.parentVertexLabel;
const getToParentEdgeType = () => args.contextData.props?.toParentEdgeType;

// State
const [children, setChildren] = args.createSignal([]);
const [loading, setLoading] = args.createSignal(false);
const [hasCheckedChildren, setHasCheckedChildren] = args.createSignal(false);

// Check if item is expanded - make it reactive by accessing the signal
const isExpanded = () => {
  const item = getItem();
  if (!item) return false;
  // Access expandedKeys as a signal to make it reactive
  const expandedKeys = getExpandedKeys();
  return Array.isArray(expandedKeys) && expandedKeys.includes(item.id);
};

// Check if item is selected
const isSelected = () => {
  const item = getItem();
  const selectedItem = getSelectedItem();
  if (!item || !selectedItem) return false;
  return item.id === selectedItem.id;
};

// Fetch children on mount if expanded
const fetchChildrenIfNeeded = async () => {
  const item = getItem();
  if (!item) return;

  const expanded = isExpanded();
  if (expanded && children().length === 0 && !hasCheckedChildren()) {
    setLoading(true);
    try {
      const fetchedChildren = await getFetchChildren()(item.id);
      setChildren(fetchedChildren || []);
      setHasCheckedChildren(true);
    } catch (error) {
      console.error("Error fetching children:", error);
      setHasCheckedChildren(true);
    } finally {
      setLoading(false);
    }
  }
};

// Handle expand toggle
const handleToggleExpand = async () => {
  const item = getItem();
  if (!item) return;

  const onToggleExpand = getOnToggleExpand();
  if (onToggleExpand) {
    const wasExpanded = isExpanded();
    await onToggleExpand(item.id);
    // Fetch children if expanding and we don't have them yet
    if (!wasExpanded && (children().length === 0 || !hasCheckedChildren())) {
      await fetchChildrenIfNeeded();
    }
  }
};

// Handle item click
const handleItemClick = () => {
  const item = getItem();
  const onItemSelect = getOnItemSelect();
  if (item && onItemSelect) {
    onItemSelect(item);
  }
};

// Get item display name
const getItemName = () => {
  const item = getItem();
  if (!item) return "";
  return item.P?.key || item.P?.name || item.P?.title || "No name";
};

// Get item icon
const getItemIcon = () => {
  const item = getItem();
  if (!item) return "ph:circle";
  return item.P?.icon || "ph:circle";
};

// Check if item has children
// Show expand button if:
// 1. We have children loaded, OR
// 2. We haven't checked yet (allows expand button on initial load)
const hasChildren = () => {
  const childrenList = children();
  // If we have children loaded, return true
  if (childrenList.length > 0) {
    return true;
  }
  // If we haven't checked yet, assume it might have children (show expand button)
  // After checking, if no children, this will return false
  if (!hasCheckedChildren()) {
    return true;
  }
  // We've checked and found no children
  return false;
};

// Modal state
const [isAddModalOpen, setIsAddModalOpen] = args.createSignal(false);
const [isEditModalOpen, setIsEditModalOpen] = args.createSignal(false);

// Get formConfig from props
const getFormConfig = () => args.contextData.props?.formConfig;

// Handle opening add modal
const handleOpenAddModal = (e) => {
  e.stopPropagation();
  setIsAddModalOpen(true);
};

// Handle closing add modal
const handleCloseAddModal = () => {
  setIsAddModalOpen(false);
};

// Handle opening edit modal
const handleOpenEditModal = (e) => {
  e.stopPropagation();
  setIsEditModalOpen(true);
};

// Handle closing edit modal
const handleCloseEditModal = () => {
  setIsEditModalOpen(false);
};

// Handle save callback - refresh children after adding
const handleAddChildSave = async (newVertex) => {
  const item = getItem();
  if (!item) return;

  // Clear cache for parent to force refresh
  const fetchChildrenFn = getFetchChildren();
  if (fetchChildrenFn) {
    // Refresh children - force refresh to get latest data
    // Note: fetchChildren function signature: (parentId, forceRefresh = false)
    const refreshedChildren = await fetchChildrenFn(item.id, true);
    setChildren(refreshedChildren || []);
    setHasCheckedChildren(true);
    // Expand parent if not already expanded
    const onToggleExpand = getOnToggleExpand();
    if (onToggleExpand) {
      const expanded = getExpandedKeys();
      if (!expanded.includes(item.id)) {
        await onToggleExpand(item.id);
      }
    }
  }

  handleCloseAddModal();
};

// Handle save callback - refresh after editing
const handleEditSave = async (updatedVertex) => {
  const item = getItem();
  if (!item) return;

  handleCloseEditModal();

  // Refresh the entire tree by clearing cache and re-fetching
  // This ensures the updated item data is reflected
  // The parent Sidebar component will handle the refresh
};

return {
  getItem,
  getExpandedKeys,
  getSelectedItem,
  getOnToggleExpand,
  getOnItemSelect,
  getFetchChildren,
  isExpanded,
  isSelected,
  children,
  setChildren,
  loading,
  setLoading,
  hasCheckedChildren,
  setHasCheckedChildren,
  fetchChildrenIfNeeded,
  handleToggleExpand,
  handleItemClick,
  getItemName,
  getItemIcon,
  hasChildren,
  isAddModalOpen,
  setIsAddModalOpen,
  handleOpenAddModal,
  handleCloseAddModal,
  handleAddChildSave,
  isEditModalOpen,
  setIsEditModalOpen,
  handleOpenEditModal,
  handleCloseEditModal,
  handleEditSave,
  getFormConfig
};
'''
        key: SidebarTreeItem
        props: ""
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
