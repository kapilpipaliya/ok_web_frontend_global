        props:
          '''
const item = args.fns.getItem();
const formConfig = args.fns.getFormConfig();
const parentVertexLabel = args.contextData.props?.parentVertexLabel;
const toParentEdgeType = args.contextData.props?.toParentEdgeType;
const rootKeys = args.contextData.props?.rootKeys || {};

return {
  isOpen: args.fns.isAddModalOpen(),
  formConfig: formConfig,
  parentId: item?.id,
  parentVertexLabel: parentVertexLabel,
  toParentEdgeType: toParentEdgeType,
  rootKeys: rootKeys,
  onSave: args.fns.handleAddChildSave,
  onClose: args.fns.handleCloseAddModal
};
'''
