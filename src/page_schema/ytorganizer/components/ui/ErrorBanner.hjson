{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        key: ErrorBanner
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''
return `._id {
  background: ${args.theme.var.color.error_light_100};
  border: 1px solid ${args.theme.var.color.error};
  border-radius: ${args.theme.var.borderRadius.md};
  padding: 1rem;
  margin: 0 0 1rem 0;
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
}

@media (max-width: 768px) {
  ._id {
    padding: 0.75rem;
    gap: 0.5rem;
  }
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const error = args.contextData.props?.error;

return {
  as: "div",
  hide: !error
};
'''
      }
    }
    {
      id: "3"
      L: Attr
      P: {
        css:
          '''
return `._id {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  min-width: 0;
}

._id icon {
  flex-shrink: 0;
  color: ${args.theme.var.color.error};
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "div"
};
'''
      }
    }
    {
      id: "4"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Html
        props:
          '''
return {
  as: "icon",
  icon: "carbon:error",
  width: 20,
  height: 20
};
'''
      }
    }
    {
      id: "5"
      L: Attr
      P: {
        css:
          '''
return `._id {
  color: ${args.theme.var.color.error_text};
  font-size: ${args.theme.var.fontSize.md};
  margin: 0;
  flex: 1;
  word-break: break-word;
}

@media (max-width: 768px) {
  ._id {
    font-size: ${args.theme.var.fontSize.sm};
  }
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''
const error = args.contextData.props?.error || "";

return {
  as: "p",
  text: error
};
'''
      }
    }
    {
      id: "6"
      L: Attr
      P: {
        css:
          '''
return `._id {
  flex-shrink: 0;
  padding: 0.25rem;
  cursor: pointer;
  color: ${args.theme.var.color.text};
  opacity: 0.7;
  transition: opacity ${args.theme.var.animation.fast} ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

._id:hover {
  opacity: 1;
}

._id icon {
  display: block;
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''
const onClose = args.contextData.props?.onClose;

return {
  as: "button",
  onClick: onClose,
  type: "button"
};
'''
      }
