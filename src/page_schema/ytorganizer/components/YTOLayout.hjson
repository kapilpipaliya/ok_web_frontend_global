const item = args.contextData.navItem;
const isActive = item.pathCheck ? item.pathCheck(args.location.pathname) : false;
const isButton = item.isButton;
const isDanger = item.isDanger;
const openInNewTab = item.openInNewTab;

return {
  as: isButton ? "button" : "a",
  href: !isButton ? item.href : undefined,
  target: openInNewTab ? "_blank" : undefined,
  rel: openInNewTab ? "noopener noreferrer" : undefined,
  "aria-label": item.label,
  title: item.title,
  onClick: (e) => {
    if (openInNewTab) {
      // Let the browser handle the new tab opening
      return;
    }
    e.preventDefault();
    args.fns.navigateTo?.(item.href);
  }
};
''',
        css: '''
const item = args.contextData.navItem;
