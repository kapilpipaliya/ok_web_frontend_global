  color: ${isDanger ? args.theme.var.color.error : (isActive ? args.theme.var.color.primary : args.theme.var.color.text)};
  text-decoration: none;
  font-weight: ${isActive ? '600' : '500'};
  transition: all ${args.theme.var.animation.fast} ease;
  ${isButton ? `
    border: none;
    font-size: inherit;
    font-family: inherit;
    cursor: pointer;
    width: 100%;
    text-align: left;
  ` : ''}

  &:hover {
    background: ${isDanger ? args.theme.var.color.error_light_100 : args.theme.var.color.background_light_200};
    color: ${isDanger ? args.theme.var.color.error_light_100_text : args.theme.var.color.primary};
  }
  
  ${isButton ? `
    &:active {
      transform: scale(0.98);
    }
  ` : ''}
}`;
'''
