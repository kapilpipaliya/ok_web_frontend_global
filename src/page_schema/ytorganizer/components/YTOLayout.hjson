      }
    },
    {
      id: "quota_warning_banner",
      L: "Attr",
      P: {
        displayOrder: 0.6,
        componentName: "Html",
        props: '''
const isApproaching = args.fns.isApproachingQuotaLimit?.();
const isAtLimit = args.fns.isAtQuotaLimit?.();
const showBanner = isApproaching || isAtLimit;

return {
  as: "div",
  hide: !showBanner
};
''',
        css: '''
const isAtLimit = args.fns.isAtQuotaLimit?.();

return `._id {
  background: ${isAtLimit ? args.theme.var.color.error : args.theme.var.color.warning};
  color: ${isAtLimit ? args.theme.var.color.error_text : args.theme.var.color.warning_text};
  padding: ${args.theme.var.spacing.md} ${args.theme.var.spacing.lg};
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: ${args.theme.var.spacing.md};
  border-bottom: 1px solid ${isAtLimit ? args.theme.var.color.error_dark_100 : args.theme.var.color.warning_dark_100};
  flex-wrap: wrap;

  @media (max-width: 768px) {
    flex-direction: column;
    align-items: flex-start;
  }
}`;
'''
      }
    },
    {
      id: "quota_warning_content",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: ${args.theme.var.spacing.md};
  flex: 1;
}`;
'''
      }
    },
    {
      id: "quota_warning_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const isAtLimit = args.fns.isAtQuotaLimit?.();

return {
  as: "icon",
  icon: isAtLimit ? "carbon:warning-filled" : "carbon:warning-alt",
  width: 24,
  height: 24
};
''',
        css: '''
return `._id {
  flex-shrink: 0;
}`;
'''
      }
    },
    {
      id: "quota_warning_text_container",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: ${args.theme.var.spacing.xs};
}`;
'''
      }
    },
    {
      id: "quota_warning_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const isAtLimit = args.fns.isAtQuotaLimit?.();
const percentage = args.fns.getQuotaUsagePercentage?.();

return {
  as: "strong",
  text: isAtLimit
    ? `YouTube API Quota Limit Reached (${percentage}%)`
    : `YouTube API Quota Warning (${percentage}%)`
};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.md};
  font-weight: 600;
  display: block;
}`;
'''
      }
    },
    {
      id: "quota_warning_message",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const isAtLimit = args.fns.isAtQuotaLimit?.();
const resetTime = args.fns.getQuotaResetTime?.();
const usage = args.fns.quotaUsage?.();
const usedQuota = usage?.totalUnitsUsed || 0;
const dailyLimit = usage?.dailyLimit || 10000;
const selectedOwnership = args.fns.selectedOwnership?.();
const ownershipName = selectedOwnership?.P?.customName || selectedOwnership?.P?.channelName || "Current account";

return {
  as: "span",
  text: isAtLimit
    ? `You've reached 95% of your daily YouTube API quota for ${ownershipName} (${usedQuota.toLocaleString()}/${dailyLimit.toLocaleString()} units). Adding channels and playlists is temporarily disabled. Resets in ${resetTime}.`
    : `You've used ${usedQuota.toLocaleString()}/${dailyLimit.toLocaleString()} units of your daily YouTube API quota for ${ownershipName}. Resets in ${resetTime}.`
};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.sm};
  opacity: 0.95;
  line-height: 1.5;
}`;
'''
      }
    },
    {
      id: "quota_warning_dismiss",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        fns: '''
const [isDismissed, setIsDismissed] = args.createSignal(false);

return {
  isDismissed,
  dismissBanner: () => setIsDismissed(true)
};
''',
        props: '''
const isDismissed = args.fns.isDismissed?.();

return {
  as: "button",
  text: "Dismiss",
  onClick: args.fns.dismissBanner,
  hide: isDismissed
};
''',
        css: '''
const isAtLimit = args.fns.isAtQuotaLimit?.();

return `._id {
  padding: ${args.theme.var.spacing.sm} ${args.theme.var.spacing.md};
  background: ${isAtLimit ? args.theme.var.color.error_dark_100 : args.theme.var.color.warning_dark_100};
  color: ${isAtLimit ? args.theme.var.color.error_dark_100_text : args.theme.var.color.warning_dark_100_text};
  border: none;
  border-radius: ${args.theme.var.borderRadius.md};
  font-size: ${args.theme.var.fontSize.sm};
  font-weight: 500;
  cursor: pointer;
  transition: all ${args.theme.var.animation.fast} ease;
  flex-shrink: 0;

  &:hover {
    background: ${isAtLimit ? args.theme.var.color.error_dark_200 : args.theme.var.color.warning_dark_200};
  }

  &:active {
    transform: scale(0.98);
  }
}`;
'''
      }
    },
    {
      id: "layout_wrapper",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
// Check if user is admin
const checkAdminRole = () => {
  const userRoles = args.user?.OUT?.UserRole || [];
  return userRoles.some(edgeId => {
    const edge = args.graph.edges[edgeId];
    const role = args.graph.vertexes[edge.E];
    return role?.P?.key === "Admin";
  });
};

// Impersonation state management
const [impersonatedUser, setImpersonatedUser] = args.createSignal(null);

// YouTube Ownership state management (multi-account support)
const [ownerships, setOwnerships] = args.createSignal([]);
const [selectedOwnership, setSelectedOwnership] = args.createSignal(null);
const [ownershipsLoading, setOwnershipsLoading] = args.createSignal(false);

// Quota usage state management
const [quotaUsage, setQuotaUsage] = args.createSignal(null);
const [quotaLoading, setQuotaLoading] = args.createSignal(false);

// Load impersonation state from sessionStorage (client-side only)
// This is called from onMount to avoid SSR/hydration mismatch
const loadImpersonationState = () => {
  if (typeof window !== 'undefined') {
    const storedImpersonation = sessionStorage.getItem('yto_impersonatedUser');
    if (storedImpersonation) {
      try {
        setImpersonatedUser(JSON.parse(storedImpersonation));
      } catch (e) {
        // Ignore parsing errors
      }
    }
  }
};

// Exit impersonation
const exitImpersonation = async () => {
  const impersonated = impersonatedUser();
  if (!impersonated) return;

  const result = await args.executeNamedServerFunction({
    functionName: "clearImpersonation",
    contextData: { impersonatedUserUuid: impersonated.P.uuid }
  });

  setImpersonatedUser(null);
  if (typeof window !== 'undefined') {
    sessionStorage.removeItem('yto_impersonatedUser');
  }
  args.showSuccessToast("Stopped viewing as user");

  // Reload current page to refresh data
  window.location.reload();
};

// Get impersonatedUserUuid for contextData
const getImpersonatedUserUuid = () => {
  const impersonated = impersonatedUser();
  return impersonated?.P?.uuid || null;
};

// Fetch all YouTube ownerships for the user
const fetchOwnerships = async () => {
  setOwnershipsLoading(true);
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "getYouTubeOwnerships",
      contextData: {}
    });

    if (result?.result?.success && result?.result?.data) {
      const ownershipsList = result.result.data;
      setOwnerships(ownershipsList);

      // If no ownership is selected and we have ownerships, select the first one
      // (either primary or first in list)
      if (!selectedOwnership() && ownershipsList.length > 0) {
        const primaryOwnership = ownershipsList.find(o => o.P.isPrimary);
        const defaultOwnership = primaryOwnership || ownershipsList[0];
        await selectOwnership(defaultOwnership);
      } else if (selectedOwnership()) {
        // If an ownership is already selected (from sessionStorage),
        // verify it still exists in the fetched list
        const currentOwnershipId = selectedOwnership().P.key;
        const stillExists = ownershipsList.find(o => o.P.key === currentOwnershipId);

        if (!stillExists && ownershipsList.length > 0) {
          // Selected ownership no longer exists, select first available
          const primaryOwnership = ownershipsList.find(o => o.P.isPrimary);
          const defaultOwnership = primaryOwnership || ownershipsList[0];
          await selectOwnership(defaultOwnership);
        }
      }
    }
  } catch (error) {
    console.error('Error fetching ownerships:', error);
    args.showErrorToast('Failed to load YouTube accounts');
  } finally {
    setOwnershipsLoading(false);
  }
};

// Select a YouTube ownership (account)
const selectOwnership = async (ownership) => {
  if (!ownership) return;

  setSelectedOwnership(ownership);

  // Save to sessionStorage
  if (typeof window !== 'undefined') {
    sessionStorage.setItem('yto_selectedOwnership', JSON.stringify(ownership));
  }

  // Update lastSelected on server
  try {
    await args.executeNamedServerFunction({
      functionName: "updateOwnershipLastSelected",
      contextData: { ownershipId: ownership.P.key }
    });
  } catch (error) {
    console.error('Error updating ownership lastSelected:', error);
  }

  // Refresh quota usage for the new ownership
  await fetchQuotaUsage();
};

// Load ownership state from sessionStorage
const loadOwnershipState = () => {
  if (typeof window !== 'undefined') {
    const storedOwnership = sessionStorage.getItem('yto_selectedOwnership');
    if (storedOwnership) {
      try {
        const ownership = JSON.parse(storedOwnership);
        setSelectedOwnership(ownership);
      } catch (e) {
        // Ignore parsing errors
      }
    }
  }
};

// Get selected ownershipId for contextData
const getSelectedOwnershipId = () => {
  const ownership = selectedOwnership();
  return ownership?.P?.key || null;
};

// Wrapper for executeNamedServerFunction that automatically includes impersonatedUserUuid and ownershipId
const executeYTOFunction = async (functionName, contextData = {}) => {
  const impersonatedUserUuid = getImpersonatedUserUuid();
  const ownershipId = getSelectedOwnershipId();

  return await args.executeNamedServerFunction({
    functionName,
    contextData: {
      ...contextData,
      // Only add impersonatedUserUuid if it exists (admin is impersonating)
      ...(impersonatedUserUuid ? { impersonatedUserUuid } : {}),
      // Add ownershipId if selected (required for most operations)
      ...(ownershipId ? { ownershipId } : {})
    }
  });
};

// Fetch quota usage from server
const fetchQuotaUsage = async () => {
  setQuotaLoading(true);
  try {
    const result = await executeYTOFunction('getAPIUsageToday', {});
    if (result?.result) {
      setQuotaUsage(result.result);
    }
  } catch (error) {
    console.error('Error fetching quota usage:', error);
  } finally {
    setQuotaLoading(false);
  }
};

// Check if approaching quota limit (80%)
const isApproachingQuotaLimit = () => {
  const usage = quotaUsage();
  if (!usage) return false;

  const usedQuota = usage.totalUnitsUsed || 0;
  const dailyLimit = usage.dailyLimit || 10000;
  const percentage = (usedQuota / dailyLimit) * 100;

  return percentage >= 80;
};

// Check if at quota limit (95%) - should disable actions
const isAtQuotaLimit = () => {
  const usage = quotaUsage();
  if (!usage) return false;

  const usedQuota = usage.totalUnitsUsed || 0;
  const dailyLimit = usage.dailyLimit || 10000;
  const percentage = (usedQuota / dailyLimit) * 100;

  return percentage >= 95;
};

// Get quota reset time (midnight UTC)
const getQuotaResetTime = () => {
  const now = new Date();
  const midnight = new Date(Date.UTC(
    now.getUTCFullYear(),
    now.getUTCMonth(),
    now.getUTCDate() + 1, // Next day
    0, 0, 0, 0 // Midnight
  ));

  const diff = midnight - now;
  const hours = Math.floor(diff / (1000 * 60 * 60));
  const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));

  return `${hours}h ${minutes}m`;
};

// Get quota usage percentage
const getQuotaUsagePercentage = () => {
  const usage = quotaUsage();
  if (!usage) return 0;

  const usedQuota = usage.totalUnitsUsed || 0;
  const dailyLimit = usage.dailyLimit || 10000;
  return Math.round((usedQuota / dailyLimit) * 100);
};

// Video player state management
const [playerState, setPlayerState] = args.createSignal("closed"); // closed, minimized, maximized
const [currentVideo, setCurrentVideo] = args.createSignal(null);

// Player position and size state
const [playerPosition, setPlayerPosition] = args.createStore({ x: null, y: null });
const [playerSize, setPlayerSize] = args.createStore({ width: 400, height: 250 });

// Video queue state
const [videoQueue, setVideoQueue] = args.createSignal([]);

// Play video in the player
const playVideo = (video) => {
  setCurrentVideo(video);
  setPlayerState("minimized");
};

// Add video to queue
const addToQueue = (video) => {
  const queue = videoQueue();
  const videoId = video?.P?.youtubeId;

  // Check if video already in queue
  const alreadyInQueue = queue.some(v => v?.P?.youtubeId === videoId);
  if (alreadyInQueue) {
    args.showWarningToast("Video already in queue");
    return;
  }

  setVideoQueue([...queue, video]);
  args.showSuccessToast("Added to queue");
};

// Play playlist (loads videos and plays first one)
const playPlaylist = async (playlist) => {
  try {
    const playlistId = playlist?.P?.youtubeId;
    if (!playlistId) {
      args.showErrorToast("Invalid playlist");
      return;
    }

    // Get playlist videos
    const result = await executeYTOFunction("getPlaylistVideos", { playlistId });

    if (result?.result?.success && result?.result?.data?.videos) {
      const videos = result.result.data.videos;

      if (videos.length === 0) {
        args.showWarningToast("Playlist has no videos");
        return;
      }

      // Play first video
      const firstVideo = videos[0]?.video;
      if (firstVideo) {
        setCurrentVideo(firstVideo);
        setPlayerState("minimized");

        // Add remaining videos to queue
        const remainingVideos = videos.slice(1).map(v => v.video);
        setVideoQueue([...videoQueue(), ...remainingVideos]);

        args.showSuccessToast(`Playing playlist: ${playlist?.P?.title || 'Playlist'}`);
      }
    } else {
      args.showErrorToast("Failed to load playlist videos");
    }
  } catch (error) {
    console.error("Error playing playlist:", error);
    args.showErrorToast("Failed to play playlist");
  }
};

// Add all playlist videos to queue
const addPlaylistToQueue = async (playlist) => {
  try {
    const playlistId = playlist?.P?.youtubeId;
    if (!playlistId) {
      args.showErrorToast("Invalid playlist");
      return;
    }

    // Get playlist videos
    const result = await executeYTOFunction("getPlaylistVideos", { playlistId });

    if (result?.result?.success && result?.result?.data?.videos) {
      const videos = result.result.data.videos;

      if (videos.length === 0) {
        args.showWarningToast("Playlist has no videos");
        return;
      }

      const queue = videoQueue();
      const newVideos = [];

      // Filter out videos already in queue
      videos.forEach(item => {
        const video = item.video;
        const videoId = video?.P?.youtubeId;
        const alreadyInQueue = queue.some(v => v?.P?.youtubeId === videoId);

        if (!alreadyInQueue && !newVideos.some(v => v?.P?.youtubeId === videoId)) {
          newVideos.push(video);
        }
      });

      if (newVideos.length === 0) {
        args.showWarningToast("All playlist videos are already in queue");
        return;
      }

      setVideoQueue([...queue, ...newVideos]);
      args.showSuccessToast(`Added ${newVideos.length} video${newVideos.length !== 1 ? 's' : ''} to queue`);
    } else {
      args.showErrorToast("Failed to load playlist videos");
    }
  } catch (error) {
    console.error("Error adding playlist to queue:", error);
    args.showErrorToast("Failed to add playlist to queue");
  }
};

// Play next video from queue
const playNext = () => {
  const queue = videoQueue();
  if (queue.length === 0) {
    // Don't close player when queue is empty, just keep current video
    // setPlayerState("closed");
    // setCurrentVideo(null);
    return;
  }

  const nextVideo = queue[0];
  setCurrentVideo(nextVideo);
  setVideoQueue(queue.slice(1));
};

// Remove video from queue
const removeFromQueue = (index) => {
  const queue = videoQueue();
  setVideoQueue([...queue.slice(0, index), ...queue.slice(index + 1)]);
};

// Clear entire queue
const clearQueue = () => {
  setVideoQueue([]);
  args.showSuccessToast("Queue cleared");
};

// Queue modal state
const [isQueueModalOpen, setIsQueueModalOpen] = args.createSignal(false);

const openQueueModal = () => {
  setIsQueueModalOpen(true);
};

const closeQueueModal = () => {
  setIsQueueModalOpen(false);
};

// Add to playlist modal state
const [isAddToPlaylistModalOpen, setIsAddToPlaylistModalOpen] = args.createSignal(false);
const [playlistModalVideo, setPlaylistModalVideo] = args.createSignal(null);

const openAddToPlaylistModal = (video) => {
  setPlaylistModalVideo(video);
  setIsAddToPlaylistModalOpen(true);
};

const closeAddToPlaylistModal = () => {
  setIsAddToPlaylistModalOpen(false);
  setPlaylistModalVideo(null);
};

const addVideoToPlaylists = async (data) => {
  try {
    const result = await executeYTOFunction("addVideoToPlaylists", data);

    if (result?.result?.success) {
      args.showSuccessToast(result.result.message);
      return result.result;
    } else {
      const errorMessage = result?.result?.message || "Failed to add video to playlists";
      args.showErrorToast(errorMessage);
      const error = new Error(errorMessage);
      error.toastShown = true;
      throw error;
    }
  } catch (error) {
    // Only show toast for unexpected errors (network, etc.)
    if (!error.toastShown) {
      console.error("Unexpected error adding video to playlists:", error);
      args.showErrorToast("Failed to add video to playlists");
    }
    throw error;
  }
};

// Toggle player state
const togglePlayerState = () => {
  const current = playerState();
  if (current === "minimized") {
    setPlayerState("maximized");
  } else if (current === "maximized") {
    setPlayerState("minimized");
  }
};

// Close player
const closePlayer = () => {
  setPlayerState("closed");
  setCurrentVideo(null);
};

