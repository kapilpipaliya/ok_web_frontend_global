    icon: "carbon:dashboard-reference",
    title: "Admin dashboard home",
    pathCheck: (pathname) => pathname === "/admin_home" || pathname === "/admin_home/",
    // Only show for admin users
    showIf: checkAdminRole
  },
];

// Filter mobile navigation items based on showIf condition
const filteredMobileNavigationItems = mobileNavigationItemsData.filter(item => {
  if (item.showIf && typeof item.showIf === 'function') {
    return item.showIf();
  }
  return true; // Show by default if no showIf condition
});

// Create signal for mobile navigation items
const [mobileNavigationItems, setMobileNavigationItems] = args.createSignal(filteredMobileNavigationItems);

// Status messages from constants
const STATUS_CONSTANTS = {
  "statuses": {
    "queued": {
      "label": "Queued",
      "message": "Waiting in queue",
      "color": "blue",
      "icon": "carbon:time",
      "canCancel": true,
      "canRetry": false
    },
    "processing": {
      "label": "Processing",
      "message": "Fetching data from YouTube",
      "color": "yellow",
      "icon": "carbon:in-progress",
      "canCancel": true,
      "canRetry": false
    },
    "pending_quota": {
      "label": "Pending Quota",
      "message": "Waiting for quota reset (midnight UTC)",
      "color": "orange",
      "icon": "carbon:pause",
      "canCancel": true,
      "canRetry": true
    },
    "paused": {
      "label": "Paused",
      "message": "Paused by user",
      "color": "gray",
      "icon": "carbon:pause",
      "canCancel": true,
      "canRetry": true
    },
    "completed": {
      "label": "Completed",
      "message": "All data fetched successfully",
      "color": "green",
      "icon": "carbon:checkmark-filled",
      "canCancel": false,
      "canRetry": true
    },
    "completed_with_errors": {
      "label": "Completed with Errors",
      "message": "Completed with some failures",
      "color": "yellow",
      "icon": "carbon:warning-filled",
      "canCancel": false,
      "canRetry": true
    },
    "failed": {
      "label": "Failed",
      "message": "Processing failed",
      "color": "red",
      "icon": "carbon:error-filled",
      "canCancel": false,
      "canRetry": true
    }
  },
  "priorities": {
    "high": {
      "label": "High Priority",
      "color": "red",
      "icon": "carbon:arrow-up",
      "order": 1
    },
    "normal": {
      "label": "Normal Priority",
      "color": "blue",
      "icon": "carbon:minus",
      "order": 2
    },
    "low": {
      "label": "Low Priority",
      "color": "gray",
      "icon": "carbon:arrow-down",
      "order": 3
    }
  }
};

// Get status info
const getStatusInfo = (status) => {
  return STATUS_CONSTANTS.statuses[status] || null;
};

// Get priority info
const getPriorityInfo = (priority) => {
  return STATUS_CONSTANTS.priorities[priority] || null;
};

return {
  checkAdminRole,
  impersonatedUser,
  exitImpersonation,
  getImpersonatedUserUuid,
  executeYTOFunction,
  loadImpersonationState,
  ownerships,
  selectedOwnership,
  ownershipsLoading,
  fetchOwnerships,
  selectOwnership,
  loadOwnershipState,
  getSelectedOwnershipId,
  quotaUsage,
  fetchQuotaUsage,
  isApproachingQuotaLimit,
  isAtQuotaLimit,
  getQuotaResetTime,
  getQuotaUsagePercentage,
  navigationSections,
  setNavigationSections,
  mobileNavigationItems,
  setMobileNavigationItems,
  playerState,
  currentVideo,
  playVideo,
  playPlaylist,
  togglePlayerState,
  closePlayer,
  playerPosition,
  setPlayerPosition,
  playerSize,
  setPlayerSize,
  videoQueue,
  addToQueue,
  addPlaylistToQueue,
  playNext,
  removeFromQueue,
  clearQueue,
  isQueueModalOpen,
  openQueueModal,
  closeQueueModal,
  isAddToPlaylistModalOpen,
  playlistModalVideo,
  openAddToPlaylistModal,
  closeAddToPlaylistModal,
  addVideoToPlaylists,
  getStatusInfo,
  getPriorityInfo
};
''',
        props: '''
return {
  as: "div",
  onMount: async () => {
    // Load saved state from sessionStorage
    args.fns.loadImpersonationState?.();
    args.fns.loadOwnershipState?.();

    // Fetch ownerships (will auto-select first one if none selected)
    await args.fns.fetchOwnerships?.();

    // Fetch quota usage for selected ownership
    args.fns.fetchQuotaUsage?.();

    // Refresh quota usage every 5 minutes
    const quotaInterval = setInterval(() => {
      args.fns.fetchQuotaUsage?.();
    }, 5 * 60 * 1000);

    // Cleanup on unmount
    return () => {
      clearInterval(quotaInterval);
    };
  }
};
'''
      }
    },
