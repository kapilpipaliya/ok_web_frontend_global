{
  vertexes: [
    {
      id: "yto_layout_component",
      L: "Component",
      P: {
        key: "YTOLayout"
      }
    },
    {
      id: "yto_layout_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
  display: flex;
  flex-direction: column;
}`;
'''
      }
    },
    {
      id: "yto_layout_content",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  flex: 1;
  padding-bottom: 5rem; /* Space for bottom navigation */
  overflow-x: hidden;
}`;
'''
      }
    },
    {
      id: "yto_layout_slot",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Slot",
        name: "children"
      }
    },
    {
      id: "yto_layout_bottom_nav",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "nav"
};
''',
        css: '''
return `._id {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: ${args.theme.var.color.surface};
  border-top: 1px solid ${args.theme.var.color.border};
  padding: 0.75rem;
  z-index: 100;
  box-shadow: 0 -2px 8px rgba(0,0,0,0.1);
  backdrop-filter: blur(10px);
  
  @media (max-width: 768px) {
    padding: 0.5rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_layout_nav_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  justify-content: space-around;
  align-items: center;
  max-width: 600px;
  margin: 0 auto;
  gap: 0.5rem;
}`;
'''
      }
    },
    {
      id: "yto_layout_nav_home",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const currentPath = args.location?.pathname || '';
const isActive = currentPath === '/yto' || currentPath === '/yto/';

return {
  as: "button",
  onClick: () => args.navigate('/yto')
};
''',
        css: '''
const currentPath = args.location?.pathname || '';
const isActive = currentPath === '/yto' || currentPath === '/yto/';

return `._id {
  background: ${isActive ? args.theme.var.color.primary : 'transparent'};
  color: ${isActive ? args.theme.var.color.primary_text : args.theme.var.color.muted};
  border: none;
  border-radius: 0.75rem;
  padding: 0.75rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: inherit;
  flex: 1;
  max-width: 80px;
  
  &:hover {
    background: ${isActive ? args.theme.var.color.primary_dark_200 : args.theme.var.color.background_dark_100};
    color: ${isActive ? args.theme.var.color.primary_text : args.theme.var.color.text};
  }
  
  @media (max-width: 768px) {
    padding: 0.5rem;
    gap: 0.125rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_layout_nav_home_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:home",
  width: 24,
  height: 24
};
''',
        css: '''
return `._id {
  @media (max-width: 768px) {
    width: 20px;
    height: 20px;
  }
}`;
'''
      }
    },
    {
      id: "yto_layout_nav_home_label",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "span",
  text: "Home"
};
''',
        css: '''
return `._id {
  font-size: 0.75rem;
  font-weight: 500;
  
  @media (max-width: 768px) {
    font-size: 0.625rem;
  }
}`;
'''
      }
    },
