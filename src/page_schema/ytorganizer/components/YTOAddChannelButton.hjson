{
  vertexes: [
    {
      id: "yto_add_channel_button_component",
      L: "Component",
      P: {
        key: "YTOAddChannelButton"
      }
    },
    {
      id: "yto_add_channel_button_variant_on_submit",
      L: "ComponentVariant",
      P: {
        key: "onSubmit",
        type: "function",
        defValue: null
      }
    },
    {
      id: "yto_add_channel_button_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        fns: '''
// State for showing/hiding the modal
const [showModal, setShowModal] = args.createSignal(false);

// Form state
const [urlValue, setUrlValue] = args.createSignal("");
const [nameValue, setNameValue] = args.createSignal("");
const [isSubmitting, setIsSubmitting] = args.createSignal(false);

// Get onSubmit callback from props
const onSubmit = args.contextData.props?.onSubmit;

// Handle form submission
const handleSubmit = async (e) => {
  e.preventDefault();

  const url = urlValue().trim();
  const name = nameValue().trim();

  if (!url) {
    args.showErrorToast("Please enter a channel URL");
    return;
  }

  // Set loading state
  setIsSubmitting(true);

  try {
    // Call the saveChannel server function
    const result = await args.executeNamedServerFunction({
      functionName: "saveChannel",
      contextData: {
        url: url,
        name: name || null
      }
    });

    if (result.error) {
      args.showErrorToast(result.error);
    } else if (result.result && result.result.success) {
      args.showSuccessToast(result.result.message);

      // Call parent onSubmit if provided
      if (onSubmit) {
        onSubmit({
          url: url,
          name: name,
          result: result.result.data
        });
      }

      // Reset form and close modal
      setUrlValue("");
      setNameValue("");
      setShowModal(false);
    } else {
      args.showErrorToast(result.result?.message || result.message || "Failed to save channel");
    }
  } catch (error) {
    console.error("Error saving channel:", error);
    args.showErrorToast("An error occurred while saving the channel. Please try again.");
  } finally {
    setIsSubmitting(false);
  }
};

// Return functions to be accessible in children
return {
  showModal,
  setShowModal,
  urlValue,
  setUrlValue,
  nameValue,
  setNameValue,
  isSubmitting,
  handleSubmit
};
'''
      }
    },
    {
      id: "yto_add_channel_button_fab",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "YTOFloatingButton",
        props: '''
return {
