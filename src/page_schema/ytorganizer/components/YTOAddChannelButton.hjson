        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: !args.fns.showModal(),
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      args.fns.setShowModal(false);
    }
  }
};
''',
        css: '''
return `._id {
