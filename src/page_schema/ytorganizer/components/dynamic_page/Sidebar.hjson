{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''
// Get props from context
const getParentVertexLabel = () => args.contextData.props?.parentVertexLabel;
const getToParentEdgeType = () => args.contextData.props?.toParentEdgeType;
const getRootKeys = () => args.contextData.props?.rootKeys || {};
const getTableVertexLabel = () => args.contextData.props?.tableVertexLabel;
const getRelationshipType = () => args.contextData.props?.relationshipType;

// State management - using graph for data, signals only for UI state
const [expandedKeys, setExpandedKeys] = args.createSignal([]);
const [selectedItem, setSelectedItem] = args.createSignal(null);
const [loading, setLoading] = args.createSignal(false);
const [isAddRootModalOpen, setIsAddRootModalOpen] = args.createSignal(false);
const [rootVertices, setRootVertices] = args.createSignal([]);

// Graph namespace for sidebar data
const SIDEBAR_NAMESPACE = "sidebar";
const getSidebarNamespace = (key) => `${SIDEBAR_NAMESPACE}_${key}`;

// Fetch root vertices and store in graph
const fetchRoot = async () => {
  const parentVertexLabel = getParentVertexLabel();
  const toParentEdgeType = getToParentEdgeType();
  const rootKeys = getRootKeys();

  if (!parentVertexLabel || !toParentEdgeType) {
    return;
  }

  setLoading(true);
  try {
    const tableVertexLabel = getTableVertexLabel();
    const relationshipType = getRelationshipType();
    
    const enableUserScoping = args.contextData.props?.enableUserScoping === true;
    
    const result = await args.executeNamedServerFunction({
      functionName: "getVertexChildren",
      contextData: {
        parentVertexLabel,
        toParentEdgeType,
        rootKeys,
        tableVertexLabel,
        relationshipType,
        enableUserScoping
      }
    });

    if (result?.result?.success && result.result.data) {
      const rootItems = result.result.data;
      
      // Store root items in graph
      if (result.graph && result.graph.vertexes) {
        args.setGraphData(0, result.graph, {});
      }
      
      // Store root items IDs in signal
      setRootVertices(rootItems.map(v => v.id));
      
      // Auto-expand root items
      const rootIds = rootItems.map(v => v.id);
      setExpandedKeys(rootIds);
      // Fetch children for all root items
      for (const rootItem of rootItems) {
        await fetchChildren(rootItem.id);
      }
    } else {
      args.showErrorToast?.(result?.result?.message || result?.error || "Failed to load root vertices");
    }
  } catch (error) {
    console.error("Error fetching root:", error);
    args.showErrorToast?.("Failed to load sidebar data");
  } finally {
    setLoading(false);
  }
};

// Fetch children for a specific parent and store in graph
const fetchChildren = async (parentId, forceRefresh = false) => {
  const parentVertexLabel = getParentVertexLabel();
  const toParentEdgeType = getToParentEdgeType();

  if (!parentVertexLabel || !toParentEdgeType || !parentId) {
    return [];
  }

  // Check graph first using evalExpression (unless forcing refresh)
  if (!forceRefresh) {
    const parentVertex = args.graph.vertexes[parentId];
    if (parentVertex) {
      // Use evalExpression to get children from graph
      // Relationship direction: child-[toParentEdgeType]->parent, so use <- to get children
      const children = args.evalExpression(
        `<-${toParentEdgeType}`,
        { graph: args.graph, setGraph: args.setGraph, vertexes: [parentVertex] }
      ) || [];
      if (children.length > 0) {
        return children;
      }
    }
  }

  try {
    const tableVertexLabel = getTableVertexLabel();
    const relationshipType = getRelationshipType();
    
    const enableUserScoping = args.contextData.props?.enableUserScoping === true;
    
    const result = await args.executeNamedServerFunction({
      functionName: "getVertexChildren",
      contextData: {
        parentVertexLabel,
        toParentEdgeType,
        parentId,
        tableVertexLabel,
        relationshipType,
        enableUserScoping
      }
    });

    if (result?.result?.success && result.result.data) {
      // Store children in graph
      if (result.graph && result.graph.vertexes) {
        args.setGraphData(0, result.graph, {});
      }
      
      // Return children using evalExpression from graph
      // Relationship direction: child-[toParentEdgeType]->parent, so use <- to get children
      const parentVertex = args.graph.vertexes[parentId];
      if (parentVertex) {
        const children = args.evalExpression(
          `<-${toParentEdgeType}`,
          { graph: args.graph, setGraph: args.setGraph, vertexes: [parentVertex] }
        ) || [];
        return children;
      }
    }
  } catch (error) {
    console.error("Error fetching children:", error);
  }

  return [];
};

// Get children for a specific parent using evalExpression (reactive)
const getChildren = (parentId) => {
  if (!parentId) return [];
  const toParentEdgeType = getToParentEdgeType();
  // Access graph reactively
  const graph = args.graph;
  const parentVertex = graph.vertexes[parentId];
  if (!parentVertex) return [];
  
  // Use evalExpression to get children via incoming edge
  // Relationship direction: child-[toParentEdgeType]->parent, so use <- to get children
  // Expression format: ->EdgeType (outgoing) or <-EdgeType (incoming)
  const children = args.evalExpression(
    `<-${toParentEdgeType}`,
    { graph: args.graph, setGraph: args.setGraph, vertexes: [parentVertex] }
  ) || [];
  
  return children;
};

// Get loading state - not needed with graph, but kept for compatibility
const getLoadingState = (parentId) => {
  return false; // Graph updates are synchronous
};

// Get root items from signal mapped to graph vertices (reactive)
const getRoot = () => {
  // Get root vertex IDs from signal
  const rootIds = rootVertices();
  // Access graph reactively
  const graph = args.graph;
  // Map IDs to vertices from graph and filter out blank results
  return rootIds
    .map(id => graph.vertexes[id])
    .filter(v => v !== undefined && v !== null);
};

// Toggle expand/collapse
const toggleExpand = async (itemId) => {
  const currentExpanded = expandedKeys();
  const isExpanded = currentExpanded.includes(itemId);

  if (isExpanded) {
    setExpandedKeys(currentExpanded.filter(id => id !== itemId));
  } else {
    setExpandedKeys([...currentExpanded, itemId]);
    // Always fetch children when expanding (cache will be checked inside fetchChildren)
    await fetchChildren(itemId);
  }
};

// Handle item selection
const handleItemSelect = (item) => {
  setSelectedItem(item);
  // Call onItemSelect if provided via props
  if (args.contextData.props?.onItemSelect) {
    args.contextData.props.onItemSelect(item);
  }
};

// Handle opening add root modal
const handleOpenAddRootModal = () => {
  setIsAddRootModalOpen(true);
};

// Handle closing add root modal
const handleCloseAddRootModal = () => {
  setIsAddRootModalOpen(false);
};

// Handle saving root item
const handleAddRootSave = async (savedVertex) => {
  // Add to root vertices signal (store only ID)
  const currentRootIds = rootVertices();
  if (!currentRootIds.includes(savedVertex.id)) {
    setRootVertices([...currentRootIds, savedVertex.id]);
  }
  
  // Refresh root items from server to ensure graph is updated
  await fetchRoot();
  setIsAddRootModalOpen(false);
};

// Update a specific item in the tree (for edits) - graph is automatically updated
const updateItemInTree = (updatedVertex) => {
  if (!updatedVertex || !updatedVertex.id) return;

  // Update vertex in graph using replaceVertexProperties
  args.replaceVertexProperties(0, updatedVertex.id, args.graph, args.setGraph, { ...updatedVertex.P });

  // Root vertices signal only stores IDs, so no need to update it on edit
  // The graph update will automatically reflect in getRoot() since it reads from graph

  // Update selectedItem if it's the currently selected item
  const currentSelected = selectedItem();
  if (currentSelected && currentSelected.id === updatedVertex.id) {
    setSelectedItem(updatedVertex);
  }
};


// Remove a specific item from the tree (for deletes) - using graph
const removeItemFromTree = (itemId) => {
  if (!itemId) return;

  // Find parent of deleted item using graph traversal
  const toParentEdgeType = getToParentEdgeType();
  const deletedVertex = args.graph.vertexes[itemId];
  let parentItem = null;
  
  if (deletedVertex && deletedVertex.IN && deletedVertex.IN[toParentEdgeType]) {
    const parentIds = deletedVertex.IN[toParentEdgeType];
    if (parentIds.length > 0) {
      parentItem = args.graph.vertexes[parentIds[0]];
    }
  }

  // Remove vertex from graph
  args.deleteVertex(0, itemId, args.graph, args.setGraph);

  // Remove from root vertices signal if it's a root item (signal stores IDs)
  const currentRootIds = rootVertices();
  if (currentRootIds.includes(itemId)) {
    setRootVertices(currentRootIds.filter(id => id !== itemId));
  }

  // Select parent item if it exists, otherwise clear selection
  const currentSelected = selectedItem();
  if (currentSelected && currentSelected.id === itemId) {
    if (parentItem) {
      setSelectedItem(parentItem);
      // Also call onItemSelect if provided
      if (args.contextData.props?.onItemSelect) {
        args.contextData.props.onItemSelect(parentItem);
      }
    } else {
      setSelectedItem(null);
    }
  }
};

// Initialize on mount
const initialize = async () => {
  await fetchRoot();
};

return {
  getRoot,
  rootVertices,
  setRootVertices,
  expandedKeys,
  setExpandedKeys,
  selectedItem,
  setSelectedItem,
  loading,
  setLoading,
  fetchRoot,
  fetchChildren,
  toggleExpand,
  handleItemSelect,
  initialize,
  getParentVertexLabel,
  getToParentEdgeType,
  getRootKeys,
  getTableVertexLabel,
  getRelationshipType,
  isAddRootModalOpen,
  setIsAddRootModalOpen,
  handleOpenAddRootModal,
  handleCloseAddRootModal,
  handleAddRootSave,
  updateItemInTree,
  removeItemFromTree,
  getChildren,
  getLoadingState,
  getOnMoveItemsToCategory: () => args.contextData.props?.onMoveItemsToCategory
};
'''
