  expandedKeys: args.fns.expandedKeys(),
  selectedItem: args.fns.selectedItem(),
  onToggleExpand: args.fns.toggleExpand,
  onItemSelect: args.fns.handleItemSelect,
  fetchChildren: args.fns.fetchChildren,
  parentVertexLabel: args.fns.getParentVertexLabel(),
  toParentEdgeType: args.fns.getToParentEdgeType(),
  formConfig: args.contextData.props?.formConfig,
  rootKeys: args.fns.getRootKeys(),
  onItemUpdate: args.fns.updateItemInTree,
  onItemDelete: args.fns.removeItemFromTree,
  childItems: children,
  loading: false,
  getChildren: args.fns.getChildren,
  tableVertexLabel: args.fns.getTableVertexLabel(),
  relationshipType: args.fns.getRelationshipType(),
  enableUserScoping: args.contextData.props?.enableUserScoping,
  onMoveItemsToCategory: args.fns.getOnMoveItemsToCategory(),
  fetchRoot: args.fns.fetchRoot
};
'''
