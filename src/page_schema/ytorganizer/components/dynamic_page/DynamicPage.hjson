return {
  parentVertexLabel: sidebarConfig?.parentVertexLabel,
  toParentEdgeType: sidebarConfig?.toParentEdgeType,
  rootKeys: sidebarConfig?.rootKeys || {},
  formConfig: sidebarConfig?.formConfig,
  onItemSelect: args.fns.handleSidebarItemSelect,
  tableVertexLabel: tableVertexLabel,
  relationshipType: relationshipType,
  enableUserScoping: enableUserScopingForSidebar
};
'''
