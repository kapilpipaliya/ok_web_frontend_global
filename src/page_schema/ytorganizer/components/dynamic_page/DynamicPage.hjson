const sidebarConfig = args.fns.getSidebarConfig();
const tableVertexLabel = args.fns.getTableVertexLabel();
// Relationship type is "User" + tableVertexLabel (e.g., "UserBook", "UserAudioVideo")
const relationshipType = tableVertexLabel ? `User${tableVertexLabel}` : null;

// Get config to check user scoping settings
const { config } = args.fns.getCachedConfig();
