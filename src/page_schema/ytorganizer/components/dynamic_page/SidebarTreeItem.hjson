        displayOrder: 1
        componentName: SidebarTreeItem
        key: tree_item_child
        props:
          '''
const childItem = args.contextData.childItem;
// Get children from graph reactively using parent's getChildren function
// Access graph reactively by calling getChildren which accesses args.graph
const getChildrenFn = args.contextData.props?.getChildren;
// Call getChildren to get children reactively (it accesses args.graph which is reactive)
const children = getChildrenFn ? getChildrenFn(childItem?.id) : [];

return {
  item: childItem,
  expandedKeys: args.contextData.props?.expandedKeys || [],
  selectedItem: args.contextData.props?.selectedItem,
  onToggleExpand: args.contextData.props?.onToggleExpand,
  onItemSelect: args.contextData.props?.onItemSelect,
  fetchChildren: args.contextData.props?.fetchChildren,
  parentVertexLabel: args.contextData.props?.parentVertexLabel,
  toParentEdgeType: args.contextData.props?.toParentEdgeType,
  formConfig: args.contextData.props?.formConfig,
  rootKeys: args.contextData.props?.rootKeys,
  onItemUpdate: args.contextData.props?.onItemUpdate,
  onItemDelete: args.contextData.props?.onItemDelete,
  childItems: children,
  loading: false,
  getChildren: getChildrenFn,
  tableVertexLabel: args.contextData.props?.tableVertexLabel,
  relationshipType: args.contextData.props?.relationshipType,
  onMoveItemsToCategory: args.contextData.props?.onMoveItemsToCategory
};
'''
      }
    }
    {
      id: "13"
      L: Attr
      P: {
        displayOrder: 5
        componentName: SidebarAddChildModal
        key: tree_item_add_modal
        props:
          '''
const item = args.fns.getItem();
const formConfig = args.fns.getFormConfig();
const parentVertexLabel = args.contextData.props?.parentVertexLabel;
const toParentEdgeType = args.contextData.props?.toParentEdgeType;
const rootKeys = args.contextData.props?.rootKeys || {};
const tableVertexLabel = args.contextData.props?.tableVertexLabel;
const relationshipType = args.contextData.props?.relationshipType;

return {
  isOpen: args.fns.isAddModalOpen(),
  formConfig: formConfig,
  parentId: item?.id,
  parentVertexLabel: parentVertexLabel,
  toParentEdgeType: toParentEdgeType,
  rootKeys: rootKeys,
  tableVertexLabel: tableVertexLabel,
  relationshipType: relationshipType,
  onSave: args.fns.handleAddChildSave,
  onClose: args.fns.handleCloseAddModal
};
'''
