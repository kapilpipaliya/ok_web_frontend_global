    {
      id: "3"
      L: Attr
      P: {
        css:
          '''
const isHovered = args.fns.isSelected();
const isDragOver = args.fns.isDragOver();
const isValidDrop = args.fns.isValidDrop?.() ?? true;
const isDragging = args.fns.isDragging?.() || false;
const item = args.fns.getItem();
const rootKeys = args.contextData.props?.sidebarConfig?.rootKeys || {};
const rootKey = rootKeys.key;
const isRoot = item?.P?.key === rootKey || item?.P?.key === 'uncategorized';

// Determine drag over styling based on validation
let dragOverStyle = "";
if (isDragOver) {
  if (isValidDrop) {
    // Valid drop: green border and subtle green background
    dragOverStyle = `background-color: ${args.theme.var.color.success || '#10b981'}20; border: 2px dashed ${args.theme.var.color.success || '#10b981'};`;
  } else {
    // Invalid drop: red border and red background with opacity
    dragOverStyle = `background-color: ${args.theme.var.color.danger || '#ef4444'}20; border: 2px dashed ${args.theme.var.color.danger || '#ef4444'}; cursor: not-allowed;`;
  }
}

return `._id {
  align-items: center;
  cursor: ${isRoot ? 'default' : isDragging ? 'grabbing' : isDragOver && !isValidDrop ? 'not-allowed' : 'grab'};
  display: flex;
  gap: 0.375rem;
  font-size: 14px;
  font-weight: ${args.fns.hasChildren() ? "bold" : "normal"};
  width: 100%;
  border-radius: ${args.fns.hasChildren() ? "5px" : "0 5px 5px 0"};
  ${isHovered ? `background-color: ${args.theme.var.color.background_dark_150};` : ""}
  ${dragOverStyle}
  ${isDragging ? `opacity: 0.5;` : ""}
  padding: 2px 0;
  transition: all 0.15s ease-in-out;
  ${args.fns.hasChildren() ? "" : `border-left: 1px dashed ${args.theme.var.color.border};`}
}`;
'''
        displayOrder: 1
        componentName: Html
        key: tree_item_content
        props:
          '''
const item = args.fns.getItem();
const rootKeys = args.contextData.props?.sidebarConfig?.rootKeys || {};
const rootKey = rootKeys.key;
const isRoot = item?.P?.key === rootKey || item?.P?.key === 'uncategorized';
const isDragging = args.fns.isDragging?.() || false;
const isDragOver = args.fns.isDragOver?.() || false;
const isValidDrop = args.fns.isValidDrop?.() ?? true;

return {
  as: "div",
  onClick: args.fns.handleItemClick,
  onDragOver: args.fns.handleDragOver,
  onDragLeave: args.fns.handleDragLeave,
  onDrop: args.fns.handleDrop,
  draggable: !isRoot,
  onDragStart: !isRoot ? args.fns.handleDragStartSidebar : undefined,
  onDragEnd: args.fns.handleDragEnd,
  style: isDragging ? { opacity: 0.5 } : {}
};
'''
