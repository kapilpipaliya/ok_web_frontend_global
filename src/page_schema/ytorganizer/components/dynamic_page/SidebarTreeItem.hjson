const expanded = args.fns.isExpanded();
// Get children reactively - this will update when graph changes
const childrenList = args.fns.getChildren();
// Only render if expanded and we have children
// If expanded but no children yet, they might be fetching
return {
  as: "ul",
  loop: expanded && childrenList.length > 0,
  contextName: "childItem",
  data: expanded ? childrenList : [],
  hide: !expanded || childrenList.length === 0
};
