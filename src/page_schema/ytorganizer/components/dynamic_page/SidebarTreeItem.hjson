{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''
// Get props from context
const getItem = () => args.contextData.props?.item;
const getExpandedKeys = () => args.contextData.props?.expandedKeys || [];
const getSelectedItem = () => args.contextData.props?.selectedItem;
const getOnToggleExpand = () => args.contextData.props?.onToggleExpand;
const getOnItemSelect = () => args.contextData.props?.onItemSelect;
const getFetchChildren = () => args.contextData.props?.fetchChildren;
const getParentVertexLabel = () => args.contextData.props?.sidebarConfig?.parentVertexLabel;
const getToParentEdgeType = () => args.contextData.props?.sidebarConfig?.toParentEdgeType;

// Get children and loading from props (from graph)
const getChildren = () => {
  return args.contextData.props?.childItems || [];
};

const getLoading = () => {
  return args.contextData.props?.loading || false;
};

// Check if item is expanded - make it reactive by accessing the signal
const isExpanded = () => {
  const item = getItem();
  if (!item) return false;
  // Access expandedKeys as a signal to make it reactive
  const expandedKeys = getExpandedKeys();
  return Array.isArray(expandedKeys) && expandedKeys.includes(item.id);
};

// Check if item is selected
const isSelected = () => {
  const item = getItem();
  const selectedItem = getSelectedItem();
  if (!item || !selectedItem) return false;
  return item.id === selectedItem.id;
};

// Refresh children function - calls parent's fetchChildren
const refreshChildren = async () => {
  const item = getItem();
  if (!item) return;

  const fetchChildrenFn = getFetchChildren();
  if (fetchChildrenFn) {
    await fetchChildrenFn(item.id, true);
  }
};

// Fetch children on mount if expanded
const fetchChildrenIfNeeded = async () => {
  const item = getItem();
  if (!item) return;

  const expanded = isExpanded();
  if (!expanded) return;
  
  const childrenList = getChildren();
  
  // Always fetch children when expanded if we don't have them loaded yet
  // This ensures nested children are fetched from the server
  if (childrenList.length === 0) {
    const fetchChildrenFn = getFetchChildren();
    if (fetchChildrenFn) {
      await fetchChildrenFn(item.id);
    }
  }
};

// Handle expand toggle
const handleToggleExpand = async () => {
  const item = getItem();
  if (!item) return;

  const onToggleExpand = getOnToggleExpand();
  if (onToggleExpand) {
    const wasExpanded = isExpanded();
    await onToggleExpand(item.id);
    // Always fetch children when expanding (even if we think we have them)
    // This ensures nested children are properly fetched from the server
    if (!wasExpanded) {
      // Fetch children from server to ensure they're in the graph
      const fetchChildrenFn = getFetchChildren();
      if (fetchChildrenFn) {
        await fetchChildrenFn(item.id);
      }
    }
  }
};

// Handle item click
const handleItemClick = () => {
  const item = getItem();
  const onItemSelect = getOnItemSelect();
  if (item && onItemSelect) {
    onItemSelect(item);
  }
};

// Get item display name (with content count)
const getItemName = () => {
  const item = getItem();
  if (!item) return "";

  const baseName = item.P?.key || item.P?.name || item.P?.title || "No name";

  // Use content count from vertex P property
  const contentCount = item.P?.contentCount ?? 0;
  if (contentCount > 0) {
    return `${baseName} (${contentCount})`;
  }

  return baseName;
};

// Get item icon
const getItemIcon = () => {
  const item = getItem();
  if (!item) return "ph:circle";
  return item.P?.icon || "ph:circle";
};

// Check if item has children
// Show expand button if we have children loaded or if relationships indicate children exist
const hasChildren = () => {
  const item = getItem();
  if (!item) return false;
  
  // Check if we have children in graph
  const childrenList = getChildren();
  if (childrenList.length > 0) {
    return true;
  }
  
  // If no children in graph, check if the vertex has IN relationships indicating it has children
  // Relationship direction: child-[toParentEdgeType]->parent
  // So parent has IN relationships from children (children point to parent)
  // When processResult processes relationships, it sets up parent.IN[toParentEdgeType]
  const toParentEdgeType = getToParentEdgeType();
  if (toParentEdgeType && item.IN && item.IN[toParentEdgeType] && item.IN[toParentEdgeType].length > 0) {
    return true;
  }
  
  // For nested items that haven't been fetched yet, we don't know if they have children
  // But we should allow expansion to check - show expand button if item might have children
  // This allows nested items to be expanded to fetch and check for children
  // The expand button will be hidden if no children are found after fetching
  return true;
};

// Modal state
const [isAddModalOpen, setIsAddModalOpen] = args.createSignal(false);
const [isEditModalOpen, setIsEditModalOpen] = args.createSignal(false);

// Get formConfig from props
const getFormConfig = () => args.contextData.props?.sidebarConfig?.formConfig;

// Get onItemUpdate callback from props
const getOnItemUpdate = () => args.contextData.props?.onItemUpdate;

// Get onItemDelete callback from props
const getOnItemDelete = () => args.contextData.props?.onItemDelete;

// Get fetchRoot function from props
const getFetchRoot = () => args.contextData.props?.fetchRoot;


// Helper function to refresh category count
const refreshCategoryCount = async (categoryItem, rootKey) => {
  if (!categoryItem) return;
  
  const fetchChildrenFn = getFetchChildren();
  const fetchRootFn = getFetchRoot();
  
  // Check if category is uncategorized
  const isUncategorized = 
    categoryItem.P?.key === rootKey || 
    categoryItem.P?.key === 'uncategorized' || 
    categoryItem.id === 'uncategorized';
  
  if (isUncategorized) {
    // Refresh root items to update uncategorized count
    if (fetchRootFn) {
      await fetchRootFn();
    }
  } else if (categoryItem.id && fetchChildrenFn) {
    // Refresh the specific category
    await fetchChildrenFn(categoryItem.id, true);
    
    // Also refresh parent's children if this is a child item (to update parent's count)
    const toParentEdgeType = getToParentEdgeType();
    if (toParentEdgeType) {
      const parentItem = args.evalExpression?.(`<-${toParentEdgeType}`, {
        graph: args.graph,
        setGraph: args.setGraph,
        vertexes: [categoryItem]
      })?.[0];
      
      if (parentItem && parentItem.id && fetchChildrenFn) {
        await fetchChildrenFn(parentItem.id, true);
      }
    }
  }
};

// Handle opening add modal
const handleOpenAddModal = (e) => {
  e.stopPropagation();
  setIsAddModalOpen(true);
};

// Handle closing add modal
const handleCloseAddModal = () => {
  setIsAddModalOpen(false);
};

// Handle opening edit modal
const handleOpenEditModal = (e) => {
  e.stopPropagation();
  setIsEditModalOpen(true);
};

// Handle closing edit modal
const handleCloseEditModal = () => {
  setIsEditModalOpen(false);
};

// Handle save callback - refresh children after adding
const handleAddChildSave = async (newVertex) => {
  const item = getItem();
  if (!item) return;

  // Refresh children - force refresh to get latest data
  const fetchChildrenFn = getFetchChildren();
  if (fetchChildrenFn) {
    await fetchChildrenFn(item.id, true);
    // Expand parent if not already expanded
    const onToggleExpand = getOnToggleExpand();
    if (onToggleExpand) {
      const expanded = getExpandedKeys();
      if (!expanded.includes(item.id)) {
        await onToggleExpand(item.id);
      }
    }
  }

  handleCloseAddModal();
};

// Handle save callback - refresh after editing
const handleEditSave = async (updatedVertex) => {
  const item = getItem();
  if (!item) return;

  handleCloseEditModal();

  // Update the item in the tree using the parent's update function
  // The updated vertex from server includes contentCount in P
  const onItemUpdate = getOnItemUpdate();
  if (onItemUpdate && updatedVertex) {
    onItemUpdate(updatedVertex);
  }

  // The parent update should handle this via updateItemInTree function
  // The graph will be updated with the new count from the server response
};

// Drag and drop handlers
const [isDragOver, setIsDragOver] = args.createSignal(false);
const [isDragging, setIsDragging] = args.createSignal(false);
const [isValidDrop, setIsValidDrop] = args.createSignal(true);
const [draggedCategoryId, setDraggedCategoryId] = args.createSignal(null);

// Helper function to check if a category is a descendant of another
// Relationship direction: child-[toParentEdgeType]->parent
// To check if targetId is a descendant of categoryId, we traverse from targetId to categoryId
const isDescendantOf = (targetId, categoryId) => {
  if (!targetId || !categoryId || targetId === categoryId) {
    return false;
  }
  
  const toParentEdgeType = getToParentEdgeType();
  if (!toParentEdgeType) return false;
  
  try {
    // Get target vertex from graph
    const targetVertex = args.graph?.vertexes?.[targetId];
    if (!targetVertex) return false;
    
    // Traverse up the parent chain to see if we reach categoryId
    // Use evalExpression to follow the toParentEdgeType relationship backwards
    // Since child-[toParentEdgeType]->parent, we use ->toParentEdgeType to go from child to parent
    const parent = args.evalExpression(
      `->${toParentEdgeType}`,
      { graph: args.graph, setGraph: args.setGraph, vertexes: [targetVertex] }
    );
    
    if (!parent || parent.length === 0) {
      // No parent, so not a descendant
      return false;
    }
    
    const parentId = parent[0]?.id;
    if (!parentId) return false;
    
    // If parent is the category we're checking against, target is a direct child
    if (parentId === categoryId) {
      return true;
    }
    
    // Recursively check if parent is a descendant
    return isDescendantOf(parentId, categoryId);
  } catch (error) {
    console.error("Error checking descendant:", error);
    return false;
  }
};

// Validate if a drop target is valid for the dragged category
const validateDropTarget = (categoryId, targetId) => {
  if (!categoryId || !targetId) {
    return { valid: false, reason: "Missing category or target ID" };
  }
  
  // Check 1: Cannot drop on itself
  if (categoryId === targetId) {
    return { valid: false, reason: "Cannot move a category to itself" };
  }
  
  const rootKeys = args.contextData.props?.sidebarConfig?.rootKeys || {};
  const rootKey = rootKeys.key;
  
  // Get the dragged item
  const draggedItem = args.graph?.vertexes?.[categoryId];
  if (!draggedItem) {
    return { valid: false, reason: "Dragged category not found" };
  }
  
  // Check 2: Cannot drag root items
  if (draggedItem.P?.key === rootKey || draggedItem.P?.key === 'uncategorized' || draggedItem.id === 'uncategorized') {
    return { valid: false, reason: "Root items cannot be moved" };
  }
  
  // Check 3: Cannot drop on a descendant
  if (isDescendantOf(targetId, categoryId)) {
    return { valid: false, reason: "Cannot move a category to its own descendant" };
  }
  
  return { valid: true };
};

// Handle drag start for sidebar items
const handleDragStartSidebar = (e) => {
  const item = getItem();
  if (!item) {
    e.preventDefault();
    return;
  }
  
  const rootKeys = args.contextData.props?.sidebarConfig?.rootKeys || {};
  const rootKey = rootKeys.key;
  
  // Prevent dragging root items
  if (item.P?.key === rootKey || item.P?.key === 'uncategorized') {
    e.preventDefault();
    return;
  }
  
  setIsDragging(true);
  setDraggedCategoryId(item.id);
  setIsValidDrop(true); // Reset validation state
  
  // Store sidebar item data
  e.dataTransfer.setData('application/json', JSON.stringify({
    type: 'sidebar-item',
    categoryId: item.id,
    categoryName: item.P?.name || item.P?.key || 'Category'
  }));
  e.dataTransfer.effectAllowed = 'move';
  
  // Create custom drag image
  const dragImage = document.createElement('div');
  dragImage.style.cssText = `
    padding: 8px 12px;
    background: ${args.theme?.var?.color?.primary || '#3b82f6'};
    color: ${args.theme?.var?.color?.primary_text || '#ffffff'};
    border-radius: 4px;
    font-size: 14px;
    font-weight: 500;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    pointer-events: none;
    position: absolute;
    top: -1000px;
    white-space: nowrap;
  `;
  dragImage.textContent = item.P?.name || item.P?.key || 'Category';
  document.body.appendChild(dragImage);
  e.dataTransfer.setDragImage(dragImage, 0, 0);
  setTimeout(() => document.body.removeChild(dragImage), 0);
};

const handleDragEnd = () => {
  setIsDragging(false);
  setIsDragOver(false);
  setIsValidDrop(true);
  setDraggedCategoryId(null);
};

const handleDragOver = (e) => {
  e.preventDefault();
  e.stopPropagation();
  
  // Check if this is a sidebar item drag
  const dataStr = e.dataTransfer.getData('application/json');
  let draggedCategoryId = null;
  
  try {
    if (dataStr) {
      const data = JSON.parse(dataStr);
      if (data.type === 'sidebar-item' && data.categoryId) {
        draggedCategoryId = data.categoryId;
      }
    }
  } catch (error) {
    // Not a JSON drag, might be table items - allow default behavior
  }
  
  // If dragging a sidebar item, validate the drop target
  if (draggedCategoryId) {
    const item = getItem();
    if (item) {
      const validation = validateDropTarget(draggedCategoryId, item.id);
      setIsValidDrop(validation.valid);
      
      if (validation.valid) {
        e.dataTransfer.dropEffect = 'move';
      } else {
        e.dataTransfer.dropEffect = 'none';
      }
    } else {
      setIsValidDrop(false);
      e.dataTransfer.dropEffect = 'none';
    }
  } else {
    // Table items or other drags - allow move
    e.dataTransfer.dropEffect = 'move';
    setIsValidDrop(true);
  }
  
  setIsDragOver(true);
};

const handleDragLeave = (e) => {
  e.preventDefault();
  e.stopPropagation();
  setIsDragOver(false);
};

// Handle moving sidebar item to new parent
const handleMoveSidebarItem = async (categoryId, newParentId) => {
  const parentVertexLabel = getParentVertexLabel();
  const toParentEdgeType = getToParentEdgeType();
  const rootKeys = args.contextData.props?.sidebarConfig?.rootKeys || {};
  const enableUserScoping = args.contextData.props?.enableUserScoping === true;
  const hooks = args.contextData.props?.hooks;
  
  const moveContextData = {
    categoryId,
    newParentId,
    parentVertexLabel,
    toParentEdgeType,
    rootKeys,
    enableUserScoping,
    hooks: hooks
  };
  
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "moveSidebarItem",
      contextData: moveContextData
    });

    if (result?.result?.success) {
      // Process graph data if available
      if (result.graph && result.graph.vertexes) {
        args.setGraphData(0, result.graph, {});
      }
      
      // Refresh children for both old and new parents
      const fetchChildrenFn = getFetchChildren();
      if (fetchChildrenFn) {
        // Refresh root items to update the tree structure
        const fetchRootFn = getFetchRoot();
        if (fetchRootFn) {
          await fetchRootFn();
        }
      }
      
      args.showSuccessToast?.(result.result.message || "Category moved successfully");
      return true;
    } else {
      args.showErrorToast?.(result?.result?.message || "Failed to move category");
      return false;
    }
  } catch (error) {
    console.error("Error moving sidebar item:", error);
    args.showErrorToast?.("Failed to move category");
    return false;
  }
};

const handleDrop = async (e) => {
  e.preventDefault();
  e.stopPropagation();
  setIsDragOver(false);
  
  try {
    const dataStr = e.dataTransfer.getData('application/json');
    if (!dataStr) return;
    
    const data = JSON.parse(dataStr);
    
    // Handle sidebar item drops
    if (data.type === 'sidebar-item' && data.categoryId) {
      const item = getItem();
      if (!item) return;
      
      // Re-validate before proceeding (defense in depth)
      const validation = validateDropTarget(data.categoryId, item.id);
      if (!validation.valid) {
        args.showWarningToast?.(validation.reason || "Cannot drop here");
        return;
      }
      
      const rootKeys = args.contextData.props?.sidebarConfig?.rootKeys || {};
      const rootKey = rootKeys.key;
      
      // Determine new parent ID
      // If target is root or uncategorized, set newParentId to null (make it a root item)
      const newParentId = (item.P?.key === rootKey || item.P?.key === 'uncategorized') ? null : item.id;
      
      // Move the sidebar item
      await handleMoveSidebarItem(data.categoryId, newParentId);
      return;
    }
    
    // Handle table item drops (existing functionality)
    if (data.type !== 'table-items' || !data.itemIds || !Array.isArray(data.itemIds)) {
      return;
    }
    
    const item = getItem();
    if (!item) return;
    
    const onMoveItemsToCategory = args.contextData.props?.onMoveItemsToCategory;
    if (!onMoveItemsToCategory) {
      args.showErrorToast?.("Move function not available");
      return;
    }
    
    const parentVertexLabel = getParentVertexLabel();
    const toParentEdgeType = getToParentEdgeType();
    const rootKeys = args.contextData.props?.sidebarConfig?.rootKeys || {};
    const rootKey = rootKeys.key;
    
    // Determine category ID - if 'uncategorized' or root key, use null
    const categoryId = (item.P?.key === rootKey || item.P?.key === 'uncategorized') ? null : item.id;
    
    // Prevent dropping into the same selected category
    const selectedSidebarItemFn = args.fns?.selectedSidebarItem;
    const currentSelected = typeof selectedSidebarItemFn === "function" ? selectedSidebarItemFn() : null;
    if (currentSelected) {
      const currentRootKey = currentSelected.P?.key;
      const isCurrentRootOrUncategorized =
        currentRootKey === rootKey || currentRootKey === "uncategorized";
      const isTargetRootOrUncategorized =
        item.P?.key === rootKey || item.P?.key === "uncategorized";
      
      // Same regular category
      const isSameCategory = currentSelected.id && item.id && currentSelected.id === item.id;
      
      // Both represent the "uncategorized" bucket
      const isSameUncategorized = isCurrentRootOrUncategorized && isTargetRootOrUncategorized;
      
      if (isSameCategory || isSameUncategorized) {
        args.showWarningToast?.("Items are already in this category");
        return;
      }
    }
    
    // Get sidebar config
    const sidebarConfig = {
      parentVertexLabel: parentVertexLabel,
      toParentEdgeType: toParentEdgeType,
      rootKeys: rootKeys
    };
    
    // Call move function from parent
    const result = await onMoveItemsToCategory(data.itemIds, categoryId, sidebarConfig);
    
    if (result?.success) {
      args.showSuccessToast?.(result.message || `Moved ${data.itemIds.length} item${data.itemIds.length !== 1 ? 's' : ''} successfully`);
      
      // Determine source category (where items were moved FROM)
      const sourceCategory = currentSelected;
      const isSourceUncategorized = sourceCategory && (
        sourceCategory.P?.key === rootKey || 
        sourceCategory.P?.key === 'uncategorized' ||
        sourceCategory.id === 'uncategorized'
      );
      const isTargetUncategorized = item.P?.key === rootKey || item.P?.key === 'uncategorized' || item.id === 'uncategorized';
      
      // Update content counts using mergeVertexProperties
      const updatedCounts = result.data?.updatedCounts;
      
      if (updatedCounts) {
        // Update target category count (if not uncategorized)
        if (updatedCounts.targetCategoryId && !isTargetUncategorized && item.id === updatedCounts.targetCategoryId) {
          args.mergeVertexProperties(0, item.id, args.graph, args.setGraph, {
            contentCount: updatedCounts.targetCount
          });
        }
        
        // Update source category count (if not uncategorized)
        if (updatedCounts.sourceCategoryId && !isSourceUncategorized && currentSelected && currentSelected.id === updatedCounts.sourceCategoryId) {
          args.mergeVertexProperties(0, currentSelected.id, args.graph, args.setGraph, {
            contentCount: updatedCounts.sourceCount
          });
        }
        
        // For uncategorized target, update the uncategorized vertex directly if it exists
        if (isTargetUncategorized && updatedCounts.targetCategoryId === 'uncategorized' && updatedCounts.targetCount !== undefined) {
          // Try to find and update the uncategorized vertex in the graph
          const uncategorizedVertex = args.graph?.vertexes?.['uncategorized'];
          if (uncategorizedVertex) {
            args.mergeVertexProperties(0, 'uncategorized', args.graph, args.setGraph, {
              contentCount: updatedCounts.targetCount
            });
          } else {
            // If uncategorized vertex doesn't exist in graph, refresh root items
            const fetchRootFn = getFetchRoot();
            if (fetchRootFn) {
              await fetchRootFn();
            }
          }
        }
        
        // For uncategorized source, update the uncategorized vertex directly if it exists
        if (isSourceUncategorized && updatedCounts.sourceCategoryId === 'uncategorized' && updatedCounts.sourceCount !== undefined) {
          // Try to find and update the uncategorized vertex in the graph
          const uncategorizedVertex = args.graph?.vertexes?.['uncategorized'];
          if (uncategorizedVertex) {
            args.mergeVertexProperties(0, 'uncategorized', args.graph, args.setGraph, {
              contentCount: updatedCounts.sourceCount
            });
          } else {
            // If uncategorized vertex doesn't exist in graph, refresh root items
            const fetchRootFn = getFetchRoot();
            if (fetchRootFn) {
              await fetchRootFn();
            }
          }
        }
      }
      
      // Always refresh root items if moving to/from uncategorized (as fallback)
      // This ensures the uncategorized count is updated even if updatedCounts is missing
      if (isSourceUncategorized || isTargetUncategorized) {
        const fetchRootFn = getFetchRoot();
        if (fetchRootFn) {
          await fetchRootFn();
        }
      }
      
      // Refresh table data for currently selected sidebar item
      if (sourceCategory && args.contextData.props?.onItemSelect) {
        const onItemSelect = getOnItemSelect();
        if (onItemSelect) {
          // Re-select the current item to trigger table refresh
          onItemSelect({...sourceCategory});
        }
      }
    } else {
      args.showErrorToast?.(result?.message || "Failed to move items");
    }
  } catch (error) {
    console.error("Error handling drop:", error);
    args.showErrorToast?.("Failed to move items");
  }
};

// Handle delete
const handleDelete = async (e) => {
  e.stopPropagation();
  const item = getItem();
  if (!item) return;

  const parentVertexLabel = getParentVertexLabel();
  const toParentEdgeType = getToParentEdgeType();
  const rootKeys = args.contextData.props?.sidebarConfig?.rootKeys || {};
  const rootKey = rootKeys.key;

  // Prevent deletion of root item
  if (item.P?.key === rootKey) {
    args.showErrorToast?.("Root item cannot be deleted");
    return;
  }

  // Confirm deletion using rbConfirm
  const rbConfirm = args.fns?.rbConfirm;
  if (!rbConfirm) {
    args.showErrorToast?.("Delete confirmation not available");
    return;
  }

  const confirmed = await rbConfirm({
    title: "Delete Item",
    message: `Are you sure you want to delete "${item.P?.name || item.P?.key || 'this item'}"? This action cannot be undone.`,
    confirmText: "Delete",
    cancelText: "Cancel",
    variant: "danger"
  });

  if (!confirmed) {
    return;
  }

  // Delete the vertex
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "saveSidebarVertex",
      contextData: {
        vertexId: item.id,
        name: item.P?.name || "",
        key: item.P?.key || "",
        parentId: null,
        parentVertexLabel: parentVertexLabel,
        toParentEdgeType: toParentEdgeType,
        rootKeys: rootKeys,
        properties: item.P || {},
        operation: "delete",
          tableVertexLabel: args.contextData.props?.tableVertexLabel,
          relationshipType: args.contextData.props?.relationshipType,
          enableUserScoping: args.contextData.props?.enableUserScoping
        }
      });

    if (result?.result?.success) {
      args.showSuccessToast?.("Item deleted successfully");
      
      // Get vertex from graph to collect all connected edges
      const vertex = args.graph.vertexes[item.id];
      const edgeIdsToDelete = [];
      
      if (vertex) {
        // Collect all outgoing edge IDs
        if (vertex.OUT) {
          for (const edgeType in vertex.OUT) {
            const edgeIds = vertex.OUT[edgeType] || [];
            edgeIdsToDelete.push(...edgeIds);
          }
        }
        
        // Collect all incoming edge IDs
        if (vertex.IN) {
          for (const edgeType in vertex.IN) {
            const edgeIds = vertex.IN[edgeType] || [];
            edgeIdsToDelete.push(...edgeIds);
          }
        }
      }
      
      // Delete all edges before calling setGraphData
      for (const edgeId of edgeIdsToDelete) {
        args.deleteEdge(0, edgeId, args.graph, args.setGraph);
      }
      
      // Use setGraphData to handle vertex deletion from graph
      if (result.graph) {
        const graphData = {
          vertexes: result.graph.vertexes || {},
          edges: {},
          deleted_vertexes: result.result.deleted_vertexes || [item.id],
          deleted_edges: []
        };
        args.setGraphData(0, graphData, {});
      }
      
      // Notify parent to remove item from tree
      const onItemDelete = getOnItemDelete();
      if (onItemDelete) {
        onItemDelete(item.id);
      }
    } else {
      args.showErrorToast?.(result?.result?.message || result?.error || "Failed to delete item");
    }
  } catch (error) {
    console.error("Error deleting item:", error);
    args.showErrorToast?.("Failed to delete item");
  }
};

return {
  getItem,
  getExpandedKeys,
  getSelectedItem,
  getOnToggleExpand,
  getOnItemSelect,
  getFetchChildren,
  isExpanded,
  isSelected,
  getChildren,
