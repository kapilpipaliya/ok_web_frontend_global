{
  vertexes: [
    {
      id: "1"
      L: Component
      P: {
        fns:
          '''
// Get props from context
const getItem = () => args.contextData.props?.item;
const getExpandedKeys = () => args.contextData.props?.expandedKeys || [];
const getSelectedItem = () => args.contextData.props?.selectedItem;
const getOnToggleExpand = () => args.contextData.props?.onToggleExpand;
const getOnItemSelect = () => args.contextData.props?.onItemSelect;
const getFetchChildren = () => args.contextData.props?.fetchChildren;
const getParentVertexLabel = () => args.contextData.props?.parentVertexLabel;
const getToParentEdgeType = () => args.contextData.props?.toParentEdgeType;

// Get children and loading from props (from graph)
const getChildren = () => {
  return args.contextData.props?.childItems || [];
};

const getLoading = () => {
  return args.contextData.props?.loading || false;
};

// Check if item is expanded - make it reactive by accessing the signal
const isExpanded = () => {
  const item = getItem();
  if (!item) return false;
  // Access expandedKeys as a signal to make it reactive
  const expandedKeys = getExpandedKeys();
  return Array.isArray(expandedKeys) && expandedKeys.includes(item.id);
};

// Check if item is selected
const isSelected = () => {
  const item = getItem();
  const selectedItem = getSelectedItem();
  if (!item || !selectedItem) return false;
  return item.id === selectedItem.id;
};

// Refresh children function - calls parent's fetchChildren
const refreshChildren = async () => {
  const item = getItem();
  if (!item) return;

  const fetchChildrenFn = getFetchChildren();
  if (fetchChildrenFn) {
    await fetchChildrenFn(item.id, true);
  }
};

// Fetch children on mount if expanded
const fetchChildrenIfNeeded = async () => {
  const item = getItem();
  if (!item) return;

  const expanded = isExpanded();
  if (!expanded) return;
  
  const childrenList = getChildren();
  
  // Always fetch children when expanded if we don't have them loaded yet
  // This ensures nested children are fetched from the server
  if (childrenList.length === 0) {
    const fetchChildrenFn = getFetchChildren();
    if (fetchChildrenFn) {
      await fetchChildrenFn(item.id);
    }
  }
};

// Handle expand toggle
const handleToggleExpand = async () => {
  const item = getItem();
  if (!item) return;

  const onToggleExpand = getOnToggleExpand();
  if (onToggleExpand) {
    const wasExpanded = isExpanded();
    await onToggleExpand(item.id);
    // Always fetch children when expanding (even if we think we have them)
    // This ensures nested children are properly fetched from the server
    if (!wasExpanded) {
      // Fetch children from server to ensure they're in the graph
      const fetchChildrenFn = getFetchChildren();
      if (fetchChildrenFn) {
        await fetchChildrenFn(item.id);
      }
    }
  }
};

// Handle item click
const handleItemClick = () => {
  const item = getItem();
  const onItemSelect = getOnItemSelect();
  if (item && onItemSelect) {
    onItemSelect(item);
  }
};

// Get item display name (with content count)
const getItemName = () => {
  const item = getItem();
  if (!item) return "";

  const baseName = item.P?.key || item.P?.name || item.P?.title || "No name";

  // Use content count from vertex P property
  const contentCount = item.P?.contentCount ?? 0;
  if (contentCount > 0) {
    return `${baseName} (${contentCount})`;
  }

  return baseName;
};

// Get item icon
const getItemIcon = () => {
  const item = getItem();
  if (!item) return "ph:circle";
  return item.P?.icon || "ph:circle";
};

// Check if item has children
// Show expand button if we have children loaded or if relationships indicate children exist
const hasChildren = () => {
  const item = getItem();
  if (!item) return false;
  
  // Check if we have children in graph
  const childrenList = getChildren();
  if (childrenList.length > 0) {
    return true;
  }
  
  // If no children in graph, check if the vertex has IN relationships indicating it has children
  // Relationship direction: child-[toParentEdgeType]->parent
  // So parent has IN relationships from children (children point to parent)
  // When processResult processes relationships, it sets up parent.IN[toParentEdgeType]
  const toParentEdgeType = getToParentEdgeType();
  if (toParentEdgeType && item.IN && item.IN[toParentEdgeType] && item.IN[toParentEdgeType].length > 0) {
    return true;
  }
  
  // For nested items that haven't been fetched yet, we don't know if they have children
  // But we should allow expansion to check - show expand button if item might have children
  // This allows nested items to be expanded to fetch and check for children
  // The expand button will be hidden if no children are found after fetching
  return true;
};

// Modal state
const [isAddModalOpen, setIsAddModalOpen] = args.createSignal(false);
const [isEditModalOpen, setIsEditModalOpen] = args.createSignal(false);

// Get formConfig from props
const getFormConfig = () => args.contextData.props?.formConfig;

// Get onItemUpdate callback from props
const getOnItemUpdate = () => args.contextData.props?.onItemUpdate;

// Get onItemDelete callback from props
const getOnItemDelete = () => args.contextData.props?.onItemDelete;


// Handle opening add modal
const handleOpenAddModal = (e) => {
  e.stopPropagation();
  setIsAddModalOpen(true);
};

// Handle closing add modal
const handleCloseAddModal = () => {
  setIsAddModalOpen(false);
};

// Handle opening edit modal
const handleOpenEditModal = (e) => {
  e.stopPropagation();
  setIsEditModalOpen(true);
};

// Handle closing edit modal
const handleCloseEditModal = () => {
  setIsEditModalOpen(false);
};

// Handle save callback - refresh children after adding
const handleAddChildSave = async (newVertex) => {
  const item = getItem();
  if (!item) return;

  // Refresh children - force refresh to get latest data
  const fetchChildrenFn = getFetchChildren();
  if (fetchChildrenFn) {
    await fetchChildrenFn(item.id, true);
    // Expand parent if not already expanded
    const onToggleExpand = getOnToggleExpand();
    if (onToggleExpand) {
      const expanded = getExpandedKeys();
      if (!expanded.includes(item.id)) {
        await onToggleExpand(item.id);
      }
    }
  }

  handleCloseAddModal();
};

// Handle save callback - refresh after editing
const handleEditSave = async (updatedVertex) => {
  const item = getItem();
  if (!item) return;

  handleCloseEditModal();

  // Update the item in the tree using the parent's update function
  // The updated vertex from server includes contentCount in P
  const onItemUpdate = getOnItemUpdate();
  if (onItemUpdate && updatedVertex) {
    onItemUpdate(updatedVertex);
  }

  // The parent update should handle this via updateItemInTree function
  // The graph will be updated with the new count from the server response
};

// Drag and drop handlers
const [isDragOver, setIsDragOver] = args.createSignal(false);

const handleDragOver = (e) => {
  e.preventDefault();
  e.stopPropagation();
  e.dataTransfer.dropEffect = 'move';
  setIsDragOver(true);
};

const handleDragLeave = (e) => {
  e.preventDefault();
  e.stopPropagation();
  setIsDragOver(false);
};

const handleDrop = async (e) => {
  e.preventDefault();
  e.stopPropagation();
  setIsDragOver(false);
  
  try {
    const dataStr = e.dataTransfer.getData('application/json');
    if (!dataStr) return;
    
    const data = JSON.parse(dataStr);
    if (data.type !== 'table-items' || !data.itemIds || !Array.isArray(data.itemIds)) {
      return;
    }
    
    const item = getItem();
    if (!item) return;
    
    const onMoveItemsToCategory = args.contextData.props?.onMoveItemsToCategory;
    if (!onMoveItemsToCategory) {
      args.showErrorToast?.("Move function not available");
      return;
    }
    
    const parentVertexLabel = getParentVertexLabel();
    const toParentEdgeType = getToParentEdgeType();
    const rootKeys = args.contextData.props?.rootKeys || {};
    const rootKey = rootKeys.key || 'root';
    
    // Determine category ID - if 'uncategorized' or root key, use null
    const categoryId = (item.P?.key === rootKey || item.P?.key === 'uncategorized') ? null : item.id;
    
    // Prevent dropping into the same selected category
    const selectedSidebarItemFn = args.fns?.selectedSidebarItem;
    const currentSelected = typeof selectedSidebarItemFn === "function" ? selectedSidebarItemFn() : null;
    if (currentSelected) {
      const currentRootKey = currentSelected.P?.key;
      const isCurrentRootOrUncategorized =
        currentRootKey === rootKey || currentRootKey === "uncategorized";
      const isTargetRootOrUncategorized =
        item.P?.key === rootKey || item.P?.key === "uncategorized";
      
      // Same regular category
      const isSameCategory = currentSelected.id && item.id && currentSelected.id === item.id;
      
      // Both represent the "uncategorized" bucket
      const isSameUncategorized = isCurrentRootOrUncategorized && isTargetRootOrUncategorized;
      
      if (isSameCategory || isSameUncategorized) {
        args.showWarningToast?.("Items are already in this category");
        return;
      }
    }
    
    // Get sidebar config
    const sidebarConfig = {
      parentVertexLabel: parentVertexLabel,
      toParentEdgeType: toParentEdgeType,
      rootKeys: rootKeys
    };
    
    // Call move function from parent
    const result = await onMoveItemsToCategory(data.itemIds, categoryId, sidebarConfig);
    
    if (result?.success) {
      args.showSuccessToast?.(result.message || `Moved ${data.itemIds.length} item${data.itemIds.length !== 1 ? 's' : ''} successfully`);
      
      // Refresh children to update counts
      const fetchChildrenFn = getFetchChildren();
      if (fetchChildrenFn) {
        await fetchChildrenFn(item.id, true);
      }
      
      // Refresh parent's children if this is a child item
      const parentItem = args.evalExpression?.(`<-${toParentEdgeType}`, {
        graph: args.graph,
        setGraph: args.setGraph,
        vertexes: [item]
      })?.[0];
      
      if (parentItem) {
        const parentFetchChildrenFn = getFetchChildren();
        if (parentFetchChildrenFn) {
          await parentFetchChildrenFn(parentItem.id, true);
        }
      }
      
      // Trigger table refresh by calling parent's refresh if available
      if (args.contextData.props?.onItemSelect) {
        // Re-select current item to trigger table refresh
        const onItemSelect = getOnItemSelect();
        if (onItemSelect) {
          onItemSelect(item);
        }
      }
    } else {
      args.showErrorToast?.(result?.message || "Failed to move items");
    }
  } catch (error) {
    console.error("Error handling drop:", error);
    args.showErrorToast?.("Failed to move items");
  }
};

// Handle delete
const handleDelete = async (e) => {
  e.stopPropagation();
  const item = getItem();
  if (!item) return;

  const parentVertexLabel = getParentVertexLabel();
  const toParentEdgeType = getToParentEdgeType();
  const rootKeys = args.contextData.props?.rootKeys || {};
  const rootKey = rootKeys.key || 'root';

  // Prevent deletion of root item
  if (item.P?.key === rootKey) {
    args.showErrorToast?.("Root item cannot be deleted");
    return;
  }

  // Confirm deletion using rbConfirm
  const rbConfirm = args.fns?.rbConfirm;
  if (!rbConfirm) {
    args.showErrorToast?.("Delete confirmation not available");
    return;
  }

  const confirmed = await rbConfirm({
    title: "Delete Item",
    message: `Are you sure you want to delete "${item.P?.name || item.P?.key || 'this item'}"? This action cannot be undone.`,
    confirmText: "Delete",
    cancelText: "Cancel",
    variant: "danger"
  });

  if (!confirmed) {
    return;
  }

  // Delete the vertex
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "saveSidebarVertex",
      contextData: {
        vertexId: item.id,
        name: item.P?.name || "",
        key: item.P?.key || "",
        parentId: null,
        parentVertexLabel: parentVertexLabel,
        toParentEdgeType: toParentEdgeType,
        rootKeys: rootKeys,
        properties: item.P || {},
        operation: "delete",
          tableVertexLabel: args.contextData.props?.tableVertexLabel,
          relationshipType: args.contextData.props?.relationshipType,
          enableUserScoping: args.contextData.props?.enableUserScoping
        }
      });

    if (result?.result?.success) {
      args.showSuccessToast?.("Item deleted successfully");
      
      // Get vertex from graph to collect all connected edges
      const vertex = args.graph.vertexes[item.id];
      const edgeIdsToDelete = [];
      
      if (vertex) {
        // Collect all outgoing edge IDs
        if (vertex.OUT) {
          for (const edgeType in vertex.OUT) {
            const edgeIds = vertex.OUT[edgeType] || [];
            edgeIdsToDelete.push(...edgeIds);
          }
        }
        
        // Collect all incoming edge IDs
        if (vertex.IN) {
          for (const edgeType in vertex.IN) {
            const edgeIds = vertex.IN[edgeType] || [];
            edgeIdsToDelete.push(...edgeIds);
          }
        }
      }
      
      // Delete all edges before calling setGraphData
      for (const edgeId of edgeIdsToDelete) {
        args.deleteEdge(0, edgeId, args.graph, args.setGraph);
      }
      
      // Use setGraphData to handle vertex deletion from graph
      if (result.graph) {
        const graphData = {
          vertexes: result.graph.vertexes || {},
          edges: {},
          deleted_vertexes: result.result.deleted_vertexes || [item.id],
          deleted_edges: []
        };
        args.setGraphData(0, graphData, {});
      }
      
      // Notify parent to remove item from tree
      const onItemDelete = getOnItemDelete();
      if (onItemDelete) {
        onItemDelete(item.id);
      }
    } else {
      args.showErrorToast?.(result?.result?.message || result?.error || "Failed to delete item");
    }
  } catch (error) {
    console.error("Error deleting item:", error);
    args.showErrorToast?.("Failed to delete item");
  }
};

return {
  getItem,
  getExpandedKeys,
  getSelectedItem,
  getOnToggleExpand,
  getOnItemSelect,
  getFetchChildren,
  isExpanded,
  isSelected,
  getChildren,
  getLoading,
  fetchChildrenIfNeeded,
  handleToggleExpand,
  handleItemClick,
  getItemName,
  getItemIcon,
  hasChildren,
  isAddModalOpen,
  setIsAddModalOpen,
  handleOpenAddModal,
  handleCloseAddModal,
  handleAddChildSave,
  isEditModalOpen,
  setIsEditModalOpen,
  handleOpenEditModal,
  handleCloseEditModal,
  handleEditSave,
  getFormConfig,
  getOnItemUpdate,
  handleDelete,
  getOnItemDelete,
  refreshChildren,
  isDragOver,
  setIsDragOver,
  handleDragOver,
  handleDragLeave,
  handleDrop
};
'''
        key: SidebarTreeItem
        props: ""
      }
    }
