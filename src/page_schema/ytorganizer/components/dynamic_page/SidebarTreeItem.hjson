// Watch for expansion changes and fetch children when expanded
// Access expandedKeys prop directly to make it reactive
args.createEffect(() => {
  const item = args.fns.getItem();
  if (!item) return;

  // Access expandedKeys prop to make effect reactive to prop changes
  const expandedKeys = args.contextData.props?.expandedKeys || [];
  const isExpanded = Array.isArray(expandedKeys) && expandedKeys.includes(item.id);

  const childrenList = args.fns.getChildren();

  // If expanded and we haven't fetched children yet, fetch them
  if (isExpanded && childrenList.length === 0) {
    args.fns.fetchChildrenIfNeeded();
  }
});


return {
  as: "div",
  class: args.contextData.props.class,
};
'''
      }
    }
