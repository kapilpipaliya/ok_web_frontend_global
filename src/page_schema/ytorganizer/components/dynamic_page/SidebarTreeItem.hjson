const sidebarConfig = args.contextData.props?.sidebarConfig;
const tableVertexLabel = args.contextData.props?.tableVertexLabel;
const relationshipType = args.contextData.props?.relationshipType;

// For edit mode, we don't need parentId since we're just updating the vertex
// The parent relationship should remain unchanged unless explicitly changed
return {
  isOpen: args.fns.isEditModalOpen(),
  sidebarConfig: sidebarConfig,
  label: args.contextData.props?.label,
  hooks: args.contextData.props?.hooks,
  vertexId: item?.id,
  parentId: null, // Don't change parent on edit
  tableVertexLabel: tableVertexLabel,
  relationshipType: relationshipType,
  initialVertex: item,
  mode: "edit",
  onSave: args.fns.handleEditSave,
  onClose: args.fns.handleCloseEditModal
};
