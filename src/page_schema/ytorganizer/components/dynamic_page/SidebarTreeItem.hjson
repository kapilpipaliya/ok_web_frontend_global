return `._id {
  align-items: center;
  cursor: pointer;
  display: flex;
  gap: 0.375rem;
  font-size: 14px;
  font-weight: ${args.fns.hasChildren() ? "bold" : "normal"};
  width: 100%;
  border-radius: ${args.fns.hasChildren() ? "5px" : "0 5px 5px 0"};
  ${isHovered ? `background-color: ${args.theme.var.color.background_dark_150};` : ""}
  ${isDragOver ? `background-color: ${args.theme.var.color.primary_light_200}; border: 2px dashed ${args.theme.var.color.primary};` : ""}
  padding: 2px 0;
  transition: all 0.15s ease-in-out;
  ${args.fns.hasChildren() ? "" : `border-left: 1px dashed ${args.theme.var.color.border};`}
}`;
'''
