        displayOrder: 2
        componentName: FormManagement
        props:
          '''
const sidebarConfig = args.contextData.props?.sidebarConfig || {};
const formConfig = sidebarConfig?.formConfig;
const parentId = args.contextData.props?.parentId;
const vertexId = args.contextData.props?.vertexId;
const initialVertex = args.contextData.props?.initialVertex;
const mode = args.contextData.props?.mode || "add";
const parentVertexLabel = sidebarConfig?.parentVertexLabel;
const toParentEdgeType = sidebarConfig?.toParentEdgeType;
const rootKeys = sidebarConfig?.rootKeys || {};
const tableVertexLabel = args.contextData.props?.tableVertexLabel;
const relationshipType = args.contextData.props?.relationshipType;
const onSave = args.contextData.props?.onSave;
const onClose = args.contextData.props?.onClose;

// Wrap onSave to track txnId, handle cleanup, and call saveSidebarVertex
const wrappedOnSave = async (saveData) => {
  // Get txnId from FormManagement (will be set via onFnsReady)
  const txnId = args.fns?.formTxnId?.();
  if (txnId && txnId > 0) {
    args.fns.setFormTxnId(txnId);
  }

  // Extract vertex and properties from saveData
  const vertex = saveData.vertex;
  if (!vertex) {
    args.showErrorToast?.("No vertex data to save");
    return;
  }

  // Get name and key from vertex properties
  const name = vertex.P?.name || vertex.P?.title || "";
  const key = vertex.P?.key || "";

  if (!name || !name.trim()) {
    args.showErrorToast?.("Name is required");
    return;
  }

  // Call saveSidebarVertex function
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "saveSidebarVertex",
      contextData: {
        vertexId: vertexId || null,
        name: name.trim(),
        key: key || name.trim().toLowerCase().replace(/\s+/g, '_').replace(/[^a-z0-9_]/g, ''),
        parentId: parentId,
        parentVertexLabel: parentVertexLabel,
        toParentEdgeType: toParentEdgeType,
        rootKeys: rootKeys,
        properties: vertex.P,
        tableVertexLabel: tableVertexLabel,
        relationshipType: relationshipType,
        enableUserScoping: args.contextData.props?.enableUserScoping,
        hooks: args.contextData.props?.hooks
      }
    });

    if (result?.result?.success) {
      args.showSuccessToast?.(result.result.message || "Vertex created successfully");
      // Cleanup transaction after successful save
      args.fns.cleanup();
      // Call original onSave if provided
      if (onSave) {
        await onSave(result.result.data);
      }
      // Close modal
      if (onClose) {
        onClose();
      }
    } else {
      args.showErrorToast?.(result?.result?.message || result?.error || "Failed to create vertex");
    }
  } catch (error) {
    console.error("Error saving vertex:", error);
    args.showErrorToast?.("Failed to create vertex");
  }
};

// Wrap onClose to cleanup transaction
const wrappedOnClose = () => {
  args.fns.cleanup();
  if (onClose) {
    onClose();
  }
};

return {
  formConfig: formConfig,
  initialVertex: initialVertex || null,
  mode: mode,
  vertexLabel: null,
  onSave: wrappedOnSave,
  onClose: wrappedOnClose
};
'''
