        displayOrder: 1
        componentName: Html
        props:
          '''
const mode = args.contextData.props?.mode || "add";
const parentId = args.contextData.props?.parentId;
const label = args.contextData.props?.label || "Item";

let title;
if (mode === "add") {
  title = parentId === null || parentId === undefined ? `Add Root ${label}` : `Add New Child ${label}`;
} else {
  title = `Edit ${label}`;
}

return {
  as: "div",
  text: title
};
'''
