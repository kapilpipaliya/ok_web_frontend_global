{
  vertexes: [
    {
      id: "yto_playlist_card_component",
      L: "Component",
      P: {
        key: "YTOPlaylistCard"
      }
    },
    {
      id: "yto_playlist_card_variant_playlist",
      L: "ComponentVariant",
      P: {
        key: "playlist",
        type: "object",
        defValue: null
      }
    },
    {
      id: "yto_playlist_card_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const playlist = args.contextData.props?.playlist;

// Default click handler navigates to playlist detail with query parameters
const defaultOnClick = () => {
  if (playlist?.playlistId) {
    const params = new URLSearchParams({
      playlistId: playlist.playlistId,
    });
    args.navigate(`/playlist?${params.toString()}`);
  }
};

return {
  as: "div",
  onClick: defaultOnClick
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.surface};
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 1rem;
  padding: 1rem;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  height: 100%;
  
  &:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    border-color: ${args.theme.var.color.success_light_300};
  }
  
  &:active {
    transform: translateY(0);
  }
  
  @media (max-width: 768px) {
    padding: 0.875rem;
    gap: 0.625rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_playlist_card_thumbnail_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  position: relative;
  width: 100%;
  aspect-ratio: 16/9;
  border-radius: 0.75rem;
  overflow: hidden;
  background: ${args.theme.var.color.videoBackground};
  display: flex;
  align-items: center;
  justify-content: center;
}`;
'''
      }
    },
    {
      id: "yto_playlist_card_thumbnail",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const playlist = args.contextData.props?.playlist;

const thumbnailUrl = playlist?.thumbnail || '';

if (thumbnailUrl) {
  return {
    as: "img",
    src: thumbnailUrl,
    alt: playlist?.title || 'Playlist thumbnail'
  };
} else {
  return {
    as: "div"
  };
}
''',
        css: '''
const playlist = args.contextData.props?.playlist;
const thumbnailUrl = playlist?.thumbnail || '';

if (thumbnailUrl) {
  return `._id {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }`;
} else {
  return `._id {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: ${args.theme.var.color.success_light_100};
    color: ${args.theme.var.color.success};
  }`;
}
'''
      }
    },
    {
      id: "yto_playlist_card_placeholder_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const playlist = args.contextData.props?.playlist;
const thumbnailUrl = playlist?.thumbnail || '';

if (!thumbnailUrl) {
  return {
    as: "icon",
    icon: "carbon:playlist",
    width: 48,
    height: 48
  };
} else {
  return { as: "div", style: "display: none;" };
}
''',
        css: '''
return `._id {
  opacity: 0.7;
  
  @media (max-width: 768px) {
    width: 40px !important;
    height: 40px !important;
  }
}`;
'''
      }
    },
    {
      id: "yto_playlist_card_video_count",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const playlist = args.contextData.props?.playlist;
const videoCount = playlist?.itemCount || 0;

return {
  as: "div",
  text: `${videoCount} videos`
};
''',
        css: '''
return `._id {
  position: absolute;
  bottom: 0.5rem;
  right: 0.5rem;
  background: rgba(0,0,0,0.8);
  color: white;
  padding: 0.25rem 0.5rem;
  border-radius: 0.25rem;
  font-size: 0.75rem;
  font-weight: 500;
  backdrop-filter: blur(4px);
  
  @media (max-width: 768px) {
    bottom: 0.375rem;
    right: 0.375rem;
    font-size: 0.6875rem;
    padding: 0.1875rem 0.375rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_playlist_card_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}`;
'''
      }
    },
    {
      id: "yto_playlist_card_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const playlist = args.contextData.props?.playlist;
const title = playlist?.title || 'Untitled Playlist';

return {
  as: "h3",
  text: title
};
''',
        css: '''
return `._id {
  font-size: 1rem;
  font-weight: 600;
  margin: 0;
  color: ${args.theme.var.color.text};
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  
  @media (max-width: 768px) {
    font-size: 0.875rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_playlist_card_description",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const playlist = args.contextData.props?.playlist;
const description = playlist?.description || '';

if (description) {
  return {
    as: "p",
    text: description
  };
} else {
  return { as: "div", style: "display: none;" };
}
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  color: ${args.theme.var.color.muted};
  margin: 0;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  
  @media (max-width: 768px) {
    font-size: 0.75rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_playlist_card_meta",
      L: "Attr",
      P: {
