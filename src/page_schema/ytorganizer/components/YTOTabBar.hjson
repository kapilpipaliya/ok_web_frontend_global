{
  vertexes: [
    {
      id: "yto_tab_bar_component",
      L: "Component",
      P: {
        key: "YTOTabBar"
      }
    },
    {
      id: "yto_tab_bar_variant_tabs",
      L: "ComponentVariant",
      P: {
        key: "tabs",
        type: "array",
        defValue: []
      }
    },
    {
      id: "yto_tab_bar_variant_active_tab",
      L: "ComponentVariant",
      P: {
        key: "activeTab",
        type: "string",
        defValue: ""
      }
    },
    {
      id: "yto_tab_bar_variant_on_tab_change",
      L: "ComponentVariant",
      P: {
        key: "onTabChange",
        type: "function",
        defValue: null
      }
    },
    {
      id: "yto_tab_bar_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.surface};
  border-bottom: 1px solid ${args.theme.var.color.border};
  padding: 0 1.5rem;
  
  @media (max-width: 768px) {
    padding: 0 1rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_tab_bar_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
  
  &::-webkit-scrollbar {
    display: none;
  }
}`;
'''
      }
    },
    {
      id: "yto_tab_bar_tabs_data",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "tabItems",
        loop: true,
        props: '''
const tabs = args.contextData.props?.tabs || [];
const activeTab = args.contextData.props?.activeTab || '';
const onTabChange = args.contextData.props?.onTabChange;

// Create store for active tab state
const [activeTabState, setActiveTabState] = args.createSignal(activeTab);

return {
  data: tabs.map(tab => ({
    ...tab,
    isActive: tab.id === activeTabState(),
    onClick: () => {
      setActiveTabState(tab.id);
      if (onTabChange) {
        onTabChange(tab.id);
      }
    }
  }))
};
'''
      }
    },
    {
      id: "yto_tab_bar_tab_item",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const tabData = args.contextData.tabItems;

return {
  as: "button",
  onClick: tabData.onClick
};
''',
        css: '''
const tabData = args.contextData.tabItems;
const isActive = tabData.isActive;

return `._id {
  background: transparent;
  border: none;
  padding: 1rem 1.5rem;
  font-family: inherit;
  font-size: 0.875rem;
  font-weight: 500;
  color: ${isActive ? args.theme.var.color.primary : args.theme.var.color.muted};
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  white-space: nowrap;
  position: relative;
  border-bottom: 2px solid ${isActive ? args.theme.var.color.primary : 'transparent'};
  
  &:hover {
    color: ${args.theme.var.color.primary};
    background: ${args.theme.var.color.primary_light_100};
  }
  
  &:focus {
    outline: 2px solid ${args.theme.var.color.primary};
    outline-offset: 2px;
  }
  
  @media (max-width: 768px) {
    padding: 0.875rem 1rem;
    font-size: 0.75rem;
    gap: 0.375rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_tab_bar_tab_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const tabData = args.contextData.tabItems;
const icon = tabData.icon;

if (icon) {
  return {
    as: "icon",
    icon: icon,
    width: 18,
    height: 18
  };
} else {
  return { as: "div", style: "display: none;" };
}
''',
        css: '''
return `._id {
  @media (max-width: 768px) {
    width: 16px !important;
    height: 16px !important;
  }
}`;
'''
      }
    },
    {
      id: "yto_tab_bar_tab_label",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const tabData = args.contextData.tabItems;
const label = tabData.label || '';

return {
  as: "span",
  text: label
};
'''
      }
    },
    {
      id: "yto_tab_bar_tab_badge",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const tabData = args.contextData.tabItems;
const badge = tabData.badge;

if (badge && badge > 0) {
  return {
    as: "span",
    text: badge > 99 ? '99+' : badge.toString()
  };
} else {
  return { as: "div", style: "display: none;" };
}
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  font-size: 0.6875rem;
  font-weight: 600;
  padding: 0.125rem 0.375rem;
  border-radius: 0.75rem;
  min-width: 1.25rem;
  height: 1.25rem;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 0.25rem;
  
  @media (max-width: 768px) {
    font-size: 0.625rem;
    padding: 0.1rem 0.3rem;
    min-width: 1.125rem;
    height: 1.125rem;
  }
}`;
'''
      }
    }
  ],
  edges: [
    { id: "e1", T: "ComponentVariant", S: "yto_tab_bar_component", E: "yto_tab_bar_variant_tabs" },
    { id: "e2", T: "ComponentVariant", S: "yto_tab_bar_component", E: "yto_tab_bar_variant_active_tab" },
    { id: "e3", T: "ComponentVariant", S: "yto_tab_bar_component", E: "yto_tab_bar_variant_on_tab_change" },
    { id: "e4", T: "Attr", S: "yto_tab_bar_component", E: "yto_tab_bar_root" },
    { id: "e5", T: "Attr", S: "yto_tab_bar_root", E: "yto_tab_bar_container" },
    { id: "e6", T: "Attr", S: "yto_tab_bar_container", E: "yto_tab_bar_tabs_data" },
    { id: "e7", T: "Attr", S: "yto_tab_bar_tabs_data", E: "yto_tab_bar_tab_item" },
    { id: "e8", T: "Attr", S: "yto_tab_bar_tab_item", E: "yto_tab_bar_tab_icon" },
    { id: "e9", T: "Attr", S: "yto_tab_bar_tab_item", E: "yto_tab_bar_tab_label" },
    { id: "e10", T: "Attr", S: "yto_tab_bar_tab_item", E: "yto_tab_bar_tab_badge" }
  ]
}