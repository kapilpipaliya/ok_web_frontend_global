{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "YTOAddVideosModal"
      }
    },
    {
      id: "variant_is_open",
      L: "ComponentVariant",
      P: {
        key: "isOpen",
        type: "function",
        defValue: null
      }
    },
    {
      id: "variant_on_close",
      L: "ComponentVariant",
      P: {
        key: "onClose",
        type: "function",
        defValue: null
      }
    },
    {
      id: "variant_playlist",
      L: "ComponentVariant",
      P: {
        key: "playlist",
        type: "object",
        defValue: null
      }
    },
    {
      id: "variant_on_success",
      L: "ComponentVariant",
      P: {
        key: "onSuccess",
        type: "function",
        defValue: null
      }
    },
    {
      id: "modal_overlay",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
const [videoUrlsInput, setVideoUrlsInput] = args.createSignal("");
const [isAddingVideos, setIsAddingVideos] = args.createSignal(false);

const closeModal = () => {
  setVideoUrlsInput("");
  const onClose = args.contextData.props?.onClose;
  onClose?.();
};

const addVideosToPlaylist = async () => {
  const playlist = args.contextData.props?.playlist;

  if (!playlist) {
    args.showErrorToast("Playlist not found");
    return;
  }

  const urlsText = videoUrlsInput().trim();
  if (!urlsText) {
    args.showErrorToast("Please enter at least one video URL");
    return;
  }

  setIsAddingVideos(true);

  try {
    const result = await args.executeNamedServerFunction({
      functionName: "addVideoToPlaylist",
      contextData: {
        playlistId: playlist.P.youtubeId,
        videoUrl: urlsText
      }
    });

    if (result?.result?.success) {
      args.showSuccessToast(result.result.message || "Videos added successfully");
      const onSuccess = args.contextData.props?.onSuccess;
      onSuccess?.();
      closeModal();
    } else {
      args.showErrorToast(result?.result?.message || "Failed to add videos to playlist");
    }
  } catch (error) {
    console.error("Error adding videos:", error);
    args.showErrorToast("An error occurred while adding videos");
  } finally {
    setIsAddingVideos(false);
  }
};

return {
  videoUrlsInput,
  setVideoUrlsInput,
  isAddingVideos,
  closeModal,
  addVideosToPlaylist
};
''',
        props: '''
const isOpen = args.contextData.props?.isOpen;
const getIsOpen = isOpen?.() || false;

return {
  as: "div",
  hide: !getIsOpen,
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      args.fns.closeModal();
    }
  }
};
''',
        css: '''
return `._id {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}`;
'''
      }
    },
    {
      id: "modal_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  onClick: (e) => e.stopPropagation()
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.background};
  border-radius: 0.75rem;
  width: 100%;
  max-width: 600px;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}`;
'''
      }
    },
    {
      id: "modal_header",
      L: "Attr",
      P: {
        displayOrder: 1,
