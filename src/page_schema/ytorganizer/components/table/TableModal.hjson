        displayOrder: 2
        componentName: Html
        props:
          '''
const wrappedOnClose = () => {
  args.fns.cleanup();
  const onClose = args.contextData.props?.onClose;
  if (onClose) {
    onClose();
  }
};

return {
  as: "icon",
  icon: "carbon:close",
  width: 24,
  height: 24,
  onClick: wrappedOnClose
};
'''
