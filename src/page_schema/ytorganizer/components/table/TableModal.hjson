        displayOrder: 2
        componentName: FormManagement
        props:
          '''
const formConfig = args.contextData.props?.formConfig;
const mode = args.contextData.props?.mode || "add";
const tableVertexLabel = args.contextData.props?.tableVertexLabel;
const initialVertex = args.contextData.props?.initialVertex;
const onSave = args.contextData.props?.onSave;
const onClose = args.contextData.props?.onClose;

// Wrap onSave to track txnId and handle cleanup
const wrappedOnSave = async (saveData) => {
  // Get txnId from FormManagement (will be set via onFnsReady)
  const txnId = args.fns?.formTxnId?.();
  if (txnId && txnId > 0) {
    args.fns.setFormTxnId(txnId);
  }

  // Call original onSave with vertex format
  if (onSave) {
    await onSave(saveData);
  }

  // Cleanup transaction after successful save
  args.fns.cleanup();
};

// Wrap onClose to cleanup transaction
const wrappedOnClose = () => {
  args.fns.cleanup();
  if (onClose) {
    onClose();
  }
};

return {
  formConfig: formConfig,
  initialVertex: initialVertex,
  mode: mode,
  vertexLabel: tableVertexLabel,
  onSave: wrappedOnSave,
  onClose: wrappedOnClose
};
'''
