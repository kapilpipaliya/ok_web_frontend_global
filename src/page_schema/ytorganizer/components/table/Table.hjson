const column = args.contextData.column;
const columnFilters = args.fns.columnFilters;
// Preserve array values from URL - don't default to empty string for select filters
const filterValue = columnFilters[column.key] !== undefined ? columnFilters[column.key] : (column.type === "select" || column.filterType === "select" ? [] : "");

return `._id {
  width: 100%;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const column = args.contextData.column;
const columnFilters = args.fns.columnFilters;
// Access store reactively - ensure we get the current value
const getFilterValue = () => {
  const value = columnFilters[column.key];
  if (value !== undefined) {
    return value;
  }
  // Default to empty array for select filters, empty string for others
  return (column.type === "select" || column.filterType === "select") ? [] : "";
};
const filterValue = getFilterValue();

// Skip filter for rowNumber
if (column.key === "__rowNumber" || column.type === "rowNumber") {
  return { as: "div", hide: true };
}

// Render appropriate filter component based on column type
if (column.type === "select" && column.options) {
  // Normalize filterValue to array for multiple select
  // Ensure values match option values exactly
  const normalizedValue = Array.isArray(filterValue) 
    ? filterValue.filter(v => v !== null && v !== undefined && v !== "")
    : (filterValue ? [filterValue] : []);
  
  return {
    componentName: "TomSelect",
    value: normalizedValue,
    onChange: (newValue) => args.fns.handleColumnFilterChange(column.key, newValue),
    options: [{ value: "_All_VALUES_", label: "All" }, ...column.options],
    placeholder: "Filter...",
    search: false,
    multiple: true
  };
}

if (column.type === "checkbox") {
  return {
    componentName: "Html",
    as: "input",
    type: "checkbox",
    checked: filterValue === true || filterValue === "true",
    onChange: (e) => args.fns.handleColumnFilterChange(column.key, e.target.checked),
    style: "cursor: pointer; width: 20px; height: 20px;"
  };
}

if (column.type === "date" || column.type === "isoDateTime") {
  return {
    componentName: "TextInput",
    type: "date",
    value: filterValue || "",
    onChange: (e) => args.fns.handleColumnFilterChange(column.key, e.target.value),
    placeholder: "Filter..."
  };
}

// Determine filter type (default: "select" for text columns)
const filterType = column.filterType || (column.type === "text" || !column.type ? "select" : "text");

// If filterType is "select", show select with unique values
if (filterType === "select") {
  const uniqueValues = args.fns.getUniqueColumnValues(column);
  const options = [{ value: "_All_VALUES_", label: "All" }, ...uniqueValues.map(val => ({ value: val, label: val }))];
  
  // Normalize filterValue to array for multiple select
  // Ensure values match option values exactly and filter out invalid values
  const normalizedValue = Array.isArray(filterValue) 
    ? filterValue.filter(v => v !== null && v !== undefined && v !== "" && v !== "_All_VALUES_")
    : (filterValue && filterValue !== "_All_VALUES_" ? [filterValue] : []);

  return {
    componentName: "TomSelect",
    value: normalizedValue,
    onChange: (newValue) => args.fns.handleColumnFilterChange(column.key, newValue),
    options: options,
    placeholder: "Filter...",
    search: true,
    multiple: true
  };
}

// Default: text input (applies filter immediately on change)
return {
  componentName: "TextInput",
  type: "text",
  placeholder: "Filter...",
