          '''
const showSelection = args.fns.getShowSelection();
const selected = args.fns.getSelectedRows();
const filtered = args.fns.filteredData();
// Check if all rows are selected by comparing vertex IDs
const allSelected = filtered.length > 0 && filtered.every(row => row.id && selected.has(row.id));

return {
  as: "input",
  type: "checkbox",
  checked: allSelected,
  onChange: () => {
    if (allSelected) {
      args.fns.clearSelection();
    } else {
      args.fns.selectAllRows();
    }
  },
  hide: !showSelection,
  style: "cursor: pointer; width: 20px; height: 20px;"
};
'''
      }
    }
