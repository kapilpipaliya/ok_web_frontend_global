const isCustom = args.fns.isCustomPlaylist();
const isSubmitting = args.fns.isSubmitting();
return {
  as: "button",
  type: "submit",
  text: isSubmitting
    ? (isCustom ? "Creating Playlist..." : "Adding Playlist...")
    : (isCustom ? "Create Playlist" : "Add Playlist"),
  disabled: isSubmitting
};
''',
        css: '''
return `._id {
  padding: 0.75rem 1.5rem;
  border: none;
  border-radius: 0.5rem;
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;

  &:hover:not(:disabled) {
    background: ${args.theme.var.color.primary_dark_200};
  }

  &:active:not(:disabled) {
    transform: translateY(1px);
  }

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  @media (max-width: 768px) {
    padding: 0.875rem 1.5rem;
  }
}`;
'''
