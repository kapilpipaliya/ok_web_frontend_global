{
  vertexes: [
    {
      id: "yto_add_playlist_button_component",
      L: "Component",
      P: {
        key: "YTOAddPlaylistButton"
      }
    },
    {
      id: "yto_add_playlist_button_variant_on_submit",
      L: "ComponentVariant",
      P: {
        key: "onSubmit",
        type: "function",
        defValue: null
      }
    },
    {
      id: "yto_add_playlist_button_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        fns: '''
// State for showing/hiding the modal
const [showModal, setShowModal] = args.createSignal(false);

// Form state
const [urlValue, setUrlValue] = args.createSignal("");
const [nameValue, setNameValue] = args.createSignal("");
const [descriptionValue, setDescriptionValue] = args.createSignal("");
const [isCustomPlaylist, setIsCustomPlaylist] = args.createSignal(false);
const [isSubmitting, setIsSubmitting] = args.createSignal(false);

// Get onSubmit callback from props
const onSubmit = args.contextData.props?.onSubmit;

// Handle form submission
const handleSubmit = async (e) => {
  e.preventDefault();

  const url = urlValue().trim();
  const name = nameValue().trim();
  const description = descriptionValue().trim();
  const isCustom = isCustomPlaylist();

  // Validation based on playlist type
  if (isCustom) {
    if (!name) {
      args.showErrorToast("Please enter a playlist name");
      return;
    }
  } else {
    if (!url) {
      args.showErrorToast("Please enter a playlist URL");
      return;
    }
  }

  // Set loading state
  setIsSubmitting(true);

  try {
    let result;

    if (isCustom) {
      // Call the createCustomPlaylist server function
      result = await args.executeNamedServerFunction({
        functionName: "createCustomPlaylist",
        contextData: {
          name: name,
          description: description || null
        }
      });
    } else {
      // Call the savePlaylist server function
      result = await args.executeNamedServerFunction({
        functionName: "savePlaylist",
        contextData: {
          url: url,
          name: name || null
        }
      });
    }

    if (result.error) {
      args.showErrorToast(result.error);
    } else if (result.result && result.result.success) {
      args.showSuccessToast(result.result.message);

      // Call parent onSubmit if provided
      if (onSubmit) {
        onSubmit({
          url: url,
          name: name,
          description: description,
          isCustom: isCustom,
          result: result.result.data
        });
      }

      // Reset form and close modal
      setUrlValue("");
      setNameValue("");
      setDescriptionValue("");
      setIsCustomPlaylist(false);
      setShowModal(false);
    } else {
      args.showErrorToast(result.result?.message || result.message || "Failed to save playlist");
    }
  } catch (error) {
    console.error("Error saving playlist:", error);
    args.showErrorToast("An error occurred while saving the playlist. Please try again.");
  } finally {
    setIsSubmitting(false);
  }
};

// Return functions to be accessible in children
return {
  showModal,
  setShowModal,
  urlValue,
  setUrlValue,
  nameValue,
  setNameValue,
  descriptionValue,
  setDescriptionValue,
  isCustomPlaylist,
  setIsCustomPlaylist,
  isSubmitting,
  handleSubmit
};
'''
      }
    },
    {
      id: "yto_add_playlist_button_fab",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "YTOFloatingButton",
        props: '''
return {
  icon: "carbon:add",
  label: "Add Playlist",
  onClick: () => args.fns.setShowModal(true),
  color: "success"
};
'''
      }
