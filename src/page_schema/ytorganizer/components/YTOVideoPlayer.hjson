  background: ${args.theme.var.color.background_dark_800};
  border-bottom: 1px solid ${args.theme.var.color.background_dark_700};
  cursor: ${state === "minimized" ? 'move' : 'default'};
  user-select: none;
  touch-action: ${state === "minimized" ? 'none' : 'auto'};
}`;
'''
