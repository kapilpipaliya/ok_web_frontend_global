    {
      id: "resize_handle_se",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const getPlayerState = args.contextData.props?.playerState;
const setPlayerSize = args.contextData.props?.setPlayerSize;
const setPlayerPosition = args.contextData.props?.setPlayerPosition;
const playerPosition = args.contextData.props?.playerPosition || { x: null, y: null };

const handleMouseDown = (e) => {
  const state = getPlayerState?.();
  if (state !== "minimized") return;

  e.preventDefault();
  e.stopPropagation();

  const playerEl = e.currentTarget.parentElement;
  const rect = playerEl.getBoundingClientRect();
  const startX = e.clientX;
  const startY = e.clientY;
  const startWidth = rect.width;
  const startHeight = rect.height;

  const handleMouseMove = (moveEvent) => {
    const deltaX = moveEvent.clientX - startX;
    const deltaY = moveEvent.clientY - startY;

    const newWidth = Math.max(300, startWidth + deltaX);
    const newHeight = Math.max(200, startHeight + deltaY);

    setPlayerSize?.({ width: newWidth, height: newHeight });
  };

  const handleMouseUp = () => {
    document.removeEventListener('mousemove', handleMouseMove);
    document.removeEventListener('mouseup', handleMouseUp);
  };

  document.addEventListener('mousemove', handleMouseMove);
  document.addEventListener('mouseup', handleMouseUp);
};

return {
  as: "div",
  onMouseDown: handleMouseDown,
  hide: () => {
    const state = getPlayerState?.();
    return state !== "minimized";
  }
};
''',
        css: '''
return `._id {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 16px;
  height: 16px;
  cursor: se-resize;
  z-index: 10;

  &::after {
    content: '';
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 8px;
    height: 8px;
    border-right: 2px solid ${args.theme.var.color.background_dark_700};
    border-bottom: 2px solid ${args.theme.var.color.background_dark_700};
  }
}`;
'''
      }
