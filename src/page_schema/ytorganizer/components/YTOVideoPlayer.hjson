    {
      id: "player_video_container",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        fns: '''
// Setup YouTube iframe API message listener
const playNext = args.contextData.props?.playNext;
const getPlayerState = args.contextData.props?.playerState;

const handleMessage = (event) => {
  if (event.origin !== "https://www.youtube.com") return;

  try {
    // YouTube sends data as string or object
    let data = event.data;
    if (typeof data === 'string') {
      data = JSON.parse(data);
    }

    // YouTube player states: -1=unstarted, 0=ended, 1=playing, 2=paused, 3=buffering, 5=cued
    // Only auto-play next video when:
    // 1. Current video has ended (state 0)
    // 2. Player is still open (not closed)
    if (data.event === "onStateChange" && data.info === 0) {
      const currentState = getPlayerState?.();
      if (currentState === "minimized" || currentState === "maximized") {
        playNext?.();
      }
    }
  } catch (e) {
    // Ignore parse errors - many messages from YouTube aren't JSON
  }
};

return {
  handleMessage
};
''',
        props: '''
return {
  as: "div",
  onMount: (el) => {
    window.addEventListener("message", args.fns.handleMessage);
  },
  onCleanup: () => {
    window.removeEventListener("message", args.fns.handleMessage);
  }
};
''',
        css: '''
return `._id {
  width: 100%;
  height: calc(100% - 48px);
  background: ${args.theme.var.color.background_dark_900};
  position: relative;
}`;
'''
      }
