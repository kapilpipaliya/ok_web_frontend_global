{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "YTOVideoPlayer"
      }
    },
    {
      id: "video_player_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const getPlayerState = args.contextData.props?.playerState;
const currentState = getPlayerState?.() || "closed";
const playerPosition = args.contextData.props?.playerPosition || { x: null, y: null };
const playerSize = args.contextData.props?.playerSize || { width: 480, height: 270 };

// Calculate default position (bottom right) if not set
const isMobile = typeof window !== 'undefined' && window.innerWidth < 768;
const defaultX = isMobile ? 8 : null;
const defaultY = isMobile ? 80 : null;
const x = playerPosition.x !== null ? playerPosition.x : defaultX;
const y = playerPosition.y !== null ? playerPosition.y : defaultY;

// Build inline styles for positioning
const positionStyle = currentState === "minimized" && x !== null && y !== null
  ? { left: `${x}px`, top: `${y}px`, width: `${playerSize.width}px`, height: `${playerSize.height}px` }
  : {};

return {
  as: "div",
  hide: () => {
    const state = getPlayerState?.();
    return state === "closed";
  },
  "data-state": currentState,
  style: positionStyle
};
''',
        css: '''
const getPlayerState = args.contextData.props?.playerState;
const state = getPlayerState?.() || "closed";
const isMinimized = state === "minimized";
const isMaximized = state === "maximized";

return `._id {
  position: fixed;
  z-index: 99;
  background: ${args.theme.var.color.background_dark_900};
  border-radius: ${isMinimized ? '0.5rem' : '0'};
  box-shadow: ${isMinimized ? '0 4px 20px rgba(0, 0, 0, 0.3)' : 'none'};
  overflow: hidden;
  transition: box-shadow 0.3s ease, border-radius 0.3s ease;
}

._id[data-state="minimized"] {
  bottom: ${args.theme.var.spacing.lg};
  right: ${args.theme.var.spacing.lg};
  width: 480px;
  height: 270px;
  min-width: 480px;
  min-height: 270px;
}

._id[data-state="maximized"] {
  top: 0 !important;
  left: 0 !important;
  right: 0;
  bottom: 0;
  width: 100vw !important;
  height: 100vh !important;
}

@media (max-width: 768px) {
  ._id[data-state="minimized"] {
    bottom: 80px;
    right: ${args.theme.var.spacing.sm};
    left: ${args.theme.var.spacing.sm};
    width: calc(100% - ${args.theme.var.spacing.md});
    height: 270px;
  }
}`;
'''
      }
    },
    {
      id: "player_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const getPlayerState = args.contextData.props?.playerState;
const setPlayerPosition = args.contextData.props?.setPlayerPosition;

const handleMouseDown = (e) => {
  const state = getPlayerState?.();
  if (state !== "minimized") return;

  // Prevent text selection while dragging
  e.preventDefault();

  const startX = e.clientX;
  const startY = e.clientY;
  const playerEl = e.currentTarget.parentElement;
  const rect = playerEl.getBoundingClientRect();
  const offsetX = startX - rect.left;
  const offsetY = startY - rect.top;

  const handleMouseMove = (moveEvent) => {
    const newX = moveEvent.clientX - offsetX;
    const newY = moveEvent.clientY - offsetY;

    // Keep player within viewport bounds
    const maxX = window.innerWidth - rect.width;
    const maxY = window.innerHeight - rect.height;
    const boundedX = Math.max(0, Math.min(newX, maxX));
    const boundedY = Math.max(0, Math.min(newY, maxY));

    setPlayerPosition?.({ x: boundedX, y: boundedY });
  };

  const handleMouseUp = () => {
    document.removeEventListener('mousemove', handleMouseMove);
    document.removeEventListener('mouseup', handleMouseUp);
  };

  document.addEventListener('mousemove', handleMouseMove);
  document.addEventListener('mouseup', handleMouseUp);
};

const handleTouchStart = (e) => {
  const state = getPlayerState?.();
  if (state !== "minimized") return;

  // Prevent default scrolling while dragging
  e.preventDefault();

  const touch = e.touches[0];
  const startX = touch.clientX;
  const startY = touch.clientY;
  const playerEl = e.currentTarget.parentElement;
  const rect = playerEl.getBoundingClientRect();
  const offsetX = startX - rect.left;
  const offsetY = startY - rect.top;

  const handleTouchMove = (moveEvent) => {
    const touch = moveEvent.touches[0];
    const newX = touch.clientX - offsetX;
    const newY = touch.clientY - offsetY;

    // Keep player within viewport bounds
    const maxX = window.innerWidth - rect.width;
    const maxY = window.innerHeight - rect.height;
    const boundedX = Math.max(0, Math.min(newX, maxX));
    const boundedY = Math.max(0, Math.min(newY, maxY));

    setPlayerPosition?.({ x: boundedX, y: boundedY });
  };

  const handleTouchEnd = () => {
    document.removeEventListener('touchmove', handleTouchMove);
    document.removeEventListener('touchend', handleTouchEnd);
  };

  document.addEventListener('touchmove', handleTouchMove);
  document.addEventListener('touchend', handleTouchEnd);
};

return {
  as: "div",
  onMouseDown: handleMouseDown,
  onTouchStart: handleTouchStart
};
''',
        css: '''
