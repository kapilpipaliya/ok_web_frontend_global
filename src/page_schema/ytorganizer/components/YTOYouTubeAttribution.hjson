        componentName: "Html",
        props: '''
return {
  as: "a",
  href: "https://www.youtube.com",
  target: "_blank",
  rel: "noopener noreferrer"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  text-decoration: none;
  transition: opacity 0.2s ease;

  &:hover {
    opacity: 0.8;
  }
}`;
'''
