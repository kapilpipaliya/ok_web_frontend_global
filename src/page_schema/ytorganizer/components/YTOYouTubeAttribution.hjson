{
  vertexes: [
    {
      id: "youtube_attribution_component",
      L: "Component",
      P: {
        key: "YTOYouTubeAttribution",
        description: "YouTube API Services attribution component for branding compliance"
      }
    },
    {
      id: "youtube_attribution_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.75rem 1rem;
  background: ${args.theme.var.color.background_light_100};
  border-radius: 0.5rem;
  border: 1px solid ${args.theme.var.color.border};
  font-size: 0.875rem;
  color: ${args.theme.var.color.background_light_100_text};
}

@media (max-width: 640px) {
  ._id {
    flex-direction: column;
    text-align: center;
  }
}`;
'''
      }
    },
    {
      id: "youtube_attribution_text",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "span",
  text: "Powered by"
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.background_light_100_text};
  opacity: 0.7;
}`;
'''
      }
    },
    {
      id: "youtube_attribution_link",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "a",
  href: "https://www.youtube.com",
  target: "_blank",
  rel: "noopener noreferrer"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  text-decoration: none;
  transition: opacity 0.2s ease;

  &:hover {
    opacity: 0.8;
  }
}`;
'''
      }
    },
    {
      id: "youtube_logo",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "logos:youtube-icon",
  width: 32,
  height: 32
};
''',
        css: '''
return `._id {
  color: #FF0000;
}`;
'''
      }
    },
    {
      id: "youtube_text_wrapper",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "span"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.875rem;
}`;
'''
      }
    },
    {
      id: "youtube_text_bold",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "span",
  text: "YouTube"
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.background_light_100_text};
  font-weight: 700;
}`;
'''
      }
    },
    {
      id: "youtube_text_normal",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "span",
  text: "API Services"
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.background_light_100_text};
  font-weight: 400;
}`;
'''
      }
    }
  ],
  edges: [
    { id: "e1", T: "Attr", S: "youtube_attribution_component", E: "youtube_attribution_root" },
    { id: "e2", T: "Attr", S: "youtube_attribution_root", E: "youtube_attribution_text" },
    { id: "e3", T: "Attr", S: "youtube_attribution_root", E: "youtube_attribution_link" },
    { id: "e4", T: "Attr", S: "youtube_attribution_link", E: "youtube_logo" },
    { id: "e5", T: "Attr", S: "youtube_attribution_link", E: "youtube_text_wrapper" },
