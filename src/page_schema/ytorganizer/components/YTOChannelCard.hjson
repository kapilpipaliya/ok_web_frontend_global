{
  vertexes: [
    {
      id: "yto_channel_card_component",
      L: "Component",
      P: {
        key: "YTOChannelCard"
      }
    },
    {
      id: "yto_channel_card_variant_channel",
      L: "ComponentVariant",
      P: {
        key: "channel",
        type: "object",
        defValue: null
      }
    },
    {
      id: "yto_channel_card_variant_onclick",
      L: "ComponentVariant",
      P: {
        key: "onClick",
        type: "function",
        defValue: null
      }
    },
    {
      id: "yto_channel_card_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const channel = args.contextData.props?.channel;

// Default click handler navigates to channel detail with query parameters
const defaultOnClick = () => {
  if (channel?.id) {
    const params = new URLSearchParams({
      channelId: channel.id
    });
    args.navigate(`/channel?${params.toString()}`);
  }
};

return {
  as: "div",
  onClick: defaultOnClick
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.surface};
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 1rem;
  padding: 1.5rem;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  text-align: center;
  height: 100%;
  
  &:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    border-color: ${args.theme.var.color.primary_light_300};
  }
  
  &:active {
    transform: translateY(0);
  }
  
  @media (max-width: 768px) {
    padding: 1.25rem;
    gap: 0.875rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_channel_card_avatar_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  position: relative;
  width: 80px;
  height: 80px;
  border-radius: 50%;
  overflow: hidden;
  background: ${args.theme.var.color.primary_light_100};
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  
  @media (max-width: 768px) {
    width: 64px;
    height: 64px;
  }
}`;
'''
      }
    },
    {
      id: "yto_channel_card_avatar",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const channel = args.contextData.props?.channel;
const avatarUrl = channel?.avatar || '';

if (avatarUrl) {
  return {
    as: "img",
    src: avatarUrl,
    alt: channel?.title || 'Channel avatar'
  };
} else {
  return {
    as: "div"
  };
}
''',
        css: '''
const channel = args.contextData.props?.channel;
const avatarUrl = channel?.avatar || '';

if (avatarUrl) {
  return `._id {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }`;
} else {
  return `._id {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: ${args.theme.var.color.primary};
  }`;
}
'''
      }
    },
    {
      id: "yto_channel_card_placeholder_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const channel = args.contextData.props?.channel;
const avatarUrl = channel?.avatar || '';

if (!avatarUrl) {
  return {
    as: "icon",
    icon: "carbon:api-1",
    width: 32,
    height: 32
  };
} else {
  return { as: "div", style: "display: none;" };
}
''',
        css: '''
return `._id {
  opacity: 0.7;
  
  @media (max-width: 768px) {
    width: 24px !important;
    height: 24px !important;
  }
}`;
'''
      }
    },
    {
      id: "yto_channel_card_verified_badge",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const channel = args.contextData.props?.channel;
const isVerified = channel?.verified || false;

if (isVerified) {
  return {
    as: "div"
  };
} else {
  return { as: "div", style: "display: none;" };
}
''',
        css: '''
return `._id {
  position: absolute;
  bottom: -2px;
  right: -2px;
  width: 24px;
  height: 24px;
  background: ${args.theme.var.color.success};
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid ${args.theme.var.color.surface};
  
  @media (max-width: 768px) {
    width: 20px;
    height: 20px;
  }
}`;
'''
      }
    },
    {
      id: "yto_channel_card_verified_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:checkmark",
  width: 12,
  height: 12
};
''',
        css: '''
return `._id {
  color: white;
  
  @media (max-width: 768px) {
    width: 10px !important;
    height: 10px !important;
  }
}`;
'''
      }
    },
    {
      id: "yto_channel_card_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  width: 100%;
}`;
'''
      }
    },
    {
      id: "yto_channel_card_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const channel = args.contextData.props?.channel;
const title = channel?.title || 'Untitled Channel';

return {
  as: "h3",
  text: title
};
''',
        css: '''
return `._id {
  font-size: 1.125rem;
  font-weight: 600;
  margin: 0;
  color: ${args.theme.var.color.text};
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  
  @media (max-width: 768px) {
    font-size: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_channel_card_description",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const channel = args.contextData.props?.channel;
const description = channel?.description || '';

if (description) {
  return {
    as: "p",
    text: description
  };
} else {
  return { as: "div", style: "display: none;" };
}
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  color: ${args.theme.var.color.muted};
  margin: 0;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  
  @media (max-width: 768px) {
    font-size: 0.75rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_channel_card_stats",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  justify-content: center;
  gap: 1rem;
  margin-top: auto;
  
  @media (max-width: 768px) {
    gap: 0.75rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_channel_card_subscriber_count",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const channel = args.contextData.props?.channel;
const subscriberCount = channel?.subscriberCount || 0;

// Format subscriber count (simplified)
const formatCount = (count) => {
  if (count >= 1000000) return `${(count / 1000000).toFixed(1)}M`;
  if (count >= 1000) return `${(count / 1000).toFixed(1)}K`;
  return count.toString();
};

return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
}`;
'''
      }
    },
    {
      id: "yto_channel_card_subscriber_number",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const channel = args.contextData.props?.channel;
const subscriberCount = channel?.subscriberCount || 0;

// Format subscriber count
const formatCount = (count) => {
  if (count >= 1000000) return `${(count / 1000000).toFixed(1)}M`;
  if (count >= 1000) return `${(count / 1000).toFixed(1)}K`;
  return count.toString();
};

return {
  as: "span",
  text: formatCount(subscriberCount)
};
''',
        css: '''
return `._id {
  font-size: 1rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
  
  @media (max-width: 768px) {
    font-size: 0.875rem;
  }
}`;
'''
      }
    },
