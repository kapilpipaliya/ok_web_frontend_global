  text: `${count} Channels`
};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.sm};
  color: ${args.theme.var.color.muted};
  text-align: center;
}`;
'''
      }
    },
    {
      id: "playlists_stat",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
