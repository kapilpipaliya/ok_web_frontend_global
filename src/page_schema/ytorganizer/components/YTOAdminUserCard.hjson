{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "YTOAdminUserCard"
      }
    },
    {
      id: "card_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const userdata = args.contextData.props?.userdata;
const user = userdata?.user;
const stats = userdata?.stats;
const onImpersonate = args.contextData.props?.onImpersonate;

if (!user) {
  return { as: "div", hide: true };
}

return {
  as: "div",
  onClick: () => {
    // Could open detailed modal in future
  }
};
''',
        css: '''
return `._id {
  border: 1px solid ${args.theme.var.color.border};
  border-radius: ${args.theme.var.borderRadius.md};
  padding: ${args.theme.var.spacing.md};
  cursor: pointer;
  transition: all 0.2s ease;

  &:hover {
    border-color: ${args.theme.var.color.primary};
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 768px) {
    padding: ${args.theme.var.spacing.sm};
  }
}`;
'''
      }
    },
    {
      id: "user_info",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: ${args.theme.var.spacing.md};
  margin-bottom: ${args.theme.var.spacing.md};
}`;
'''
      }
    },
    {
      id: "user_avatar",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const userdata = args.contextData.props?.userdata;
const user = userdata?.user;
const username = user?.P?.username || "User";
const initial = username.charAt(0).toUpperCase();

return {
  as: "div",
  text: initial
};
''',
        css: '''
return `._id {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: ${args.theme.var.fontSize.lg};
  font-weight: 600;
  flex-shrink: 0;
}`;
'''
      }
    },
    {
      id: "user_details",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  flex: 1;
  min-width: 0;
}`;
'''
      }
    },
    {
      id: "username",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const userdata = args.contextData.props?.userdata;
const user = userdata?.user;
const username = user?.P?.username || "Unknown";

return {
  as: "div",
  text: username
};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.md};
  font-weight: 600;
  color: ${args.theme.var.color.text};
  margin-bottom: ${args.theme.var.spacing.xs};
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}`;
'''
      }
    },
    {
      id: "user_email",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const userdata = args.contextData.props?.userdata;
const user = userdata?.user;
const email = user?.P?.email || "";

return {
  as: "div",
  text: email
};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.sm};
  color: ${args.theme.var.color.muted};
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}`;
'''
      }
    },
    {
      id: "activity_badge",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const userdata = args.contextData.props?.userdata;
const user = userdata?.user;
const stats = userdata?.stats;

// Calculate activity status
const now = new Date();
const createdAt = user?.P?.createdAt ? new Date(user.P.createdAt) : null;
const lastChannelAdded = stats?.lastChannelAdded ? new Date(stats.lastChannelAdded) : null;
const lastPlaylistAdded = stats?.lastPlaylistAdded ? new Date(stats.lastPlaylistAdded) : null;
const lastVideoActivity = stats?.lastVideoActivity ? new Date(stats.lastVideoActivity) : null;

// Get most recent activity
const activityDates = [lastChannelAdded, lastPlaylistAdded, lastVideoActivity].filter(d => d);
const lastActivity = activityDates.length > 0 ? new Date(Math.max(...activityDates)) : null;

// Determine status
let status = "Dormant";
let statusBgColor = args.theme.var.color.muted;
let statusTextColor = args.theme.var.color.muted_text;

// Check if user is new (created within last 7 days)
if (createdAt && (now - createdAt) / (1000 * 60 * 60 * 24) <= 7) {
  status = "New";
  statusBgColor = args.theme.var.color.info;
  statusTextColor = args.theme.var.color.info_text;
}
// Check if user is active (activity within last 30 days)
else if (lastActivity && (now - lastActivity) / (1000 * 60 * 60 * 24) <= 30) {
  status = "Active";
  statusBgColor = args.theme.var.color.success;
  statusTextColor = args.theme.var.color.success_text;
}

return {
  as: "div",
  text: status,
  style: {
    backgroundColor: statusBgColor,
    color: statusTextColor
  }
};
''',
        css: '''
return `._id {
  display: inline-block;
  padding: ${args.theme.var.spacing.xs} ${args.theme.var.spacing.sm};
  border-radius: ${args.theme.var.borderRadius.sm};
  font-size: ${args.theme.var.fontSize.xs};
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-top: ${args.theme.var.spacing.xs};
}`;
'''
      }
    },
    {
      id: "stats_container",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: ${args.theme.var.spacing.sm};
  margin-bottom: ${args.theme.var.spacing.md};

  @media (max-width: 768px) {
    gap: ${args.theme.var.spacing.xs};
  }
}`;
'''
      }
    },
    {
      id: "channels_stat",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
