''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.sm};
  color: ${args.theme.var.color.muted};
  text-align: center;
}`;
'''
      }
    },
    {
      id: "videos_stat",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const userdata = args.contextData.props?.userdata;
const stats = userdata?.stats;
const count = stats?.favoriteVideoCount || 0;

return {
  as: "div",
  text: `${count} Favorites`
};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.sm};
  color: ${args.theme.var.color.muted};
  text-align: center;
}`;
'''
      }
    },
    {
      id: "impersonate_button",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "YTOButton",
        props: '''
const userdata = args.contextData.props?.userdata;
const user = userdata?.user;
const onImpersonate = args.contextData.props?.onImpersonate;

return {
  text: "View as User",
  variant: "primary",
  fullWidth: true,
  onClick: (e) => {
    e.stopPropagation();
    if (onImpersonate && user) {
      onImpersonate(user.P.uuid);
    }
  }
};
'''
      }
    }
  ],
  edges: [
