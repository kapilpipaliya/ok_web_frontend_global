{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "YTOCard"
      }
    },
    {
      id: "card_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.background};
  border: none;
  border-radius: 0;
  padding: 0.5rem 0.75rem;
  cursor: default;
  transition: background 0.2s ease;
  display: flex;
  flex-wrap: nowrap;
  align-items: flex-start;
  gap: 0.5rem;
  height: 100%;
  box-sizing: border-box;
  border-bottom: 1px solid ${args.theme.var.color.background_light_200};
  position: relative;

  &:hover {
    background: ${args.theme.var.color.background_light_100};
  }
}`;
'''
      }
    },
    {
      id: "card_thumbnail",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.props?.item;
const itemType = args.contextData.props?.itemType;
const thumbnailUrl = item?.P?.thumbnailUrl || item?.P?.thumbnail || "";
const youtubeId = item?.P?.youtubeId || "";

let href, target;
if (itemType === "video") {
  href = `https://www.youtube.com/watch?v=${youtubeId}`;
  target = "_blank";
} else if (itemType === "playlist") {
  href = `/yto/content?type=playlists&id=${youtubeId}`;
  target = "_self";
} else {
  href = `/yto/content?type=channels&id=${youtubeId}`;
  target = "_self";
}

return {
  as: "a",
  href: href,
  target: target,
  rel: target === "_blank" ? "noopener noreferrer" : "",
  style: thumbnailUrl ? `background-image: url('${thumbnailUrl}'); background-size: cover; background-position: center;` : "",
  onClick: (e) => {
    e.preventDefault();
    e.stopPropagation();

    if (itemType === "video") {
      args.fns.playVideo?.(item);
    } else if (itemType === "playlist") {
      args.navigate(`/yto/content?type=playlists&id=${youtubeId}`);
    } else {
      args.navigate(`/yto/content?type=channels&id=${youtubeId}`);
    }
  }
};
''',
        css: '''
return `._id {
  width: 100px;
  height: 56px;
  background-color: ${args.theme.var.color.background_light_300};
  border-radius: 0.375rem;
  flex-shrink: 0;
  overflow: hidden;
  cursor: pointer;
  transition: transform 0.2s ease;
  text-decoration: none;
  display: block;

  &:hover {
    transform: scale(1.05);
  }
}`;
'''
      }
    },
    {
      id: "card_info",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  min-width: 0;
  overflow: hidden;
}`;
'''
      }
    },
    {
      id: "card_type_badge",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const showTypeBadge = args.contextData.props?.showTypeBadge || false;
const itemType = args.contextData.props?.itemType;

let text, color;
if (itemType === "channel") {
  text = "Channel";
  color = "error";
} else if (itemType === "playlist") {
  text = "Playlist";
  color = "success";
} else {
  text = "Video";
  color = "info";
}

return {
  as: "span",
  text: text,
  "data-color": color,
  hide: !showTypeBadge
};
''',
        css: '''
return `._id {
  display: inline-flex;
  padding: 0.125rem 0.375rem;
  font-size: 0.65rem;
  font-weight: 500;
  border-radius: 0.25rem;
  width: fit-content;
}

._id[data-color="error"] {
  background: ${args.theme.var.color.error_light_100};
  color: ${args.theme.var.color.error};
}

._id[data-color="success"] {
  background: ${args.theme.var.color.success_light_100};
  color: ${args.theme.var.color.success};
}

._id[data-color="info"] {
  background: ${args.theme.var.color.info_light_100};
  color: ${args.theme.var.color.info};
}`;
'''
      }
    },
    {
      id: "card_title",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const item = args.contextData.props?.item;
const itemSettings = args.contextData.props?.itemSettings;
const itemType = args.contextData.props?.itemType;

const baseTitle = item?.P?.title || "Untitled";
const customName = itemSettings?.P?.customName;

// For playlists, channels, and videos, show custom name in brackets if it exists
let displayTitle = baseTitle;
if (customName && (itemType === "playlist" || itemType === "channel" || itemType === "video")) {
  displayTitle = `${baseTitle} (${customName})`;
}

return {
  as: "h3",
  text: displayTitle
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  font-weight: 500;
  color: ${args.theme.var.color.text};
  margin: 0;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}`;
'''
      }
    },
    {
      id: "card_meta_row",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
  font-size: 0.75rem;
  color: ${args.theme.var.color.muted};
}`;
'''
      }
    },
    {
      id: "card_meta_text",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.props?.item;
const itemSettings = args.contextData.props?.itemSettings;
const itemType = args.contextData.props?.itemType;

let metaText = "";

if (itemType === "channel") {
  const subscriberCount = item?.P?.subscriberCount || 0;
  const videoCount = itemSettings?.P?.userVideoCount ?? 0;

  let parts = [];
  if (subscriberCount >= 1000000) {
    parts.push(`${(subscriberCount / 1000000).toFixed(1)}M subscribers`);
  } else if (subscriberCount >= 1000) {
    parts.push(`${(subscriberCount / 1000).toFixed(1)}K subscribers`);
  } else if (subscriberCount > 0) {
    parts.push(`${subscriberCount} subscriber${subscriberCount !== 1 ? 's' : ''}`);
  }

  parts.push(`${videoCount} video${videoCount !== 1 ? 's' : ''}`);
  metaText = parts.join(' • ');
} else if (itemType === "playlist") {
  const videoCount = itemSettings?.P?.userVideoCount ?? 0;
  metaText = `${videoCount} video${videoCount !== 1 ? 's' : ''}`;

  // If there's a parent channel, show it
  const channelTitle = item?.P?.channelTitle || "";
  if (channelTitle) {
    metaText += ` • ${channelTitle}`;
  }
} else if (itemType === "video") {
  const channelTitle = item?.P?.channelTitle || "";
  metaText = channelTitle;
}

return {
  as: "span",
  text: metaText,
  hide: !metaText
};
''',
        css: '''
return `._id {
  margin: 0;
}`;
'''
      }
    },
    {
      id: "card_favourite_icon",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const item = args.contextData.props?.item;
const itemSettings = args.contextData.props?.itemSettings;
const itemType = args.contextData.props?.itemType;
const isFavourite = itemSettings?.P?.isFavourite || false;

return {
  as: "button",
  hide: !isFavourite,
  onClick: async (e) => {
    e.stopPropagation();
    await args.fns.toggleFavourite?.(item, itemType);
  },
  title: "Remove from favourites"
};
''',
        css: '''
return `._id {
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  display: flex;
  align-items: center;
  color: ${args.theme.var.color.error};
  transition: all 0.2s ease;

  &:hover {
    transform: scale(1.1);
  }
}`;
'''
      }
    },
    {
      id: "card_favourite_icon_svg",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:favorite-filled",
  width: 14,
  height: 14
};
'''
      }
    },
    {
      id: "card_queue_button",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const item = args.contextData.props?.item;
const itemType = args.contextData.props?.itemType;

return {
  as: "button",
  hide: itemType !== "video",
  onClick: async (e) => {
    e.stopPropagation();
    if (item) {
      args.fns.addToQueue?.(item);
    }
  },
  title: "Add to queue",
  "aria-label": "Add to queue"
};
''',
        css: '''
return `._id {
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  display: flex;
  align-items: center;
  color: ${args.theme.var.color.primary};
  transition: all 0.2s ease;

  &:hover {
    transform: scale(1.1);
    color: ${args.theme.var.color.primary_dark_200};
  }
}`;
'''
      }
    },
    {
      id: "card_queue_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:add",
  width: 14,
  height: 14
};
'''
      }
    },
    {
      id: "card_note_display",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
const itemSettings = args.contextData.props?.itemSettings;
const note = itemSettings?.P?.note || "";
const hasNote = note.length > 0;

return {
  as: "div",
  hide: !hasNote
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}`;
'''
      }
    },
    {
      id: "card_note_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:document",
  width: 14,
  height: 14
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.primary};
  flex-shrink: 0;
}`;
'''
      }
    },
    {
      id: "card_note_text",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const item = args.contextData.props?.item;
const itemSettings = args.contextData.props?.itemSettings;
const itemType = args.contextData.props?.itemType;
const note = itemSettings?.P?.note || "";
const shouldTruncate = note.length > 30;
const displayNote = shouldTruncate ? note.substring(0, 30) + "..." : note;

return {
  as: "span",
  text: displayNote,
  onClick: (e) => {
    e.stopPropagation();
    args.fns.openNoteModal?.(item, itemType, note);
  }
};
''',
        css: '''
return `._id {
  font-size: 0.75rem;
  color: ${args.theme.var.color.text};
  line-height: 1.3;
  cursor: pointer;

  &:hover {
    text-decoration: underline;
  }
}`;
'''
      }
    },
    {
      id: "card_actions",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  margin-left: auto;
