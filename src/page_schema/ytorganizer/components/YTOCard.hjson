};
'''
      }
    },
    {
      id: "menu_item_add_note",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "YTOMenuItem",
        slot: "menu-items",
        props: '''
const item = args.contextData.props?.item;
const itemSettings = args.contextData.props?.itemSettings;
const itemType = args.contextData.props?.itemType;
const note = itemSettings?.P?.note || "";

return {
  icon: "carbon:document-add",
  text: "Add a note",
  onClick: (e) => {
    e?.stopPropagation();
    args.fns.openNoteModal?.(item, itemType, note);
    args.contextData.floatingMenuContext?.closeMenu?.();
  }
};
'''
      }
    },
    {
      id: "menu_item_toggle_favourite",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "YTOMenuItem",
        slot: "menu-items",
        props: '''
const item = args.contextData.props?.item;
const itemSettings = args.contextData.props?.itemSettings;
const itemType = args.contextData.props?.itemType;
const isFavourite = itemSettings?.P?.isFavourite || false;

return {
  icon: isFavourite ? "carbon:favorite-filled" : "carbon:favorite",
  text: isFavourite ? "Remove from favourites" : "Add to favourites",
  onClick: async (e) => {
    e?.stopPropagation();
    await args.fns.toggleFavourite?.(item, itemType);
    args.contextData.floatingMenuContext?.closeMenu?.();
  }
};
'''
      }
    },
    {
      id: "menu_item_add_to_playlist",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "YTOMenuItem",
        slot: "menu-items",
        props: '''
const item = args.contextData.props?.item;
const itemType = args.contextData.props?.itemType;

return {
  icon: "material-symbols:playlist-add",
  text: "Add to playlist",
  hide: itemType !== "video",
  onClick: (e) => {
    e?.stopPropagation();
    args.fns.openAddToPlaylistModal?.(item);
    args.contextData.floatingMenuContext?.closeMenu?.();
  }
};
'''
      }
    },
    {
      id: "menu_divider",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "YTOMenuItem",
        slot: "menu-items",
        props: '''
return {
  isDivider: true
};
'''
      }
    },
    {
      id: "menu_item_open_youtube",
      L: "Attr",
      P: {
        displayOrder: 5,
        componentName: "YTOMenuItem",
        slot: "menu-items",
        props: '''
const item = args.contextData.props?.item;
const itemType = args.contextData.props?.itemType;
const youtubeId = item?.P?.youtubeId || "";

let youtubeUrl = "";
if (itemType === "channel") {
  youtubeUrl = `https://www.youtube.com/channel/${youtubeId}`;
} else if (itemType === "playlist") {
  youtubeUrl = `https://www.youtube.com/playlist?list=${youtubeId}`;
} else {
  youtubeUrl = `https://www.youtube.com/watch?v=${youtubeId}`;
}

return {
  icon: "carbon:launch",
  text: "Open in YouTube",
  onClick: (e) => {
    e?.stopPropagation();
    window.open(youtubeUrl, "_blank");
    args.contextData.floatingMenuContext?.closeMenu?.();
  }
};
'''
      }
    },
    {
      id: "menu_item_edit_name",
      L: "Attr",
      P: {
        displayOrder: 6,
        componentName: "YTOMenuItem",
        slot: "menu-items",
        props: '''
const item = args.contextData.props?.item;
const itemSettings = args.contextData.props?.itemSettings;
const itemType = args.contextData.props?.itemType;

return {
  icon: "carbon:edit",
  text: "Edit custom name",
  onClick: (e) => {
    e?.stopPropagation();
    args.fns.openCustomNameModal?.(item, itemType, itemSettings);
    args.contextData.floatingMenuContext?.closeMenu?.();
  }
};
'''
      }
    },
    {
      id: "menu_item_delete",
      L: "Attr",
      P: {
        displayOrder: 7,
        componentName: "YTOMenuItem",
        slot: "menu-items",
        props: '''
const item = args.contextData.props?.item;
const itemSettings = args.contextData.props?.itemSettings;
const itemType = args.contextData.props?.itemType;

return {
  icon: "carbon:trash-can",
  text: "Delete",
  type: "danger",
  onClick: (e) => {
    e?.stopPropagation();
    const itemData = {[itemType]: item, [`${itemType}Settings`]: itemSettings};

    // Call appropriate delete function based on item type
    if (itemType === "video") {
      args.fns.deleteVideo?.(itemData);
    } else {
      args.fns.deleteItem?.(itemData, itemType);
    }

    args.contextData.floatingMenuContext?.closeMenu?.();
  }
};
'''
      }
    }
