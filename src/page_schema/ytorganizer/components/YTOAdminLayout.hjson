{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "YTOAdminLayout",
        description: "Admin layout wrapper that renders children slot"
      }
    },
    {
      id: "root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        description: "Admin layout container",
        fns: '''
if (!args.fns.checkAdminRole()) {
  args.navigate('/home');
  args.showErrorToast("Admin access required");
  return {};
}
''',
        props: '''
return {
  as: "div",
  onMount: () => {
    // Add admin navigation sections only if not already added
    if (args.fns.setNavigationSections && args.fns.navigationSections) {
      const currentSections = args.fns.navigationSections();
      const hasAdminSection = currentSections.some(section => section.id === "admin");

      if (!hasAdminSection) {
        const adminNavigationSections = [
          {
            id: "admin",
            title: "Admin",
            items: [
              // {
              //   id: "admin_home",
              //   href: "/yto/admin",
              //   label: "Dashboard",
              //   icon: "carbon:dashboard-reference",
              //   title: "Admin dashboard home",
              //   pathCheck: (pathname) => pathname === "/yto/admin" || pathname === "/yto/admin/"
              // },
              {
                id: "worker_health",
                href: "/yto/admin/worker-health",
                label: "Worker Health",
                icon: "carbon:dashboard",
                title: "Monitor background workers and queue status",
                pathCheck: (pathname) => pathname === "/yto/admin/worker-health"
              },
              {
                id: "user_management",
                href: "/yto/admin/users",
                label: "Manage Users",
                icon: "carbon:user-multiple",
                title: "View and manage all users",
                pathCheck: (pathname) => pathname === "/yto/admin/users"
              },
              {
                id: "api_keys",
                href: "/yto/admin/api-keys",
                label: "API Keys",
                icon: "carbon:key",
                title: "Manage YouTube API keys",
                pathCheck: (pathname) => pathname === "/yto/admin/api-keys"
              },
              {
                id: "global_settings",
                href: "/admin/GlobalSettings",
                label: "Global Settings",
                icon: "carbon:settings",
                title: "Configure system-wide settings",
                pathCheck: (pathname) => pathname.startsWith("/admin/GlobalSettings") && !args.searchParams?.tab,
                openInNewTab: true
              },
              {
                id: "workers",
                href: "/admin/GlobalSettings?tab=workers",
                label: "Workers",
                icon: "carbon:task",
                title: "Manage background workers and scheduled tasks",
                pathCheck: (pathname) => pathname.startsWith("/admin/GlobalSettings") && args.searchParams?.tab === "workers",
                openInNewTab: true
              }
            ]
          }
        ];

        args.fns.setNavigationSections(v => [...v, ...adminNavigationSections]);
      }
    }
  }
};
''',
        css: '''
return `._id {
  width: 100%;
}`;
'''
      }
    },
    {
      id: "children_slot",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Slot",
        description: "Renders the page content",
        slot: "children"
      }
    }
  ],
  edges: [
    { id: "e1", T: "Attr", S: "component_root", E: "root" },
    { id: "e2", T: "Attr", S: "root", E: "children_slot" }
  ]
}
