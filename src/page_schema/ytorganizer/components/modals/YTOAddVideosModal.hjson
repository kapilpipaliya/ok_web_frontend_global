    {
      id: "playlist_selector",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "YTOTomSelect",
        props: '''
const playlists = args.fns.playlists();
const isLoadingPlaylists = args.fns.isLoadingPlaylists();

// Convert playlists to options format
const options = playlists.map(playlistData => {
  const playlist = playlistData.playlist;
  const playlistSetting = playlistData.playlistSetting;
  const ownership = playlistData.ownership;

  const title = playlistSetting?.P?.customName || playlist.P.title || playlist.P.youtubeId;
  const youtubeId = playlist.P.youtubeId;
  const ownershipKey = ownership?.P?.key || "";

  return {
    value: youtubeId,
    label: title,
    ownershipId: ownershipKey
  };
});

return {
  value: args.fns.selectedPlaylistId(),
  options: options,
  placeholder: isLoadingPlaylists ? "Loading playlists..." : "Select a playlist",
  disabled: isLoadingPlaylists,
  onChange: (value, optionData) => {
    args.fns.setSelectedPlaylistId(value);

    // Get ownershipId from the option data passed by TomSelect
    const ownershipKey = optionData?.ownershipId || "";
    args.fns.setSelectedOwnershipId(ownershipKey);

    if (!ownershipKey) {
      console.error("Playlist selection missing ownershipId:", value);
    }
  },
  search: true,
  required: true
};
'''
      }
    },
    {
      id: "modal_textarea",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "YTOTextArea",
        props: '''
return {
  value: args.fns.videoUrlsInput(),
  onChange: (e) => args.fns.setVideoUrlsInput(e.target.value),
  placeholder: "https://www.youtube.com/watch?v=...\nhttps://www.youtube.com/watch?v=...",
  rows: 4
};
'''
