    },
    {
      id: "modal_overlay",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
const [videoUrlsInput, setVideoUrlsInput] = args.createSignal("");
const [selectedPlaylistId, setSelectedPlaylistId] = args.createSignal("");
const [selectedOwnershipId, setSelectedOwnershipId] = args.createSignal("");
const [playlists, setPlaylists] = args.createSignal([]);
const [isLoadingPlaylists, setIsLoadingPlaylists] = args.createSignal(false);
const [isAddingVideos, setIsAddingVideos] = args.createSignal(false);
const [formError, setFormError] = args.createSignal(null);

// Check if playlist is provided or needs to be selected
const needsPlaylistSelection = () => {
  const playlist = args.contextData.props?.playlist;
  return !playlist;
};

// Fetch all playlists (only when playlist not provided)
const fetchPlaylists = async () => {
  if (!needsPlaylistSelection()) return;

  setIsLoadingPlaylists(true);
  try {
    const result = await args.fns.executeYTOFunction("getUserPlaylists", {
      sortBy: "title_asc"
    });

    if (result?.error) {
      console.error("Error loading playlists:", result.error);
      args.showErrorToast(result.error);
      setPlaylists([]);
    } else if (result?.result?.success && result?.result?.data) {
      const playlistsData = result.result.data.playlists || [];

      // Filter out playlists without ownership to prevent errors
      const validPlaylists = playlistsData.filter(p => p.ownership && p.ownership.P && p.ownership.P.key);

      // Warn if any playlists are missing ownership
      if (validPlaylists.length < playlistsData.length) {
        console.warn(`${playlistsData.length - validPlaylists.length} playlists filtered out due to missing ownership information`);
      }

      setPlaylists(validPlaylists);
    } else {
      const errorMessage = result?.result?.message || "Failed to load playlists";
      console.error("Error loading playlists:", errorMessage);
      args.showErrorToast(errorMessage);
      setPlaylists([]);
    }
  } catch (error) {
    console.error("Unexpected error fetching playlists:", error);
    args.showErrorToast("Failed to load playlists");
    setPlaylists([]);
  } finally {
    setIsLoadingPlaylists(false);
  }
};

// Load playlists when modal opens (if needed)
args.createEffect(() => {
  const isOpen = args.contextData.props?.isOpen;
  const getIsOpen = isOpen?.() || false;

  if (getIsOpen) {
    if (needsPlaylistSelection()) {
      fetchPlaylists();
      setSelectedPlaylistId("");
      setSelectedOwnershipId("");
    }
    // Pre-fill video URL if provided
    const videoUrl = args.contextData.props?.videoUrl || "";
    setVideoUrlsInput(videoUrl);
    setFormError(null);
  }
});

const closeModal = () => {
  setVideoUrlsInput("");
  setSelectedPlaylistId("");
  setSelectedOwnershipId("");
  setFormError(null);
  const onClose = args.contextData.props?.onClose;
  onClose?.();
};

const addVideosToPlaylist = async () => {
  const playlist = args.contextData.props?.playlist;

  // Determine playlistId and ownershipId
  let playlistId, ownershipId;

  if (playlist) {
    // Mode 1: Playlist provided as prop (existing behavior)
    playlistId = playlist.P.youtubeId;
    // Try to get ownershipId from playlist data structure
    // It might be in different places depending on how the playlist was fetched
    ownershipId = playlist.ownershipId || playlist.P?.ownershipId;

    // If ownershipId still not found, we'll let the server handle it
    // (the server function might have fallback logic)
    if (!ownershipId) {
      console.warn("Ownership ID not found in playlist data, proceeding without it");
    }
  } else {
    // Mode 2: User selects playlist from dropdown
    playlistId = selectedPlaylistId();
    ownershipId = selectedOwnershipId();

    if (!playlistId) {
      const errorMsg = "Please select a playlist";
      setFormError(errorMsg);
      args.showErrorToast(errorMsg);
      return;
    }

    if (!ownershipId || ownershipId === "") {
      const errorMsg = "Ownership information not found for this playlist. Please try another playlist.";
      setFormError(errorMsg);
      args.showErrorToast(errorMsg);
      console.error("Selected playlist missing ownership:", { playlistId, ownershipId });
      return;
    }
  }

  const urlsText = videoUrlsInput().trim();
  if (!urlsText) {
    const errorMsg = "Please enter at least one video URL";
    setFormError(errorMsg);
    args.showErrorToast(errorMsg);
    return;
  }

  setFormError(null);
  setIsAddingVideos(true);

  try {
    const result = await args.fns.executeYTOFunction("addVideoToPlaylist", {
      ownershipId: ownershipId,
      playlistId: playlistId,
      videoUrl: urlsText
    });

    if (result?.result?.success) {
      args.showSuccessToast(result.result.message || "Videos added successfully");
      const onSuccess = args.contextData.props?.onSuccess;
      onSuccess?.();
      closeModal();
    } else {
      const errorMsg = result?.result?.message || "Failed to add videos to playlist";
      setFormError(errorMsg);
      args.showErrorToast(errorMsg);
    }
  } catch (error) {
    console.error("Error adding videos:", error);
    const errorMsg = error?.message || "An error occurred while adding videos";
    setFormError(errorMsg);
    args.showErrorToast(errorMsg);
  } finally {
    setIsAddingVideos(false);
  }
};

return {
  videoUrlsInput,
  setVideoUrlsInput,
  selectedPlaylistId,
  setSelectedPlaylistId,
  selectedOwnershipId,
  setSelectedOwnershipId,
  playlists,
  isLoadingPlaylists,
  isAddingVideos,
  formError,
  setFormError,
  closeModal,
  addVideosToPlaylist,
  needsPlaylistSelection
};
''',
        props: '''
const isOpen = args.contextData.props?.isOpen;
const getIsOpen = isOpen?.() || false;

return {
  as: "div",
  hide: !getIsOpen,
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      args.fns.closeModal();
    }
  }
};
''',
        css: '''
return `._id {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}`;
'''
      }
    },
