return `._id {
  background: ${args.theme.var.color.background};
  border-radius: 0.75rem;
  width: 100%;
  max-width: 800px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  animation: slideUp 0.3s ease;
}

@media (max-width: 768px) {
  ._id {
    max-width: 100%;
    max-height: 100vh;
    height: 100vh;
    border-radius: 0;
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}`;
'''
        displayOrder: 1
        fns:
          '''
const getInitialConfig = () => args.contextData.props?.initialConfig || "";
const getContentType = () => args.contextData.props?.contentType;
const onSave = args.contextData.props?.onSave;
const rbConfirm = args.contextData?.confirmContext?.rbConfirm;

// State
const [configText, setConfigText] = args.createSignal("");
const [isLoadingDefault, setIsLoadingDefault] = args.createSignal(false);
const [isExampleExpanded, setIsExampleExpanded] = args.createSignal(false);

// Initialize from props
const initialize = () => {
  const initial = getInitialConfig();
  if (typeof initial === "string") {
    // If it's already a string (function body), use it directly
    setConfigText(initial);
  } else if (initial && typeof initial === "object") {
    // If it's an object, convert to function body format
    try {
      const objString = JSON.stringify(initial, null, 2);
      // Wrap in return statement for function body
      setConfigText(`return ${objString};`);
    } catch (e) {
      setConfigText("return {};");
    }
  } else {
    // Default empty function body
    setConfigText("return {};");
  }
};

// Load default settings
const handleLoadDefault = async () => {
  if (!rbConfirm) {
    if (args.showErrorToast) {
      args.showErrorToast("Confirmation dialog not available");
    }
    return;
  }

  const contentType = getContentType();
  if (!contentType) {
    if (args.showErrorToast) {
      args.showErrorToast("Content type not available");
    }
    return;
  }

  // Show confirmation
  const confirmed = await rbConfirm({
    title: "Load Default Settings",
    message: "This will replace your current configuration with the default settings. Are you sure you want to continue?",
    confirmText: "Load Default",
    cancelText: "Cancel",
    variant: "primary"
  });

  if (!confirmed) {
    return;
  }

  try {
    setIsLoadingDefault(true);

    // Fetch default settings
    const result = await args.fns.executeYTOFunction("getUserContentSetting", {
      contentType,
      key: `${contentType}_settings_default`
    });

    if (result?.error) {
      if (args.showErrorToast) {
        args.showErrorToast(result.error);
      }
      return;
    }

    if (result?.result?.success && result.result.data?.setting) {
      const settingData = result.result.data.setting.P || {};
      const configText = settingData.config;

      if (typeof configText === 'string') {
        setConfigText(configText);
        if (args.showSuccessToast) {
          args.showSuccessToast("Default settings loaded successfully");
        }
      } else {
        if (args.showErrorToast) {
          args.showErrorToast("Default settings not found or invalid");
        }
      }
    } else {
      if (args.showErrorToast) {
        args.showErrorToast("Default settings not found");
      }
    }
  } catch (error) {
    console.error("Error loading default settings:", error);
    if (args.showErrorToast) {
      args.showErrorToast(error.message || "Failed to load default settings");
    }
  } finally {
    setIsLoadingDefault(false);
  }
};

// Handle save
const handleSave = () => {
  if (!onSave) return;

  try {
    const text = configText().trim();
    if (!text) {
      throw new Error("Configuration cannot be empty");
    }

    // Validate that it's a valid function body by trying to create a function
    try {
      const configFunction = new Function(text);
      const config = configFunction();

      if (!config || typeof config !== "object") {
        throw new Error("Function must return an object.");
      }
    } catch (validationError) {
      throw new Error(validationError.message || "Invalid function body syntax");
    }

    // Save the raw text (function body), not the evaluated result
    onSave(text);
  } catch (error) {
    console.error("Error validating config:", error);
    // Use alert as fallback if showErrorToast is not available
    if (args.showErrorToast) {
      args.showErrorToast(error.message || "Invalid configuration syntax");
    } else {
      alert(error.message || "Invalid configuration syntax");
    }
  }
};

const toggleExample = () => {
  setIsExampleExpanded(!isExampleExpanded());
};

const getDetailedExample = () => {
  return `return {
  // Table columns configuration
  columns: [
    {
      key: "name",
      label: "Name",
      type: "text",
      sortable: true,
      filterable: true,
      editable: true,
      required: true,
      width: "200px"
    },
    {
      key: "description",
      label: "Description",
      type: "text",
      sortable: true,
      filterable: true,
      editable: true,
      width: "300px"
    },
    {
      key: "year",
      label: "Year",
      type: "number",
      sortable: true,
      filterable: true,
      editable: true,
      width: "100px"
    },
    {
      key: "language",
      label: "Language",
      type: "select",
      sortable: true,
      filterable: true,
      editable: true,
      options: ["English", "Spanish", "French"],
      width: "150px"
    },
    {
      key: "isActive",
      label: "Active",
      type: "checkbox",
      sortable: true,
      filterable: true,
      editable: true,
      width: "80px"
    },
    {
      key: "createdAt",
      label: "Created",
      type: "isoDateTime",
      sortable: true,
      filterable: true,
      editable: false,
      width: "180px"
    },
    {
      key: "preview",
      label: "Preview",
      type: "image",
      sortable: false,
      filterable: false,
      editable: true,
      width: "120px"
    },
    {
      key: "download",
      label: "Download",
      type: "link",
      sortable: false,
      filterable: false,
      editable: false,
      width: "100px"
    }
  ],

  // Form configuration
  formConfig: {
    gridColumns: 2, // Number of columns in form grid
    fields: [
      {
        key: "name",
        label: "Name",
        type: "text",
        required: true,
        gridSpan: 2 // Span across 2 columns
      },
      {
        key: "description",
        label: "Description",
        type: "textarea",
        required: false,
        gridSpan: 2
      },
      {
        key: "year",
        label: "Year",
        type: "number",
        required: false,
        gridSpan: 1
      },
      {
        key: "language",
        label: "Language",
        type: "select",
        required: false,
        options: ["English", "Spanish", "French"],
        gridSpan: 1
      },
      {
        key: "isActive",
        label: "Active",
        type: "checkbox",
        required: false,
        gridSpan: 1
      }
    ],
    saveFunction: null // Optional: custom save function
  },

  // Unique keys for validation
  uniqueKeys: ["name", "year"], // Fields that must be unique

  // Table display options
  title: "My Table",
  rowHeight: 50,
  showRowNumber: true,
  showSelection: true,
  showActions: true,
  resizableColumns: true,
  searchPlaceholder: "Search...",

  // Additional filter fields (displayed above table)
  additionalFilters: [
    {
      key: "status",
      label: "Status",
      type: "select",
      options: ["active", "inactive", "pending"]
    }
  ],

  // Custom actions (displayed in table header)
  customActions: [
    {
      label: "Custom Action",
      onClick: (selectedRows) => {
        console.log("Custom action", selectedRows);
      }
    }
  ],

  // Batch actions (displayed when rows are selected)
  batchActions: [
    {
      label: "Delete Selected",
      onClick: (selectedRows) => {
        console.log("Delete", selectedRows);
      },
      variant: "danger"
    }
  ],

  // Columns to hide conditionally
  hideColumns: ["download"], // Hide these columns

  // Show/hide buttons
  showAddButton: true,
  showEditButton: true,

  // Data and function props (optional when loadFromSetting is true)
  dataFunction: null, // Optional: custom data fetching function
  importFunction: null, // Optional: custom import function
  exportFunction: null // Optional: custom export function
};`;
};

return {
  configText,
  setConfigText,
  initialize,
  handleSave,
  handleLoadDefault,
  isLoadingDefault,
  isExampleExpanded,
  toggleExample,
  getDetailedExample
};
'''
        componentName: Html
        props:
          '''
return {
  as: "div",
  onClick: (e) => e.stopPropagation(),
  onMount: () => {
    args.fns.initialize();
  }
};
'''
      }
