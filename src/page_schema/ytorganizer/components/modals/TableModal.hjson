const isOpen = args.contextData.props?.isOpen || false;
const onClose = args.contextData.props?.onClose;

return {
  as: "div",
  hide: !isOpen,
  onClick: (e) => {
    if (e.target === e.currentTarget && onClose) {
      onClose();
    }
  }
};
'''
