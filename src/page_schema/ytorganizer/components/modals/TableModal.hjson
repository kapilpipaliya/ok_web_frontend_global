        displayOrder: 2
        componentName: Html
        props:
          '''
const field = args.contextData.field;
const formData = args.fns.formData;
const value = formData[field.key] || "";
const setFormData = args.fns.setFormData;

// Render appropriate input based on field type
if (field.type === "textArea") {
  return {
    componentName: "TextArea",
    value: value,
    onChange: (e) => { setFormData({  [field.key]: e.target.value });     },
    placeholder: field.placeholder || "",
    required: field.required || false,
    maxLength: field.maxLength
  };
}

if (field.type === "select" && field.options) {
  return {
    componentName: "TomSelect",

      value: value,
      onChange: (newValue) => {
        setFormData({  [field.key]: newValue });
      },
      options: field.options,
      placeholder: field.placeholder || "Select...",
      required: field.required || false

  };
}

if (field.type === "checkbox") {
  return {
    as: "input",
    type: "checkbox",
    checked: value === true || value === "true",
    onChange: (e) => {
      setFormData({  [field.key]: e.target.checked });
    }
  };
}

if (field.type === "date") {
  return {
    as: "input",
    type: "date",
    value: value,
    onChange: (e) => {
      setFormData({  [field.key]: e.target.value });
    },
    required: field.required || false
  };
}

if (field.type === "number") {
  return {
    componentName: "TextInput",
      type: "number",
      value: value,
      onChange: (e) => {
        setFormData({  [field.key]: e.target.value });
      },
      placeholder: field.placeholder || "",
      required: field.required || false,
      min: field.min,
      max: field.max
  };
}

// Default: text input
return {
  componentName: "TextInput",
    type: field.type === "email" ? "email" : "text",
    value: value,
    onChange: (e) => {
      setFormData({  [field.key]: e.target.value });
    },
    placeholder: field.placeholder || "",
    required: field.required || false,
    maxLength: field.maxLength,
    minLength: field.minLength
};
'''
      }
    }
