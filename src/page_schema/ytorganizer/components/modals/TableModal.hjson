return `._id {
  background: ${args.theme.var.color.background};
  border-radius: 0.75rem;
  width: 100%;
  max-width: 600px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  animation: slideUp 0.3s ease;
}

@media (max-width: 768px) {
  ._id {
    max-width: 100%;
    max-height: 100vh;
    height: 100vh;
    border-radius: 0;
    animation: slideUpMobile 0.3s ease;
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes slideUpMobile {
  from {
    opacity: 0;
    transform: translateY(100%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}`;
'''
        displayOrder: 1
        fns:
          '''
const getFormConfig = () => args.contextData.props?.formConfig;
const getInitialData = () => args.contextData.props?.initialData || {};
const getMode = () => args.contextData.props?.mode || "add";

// Form state
const [formData, setFormData] = args.createStore({});
const [errors, setErrors] = args.createStore({});
const [isSubmitting, setIsSubmitting] = args.createSignal(false);

// Initialize form data
const initializeForm = () => {
  const formConfig = getFormConfig();
  const initialData = getInitialData() || {};
  const mode = getMode();

  if (!formConfig?.fields) {
    setFormData({});
    return;
  }

  const initial = {};
  formConfig.fields.forEach(field => {
    if (mode === "edit" && initialData[field.key] !== undefined) {
      initial[field.key] = initialData[field.key];
    } else {
      initial[field.key] = field.defaultValue !== undefined ? field.defaultValue : "";
    }
  });

  setFormData(initial);
  setErrors({});
};

// Validate form
const validate = () => {
  const formConfig = getFormConfig();
  if (!formConfig?.fields) return true;

  const newErrors = {};
  formConfig.fields.forEach(field => {
    const value = formData[field.key];

    if (field.required && (value === undefined || value === null || value === "")) {
      newErrors[field.key] = `${field.label || field.key} is required`;
    }

    if (field.type === "email" && value && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(value)) {
      newErrors[field.key] = "Invalid email format";
    }

    if (field.minLength && value && String(value).length < field.minLength) {
      newErrors[field.key] = `Must be at least ${field.minLength} characters`;
    }

    if (field.maxLength && value && String(value).length > field.maxLength) {
      newErrors[field.key] = `Must be at most ${field.maxLength} characters`;
    }
  });

  setErrors(newErrors);
  return Object.keys(newErrors).length === 0;
};

// Handle save
const handleSave = async () => {
  if (!validate()) {
    args.showErrorToast?.("Please fix form errors");
    return;
  }

  const onSave = args.contextData.props?.onSave;
  if (!onSave) {
    args.showErrorToast?.("Save function not provided");
    return;
  }

  setIsSubmitting(true);
  try {
    await onSave(formData);
  } catch (error) {
    console.error("Error saving:", error);
    args.showErrorToast?.("Failed to save");
  } finally {
    setIsSubmitting(false);
  }
};

return {
  getFormConfig,
  getInitialData,
  getMode,
  formData,
  setFormData,
  errors,
  setErrors,
  isSubmitting,
  setIsSubmitting,
  initializeForm,
  validate,
  handleSave
};
'''
