{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "YTOFeedbackModal"
      }
    },
    {
      id: "modal_overlay",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
const [feedback, setFeedback] = args.createSignal("");
const [category, setCategory] = args.createSignal("general");
const [email, setEmail] = args.createSignal("");
const [isSubmitting, setIsSubmitting] = args.createSignal(false);

const initializeFeedback = () => {
  setFeedback("");
  setCategory("general");
  setEmail("");
  setIsSubmitting(false);
};

const handleSubmit = async () => {
  const feedbackValue = feedback().trim();
  const isAnonymous = args.contextData.props?.isAnonymous;

  if (!feedbackValue) {
    args.showErrorToast("Please enter your feedback");
    return;
  }

  // Validate email for anonymous feedback
  if (isAnonymous) {
    const emailValue = email().trim();
    if (!emailValue) {
      args.showErrorToast("Please enter your email address");
      return;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(emailValue)) {
      args.showErrorToast("Please enter a valid email address");
      return;
    }
  }

  const onSubmit = args.contextData.props?.onSubmit;
  const onClose = args.contextData.props?.onClose;

  setIsSubmitting(true);

  try {
    if (onSubmit) {
      const data = {
        feedback: feedbackValue,
        category: category()
      };

      // Add email for anonymous feedback
      if (isAnonymous) {
        data.email = email().trim();
      }

      await onSubmit(data);
    }

    onClose?.();
  } catch (error) {
    console.error("Error submitting feedback:", error);
  } finally {
    setIsSubmitting(false);
  }
};

return {
  feedback,
  setFeedback,
  category,
  setCategory,
  email,
  setEmail,
  isSubmitting,
  initializeFeedback,
  handleSubmit
};
''',
        props: '''
const isOpen = args.contextData.props?.isOpen;
const getIsOpen = isOpen?.() || false;
const onClose = args.contextData.props?.onClose;

return {
  as: "div",
  hide: !getIsOpen,
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      onClose?.();
    }
  },
  onMount: () => {
    args.fns.initializeFeedback();
  }
};
''',
        css: '''
return `._id {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  animation: fadeIn 0.2s ease;
  overflow-y: auto;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@media (max-width: 768px) {
  ._id {
    padding: 0.5rem;
    align-items: flex-start;
    padding-top: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "modal_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  onClick: (e) => e.stopPropagation()
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.background};
  border-radius: 0.75rem;
  width: 100%;
  max-width: 600px;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  animation: slideUp 0.3s ease;
  max-height: 90vh;
  overflow: hidden;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-width: 768px) {
  ._id {
    max-width: 100%;
    max-height: calc(100vh - 4rem);
    border-radius: 0.5rem;
  }
}`;
'''
      }
    },
