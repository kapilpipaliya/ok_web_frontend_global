  animation: slideUp 0.3s ease;
  max-height: 90vh;
  overflow: hidden;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-width: 768px) {
  ._id {
    max-width: 100%;
    max-height: calc(100vh - 4rem);
    border-radius: 0.5rem;
  }
}`;
