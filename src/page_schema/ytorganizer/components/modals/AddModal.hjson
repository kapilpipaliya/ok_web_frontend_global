const editMode = c.props?.editMode || false;
const itemData = c.props?.itemData;
const isProcessing = f.isProcessing();

if (!editMode || !itemData || isProcessing) {
  return { as: "div", hide: true };
}

// Determine actual item type from itemData structure
let itemType, data;
if (itemData.video) {
  itemType = "Video";
  data = itemData.video;
} else if (itemData.playlist) {
  itemType = "Playlist";
  data = itemData.playlist;
} else {
  itemType = "Channel";
  data = itemData.channel?.channel || itemData.channel;
}

const itemName = data?.P?.title || "";

return {
  as: "div",
  text: `YouTube ${itemType}: ${itemName}`
};
