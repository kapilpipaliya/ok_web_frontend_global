const contentType = c.props?.contentType || "channels";
const editMode = c.props?.editMode || false;
const itemData = c.props?.itemData;
const isProcessing = f.isProcessing();

// In edit mode, determine type from itemData structure
let actualType = contentType;
if (editMode && itemData) {
  if (itemData.video) {
    actualType = "videos";
  } else if (itemData.playlist) {
    actualType = "playlists";
  } else {
    actualType = "channels";
  }
}

let title;
if (isProcessing) {
  const itemTypeName = contentType === "playlists" ? "Playlist" : "Channel";
  title = `${itemTypeName} Processing`;
} else {
  title = editMode
    ? (actualType === "videos" ? "Edit Video Setting" : (actualType === "playlists" ? "Edit Playlist Setting" : "Edit Channel Setting"))
    : (contentType === "playlists" ? "Add Playlist" : "Add Channel");
}

return {
  as: "h2",
  text: title
};
'''
