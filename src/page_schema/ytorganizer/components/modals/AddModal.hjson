        props:
          '''
const contentType = c.props?.contentType || "channels";
const itemType = contentType === "playlists" ? "playlist" : "channel";

return {
  as: "p",
  text: `Processing may take 5-10 minutes depending on the size of the ${itemType}. Please wait until processed.`
};
'''
      }
    }
    {
      id: "36"
      L: Attr
      P: {
        css:
          '''
return `._id {
  padding: 1.5rem;
  border-top: 1px solid ${t.var.color.border};
  display: flex;
  gap: 1rem;
  justify-content: flex-end;
}

@media (max-width: 768px) {
  ._id {
    flex-direction: column-reverse;
  }
}`;
'''
        displayOrder: 3
        componentName: Html
        props:
          '''
return {
  as: "footer",
  hide: f.isProcessing()
};
'''
      }
    }
    {
      id: "37"
      L: Attr
      P: {
        displayOrder: 1
        componentName: Button
        props:
          '''
const onClose = c.props?.onClose || (() => {});

return {
  text: "Cancel",
  variant: "secondary",
  onClick: onClose,
  disabled: f.isSubmitting()
};
'''
      }
    }
    {
      id: "38"
      L: Attr
      P: {
        displayOrder: 2
        componentName: Button
        props:
          '''
const isSubmitting = f.isSubmitting();
const editMode = c.props?.editMode || false;

const buttonText = isSubmitting
  ? (editMode ? "Updating..." : "Saving...")
  : (editMode ? "Update" : "Save");

return {
  text: buttonText,
  variant: "primary",
  onClick: f.handleSave,
  disabled: isSubmitting
};
'''
      }
    }
  ]
