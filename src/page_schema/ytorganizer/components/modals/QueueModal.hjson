{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "QueueModal"
      }
    },
    {
      id: "modal_overlay",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const getIsOpen = args.contextData.props?.isOpen;
const isOpen = getIsOpen?.() || false;
const onClose = args.contextData.props?.onClose;

return {
  as: "div",
  hide: !isOpen,
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      onClose?.();
    }
  }
};
''',
        css: '''
return `._id {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}`;
'''
      }
    },
    {
      id: "modal_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  onClick: (e) => e.stopPropagation()
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.background};
  border-radius: 0.75rem;
  width: 100%;
  max-width: 600px;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}`;
'''
      }
    },
    {
      id: "modal_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.5rem;
  border-bottom: 1px solid ${args.theme.var.color.border};
}`;
'''
      }
    },
    {
      id: "modal_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const queue = args.contextData.props?.videoQueue?.() || [];

return {
  as: "h2",
  text: `Video Queue (${queue.length})`
};
''',
        css: '''
return `._id {
  font-size: 1.5rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
  margin: 0;
}`;
'''
      }
    },
    {
      id: "modal_close_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const onClose = args.contextData.props?.onClose;

return {
  as: "button",
  onClick: onClose,
  "aria-label": "Close modal"
};
''',
        css: '''
return `._id {
  background: none;
  border: none;
  color: ${args.theme.var.color.muted};
  cursor: pointer;
  padding: 0.5rem;
  border-radius: 0.375rem;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;

  &:hover {
    background: ${args.theme.var.color.background_light_200};
    color: ${args.theme.var.color.text};
  }
}`;
'''
      }
    },
    {
      id: "modal_close_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
