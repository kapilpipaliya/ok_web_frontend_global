      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
const item = args.contextData.loopItem;
const removeFromQueue = args.contextData.props?.removeFromQueue;

return {
  as: "button",
  onClick: () => {
    if (item && typeof item.index !== 'undefined') {
      removeFromQueue?.(item.index);
    }
  },
  "aria-label": "Remove from queue",
  title: "Remove"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.background_light_300};
  color: ${args.theme.var.color.text};
  border: none;
  border-radius: 0.375rem;
  padding: 0.375rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  width: 32px;
  height: 32px;

  &:hover {
    background: ${args.theme.var.color.error};
    color: ${args.theme.var.color.error_text};
    transform: scale(1.05);
  }
}`;
'''
      }
    },
    {
      id: "queue_item_remove_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:trash-can",
  width: 16,
  height: 16
};
'''
      }
    },
    {
      id: "modal_footer",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const queue = args.contextData.props?.videoQueue?.() || [];

return {
  as: "div",
  hide: queue.length === 0
};
''',
        css: '''
return `._id {
  padding: 1rem 1.5rem;
  border-top: 1px solid ${args.theme.var.color.border};
  display: flex;
  justify-content: space-between;
  align-items: center;
}`;
'''
      }
    },
    {
      id: "modal_footer_info",
