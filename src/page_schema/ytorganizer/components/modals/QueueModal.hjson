    {
      id: "queue_items_loop",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "loopItem",
        loop: true,
        props: '''
const queue = args.contextData.props?.videoQueue?.() || [];
const searchTerm = args.fns.searchTerm?.() || "";

// Filter queue based on search term
let filteredQueue = queue;
if (searchTerm.trim()) {
  const lowerSearch = searchTerm.toLowerCase();
  filteredQueue = queue.filter((video, index) => {
    const title = (video?.P?.title || "").toLowerCase();
    const channel = (video?.P?.channelTitle || "").toLowerCase();
    const position = (index + 1).toString();

    return title.includes(lowerSearch) ||
           channel.includes(lowerSearch) ||
           position.includes(lowerSearch);
  });
}

return {
  data: filteredQueue.map((video, index) => {
    // Find original index for queue operations
    const originalIndex = queue.findIndex(v => v?.P?.youtubeId === video?.P?.youtubeId);
    return { video, index: originalIndex };
  })
};
'''
