        displayOrder: 3
        componentName: Html
        props:
          '''
const selectedVideos = args.fns.selectedVideos?.() || new Set();

return {
  as: "button",
  hide: selectedVideos.size === 0,
  onClick: async () => {
    const queue = args.contextData.props?.videoQueue?.() || [];
    const setVideoQueue = args.contextData.props?.setVideoQueue;
    const executeYTOFunction = args.fns.executeYTOFunction;
    const getOwnershipId = args.contextData.props?.getOwnershipId;

    if (!setVideoQueue || !executeYTOFunction || selectedVideos.size === 0) return;

    const selectedIds = Array.from(selectedVideos);

    // Get positions of selected videos
    const positions = queue
      .map((v, index) => selectedIds.includes(v?.P?.youtubeId) ? index : -1)
      .filter(pos => pos !== -1);

    if (positions.length === 0) return;

    // Optimistically update the queue - remove all selected videos at once
    const newQueue = queue.filter(v => !selectedIds.includes(v?.P?.youtubeId));
    setVideoQueue(newQueue);

    // Clear selection immediately
    args.fns.clearSelection?.();

    // Make single API call to remove all videos
    const ownershipId = getOwnershipId?.();
    if (ownershipId && args.user) {
      try {
        const result = await executeYTOFunction("bulkRemoveFromQueue", {
          positions: positions
        });

        if (result?.result?.success) {
          // Update with server response to ensure consistency
          setVideoQueue(result.result.data || newQueue);
          args.showSuccessToast(result.result.message || `Removed ${positions.length} video(s) from queue`);
        } else {
          // Rollback on error
          setVideoQueue(queue);
          args.showErrorToast(result?.result?.message || result?.error || "Failed to remove videos from queue");
        }
      } catch (error) {
        // Rollback on error
        setVideoQueue(queue);
        args.showErrorToast("Failed to remove videos from queue");
        console.error("Error removing videos:", error);
      }
    } else {
      args.showSuccessToast(`Removed ${positions.length} video(s) from queue`);
    }
  },
  text: "Remove"
};
'''
      }
    }
