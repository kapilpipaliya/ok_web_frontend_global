  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.5rem;
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
  font-size: 1rem;
  outline: none;
  transition: all 0.2s ease;

  &:focus {
    border-color: ${args.theme.var.color.primary};
    box-shadow: 0 0 0 3px ${args.theme.var.color.primary_light_100};
  }

  &::placeholder {
    color: ${args.theme.var.color.muted};
  }
}`;
'''
      }
    },
    {
      id: "playlist_selector_footer",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  padding: 1.5rem;
  border-top: 1px solid ${args.theme.var.color.border};
  display: flex;
  gap: 0.75rem;
  justify-content: flex-end;
}`;
'''
      }
    },
    {
      id: "playlist_selector_cancel",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "button",
  onClick: () => args.fns.setShowPlaylistSelector?.(false),
  text: "Cancel"
};
''',
        css: '''
return `._id {
  padding: 0.625rem 1.25rem;
  background: ${args.theme.var.color.background_light_200};
  color: ${args.theme.var.color.text};
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.5rem;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;

  &:hover {
    background: ${args.theme.var.color.background_light_300};
  }
}`;
'''
      }
    },
    {
      id: "playlist_selector_save",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const showCreateNew = args.fns.showCreateNew?.() || false;
const savingToPlaylist = args.fns.savingToPlaylist?.() || false;
const newPlaylistName = args.fns.newPlaylistName?.() || "";
const selectedPlaylistId = args.fns.selectedPlaylistId?.();

const isDisabled = savingToPlaylist || (showCreateNew ? !newPlaylistName.trim() : !selectedPlaylistId);

return {
  as: "button",
  disabled: isDisabled,
  onClick: async () => {
    if (isDisabled) return;

    if (showCreateNew) {
      await args.fns.saveToNewPlaylist?.(newPlaylistName.trim());
    } else {
      await args.fns.saveToExistingPlaylist?.(selectedPlaylistId);
    }
  },
  text: savingToPlaylist ? "Saving..." : "Save"
};
''',
        css: '''
return `._id {
  padding: 0.625rem 1.25rem;
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  border: none;
  border-radius: 0.5rem;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;

  &:hover:not(:disabled) {
    background: ${args.theme.var.color.primary_dark_200};
  }

  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
}`;
'''
      }
    }
