}`;
'''
      }
    },
    {
      id: "bulk_select_all_checkbox",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const selectedVideos = args.fns.selectedVideos?.() || new Set();
const queue = args.contextData.props?.videoQueue?.() || [];
const allSelected = queue.length > 0 && selectedVideos.size === queue.length;
const someSelected = selectedVideos.size > 0 && selectedVideos.size < queue.length;

return {
  as: "input",
  type: "checkbox",
  checked: allSelected,
  indeterminate: someSelected,
  onClick: () => {
    if (allSelected || someSelected) {
      args.fns.clearSelection?.();
    } else {
      args.fns.selectAll?.();
    }
  }
};
''',
        css: '''
return `._id {
  width: 1.125rem;
  height: 1.125rem;
  cursor: pointer;
}`;
'''
      }
    },
    {
      id: "bulk_actions_text",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const selectedVideos = args.fns.selectedVideos?.() || new Set();

return {
  as: "span",
  text: selectedVideos.size > 0 ? `${selectedVideos.size} selected` : "Select videos"
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  color: ${args.theme.var.color.text};
  flex: 1;
}`;
'''
      }
    },
    {
      id: "bulk_remove_button",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const selectedVideos = args.fns.selectedVideos?.() || new Set();

return {
  as: "button",
  hide: selectedVideos.size === 0,
  onClick: async () => {
    const queue = args.contextData.props?.videoQueue?.() || [];
    const setVideoQueue = args.contextData.props?.setVideoQueue;
    const executeYTOFunction = args.fns.executeYTOFunction;
    const getOwnershipId = args.contextData.props?.getOwnershipId;

    if (!setVideoQueue || !executeYTOFunction || selectedVideos.size === 0) return;

    const selectedIds = Array.from(selectedVideos);

    // Get positions of selected videos
    const positions = queue
      .map((v, index) => selectedIds.includes(v?.P?.youtubeId) ? index : -1)
      .filter(pos => pos !== -1);

    if (positions.length === 0) return;

    // Optimistically update the queue - remove all selected videos at once
    const newQueue = queue.filter(v => !selectedIds.includes(v?.P?.youtubeId));
    setVideoQueue(newQueue);

    // Clear selection immediately
    args.fns.clearSelection?.();

    // Make single API call to remove all videos
    const ownershipId = getOwnershipId?.();
    if (ownershipId && args.user) {
      try {
        const result = await executeYTOFunction("bulkRemoveFromQueue", {
          positions: positions
        });

        if (result?.result?.success) {
          // Update with server response to ensure consistency
          setVideoQueue(result.result.data || newQueue);
          args.showSuccessToast(result.result.message || `Removed ${positions.length} video(s) from queue`);
        } else {
          // Rollback on error
          setVideoQueue(queue);
          args.showErrorToast(result?.result?.message || "Failed to remove videos from queue");
        }
      } catch (error) {
        // Rollback on error
        setVideoQueue(queue);
        args.showErrorToast("Failed to remove videos from queue");
        console.error("Error removing videos:", error);
      }
    } else {
      args.showSuccessToast(`Removed ${positions.length} video(s) from queue`);
    }
  },
  text: "Remove"
};
''',
        css: '''
return `._id {
  padding: 0.5rem 1rem;
  background: ${args.theme.var.color.error};
  color: ${args.theme.var.color.error_text};
  border: none;
  border-radius: 0.375rem;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;

  &:hover {
    background: ${args.theme.var.color.error_dark_200};
  }
}`;
'''
      }
    },
    {
      id: "bulk_move_top_button",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
const selectedVideos = args.fns.selectedVideos?.() || new Set();

return {
  as: "button",
  hide: selectedVideos.size === 0,
  onClick: async () => {
    const queue = args.contextData.props?.videoQueue?.() || [];
    const reorderQueue = args.contextData.props?.reorderQueue;

    if (!reorderQueue || selectedVideos.size === 0) return;

    // Find indices of selected videos
    const selectedIndices = queue
      .map((v, i) => selectedVideos.has(v?.P?.youtubeId) ? i : -1)
      .filter(i => i !== -1)
      .sort((a, b) => a - b);

    // Move each to the top in order
    for (let i = 0; i < selectedIndices.length; i++) {
      await reorderQueue(selectedIndices[i], i);
    }

    args.fns.clearSelection?.();
  },
  text: "Move to Top"
};
''',
        css: '''
