}`;
'''
      }
    },
    {
      id: "queue_items_container",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const queue = args.contextData.props?.videoQueue?.() || [];

return {
  as: "div",
