  width: 24,
  height: 24
};
'''
      }
    },
    {
      id: "modal_body",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  flex: 1;
  overflow: auto;
  padding: 1rem;
}`;
'''
      }
    },
    {
      id: "queue_list",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
