        displayOrder: 4
        componentName: Html
        props:
          '''
const selectedVideos = args.fns.selectedVideos?.() || new Set();

return {
  as: "button",
  hide: selectedVideos.size === 0,
  onClick: async () => {
    const queue = args.contextData.props?.videoQueue?.() || [];
    const reorderQueue = args.contextData.props?.reorderQueue;

    if (!reorderQueue || selectedVideos.size === 0) return;

    // Find indices of selected videos
    const selectedIndices = queue
      .map((v, i) => selectedVideos.has(v?.P?.youtubeId) ? i : -1)
      .filter(i => i !== -1)
      .sort((a, b) => a - b);

    // Move each to the top in order
    for (let i = 0; i < selectedIndices.length; i++) {
      await reorderQueue(selectedIndices[i], i);
    }

    args.fns.clearSelection?.();
  },
  text: "Move to Top"
};
'''
      }
    }
