    {
      id: "modal_footer_save_button",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const queue = args.contextData.props?.videoQueue?.() || [];
const savingToPlaylist = args.fns.savingToPlaylist?.() || false;

return {
  as: "button",
  disabled: queue.length === 0 || savingToPlaylist,
  onClick: async () => {
    if (queue.length === 0) {
      args.showWarningToast("Queue is empty");
      return;
    }

    const getOwnershipId = args.contextData.props?.getOwnershipId;
    const ownershipId = getOwnershipId?.();

    if (!ownershipId) {
      args.showErrorToast("Please select a YouTube account");
      return;
    }

    // Reset state
    args.fns.setNewPlaylistName?.("");
    args.fns.setSelectedPlaylistId?.(null);
    args.fns.setShowCreateNew?.(false);

    // Load existing playlists and show selector
    await args.fns.loadCustomPlaylists?.();
    args.fns.setShowPlaylistSelector?.(true);
  },
  text: savingToPlaylist ? "Saving..." : "Save as Playlist"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  border: none;
  border-radius: 0.375rem;
  padding: 0.5rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;

  &:hover {
    background: ${args.theme.var.color.primary_dark_200};
  }
}`;
'''
      }
