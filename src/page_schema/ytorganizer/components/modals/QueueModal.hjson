}`;
'''
      }
    },
    {
      id: "empty_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:playlist",
  width: 48,
  height: 48
};
''',
        css: '''
return `._id {
  opacity: 0.5;
  margin-bottom: 1rem;
}`;
'''
      }
    },
    {
      id: "empty_text",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "No videos in queue"
};
''',
        css: '''
return `._id {
