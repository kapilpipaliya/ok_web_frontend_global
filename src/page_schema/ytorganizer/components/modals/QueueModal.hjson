      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const queue = args.contextData.props?.videoQueue?.() || [];

return {
  as: "div",
  text: `${queue.length} video${queue.length !== 1 ? 's' : ''} in queue`
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  color: ${args.theme.var.color.muted};
}`;
'''
      }
    },
    {
      id: "modal_footer_clear_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const clearQueue = args.contextData.props?.clearQueue;

return {
  as: "button",
  onClick: clearQueue,
  text: "Clear All"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.error};
  color: ${args.theme.var.color.error_text};
  border: none;
  border-radius: 0.375rem;
  padding: 0.5rem 1rem;
