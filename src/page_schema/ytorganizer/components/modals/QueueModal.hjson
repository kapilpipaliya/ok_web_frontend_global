}`;
'''
      }
    },
    {
      id: "queue_items_loop",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "loopItem",
        loop: true,
        props: '''
const queue = args.contextData.props?.videoQueue?.() || [];

return {
  data: queue.map((video, index) => ({ video, index }))
};
'''
      }
    },
    {
      id: "queue_item_wrapper",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  background: ${args.theme.var.color.background};
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.5rem;
  padding: 0.75rem;
  transition: all 0.2s ease;

  &:hover {
    background: ${args.theme.var.color.background_light_50};
    border-color: ${args.theme.var.color.primary_light_200};
  }
}`;
'''
      }
    },
    {
      id: "queue_item_number",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.loopItem;

return {
  as: "div",
  text: `${(item?.index ?? 0) + 1}`
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.875rem;
  font-weight: 600;
  flex-shrink: 0;
  margin-top: 0.25rem;
}`;
'''
      }
    },
    {
      id: "queue_item_card",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Card",
        props: '''
const item = args.contextData.loopItem;
const video = item?.video;

return {
  item: video,
  itemType: "video",
  itemSetting: null
};
''',
        css: '''
return `._id {
  flex: 1;
  min-width: 0;
  border: none !important;
  padding: 0 !important;
  background: transparent !important;

  &:hover {
    background: transparent !important;
  }
}`;
'''
      }
    },
    {
      id: "queue_item_actions",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  gap: 0.375rem;
  flex-shrink: 0;
  margin-top: 0.25rem;
}`;
'''
      }
    },
    {
      id: "queue_item_play_button",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.loopItem;
const video = item?.video;
const playVideo = args.contextData.props?.playVideo;
const onClose = args.contextData.props?.onClose;

return {
  as: "button",
  onClick: () => {
    if (video) {
      playVideo?.(video);
      onClose?.();
    }
  },
  "aria-label": "Play video",
  title: "Play now"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  border: none;
  border-radius: 0.375rem;
  padding: 0.375rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;F
  width: 32px;
  height: 32px;

  &:hover {
    background: ${args.theme.var.color.primary_dark_200};
    transform: scale(1.05);
  }
}`;
'''
      }
    },
    {
      id: "queue_item_play_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:play",
  width: 16,
  height: 16
};
'''
      }
    },
    {
      id: "queue_item_move_up_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const item = args.contextData.loopItem;
const queue = args.contextData.props?.videoQueue?.() || [];
const reorderQueue = args.contextData.props?.reorderQueue;
const isFirst = item?.index === 0;

return {
  as: "button",
  onClick: () => {
    if (item && typeof item.index !== 'undefined' && !isFirst) {
      reorderQueue?.(item.index, item.index - 1);
    }
  },
  disabled: isFirst,
  "aria-label": "Move up",
  title: "Move up"
};
''',
        css: '''
const item = args.contextData.loopItem;
const isFirst = item?.index === 0;

return `._id {
  background: ${args.theme.var.color.background_light_300};
  color: ${args.theme.var.color.text};
  border: none;
  border-radius: 0.375rem;
  padding: 0.375rem;
  cursor: ${isFirst ? 'not-allowed' : 'pointer'};
  opacity: ${isFirst ? '0.5' : '1'};
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  width: 32px;
  height: 32px;

  &:hover:not(:disabled) {
    background: ${args.theme.var.color.primary};
    color: ${args.theme.var.color.primary_text};
    transform: scale(1.05);
  }
}`;
'''
      }
    },
    {
      id: "queue_item_move_up_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:arrow-up",
  width: 16,
  height: 16
};
'''
      }
    },
    {
      id: "queue_item_move_down_button",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const item = args.contextData.loopItem;
const queue = args.contextData.props?.videoQueue?.() || [];
const reorderQueue = args.contextData.props?.reorderQueue;
const isLast = item?.index === queue.length - 1;

return {
  as: "button",
  onClick: () => {
    if (item && typeof item.index !== 'undefined' && !isLast) {
      reorderQueue?.(item.index, item.index + 1);
    }
  },
  disabled: isLast,
  "aria-label": "Move down",
  title: "Move down"
};
''',
        css: '''
const item = args.contextData.loopItem;
const queue = args.contextData.props?.videoQueue?.() || [];
const isLast = item?.index === queue.length - 1;

return `._id {
  background: ${args.theme.var.color.background_light_300};
  color: ${args.theme.var.color.text};
  border: none;
  border-radius: 0.375rem;
  padding: 0.375rem;
  cursor: ${isLast ? 'not-allowed' : 'pointer'};
  opacity: ${isLast ? '0.5' : '1'};
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  width: 32px;
  height: 32px;

  &:hover:not(:disabled) {
    background: ${args.theme.var.color.primary};
    color: ${args.theme.var.color.primary_text};
    transform: scale(1.05);
  }
}`;
'''
      }
    },
    {
      id: "queue_item_move_down_icon",
