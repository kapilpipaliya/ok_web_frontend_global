        props:
          '''
const selectedVideos = args.fns.selectedVideos?.() || new Set();
const queue = args.contextData.props?.videoQueue?.() || [];
const allSelected = queue.length > 0 && selectedVideos.size === queue.length;
const someSelected = selectedVideos.size > 0 && selectedVideos.size < queue.length;

return {
  as: "input",
  type: "checkbox",
  checked: allSelected,
  indeterminate: someSelected,
  onClick: () => {
    if (allSelected || someSelected) {
      args.fns.clearSelection?.();
    } else {
      args.fns.selectAll?.();
    }
  }
};
'''
