{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "QueueModal"
      }
    },
    {
      id: "modal_overlay",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const getIsOpen = args.contextData.props?.isOpen;
const isOpen = getIsOpen?.() || false;
const onClose = args.contextData.props?.onClose;

return {
  as: "div",
  hide: !isOpen,
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      onClose?.();
    }
  }
};
''',
        css: '''
return `._id {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}`;
'''
      }
    },
    {
      id: "modal_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
const [searchTerm, setSearchTerm] = args.createSignal("");
const [selectedVideos, setSelectedVideos] = args.createSignal(new Set());
const [showPlaylistSelector, setShowPlaylistSelector] = args.createSignal(false);
const [customPlaylists, setCustomPlaylists] = args.createSignal([]);
const [playlistsLoading, setPlaylistsLoading] = args.createSignal(false);
const [savingToPlaylist, setSavingToPlaylist] = args.createSignal(false);
const [newPlaylistName, setNewPlaylistName] = args.createSignal("");
const [selectedPlaylistId, setSelectedPlaylistId] = args.createSignal(null);
const [showCreateNew, setShowCreateNew] = args.createSignal(false);

const toggleVideoSelection = (videoId) => {
  setSelectedVideos(prev => {
    const newSet = new Set(prev);
    if (newSet.has(videoId)) {
      newSet.delete(videoId);
    } else {
      newSet.add(videoId);
    }
    return newSet;
  });
};

const selectAll = () => {
  const queue = args.contextData.props?.videoQueue?.() || [];
  const allIds = queue.map(v => v?.P?.youtubeId).filter(Boolean);
  setSelectedVideos(new Set(allIds));
};

const clearSelection = () => {
  setSelectedVideos(new Set());
};

// Get executeYTOFunction from context
const executeYTOFunction = args.contextData.props?.executeYTOFunction;

// Load custom playlists
const loadCustomPlaylists = async () => {
  const getOwnershipId = args.contextData.props?.getOwnershipId;
  const ownershipId = getOwnershipId?.();

  if (!ownershipId || !executeYTOFunction) return;

  setPlaylistsLoading(true);
  try {
    const result = await executeYTOFunction("getCustomPlaylists", { ownershipId });
    if (result?.result?.success) {
      setCustomPlaylists(result.result.data || []);
    } else {
      args.showErrorToast("Failed to load playlists");
    }
  } catch (error) {
    console.error("Error loading playlists:", error);
    args.showErrorToast("Failed to load playlists");
  } finally {
    setPlaylistsLoading(false);
  }
};

// Save queue to new playlist
const saveToNewPlaylist = async (playlistName) => {
  const queue = args.contextData.props?.videoQueue?.() || [];
  const getOwnershipId = args.contextData.props?.getOwnershipId;
  const ownershipId = getOwnershipId?.();

  if (!ownershipId || !executeYTOFunction) return;

  setSavingToPlaylist(true);
  try {
    // Create playlist
    const createResult = await executeYTOFunction("createCustomPlaylist", {
      name: playlistName.trim(),
      ownershipId: ownershipId,
      description: `Created from queue with ${queue.length} videos`
    });

    if (!createResult?.result?.success) {
      args.showErrorToast(createResult?.result?.message || "Failed to create playlist");
      return;
    }

    const playlistId = createResult.result.data?.playlistId;

    // Add videos to playlist
    const videoIds = queue.map(v => v?.P?.youtubeId).filter(Boolean);
    if (videoIds.length > 0) {
      const addResult = await executeYTOFunction("addVideosToCustomPlaylist", {
        playlistId,
        videoIds,
        ownershipId
      });

      if (addResult?.result?.success) {
        args.showSuccessToast(`Playlist "${playlistName}" created with ${addResult.result.data.addedCount} videos`);
        setShowPlaylistSelector(false);
      } else {
        args.showErrorToast(addResult?.result?.message || "Playlist created but failed to add videos");
      }
    } else {
      args.showSuccessToast(`Playlist "${playlistName}" created`);
      setShowPlaylistSelector(false);
    }
  } catch (error) {
    console.error("Error saving to new playlist:", error);
    args.showErrorToast("Failed to create playlist");
  } finally {
    setSavingToPlaylist(false);
  }
};

// Save queue to existing playlist
const saveToExistingPlaylist = async (playlistId) => {
  const queue = args.contextData.props?.videoQueue?.() || [];
  const getOwnershipId = args.contextData.props?.getOwnershipId;
  const ownershipId = getOwnershipId?.();

  if (!ownershipId || !executeYTOFunction) return;

  setSavingToPlaylist(true);
  try {
    const videoIds = queue.map(v => v?.P?.youtubeId).filter(Boolean);
    if (videoIds.length === 0) {
      args.showWarningToast("Queue is empty");
      return;
    }

    const addResult = await executeYTOFunction("addVideosToCustomPlaylist", {
      playlistId,
      videoIds,
      ownershipId
    });

    if (addResult?.result?.success) {
      const playlist = customPlaylists().find(p => p.playlist.P.youtubeId === playlistId);
      const playlistName = playlist?.playlist?.P?.title || "playlist";
      args.showSuccessToast(`Added ${addResult.result.data.addedCount} videos to "${playlistName}"`);
      setShowPlaylistSelector(false);
    } else {
      args.showErrorToast(addResult?.result?.message || "Failed to add videos to playlist");
    }
  } catch (error) {
    console.error("Error saving to existing playlist:", error);
    args.showErrorToast("Failed to add videos to playlist");
  } finally {
    setSavingToPlaylist(false);
  }
};

return {
  searchTerm,
  setSearchTerm,
  selectedVideos,
  toggleVideoSelection,
  selectAll,
  clearSelection,
  executeYTOFunction,
  showPlaylistSelector,
  setShowPlaylistSelector,
  customPlaylists,
  playlistsLoading,
  savingToPlaylist,
  loadCustomPlaylists,
  saveToNewPlaylist,
  saveToExistingPlaylist,
  newPlaylistName,
  setNewPlaylistName,
  selectedPlaylistId,
  setSelectedPlaylistId,
  showCreateNew,
  setShowCreateNew
};
''',
        props: '''
