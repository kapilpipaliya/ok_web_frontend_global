{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "QueueModal"
      }
    },
    {
      id: "modal_overlay",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const getIsOpen = args.contextData.props?.isOpen;
const isOpen = getIsOpen?.() || false;
const onClose = args.contextData.props?.onClose;

return {
  as: "div",
  hide: !isOpen,
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      onClose?.();
    }
  }
};
''',
        css: '''
return `._id {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}`;
'''
      }
    },
    {
      id: "modal_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  onClick: (e) => e.stopPropagation()
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.background};
  border-radius: 0.75rem;
  width: 100%;
  max-width: 600px;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}`;
'''
      }
    },
    {
      id: "modal_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.5rem;
  border-bottom: 1px solid ${args.theme.var.color.border};
}`;
'''
      }
    },
    {
      id: "modal_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const queue = args.contextData.props?.videoQueue?.() || [];

return {
  as: "h2",
  text: `Video Queue (${queue.length})`
};
''',
        css: '''
return `._id {
  font-size: 1.5rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
  margin: 0;
}`;
'''
      }
    },
    {
      id: "modal_close_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const onClose = args.contextData.props?.onClose;

return {
  as: "button",
  onClick: onClose,
  "aria-label": "Close modal"
};
''',
        css: '''
return `._id {
  background: none;
  border: none;
  color: ${args.theme.var.color.muted};
  cursor: pointer;
  padding: 0.5rem;
  border-radius: 0.375rem;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;

  &:hover {
    background: ${args.theme.var.color.background_light_200};
    color: ${args.theme.var.color.text};
  }
}`;
'''
      }
    },
    {
      id: "modal_close_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:close",
  width: 24,
  height: 24
};
'''
      }
    },
    {
      id: "modal_body",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  flex: 1;
  overflow: auto;
  padding: 1rem;
}`;
'''
      }
    },
    {
      id: "queue_list",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}`;
'''
      }
    },
    {
      id: "queue_empty_state",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const queue = args.contextData.props?.videoQueue?.() || [];

return {
  as: "div",
  hide: queue.length > 0
};
''',
        css: '''
return `._id {
  text-align: center;
  padding: 3rem 1rem;
  color: ${args.theme.var.color.muted};
}`;
'''
      }
    },
    {
      id: "empty_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:playlist",
  width: 48,
  height: 48
};
''',
        css: '''
return `._id {
  opacity: 0.5;
  margin-bottom: 1rem;
}`;
'''
      }
    },
    {
      id: "empty_text",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "No videos in queue"
};
''',
        css: '''
return `._id {
  font-size: 1rem;
  margin: 0;
}`;
'''
      }
    },
    {
      id: "queue_items_container",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const queue = args.contextData.props?.videoQueue?.() || [];

return {
  as: "div",
  hide: queue.length === 0
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}`;
'''
      }
    },
    {
      id: "queue_items_loop",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "loopItem",
        loop: true,
        props: '''
const queue = args.contextData.props?.videoQueue?.() || [];

return {
  data: queue.map((video, index) => ({ video, index }))
};
'''
      }
    },
    {
      id: "queue_item",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.background_light_100};
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.5rem;
  padding: 0.75rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  transition: all 0.2s ease;

  &:hover {
    background: ${args.theme.var.color.background_light_200};
  }
}`;
'''
      }
    },
    {
      id: "queue_item_number",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.loopItem;

return {
  as: "div",
  text: `${(item?.index ?? 0) + 1}`
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.875rem;
  font-weight: 600;
  flex-shrink: 0;
}`;
'''
      }
    },
    {
      id: "queue_item_thumbnail",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const item = args.contextData.loopItem;
const video = item?.video;
const thumbnailUrl = video?.P?.thumbnail || "";

return {
  as: "div",
  style: thumbnailUrl ? `background-image: url('${thumbnailUrl}'); background-size: cover; background-position: center;` : ""
};
''',
        css: '''
return `._id {
  width: 80px;
  height: 45px;
  background-color: ${args.theme.var.color.background_light_300};
  border-radius: 0.375rem;
  flex-shrink: 0;
  overflow: hidden;
}`;
'''
      }
    },
    {
      id: "queue_item_info",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}`;
'''
      }
    },
    {
      id: "queue_item_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.loopItem;
const video = item?.video;
const title = video?.P?.title || "Untitled Video";

return {
  as: "div",
  text: title
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  font-weight: 500;
  color: ${args.theme.var.color.text};
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}`;
'''
      }
    },
    {
      id: "queue_item_channel",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const item = args.contextData.loopItem;
const video = item?.video;
const channelTitle = video?.P?.channelTitle || "Unknown Channel";

return {
  as: "div",
  text: channelTitle
};
''',
        css: '''
return `._id {
  font-size: 0.75rem;
  color: ${args.theme.var.color.muted};
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}`;
'''
      }
    },
    {
      id: "queue_item_actions",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  gap: 0.25rem;
  flex-shrink: 0;
}`;
'''
      }
    },
    {
      id: "queue_item_play_button",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.loopItem;
const video = item?.video;
const playVideo = args.contextData.props?.playVideo;
const onClose = args.contextData.props?.onClose;

return {
  as: "button",
  onClick: () => {
    if (video) {
      playVideo?.(video);
      onClose?.();
    }
  },
  "aria-label": "Play video",
  title: "Play now"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  border: none;
  border-radius: 0.375rem;
  padding: 0.5rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;

  &:hover {
    background: ${args.theme.var.color.primary_dark_200};
  }
}`;
'''
      }
    },
    {
      id: "queue_item_play_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:play",
  width: 16,
  height: 16
};
'''
      }
    },
    {
      id: "queue_item_remove_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const item = args.contextData.loopItem;
const removeFromQueue = args.contextData.props?.removeFromQueue;

return {
  as: "button",
  onClick: () => {
    if (item && typeof item.index !== 'undefined') {
      removeFromQueue?.(item.index);
    }
  },
  "aria-label": "Remove from queue",
  title: "Remove"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.background_dark_200};
  color: ${args.theme.var.color.text};
  border: none;
  border-radius: 0.375rem;
  padding: 0.5rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;

  &:hover {
    background: ${args.theme.var.color.error};
    color: ${args.theme.var.color.error_text};
  }
}`;
'''
      }
    },
    {
      id: "queue_item_remove_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:trash-can",
  width: 16,
  height: 16
};
'''
      }
    },
    {
      id: "modal_footer",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const queue = args.contextData.props?.videoQueue?.() || [];

return {
  as: "div",
  hide: queue.length === 0
};
''',
        css: '''
return `._id {
  padding: 1rem 1.5rem;
  border-top: 1px solid ${args.theme.var.color.border};
  display: flex;
  justify-content: space-between;
  align-items: center;
}`;
'''
      }
    },
    {
      id: "modal_footer_info",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const queue = args.contextData.props?.videoQueue?.() || [];

return {
  as: "div",
  text: `${queue.length} video${queue.length !== 1 ? 's' : ''} in queue`
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  color: ${args.theme.var.color.muted};
}`;
'''
      }
    },
    {
      id: "modal_footer_clear_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const clearQueue = args.contextData.props?.clearQueue;

return {
  as: "button",
  onClick: clearQueue,
  text: "Clear All"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.error};
  color: ${args.theme.var.color.error_text};
  border: none;
  border-radius: 0.375rem;
  padding: 0.5rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;

  &:hover {
    background: ${args.theme.var.color.error_dark_200};
  }
}`;
'''
      }
    }
  ],
  edges: [
