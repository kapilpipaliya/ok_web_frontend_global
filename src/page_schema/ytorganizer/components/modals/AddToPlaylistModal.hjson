        displayOrder: 1
        fns:
          '''
const [selectedPlaylists, setSelectedPlaylists] = args.createSignal([]);
const [isSubmitting, setIsSubmitting] = args.createSignal(false);

const togglePlaylist = (playlistId) => {
  const current = selectedPlaylists();
  if (current.includes(playlistId)) {
    setSelectedPlaylists(current.filter(id => id !== playlistId));
  } else {
    setSelectedPlaylists([...current, playlistId]);
  }
};

const handleSave = async () => {
  const video = args.contextData.props?.video?.();
  const playlists = selectedPlaylists();
  const onSave = args.contextData.props?.onSave;
  const onClose = args.contextData.props?.onClose;

  if (playlists.length === 0) {
    args.showWarningToast("Please select at least one playlist");
    return;
  }

  if (!video) {
    args.showErrorToast("No video selected");
    return;
  }

  setIsSubmitting(true);

  try {
    if (onSave) {
      await onSave({
        video,
        playlistIds: playlists
      });
    }

    onClose?.();
  } catch (error) {
    console.error("Error adding to playlist:", error);
    // Error toast already shown by the onSave function
  } finally {
    setIsSubmitting(false);
  }
};

return {
  selectedPlaylists,
  togglePlaylist,
  isSubmitting,
  handleSave
};
'''
        componentName: Html
        serverFunction:
          '''
try {
  const result = await args.fns.executeYTOFunction("getUserPlaylists", {});

  if (result?.result?.success && result?.result?.data) {
    return result.result.data;
  }

  return { playlists: [] };
} catch (error) {
  console.error("Error loading playlists:", error);
  return { playlists: [] };
}
'''
        props:
          '''
const isOpen = args.contextData.props?.isOpen;
const getIsOpen = isOpen?.() || false;
const onClose = args.contextData.props?.onClose;

return {
  as: "div",
  hide: !getIsOpen,
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      onClose?.();
    }
  }
};
'''
      }
    }
