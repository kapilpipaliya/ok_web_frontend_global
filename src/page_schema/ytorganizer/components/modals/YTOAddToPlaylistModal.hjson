};
'''
      }
    },
    {
      id: "playlist_item",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.playlistItem;
const playlist = item?.playlist;
const playlistId = playlist?.P?.youtubeId || "";
