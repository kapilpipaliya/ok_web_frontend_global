      P: {
        displayOrder: 2,
        componentName: "YTOButton",
        props: '''
const isSubmitting = args.fns.isSubmitting();
const selectedCount = args.fns.selectedPlaylists().length;

return {
  text: isSubmitting ? "Adding..." : `Add to ${selectedCount} Playlist${selectedCount !== 1 ? 's' : ''}`,
  variant: "primary",
  onClick: args.fns.handleSave,
  disabled: isSubmitting || selectedCount === 0
};
'''
      }
