};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 0.75rem;
  padding: 0.75rem;
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.5rem;
  cursor: pointer;
  transition: all 0.2s ease;

  &:hover {
    background: ${args.theme.var.color.background_light_100};
    border-color: ${args.theme.var.color.primary};
  }

  &.selected {
    background: ${args.theme.var.color.primary_light_100};
    border-color: ${args.theme.var.color.primary};
  }
}`;
'''
      }
    },
    {
      id: "playlist_checkbox",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.playlistItem;
const playlist = item?.playlist;
const playlistId = playlist?.P?.youtubeId || "";
const isSelected = args.fns.selectedPlaylists().includes(playlistId);

return {
  as: "input",
  type: "checkbox",
  checked: isSelected,
  onChange: () => args.fns.togglePlaylist(playlistId)
};
''',
        css: '''
return `._id {
  width: 18px;
  height: 18px;
  cursor: pointer;
  flex-shrink: 0;
}`;
'''
      }
    },
    {
      id: "playlist_info",
