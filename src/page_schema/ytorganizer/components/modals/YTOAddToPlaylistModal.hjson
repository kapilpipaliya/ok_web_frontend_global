  min-width: 0;
}`;
'''
      }
    },
    {
      id: "playlist_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const item = args.contextData.playlistItem;
const playlist = item?.playlist;
const playlistSetting = item?.playlistSetting;
const customName = playlistSetting?.P?.customName;
const title = customName || playlist?.P?.title || "Untitled Playlist";

return {
  as: "div",
