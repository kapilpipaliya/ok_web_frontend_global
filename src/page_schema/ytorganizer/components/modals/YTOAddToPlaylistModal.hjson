{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "YTOAddToPlaylistModal"
      }
    },
    {
      id: "modal_overlay",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "playlistsData",
        serverFunction: '''
try {
  const result = await args.fns.executeYTOFunction("getUserPlaylists", {});

  if (result?.result?.success && result?.result?.data) {
    return result.result.data;
  }

  return { playlists: [] };
} catch (error) {
  console.error("Error loading playlists:", error);
  return { playlists: [] };
}
''',
        fns: '''
const [selectedPlaylists, setSelectedPlaylists] = args.createSignal([]);
const [isSubmitting, setIsSubmitting] = args.createSignal(false);

const togglePlaylist = (playlistId) => {
  const current = selectedPlaylists();
  if (current.includes(playlistId)) {
    setSelectedPlaylists(current.filter(id => id !== playlistId));
  } else {
    setSelectedPlaylists([...current, playlistId]);
  }
};

const handleSave = async () => {
  const video = args.contextData.props?.video?.();
  const playlists = selectedPlaylists();
  const onSave = args.contextData.props?.onSave;
  const onClose = args.contextData.props?.onClose;

  if (playlists.length === 0) {
    args.showWarningToast("Please select at least one playlist");
    return;
  }

  if (!video) {
    args.showErrorToast("No video selected");
    return;
  }

  setIsSubmitting(true);

  try {
    if (onSave) {
      await onSave({
        video,
        playlistIds: playlists
      });
    }

    onClose?.();
  } catch (error) {
    console.error("Error adding to playlist:", error);
    // Error toast already shown by the onSave function
  } finally {
    setIsSubmitting(false);
  }
};

return {
  selectedPlaylists,
  togglePlaylist,
  isSubmitting,
  handleSave
};
''',
        props: '''
const isOpen = args.contextData.props?.isOpen;
const getIsOpen = isOpen?.() || false;
const onClose = args.contextData.props?.onClose;

return {
  as: "div",
  hide: !getIsOpen,
  onClick: (e) => {
    if (e.target === e.currentTarget) {
      onClose?.();
    }
  }
};
''',
        css: '''
return `._id {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}`;
'''
      }
    },
    {
      id: "modal_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  onClick: (e) => e.stopPropagation()
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.background};
  border-radius: 0.75rem;
  width: 100%;
  max-width: 500px;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}`;
'''
      }
    },
    {
      id: "modal_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
