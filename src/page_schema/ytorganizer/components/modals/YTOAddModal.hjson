{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "YTOAddModal"
      }
    },
    {
      id: "modal_overlay",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
// Form state management
const [isSubmitting, setIsSubmitting] = args.createSignal(false);
const [isProcessing, setIsProcessing] = args.createSignal(false);
const [url, setUrl] = args.createSignal("");
const [customName, setCustomName] = args.createSignal("");
const [priority, setPriority] = args.createSignal("normal");
const [formError, setFormError] = args.createSignal(null);

// Initialize form data
const initializeFormData = () => {
  const editMode = args.contextData.props?.editMode || false;
  const itemData = args.contextData.props?.itemData;

  if (editMode && itemData) {
    // Determine actual type from itemData structure
    let setting;
    if (itemData.video) {
      setting = itemData.videoSetting;
    } else if (itemData.playlist) {
      setting = itemData.playlistSetting;
    } else {
      setting = itemData.channelSetting;
    }
    setCustomName(setting?.P?.customName || "");
  } else {
    setUrl("");
    setCustomName("");
    setPriority("normal");
  }
  setIsSubmitting(false);
  setIsProcessing(false);
  setFormError(null);
};

// Handle form submission
const handleSave = async () => {
  const urlValue = url().trim();
  const contentType = args.contextData.props?.contentType || "channels";
  const editMode = args.contextData.props?.editMode || false;
  const itemData = args.contextData.props?.itemData;
  const onSave = args.contextData.props?.onSave;
  const onClose = args.contextData.props?.onClose || (() => {});

  // In edit mode, determine actual type from itemData structure
  let actualType = contentType;
  if (editMode && itemData) {
    if (itemData.video) {
      actualType = "videos";
    } else if (itemData.playlist) {
      actualType = "playlists";
    } else {
      actualType = "channels";
    }
  }

  // Validate required fields for add mode
  if (!editMode && !urlValue) {
    setFormError("Please enter a YouTube URL");
    return;
  }

  setFormError(null);
  setIsSubmitting(true);

  try {
    let result;

    if (editMode) {
      // Edit mode: update setting
      let data, youtubeId, functionName;

      if (actualType === "videos") {
        data = itemData.video;
        youtubeId = data?.P?.youtubeId;
        functionName = "updateVideoSetting";
      } else if (actualType === "playlists") {
        data = itemData.playlist;
        youtubeId = data?.P?.youtubeId;
        functionName = "updatePlaylistSetting";
      } else {
        data = itemData.channel?.channel || itemData.channel;
        youtubeId = data?.P?.youtubeId;
        functionName = "updateChannelSetting";
      }

      result = await args.fns.executeYTOFunction(functionName, {
        youtubeId,
        customName: customName().trim() || null
      });
    } else {
      // Add mode: create new
      const functionName = contentType === "playlists" ? "savePlaylist" : "saveChannel";
      const params = {
        url: urlValue,
        name: customName().trim() || null,
        priority: priority()
      };

      // If adding a playlist and channelId is provided, link it to the channel
      if (contentType === "playlists" && args.contextData.props?.channelId) {
        params.channelId = args.contextData.props.channelId;
      }

      result = await args.fns.executeYTOFunction(functionName, params);
    }

    if (result?.error) {
      const errorMsg = result.error;
      setFormError(errorMsg);
    } else if (result?.result?.success) {
      const action = editMode ? "updated" : "added";
      const itemTypeName = actualType === "videos" ? "Video" : ((editMode ? actualType : contentType) === "playlists" ? "Playlist" : "Channel");
      args.showSuccessToast(result.result.message || `${itemTypeName} ${action} successfully`);

      // Call parent callback if provided
      if (onSave) {
        onSave({
          contentType: editMode ? actualType : contentType,
          url: urlValue,
          customName: customName().trim() || null,
          result: result.result.data,
          editMode
        });
      }

      onClose();
    } else {
      const errorMsg = result?.result?.message || result?.result?.error || `Failed to ${editMode ? "update" : "add"} item`;
      setFormError(errorMsg);
    }
  } catch (error) {
    console.error("Error saving:", error);
    const errorMsg = error?.message || `Failed to ${editMode ? "update" : "add"} item`;
    setFormError(errorMsg);
  } finally {
    setIsSubmitting(false);
  }
};

return {
  isSubmitting,
  isProcessing,
  url,
  setUrl,
  customName,
  setCustomName,
  priority,
  setPriority,
  formError,
  setFormError,
  handleSave,
  initializeFormData
};
''',
        props: '''
const isOpen = args.contextData.props?.isOpen || false;

return {
  as: "div",
  hide: !isOpen,
  onMount: () => {
    args.fns.initializeFormData();
  }
};
''',
        css: '''
return `._id {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  animation: fadeIn 0.3s ease;
}

@media (max-width: 768px) {
  ._id {
    padding: 0;
    align-items: stretch;
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}`;
'''
      }
    },
    {
      id: "modal_container",
