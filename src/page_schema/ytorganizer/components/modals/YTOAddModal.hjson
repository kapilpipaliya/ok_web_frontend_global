    {
      id: "modal_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const contentType = args.contextData.props?.contentType || "channels";
const editMode = args.contextData.props?.editMode || false;
const itemData = args.contextData.props?.itemData;
const isProcessing = args.fns.isProcessing();

// In edit mode, determine type from itemData structure
let actualType = contentType;
if (editMode && itemData) {
  if (itemData.video) {
    actualType = "videos";
  } else if (itemData.playlist) {
    actualType = "playlists";
  } else {
    actualType = "channels";
  }
}

let title;
if (isProcessing) {
  const itemTypeName = contentType === "playlists" ? "Playlist" : "Channel";
  title = `${itemTypeName} Processing`;
} else {
  title = editMode
    ? (actualType === "videos" ? "Edit Video Setting" : (actualType === "playlists" ? "Edit Playlist Setting" : "Edit Channel Setting"))
    : (contentType === "playlists" ? "Add Playlist" : "Add Channel");
}

return {
  as: "h2",
  text: title
};
''',
        css: '''
return `._id {
  font-size: 1.5rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
  margin: 0;
}`;
'''
      }
    },
    {
      id: "playlist_name_display",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const editMode = args.contextData.props?.editMode || false;
const itemData = args.contextData.props?.itemData;
const isProcessing = args.fns.isProcessing();

if (!editMode || !itemData || isProcessing) {
  return { as: "div", hide: true };
}

// Determine actual item type from itemData structure
let itemType, data;
if (itemData.video) {
  itemType = "Video";
  data = itemData.video;
} else if (itemData.playlist) {
  itemType = "Playlist";
  data = itemData.playlist;
} else {
  itemType = "Channel";
  data = itemData.channel?.channel || itemData.channel;
}

const itemName = data?.P?.title || "";

return {
  as: "div",
  text: `YouTube ${itemType}: ${itemName}`
};
''',
