        props: '''
return {
  as: "icon",
  icon: "carbon:warning",
  width: 20,
  height: 20
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.warning};
  flex-shrink: 0;
  margin-top: 0.125rem;
}`;
'''
      }
    },
    {
      id: "warning_text",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const contentType = args.contextData.props?.contentType || "channels";
const itemType = contentType === "playlists" ? "playlist" : "channel";

return {
  as: "p",
  text: `Processing may take 5-10 minutes depending on the size of the ${itemType}. Please wait until processed.`
};
''',
        css: '''
return `._id {
  margin: 0;
  font-size: 0.875rem;
  line-height: 1.5;
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "modal_footer",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "footer",
  hide: args.fns.isProcessing()
};
''',
        css: '''
return `._id {
  padding: 1.5rem;
  border-top: 1px solid ${args.theme.var.color.border};
  display: flex;
  gap: 1rem;
  justify-content: flex-end;
}

@media (max-width: 768px) {
  ._id {
    flex-direction: column-reverse;
  }
}`;
'''
      }
    },
    {
      id: "cancel_button",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "YTOButton",
        props: '''
const onClose = args.contextData.props?.onClose || (() => {});

return {
  text: "Cancel",
  variant: "secondary",
  onClick: onClose,
  disabled: args.fns.isSubmitting()
};
'''
      }
    },
    {
      id: "save_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "YTOButton",
        props: '''
const isSubmitting = args.fns.isSubmitting();
const editMode = args.contextData.props?.editMode || false;

const buttonText = isSubmitting
  ? (editMode ? "Updating..." : "Saving...")
  : (editMode ? "Update" : "Save");

return {
  text: buttonText,
  variant: "primary",
  onClick: args.fns.handleSave,
  disabled: isSubmitting
};
'''
      }
    }
  ],
  edges: [
