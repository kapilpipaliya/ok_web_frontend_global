          '''return {

}'''
        componentName: Html
        key: unique_4
        props:
          '''return {
  serverFunction: `
    // This server function runs on the server and authenticates the Shopify admin app
    // It calls the named server function "authShopifyAdminRequest"

    const searchParams = ${JSON.stringify({ ...args.searchParams })};

    const result = await args.executeNamedServerFunction({
      functionName: "authShopifyAdminRequest",
      contextData: {
        searchParams,
      },
    });

    if (result?.error || result?.result?.success === false) {
      console.error("Shopify auth failed:", result?.error || result?.result?.error);
      return {
        data: null,
        error: result?.error || result?.result?.error || "Shopify auth failed",
        needsOAuth: result?.result?.needsOAuth || false,
        redirectUrl: result?.result?.redirectUrl,
      };
    }

    return {
      data: result?.result,
      needsOAuth: result?.result?.needsOAuth || false,
      redirectUrl: result?.result?.redirectUrl,
    };
  `,
  onMount: () => {
    // Check if OAuth redirect is needed after server function completes
    const authData = args.contextData?.auth;
    if (authData?.needsOAuth && authData?.redirectUrl) {
      // Redirect to OAuth begin endpoint
      window.location.href = authData.redirectUrl;
    }
  }
}'''
