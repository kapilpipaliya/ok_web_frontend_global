{
  vertexes: [
    {
      id: "component_root",
      L: "Component",
      P: {
        key: "SplitButton"
      }
    },
    {
      id: "variant_field",
      L: "ComponentVariant",
      P: {
        key: "field",
        type: "string",
        defValue: ""
      }
    },
    {
      id: "variant_direction",
      L: "ComponentVariant",
      P: {
        key: "direction",
        type: "string",
        defValue: "asc"
      }
    },
    {
      id: "variant_options",
      L: "ComponentVariant",
      P: {
        key: "options",
        type: "array",
        defValue: []
      }
    },
    {
      id: "variant_on_field_change",
      L: "ComponentVariant",
      P: {
        key: "onFieldChange",
        type: "function",
        defValue: null
      }
    },
    {
      id: "variant_on_direction_toggle",
      L: "ComponentVariant",
      P: {
        key: "onDirectionToggle",
        type: "function",
        defValue: null
      }
    },
    {
      id: "variant_disabled",
      L: "ComponentVariant",
      P: {
        key: "disabled",
        type: "boolean",
        defValue: false
      }
    },
    {
      id: "wrapper_div",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  class: args.contextData.props?.class
};
''',
        css: '''
return `._id {
  display: inline-flex;
  align-items: stretch;
  border-radius: ${args.theme.var.borderRadius.md};
  border: 1px solid ${args.theme.var.color.border};
  background: ${args.theme.var.color.background};
}`;
'''
      }
    },
    {
      id: "dropdown_wrapper",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  flex: 1;
  min-width: 150px;
}`;
'''
      }
    },
    {
      id: "dropdown_select",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "TomSelect",
        props: '''
const field = args.contextData.props?.field || "";
const options = args.contextData.props?.options || [];
const onFieldChange = args.contextData.props?.onFieldChange || (() => {});
const disabled = args.contextData.props?.disabled || false;

return {
  value: field,
  options: options,
  onChange: (value) => {
    onFieldChange(value);
  },
  disabled: disabled,
  search: false,
  placeholder: "Sort by..."
};
''',
        css: '''
return `._id {
  border-radius: ${args.theme.var.borderRadius.md} 0 0 ${args.theme.var.borderRadius.md};
}`;
'''
      }
    },
    {
      id: "divider",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  width: 1px;
  background: ${args.theme.var.color.border};
}`;
'''
      }
    },
    {
      id: "direction_button",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const direction = args.contextData.props?.direction || "asc";
const onDirectionToggle = args.contextData.props?.onDirectionToggle || (() => {});
const disabled = args.contextData.props?.disabled || false;

// Determine icon based on direction
const icon = direction === "asc" ? "arrow-up" : "arrow-down";
const ariaLabel = direction === "asc" ? "Sort ascending" : "Sort descending";

return {
  as: "button",
  type: "button",
  onClick: () => {
    onDirectionToggle();
  },
  disabled: disabled,
  "aria-label": ariaLabel,
  title: ariaLabel
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 ${args.theme.var.spacing.md};
  min-width: ${args.theme.var.touch.minTarget};
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
  border: none;
  border-radius: 0 ${args.theme.var.borderRadius.md} ${args.theme.var.borderRadius.md} 0;
  cursor: pointer;
  transition: all ${args.theme.var.animation.fast} ease;

  &:hover:not(:disabled) {
    background: ${args.theme.var.color.background_dark_200};
  }

  &:active:not(:disabled) {
    background: ${args.theme.var.color.background_dark_300};
  }

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
}`;
'''
      }
    },
    {
      id: "direction_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const direction = args.contextData.props?.direction || "asc";
const iconName = direction === "asc" ? "ph:arrow-up" : "ph:arrow-down";

return {
  as: "icon",
  icon: iconName,
  width: "20",
  height: "20"
};
''',
        css: '''
return `._id {
  display: block;
}`;
'''
      }
    }
  ],
  edges: [
    { id: "e1", T: "ComponentVariant", S: "component_root", E: "variant_field" },
    { id: "e2", T: "ComponentVariant", S: "component_root", E: "variant_direction" },
    { id: "e3", T: "ComponentVariant", S: "component_root", E: "variant_options" },
    { id: "e4", T: "ComponentVariant", S: "component_root", E: "variant_on_field_change" },
    { id: "e5", T: "ComponentVariant", S: "component_root", E: "variant_on_direction_toggle" },
    { id: "e6", T: "ComponentVariant", S: "component_root", E: "variant_disabled" },
    { id: "e7", T: "Attr", S: "component_root", E: "wrapper_div" },
    { id: "e8", T: "Attr", S: "wrapper_div", E: "dropdown_wrapper" },
    { id: "e9", T: "Attr", S: "dropdown_wrapper", E: "dropdown_select" },
    { id: "e10", T: "Attr", S: "wrapper_div", E: "divider" },
    { id: "e11", T: "Attr", S: "wrapper_div", E: "direction_button" },
    { id: "e12", T: "Attr", S: "direction_button", E: "direction_icon" }
  ]
}
