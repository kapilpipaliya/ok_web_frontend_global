}`;
'''
      }
    },
    {
      id: "yto_search_pagination_pages_data",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const searchResults = args.fns.searchResults();
const pagination = searchResults?.pagination;
const currentPage = args.fns.currentPage();

if (!pagination) return { data: [] };

const { totalPages } = pagination;
const maxVisible = 7;
let pages = [];

if (totalPages <= maxVisible) {
  // Show all pages
  for (let i = 1; i <= totalPages; i++) {
    pages.push(i);
  }
} else {
  // Show first page, last page, and pages around current
  const start = Math.max(2, currentPage - 2);
  const end = Math.min(totalPages - 1, currentPage + 2);

  pages.push(1);

  if (start > 2) {
    pages.push('...');
  }

  for (let i = start; i <= end; i++) {
    if (i !== 1 && i !== totalPages) {
      pages.push(i);
    }
  }

  if (end < totalPages - 1) {
    pages.push('...');
  }

  if (totalPages > 1) {
    pages.push(totalPages);
  }
}

return {
  data: pages.map(page => ({ page, isCurrent: page === currentPage }))
};
''',
        loop: true,
        contextName: "pageItem"
      }
    },
    {
      id: "yto_search_pagination_page_button",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const pageItem = args.contextData.pageItem;
const { page, isCurrent } = pageItem;

if (page === '...') {
  return {
    as: "span",
    text: "..."
  };
}

return {
  as: "button",
  text: page,
  onClick: () => {
    if (!isCurrent) {
      args.fns.goToPage(page);
    }
  }
};
''',
        css: '''
const pageItem = args.contextData.pageItem;
const { page, isCurrent } = pageItem;

if (page === '...') {
  return `._id {
    padding: 0.5rem 0.75rem;
    color: ${args.theme.var.color.muted};
    font-size: 0.875rem;
  }`;
}

return `._id {
  padding: 0.5rem 0.75rem;
  border: 1px solid ${isCurrent ? args.theme.var.color.info : args.theme.var.color.border};
  border-radius: 0.375rem;
  background: ${isCurrent ? args.theme.var.color.info : args.theme.var.color.background};
  color: ${isCurrent ? args.theme.var.color.info_text : args.theme.var.color.text};
  font-size: 0.875rem;
  font-weight: ${isCurrent ? '600' : '500'};
  cursor: ${isCurrent ? 'default' : 'pointer'};
  transition: all 0.2s ease;
  min-width: 2.5rem;

  &:hover {
    ${!isCurrent ? `
      background: ${args.theme.var.color.background_light_100};
      border-color: ${args.theme.var.color.info};
    ` : ''}
  }

  @media (max-width: 768px) {
    padding: 0.375rem 0.625rem;
    font-size: 0.8125rem;
    min-width: 2.25rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_search_pagination_next",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const searchResults = args.fns.searchResults();
const pagination = searchResults?.pagination;

return {
  as: "button",
  text: "Next",
  disabled: !pagination?.hasNextPage,
  onClick: () => {
    if (pagination?.hasNextPage) {
      args.fns.goToNextPage();
    }
  }
};
''',
        css: '''
return `._id {
  padding: 0.5rem 1rem;
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.375rem;
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;

  &:hover:not(:disabled) {
    background: ${args.theme.var.color.background_light_100};
    border-color: ${args.theme.var.color.info};
  }

  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 768px) {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_search_pagination_per_page",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: ${args.theme.var.color.muted};
  font-size: 0.875rem;

  @media (max-width: 768px) {
    font-size: 0.8125rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_search_pagination_per_page_label",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "span",
  text: "Items per page:"
};
'''
      }
    },
    {
      id: "yto_search_pagination_per_page_select",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const currentLimit = args.fns.itemsPerPage();

return {
  as: "select",
  value: currentLimit,
  onChange: (e) => {
    const newLimit = parseInt(e.target.value);
    args.fns.changeItemsPerPage(newLimit);
  }
};
''',
        css: '''
return `._id {
  padding: 0.25rem 0.5rem;
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.25rem;
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
  font-size: 0.875rem;
  cursor: pointer;

  &:focus {
    outline: none;
    border-color: ${args.theme.var.color.info};
  }

  @media (max-width: 768px) {
    font-size: 0.8125rem;
  }
}`;
'''
      }
