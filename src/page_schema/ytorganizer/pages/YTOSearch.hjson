const result = args.contextData.result;
const getTypeColor = (type) => {
  switch(type) {
    case "channel": return args.theme.var.color.primary;
    case "playlist": return args.theme.var.color.success;
    case "video": return args.theme.var.color.info;
    default: return args.theme.var.color.muted;
  }
};

return `._id {
  display: inline-block;
  background: ${getTypeColor(result.type)};
  color: white;
  font-size: 0.75rem;
  font-weight: 500;
  padding: 0.25rem 0.5rem;
  border-radius: 1rem;
  margin-bottom: 0.5rem;
}`;
'''
