    },
    {
      id: "yto_search_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        fns: '''
// Search state
const [searchQuery, setSearchQuery] = args.createSignal("");
const [searchFilter, setSearchFilter] = args.createSignal("all");
const [searchResults, setSearchResults] = args.createSignal([]);
const [isSearching, setIsSearching] = args.createSignal(false);

// Handle search
const handleSearch = async (e) => {
  e.preventDefault();
  const query = searchQuery().trim();

  if (!query) {
    args.showWarningToast("Please enter a search term");
    return;
  }

  setIsSearching(true);

  // Simulate search - replace with actual search functionality
  setTimeout(() => {
    const mockResults = [
      {
        id: 1,
        type: "channel",
        title: "Tech Channel",
        description: "Technology tutorials and reviews",
        thumbnail: "https://picsum.photos/120/90?random=1"
      },
      {
        id: 2,
        type: "playlist",
        title: "JavaScript Tutorials",
        description: "Complete JavaScript learning series",
        thumbnail: "https://picsum.photos/120/90?random=2"
      },
      {
        id: 3,
        type: "video",
        title: "React vs Vue Comparison",
        description: "Detailed comparison of React and Vue frameworks",
        thumbnail: "https://picsum.photos/120/90?random=3"
      }
    ].filter(item =>
      searchFilter() === "all" || item.type === searchFilter()
    ).filter(item =>
      item.title.toLowerCase().includes(query.toLowerCase()) ||
      item.description.toLowerCase().includes(query.toLowerCase())
    );

    setSearchResults(mockResults);
    setIsSearching(false);

    if (mockResults.length === 0) {
      args.showInfoToast("No results found for your search");
    } else {
      args.showSuccessToast(`Found ${mockResults.length} result(s)`);
    }
  }, 1000);
};

// Clear search
const clearSearch = () => {
  setSearchQuery("");
  setSearchResults([]);
  setSearchFilter("all");
};

return {
  searchQuery,
  setSearchQuery,
  searchFilter,
  setSearchFilter,
  searchResults,
  isSearching,
  handleSearch,
  clearSearch
};
'''
      }
    },
