{
  vertexes: [
    {
      id: "yto_search_page",
      L: "Page",
      P: {
        key: "YTOSearch",
        url: "/search",
        title: "Search - YouTube Organizer",
        description: "Search your YouTube channels, playlists, and videos",
        props: '''
return {
  isNoPermissionCheck: true,
  enabled: true
};
'''
      }
    },
    {
      id: "yto_search_layout",
      L: "PageLayout",
      P: {
        componentName: "YTOLayout",
        displayOrder: 1
      }
    },
    {
      id: "yto_search_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  onMount: () => {
    // Check if there's a query in URL params and search immediately
    const urlQuery = args.searchParams?.q || args.params?.q;
    if (urlQuery) {
      args.fns.setSearchQuery(urlQuery);
      args.fns.performSearch();
    }
  }
};
''',
        fns: '''
// State for search functionality
const [searchQuery, setSearchQuery] = args.createSignal('');
const [searchType, setSearchType] = args.createSignal('all');
const [searchResults, setSearchResults] = args.createSignal(null);
const [loading, setLoading] = args.createSignal(false);
const [error, setError] = args.createSignal(null);
const [activeTab, setActiveTab] = args.createSignal('all');

// Pagination state
const [currentPage, setCurrentPage] = args.createSignal(1);
const [itemsPerPage, setItemsPerPage] = args.createSignal(20);

// Regex search state
const [isRegexSearch, setIsRegexSearch] = args.createSignal(false);

// Perform search
const performSearch = async (page = null) => {
  const query = searchQuery().trim();

  if (!query) {
    args.showWarningToast("Please enter a search query");
    return;
  }

  // Use provided page or current page
  const searchPage = page !== null ? page : currentPage();

  try {
    setLoading(true);
    setError(null);

    const result = await args.executeNamedServerFunction({
      functionName: "searchUserContent",
      contextData: {
        query,
        type: searchType(),
        limit: itemsPerPage(),
        page: searchPage,
        isRegex: isRegexSearch()
      }
    });

    if (result.error) {
      const errorMessage = result.error;
      setError(errorMessage);
      args.showErrorToast(errorMessage);
    } else if (result.result && result.result.success) {
      // Process search results to handle Vertex format (properties in P field)
      const data = result.result.data;

      // Process channels
      const processedChannels = data.channels.map(item => {
        const channel = item.channel;
        const channelSettings = item.channelSettings;

        return {
          // Channel data from YouTube (accessing P field)
          channelId: channel.P.youtubeId,
          title: channel.P.title,
          description: channel.P.description,
          thumbnail: channel.P.thumbnail,
          subscriberCount: channel.P.subscriberCount,
          videoCount: channel.P.videoCount,

          // User-specific settings (accessing P field)
          customName: channelSettings.P.customName,
          displayName: channelSettings.P.customName || channel.P.title,
          isUserSaved: true
        };
      });

      // Process playlists
      const processedPlaylists = data.playlists.map(item => {
        const playlist = item.playlist;
        const playlistSettings = item.playlistSettings;
        const channel = item.channel;

        return {
          // Playlist data from YouTube (accessing P field)
          playlistId: playlist.P.youtubeId,
          title: playlist.P.title,
          description: playlist.P.description,
          thumbnails: playlist.P.thumbnails,
          itemCount: playlist.P.itemCount,
          publishedAt: playlist.P.publishedAt,

          // User-specific settings (accessing P field)
          customName: playlistSettings.P.customName,
          displayName: playlistSettings.P.customName || playlist.P.title,
          isUserSaved: true,

          // Parent channel info (accessing P field)
          parentChannelId: channel?.P.youtubeId || null,
          parentChannelTitle: channel?.P.title || null
        };
      });

      // Process videos
      const processedVideos = data.videos.map(item => {
        const video = item.video;
        const videoSettings = item.videoSettings;
        const parentPlaylist = item.parentPlaylist;

        return {
          // Video data from YouTube (accessing P field)
          videoId: video.P.youtubeId,
          title: video.P.title,
          description: video.P.description,
          thumbnails: video.P.thumbnails,
          thumbnail: video.P.thumbnails?.medium?.url || video.P.thumbnails?.default?.url || null,
          duration: video.P.duration,
          publishedAt: video.P.publishedAt,
          viewCount: video.P.viewCount,
          channelTitle: video.P.channelTitle,

          // User-specific settings (accessing P field)
          watched: videoSettings.P.watched || false,
          notes: videoSettings.P.notes || '',

          // Parent playlist info
          parentPlaylist: parentPlaylist ? {
            playlistId: parentPlaylist.playlist.P.youtubeId,
            title: parentPlaylist.playlist.P.title,
            displayName: parentPlaylist.playlistSettings?.P.customName || parentPlaylist.playlist.P.title
          } : null
        };
      });

      setSearchResults({
        channels: processedChannels,
        playlists: processedPlaylists,
        videos: processedVideos,
        totalResults: data.totalResults,
        query: data.query,
        pagination: data.pagination
      });

      // Update current page state from pagination data
      if (data.pagination && data.pagination.page) {
        setCurrentPage(data.pagination.page);
      }

      // Set active tab based on results
      if (processedChannels.length > 0 && processedPlaylists.length === 0 && processedVideos.length === 0) {
        setActiveTab('channels');
      } else if (processedPlaylists.length > 0 && processedChannels.length === 0 && processedVideos.length === 0) {
        setActiveTab('playlists');
      } else if (processedVideos.length > 0 && processedChannels.length === 0 && processedPlaylists.length === 0) {
        setActiveTab('videos');
      } else {
        setActiveTab('all');
      }
    } else {
      const errorMessage = result.result?.message || result.message || "Failed to search";
      setError(errorMessage);
      args.showErrorToast(errorMessage);
    }
  } catch (err) {
    console.error("Error performing search:", err);
    setError("Failed to search. Please try again.");
    args.showErrorToast("Failed to search. Please try again.");
  } finally {
    setLoading(false);
  }
};

// Handle enter key in search input
const handleKeyPress = (e) => {
  if (e.key === 'Enter') {
    performSearch();
  }
};

// Pagination functions
const goToPage = (page) => {
  setCurrentPage(page);
  performSearch(page);
};

const goToNextPage = () => {
  const results = searchResults();
  if (results?.pagination?.hasNextPage) {
    goToPage(currentPage() + 1);
  }
};

const goToPrevPage = () => {
  const results = searchResults();
  if (results?.pagination?.hasPrevPage) {
    goToPage(currentPage() - 1);
  }
};

const changeItemsPerPage = (newLimit) => {
  setItemsPerPage(newLimit);
  setCurrentPage(1); // Reset to first page
  performSearch(1);
};

return {
  searchQuery,
  setSearchQuery,
  searchType,
  setSearchType,
  searchResults,
  loading,
  error,
  activeTab,
  setActiveTab,
  currentPage,
  setCurrentPage,
  itemsPerPage,
  setItemsPerPage,
  isRegexSearch,
  setIsRegexSearch,
  performSearch,
  handleKeyPress,
  goToPage,
  goToNextPage,
  goToPrevPage,
  changeItemsPerPage
};
'''
      }
    },
    {
      id: "yto_search_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
