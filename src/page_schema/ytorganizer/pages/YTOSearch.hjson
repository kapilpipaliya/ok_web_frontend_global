      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const searchResults = args.fns.searchResults();
const pagination = searchResults?.pagination;

// Only show navigation controls if there are multiple pages
if (!pagination || pagination.totalPages <= 1) {
  return { as: "div", style: "display: none;" };
}

return {
  as: "div"
};
''',
        css: '''
return `._id {
