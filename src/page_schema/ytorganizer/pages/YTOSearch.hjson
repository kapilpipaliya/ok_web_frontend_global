{
  vertexes: [
    {
      id: "yto_search_page",
      L: "Page",
      P: {
        key: "YTOSearch",
        url: "/search",
        title: "Search - YouTube Organizer",
        description: "Search across your YouTube channels, playlists, and videos",
        props: '''
return {
  isNoPermissionCheck: true,
  enabled: true
};
'''
      }
    },
    {
      id: "yto_search_layout",
      L: "PageLayout",
      P: {
        componentName: "YTOLayout",
        displayOrder: 1
