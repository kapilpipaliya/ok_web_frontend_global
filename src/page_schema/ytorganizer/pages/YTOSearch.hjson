      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const searchResults = args.fns.searchResults();
const pagination = searchResults?.pagination;

return {
  as: "button",
  text: "Previous",
  disabled: !pagination?.hasPrevPage,
  onClick: () => {
    if (pagination?.hasPrevPage) {
      args.fns.goToPrevPage();
    }
  }
};
''',
        css: '''
return `._id {
  padding: 0.5rem 1rem;
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.375rem;
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;

  &:hover:not(:disabled) {
    background: ${args.theme.var.color.background_light_100};
    border-color: ${args.theme.var.color.info};
  }

  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 768px) {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_search_pagination_pages",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
