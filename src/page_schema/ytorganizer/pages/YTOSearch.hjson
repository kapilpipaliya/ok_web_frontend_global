      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const searchResults = args.fns.searchResults();
const pagination = searchResults?.pagination;
console.log(pagination)
if (!pagination) return { as: "div", style: "display: none;" };

const { startIndex, endIndex, totalCount, page, totalPages } = pagination;

return {
  as: "div",
  text: `Showing ${startIndex}-${endIndex} of ${totalCount} results (Page ${page} of ${totalPages})`
};
''',
        css: '''
return `._id {
  text-align: center;
