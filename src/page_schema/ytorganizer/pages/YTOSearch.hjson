  padding: 0.625rem 1rem;
  font-size: 0.875rem;
  font-weight: ${isActive ? '600' : '500'};
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: inherit;
  white-space: nowrap;

  &:hover {
    background: ${isActive ? args.theme.var.color.info_dark_200 : args.theme.var.color.background_light_100};
  }

  @media (max-width: 768px) {
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_search_tab_channels",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const results = args.fns.searchResults();
const activeTab = args.fns.activeTab();
const count = results ? results.channels.length : 0;

return {
  as: "button",
  onClick: () => args.fns.setActiveTab('channels'),
  hide: !results || results.channels.length === 0,
  text: `Channels (${count})`
};
''',
        css: '''
const activeTab = args.fns.activeTab();
const isActive = activeTab === 'channels';

return `._id {
