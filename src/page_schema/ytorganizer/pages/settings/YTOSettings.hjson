    {
      id: "ownership_selector",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "YTOTomSelect",
        props: '''
const ownerships = args.fns.ownerships?.() || [];
const selectedOwnership = args.fns.selectedOwnership?.();
const selectedOwnershipId = selectedOwnership?.P?.key;

// Transform ownerships into options format for TomSelect
// Add status indicator for disconnected accounts
const ownershipOptions = ownerships.map(ownership => {
  const name = ownership.P.customName || ownership.P.channelName || ownership.P.key;
  const isConnected = ownership._isConnected;
  const label = isConnected ? name : `${name} (Disconnected)`;

  return {
    value: ownership.P.key,
    label: label
  };
});

return {
  value: selectedOwnershipId || "",
  options: ownershipOptions,
  placeholder: "Select YouTube Account...",
  search: true,
  onChange: async (ownershipId) => {
    const ownership = ownerships.find(o => o.P.key === ownershipId);
    if (ownership) {
      // Check if account is disconnected
      if (!ownership._isConnected) {
        args.showWarningToast("This account is disconnected. Please reconnect it from Account Settings.");
        return;
      }

      await args.fns.selectOwnership?.(ownership);
      // Reload page to refresh all data with new ownership
      window.location.reload();
    }
  }
};
'''
      }
