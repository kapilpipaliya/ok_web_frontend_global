{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "YTOSettings",
        url: "/settings",
        signinRequired: true,
        fns: '''
// Message state for displaying success/error messages in UI
const [messageState, setMessageState] = args.createStore({
  type: null, // 'success' or 'error'
  text: '',
  visible: false
});

const showMessage = (type, text) => {
  setMessageState({ type, text, visible: true });
  // Auto-hide after 15 seconds
  setTimeout(() => {
    setMessageState('visible', false);
  }, 15000);
};

const hideMessage = () => {
  setMessageState('visible', false);
};

return {
  enabled: true,
  messageState,
  showMessage,
  hideMessage,
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
        componentName: "YTOLayout",
        displayOrder: 1
      }
    },
    {
      id: "setting_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  padding: 1.5rem;
  max-width: 1200px;
  margin: 0 auto;
}

