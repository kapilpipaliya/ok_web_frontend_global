}`;
'''
      }
    },
    {
      id: "delete_account_button",
      L: "Attr",
      P: {
        displayOrder: 6,
        componentName: "YTOButton",
        props: '''
return {
  text: "Delete Account",
  variant: "danger",
  onClick: async () => {
    const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
    if (!rbConfirm) {
      args.fns.showMessage('error', "Confirmation dialog not available");
      return;
    }

    const confirmed = await rbConfirm({
      title: "Delete Account",
      message: "⚠️ WARNING: This will permanently delete your account and ALL your data including channels, playlists, videos, notes, and favorites. This action CANNOT be undone! Are you absolutely sure?",
      confirmText: "Delete My Account",
      cancelText: "Cancel",
      variant: "danger"
    });

    if (confirmed) {
      // Double confirmation for account deletion
      const doubleConfirmed = await rbConfirm({
        title: "Final Confirmation",
        message: "This is your last chance! Your account will be permanently deleted. Are you absolutely sure you want to delete your account?",
        confirmText: "Yes, Delete My Account",
        cancelText: "Cancel",
        variant: "danger"
      });

      if (doubleConfirmed) {
        try {
          const result = await args.fns.executeYTOFunction("deleteAccount", {});

          if (result?.result?.success) {
            args.fns.showMessage('success', result.result.message || "Account deleted successfully");

            // Logout and redirect to home after 2 seconds
            setTimeout(() => {
              args.navigate("/auth/logout");
            }, 2000);
          } else {
            args.fns.showMessage('error', result?.result?.message || "Failed to delete account");
          }
        } catch (error) {
          console.error("Error deleting account:", error);
          args.fns.showMessage('error', "An error occurred while deleting account");
        }
      }
    }
  }
};
'''
      }
    },
