    {
      id: "5"
      L: Attr
      P: {
        css:
          '''
const messageState = args.fns.messageState;
const isSuccess = messageState?.type === 'success';
const isError = messageState?.type === 'error';

let bgColor = args.theme.var.color.background_light_100;
let borderColor = args.theme.var.color.border;
let textColor = args.theme.var.color.text;

if (isSuccess) {
  bgColor = args.theme.var.color.success_light_50;
  borderColor = args.theme.var.color.success;
  textColor = args.theme.var.color.success_light_50_text;
} else if (isError) {
  bgColor = args.theme.var.color.error_light_50;
  borderColor = args.theme.var.color.error;
  textColor = args.theme.var.color.error_light_50_text;
}

return `._id {
  background: ${bgColor};
  border: 2px solid ${borderColor};
  border-radius: 0.75rem;
  padding: 1rem 1.25rem;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  animation: slideDown 0.3s ease-out;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}`;
'''
        displayOrder: 2.5
