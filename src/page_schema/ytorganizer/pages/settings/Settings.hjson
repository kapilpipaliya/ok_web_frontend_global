        displayOrder: 3
        componentName: Button
        props:
          '''
return {
  text: "Clear All Data",
  variant: "danger",
  onClick: async () => {
    const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
    if (!rbConfirm) {
      args.fns.showMessage('error', "Confirmation dialog not available");
      return;
    }

    const confirmed = await rbConfirm({
      title: "Clear All Data",
      message: "Are you sure you want to delete all your YSaar data including channels, playlists, videos, notes, and favorites? This action cannot be undone!",
      confirmText: "Delete All Data",
      cancelText: "Cancel",
      variant: "danger"
    });

    if (confirmed) {
      try {
        const result = await args.fns.executeYTOFunction("clearAllUserData", {});

        if (result?.result?.success) {
          args.fns.showMessage('success', result.result.message || "All data cleared successfully");
        } else {
          args.fns.showMessage('error', result?.result?.message || result?.error || "Failed to clear data");
        }
      } catch (error) {
        console.error("Error clearing data:", error);
        args.fns.showMessage('error', "An error occurred while clearing data");
      }
    }
  }
};
'''
      }
    }
