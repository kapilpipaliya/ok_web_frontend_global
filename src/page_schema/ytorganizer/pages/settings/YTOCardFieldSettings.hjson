  margin: 0 0 1rem 0;
}`;
'''
      }
    },
    {
      id: "video_select",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "YTOTomSelect",
        props: '''
return {
  value: args.fns.videoFields(),
  options: args.fns.FIELD_OPTIONS.video,
  multiple: true,
  search: true,
  plugins: ['remove_button', 'drag_drop'],
  placeholder: "Select fields to display...",
  onChange: (newValue) => {
    args.fns.setVideoFields(Array.isArray(newValue) ? newValue : []);
  }
};
'''
      }
    },
