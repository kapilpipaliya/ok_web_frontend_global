{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        signinRequired: true
        fns:
          '''
// Available field options for each content type
// Using YouTube API field names directly
const FIELD_OPTIONS = {
  video: [
    { value: "description", label: "Description" },
    { value: "channelTitle", label: "Channel Name" },
    { value: "publishedAt", label: "Published Date" },
    { value: "duration", label: "Duration" },
    { value: "viewCount", label: "View Count" },
    { value: "likeCount", label: "Like Count" },
    { value: "commentCount", label: "Comment Count" },
    { value: "position", label: "Position (in Playlist)" },
    { value: "note", label: "Personal Notes" }
  ],
  playlist: [
    { value: "description", label: "Description" },
    { value: "itemCount", label: "Video Count" },
    { value: "updatedAt", label: "Last Updated" },
    { value: "channelTitle", label: "Channel" },
    { value: "publishedAt", label: "Published Date" }
  ],
  channel: [
    { value: "description", label: "Description" },
    { value: "videoCount", label: "Video Count" },
    { value: "subscriberCount", label: "Subscriber Count" },
    { value: "publishedAt", label: "Created Date" }
  ]
};

// Default setting - using YouTube API field names
const defaultSetting = {
  video: ["description", "channelTitle", "publishedAt", "duration", "viewCount"],
  playlist: ["description", "itemCount", "updatedAt", "channelTitle"],
  channel: ["description", "videoCount", "subscriberCount", "publishedAt"]
};

// Local state for edited setting - start with empty arrays
const [videoFields, setVideoFields] = args.createSignal([]);
const [playlistFields, setPlaylistFields] = args.createSignal([]);
const [channelFields, setChannelFields] = args.createSignal([]);

// Save state
const [isSaving, setIsSaving] = args.createSignal(false);

// Initialize from layout setting on mount
args.createEffect(() => {
  const setting = args.fns.cardFieldSetting?.();
  if (setting) {
    setVideoFields(setting.video || defaultSetting.video);
    setPlaylistFields(setting.playlist || defaultSetting.playlist);
    setChannelFields(setting.channel || defaultSetting.channel);
  } else {
    // Use defaults if no setting exist
    setVideoFields(defaultSetting.video);
    setPlaylistFields(defaultSetting.playlist);
    setChannelFields(defaultSetting.channel);
  }
});

// Handle save
const handleSave = async () => {
  setIsSaving(true);
  try {
    const newSetting = {
      video: videoFields(),
      playlist: playlistFields(),
      channel: channelFields()
    };

    // saveCardFieldSetting already shows success/error toasts
    await args.fns.saveCardFieldSetting(newSetting);
  } catch (error) {
    console.error("Error saving card field setting:", error);
  } finally {
    setIsSaving(false);
  }
};

// Handle cancel
const handleCancel = () => {
  args.navigate("/settings");
};

return {
  enabled: true,
  FIELD_OPTIONS,
  videoFields,
  setVideoFields,
  playlistFields,
  setPlaylistFields,
  channelFields,
  setChannelFields,
  isSaving,
  handleSave,
  handleCancel
};
'''
        url: /settings/card-fields
        key: CardFieldSetting
        props:
          '''
return {
  isNoPermissionCheck: true
};
'''
      }
    }
