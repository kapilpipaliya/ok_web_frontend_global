const account = c?.account;
const isConnected = account?.isConnected;

return `._id {
  display: inline-block;
  padding: ${t.var.spacing.xs} ${t.var.spacing.sm};
  border-radius: ${t.var.borderRadius.sm};
  font-size: 0.75rem;
  font-weight: 600;
  white-space: nowrap;
  ${isConnected ? `
    background: ${t.var.color.success_light_100};
    color: ${t.var.color.success_light_100_text};
  ` : `
    background: ${t.var.color.background_light_100};
    color: ${t.var.color.background_light_100_text};
  `}
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const account = c?.account;
const isConnected = account?.isConnected;

return {
  as: "span",
  text: isConnected ? "Connected" : "Disconnected"
};
'''
      }
    }
    {
      id: "40"
      L: Attr
      P: {
        css:
          '''
return `._id {
  padding: ${t.var.spacing.md};
  text-align: center;
  font-size: 1.125rem;
}`;
'''
        displayOrder: 5
        componentName: Html
        props:
          '''
