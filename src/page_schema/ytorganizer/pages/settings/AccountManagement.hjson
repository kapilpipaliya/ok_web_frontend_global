    background: ${args.theme.var.color.success_light_100};
    color: ${args.theme.var.color.success_light_100_text};
  ` : `
    background: ${args.theme.var.color.muted_light_100};
    color: ${args.theme.var.color.muted_light_100_text};
  `}
}`;
'''
