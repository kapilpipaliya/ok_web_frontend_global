        componentName: "Html"
        props: '''
const account = args.contextData?.account;
const ownership = account?.ownership;
const isPrimary = ownership?.P?.isPrimary;

return {
  as: "td",
  text: isPrimary ? "⭐" : ""
};
'''
        css: '''
return `._id {
  padding: ${args.theme.var.spacing.md};
  text-align: center;
  font-size: ${args.theme.var.fontSize.lg};
}`;
'''
      }
    }

    // TD: Last Activity
    {
      id: "td_last_activity"
      L: "Attr"
      P: {
        displayOrder: 6
        componentName: "Html"
        props: '''
const account = args.contextData?.account;
const isConnected = account?.isConnected;
const token = account?.token;
const lastRefreshed = token?.P?.lastRefreshed;
const revokedAt = token?.P?.revokedAt;

let activityText = "";

if (isConnected && lastRefreshed) {
  const date = new Date(lastRefreshed);
  activityText = `${date.toLocaleDateString()} ${date.toLocaleTimeString()}`;
} else if (!isConnected && revokedAt) {
  const date = new Date(revokedAt);
  activityText = `Disconnected: ${date.toLocaleDateString()}`;
} else {
  activityText = "-";
}

return {
  as: "td",
  text: activityText
};
'''
        css: '''
return `._id {
  padding: ${args.theme.var.spacing.md};
  color: ${args.theme.var.color.muted};
  font-size: ${args.theme.var.fontSize.xs};
  white-space: nowrap;
}`;
'''
      }
    }

    // TD: Actions
    {
      id: "td_actions"
      L: "Attr"
      P: {
        displayOrder: 7
        componentName: "Html"
        props: '''
return {
  as: "td"
};
'''
        css: '''
return `._id {
  padding: ${args.theme.var.spacing.md};
  text-align: center;
}`;
'''
      }
    }

    // Action buttons container
    {
      id: "action_buttons"
      L: "Attr"
      P: {
        displayOrder: 1
        componentName: "Html"
        props: '''
return {
  as: "div"
};
'''
        css: '''
return `._id {
  display: flex;
  gap: ${args.theme.var.spacing.sm};
  justify-content: center;
}`;
'''
      }
    }

    // Reconnect button (for disconnected accounts)
    {
      id: "reconnect_button"
      L: "Attr"
      P: {
        displayOrder: 1
        componentName: "Button"
        props: '''
const account = args.contextData?.account;
const isConnected = account?.isConnected;
const isConnecting = args.fns.isConnecting?.();

return {
  text: isConnecting ? "Connecting..." : "Reconnect",
  variant: "primary",
  onClick: args.fns.connectAccount,
  disabled: isConnecting,
  hide: isConnected
};
'''
      }
    }

    // Disconnect button (for connected accounts)
    {
      id: "disconnect_button"
      L: "Attr"
      P: {
        displayOrder: 2
        componentName: "Button"
        props: '''
const account = args.contextData?.account;
const ownership = account?.ownership;
const ownershipId = ownership?.P?.key;
const channelName = ownership?.P?.customName || ownership?.P?.channelName || "Unknown Channel";
const isConnected = account?.isConnected;
const disconnectingId = args.fns.disconnectingId?.();
const isDisconnecting = disconnectingId === ownershipId;

return {
  text: isDisconnecting ? "Disconnecting..." : "Disconnect",
  variant: "danger",
  onClick: () => args.fns.disconnectAccount(ownershipId, channelName),
  disabled: isDisconnecting,
  hide: !isConnected
};
'''
      }
    }

    // Empty state (no accounts)
    {
      id: "empty_state"
      L: "Attr"
      P: {
        displayOrder: 5
        componentName: "Html"
        props: '''
const isLoading = args.fns.isLoading?.();
const ownerships = args.fns.ownerships?.() || [];
const hasAccounts = ownerships.length > 0;

return {
  as: "div",
  hide: isLoading || hasAccounts
};
'''
        css: '''
return `._id {
  text-align: center;
  padding: ${args.theme.var.spacing.xxl};
  background: ${args.theme.var.color.background_dark_50};
  border-radius: ${args.theme.var.borderRadius.lg};
  border: 2px dashed ${args.theme.var.color.border};
}`;
'''
      }
    }

    // Empty state icon
    {
      id: "empty_state_icon"
      L: "Attr"
      P: {
        displayOrder: 1
        componentName: "Html"
        props: '''
return {
  as: "icon",
  icon: "ph:youtube-logo",
  width: 64,
  height: 64
};
'''
        css: '''
return `._id {
  color: ${args.theme.var.color.muted};
  margin-bottom: ${args.theme.var.spacing.md};
}`;
'''
      }
    }

    // Empty state title
    {
      id: "empty_state_title"
      L: "Attr"
      P: {
        displayOrder: 2
        componentName: "Html"
        props: '''
return {
  as: "h3",
  text: "No YouTube Channels Connected"
};
'''
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.xl};
  font-weight: 600;
  color: ${args.theme.var.color.text};
  margin: 0 0 ${args.theme.var.spacing.sm} 0;
}`;
'''
      }
    }

    // Empty state description
    {
      id: "empty_state_description"
      L: "Attr"
      P: {
        displayOrder: 3
        componentName: "Html"
        props: '''
return {
  as: "p",
  text: "Connect your YouTube channels to start organizing your content. Each channel requires a separate connection."
};
'''
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.md};
  color: ${args.theme.var.color.muted};
  margin: 0 0 ${args.theme.var.spacing.lg} 0;
}`;
'''
      }
    }

    // Empty state button
    {
      id: "empty_state_button"
      L: "Attr"
      P: {
        displayOrder: 4
        componentName: "Button"
        props: '''
const isConnecting = args.fns.isConnecting?.();

return {
  text: isConnecting ? "Connecting..." : "Connect YouTube Channel",
  variant: "primary",
  onClick: args.fns.connectAccount,
  disabled: isConnecting
};
'''
      }
    }
  ]

