const messageState = args.fns.messageState;
const isError = messageState?.type === 'error';

return `._id {
  margin-bottom: ${args.theme.var.spacing.lg};
  padding: ${args.theme.var.spacing.md};
  border-radius: ${args.theme.var.borderRadius.md};
  background: ${isError ? args.theme.var.color.error_light_100 : args.theme.var.color.success_light_100};
  border: 1px solid ${isError ? args.theme.var.color.error : args.theme.var.color.success};
  display: flex;
  align-items: flex-start;
  gap: ${args.theme.var.spacing.md};
  animation: slideDown 0.3s ease-out;

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    padding: ${args.theme.var.spacing.sm};
    gap: ${args.theme.var.spacing.sm};
  }
}`;
'''
      }
