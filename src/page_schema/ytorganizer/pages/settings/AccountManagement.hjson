{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        signinRequired: true
        fns:
          '''
// State for ownerships
const [ownerships, setOwnerships] = _.createSignal([]);
const [isLoading, setIsLoading] = _.createSignal(true);
const [isConnecting, setIsConnecting] = _.createSignal(false);
const [disconnectingId, setDisconnectingId] = _.createSignal(null);

// Message state for displaying OAuth callback messages
const [messageState, setMessageState] = _.createStore({
  type: null, // 'success' or 'error'
  text: '',
  visible: false
});

const showMessage = (type, text) => {
  setMessageState({ type, text, visible: true });
  setTimeout(() => {
    setMessageState('visible', false);
  }, 15000);
};

const hideMessage = () => {
  setMessageState('visible', false);
};

// Handle OAuth callback messages from URL params
const handleOAuthCallback = () => {
  const urlParams = new URLSearchParams(window.location.search);
  const success = urlParams.get('success');
  const error = urlParams.get('error');

  if (success) {
    showMessage('success', decodeURIComponent(success));
    window.history.replaceState({}, '', window.location.pathname);
    fetchOwnerships();
  } else if (error) {
    showMessage('error', decodeURIComponent(error));
    window.history.replaceState({}, '', window.location.pathname);
  }
};

// Fetch all ownerships (including disconnected)
const fetchOwnerships = async () => {
  setIsLoading(true);
  try {
    const result = await s({
      functionName: "getAllYouTubeOwnerships",
      contextData: {}
    });

    if (result?.result?.success && result?.result?.data) {
      setOwnerships(result.result.data);
    } else {
      _.showErrorToast(result?.error || "Failed to load YouTube accounts");
    }
  } catch (error) {
    console.error("Error fetching ownerships:", error);
    _.showErrorToast("Error loading YouTube accounts");
  } finally {
    setIsLoading(false);
  }
};

// Connect YouTube account (redirect to OAuth)
const connectAccount = () => {
  const isInIframe = window.self !== window.top;

  if (isInIframe) {
    // Open in new tab when in iframe (e.g., extension)
    window.open("/api/auth/youtube/connect", "_blank");
  } else {
    setIsConnecting(true);
    window.location.href = "/api/auth/youtube/connect";
  }
};

// Reconnect a disconnected account
const reconnectAccount = (ownershipId) => {
  const isInIframe = window.self !== window.top;

  if (isInIframe) {
    // Open in new tab when in iframe (e.g., extension)
    window.open("/api/auth/youtube/connect", "_blank");
  } else {
    setIsConnecting(true);
    // Reconnect uses the same OAuth flow
    window.location.href = "/api/auth/youtube/connect";
  }
};

// Disconnect an account
const disconnectAccount = async (ownershipId, channelName) => {
  const rbConfirm = c?.confirmContext?.rbConfirm;
  if (!rbConfirm) {
    _.showErrorToast("Confirmation dialog not available");
    return;
  }

  const confirmed = await rbConfirm({
    title: "Disconnect YouTube Account",
    message: `Are you sure you want to disconnect "${channelName}"? The account will remain in your list but you won't be able to access its data until you reconnect.`,
    confirmText: "Disconnect",
    cancelText: "Cancel",
    variant: "danger"
  });

  if (!confirmed) return;

  setDisconnectingId(ownershipId);
  try {
    const response = await fetch("/api/auth/youtube/disconnect", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({ ownershipId })
    });
    const result = await response.json();

    if (result.success) {
      _.showSuccessToast(`Disconnected "${channelName}" successfully`);
      await fetchOwnerships();
    } else {
      _.showErrorToast(result.error || "Failed to disconnect account");
    }
  } catch (error) {
    console.error("Error disconnecting account:", error);
    _.showErrorToast("An error occurred while disconnecting");
  } finally {
    setDisconnectingId(null);
  }
};

return {
  enabled: true,
  ownerships,
  isLoading,
  isConnecting,
  disconnectingId,
  messageState,
  fetchOwnerships,
  connectAccount,
  reconnectAccount,
  disconnectAccount,
  showMessage,
  hideMessage,
  handleOAuthCallback
};
'''
        url: /accounts
        key: AccountManagement
        props:
          '''
return {
  isNoPermissionCheck: true,
  onMount: () => {
    f.handleOAuthCallback?.();
    f.fetchOwnerships();
  }
};
'''
      }
    }
