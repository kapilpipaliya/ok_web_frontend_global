      id: "stats_section",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "Html",
        contextName: "userStats",
        serverFunction: '''
try {
  // Execute the getUserCount function
  const result = await args.executeNamedServerFunction({
    functionName: "getUserCount",
    contextData: {}
  });

  if (result?.result?.success) {
    return result.result.data;
  }

  return { totalUsers: 0 };
} catch (error) {
  console.error("Error loading user count:", error);
  return { totalUsers: 0 };
}
''',
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  padding: 4rem 2rem;
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  text-align: center;
}

@media (max-width: 768px) {
  ._id {
    padding: 3rem 1rem;
  }
}`;
'''
