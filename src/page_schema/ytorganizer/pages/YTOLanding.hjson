        css: '''
const tier = args.contextData.tier;
const isPopular = tier?.popular;

return `._id {
  width: 100%;
  background: ${args.theme.var.color.background};
  border: ${isPopular ? `2px solid ${args.theme.var.color.primary}` : `1px solid ${args.theme.var.color.border}`};
  border-radius: 1rem;
  padding: 2rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
  position: relative;
  box-shadow: ${isPopular ? '0 8px 24px rgba(0, 0, 0, 0.12)' : '0 2px 8px rgba(0, 0, 0, 0.05)'};
}

._id:hover {
  transform: translateY(-8px);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.15);
  border-color: ${args.theme.var.color.primary};
}

@media (max-width: 768px) {
  ._id {
    padding: 1.5rem 1rem;
  }
}`;
'''
