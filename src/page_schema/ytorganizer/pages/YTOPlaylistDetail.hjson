        componentName: "Html",
        props: '''
const videos = args.fns.videos();
const loading = args.fns.loading();

if (loading) {
  return {
    as: "span",
    text: "Loading..."
  };
}

const watchedCount = videos.filter(v => v.watched).length;
const unwatchedCount = videos.length - watchedCount;

return {
  as: "span",
  text: `${watchedCount} watched, ${unwatchedCount} unwatched`
};
''',
        css: '''
return `._id {
  background: rgba(255,255,255,0.15);
