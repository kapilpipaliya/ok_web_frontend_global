    {
      id: "yto_playlist_detail_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
return `._id {
  background: linear-gradient(135deg, ${args.theme.var.color.success}, ${args.theme.var.color.success_dark_200});
  color: ${args.theme.var.color.success_text};
  padding: 2rem 1.5rem;
  position: relative;
  overflow: hidden;
  
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="2" fill="white" opacity="0.1"/><circle cx="80" cy="40" r="1" fill="white" opacity="0.05"/><circle cx="40" cy="80" r="1.5" fill="white" opacity="0.08"/></svg>') repeat;
    pointer-events: none;
  }
  
  @media (max-width: 768px) {
    padding: 1.5rem 1rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_playlist_detail_header_content",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}`;
'''
      }
    },
    {
      id: "yto_playlist_detail_back_button",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "button",
  onClick: () => args.navigate('/playlists')
};
''',
        css: '''
return `._id {
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  color: ${args.theme.var.color.success_text};
  border-radius: 0.5rem;
  padding: 0.75rem;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: inherit;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
  
  &:hover {
    background: rgba(255,255,255,0.15);
    transform: translateX(-2px);
  }
  
  @media (max-width: 768px) {
    padding: 0.625rem;
    margin-bottom: 1rem;
  }
}`;
'''
      }
