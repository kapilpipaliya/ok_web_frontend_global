};
''',
        css: '''
return `._id {
  opacity: 0.7;
  
  @media (max-width: 768px) {
    width: 32px;
    height: 32px;
  }
}`;
'''
      }
    },
    {
      id: "yto_playlist_detail_meta",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
'''
      }
    },
    {
      id: "yto_playlist_detail_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const playlistData = args.fns.playlistData();
const loading = args.fns.loading();

const playlistTitle = loading ? 'Loading...' : (playlistData?.playlistSettings?.P?.customName || playlistData?.playlist?.P?.title || 'Unknown Playlist');

return {
  as: "h1",
  text: playlistTitle
};
''',
        css: '''
return `._id {
  font-size: 2rem;
  font-weight: 700;
  margin: 0 0 0.5rem 0;
  line-height: 1.2;
  
  @media (max-width: 768px) {
    font-size: 1.5rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_playlist_detail_stats",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 0.75rem;
  
  @media (max-width: 768px) {
    justify-content: center;
    gap: 0.75rem;
  }
}`;
'''
