};
''',
        css: '''
return `._id {
  width: 120px;
  height: 68px;
  background: ${args.theme.var.color.background_dark_100};
  border-radius: 0.5rem;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;

  @media (max-width: 768px) {
    width: 100%;
    height: 180px;
  }
}`;
'''
      }
