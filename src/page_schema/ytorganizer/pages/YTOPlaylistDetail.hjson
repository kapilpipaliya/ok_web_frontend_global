  as: "div"
};
''',
        css: '''
return `._id {
  width: 120px;
  height: 90px;
  background: rgba(255,255,255,0.1);
  border-radius: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 2px solid rgba(255,255,255,0.2);
  
  @media (max-width: 768px) {
    width: 100px;
    height: 75px;
    margin: 0 auto;
  }
}`;
'''
      }
    },
    {
      id: "yto_playlist_detail_thumbnail_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
