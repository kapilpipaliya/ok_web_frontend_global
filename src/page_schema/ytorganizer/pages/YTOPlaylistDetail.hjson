  };
}

const description = playlistData?.playlist?.P?.description || 'No description available.';

return {
  as: "p",
  text: description
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  line-height: 1.5;
  margin: 0;
  opacity: 0.9;
  max-width: 600px;
}`;
'''
      }
    },
    {
      id: "yto_playlist_detail_youtube_link",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
const playlistData = args.fns.playlistData();
const loading = args.fns.loading();

// Don't show for custom playlists or while loading
if (loading || playlistData?.playlist?.P?.isCustom) {
  return { hide: true };
}

const youtubeId = playlistData?.playlist?.P?.youtubeId;

return {
  as: "button",
  onClick: () => {
    if (youtubeId) {
      window.open(`https://www.youtube.com/playlist?list=${youtubeId}`, '_blank');
    }
  }
};
''',
        css: '''
return `._id {
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  color: ${args.theme.var.color.success_text};
  border-radius: 0.5rem;
  padding: 0.75rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: inherit;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 1rem;

  &:hover {
    background: rgba(255,255,255,0.15);
    transform: translateY(-1px);
  }

  &:active {
    transform: translateY(0);
  }
}`;
'''
      }
