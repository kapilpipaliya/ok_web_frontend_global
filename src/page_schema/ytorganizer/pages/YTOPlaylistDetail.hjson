  font-family: inherit;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
  
  &:hover {
    background: rgba(255,255,255,0.15);
    transform: translateX(-2px);
  }
  
  @media (max-width: 768px) {
    padding: 0.625rem;
    margin-bottom: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_playlist_detail_back_icon",
      L: "Attr",
      P: {
