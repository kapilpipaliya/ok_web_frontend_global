''',
        css: '''
return `._id {
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}`;
'''
      }
    },
    {
      id: "yto_playlist_detail_back_button",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "button",
  onClick: () => args.navigate('/playlists')
};
''',
        css: '''
return `._id {
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  color: ${args.theme.var.color.success_text};
  border-radius: 0.5rem;
  padding: 0.75rem;
