{
  vertexes: [
    {
      id: "yto_playlist_detail_page",
      L: "Page",
      P: {
        key: "YTOPlaylistDetail",
        url: "/playlist",
        title: "Playlist Details - YouTube Organizer",
        description: "View and manage videos in your YouTube playlist with custom ordering",
        props: '''
return {
  isNoPermissionCheck: true,
  enabled: true
};
'''
      }
    },
    {
      id: "yto_playlist_detail_layout",
      L: "PageLayout",
      P: {
        componentName: "YTOLayout",
        displayOrder: 1
      }
    },
    {
      id: "yto_playlist_detail_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  onMount: () => args.fns.loadPlaylistVideos()
};
''',
        fns: '''
// State for playlist data
const [playlistData, setPlaylistData] = args.createSignal(null);
const [videos, setVideos] = args.createSignal([]);
const [loading, setLoading] = args.createSignal(true);
const [error, setError] = args.createSignal(null);
const [sortBy, setSortBy] = args.createSignal('index');

// Search state
const [searchQuery, setSearchQuery] = args.createSignal('');
const [filteredVideos, setFilteredVideos] = args.createSignal([]);

// Custom order state
const [customOrder, setCustomOrder] = args.createSignal([]);
const [isDragging, setIsDragging] = args.createSignal(false);
const [draggedVideoId, setDraggedVideoId] = args.createSignal(null);
const [dragOverVideoId, setDragOverVideoId] = args.createSignal(null);
const [isSavingOrder, setIsSavingOrder] = args.createSignal(false);

// Get playlist ID from URL params
const playlistId = args.searchParams?.playlistId || args.params?.playlistId;

// Load playlist videos when component mounts
const loadPlaylistVideos = async () => {
  if (!playlistId) {
    setError("Playlist ID not provided");
    setLoading(false);
    return;
  }

  try {
    setLoading(true);
    setError(null);

    const result = await args.executeNamedServerFunction({
      functionName: "getPlaylistVideos",
      contextData: { playlistId }
    });

    if (result.error) {
      const errorMessage = result.error;
      setError(errorMessage);
      args.showErrorToast(errorMessage);
    } else if (result.result && result.result.success) {
      // Use raw vertex data directly
      const playlistData = result.result.data.playlist;
      setPlaylistData(playlistData);
      setVideos(result.result.data.videos);
      setFilteredVideos(result.result.data.videos);
      setSortBy(playlistData.playlistSettings?.P?.sortBy || 'index');
      setCustomOrder(playlistData.playlistSettings?.P?.customOrder || []);
    } else {
      const errorMessage = result.result?.message || result.message || "Failed to load playlist videos";
      setError(errorMessage);
      args.showErrorToast(errorMessage);
    }
  } catch (err) {
    console.error("Error loading playlist videos:", err);
    setError("Failed to load playlist videos");
    args.showErrorToast("Failed to load playlist videos");
  } finally {
    setLoading(false);
  }
};

// Search functionality
const performSearch = (query) => {
  setSearchQuery(query); // Keep the original query with capitals

  const searchTerm = query.toLowerCase().trim(); // Convert to lowercase only for searching

  if (!searchTerm) {
    setFilteredVideos(videos());
    return;
  }

  const filtered = videos().filter(video => {
    const title = (video.video?.P?.title || '').toLowerCase();
    const description = (video.video?.P?.description || '').toLowerCase();
    return title.includes(searchTerm) || description.includes(searchTerm);
  });

  setFilteredVideos(filtered);
};

const clearSearch = () => {
  setSearchQuery('');
  setFilteredVideos(videos());
};

// Clear playlist user settings
const clearPlaylistSettings = async () => {
  const confirmed = confirm(
    "⚠️ WARNING: This will clear all your personal settings for this playlist including:\n\n" +
    "• Custom playlist name\n" +
    "• Custom video ordering\n" +
    "• Sort preferences\n" +
    "• Display preferences\n\n" +
    "This action CANNOT be undone.\n\n" +
    "Are you sure you want to continue?"
  );

  if (!confirmed) {
    return;
  }

  if (!playlistId) {
    args.showErrorToast("Playlist ID not available");
    return;
  }

  try {
    const result = await args.executeNamedServerFunction({
      functionName: "clearPlaylistUserSettings",
      contextData: { playlistId }
    });

    if (result.error) {
      const errorMessage = result.error;
      args.showErrorToast(errorMessage);
    } else if (result.result && result.result.success) {
      args.showSuccessToast("Playlist user settings cleared successfully!");
      // Reload playlist data to reflect changes
      loadPlaylistVideos();
    } else {
      const errorMessage = result.result?.message || result.message || "Failed to clear playlist settings";
      args.showErrorToast(errorMessage);
    }
  } catch (err) {
    console.error("Error clearing playlist settings:", err);
    args.showErrorToast("Failed to clear playlist settings. Please try again.");
  }
};

// Save sort preference to database
const saveSortPreference = async (newSortBy, newCustomOrder = null) => {
  if (!playlistId) return;

  try {
    const result = await args.executeNamedServerFunction({
      functionName: "updatePlaylistSortPreference",
      contextData: {
        playlistId,
        sortBy: newSortBy,
        customOrder: newCustomOrder
      }
    });

    if (result.error) {
      args.showErrorToast("Failed to save sort preference");
    } else if (result.result && result.result.success) {
      args.showSuccessToast("Sort preference saved");
    }
  } catch (err) {
    console.error("Error saving sort preference:", err);
    args.showErrorToast("Failed to save sort preference");
  }
};

// Handle sort change
const handleSortChange = async (newSortBy) => {
  setSortBy(newSortBy);
  await saveSortPreference(newSortBy, newSortBy === 'custom' ? customOrder() : null);
};

// Drag and drop handlers for custom ordering
const handleDragStart = (videoId) => {
  setIsDragging(true);
  setDraggedVideoId(videoId);

  // Add global mouse move listener for auto-scroll anywhere on screen
  const globalMouseMoveHandler = (event) => {
    if (draggedVideoId()) {
      const scrolled = autoScroll(event.clientY);
      if (scrolled) {
        console.log('Mouse auto-scroll triggered at Y:', event.clientY);
      }
    }
  };

  document.addEventListener('mousemove', globalMouseMoveHandler);

  // Store the global handler for cleanup
  window._dragGlobalMouseHandler = globalMouseMoveHandler;

  console.log('Mouse drag started, auto-scroll enabled');
};

const handleDragOver = (e, videoId) => {
  e.preventDefault();
  if (draggedVideoId() && draggedVideoId() !== videoId) {
    setDragOverVideoId(videoId);

    // Auto-scroll when dragging near top/bottom edges
    autoScroll(e.clientY);

    // Immediately reorder the visual list for better UX
    const sourceVideoId = draggedVideoId();
    const currentVideos = [...filteredVideos()];
    const sourceIndex = currentVideos.findIndex(v => v.video?.P?.youtubeId === sourceVideoId);
    const targetIndex = currentVideos.findIndex(v => v.video?.P?.youtubeId === videoId);

    if (sourceIndex !== -1 && targetIndex !== -1 && sourceIndex !== targetIndex) {
      // Reorder the array for immediate visual feedback
      const [movedVideo] = currentVideos.splice(sourceIndex, 1);
      currentVideos.splice(targetIndex, 0, movedVideo);
      setFilteredVideos(currentVideos);

      // Update the temporary custom order for visual feedback
      const newOrder = currentVideos.map(v => v.video?.P?.youtubeId);
      setCustomOrder(newOrder);
    }
  }
};

const handleDragEnd = () => {
  setIsDragging(false);
  setDraggedVideoId(null);
  setDragOverVideoId(null);

  // Clear auto-scroll interval
  if (autoScrollInterval) {
    clearInterval(autoScrollInterval);
    autoScrollInterval = null;
  }

  // Remove global event listeners
  if (window._dragGlobalTouchHandler) {
    document.removeEventListener('touchmove', window._dragGlobalTouchHandler);
    window._dragGlobalTouchHandler = null;
  }
  if (window._dragGlobalMouseHandler) {
    document.removeEventListener('mousemove', window._dragGlobalMouseHandler);
    window._dragGlobalMouseHandler = null;
  }

  console.log('Drag ended, auto-scroll disabled');
};

const handleDrop = async (e, targetVideoId) => {
  e.preventDefault();

  const sourceVideoId = draggedVideoId();
  if (!sourceVideoId) {
    handleDragEnd();
    return;
  }

  // The reordering was already done in handleDragOver, so just save to database
  const currentOrder = customOrder();
  if (currentOrder.length > 0) {
    setIsSavingOrder(true);
    await saveSortPreference('custom', currentOrder);
    setIsSavingOrder(false);
  }

  handleDragEnd();
};

// Auto-scroll helper for drag and drop
const autoScroll = (clientY) => {
  const isMobile = window.innerWidth <= 768;
  const scrollThreshold = isMobile ? 200 : 150; // Much larger threshold
  const scrollSpeed = isMobile ? 25 : 15; // Even faster scrolling
  const viewportHeight = window.innerHeight;
  const maxScroll = document.documentElement.scrollHeight - window.innerHeight;

  // Account for footer on web (assume 100px footer height)
  const footerHeight = isMobile ? 0 : 100;
  const effectiveViewportHeight = viewportHeight - footerHeight;

  console.log('AutoScroll called - clientY:', clientY, 'viewport:', viewportHeight, 'scrollY:', window.scrollY, 'maxScroll:', maxScroll);

  // Check if near top edge
  if (clientY < scrollThreshold && window.scrollY > 0) {
    const scrollAmount = Math.max(2, (scrollThreshold - clientY) / 3);
    const scrollDistance = -scrollAmount * scrollSpeed;
    window.scrollBy(0, scrollDistance);
    console.log('Scrolling UP:', scrollDistance, 'clientY:', clientY, 'threshold:', scrollThreshold);
    return true;
  }
  // Check if near bottom edge (account for footer)
  else if (clientY > effectiveViewportHeight - scrollThreshold && window.scrollY < maxScroll - 50) {
    const scrollAmount = Math.max(2, (clientY - (effectiveViewportHeight - scrollThreshold)) / 3);
    const scrollDistance = scrollAmount * scrollSpeed;
    window.scrollBy(0, scrollDistance);
    console.log('Scrolling DOWN:', scrollDistance, 'clientY:', clientY, 'threshold:', effectiveViewportHeight - scrollThreshold);
    return true;
  }

  return false;
};

// Handle touch events for mobile drag and drop
let touchItem = null;
let touchOffset = { x: 0, y: 0 };
let autoScrollInterval = null;

const handleTouchStart = (e, videoId) => {
  const touch = e.touches[0];
  touchItem = videoId;
  currentTouchY = touch.clientY;
  const element = e.currentTarget;
  const rect = element.getBoundingClientRect();
  touchOffset = {
    x: touch.clientX - rect.left,
    y: touch.clientY - rect.top
  };

  setIsDragging(true);
  setDraggedVideoId(videoId);

  // Add visual feedback
  element.style.opacity = '0.5';

  // Add global touch move listener for auto-scroll anywhere on screen
  const globalTouchMoveHandler = (event) => {
    if (touchItem && event.touches && event.touches[0]) {
      currentTouchY = event.touches[0].clientY;
      // Immediate auto-scroll on touch move
      autoScroll(currentTouchY);
    }
  };

  document.addEventListener('touchmove', globalTouchMoveHandler, { passive: false });

  // Start very aggressive auto-scroll interval for mobile
  autoScrollInterval = setInterval(() => {
    if (touchItem && currentTouchY) {
      const scrolled = autoScroll(currentTouchY);
      if (scrolled) {
        console.log('Interval auto-scroll triggered at Y:', currentTouchY);
      }
    }
  }, 16); // 60fps for ultra-smooth scrolling

  // Store the global handler for cleanup
  window._dragGlobalTouchHandler = globalTouchMoveHandler;

  console.log('Touch drag started at Y:', currentTouchY, 'auto-scroll enabled');
};

// Store current touch position for auto-scroll
let currentTouchY = 0;

const handleTouchMove = (e) => {
  if (!touchItem) return;
  e.preventDefault();

  const touch = e.touches[0];
  currentTouchY = touch.clientY; // Store for auto-scroll interval

  // Force auto-scroll call on touch move
  const scrolled = autoScroll(currentTouchY);
  if (scrolled) {
    console.log('Direct touchmove auto-scroll triggered at Y:', currentTouchY);
  }

  const elementBelow = document.elementFromPoint(
    touch.clientX,
    touch.clientY
  );

  if (elementBelow) {
    const videoElement = elementBelow.closest('[data-video-id]');
    if (videoElement) {
      const videoId = videoElement.getAttribute('data-video-id');
      if (videoId && videoId !== touchItem) {
        setDragOverVideoId(videoId);

        // Immediately reorder the visual list for better UX (same as handleDragOver)
        const sourceVideoId = touchItem;
        const currentVideos = [...filteredVideos()];
        const sourceIndex = currentVideos.findIndex(v => v.video?.P?.youtubeId === sourceVideoId);
        const targetIndex = currentVideos.findIndex(v => v.video?.P?.youtubeId === videoId);

        if (sourceIndex !== -1 && targetIndex !== -1 && sourceIndex !== targetIndex) {
          // Reorder the array for immediate visual feedback
          const [movedVideo] = currentVideos.splice(sourceIndex, 1);
          currentVideos.splice(targetIndex, 0, movedVideo);
          setFilteredVideos(currentVideos);

          // Update the temporary custom order for visual feedback
          const newOrder = currentVideos.map(v => v.video?.P?.youtubeId);
          setCustomOrder(newOrder);
        }
      }
    }
  }
};

const handleTouchEnd = async (e) => {
  if (!touchItem) return;

  const touch = e.changedTouches[0];
  const elementBelow = document.elementFromPoint(
    touch.clientX,
    touch.clientY
  );

  // Reset visual feedback
  e.currentTarget.style.opacity = '1';

  if (elementBelow) {
    const videoElement = elementBelow.closest('[data-video-id]');
    if (videoElement) {
      const targetVideoId = videoElement.getAttribute('data-video-id');
      if (targetVideoId && targetVideoId !== touchItem) {
        await handleDrop({ preventDefault: () => {} }, targetVideoId);
      }
    }
  }

  touchItem = null;
  currentTouchY = 0;
  handleDragEnd();
};

// Handle video addition
const handleVideoSubmit = (data) => {
  // Reload playlist videos after adding new video
  loadPlaylistVideos();
};

return {
  playlistData,
  videos,
  filteredVideos,
  loading,
  error,
  sortBy,
  setSortBy,
  searchQuery,
  performSearch,
  clearSearch,
  clearPlaylistSettings,
  loadPlaylistVideos,
  handleVideoSubmit,
  customOrder,
  isDragging,
  draggedVideoId,
  dragOverVideoId,
  isSavingOrder,
  handleSortChange,
  handleDragStart,
  handleDragOver,
  handleDragEnd,
  handleDrop,
  handleTouchStart,
  handleTouchMove,
  handleTouchEnd,
  autoScroll
};
'''
      }
    },
    {
      id: "yto_playlist_detail_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
return `._id {
  background: linear-gradient(135deg, ${args.theme.var.color.success}, ${args.theme.var.color.success_dark_200});
  color: ${args.theme.var.color.success_text};
  padding: 2rem 1.5rem;
  position: relative;
  overflow: hidden;
  
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="2" fill="white" opacity="0.1"/><circle cx="80" cy="40" r="1" fill="white" opacity="0.05"/><circle cx="40" cy="80" r="1.5" fill="white" opacity="0.08"/></svg>') repeat;
    pointer-events: none;
  }
  
  @media (max-width: 768px) {
    padding: 1.5rem 1rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_playlist_detail_header_content",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
