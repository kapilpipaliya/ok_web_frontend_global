{
  vertexes: [
    {
      id: "yto_channel_detail_page",
      L: "Page",
      P: {
        key: "YTOChannelDetail",
        url: "/channel",
        title: "Channel Details - YouTube Organizer",
        description: "View channel details with videos and playlists tabs",
        props: '''
return {
  isNoPermissionCheck: true,
  enabled: true
};
'''
      }
    },
    {
      id: "yto_channel_detail_layout",
      L: "PageLayout",
      P: {
        componentName: "YTOLayout",
        displayOrder: 1
      }
    },
    {
      id: "yto_channel_detail_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  onMount: () => args.fns.loadChannelContents()
};
''',
        fns: '''
// State for channel data
const [channelData, setChannelData] = args.createSignal(null);
const [videos, setVideos] = args.createSignal([]);
const [playlists, setPlaylists] = args.createSignal([]);
const [loading, setLoading] = args.createSignal(true);
const [error, setError] = args.createSignal(null);
const [activeTab, setActiveTab] = args.createSignal('videos');

// Get channel ID from URL params
const channelId = args.searchParams?.channelId || args.params?.channelId;

// Load channel contents when component mounts
const loadChannelContents = async () => {
  if (!channelId) {
    setError("Channel ID not provided");
    setLoading(false);
    return;
  }

  try {
    setLoading(true);
    setError(null);

    const result = await args.executeNamedServerFunction({
      functionName: "getChannelContents",
      contextData: { channelId }
    });

    if (result.error) {
      const errorMessage = result.error;
      setError(errorMessage);
      args.showErrorToast(errorMessage);
    } else if (result.result && result.result.success) {
      // Use raw vertex data directly
      setChannelData(result.result.data.channel);
      setVideos(result.result.data.videos);
      setPlaylists(result.result.data.playlists);
    } else {
      const errorMessage = result.result?.message || result.message || "Failed to load channel contents";
      setError(errorMessage);
      args.showErrorToast(errorMessage);
    }
  } catch (err) {
    console.error("Error loading channel contents:", err);
    setError("Failed to load channel contents");
    args.showErrorToast("Failed to load channel contents");
  } finally {
    setLoading(false);
  }
};

return {
  channelData,
  videos,
  playlists,
  loading,
  error,
  activeTab,
  setActiveTab,
  loadChannelContents
};
'''
      }
    },
    {
      id: "yto_channel_detail_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
return `._id {
  background: linear-gradient(135deg, ${args.theme.var.color.primary}, ${args.theme.var.color.primary_dark_200});
  color: ${args.theme.var.color.primary_text};
  padding: 2rem 1.5rem;
  position: relative;
  overflow: hidden;
  
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="2" fill="white" opacity="0.1"/><circle cx="80" cy="40" r="1" fill="white" opacity="0.05"/><circle cx="40" cy="80" r="1.5" fill="white" opacity="0.08"/></svg>') repeat;
    pointer-events: none;
  }
  
  @media (max-width: 768px) {
    padding: 1.5rem 1rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_channel_detail_header_content",
