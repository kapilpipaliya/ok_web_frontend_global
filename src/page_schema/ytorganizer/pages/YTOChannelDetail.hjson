        props: '''
const virtualItem = args.contextData.virtualItem;
const videos = args.fns.filteredVideos();
const video = videos[virtualItem.index];

return {
  video: video,
  onClick: () => {
    window.open(`https://www.youtube.com/watch?v=${video.video?.P?.youtubeId}`, '_blank');
  }
};
'''
