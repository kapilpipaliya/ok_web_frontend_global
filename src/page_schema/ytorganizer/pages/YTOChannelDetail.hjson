'''
      }
    },
    {
      id: "yto_channel_detail_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
// Get channel data from query parameters
const channelId = args.searchParams?.channelId;
const channelTitle = 'Sample Channel';

return {
  as: "h1",
  text: channelTitle
};
''',
        css: '''
return `._id {
  font-size: 2rem;
  font-weight: 700;
  margin: 0 0 0.5rem 0;
  line-height: 1.2;
  
  @media (max-width: 768px) {
    font-size: 1.5rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_channel_detail_stats",
