        displayOrder: 2,
        componentName: "Html",
        props: '''
const activeTab = args.fns.activeTab();
const loading = args.fns.loading();
const videos = args.fns.videos();

return {
  as: "div",
  hide: loading || activeTab !== 'videos',
  ref: args.fns.setVideosScrollElement,
  onScroll: args.fns.handleVideosScroll
};
''',
        css: '''
return `._id {
  overflow-y: auto;
  height: calc(100vh - 450px);
  position: relative;

  @media (max-width: 768px) {
    height: calc(100vh - 420px);
  }
}`;
'''
