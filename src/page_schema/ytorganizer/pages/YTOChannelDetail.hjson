      id: "yto_channel_detail_youtube_link",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
const channelData = args.fns.channelData();
const loading = args.fns.loading();

if (loading) {
  return { hide: true };
}

const channelId = channelData?.channel?.P?.youtubeId;
const customUrl = channelData?.channel?.P?.customUrl;

return {
  as: "button",
  onClick: () => {
    let channelUrl = '';
    if (customUrl) {
      channelUrl = `https://www.youtube.com/${customUrl}`;
    } else if (channelId) {
      channelUrl = `https://www.youtube.com/channel/${channelId}`;
    }

    if (channelUrl) {
      window.open(channelUrl, '_blank');
    }
  }
};
''',
        css: '''
return `._id {
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  color: ${args.theme.var.color.primary_text};
  border-radius: 0.5rem;
  padding: 0.75rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: inherit;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 1rem;

  &:hover {
    background: rgba(255,255,255,0.15);
    transform: translateY(-1px);
  }

  &:active {
    transform: translateY(0);
  }
}`;
'''
