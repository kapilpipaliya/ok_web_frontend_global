      }
    },
    {
      id: "yto_channel_detail_search_clear",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const hasQuery = args.fns.searchQuery().length > 0;
return {
  as: "button",
  onClick: args.fns.clearSearch,
  hide: !hasQuery
};
''',
        css: '''
return `._id {
  position: absolute;
  right: 1rem;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: ${args.theme.var.color.muted};
  cursor: pointer;
  padding: 0.25rem;
  border-radius: 0.25rem;
  transition: all 0.2s ease;

  &:hover {
    color: ${args.theme.var.color.text};
    background: ${args.theme.var.color.background_light_100};
  }

  @media (max-width: 768px) {
    right: 0.75rem;
  }
}`;
