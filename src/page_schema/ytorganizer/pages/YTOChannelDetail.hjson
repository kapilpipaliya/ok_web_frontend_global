        componentName: "Html",
        props: '''
const activeTab = args.fns.activeTab();

const message = activeTab === 'videos'
  ? "This channel doesn't have any videos yet or they haven't been loaded."
  : "This channel doesn't have any playlists yet or they haven't been loaded.";

