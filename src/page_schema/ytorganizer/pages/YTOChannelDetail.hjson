      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 0.75rem;
  
  @media (max-width: 768px) {
    justify-content: center;
    gap: 0.75rem;
  }
}`;
'''
      }
    },
    {
