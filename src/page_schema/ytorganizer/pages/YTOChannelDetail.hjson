  height: 48
};
''',
        css: '''
return `._id {
  opacity: 0.7;
  
  @media (max-width: 768px) {
    width: 40px;
    height: 40px;
  }
}`;
'''
      }
    },
    {
      id: "yto_channel_detail_meta",
      L: "Attr",
      P: {
        displayOrder: 2,
