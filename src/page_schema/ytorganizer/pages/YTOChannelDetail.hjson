{
  vertexes: [
    {
      id: "yto_channel_detail_page",
      L: "Page",
      P: {
        key: "YTOChannelDetail",
        url: "/channel",
        title: "Channel Details - YouTube Organizer",
        description: "View channel details with videos and playlists tabs",
        props: '''
return {
  isNoPermissionCheck: true,
  enabled: true
};
'''
      }
    },
    {
      id: "yto_channel_detail_layout",
      L: "PageLayout",
      P: {
        componentName: "YTOLayout",
        displayOrder: 1
      }
    },
    {
      id: "yto_channel_detail_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  onMount: () => {
    args.fns.loadChannelContents();
    window.addEventListener('resize', args.fns.handleResize);
  },
  onCleanup: () => {
    window.removeEventListener('resize', args.fns.handleResize);
  }
};
''',
        fns: '''
// State for channel data
const [channelData, setChannelData] = args.createSignal(null);
const [videos, setVideos] = args.createSignal([]);
const [playlists, setPlaylists] = args.createSignal([]);
const [loading, setLoading] = args.createSignal(true);
const [error, setError] = args.createSignal(null);
const [activeTab, setActiveTab] = args.createSignal('videos');

// Search state
const [searchQuery, setSearchQuery] = args.createSignal('');
const [filteredVideos, setFilteredVideos] = args.createSignal([]);
const [filteredPlaylists, setFilteredPlaylists] = args.createSignal([]);

// Virtualization state
const [videosScrollElement, setVideosScrollElement] = args.createSignal(null);
const [playlistsScrollElement, setPlaylistsScrollElement] = args.createSignal(null);
const [videosScrollTop, setVideosScrollTop] = args.createSignal(0);
const [playlistsScrollTop, setPlaylistsScrollTop] = args.createSignal(0);
const [windowWidth, setWindowWidth] = args.createSignal(typeof window !== 'undefined' ? window.innerWidth : 768);
const overscan = 1; // Extra items to render above/below

// Reactive item heights based on screen size
const getVideoItemHeight = () => {
  return windowWidth() <= 768 ? 350 : 140; // Mobile: 350px, Desktop: 140px
};

const getPlaylistItemHeight = () => {
  return windowWidth() <= 768 ? 250 : 380; // Mobile: 320px, Desktop: 380px
};

// Handle window resize
const handleResize = () => {
  setWindowWidth(window.innerWidth);
};

// Get channel ID from URL params
const channelId = args.searchParams?.channelId || args.params?.channelId;

// Load channel contents when component mounts
const loadChannelContents = async () => {
  if (!channelId) {
    setError("Channel ID not provided");
    setLoading(false);
    return;
  }

  try {
    setLoading(true);
    setError(null);

    const result = await args.executeNamedServerFunction({
      functionName: "getChannelContents",
      contextData: { channelId }
    });

    if (result.error) {
      const errorMessage = result.error;
      setError(errorMessage);
      args.showErrorToast(errorMessage);
    } else if (result.result && result.result.success) {
      // Use raw vertex data directly
      setChannelData(result.result.data.channel);
      setVideos(result.result.data.videos);
      setPlaylists(result.result.data.playlists);
      // Initialize filtered data
      setFilteredVideos(result.result.data.videos);
      setFilteredPlaylists(result.result.data.playlists);
    } else {
      const errorMessage = result.result?.message || result.message || "Failed to load channel contents";
      setError(errorMessage);
      args.showErrorToast(errorMessage);
    }
  } catch (err) {
    console.error("Error loading channel contents:", err);
    setError("Failed to load channel contents");
    args.showErrorToast("Failed to load channel contents");
  } finally {
    setLoading(false);
  }
};

// Search function
const performSearch = (query) => {
  setSearchQuery(query); // Keep the original query with capitals

  const searchTerm = query.toLowerCase().trim(); // Convert to lowercase only for searching

  if (!searchTerm) {
    // Reset to show all content
    setFilteredVideos(videos());
    setFilteredPlaylists(playlists());
    return;
  }

  // Filter videos
  const videoResults = videos().filter(video => {
    const title = video.video?.P?.title || '';
    const description = video.video?.P?.description || '';
    return title.toLowerCase().includes(searchTerm) ||
           description.toLowerCase().includes(searchTerm);
  });

  // Filter playlists
  const playlistResults = playlists().filter(playlist => {
    const title = playlist.playlist?.P?.title || '';
    const description = playlist.playlist?.P?.description || '';
    return title.toLowerCase().includes(searchTerm) ||
           description.toLowerCase().includes(searchTerm);
  });

  setFilteredVideos(videoResults);
  setFilteredPlaylists(playlistResults);
};

// Clear search
const clearSearch = () => {
  setSearchQuery('');
  setFilteredVideos(videos());
  setFilteredPlaylists(playlists());
};

// Virtualization helpers for videos
const getVideosVisibleRange = () => {
  const el = videosScrollElement();
  if (!el) return { start: 0, end: 0 };

  const scroll = videosScrollTop();
  const containerHeight = el.clientHeight || 600; // Default height if not calculated yet
  const itemHeight = getVideoItemHeight();

  const startIndex = Math.max(0, Math.floor(scroll / itemHeight) - overscan);
  const endIndex = Math.min(
    filteredVideos().length - 1,
    Math.ceil((scroll + containerHeight) / itemHeight) + overscan
  );

  return { start: startIndex, end: endIndex };
};

const getVideosVirtualItems = () => {
  const { start, end } = getVideosVisibleRange();
  const items = [];
  const itemHeight = getVideoItemHeight();

  for (let i = start; i <= end; i++) {
    items.push({
      index: i,
      start: i * itemHeight,
      size: itemHeight
    });
  }

  return items;
};

const getVideosTotalSize = () => filteredVideos().length * getVideoItemHeight();

const handleVideosScroll = (e) => {
  setVideosScrollTop(e.target.scrollTop);
};

// Virtualization helpers for playlists
const getPlaylistsVisibleRange = () => {
  const el = playlistsScrollElement();
  if (!el) return { start: 0, end: 0 };

  const scroll = playlistsScrollTop();
  const containerHeight = el.clientHeight || 600; // Default height if not calculated yet
  const itemHeight = getPlaylistItemHeight();

  const startIndex = Math.max(0, Math.floor(scroll / itemHeight) - overscan);
  const endIndex = Math.min(
    filteredPlaylists().length - 1,
    Math.ceil((scroll + containerHeight) / itemHeight) + overscan
  );

  return { start: startIndex, end: endIndex };
};

const getPlaylistsVirtualItems = () => {
  const { start, end } = getPlaylistsVisibleRange();
  const items = [];
  const itemHeight = getPlaylistItemHeight();

  for (let i = start; i <= end; i++) {
    items.push({
      index: i,
      start: i * itemHeight,
      size: itemHeight
    });
  }

  return items;
};

const getPlaylistsTotalSize = () => filteredPlaylists().length * getPlaylistItemHeight();

const handlePlaylistsScroll = (e) => {
  setPlaylistsScrollTop(e.target.scrollTop);
};

return {
  channelData,
  videos,
  playlists,
  filteredVideos,
  filteredPlaylists,
  loading,
  error,
  activeTab,
  setActiveTab,
  searchQuery,
  loadChannelContents,
  performSearch,
  clearSearch,
  setVideosScrollElement,
  setPlaylistsScrollElement,
  handleVideosScroll,
  handlePlaylistsScroll,
  getVideosVirtualItems,
  getVideosTotalSize,
  getPlaylistsVirtualItems,
  getPlaylistsTotalSize,
  handleResize
};
'''
      }
    },
    {
      id: "yto_channel_detail_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
return `._id {
  background: linear-gradient(135deg, ${args.theme.var.color.primary}, ${args.theme.var.color.primary_dark_200});
  color: ${args.theme.var.color.primary_text};
  padding: 2rem 1.5rem;
  position: relative;
  overflow: hidden;
  
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="2" fill="white" opacity="0.1"/><circle cx="80" cy="40" r="1" fill="white" opacity="0.05"/><circle cx="40" cy="80" r="1.5" fill="white" opacity="0.08"/></svg>') repeat;
    pointer-events: none;
  }
  
  @media (max-width: 768px) {
    padding: 1.5rem 1rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_channel_detail_header_content",
      L: "Attr",
      P: {
        displayOrder: 1,
