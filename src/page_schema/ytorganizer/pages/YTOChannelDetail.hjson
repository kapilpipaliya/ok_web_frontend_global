    {
      id: "yto_channel_detail_empty_state",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
const activeTab = args.fns.activeTab();
const loading = args.fns.loading();
const videos = args.fns.videos();
const playlists = args.fns.playlists();

const showEmpty = !loading && (
  (activeTab === 'videos' && videos.length === 0) ||
  (activeTab === 'playlists' && playlists.length === 0)
);

return {
  as: "div",
  hide: !showEmpty
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 4rem 2rem;
  background: ${args.theme.var.color.background_dark_50};
  border-radius: 1rem;
  border: 2px dashed ${args.theme.var.color.border};

  @media (max-width: 768px) {
    padding: 3rem 1.5rem;
  }
}`;
'''
