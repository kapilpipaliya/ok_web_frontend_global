    {
      id: "yto_channel_detail_subscriber_count",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const channelData = args.fns.channelData();
const loading = args.fns.loading();

if (loading) {
  return {
    as: "span",
    text: "Loading..."
  };
}

const subscriberCount = channelData?.channel?.P?.subscriberCount || 0;
const formattedCount = subscriberCount >= 1000000
  ? `${(subscriberCount / 1000000).toFixed(1)}M`
  : subscriberCount >= 1000
    ? `${(subscriberCount / 1000).toFixed(1)}K`
    : subscriberCount.toString();

return {
  as: "span",
  text: `${formattedCount} subscribers`
};
''',
        css: '''
return `._id {
  background: rgba(255,255,255,0.15);
  padding: 0.375rem 0.75rem;
  border-radius: 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 0.375rem;
}`;
'''
