    {
      id: "yto_channel_detail_playlist_card",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "YTOPlaylistCard",
        props: '''
const virtualItem = args.contextData.virtualItem;
const playlists = args.fns.filteredPlaylists();
const playlist = playlists[virtualItem.index];

return {
  playlist: playlist,
  onClick: () => {
    if (playlist.playlistSettings?.P?.isUserSaved) {
      args.navigate(`/playlist?playlistId=${playlist.playlist?.P?.youtubeId}`);
    } else {
      window.open(`https://www.youtube.com/playlist?list=${playlist.playlist?.P?.youtubeId}`, '_blank');
    }
  }
};
'''
      }
