      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
const channelData = args.fns.channelData();
const loading = args.fns.loading();

if (loading) {
  return { hide: true };
}

const channelId = channelData?.channel?.P?.youtubeId;
const customUrl = channelData?.channel?.P?.customUrl;

return {
  as: "button",
  onClick: () => {
    let channelUrl = '';
    if (customUrl) {
      channelUrl = `https://www.youtube.com/${customUrl}`;
    } else if (channelId) {
      channelUrl = `https://www.youtube.com/channel/${channelId}`;
    }

    if (channelUrl) {
      window.open(channelUrl, '_blank');
    }
  }
};
''',
        css: '''
return `._id {
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
