{
  vertexes: [
    {
      id: "checkout_page",
      L: "Page",
      P: {
        key: "YTOCheckout",
        url: "/checkout",
        signinRequired: true,
        fns: '''
const [orderData, setOrderData] = args.createSignal(null);
const [isLoading, setIsLoading] = args.createSignal(false);
const [errorMessage, setErrorMessage] = args.createSignal("");
const [razorpayLoaded, setRazorpayLoaded] = args.createSignal(false);
const [selectedPlan, setSelectedPlan] = args.createSignal(args.searchParams?.plan || "basic");
const [billingCycle, setBillingCycle] = args.createSignal(args.searchParams?.cycle || "monthly");

// Load Razorpay script
const loadRazorpayScript = () => {
  return new Promise((resolve) => {
    if (window.Razorpay) {
      resolve(true);
      return;
    }
    const script = document.createElement("script");
    script.src = "https://checkout.razorpay.com/v1/checkout.js";
    script.onload = () => {
      setRazorpayLoaded(true);
      resolve(true);
    };
    script.onerror = () => {
      setErrorMessage("Failed to load payment gateway");
      resolve(false);
    };
    document.body.appendChild(script);
  });
};

// Plan pricing
const planPrices = {
  basic: 2.50,
  pro: 5.00,
  unlimited: 10.00
};

const planQuotas = {
  basic: "50,000 videos",
  pro: "150,000 videos",
  unlimited: "Unlimited videos"
};

// Calculate price
const calculatePrice = () => {
  const monthlyPrice = planPrices[selectedPlan()];
  if (billingCycle() === "annual") {
    return monthlyPrice * 10; // 10 months (2 months free)
  }
  return monthlyPrice;
};

// Create payment order
const createOrder = async () => {
  try {
    setIsLoading(true);
    setErrorMessage("");

    const result = await args.executeNamedServerFunction({
      functionName: "createPaymentOrder",
      contextData: {
        plan: selectedPlan(),
        billingCycle: billingCycle()
      }
    });

    if (!result.success) {
      throw new Error(result.message || "Failed to create order");
    }

    setOrderData(result.data);
    return result.data;
  } catch (error) {
    setErrorMessage(error.message);
    args.showErrorToast(error.message);
    return null;
  } finally {
    setIsLoading(false);
  }
};

// Initialize payment
const initiatePayment = async () => {
  try {
    // Load Razorpay script
    const loaded = await loadRazorpayScript();
    if (!loaded) return;

    // Create order
    const order = await createOrder();
    if (!order) return;

    // Razorpay checkout options
    const options = {
      key: order.keyId,
      amount: order.amount,
      currency: order.currency,
      name: "YouTube Organizer",
      description: selectedPlan().charAt(0).toUpperCase() + selectedPlan().slice(1) + " Plan - " + billingCycle(),
      order_id: order.orderId,
      handler: async function (response) {
        try {
          setIsLoading(true);

          // Verify payment
          const verifyResult = await args.executeNamedServerFunction({
            functionName: "verifyPaymentSignature",
            contextData: {
              orderId: response.razorpay_order_id,
              paymentId: response.razorpay_payment_id,
              signature: response.razorpay_signature
            }
          });

          if (verifyResult.success) {
            args.showSuccessToast("Payment successful! Your subscription is now active.");
            setTimeout(() => {
              args.navigate("/subscription");
            }, 1500);
          } else {
            throw new Error(verifyResult.message || "Payment verification failed");
          }
        } catch (error) {
          args.showErrorToast(error.message);
          setErrorMessage(error.message);
        } finally {
          setIsLoading(false);
        }
      },
      prefill: {
        name: args.user?.P?.username || "",
        email: args.user?.P?.email || ""
      },
      theme: {
        color: "#3399cc"
      },
      modal: {
        ondismiss: function() {
          setIsLoading(false);
          args.showWarningToast("Payment cancelled");
        }
      }
    };

    const razorpay = new window.Razorpay(options);
    razorpay.open();

  } catch (error) {
    setErrorMessage(error.message);
    args.showErrorToast(error.message);
  }
};

return {
  enabled: true,
  selectedPlan,
  setSelectedPlan,
  billingCycle,
  setBillingCycle,
  calculatePrice,
  initiatePayment,
  isLoading,
  errorMessage,
  planPrices,
  planQuotas
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "checkout_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  background: ${args.theme.var.color.background};
  padding: 2rem;
}

@media (max-width: 768px) {
  ._id {
    padding: 1rem;
  }
}`;
'''
      }
    },
