// Sync current channel or playlist
const [isSyncing, setIsSyncing] = args.createSignal(false);

const syncCurrentItem = async () => {
  const contentType = args.searchParams?.type || "channels";
  const data = detailData();

  if (!data) {
    args.showErrorToast("No item to sync");
    return;
  }

  setIsSyncing(true);

  try {
    if (contentType === "playlists") {
      const playlist = data.playlist?.playlist;
      if (!playlist) {
        args.showErrorToast("Playlist not found");
        setIsSyncing(false);
        return;
      }

      const url = `https://www.youtube.com/playlist?list=${playlist.P.youtubeId}`;

      const result = await args.fns.executeYTOFunction("savePlaylist", { url });

      if (result?.result?.success) {
        args.showSuccessToast(result.result.message || "Playlist synced successfully");
        await loadDetailData();
      } else {
        args.showErrorToast(result?.result?.message || "Failed to sync playlist");
      }
    } else {
      const channel = data.channel?.channel;
      if (!channel) {
        args.showErrorToast("Channel not found");
        setIsSyncing(false);
        return;
      }

      const url = `https://www.youtube.com/channel/${channel.P.youtubeId}`;

      const result = await args.fns.executeYTOFunction("saveChannel", { url });

      if (result?.result?.success) {
        args.showSuccessToast(result.result.message || "Channel synced successfully");
        await loadDetailData();
      } else {
        args.showErrorToast(result?.result?.message || "Failed to sync channel");
      }
    }
  } catch (error) {
    console.error("Error syncing:", error);
    args.showErrorToast("An error occurred while syncing");
  } finally {
    setIsSyncing(false);
  }
};

// Add videos to playlist modal
const [isAddVideosModalOpen, setIsAddVideosModalOpen] = args.createSignal(false);

// Update local item settings across all views
const updateLocalItemSettings = (updatedData) => {
  const isVideo = !!updatedData.video;
  const isPlaylist = !!updatedData.playlist;

  if (isVideo) {
    // Update video settings locally
    const videoSettings = updatedData.videoSettings;
    const youtubeId = updatedData.video.P.youtubeId;

    // Update in detail view (videos are shown in playlist detail view)
    if (isDetailView()) {
      const detail = detailData();
      if (detail?.videos) {
        setDetailData({
          ...detail,
          videos: detail.videos.map(item => {
            if (item.video?.P?.youtubeId === youtubeId) {
              return { ...item, videoSettings };
            }
            return item;
          })
        });
      }
    }

    // Update in search results
    if (isSearchView()) {
      const results = searchResults();
      if (results?.videos) {
        setSearchResults({
          ...results,
          videos: results.videos.map(item => {
            if (item.video?.P?.youtubeId === youtubeId) {
              return { ...item, videoSettings };
            }
            return item;
          })
        });
      }
    }

    // Update in favourites
    if (isFavouritesView()) {
      const favourites = favouritesData();
      if (favourites?.videos) {
        setFavouritesData({
          ...favourites,
          videos: favourites.videos.map(item => {
            if (item.video?.P?.youtubeId === youtubeId) {
              return { ...item, videoSettings };
            }
            return item;
          })
        });
      }
    }
  } else if (isPlaylist) {
    // Update playlist settings locally
    const playlistSetting = updatedData.playlistSetting;
    const youtubeId = updatedData.playlist.P.youtubeId;

    // Update in list view
    if (isListView() && contentType === "playlists") {
      setItems(items().map(item => {
        if (item.playlist?.P?.youtubeId === youtubeId) {
          return { ...item, playlistSetting };
        }
        return item;
      }));
    }

    // Update in detail view
    if (isDetailView()) {
      const detail = detailData();
      if (detail?.playlist?.playlist?.P?.youtubeId === youtubeId) {
        setDetailData({ ...detail, playlist: { ...detail.playlist, playlistSetting } });
      }
    }

    // Update in search results
    if (isSearchView()) {
      const results = searchResults();
      if (results?.playlists) {
        setSearchResults({
          ...results,
          playlists: results.playlists.map(item => {
            if (item.playlist?.P?.youtubeId === youtubeId) {
              return { ...item, playlistSetting };
            }
            return item;
          })
        });
      }
    }

    // Update in favourites
    if (isFavouritesView()) {
      const favourites = favouritesData();
      if (favourites?.playlists) {
        setFavouritesData({
          ...favourites,
          playlists: favourites.playlists.map(item => {
            if (item.playlist?.P?.youtubeId === youtubeId) {
              return { ...item, playlistSetting };
            }
            return item;
          })
        });
      }
    }
  } else {
    // Update channel settings locally
    const channelSetting = updatedData.channelSetting;
    const youtubeId = updatedData.channel.P.youtubeId;

    // Update in list view (structure: { channel: vertex, channelSetting: vertex })
    if (isListView() && contentType === "channels") {
      setItems(items().map(item => {
        if (item.channel?.P?.youtubeId === youtubeId) {
          return { ...item, channelSetting };
        }
        return item;
      }));
    }

    // Update in detail view (structure: { channel: { channel: vertex, channelSetting: vertex } })
    if (isDetailView()) {
      const detail = detailData();
      if (detail?.channel?.channel?.P?.youtubeId === youtubeId) {
        setDetailData({ ...detail, channel: { ...detail.channel, channelSetting } });
      }
    }

    // Update in search results (structure: { channel: vertex, channelSetting: vertex })
    if (isSearchView()) {
      const results = searchResults();
      if (results?.channels) {
        setSearchResults({
          ...results,
          channels: results.channels.map(item => {
            if (item.channel?.P?.youtubeId === youtubeId) {
              return { ...item, channelSetting };
            }
            return item;
          })
        });
      }
    }

    // Update in favourites (structure: { channel: vertex, channelSetting: vertex })
    if (isFavouritesView()) {
      const favourites = favouritesData();
      if (favourites?.channels) {
        setFavouritesData({
          ...favourites,
          channels: favourites.channels.map(item => {
            if (item.channel?.P?.youtubeId === youtubeId) {
              return { ...item, channelSetting };
            }
            return item;
          })
        });
      }
    }
  }
};

// Polling state for processing status
const [processingStatuses, setProcessingStatuses] = args.createSignal({
  channels: {},
  playlists: {}
});
const [pollingInterval, setPollingInterval] = args.createSignal(null);
const [isPolling, setIsPolling] = args.createSignal(false);

// Helper function to collect visible IDs from channel/playlist arrays (only those with processing status)
const collectVisibleIds = (channelsArray, playlistsArray, channelIds, playlistIds) => {
  // Collect channel IDs with processing status
  if (channelsArray) {
    channelsArray.forEach(item => {
      const channelId = item.channel?.P?.youtubeId;
      const status = item.channelSetting?.P?.status;
      if (channelId && status && (status === 'queued' || status === 'processing') && !channelIds.includes(channelId)) {
        channelIds.push(channelId);
      }
    });
  }

  // Collect playlist IDs with processing status
  if (playlistsArray) {
    playlistsArray.forEach(item => {
      const playlistId = item.playlist?.P?.youtubeId;
      const status = item.playlistSetting?.P?.status;
      if (playlistId && status && (status === 'queued' || status === 'processing') && !playlistIds.includes(playlistId)) {
        playlistIds.push(playlistId);
      }
    });
  }
};

// Helper function to extract processing items from arrays
const extractProcessingItems = (channelsArray, playlistsArray, channelsMap, playlistsMap) => {
  // Extract from channels
  if (channelsArray) {
    channelsArray.forEach(item => {
      const channelId = item.channel?.P?.youtubeId;
      const status = item.channelSetting?.P?.status;
      if (channelId && status && (status === 'queued' || status === 'processing')) {
        channelsMap[channelId] = item;
      }
    });
  }

  // Extract from playlists
  if (playlistsArray) {
    playlistsArray.forEach(item => {
      const playlistId = item.playlist?.P?.youtubeId;
      const status = item.playlistSetting?.P?.status;
      if (playlistId && status && (status === 'queued' || status === 'processing')) {
        playlistsMap[playlistId] = item;
      }
    });
  }
};

// Reactive effect to automatically update processing status when data changes
args.createEffect(
  args.on(
    [items, detailData, searchResults, favouritesData, isListView, isDetailView, isSearchView, isFavouritesView],
    () => {
      const channelsMap = {};
      const playlistsMap = {};

      // Watch list view items
      if (isListView() && !isSearchView() && !isFavouritesView()) {
        const currentItems = items();

        if (contentType === "channels") {
          extractProcessingItems(currentItems, null, channelsMap, playlistsMap);
        } else if (contentType === "playlists") {
          extractProcessingItems(null, currentItems, channelsMap, playlistsMap);
        }
      }

      // Watch detail view
      if (isDetailView()) {
        const detail = detailData();
        if (detail) {
          if (contentType === "channels") {
            // Check channel itself
            const channelId = detail.channel?.channel?.P?.youtubeId;
            const channelStatus = detail.channel?.channelSetting?.P?.status;
            if (channelId && channelStatus && (channelStatus === 'queued' || channelStatus === 'processing')) {
              channelsMap[channelId] = detail.channel;
            }

            // Check playlists in channel
            extractProcessingItems(null, detail.playlists, channelsMap, playlistsMap);
          } else if (contentType === "playlists") {
            // Check playlist itself
            const playlistId = detail.playlist?.playlist?.P?.youtubeId;
            const playlistStatus = detail.playlist?.playlistSetting?.P?.status;
            if (playlistId && playlistStatus && (playlistStatus === 'queued' || playlistStatus === 'processing')) {
              playlistsMap[playlistId] = detail.playlist;
            }
          }
        }
      }

      // Watch search results
      if (isSearchView()) {
        const results = searchResults();
        if (results) {
          extractProcessingItems(results.channels, results.playlists, channelsMap, playlistsMap);
        }
      }

      // Watch favourites
      if (isFavouritesView()) {
        const favourites = favouritesData();
        if (favourites) {
          extractProcessingItems(favourites.channels, favourites.playlists, channelsMap, playlistsMap);
        }
      }

      // Automatically update processingStatuses whenever data changes
      setProcessingStatuses({
        channels: channelsMap,
        playlists: playlistsMap
      });
    }
  )
);

// Collect visible IDs from current view for polling
const collectVisibleIdsFromData = () => {
  const channelIds = [];
  const playlistIds = [];

  // Collect from list view items
  if (isListView() && !isSearchView() && !isFavouritesView()) {
    const currentItems = items();

    if (contentType === "channels") {
      collectVisibleIds(currentItems, null, channelIds, playlistIds);
    } else if (contentType === "playlists") {
      collectVisibleIds(null, currentItems, channelIds, playlistIds);
    }
  }

  // Collect from detail view
  if (isDetailView()) {
    const detail = detailData();
    if (detail) {
      if (contentType === "channels") {
        // Collect channel ID itself if processing
        const channelId = detail.channel?.channel?.P?.youtubeId;
        const channelStatus = detail.channel?.channelSetting?.P?.status;
        if (channelId && channelStatus && (channelStatus === 'queued' || channelStatus === 'processing') && !channelIds.includes(channelId)) {
          channelIds.push(channelId);
        }

        // Collect playlists in channel
        collectVisibleIds(null, detail.playlists, channelIds, playlistIds);
      } else if (contentType === "playlists") {
        // Collect playlist ID itself if processing
        const playlistId = detail.playlist?.playlist?.P?.youtubeId;
        const playlistStatus = detail.playlist?.playlistSetting?.P?.status;
        if (playlistId && playlistStatus && (playlistStatus === 'queued' || playlistStatus === 'processing') && !playlistIds.includes(playlistId)) {
          playlistIds.push(playlistId);
        }
      }
    }
  }

  // Collect from search results
  if (isSearchView()) {
    const results = searchResults();
    if (results) {
      collectVisibleIds(results.channels, results.playlists, channelIds, playlistIds);
    }
  }

  // Collect from favourites
  if (isFavouritesView()) {
    const favourites = favouritesData();
    if (favourites) {
      collectVisibleIds(favourites.channels, favourites.playlists, channelIds, playlistIds);
    }
  }

  return { channelIds, playlistIds };
};

// Poll for processing status updates
const pollProcessingStatus = async () => {
  // Skip if already polling
  if (isPolling()) {
    return;
  }

  // Collect visible IDs from current view
  const { channelIds, playlistIds } = collectVisibleIdsFromData();

  // If no IDs to poll, skip
  if (channelIds.length === 0 && playlistIds.length === 0) {
    return;
  }

  setIsPolling(true);
  try {
    const result = await args.fns.executeYTOFunction("getProcessingStatusByIds", {
      channelIds,
      playlistIds
    });

    if (result?.result?.success && result?.result?.data) {
      const data = result.result.data;

      // Convert arrays to objects keyed by ID for easier lookup
      const channelsMap = {};
      data.channels.forEach(item => {
        const channelId = item.channel?.P?.youtubeId;
        if (channelId) {
          channelsMap[channelId] = item;
        }
      });

      const playlistsMap = {};
      data.playlists.forEach(item => {
        const playlistId = item.playlist?.P?.youtubeId;
        if (playlistId) {
          playlistsMap[playlistId] = item;
        }
      });

      setProcessingStatuses({
        channels: channelsMap,
        playlists: playlistsMap
      });

      // If no active processing, stop polling and reload data
      if (!data.hasActiveProcessing) {
        stopPolling();
        // Reload data to show completed items in all views
        await loadData();
      }
    }
  } catch (error) {
    console.error('Error polling processing status:', error);
  } finally {
    setIsPolling(false);
  }
};

// Start polling
const startPolling = () => {
  // Don't start if already polling
  if (pollingInterval()) {
    return;
  }

  // Start polling immediately
  pollProcessingStatus();

  // Set up interval (poll every 3 seconds)
  const interval = setInterval(pollProcessingStatus, 3000);
  setPollingInterval(interval);
};

// Stop polling
const stopPolling = () => {
  const interval = pollingInterval();
  if (interval) {
    clearInterval(interval);
    setPollingInterval(null);
  }
  setIsPolling(false);
};

// Watch for processing status changes and start/stop polling as needed
args.createEffect(
  args.on([processingStatuses, pollingInterval], () => {
    const statuses = processingStatuses();
    const hasProcessing = Object.keys(statuses.channels).length > 0 ||
                          Object.keys(statuses.playlists).length > 0;

    // Start polling if there's processing
    if (hasProcessing && !pollingInterval()) {
      args.untrack(() => startPolling());
    }
    // Stop polling if there's no processing
    else if (!hasProcessing && pollingInterval()) {
      args.untrack(() => stopPolling());
    }
  })
);

// Cleanup on unmount
args.onCleanup(() => {
    args.untrack(() => stopPolling());
});

// Get processing status for a specific channel
const getChannelProcessingStatus = (channelId) => {
  return processingStatuses().channels[channelId] || null;
};

// Get processing status for a specific playlist
const getPlaylistProcessingStatus = (playlistId) => {
  return processingStatuses().playlists[playlistId] || null;
};

// Format processing status with detailed information
const formatProcessingStatus = (processingStatus, itemType) => {
  if (!processingStatus) {
    return null;
  }

  // Try to extract settings from different possible structures
  let settings = null;
  if (itemType === "playlist") {
    settings = processingStatus.playlistSetting;
  } else if (itemType === "channel") {
    settings = processingStatus.channelSetting;
  }

  // If no settings found, return null
  if (!settings) {
    return null;
  }

  const props = settings.P;

  // Check if we have a valid status
  const status = props.status;
  if (!status) {
    return null;
  }

  // Only format if status is queued or processing
  if (status !== 'queued' && status !== 'processing') {
    return null;
  }

  // Extract progress
  const progress = props.progress || 0;

  // Build details string based on item type
  let details = '';
  if (itemType === "channel") {
    const processedPlaylists = props.processedPlaylists || 0;
    const totalPlaylists = props.totalPlaylists || 0;
    const processedVideos = props.processedVideos || 0;
    const totalVideos = props.totalVideos || 0;
    details = `${processedPlaylists}/${totalPlaylists} playlists, ${processedVideos}/${totalVideos} videos`;
  } else if (itemType === "playlist") {
    const processedVideos = props.processedVideos || 0;
    const totalVideos = props.totalVideos || 0;
    details = `${processedVideos}/${totalVideos} videos`;
  }

  // Return formatted status
  return {
    ...processingStatus,
    status,
    progress,
    details
  };
};

return {
  items,
  filteredItems,
  loading,
  updateItemDataAfterNoteSave,
  isNoteModalOpen,
  noteModalData,
  openNoteModal,
  closeNoteModal,
  saveNote,
  toggleFavourite,
  searchTerm,
  setSearchTerm,
  setScrollElement,
  handleScroll,
  getVirtualItems,
  getTotalSize,
  activeMenu,
  setActiveMenu,
  menuPosition,
  setMenuPosition,
  navigateToDetail,
  navigateBack,
  openInYouTube,
  editCustomName,
  openCustomNameModal,
  deleteItem,
  deleteVideo,
  isModalOpen,
  modalData,
  openModal,
  closeModal,
  handleModalSave,
  updateLocalItemSettings,
  isDetailView,
  isSearchView,
  isFavouritesView,
  isListView,
  detailData,
  filteredDetailItems,
  detailSearchTerm,
  setDetailSearchTerm,
  getDetailVirtualItems,
  getDetailTotalSize,
  setDetailScrollElement,
  handleDetailScroll,
  searchResults,
  searchInput,
  setSearchInput,
  getSearchItems,
  getSearchVirtualItems,
  getSearchTotalSize,
  setSearchScrollElement,
  handleSearchScroll,
  favouritesData,
  getFavouritesItems,
  getFavouritesVirtualItems,
  getFavouritesTotalSize,
  setFavouritesScrollElement,
  handleFavouritesScroll,
  handleSearch,
  loadData,
  loadListData,
  loadDetailData,
  loadSearchData,
  loadFavouritesData,
  handleResize,
  syncCurrentItem,
  isSyncing,
  isAddVideosModalOpen,
  setIsAddVideosModalOpen,
  processingStatuses,
  getChannelProcessingStatus,
  getPlaylistProcessingStatus,
  formatProcessingStatus
};
''',
        props: '''
