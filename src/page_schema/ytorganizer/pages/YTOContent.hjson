    {
      id: "video_card",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "YTOCard",
        props: '''
const contentType = args.searchParams?.type || "channels";
const videoItem = args.contextData.videoItem;
const itemData = args.fns.filteredDetailItems()[videoItem.index];

// For channels view, itemData is a playlist object
// For playlists view, itemData is a video object
const isPlaylistItem = contentType === "channels";
const item = isPlaylistItem ? itemData.playlist : itemData.video;
const itemId = item?.P?.youtubeId;

// Get processing status for playlists only (videos don't have processing status)
const processingStatus = isPlaylistItem
  ? args.fns.getPlaylistProcessingStatus(itemId)
  : null;

return {
  item: item,
  itemSettings: isPlaylistItem ? itemData.playlistSettings : itemData.videoSettings,
  itemType: isPlaylistItem ? "playlist" : "video",
  processingStatus: processingStatus
};
'''
