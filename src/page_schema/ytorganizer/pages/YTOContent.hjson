};
''',
        css: '''
return `._id {
  padding: 0 1.5rem 1.5rem 1.5rem;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
  overflow-y: auto;
  height: calc(100vh - 280px);
}

@media (max-width: 768px) {
  ._id {
    padding: 0 1rem 1rem 1rem;
    height: calc(100vh - 240px);
  }
}`;
'''
