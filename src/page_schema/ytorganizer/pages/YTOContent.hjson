        props: '''
const contentType = args.searchParams?.type || "channels";

// Determine description based on view
let description = "";
if (args.fns.isSearchView()) {
  const results = args.fns.searchResults();
  const totalCount = results?.totalCount || 0;
  description = results ? `Found ${totalCount} result${totalCount !== 1 ? 's' : ''}` : "";
} else if (args.fns.isFavouritesView()) {
  const items = args.fns.getFavouritesItems();
  const totalCount = items.length;
  description = `${totalCount} favourite item${totalCount !== 1 ? 's' : ''}`;
} else if (args.fns.isDetailView()) {
  const count = args.fns.filteredDetailItems().length;
  description = contentType === "playlists"
    ? `${count} video${count !== 1 ? 's' : ''}`
    : `${count} playlist${count !== 1 ? 's' : ''}`;
} else {
  // List view
  const count = args.fns.filteredItems().length;
  description = contentType === "playlists"
    ? `${count} playlist${count !== 1 ? 's' : ''}`
    : `${count} channel${count !== 1 ? 's' : ''}`;
}

return {
  as: "p",
  text: description,
  hide: args.fns.loading()
};
''',
        css: '''
