{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "YTOContent",
        url: "/yto/content",
        siginRequired: true,
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true,
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
        componentName: "YTOLayout",
        displayOrder: 1
      }
    },
    {
      id: "page_root_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
const contentType = args.searchParams?.type || "channels";
const detailId = args.searchParams?.id || null;
const searchQuery = args.searchParams?.q || "";

// Reactive view mode detection
const isDetailView = args.createMemo(() => !!args.searchParams?.id);
const isSearchView = args.createMemo(() => args.searchParams?.q !== undefined);
const isFavouritesView = args.createMemo(() => contentType === "favourites");
const isListView = args.createMemo(() => !isDetailView() && !isSearchView() && !isFavouritesView());

// State for data
const [items, setItems] = args.createSignal([]);
const [loading, setLoading] = args.createSignal(true);
const [searchTerm, setSearchTerm] = args.createSignal("");
const [scrollElement, setScrollElement] = args.createSignal(null);

// State for detail view
const [detailData, setDetailData] = args.createSignal(null);
const [detailSearchTerm, setDetailSearchTerm] = args.createSignal("");

// State for search view
const [searchResults, setSearchResults] = args.createSignal(null);
const [searchInput, setSearchInput] = args.createSignal(searchQuery);

// State for favourites view
const [favouritesData, setFavouritesData] = args.createSignal(null);

// Note modal state
const [isNoteModalOpen, setIsNoteModalOpen] = args.createSignal(false);
const [noteModalData, setNoteModalData] = args.createStore({ item: null, itemType: null, existingNote: "" });

// Virtualization constants
const overscan = 5;
const [scrollTop, setScrollTop] = args.createSignal(0);
const [windowWidth, setWindowWidth] = args.createSignal(typeof window !== 'undefined' ? window.innerWidth : 768);

// Virtualization state for detail view items (playlists for channels, videos for playlists)
const [detailScrollTop, setDetailScrollTop] = args.createSignal(0);
const [detailScrollElement, setDetailScrollElement] = args.createSignal(null);

// Get items from detail data (playlists for channels, videos for playlists)
const detailItems = args.createMemo(() => {
  const data = detailData();
  if (!data) return [];

  // For channels, return playlists
  if (contentType === "channels") {
    return data.playlists || [];
  }

  // For playlists, return videos
  return data.videos || [];
});

// Filtered detail items based on search term
const filteredDetailItems = args.createMemo(() => {
  const term = detailSearchTerm().toLowerCase();
  if (!term) return detailItems();

  return detailItems().filter(item => {
    // For playlists (in channel detail view)
    if (item.playlist) {
      const playlist = item.playlist;
      const playlistSettings = item.playlistSettings;
      const title = playlist?.P?.title?.toLowerCase() || "";
      const description = playlist?.P?.description?.toLowerCase() || "";
      const customName = playlistSettings?.P?.customName?.toLowerCase() || "";
      return title.includes(term) || description.includes(term) || customName.includes(term);
    }

    // For videos (in playlist detail view)
    if (item.video) {
      const video = item.video;
      const videoSettings = item.videoSettings;
      const title = video?.P?.title?.toLowerCase() || "";
      const description = video?.P?.description?.toLowerCase() || "";
      const channelTitle = video?.P?.channelTitle?.toLowerCase() || "";
      const notes = videoSettings?.P?.notes?.toLowerCase() || "";
      return title.includes(term) || description.includes(term) || channelTitle.includes(term) || notes.includes(term);
    }

    return false;
  });
});

// Virtualization state for search results
const [searchScrollTop, setSearchScrollTop] = args.createSignal(0);
const [searchScrollElement, setSearchScrollElement] = args.createSignal(null);

// Get combined search results
const getSearchItems = args.createMemo(() => {
  const results = searchResults();
  if (!results) return [];

  const combined = [];

  // Add channels
  if (results.channels) {
    results.channels.forEach(item => {
      combined.push({ ...item, resultType: 'channel' });
    });
  }

  // Add playlists
  if (results.playlists) {
    results.playlists.forEach(item => {
      combined.push({ ...item, resultType: 'playlist' });
    });
  }

  // Add videos
  if (results.videos) {
    results.videos.forEach(item => {
      combined.push({ ...item, resultType: 'video' });
    });
  }

  return combined;
});

// Get combined favourites items
const getFavouritesItems = args.createMemo(() => {
  const data = favouritesData();
  if (!data) return [];

  const combined = [];

  // Add favourite channels
  if (data.channels) {
    data.channels.forEach(item => {
      combined.push({ ...item, resultType: 'channel' });
    });
  }

  // Add favourite playlists
  if (data.playlists) {
    data.playlists.forEach(item => {
      combined.push({ ...item, resultType: 'playlist' });
    });
  }

  // Add favourite videos
  if (data.videos) {
    data.videos.forEach(item => {
      combined.push({ ...item, resultType: 'video' });
    });
  }

  return combined;
});

// Reactive item height for detail items (playlists or videos)
const getDetailItemHeight = () => {
  return 90;
};

// Calculate visible items for detail view
const getDetailVisibleRange = () => {
  const el = detailScrollElement();
  const videos = filteredDetailItems();
  const scroll = detailScrollTop();
  const itemHeight = getDetailItemHeight();

  // If no element yet, use a default container height to render initial items
  // NOTE: Do NOT return early with {start: 0, end: 0} when el doesn't exist,
  // as that would only render 1 item. Use default height to calculate proper range.
  const containerHeight = el?.clientHeight || 600;

  const startIndex = Math.max(0, Math.floor(scroll / itemHeight) - overscan);
  const endIndex = Math.min(
    videos.length - 1,
    Math.ceil((scroll + containerHeight) / itemHeight) + overscan
  );

  return { start: startIndex, end: endIndex };
};

// Get virtual items to render for detail view
const getDetailVirtualItems = () => {
  const { start, end } = getDetailVisibleRange();
  const items = [];
  const itemHeight = getDetailItemHeight();

  for (let i = start; i <= end; i++) {
    items.push({
      index: i,
      start: i * itemHeight,
      size: itemHeight
    });
  }

  return items;
};

// Total height of all detail videos
const getDetailTotalSize = () => filteredDetailItems().length * getDetailItemHeight();

// Handle scroll for detail view
const handleDetailScroll = (e) => {
  setDetailScrollTop(e.target.scrollTop);
};

// Reactive item height for search results
const getSearchItemHeight = () => {
  return 90;
};

// Calculate visible items for search view
const getSearchVisibleRange = () => {
  const el = searchScrollElement();
  const searchItems = getSearchItems();
  const scroll = searchScrollTop();
  const itemHeight = getSearchItemHeight();

  // If no element yet, use a default container height to render initial items
  // NOTE: Do NOT return early with {start: 0, end: 0} when el doesn't exist,
  // as that would only render 1 item. Use default height to calculate proper range.
  const containerHeight = el?.clientHeight || 600;

  const startIndex = Math.max(0, Math.floor(scroll / itemHeight) - overscan);
  const endIndex = Math.min(
    searchItems.length - 1,
    Math.ceil((scroll + containerHeight) / itemHeight) + overscan
  );

  return { start: startIndex, end: endIndex };
};

// Get virtual items to render for search view
const getSearchVirtualItems = () => {
  const { start, end } = getSearchVisibleRange();
  const virtualItems = [];
  const itemHeight = getSearchItemHeight();

  for (let i = start; i <= end; i++) {
    virtualItems.push({
      index: i,
      start: i * itemHeight,
      size: itemHeight
    });
  }

  return virtualItems;
};

// Total height of all search results
const getSearchTotalSize = () => getSearchItems().length * getSearchItemHeight();

// Handle scroll for search view
const handleSearchScroll = (e) => {
  setSearchScrollTop(e.target.scrollTop);
};

// Virtualization state for favourites
const [favouritesScrollTop, setFavouritesScrollTop] = args.createSignal(0);
const [favouritesScrollElement, setFavouritesScrollElement] = args.createSignal(null);

// Reactive item height for favourites
const getFavouritesItemHeight = () => {
  return 90;
};

// Calculate visible items for favourites view
const getFavouritesVisibleRange = () => {
  const el = favouritesScrollElement();
  const favouritesItems = getFavouritesItems();
  const scroll = favouritesScrollTop();
  const itemHeight = getFavouritesItemHeight();

  const containerHeight = el?.clientHeight || 600;

  const startIndex = Math.max(0, Math.floor(scroll / itemHeight) - overscan);
  const endIndex = Math.min(
    favouritesItems.length - 1,
    Math.ceil((scroll + containerHeight) / itemHeight) + overscan
  );

  return { start: startIndex, end: endIndex };
};

// Get virtual items to render for favourites view
const getFavouritesVirtualItems = () => {
  const { start, end } = getFavouritesVisibleRange();
  const virtualItems = [];
  const itemHeight = getFavouritesItemHeight();

  for (let i = start; i <= end; i++) {
    virtualItems.push({
      index: i,
      start: i * itemHeight,
      size: itemHeight
    });
  }

  return virtualItems;
};

// Total height of all favourites
const getFavouritesTotalSize = () => getFavouritesItems().length * getFavouritesItemHeight();

// Handle scroll for favourites view
const handleFavouritesScroll = (e) => {
  setFavouritesScrollTop(e.target.scrollTop);
};

// Menu state
const [activeMenu, setActiveMenu] = args.createSignal(null);
const [menuPosition, setMenuPosition] = args.createSignal({ x: 0, y: 0 });

// Modal state
const [isModalOpen, setIsModalOpen] = args.createSignal(false);
const [modalData, setModalData] = args.createStore({ editMode: false, itemData: null });

// Reactive item height based on screen size
const getItemHeight = () => {
  return 90;
};

// Handle window resize
const handleResize = () => {
  setWindowWidth(window.innerWidth);
};

// Calculate visible items
const getVisibleRange = () => {
  const el = scrollElement();
  const filtered = filteredItems();
  const scroll = scrollTop();
  const itemHeight = getItemHeight();

  // If no element yet, use a default container height to render initial items
  // NOTE: Do NOT return early with {start: 0, end: 0} when el doesn't exist,
  // as that would only render 1 item. Use default height to calculate proper range.
  const containerHeight = el?.clientHeight || 600;

  const startIndex = Math.max(0, Math.floor(scroll / itemHeight) - overscan);
  const endIndex = Math.min(
    filtered.length - 1,
    Math.ceil((scroll + containerHeight) / itemHeight) + overscan
  );

  return { start: startIndex, end: endIndex };
};

// Get virtual items to render
const getVirtualItems = () => {
  const { start, end } = getVisibleRange();
  const items = [];
  const itemHeight = getItemHeight();

  for (let i = start; i <= end; i++) {
    items.push({
      index: i,
      start: i * itemHeight,
      size: itemHeight
    });
  }

  return items;
};

// Total height of all items
const getTotalSize = () => filteredItems().length * getItemHeight();

// Handle scroll
const handleScroll = (e) => {
  setScrollTop(e.target.scrollTop);
};

// Load list data
const loadListData = async () => {
  setLoading(true);
  try {
    const functionName = contentType === "playlists" ? "getUserPlaylists" : "getUserChannels";
    const result = await args.executeNamedServerFunction({
      functionName,
      contextData: {}
    });

    if (result?.error) {
      console.error("Error loading data:", result.error);
      args.showErrorToast(result.error);
      setItems([]);
    } else if (result?.result?.success && result?.result?.data) {
      const itemsData = contentType === "playlists"
        ? result.result.data.playlists || []
        : result.result.data.channels || [];
      setItems(itemsData);
    } else {
      // Handle error case
      const errorMessage = result?.result?.message || "Failed to load data";
      const errorDetails = result?.result?.error?.details;

      console.error("Error loading data:", errorDetails || errorMessage);
      args.showErrorToast(errorMessage);

      setItems([]);
    }
  } catch (error) {
    console.error("Unexpected error loading data:", error);
    args.showErrorToast("Failed to load data");
    setItems([]);
  } finally {
    setLoading(false);
  }
};

// Load detail data
const loadDetailData = async () => {
  setLoading(true);
  try {
    const functionName = contentType === "playlists" ? "getPlaylistVideos" : "getChannelContents";
    const result = await args.executeNamedServerFunction({
      functionName,
      contextData: {
        [contentType === "playlists" ? "playlistId" : "channelId"]: detailId
      }
    });

    if (result?.error) {
      console.error("Error loading details:", result.error);
      args.showErrorToast(result.error);
      setDetailData(null);
    } else if (result?.result?.success && result?.result?.data) {
      setDetailData(result.result.data);
    } else {
      // Handle error case
      const errorMessage = result?.result?.message || "Failed to load details";
      const errorDetails = result?.result?.error?.details;

      console.error("Error loading details:", errorDetails || errorMessage);
      args.showErrorToast(errorMessage);

      setDetailData(null);
    }
  } catch (error) {
    console.error("Error loading detail data:", error);
    args.showErrorToast("Failed to load details");
    setDetailData(null);
  } finally {
    setLoading(false);
  }
};

// Load search data
const loadSearchData = async (query) => {
  if (!query || query.trim().length === 0) {
    setSearchResults({ channels: [], playlists: [], videos: [], totalResults: 0 });
    setLoading(false);
    return;
  }

  setLoading(true);
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "searchUserContent",
      contextData: {
        query: query.trim(),
        type: "all",
        limit: 100
      }
    });

    if (result?.error) {
      console.error("Error searching:", result.error);
      args.showErrorToast(result.error);
      setSearchResults({ channels: [], playlists: [], videos: [], totalResults: 0 });
    } else if (result?.result?.success && result?.result?.data) {
      setSearchResults(result.result.data);
    } else {
      // Handle error case
      const errorMessage = result?.result?.message || "Failed to search content";
      const errorDetails = result?.result?.error?.details;

      console.error("Error searching:", errorDetails || errorMessage);
      args.showErrorToast(errorMessage);

      setSearchResults({ channels: [], playlists: [], videos: [], totalResults: 0 });
    }
  } catch (error) {
    console.error("Unexpected error searching:", error);
    args.showErrorToast("Failed to search");
    setSearchResults({ channels: [], playlists: [], videos: [], totalResults: 0 });
  } finally {
    setLoading(false);
  }
};

// Load favourites data
const loadFavouritesData = async () => {
  setLoading(true);
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "getUserFavourites",
      contextData: {}
    });

    if (result?.error) {
      console.error("Error loading favourites:", result.error);
      args.showErrorToast(result.error);
      setFavouritesData({ channels: [], playlists: [], videos: [] });
    } else if (result?.result?.success && result?.result?.data) {
      setFavouritesData(result.result.data);
    } else {
      // Handle error case - show the error message from server
      const errorMessage = result?.result?.message || "Failed to load favourites";
      const errorDetails = result?.result?.error?.details;

      console.error("Error loading favourites:", errorDetails || errorMessage);
      args.showErrorToast(errorMessage);

      setFavouritesData({ channels: [], playlists: [], videos: [] });
    }
  } catch (error) {
    console.error("Unexpected error loading favourites:", error);
    args.showErrorToast("Failed to load favourites");
    setFavouritesData({ channels: [], playlists: [], videos: [] });
  } finally {
    setLoading(false);
  }
};

// Load data based on view
const loadData = async () => {
  const currentSearchQuery = args.searchParams?.q;
  const currentDetailId = args.searchParams?.id;

  if (currentSearchQuery !== undefined) {
    await loadSearchData(currentSearchQuery);
  } else if (currentDetailId) {
    await loadDetailData();
  } else if (isFavouritesView()) {
    await loadFavouritesData();
  } else {
    await loadListData();
  }
};

// Reset all scroll positions
const resetScrollPositions = () => {
  // Reset signals immediately
  setScrollTop(0);
  setDetailScrollTop(0);
  setSearchScrollTop(0);
  setFavouritesScrollTop(0);

  // Reset DOM elements after a small delay to ensure they're rendered
  setTimeout(() => {
    const listEl = scrollElement();
    const detailEl = detailScrollElement();
    const searchEl = searchScrollElement();
    const favouritesEl = favouritesScrollElement();
    if (listEl) listEl.scrollTop = 0;
    if (detailEl) detailEl.scrollTop = 0;
    if (searchEl) searchEl.scrollTop = 0;
    if (favouritesEl) favouritesEl.scrollTop = 0;
  }, 0);
};

// Watch for query parameter changes and reload data
args.createEffect(() => {
  const currentType = args.searchParams?.type;
  const currentId = args.searchParams?.id;
  const currentQuery = args.searchParams?.q;

  // Reset scroll positions FIRST before loading new data
  resetScrollPositions();

  // Trigger reload when params change
  loadData();
});

// Handle search form submission
const handleSearch = async (e) => {
  if (e) e.preventDefault();
  const query = searchInput().trim();
  if (query) {
    args.navigate(`/yto/content?q=${encodeURIComponent(query)}`);
  }
};

// Filtered items
const filteredItems = args.createMemo(() => {
  const term = searchTerm().toLowerCase();
  if (!term) return items();

  return items().filter(item => {
    const data = contentType === "playlists" ? item.playlist : item.channel;
    const title = data?.P?.title?.toLowerCase() || "";
    const description = data?.P?.description?.toLowerCase() || "";
    return title.includes(term) || description.includes(term);
  });
});

// Navigation actions
const navigateToDetail = (item) => {
  const data = contentType === "playlists" ? item.playlist : item.channel;
  const id = data?.P?.youtubeId || "";
  args.navigate(`/yto/content?type=${contentType}&id=${id}`);
};

const navigateBack = () => {
  args.navigate(`/yto/content?type=${contentType}`);
};

// Menu actions
const openInYouTube = (item) => {
  const data = contentType === "playlists" ? item.playlist : item.channel;
  const youtubeId = data?.P?.youtubeId || "";
  const url = contentType === "playlists"
    ? `https://www.youtube.com/playlist?list=${youtubeId}`
    : `https://www.youtube.com/channel/${youtubeId}`;
  window.open(url, "_blank");
  setActiveMenu(null);
};

const editCustomName = async (item) => {
  setModalData({ editMode: true, itemData: item });
  setIsModalOpen(true);
  setActiveMenu(null);
};

// Alias for YTOCard component - converts item structure to match editCustomName expectations
const openCustomNameModal = (item, itemType, itemSettings) => {
  let contentType, itemData;

  if (itemType === "video") {
    contentType = "videos";
    itemData = { video: item, videoSettings: itemSettings };
  } else if (itemType === "playlist") {
    contentType = "playlists";
    itemData = { playlist: item, playlistSettings: itemSettings };
  } else {
    contentType = "channels";
    itemData = { channel: item, channelSetting: itemSettings };
  }

  setModalData({ editMode: true, itemData });
  setIsModalOpen(true);
};

const deleteItem = async (item) => {
  const data = contentType === "playlists" ? item.playlist : item.channel;
  const itemType = contentType === "playlists" ? "playlist" : "channel";
  const title = data?.P?.title || "this item";

  const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
  if (!rbConfirm) {
    args.showErrorToast("Confirmation dialog not available");
    setActiveMenu(null);
    return;
  }

  let message = `Are you sure you want to delete "${title}"?`;
  if (itemType === "channel") {
    message += "\n\nThis will also delete:\n• All playlists in this channel\n• All videos that are only in this channel's playlists";
  } else if (itemType === "playlist") {
    message += "\n\nThis will also delete:\n• All videos that are only in this playlist";
  }
  message += "\n\nThis action cannot be undone!";

  const confirmed = await rbConfirm({
    title: `Delete ${itemType}`,
    message,
    confirmText: `Delete ${itemType}`,
    cancelText: "Cancel",
    variant: "danger"
  });

  if (confirmed) {
    try {
      const functionName = itemType === "channel" ? "deleteChannel" : "deletePlaylist";
      const result = await args.executeNamedServerFunction({
        functionName,
        contextData: { item: data, itemType }
      });

      if (result?.result?.success) {
        args.showSuccessToast(result.result.message);
        await loadData();
      } else {
        args.showErrorToast(result?.result?.message || `Failed to delete ${itemType}`);
      }
    } catch (error) {
      console.error(`Error deleting ${itemType}:`, error);
      args.showErrorToast(`An error occurred while deleting ${itemType}`);
    }
  }
  setActiveMenu(null);
};

const deleteVideo = async (videoData) => {
  const video = videoData?.video;
  const title = video?.P?.title || "this video";

  // Get current detail data to determine context
  const detail = detailData();
  if (!detail) {
    args.showErrorToast("Detail view not loaded");
    return;
  }

  // Videos can only be deleted from playlists
  const currentContext = "playlist";
  const contextItem = detail.playlist?.playlist;
  const contextName = contextItem?.P?.title || "current view";

  if (!contextItem) {
    args.showErrorToast("Playlist information not found");
    return;
  }

  const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
  if (!rbConfirm) {
    args.showErrorToast("Confirmation dialog not available");
    return;
  }

  let message = `Are you sure you want to remove "${title}" from ${contextName}?`;
  message += "\n\nNote: This video will only be deleted if it doesn't exist in other playlists or the channel.";
  message += "\n\nThis action cannot be undone!";

  const confirmed = await rbConfirm({
    title: "Delete Video",
    message,
    confirmText: "Delete Video",
    cancelText: "Cancel",
    variant: "danger"
  });

  if (confirmed) {
    try {
      const result = await args.executeNamedServerFunction({
        functionName: "deleteVideo",
        contextData: {
          video,
          contextType: currentContext,
          contextItem: contextItem
        }
      });

      if (result?.result?.success) {
        args.showSuccessToast(result.result.message);
        await loadDetailData();
      } else {
        args.showErrorToast(result?.result?.message || "Failed to delete video");
      }
    } catch (error) {
      console.error("Error deleting video:", error);
      args.showErrorToast("An error occurred while deleting video");
    }
  }
};

// Modal actions
const openModal = () => {
  setModalData({ editMode: false, itemData: null });
  setIsModalOpen(true);
};

const closeModal = () => {
  setIsModalOpen(false);
  setModalData({ editMode: false, itemData: null });
};

const handleModalSave = async (saveData) => {
  closeModal();

  if (saveData?.editMode && saveData?.result) {
    // Edit mode - update local data instead of refetching
    args.fns.updateLocalItemSettings(saveData.result);
  } else {
    // Add mode, reload all data
    await loadData();
  }
};

// Note modal functions
const openNoteModal = (item, itemType, existingNote = "") => {
  setNoteModalData({ item, itemType, existingNote });
  setIsNoteModalOpen(true);
};

const closeNoteModal = () => {
  setIsNoteModalOpen(false);
  setNoteModalData({ item: null, itemType: null, existingNote: "" });
};

const saveNote = async (data) => {
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "saveNote",
      contextData: data
    });

    if (result?.result?.success) {
      args.showSuccessToast(result.result.message);

      // Update item data locally
      updateItemDataAfterNoteSave(result.result.data);

      return result.result;
    } else {
      const errorMessage = result?.result?.message || "Failed to save note";
      args.showErrorToast(errorMessage);
      const error = new Error(errorMessage);
      error.toastShown = true;
      throw error;
    }
  } catch (error) {
    // Only show toast for unexpected errors (network, etc.)
    if (!error.toastShown) {
      console.error("Unexpected error saving note:", error);
      args.showErrorToast("Failed to save note");
    }
    throw error;
  }
};

// Toggle favourite function
const toggleFavourite = async (item, itemType) => {
  try {
    const result = await args.executeNamedServerFunction({
      functionName: "toggleFavourite",
      contextData: { item, itemType }
    });

    if (result?.result?.success) {
      args.showSuccessToast(result.result.message);

      // Update item data locally
      updateItemDataAfterToggleFavourite(result.result.data);

      return result.result;
    } else {
      const errorMessage = result?.result?.message || "Failed to toggle favourite";
      args.showErrorToast(errorMessage);
      const error = new Error(errorMessage);
      error.toastShown = true;
      throw error;
    }
  } catch (error) {
    // Only show toast for unexpected errors (network, etc.)
    if (!error.toastShown) {
      console.error("Unexpected error toggling favourite:", error);
      args.showErrorToast("Failed to toggle favourite");
    }
    throw error;
  }
};

// Update item data after toggle favourite
const updateItemDataAfterToggleFavourite = (updatedData) => {
  const { settings, item, itemType } = updatedData;
  if (!settings || !item) return;

  const itemId = item.P?.youtubeId;
  if (!itemId) return;

  // Helper to update an item in an array
  const updateItemInArray = (items, itemKey, settingsKey) => {
    return items.map(existingItem => {
      const existingData = existingItem[itemKey];
      if (existingData?.P?.youtubeId === itemId) {
        // Update the settings
        return {
          ...existingItem,
          [settingsKey]: settings
        };
      }
      return existingItem;
    });
  };

  // Update list view data
  if (isListView()) {
    if (itemType === 'channel' && contentType === 'channels') {
      setItems(updateItemInArray(items(), 'channel', 'channelSetting'));
    } else if (itemType === 'playlist' && contentType === 'playlists') {
      setItems(updateItemInArray(items(), 'playlist', 'playlistSettings'));
    }
  }

  // Update detail view data
  if (isDetailView()) {
    const detail = detailData();
    if (detail) {
      if (itemType === 'video' && detail.videos) {
        // Update video in detail videos list
        const updatedVideos = detail.videos.map(videoItem => {
          if (videoItem.video?.P?.youtubeId === itemId) {
            return {
              ...videoItem,
              videoSettings: settings
            };
          }
          return videoItem;
        });
        setDetailData({ ...detail, videos: updatedVideos });
      } else if (itemType === 'channel' && detail.channel) {
        // Update channel in detail view
        if (detail.channel.channel?.P?.youtubeId === itemId) {
          setDetailData({ ...detail, channel: { ...detail.channel, channelSetting: settings } });
        }
      } else if (itemType === 'playlist') {
        // Update playlist in detail view
        if (detail.playlist?.playlist?.P?.youtubeId === itemId) {
          // Single playlist detail view
          setDetailData({ ...detail, playlist: { ...detail.playlist, playlistSettings: settings } });
        } else if (detail.playlists) {
          // Channel detail view showing playlists
          const updatedPlaylists = detail.playlists.map(playlistItem => {
            if (playlistItem.playlist?.P?.youtubeId === itemId) {
              return {
                ...playlistItem,
                playlistSettings: settings
              };
            }
            return playlistItem;
          });
          setDetailData({ ...detail, playlists: updatedPlaylists });
        }
      }
    }
  }

  // Update search results
  if (isSearchView()) {
    const results = searchResults();
    if (results) {
      const updatedResults = { ...results };

      if (itemType === 'channel' && results.channels) {
        updatedResults.channels = updateItemInArray(results.channels, 'channel', 'channelSetting');
      } else if (itemType === 'playlist' && results.playlists) {
        updatedResults.playlists = updateItemInArray(results.playlists, 'playlist', 'playlistSettings');
      } else if (itemType === 'video' && results.videos) {
        updatedResults.videos = updateItemInArray(results.videos, 'video', 'videoSettings');
      }

      setSearchResults(updatedResults);
    }
  }

  // Update favourites data
  if (isFavouritesView()) {
    const favourites = favouritesData();
    if (favourites) {
      const updatedFavourites = { ...favourites };

      if (itemType === 'channel' && favourites.channels) {
        updatedFavourites.channels = updateItemInArray(favourites.channels, 'channel', 'channelSetting');
      } else if (itemType === 'playlist' && favourites.playlists) {
        updatedFavourites.playlists = updateItemInArray(favourites.playlists, 'playlist', 'playlistSettings');
      } else if (itemType === 'video' && favourites.videos) {
        updatedFavourites.videos = updateItemInArray(favourites.videos, 'video', 'videoSettings');
      }

      setFavouritesData(updatedFavourites);
    }
  }
};

// Update item data after note is saved
const updateItemDataAfterNoteSave = (updatedData) => {
  const { settings, item, itemType } = updatedData;
  if (!settings || !item) return;

  const itemId = item.P?.youtubeId;
  if (!itemId) return;

  // Helper to update an item in an array
