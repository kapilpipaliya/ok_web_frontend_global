      id: "page_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const contentType = args.searchParams?.type || "channels";

// Determine title based on view
let title = "";
if (args.fns.isSearchView()) {
  title = "Search";
} else if (args.fns.isFavouritesView()) {
  title = "Favourites";
} else if (args.fns.isDetailView()) {
  const data = args.fns.detailData();
  if (data) {
    if (contentType === "playlists") {
      title = data.playlist?.playlist?.P?.title || "Playlist Details";
    } else {
      title = data.channel?.channel?.P?.title || "Channel Details";
    }
  } else {
    title = contentType === "playlists" ? "Playlist Details" : "Channel Details";
  }
} else {
  // List view
  title = contentType === "playlists" ? "Playlists" : "Channels";
}

return {
  as: "h1",
  text: title
};
''',
        css: '''
return `._id {
  font-size: 2rem;
  font-weight: 700;
  color: ${args.theme.var.color.text};
  margin: 0 0 0.5rem 0;
}`;
'''
      }
    },
    {
      id: "processing_status",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "YTOProcessingStatus",
        props: '''
const contentType = args.searchParams?.type || "channels";
const data = args.fns.detailData();

if (!args.fns.isDetailView() || !data) {
  return { hide: true };
}

const itemId = contentType === "playlists"
  ? data.playlist?.playlist?.P?.youtubeId
  : data.channel?.channel?.P?.youtubeId;

const processingData = contentType === "playlists"
  ? args.fns.getPlaylistProcessingStatus(itemId)
  : args.fns.getChannelProcessingStatus(itemId);

if (!processingData) {
  return { hide: true };
}

// Extract data from vertex format
const settings = contentType === "playlists"
  ? processingData.playlistSetting
  : processingData.channelSetting;

if (!settings || !settings.P) {
  return { hide: true };
}

let details = '';
if (contentType === "channels") {
  const processedPlaylists = settings.P.processedPlaylists || 0;
  const totalPlaylists = settings.P.totalPlaylists || 0;
  const processedVideos = settings.P.processedVideos || 0;
  const totalVideos = settings.P.totalVideos || 0;
  details = `${processedPlaylists}/${totalPlaylists} playlists, ${processedVideos}/${totalVideos} videos`;
} else {
  const processedVideos = settings.P.processedVideos || 0;
  const totalVideos = settings.P.totalVideos || 0;
  details = `${processedVideos}/${totalVideos} videos`;
}

return {
  status: settings.P.status,
  progress: settings.P.progress || 0,
  type: contentType === "playlists" ? "playlist" : "channel",
  details
};
'''
      }
