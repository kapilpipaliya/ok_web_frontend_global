      P: {
        displayOrder: 1,
        componentName: "YTOCard",
        props: '''
const virtualItem = args.contextData.virtualItem;
const contentType = args.searchParams?.type || "channels";
const item = args.fns.filteredItems()[virtualItem.index];

// Get processing status for this item
const itemData = contentType === "playlists" ? item.playlist : item.channel;
const itemId = itemData?.P?.youtubeId;
const processingStatus = contentType === "playlists"
  ? args.fns.getPlaylistProcessingStatus(itemId)
  : args.fns.getChannelProcessingStatus(itemId);

return {
  item: itemData,
  itemSettings: contentType === "playlists" ? item.playlistSettings : item.channelSetting,
  itemType: contentType === "playlists" ? "playlist" : "channel",
  processingStatus: processingStatus
};
'''
      }
    },
    {
      id: "card_processing_status",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "YTOProcessingStatus",
