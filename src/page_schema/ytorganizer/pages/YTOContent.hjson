  background: ${args.theme.var.color.background_light_100};
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.75rem;
  padding: 3rem 2rem;
  text-align: center;
}`;
'''
      }
    },
    {
      id: "search_empty_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "mdi:magnify",
  width: 64,
  height: 64
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.muted};
  margin-bottom: 1rem;
  opacity: 0.5;
}`;
'''
      }
    },
    {
      id: "search_empty_text",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const query = args.searchParams?.q || "";
const text = query ? "No results found" : "Enter a search query to find channels, playlists, and videos";

return {
  as: "p",
  text
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.muted};
  margin: 0;
}`;
'''
      }
    },
    {
      id: "search_results_wrapper",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: args.fns.loading() || args.fns.getSearchItems().length === 0
};
''',
        css: '''
return `._id {
  position: relative;
}`;
'''
      }
    },
    {
      id: "search_results_list",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const totalSize = args.fns.getSearchTotalSize();

return {
  as: "div",
  style: {
    height: `${totalSize}px`,
    width: "100%",
    position: "relative"
  }
};
'''
      }
    },
    {
      id: "search_virtual_items",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const virtualItems = args.fns.getSearchVirtualItems();

return {
  data: virtualItems,
  loop: true,
  contextName: "searchItem"
};
''',
        css: '''
return `._id {
  display: contents;
}`;
'''
      }
    },
    {
      id: "search_result_wrapper",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const searchItem = args.contextData.searchItem;

return {
  as: "div",
  style: {
    position: "absolute",
    top: 0,
    left: 0,
    width: "100%",
    height: `${searchItem.size}px`,
    transform: `translateY(${searchItem.start}px)`
  }
};
'''
      }
    },
    {
      id: "search_result_card",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "YTOCard",
        props: '''
const searchItem = args.contextData.searchItem;
const item = args.fns.getSearchItems()[searchItem.index];
const resultType = item.resultType;
const itemData = resultType === "channel" ? item.channel : (resultType === "playlist" ? item.playlist : item.video);
const itemId = itemData?.P?.youtubeId;

// Get processing status (only for channels and playlists, not videos)
const processingStatus = resultType === "channel"
  ? args.fns.getChannelProcessingStatus(itemId)
  : resultType === "playlist"
  ? args.fns.getPlaylistProcessingStatus(itemId)
  : null;

return {
  item: itemData,
  itemSettings: resultType === "channel" ? item.channelSetting : (resultType === "playlist" ? item.playlistSettings : item.videoSettings),
  itemType: resultType,
  showTypeBadge: true,
  processingStatus: processingStatus
};
'''
      }
    },
