      id: "favourites_header_section",
      L: "Attr",
      P: {
        displayOrder: 7,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: () => !args.fns.isFavouritesView()
};
''',
        css: '''
return `._id {
  padding: 1.5rem 1.5rem 0 1.5rem;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
}

@media (max-width: 768px) {
  ._id {
    padding: 1rem 1rem 0 1rem;
  }
}`;
