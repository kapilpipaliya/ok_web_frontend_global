const contentType = args.searchParams?.type || "channels";

// Determine placeholder and handlers based on view
let placeholder = "";
let value = "";
let onInput = null;
let autofocus = false;

if (args.fns.isSearchView()) {
  placeholder = "Search channels, playlists, and videos...";
  value = args.fns.searchInput();
  onInput = (e) => args.fns.setSearchInput(e.target.value);
  autofocus = true;
} else if (args.fns.isFavouritesView()) {
  placeholder = "Filter favourites...";
  value = args.fns.searchTerm();
  onInput = (e) => args.fns.setSearchTerm(e.target.value);
} else if (args.fns.isDetailView()) {
  placeholder = contentType === "playlists"
    ? "Search videos..."
    : "Search playlists...";
  value = args.fns.detailSearchTerm();
  onInput = (e) => args.fns.setDetailSearchTerm(e.target.value);
} else {
  // List view
  placeholder = contentType === "playlists"
    ? "Search playlists..."
    : "Search channels...";
  value = args.fns.searchTerm();
  onInput = (e) => args.fns.setSearchTerm(e.target.value);
}

return {
  placeholder,
  leftIcon: "mdi:magnify",
  value,
  onInput,
  autofocus
};
'''
