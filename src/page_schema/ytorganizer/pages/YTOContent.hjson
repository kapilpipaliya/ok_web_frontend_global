  ? item.playlist?.P?.youtubeId
  : item.channel?.P?.youtubeId;

const processingData = contentType === "playlists"
  ? args.fns.getPlaylistProcessingStatus(itemId)
  : args.fns.getChannelProcessingStatus(itemId);

if (!processingData) {
  return { hide: true };
}

// Extract data from vertex format
const settings = contentType === "playlists"
  ? processingData.playlistSetting
  : processingData.channelSetting;

if (!settings || !settings.P) {
  return { hide: true };
}

let details = '';
if (contentType === "channels") {
  const processedPlaylists = settings.P.processedPlaylists || 0;
  const totalPlaylists = settings.P.totalPlaylists || 0;
  const processedVideos = settings.P.processedVideos || 0;
  const totalVideos = settings.P.totalVideos || 0;
  details = `${processedPlaylists}/${totalPlaylists} playlists, ${processedVideos}/${totalVideos} videos`;
} else {
  const processedVideos = settings.P.processedVideos || 0;
  const totalVideos = settings.P.totalVideos || 0;
  details = `${processedVideos}/${totalVideos} videos`;
}

return {
  status: settings.P.status,
  progress: settings.P.progress || 0,
  type: contentType === "playlists" ? "playlist" : "channel",
  details
};
'''
