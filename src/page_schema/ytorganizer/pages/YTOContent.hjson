      } else if (itemType === 'playlist' && results.playlists) {
        updatedResults.playlists = updateItemInArray(results.playlists, 'playlist', 'playlistSettings');
      } else if (itemType === 'video' && results.videos) {
        updatedResults.videos = updateItemInArray(results.videos, 'video', 'videoSettings');
      }

      setSearchResults(updatedResults);
    }
  }

  // Update favourites data
