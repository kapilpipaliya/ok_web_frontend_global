};
'''
      }
    },
    {
      id: "yto_channels_empty_action_text",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "span",
  text: "Add Your First Channel"
};
'''
      }
    },
    {
      id: "yto_channels_loading",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
