    { id: "e9", T: "Attr", S: "yto_channels_empty_state", E: "yto_channels_empty_action" },
    { id: "e10", T: "Attr", S: "yto_channels_empty_action", E: "yto_channels_empty_action_icon" },
    { id: "e11", T: "Attr", S: "yto_channels_empty_action", E: "yto_channels_empty_action_text" },
    { id: "e12", T: "Attr", S: "yto_channels_container", E: "yto_channels_loading" },
    { id: "e13", T: "Attr", S: "yto_channels_loading", E: "yto_channels_loading_spinner" },
    { id: "e14", T: "Attr", S: "yto_channels_loading", E: "yto_channels_loading_text" },
    { id: "e15", T: "Attr", S: "yto_channels_container", E: "yto_channels_list_wrapper" },
    { id: "e16", T: "Attr", S: "yto_channels_list_wrapper", E: "yto_channels_list" },
    { id: "e17", T: "Attr", S: "yto_channels_list", E: "yto_channels_virtual_items" },
    { id: "e18", T: "Attr", S: "yto_channels_virtual_items", E: "yto_channels_card_wrapper" },
    { id: "e19", T: "Attr", S: "yto_channels_card_wrapper", E: "yto_channels_card" },
    { id: "e20", T: "Attr", S: "yto_channels_root", E: "yto_channels_add_button" }
  ]
}