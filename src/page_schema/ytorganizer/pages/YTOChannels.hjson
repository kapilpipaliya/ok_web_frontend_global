{
  vertexes: [
    {
      id: "yto_channels_page",
      L: "Page",
      P: {
        key: "YTOChannels",
        url: "/channels",
        title: "Channels - YouTube Organizer",
        description: "Manage your favorite YouTube channels and discover new content",
        props: '''
return {
  isNoPermissionCheck: true,
  enabled: true
};
'''
      }
    },
    {
      id: "yto_channels_layout",
      L: "PageLayout",
      P: {
        componentName: "YTOLayout",
        displayOrder: 1
      }
    },
    {
      id: "yto_channels_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  onMount: () => args.fns.loadChannels()
};
''',
        fns: '''
// State for channels data
const [channels, setChannels] = args.createSignal([]);
const [loading, setLoading] = args.createSignal(true);
const [error, setError] = args.createSignal(null);

// Load channels when component mounts
const loadChannels = async () => {
  try {
    setLoading(true);
    setError(null);

    const result = await args.executeNamedServerFunction({
      functionName: "getUserChannels",
      contextData: {}
    });

    if (result.error) {
      const errorMessage = result.error;
      setError(errorMessage);
      args.showErrorToast(errorMessage);
    } else if (result.result && result.result.success) {
      // Process raw vertex data from convertNodeToJson
      const processedChannels = result.result.data.channels.map(item => {
        const channel = item.channel;
        const channelSettings = item.channelSettings;

        return {
          // Channel data from YouTube (accessing P field)
          channelId: channel.P.youtubeId,
          title: channel.P.title,
          description: channel.P.description || '',
          thumbnail: channel.P.thumbnail || '',
          customUrl: channel.P.customUrl || '',
          country: channel.P.country || '',
          videoCount: channel.P.videoCount || 0,
          viewCount: channel.P.viewCount || 0,
          subscriberCount: channel.P.subscriberCount || 0,
          publishedAt: channel.P.publishedAt,
          updatedAt: channel.P.updatedAt,

          // User-specific settings (accessing P field)
          customName: channelSettings.P.customName,
          notifications: channelSettings.P.notifications || false,
          autoDownload: channelSettings.P.autoDownload || false,
          priority: channelSettings.P.priority || 'normal',
          addedAt: channelSettings.P.createdAt,
          settingsUpdatedAt: channelSettings.P.updatedAt,

          // Display name (custom name or channel title)
          displayName: channelSettings.P.customName || channel.P.title
        };
      });
      setChannels(processedChannels);
    } else {
      const errorMessage = result.result?.message || result.message || "Failed to load channels";
      setError(errorMessage);
      args.showErrorToast(errorMessage);
    }
  } catch (err) {
    console.error("Error loading channels:", err);
    setError("Failed to load channels");
    args.showErrorToast("Failed to load channels");
  } finally {
    setLoading(false);
  }
};

// Handle channel submission
const handleChannelSubmit = (data) => {
  args.showSuccessToast(`Channel "${data.result.title}" added successfully!`);
  // Reload channels after adding new one
  loadChannels();
};

return {
  channels,
  loading,
  error,
  loadChannels,
  handleChannelSubmit
};
'''
      }
    },
    {
      id: "yto_channels_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  padding: 1.5rem;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  
  @media (max-width: 768px) {
    padding: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_channels_header_content",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}`;
'''
      }
    },
    {
      id: "yto_channels_title_section",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}`;
'''
      }
    },
    {
      id: "yto_channels_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:api-1",
  width: 32,
  height: 32
};
'''
      }
    },
    {
      id: "yto_channels_title",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: "My Channels"
};
''',
        css: '''
return `._id {
  font-size: 2rem;
  font-weight: 700;
  margin: 0;
  
  @media (max-width: 768px) {
    font-size: 1.5rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_channels_stats",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const channelCount = args.fns.channels().length;
return {
  as: "div",
  text: `${channelCount} channel${channelCount !== 1 ? 's' : ''}`
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  opacity: 0.9;
  background: rgba(255,255,255,0.1);
  padding: 0.5rem 1rem;
  border-radius: 2rem;
  
  @media (max-width: 768px) {
    font-size: 0.75rem;
    padding: 0.375rem 0.75rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_channels_container",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "main"
};
''',
        css: '''
return `._id {
  padding: 1.5rem;
  max-width: 1400px;
  margin: 0 auto;
  min-height: 60vh;
  
  @media (max-width: 768px) {
    padding: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_channels_empty_state",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const channels = args.fns.channels();
const loading = args.fns.loading();

return {
  as: "div",
  hide: loading || channels.length > 0
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 4rem 2rem;
  background: ${args.theme.var.color.background_dark_50};
  border-radius: 1rem;
  border: 2px dashed ${args.theme.var.color.border};
  margin-bottom: 2rem;
  
  @media (max-width: 768px) {
    padding: 3rem 1.5rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_channels_empty_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  width: 80px;
