const totalCount = args.fns.store.totalCount;
const currentPage = args.fns.store.currentPage;
const pageSize = args.fns.store.pageSize;
const startIndex = (currentPage - 1) * pageSize + 1;
const endIndex = Math.min(currentPage * pageSize, totalCount);

return {
  as: "p",
  text: totalCount > 0 ? `Showing ${startIndex}-${endIndex} of ${totalCount} feedbacks` : `${totalCount} feedbacks`,
  hide: () => args.fns.store.loading
};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.sm};
  color: ${args.theme.var.color.muted};
  margin: 0;
}`;
'''
