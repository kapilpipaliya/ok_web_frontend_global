const feedbackData = args.contextData.feedbackData;
const type = feedbackData.feedback?.P?.category || 'other';
const typeLabels = {
  bug: 'Bug Report',
  feature: 'Feature',
  improvement: 'Improvement',
  other: 'Other'
};

return {
  as: "span",
  text: typeLabels[type] || 'Other'
};
''',
        css: '''
const feedbackData = args.contextData.feedbackData;
const type = feedbackData.feedback?.P?.category || 'other';

const colors = {
  bug: { bg: args.theme.var.color.error_light_100, text: args.theme.var.color.error_light_100_text },
  feature: { bg: args.theme.var.color.info_light_100, text: args.theme.var.color.info_light_100_text },
  improvement: { bg: args.theme.var.color.success_light_100, text: args.theme.var.color.success_light_100_text },
  other: { bg: args.theme.var.color.background_dark_200, text: args.theme.var.color.background_dark_200_text }
};

const color = colors[type] || colors.other;

return `._id {
  display: inline-block;
  padding: ${args.theme.var.spacing.xs} ${args.theme.var.spacing.sm};
  background: ${color.bg};
  color: ${color.text};
  border-radius: ${args.theme.var.borderRadius.sm};
  font-size: ${args.theme.var.fontSize.xs};
  font-weight: 600;
}`;
'''
      }
    },
