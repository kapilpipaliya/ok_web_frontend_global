        css: '''
const feedbackData = args.contextData.feedbackData;
const status = feedbackData.feedback?.P?.status || 'pending';

const colors = {
  new: { bg: args.theme.var.color.warning_light_100, text: args.theme.var.color.warning_light_100_text },
  reviewed: { bg: args.theme.var.color.info_light_100, text: args.theme.var.color.info_light_100_text },
  resolved: { bg: args.theme.var.color.success_light_100, text: args.theme.var.color.success_light_100_text }
};

const color = colors[status] || colors.new;

return `._id {
  display: inline-block;
  padding: ${args.theme.var.spacing.xs} ${args.theme.var.spacing.sm};
  background: ${color.bg};
  color: ${color.text};
  border-radius: ${args.theme.var.borderRadius.sm};
  font-size: ${args.theme.var.fontSize.xs};
  font-weight: 600;
}`;
'''
