        props: '''
const filteredFeedbacks = args.fns.getFilteredFeedbacks();
const allSelected = filteredFeedbacks.length > 0 && filteredFeedbacks.every(f => args.fns.store.selectedFeedbacks.includes(f.feedback?.id));

return {
  as: "input",
  type: "checkbox",
  checked: allSelected,
  onChange: () => {
    if (allSelected) {
      args.fns.clearSelection();
    } else {
      args.fns.selectAllFeedbacks();
    }
  }
};
''',
