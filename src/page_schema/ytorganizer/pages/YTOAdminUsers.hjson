'''
      }
    }
  ],
  edges: [
    { id: "e1", T: "PageLayout", S: "page_root", E: "layout_ref" },
    { id: "e2", T: "Attr", S: "page_root", E: "main_container" },
    { id: "e3", T: "Attr", S: "main_container", E: "page_title" },
    { id: "e3b", T: "Attr", S: "main_container", E: "stats_summary" },
    { id: "e3c", T: "Attr", S: "stats_summary", E: "stat_card" },
    { id: "e3d", T: "Attr", S: "stat_card", E: "stat_card_label" },
    { id: "e3e", T: "Attr", S: "stat_card", E: "stat_card_value" },
    { id: "e4", T: "Attr", S: "main_container", E: "search_container" },
