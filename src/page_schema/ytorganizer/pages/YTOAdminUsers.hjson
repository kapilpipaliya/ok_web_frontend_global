''',
        css: '''
return `._id {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: ${args.theme.var.spacing.md};

  @media (max-width: 768px) {
    grid-template-columns: 1fr;
    gap: ${args.theme.var.spacing.sm};
  }
}`;
'''
      }
    },
    {
      id: "user_card",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "YTOAdminUserCard",
        props: '''
return {
