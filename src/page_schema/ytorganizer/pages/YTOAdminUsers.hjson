};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize['2xl']};
  font-weight: 700;
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "loading_state",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
return {
  as: "div",
  text: "Loading users...",
  hide: () => !args.fns.store.loading
};
''',
        css: '''
return `._id {
  text-align: center;
  padding: ${args.theme.var.spacing.xl};
  color: ${args.theme.var.color.muted};
}`;
'''
      }
    },
    {
      id: "error_state",
      L: "Attr",
      P: {
        displayOrder: 5,
        componentName: "Html",
        props: '''
return {
  as: "div",
  text: args.fns.store.error || "An error occurred",
  hide: () => !args.fns.store.error
};
''',
        css: '''
return `._id {
  text-align: center;
  padding: ${args.theme.var.spacing.xl};
