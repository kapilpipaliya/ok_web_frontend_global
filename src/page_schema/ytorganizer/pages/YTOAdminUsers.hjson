  margin-bottom: ${args.theme.var.spacing.xs};
}`;
'''
      }
    },
    {
      id: "stat_card_value",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const stat = args.contextData.stat;
return {
  as: "div",
