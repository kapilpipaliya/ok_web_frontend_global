    },
    {
      id: "th_checkbox_input",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const filteredUsers = args.fns.getFilteredUsers();
const allSelected = filteredUsers.length > 0 && filteredUsers.every(ud => args.fns.store.selectedUsers.includes(ud.user?.id));

return {
  as: "input",
  type: "checkbox",
  checked: allSelected,
  onChange: () => {
    if (allSelected) {
      args.fns.clearSelection();
    } else {
      args.fns.selectAllUsers();
    }
  }
};
''',
