        displayOrder: 2,
        componentName: "Html",
        props: '''
const totalCount = args.fns.store.totalCount;
const currentPage = args.fns.store.currentPage;
const pageSize = args.fns.store.pageSize;
const startIndex = (currentPage - 1) * pageSize + 1;
const endIndex = Math.min(currentPage * pageSize, totalCount);

return {
  as: "p",
  text: totalCount > 0 ? `Showing ${startIndex}-${endIndex} of ${totalCount} users` : `${totalCount} users`,
  hide: () => args.fns.store.loading
};
''',
        css: '''
return `._id {
  font-size: ${args.theme.var.fontSize.sm};
  color: ${args.theme.var.color.muted};
  margin: 0;
}`;
'''
      }
    },
    {
      id: "stats_summary",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        contextName: "stat",
        loop: true,
        fns: '''
return {
  getStatsData: () => {
    const users = args.fns.store.users;
    const activeUsers = users.filter(ud => args.fns.getUserStatus(ud.stats) === 'active').length;
    const totalChannels = users.reduce((sum, ud) => sum + (ud.stats?.channelCount || 0), 0);
    const totalPlaylists = users.reduce((sum, ud) => sum + (ud.stats?.playlistCount || 0), 0);
    const totalVideos = users.reduce((sum, ud) => sum + (ud.stats?.videoCount || 0), 0);

    return [
      { label: "Active Users", value: activeUsers, icon: "carbon:user-activity" },
      { label: "Total Channels", value: totalChannels, icon: "carbon:video" },
      { label: "Total Playlists", value: totalPlaylists, icon: "carbon:list" },
      { label: "Total Videos", value: totalVideos, icon: "carbon:play-filled" }
    ];
  }
};
''',
        props: '''
return {
  as: "div",
  data: args.fns.getStatsData(),
  hide: () => args.fns.store.loading
};
''',
