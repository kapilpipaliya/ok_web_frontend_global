    {
      id: "th_user",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "th",
  onClick: () => args.fns.handleSort('username')
};
''',
        css: '''
return `._id {
  padding: ${args.theme.var.spacing.md};
