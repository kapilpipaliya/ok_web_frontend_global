      }
    },
    {
      id: "td_engagement_score",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const userdata = args.contextData.userdata;
const score = args.fns.calculateEngagementScore(userdata.stats);

return {
  as: "div",
  text: score
};
''',
        css: '''
const userdata = args.contextData.userdata;
const score = args.fns.calculateEngagementScore(userdata.stats);

const getColor = () => {
  if (score >= 100) return args.theme.var.color.success;
  if (score >= 50) return args.theme.var.color.info;
  if (score >= 20) return args.theme.var.color.warning;
  return args.theme.var.color.muted;
};

return `._id {
  font-weight: 700;
  font-size: ${args.theme.var.fontSize.md};
  color: ${getColor()};
}`;
'''
      }
    },
