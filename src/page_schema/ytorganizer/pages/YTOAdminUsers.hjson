{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "YTOAdminUsers",
        url: "/yto/admin/users",
        signinRequired: true,
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "layout_ref",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "YTOLayout"
      }
    },
    {
      id: "main_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
// State management
const [store, setStore] = args.createStore({
  users: [],
  loading: true,
  error: null,
  searchQuery: '',
  selectedUsers: [],
  sortBy: 'createdAt',
  sortOrder: 'desc',
  filterStatus: 'all', // all, active, dormant, new
  impersonatedUserId: null,
  currentPage: 1,
  pageSize: 20,
  totalCount: 0,
  totalPages: 0
});

// Check if user is admin
const checkAdminRole = () => {
  const userRoles = args.user?.OUT?.UserRole || [];
  return userRoles.some(edge => {
    const role = args.graph.vertexes[edge.E];
    return role?.P?.key === "Admin";
  });
};

// Load all users with YTO stats
const loadUsers = async (page = store.currentPage) => {
  setStore('loading', true);
  setStore('error', null);

  const offset = (page - 1) * store.pageSize;

  const result = await args.fns.executeYTOFunction("getAllYTOUsers", {
    searchQuery: store.searchQuery,
    filterStatus: store.filterStatus,
    limit: store.pageSize,
    offset: offset
  });

  if (result.error) {
    setStore('error', result.error);
    setStore('loading', false);
    return;
  }

  const serverResult = result.result;

  if (serverResult?.success) {
    setStore('users', serverResult.data.users || []);
    setStore('totalCount', serverResult.data.totalCount || 0);
    setStore('totalPages', Math.ceil((serverResult.data.totalCount || 0) / store.pageSize));
    setStore('currentPage', page);
  } else {
    setStore('error', serverResult?.message || "Failed to load users");
  }
  setStore('loading', false);
};

// Calculate engagement score
const calculateEngagementScore = (stats) => {
  const channelScore = (stats?.channelCount || 0) * 10;
  const playlistScore = (stats?.playlistCount || 0) * 5;
  const videoScore = (stats?.videoCount || 0) * 2;
  const favScore = ((stats?.favoriteChannelCount || 0) + (stats?.favoritePlaylistCount || 0) + (stats?.favoriteVideoCount || 0)) * 3;

  const now = new Date();
  const lastActivity = [
    stats?.lastChannelAdded ? new Date(stats.lastChannelAdded) : null,
    stats?.lastPlaylistAdded ? new Date(stats.lastPlaylistAdded) : null,
    stats?.lastVideoActivity ? new Date(stats.lastVideoActivity) : null
  ].filter(d => d).sort((a, b) => b - a)[0];

  const daysSinceActivity = lastActivity ? (now - lastActivity) / (1000 * 60 * 60 * 24) : 999;
  const activityBonus = daysSinceActivity < 7 ? 50 : daysSinceActivity < 30 ? 25 : 0;

  return Math.round(channelScore + playlistScore + videoScore + favScore + activityBonus);
};

// Get user activity status
const getUserStatus = (stats) => {
  const now = new Date();
  const lastActivity = [
    stats?.lastChannelAdded ? new Date(stats.lastChannelAdded) : null,
    stats?.lastPlaylistAdded ? new Date(stats.lastPlaylistAdded) : null,
    stats?.lastVideoActivity ? new Date(stats.lastVideoActivity) : null
  ].filter(d => d).sort((a, b) => b - a)[0];

  if (!lastActivity) return 'dormant';

  const daysSinceActivity = (now - lastActivity) / (1000 * 60 * 60 * 24);

  if (daysSinceActivity < 7) return 'active';
  if (daysSinceActivity < 30) return 'new';
  return 'dormant';
};

// Get users (filtering now happens server-side)
const getFilteredUsers = () => {
  return store.users;
};

// Start impersonation
const startImpersonation = async (userId) => {
  const result = await args.fns.executeYTOFunction("impersonateUser", { targetUserId: userId });

  if (result.error) {
    args.showErrorToast(result.error);
    return;
  }

  const serverResult = result.result;

  if (serverResult?.success) {
    const impersonatedUser = serverResult.data.impersonatedUser;

    if (typeof window !== 'undefined') {
      sessionStorage.setItem('yto_impersonatedUser', JSON.stringify(impersonatedUser));
    }

    setStore('impersonatedUserId', userId);
    args.showSuccessToast("Now viewing as user");
    args.navigate('/yto/content');
  } else {
    args.showErrorToast(serverResult?.message || "Failed to start impersonation");
  }
};

// Toggle user selection
const toggleUserSelection = (userId) => {
  const selected = store.selectedUsers;
  if (selected.includes(userId)) {
    setStore('selectedUsers', selected.filter(id => id !== userId));
  } else {
    setStore('selectedUsers', [...selected, userId]);
  }
};

// Select all users
const selectAllUsers = () => {
  const filteredUsers = getFilteredUsers();
  setStore('selectedUsers', filteredUsers.map(ud => ud.user?.id));
};

// Clear selection
const clearSelection = () => {
  setStore('selectedUsers', []);
};

// Search handler with debounce
let searchTimeout;
const handleSearch = (query) => {
  setStore('searchQuery', query);
  clearTimeout(searchTimeout);
  searchTimeout = setTimeout(() => {
    setStore('currentPage', 1);
    loadUsers(1);
  }, 500);
};

// Sort handler
const handleSort = (column) => {
  if (store.sortBy === column) {
    setStore('sortOrder', store.sortOrder === 'asc' ? 'desc' : 'asc');
  } else {
    setStore('sortBy', column);
    setStore('sortOrder', 'desc');
  }
};

// Filter handler
const handleFilterChange = (status) => {
  setStore('filterStatus', status);
  setStore('currentPage', 1); // Reset to first page when filter changes
  loadUsers(1);
};

// Pagination handlers
const goToPage = (page) => {
  if (page < 1 || page > store.totalPages) return;
  loadUsers(page);
};

const goToNextPage = () => {
  if (store.currentPage < store.totalPages) {
    loadUsers(store.currentPage + 1);
  }
};

const goToPreviousPage = () => {
  if (store.currentPage > 1) {
    loadUsers(store.currentPage - 1);
  }
};

// Get visible page numbers for pagination
const getVisiblePages = () => {
  const pages = [];
  const totalPages = store.totalPages;
  const currentPage = store.currentPage;

  if (totalPages <= 7) {
    // Show all pages if 7 or less
    for (let i = 1; i <= totalPages; i++) {
      pages.push(i);
    }
  } else {
    // Always show first page
    pages.push(1);

    if (currentPage > 3) {
      pages.push('...');
    }

    // Show pages around current
    const start = Math.max(2, currentPage - 1);
    const end = Math.min(totalPages - 1, currentPage + 1);

    for (let i = start; i <= end; i++) {
      pages.push(i);
    }

    if (currentPage < totalPages - 2) {
      pages.push('...');
    }

    // Always show last page
    if (totalPages > 1) {
      pages.push(totalPages);
    }
  }

  return pages;
};

// Format date
const formatDate = (dateStr) => {
  if (!dateStr) return 'Never';
  const date = new Date(dateStr);
  const now = new Date();
  const diffDays = Math.floor((now - date) / (1000 * 60 * 60 * 24));

  if (diffDays === 0) return 'Today';
  if (diffDays === 1) return 'Yesterday';
  if (diffDays < 7) return `${diffDays}d ago`;
  if (diffDays < 30) return `${Math.floor(diffDays / 7)}w ago`;
  if (diffDays < 365) return `${Math.floor(diffDays / 30)}mo ago`;
  return `${Math.floor(diffDays / 365)}y ago`;
};

return {
  store,
  loadUsers,
  calculateEngagementScore,
  getUserStatus,
  getFilteredUsers,
  startImpersonation,
  toggleUserSelection,
  selectAllUsers,
  clearSelection,
  handleSearch,
  handleSort,
  handleFilterChange,
  goToPage,
  goToNextPage,
  goToPreviousPage,
  getVisiblePages,
  formatDate
};
''',
        props: '''
