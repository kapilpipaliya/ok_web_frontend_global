    },
    {
      id: "td_last_activity",
      L: "Attr",
      P: {
        displayOrder: 9,
        componentName: "Html",
        props: '''
const userdata = args.contextData.userdata;
const lastActivities = [
  userdata.stats?.lastChannelAdded ? new Date(userdata.stats.lastChannelAdded) : null,
  userdata.stats?.lastPlaylistAdded ? new Date(userdata.stats.lastPlaylistAdded) : null,
  userdata.stats?.lastVideoActivity ? new Date(userdata.stats.lastVideoActivity) : null
].filter(d => d).sort((a, b) => b - a)[0];

const activityText = args.fns.formatDate(lastActivities?.toISOString());

return {
  as: "td",
  text: activityText
};
''',
        css: '''
return `._id {
  padding: ${args.theme.var.spacing.md};
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "td_engagement",
      L: "Attr",
      P: {
        displayOrder: 10,
        componentName: "Html",
        props: '''
const userdata = args.contextData.userdata;
const score = args.fns.calculateEngagementScore(userdata.stats);

return {
  as: "td"
