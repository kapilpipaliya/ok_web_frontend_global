    {
      id: "privacy_section_4_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  innerHTML: `
    <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">YouTube API Services</h3>
    <p style="line-height: 1.6; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">YouTube Organizer uses YouTube API Services to access your YouTube data. By using our service, you are also agreeing to be bound by the <a href="https://www.youtube.com/t/terms" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">YouTube Terms of Service</a> and <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">Google Privacy Policy</a>.</p>

    <p style="line-height: 1.6; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">You can revoke YouTube Organizer's access to your YouTube data at any time through the <a href="https://security.google.com/settings/security/permissions" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">Google security settings page</a>.</p>

    <p style="line-height: 1.6; color: ${args.theme.var.color.text};">We do not share your YouTube data with any third parties except as necessary to provide our service (e.g., hosting providers with appropriate data protection agreements).</p>
  `
};
'''
      }
    },
    // Section 5: Your Rights
    {
      id: "privacy_section_5",
