  font-weight: 600;
  margin-bottom: 1rem;
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "privacy_section_2_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  innerHTML: `
    <p style="line-height: 1.6; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">We use the collected information for the following purposes:</p>
    <ul style="line-height: 1.6; color: ${args.theme.var.color.text}; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">To provide and maintain our service</li>
      <li style="margin-bottom: 0.5rem;">To organize and display your YouTube content</li>
      <li style="margin-bottom: 0.5rem;">To sync and update your YouTube data</li>
      <li style="margin-bottom: 0.5rem;">To save your notes, favorites, and custom settings</li>
      <li style="margin-bottom: 0.5rem;">To improve and optimize our service</li>
      <li style="margin-bottom: 0.5rem;">To communicate with you about service updates</li>
      <li style="margin-bottom: 0.5rem;">To provide customer support</li>
      <li style="margin-bottom: 0.5rem;">To detect and prevent fraud or abuse</li>
    </ul>
  `
};
'''
      }
    },
    // Section 3: Data Storage and Security
    {
      id: "privacy_section_3",
      L: "Attr",
      P: {
        displayOrder: 6,
        componentName: "Html",
