return {
  as: "div",
  innerHTML: `
    <p style="line-height: 1.6; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">You have the following rights regarding your personal data:</p>
    <ul style="line-height: 1.6; color: ${args.theme.var.color.text}; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;"><strong>Access:</strong> Request access to your personal data</li>
      <li style="margin-bottom: 0.5rem;"><strong>Correction:</strong> Request correction of inaccurate data</li>
      <li style="margin-bottom: 0.5rem;"><strong>Deletion:</strong> Request deletion of your account and data</li>
      <li style="margin-bottom: 0.5rem;"><strong>Export:</strong> Request a copy of your data in a portable format</li>
      <li style="margin-bottom: 0.5rem;"><strong>Revocation:</strong> Revoke YouTube access permissions at any time</li>
      <li style="margin-bottom: 0.5rem;"><strong>Objection:</strong> Object to processing of your personal data</li>
    </ul>
  `
};
'''
      }
