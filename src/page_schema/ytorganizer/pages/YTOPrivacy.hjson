{
  vertexes: [
    {
      id: "yto_privacy_page",
      L: "Page",
      P: {
        key: "YTOPrivacy",
        url: "/privacy",
        title: "Privacy Policy - YouTube Organizer",
        description: "Privacy policy for YouTube Organizer",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "privacy_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    // Header Section
    {
      id: "privacy_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.background_dark_100};
  border-bottom: 1px solid ${args.theme.var.color.border};
  padding: 1rem 2rem;
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(10px);
}

@media (max-width: 768px) {
  ._id {
    padding: 0.75rem 1rem;
  }
}`;
'''
      }
    },
    {
      id: "privacy_header_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}`;
'''
      }
    },
    {
      id: "privacy_logo_wrapper",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  onClick: () => args.navigate('/')
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  cursor: pointer;
}`;
'''
      }
    },
    {
      id: "privacy_logo_image",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "img",
  src: "/api/file/downloadCompanySquareLogo",
  alt: "Ysaar Logo"
};
''',
        css: '''
return `._id {
  width: 40px;
  height: 40px;
  object-fit: contain;
}

@media (max-width: 768px) {
  ._id {
    width: 32px;
    height: 32px;
  }
}`;
'''
      }
    },
    {
      id: "privacy_logo_text",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: "Ysaar"
};
''',
        css: '''
return `._id {
  font-size: 1.5rem;
  font-weight: 700;
  margin: 0;
  color: ${args.theme.var.color.primary};
}

@media (max-width: 768px) {
  ._id {
    font-size: 1.25rem;
  }
}`;
'''
      }
    },
    {
      id: "privacy_header_nav",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "nav"
};
''',
        css: '''
return `._id {
  display: flex;
  gap: 2rem;
  align-items: center;
}

@media (max-width: 768px) {
  ._id {
    gap: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "privacy_nav_home",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "a",
  text: "Home",
  onClick: (e) => {
    e.preventDefault();
    args.navigate('/');
  }
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text};
  text-decoration: none;
  font-weight: 500;
  transition: color 0.2s ease;
  cursor: pointer;
}

._id:hover {
  color: ${args.theme.var.color.primary};
}

@media (max-width: 768px) {
  ._id {
    font-size: 0.875rem;
  }
}`;
'''
      }
    },
    {
      id: "privacy_nav_signin",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "a",
  text: "Sign In",
  onClick: (e) => {
    e.preventDefault();
    args.navigate('/auth/signin');
  }
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.text};
  text-decoration: none;
  font-weight: 500;
  transition: color 0.2s ease;
  cursor: pointer;
}

._id:hover {
  color: ${args.theme.var.color.primary};
}

@media (max-width: 768px) {
  ._id {
    font-size: 0.875rem;
  }
}`;
'''
      }
    },
    {
      id: "privacy_nav_signup",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "button",
  text: "Get Started",
  onClick: () => args.navigate('/auth/signup')
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  border: none;
  padding: 0.625rem 1.25rem;
  border-radius: 0.5rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

._id:hover {
  background: ${args.theme.var.color.primary_dark_200};
  transform: translateY(-2px);
}

@media (max-width: 768px) {
  ._id {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }
}`;
'''
      }
    },
    // Main Content Section
    {
      id: "privacy_main",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "main"
};
''',
        css: '''
return `._id {
  flex: 1;
  max-width: 900px;
  margin: 0 auto;
  padding: 3rem 1.5rem;
  width: 100%;

  @media (max-width: 768px) {
    padding: 2rem 1rem;
  }
}`;
'''
      }
    },
    // Title
    {
      id: "privacy_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: "Privacy Policy"
};
''',
        css: '''
return `._id {
  font-size: 2.5rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  color: ${args.theme.var.color.text};

  @media (max-width: 768px) {
    font-size: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "privacy_updated",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const date = new Date().toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
return {
  as: "p",
  text: `Last updated: ${date}`
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.muted};
  margin-bottom: 2rem;
  font-size: 0.875rem;
}`;
'''
      }
    },
    // Introduction
    {
      id: "privacy_intro",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  margin-bottom: 2.5rem;
}`;
'''
      }
    },
    {
      id: "privacy_intro_text",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "YouTube Organizer (\"we\", \"our\", or \"us\") is committed to protecting your privacy. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you use our service."
};
''',
        css: '''
return `._id {
  line-height: 1.6;
  color: ${args.theme.var.color.text};
  margin-bottom: 1rem;
}`;
'''
      }
    },
    // Section 1: Information We Collect
    {
      id: "privacy_section_1",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  margin-bottom: 2.5rem;
}`;
'''
      }
    },
    {
      id: "privacy_section_1_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h2",
  text: "1. Information We Collect"
};
''',
        css: '''
return `._id {
  font-size: 1.5rem;
  font-weight: 600;
  margin-bottom: 1rem;
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "privacy_section_1_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  innerHTML: `
    <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">1.1 YouTube Data</h3>
    <p style="line-height: 1.6; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">When you connect your YouTube account, we access and store:</p>
    <ul style="line-height: 1.6; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li>Your YouTube channel information (name, description, subscriber count)</li>
      <li>Your YouTube playlists (titles, descriptions, video counts)</li>
      <li>Your YouTube videos (titles, descriptions, thumbnails, metadata)</li>
      <li>Your YouTube watch history and liked videos (if you choose to sync them)</li>
    </ul>

    <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">1.2 Account Information</h3>
    <p style="line-height: 1.6; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">We collect information you provide when creating an account:</p>
    <ul style="line-height: 1.6; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li>Email address</li>
      <li>Username</li>
      <li>Profile information</li>
      <li>Password (encrypted and securely stored)</li>
    </ul>

    <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">1.3 User-Generated Content</h3>
    <p style="line-height: 1.6; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">We store content you create within our service:</p>
    <ul style="line-height: 1.6; color: ${args.theme.var.color.text}; padding-left: 1.5rem;">
      <li>Personal notes on videos</li>
      <li>Custom names and tags for channels and playlists</li>
      <li>Favorite selections and organization preferences</li>
    </ul>
  `
};
'''
      }
    },
    // Section 2: How We Use Your Information
    {
      id: "privacy_section_2",
      L: "Attr",
      P: {
        displayOrder: 5,
