        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  innerHTML: `
    <p style="line-height: 1.6; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">We implement industry-standard security measures to protect your data:</p>
    <ul style="line-height: 1.6; color: ${args.theme.var.color.text}; margin-bottom: 1rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">Encrypted data transmission using HTTPS/SSL</li>
      <li style="margin-bottom: 0.5rem;">Secure password storage using encryption</li>
      <li style="margin-bottom: 0.5rem;">Regular security audits and updates</li>
      <li style="margin-bottom: 0.5rem;">Restricted access to personal data</li>
      <li style="margin-bottom: 0.5rem;">Secure database infrastructure with Neo4j</li>
    </ul>
    <p style="line-height: 1.6; color: ${args.theme.var.color.text};">Your data is stored securely and is only accessible to you and authorized system processes.</p>
  `
};
'''
      }
    },
    // Section 4: Third-Party Services
    {
