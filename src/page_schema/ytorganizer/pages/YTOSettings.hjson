        props: '''
const isLoading = args.fns.isLoadingStatus?.();
const status = args.fns.youtubeStatus?.();
const isConnected = status?.connected;

let statusText = "Not Connected";
let statusIcon = "❌";

if (isLoading) {
  statusText = "Checking connection...";
  statusIcon = "⏳";
} else if (isConnected) {
  statusText = "Connected";
  statusIcon = "✅";
}

return {
  as: "div",
  text: `${statusIcon} ${statusText}`
};
