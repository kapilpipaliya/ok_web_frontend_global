    },
    {
      id: "youtube_api_usage_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h3",
  text: "Daily API Quota Usage"
};
''',
        css: '''
const status = args.fns.youtubeStatus?.();
const isConnected = status?.connected;

return `._id {
  font-size: 1rem;
  font-weight: 600;
  color: ${isConnected ? args.theme.var.color.success_light_50_text : args.theme.var.color.muted};
  margin: 0 0 0.75rem 0;
}`;
'''
      }
    },
    {
      id: "youtube_api_usage_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const apiUsage = args.fns.apiUsage?.();
const isLoading = args.fns.isLoadingUsage?.();

if (isLoading || !apiUsage) {
  return {
    as: "p",
    text: "Loading usage statistics..."
  };
}

const youtubeStatus = args.fns.youtubeStatus?.();
const isConnected = youtubeStatus?.connected;
const status = apiUsage.status || 'good';
const today = apiUsage.today || {};
const quotaPercent = today.quotaPercentUsed || 0;

// Base text color based on connection status
const baseTextColor = isConnected ? "${args.theme.var.color.success_light_50_text}" : "${args.theme.var.color.muted}";

// Determine color based on status
let statusTextColor = "${args.theme.var.color.success_text}";
let statusBarColor = "${args.theme.var.color.success}";

if (status === 'critical') {
  statusTextColor = "${args.theme.var.color.error_text}";
  statusBarColor = "${args.theme.var.color.error}";
} else if (status === 'warning') {
  statusTextColor = "${args.theme.var.color.warning_text}";
  statusBarColor = "${args.theme.var.color.warning}";
}

return {
  as: "div",
  innerHTML: `
    <div style="margin-bottom: 0.75rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
        <span style="font-size: 0.875rem; font-weight: 500; color: ${baseTextColor};">
          ${today.totalCost || 0} / ${today.dailyLimit || 10000} units used
        </span>
        <span style="font-size: 0.875rem; font-weight: 600; color: ${statusTextColor};">
          ${quotaPercent}%
        </span>
      </div>
      <div style="width: 100%; height: 8px; background: ${args.theme.var.color.background_light_200}; border-radius: 4px; overflow: hidden;">
        <div style="width: ${Math.min(quotaPercent, 100)}%; height: 100%; background: ${statusBarColor}; transition: width 0.3s ease;"></div>
      </div>
    </div>
    <div style="font-size: 0.75rem; color: ${baseTextColor}; margin-top: 0.5rem;">
      <strong>${today.callCount || 0}</strong> API calls today •
      <strong>${today.remainingQuota || 10000}</strong> units remaining
    </div>
  `
};
'''
      }
    },
