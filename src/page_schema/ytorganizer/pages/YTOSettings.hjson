const messageState = args.fns.messageState;
const isSuccess = messageState?.type === 'success';

let iconColor = args.theme.var.color.success_light_50_text;
let hoverBg = args.theme.var.color.success_light_100;

if (!isSuccess) {
  iconColor = args.theme.var.color.error_light_50_text;
  hoverBg = args.theme.var.color.error_light_100;
}

return `._id {
  background: transparent;
  border: none;
  color: ${iconColor};
  cursor: pointer;
  padding: 0.25rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0.375rem;
  transition: all 0.2s ease;
  flex-shrink: 0;
  font-family: inherit;

  &:hover {
    background: ${hoverBg};
  }

  &:active {
    transform: scale(0.95);
  }
}`;
'''
