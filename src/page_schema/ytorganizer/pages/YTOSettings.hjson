      }
    },
    {
      id: "yto_settings_clear_data_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const isClearing = args.fns.isClearing();

return {
  as: "button",
  type: "button",
  disabled: isClearing,
  onClick: args.fns.clearAllData
};
''',
        css: '''
const isClearing = args.fns.isClearing();

return `._id {
  background: ${isClearing ? args.theme.var.color.error_light_200 : args.theme.var.color.error};
  color: ${isClearing ? args.theme.var.color.error : args.theme.var.color.error_text};
  border: none;
  border-radius: 0.5rem;
  padding: 0.875rem 1.5rem;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: ${isClearing ? 'not-allowed' : 'pointer'};
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  opacity: ${isClearing ? '0.6' : '1'};

  &:hover:not(:disabled) {
    background: ${args.theme.var.color.error_dark_200};
    transform: translateY(-1px);
  }

  &:disabled {
    cursor: not-allowed;
  }
}`;
'''
      }
    },
    {
      id: "yto_settings_clear_data_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const isClearing = args.fns.isClearing();

return {
  as: "icon",
  icon: isClearing ? "carbon:load" : "carbon:delete",
  width: 18,
  height: 18
};
''',
        css: '''
const isClearing = args.fns.isClearing();

return `._id {
  ${isClearing ? 'animation: spin 1s linear infinite;' : ''}
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}`;
'''
      }
    },
    {
      id: "yto_settings_clear_data_text",
