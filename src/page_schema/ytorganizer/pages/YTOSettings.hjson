    {
      id: "clear_data_button",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "YTOButton",
        props: '''
return {
  text: "Clear All Data",
  variant: "danger",
  onClick: async () => {
    const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
    if (!rbConfirm) {
      args.fns.showMessage('error', "Confirmation dialog not available");
      return;
    }

    const confirmed = await rbConfirm({
      title: "Clear All Data",
      message: "Are you sure you want to delete all your YouTube Organizer data including channels, playlists, videos, notes, and favorites? This action cannot be undone!",
      confirmText: "Delete All Data",
      cancelText: "Cancel",
      variant: "danger"
    });

    if (confirmed) {
      try {
        const result = await args.fns.executeYTOFunction("clearAllUserData", {});

        if (result?.result?.success) {
          args.fns.showMessage('success', result.result.message || "All data cleared successfully");
        } else {
          args.fns.showMessage('error', result?.result?.message || "Failed to clear data");
        }
      } catch (error) {
        console.error("Error clearing data:", error);
        args.fns.showMessage('error', "An error occurred while clearing data");
      }
    }
  }
};
'''
      }
    },
    {
      id: "data_separator",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  height: 1px;
  background: ${args.theme.var.color.error_light_300};
  margin: 1.5rem 0;
}`;
'''
      }
    },
    {
      id: "delete_account_warning",
      L: "Attr",
      P: {
        displayOrder: 5,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "Delete your entire account and all associated data permanently. This will also clear all your YouTube Organizer data and cannot be undone."
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.error_light_50_text};
  margin: 0 0 1.5rem 0;
  line-height: 1.5;
  font-weight: 600;
}`;
'''
      }
    },
    {
      id: "delete_account_button",
      L: "Attr",
      P: {
        displayOrder: 6,
        componentName: "YTOButton",
        props: '''
return {
  text: "Delete Account",
  variant: "danger",
  onClick: async () => {
    const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
    if (!rbConfirm) {
      args.fns.showMessage('error', "Confirmation dialog not available");
      return;
    }

    const confirmed = await rbConfirm({
      title: "Delete Account",
      message: "⚠️ WARNING: This will permanently delete your account and ALL your data including channels, playlists, videos, notes, and favorites. This action CANNOT be undone! Are you absolutely sure?",
      confirmText: "Delete My Account",
      cancelText: "Cancel",
      variant: "danger"
    });

    if (confirmed) {
      // Double confirmation for account deletion
      const doubleConfirmed = await rbConfirm({
        title: "Final Confirmation",
        message: "This is your last chance! Your account will be permanently deleted. Are you absolutely sure you want to delete your account?",
        confirmText: "Yes, Delete My Account",
        cancelText: "Cancel",
        variant: "danger"
      });

      if (doubleConfirmed) {
        try {
          const result = await args.fns.executeYTOFunction("deleteAccount", {});

          if (result?.result?.success) {
            args.fns.showMessage('success', result.result.message || "Account deleted successfully");

            // Logout and redirect to home after 2 seconds
            setTimeout(() => {
              args.navigate("/auth/logout");
            }, 2000);
          } else {
            args.fns.showMessage('error', result?.result?.message || "Failed to delete account");
          }
        } catch (error) {
          console.error("Error deleting account:", error);
          args.fns.showMessage('error', "An error occurred while deleting account");
        }
      }
    }
  }
};
'''
      }
    },
    {
      id: "feedback_modal",
      L: "Attr",
      P: {
        displayOrder: 7,
        componentName: "YTOFeedbackModal",
        props: '''
return {
  isOpen: args.fns.isFeedbackModalOpen,
  onClose: args.fns.closeFeedbackModal,
  onSubmit: args.fns.submitFeedback
};
'''
      }
    }
  ],
