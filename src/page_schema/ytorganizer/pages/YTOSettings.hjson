    {
      id: "youtube_detail_last_sync_value",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const status = args.fns.youtubeStatus?.();
const lastRefreshed = status?.lastRefreshed;

let displayText = "Never";
if (lastRefreshed) {
  try {
    const date = new Date(lastRefreshed);
    const now = new Date();
    const diff = now - date;
    const seconds = Math.floor(diff / 1000);
    const minutes = Math.floor(seconds / 60);
    const hours = Math.floor(minutes / 60);
    const days = Math.floor(hours / 24);

    if (days > 0) {
      displayText = `${days} day${days > 1 ? 's' : ''} ago`;
    } else if (hours > 0) {
      displayText = `${hours} hour${hours > 1 ? 's' : ''} ago`;
    } else if (minutes > 0) {
      displayText = `${minutes} minute${minutes > 1 ? 's' : ''} ago`;
    } else {
      displayText = "Just now";
    }
  } catch (e) {
    displayText = "Unknown";
  }
}

return {
  as: "div",
  text: displayText
};
''',
        css: '''
const status = args.fns.youtubeStatus?.();
const isConnected = status?.connected;

return `._id {
  font-size: 0.875rem;
  font-weight: 500;
  color: ${isConnected ? args.theme.var.color.success_light_50_text : args.theme.var.color.muted};
}`;
'''
