{
  vertexes: [
    {
      id: "yto_settings_page",
      L: "Page",
      P: {
        key: "YTOSettings",
        url: "/settings",
        title: "Settings - YouTube Organizer",
        description: "Manage your YouTube Organizer preferences and configuration",
        props: '''
return {
  isNoPermissionCheck: true,
  enabled: true
};
'''
      }
    },
    {
      id: "yto_settings_layout",
      L: "PageLayout",
      P: {
        componentName: "YTOLayout",
        displayOrder: 1
      }
    },
    {
      id: "yto_settings_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        fns: '''
// Settings state
const [autoRefresh, setAutoRefresh] = args.createSignal(true);
const [refreshInterval, setRefreshInterval] = args.createSignal(30);
const [defaultView, setDefaultView] = args.createSignal("grid");
const [showThumbnails, setShowThumbnails] = args.createSignal(true);
const [notifications, setNotifications] = args.createSignal(true);
const [darkMode, setDarkMode] = args.createSignal(false);
const [isClearing, setIsClearing] = args.createSignal(false);

// Save settings
const saveSettings = () => {
  const settings = {
    autoRefresh: autoRefresh(),
    refreshInterval: refreshInterval(),
    defaultView: defaultView(),
    showThumbnails: showThumbnails(),
    notifications: notifications(),
    darkMode: darkMode()
  };

  // Simulate saving settings
  console.log("Saving settings:", settings);
  args.showSuccessToast("Settings saved successfully!");
};

// Reset settings
const resetSettings = () => {
  setAutoRefresh(true);
  setRefreshInterval(30);
  setDefaultView("grid");
  setShowThumbnails(true);
  setNotifications(true);
  setDarkMode(false);
  args.showInfoToast("Settings reset to defaults");
};

// Clear all user data
const clearAllData = async () => {
  const confirmed = confirm(
    "⚠️ WARNING: This will permanently delete all your personal YouTube Organizer data including:\n\n" +
    "• All saved channels and their settings\n" +
    "• All saved playlists and their settings\n" +
    "• All video watch history and notes\n" +
    "• All personal preferences and configurations\n\n" +
    "This action CANNOT be undone.\n\n" +
    "Are you absolutely sure you want to continue?"
  );

  if (!confirmed) {
    return;
  }

  try {
    setIsClearing(true);

    const result = await args.executeNamedServerFunction({
      functionName: "clearAllUserData",
      contextData: {}
    });

    if (result.error) {
      const errorMessage = result.error;
      args.showErrorToast(errorMessage);
    } else if (result.result && result.result.success) {
      const data = result.result.data;
      args.showSuccessToast(
        `Successfully cleared ${data.totalItemsDeleted} items: ` +
        `${data.channelSettingsDeleted} channels, ` +
        `${data.playlistSettingsDeleted} playlists, ` +
        `${data.videoSettingsDeleted} videos`
      );

      // Optionally redirect to home page after clearing
      setTimeout(() => {
        args.navigate('/');
      }, 2000);
    } else {
      const errorMessage = result.result?.message || result.message || "Failed to clear data";
      args.showErrorToast(errorMessage);
    }
  } catch (err) {
    console.error("Error clearing data:", err);
    args.showErrorToast("Failed to clear data. Please try again.");
  } finally {
    setIsClearing(false);
  }
};

return {
  autoRefresh,
  setAutoRefresh,
  refreshInterval,
  setRefreshInterval,
  defaultView,
  setDefaultView,
  showThumbnails,
  setShowThumbnails,
  notifications,
  setNotifications,
  darkMode,
  setDarkMode,
  isClearing,
  saveSettings,
  resetSettings,
  clearAllData
};
'''
      }
    },
    {
      id: "yto_settings_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
