    {
      id: "clear_data_button",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "YTOButton",
        props: '''
return {
  text: "Clear All Data",
  variant: "danger",
  onClick: async () => {
    const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
    if (!rbConfirm) {
      args.showErrorToast("Confirmation dialog not available");
      return;
    }

    const confirmed = await rbConfirm({
      title: "Clear All Data",
      message: "Are you sure you want to delete all your YouTube Organizer data including channels, playlists, videos, notes, and favorites? This action cannot be undone!",
      confirmText: "Delete All Data",
      cancelText: "Cancel",
      variant: "danger"
    });

    if (confirmed) {
      try {
        const result = await args.executeNamedServerFunction({
          functionName: "clearAllUserData",
          contextData: {}
        });

        if (result?.result?.success) {
          args.showSuccessToast(result.result.message || "All data cleared successfully");
        } else {
          args.showErrorToast(result?.result?.message || "Failed to clear data");
        }
      } catch (error) {
        console.error("Error clearing data:", error);
        args.showErrorToast("An error occurred while clearing data");
      }
    }
  }
};
'''
      }
    },
    {
