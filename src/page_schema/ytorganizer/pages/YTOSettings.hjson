{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "YTOSettings",
        url: "/settings",
        signinRequired: true,
        fns: '''
// Message state for displaying success/error messages in UI
const [messageState, setMessageState] = args.createStore({
  type: null, // 'success' or 'error'
  text: '',
  visible: false
});

const showMessage = (type, text) => {
  setMessageState({ type, text, visible: true });
  // Auto-hide after 15 seconds
  setTimeout(() => {
    setMessageState('visible', false);
  }, 15000);
};

const hideMessage = () => {
  setMessageState('visible', false);
};

// Feedback modal state
const [isFeedbackModalOpen, setIsFeedbackModalOpen] = args.createSignal(false);

const openFeedbackModal = () => {
  setIsFeedbackModalOpen(true);
};

const closeFeedbackModal = () => {
  setIsFeedbackModalOpen(false);
};

const submitFeedback = async (data) => {
  try {
    const result = await args.fns.executeYTOFunction("saveFeedback", data);

    if (result?.result?.success) {
      showMessage('success', result.result.message);
      return result.result;
    } else {
      showMessage('error', result?.result?.message || "Failed to submit feedback");
      return result?.result;
    }
  } catch (error) {
    console.error("Error submitting feedback:", error);
    showMessage('error', "An error occurred while submitting feedback");
    return { success: false };
  }
};

// YouTube OAuth connection state
const [youtubeStatus, setYoutubeStatus] = args.createSignal(null);
const [isLoadingStatus, setIsLoadingStatus] = args.createSignal(true);
const [isConnecting, setIsConnecting] = args.createSignal(false);
const [isDisconnecting, setIsDisconnecting] = args.createSignal(false);

// Load YouTube connection status
const loadYoutubeStatus = async () => {
  setIsLoadingStatus(true);
  try {
    const response = await fetch("/api/auth/youtube/status");
    const result = await response.json();

    if (result.success) {
      setYoutubeStatus(result.data);
    } else {
      setYoutubeStatus(null);
    }
  } catch (error) {
    console.error("Error loading YouTube status:", error);
    setYoutubeStatus(null);
  } finally {
    setIsLoadingStatus(false);
  }
};

// Connect YouTube account
const connectYouTube = async () => {
  setIsConnecting(true);
  try {
    window.location.href = "/api/auth/youtube/connect";
  } catch (error) {
    console.error("Error connecting YouTube:", error);
    showMessage('error', "Failed to connect YouTube account");
    setIsConnecting(false);
  }
};

// Disconnect YouTube account
const disconnectYouTube = async () => {
  const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
  if (!rbConfirm) {
    showMessage('error', "Confirmation dialog not available");
    return;
  }

  const confirmed = await rbConfirm({
    title: "Disconnect YouTube Account",
    message: "Are you sure you want to disconnect your YouTube account? You won't be able to add channels or playlists until you reconnect.",
    confirmText: "Disconnect",
    cancelText: "Cancel",
    variant: "danger"
  });

  if (!confirmed) return;

  setIsDisconnecting(true);
  try {
    const response = await fetch("/api/auth/youtube/disconnect", {
      method: "POST"
    });
    const result = await response.json();

    if (result.success) {
      showMessage('success', result.message || "YouTube account disconnected successfully");
      await loadYoutubeStatus();
    } else {
      showMessage('error', result.error || "Failed to disconnect YouTube account");
    }
  } catch (error) {
    console.error("Error disconnecting YouTube:", error);
    showMessage('error', "An error occurred while disconnecting");
  } finally {
    setIsDisconnecting(false);
  }
};

// API Usage tracking state
const [apiUsage, setApiUsage] = args.createSignal(null);
const [isLoadingUsage, setIsLoadingUsage] = args.createSignal(false);

// Load API usage statistics
const loadAPIUsage = async () => {
  const status = youtubeStatus();
  if (!status?.connected) return; // Only load if connected

  setIsLoadingUsage(true);
  try {
    const response = await fetch("/api/youtube/usage");
    const result = await response.json();

    if (result.success) {
      setApiUsage(result.data);
    }
  } catch (error) {
    console.error("Error loading API usage:", error);
  } finally {
    setIsLoadingUsage(false);
  }
};

// Initialize YouTube status on mount
const initializeYouTubeStatus = () => {
  loadYoutubeStatus();
};

// Handle OAuth callback messages from URL params
const handleOAuthCallback = () => {
  const urlParams = new URLSearchParams(window.location.search);
  const success = urlParams.get('success');
  const error = urlParams.get('error');

  if (success) {
    showMessage('success', decodeURIComponent(success));
    // Remove query params from URL
    window.history.replaceState({}, '', window.location.pathname);
    // Reload status
    loadYoutubeStatus();
  } else if (error) {
    showMessage('error', decodeURIComponent(error));
    // Remove query params from URL
    window.history.replaceState({}, '', window.location.pathname);
  }
};

// Load API usage when YouTube is connected
args.createEffect(() => {
  const status = youtubeStatus();
  if (status?.connected) {
    loadAPIUsage();
  }
});

// Queue Management state
const [isPausing, setIsPausing] = args.createSignal(false);
const [isResuming, setIsResuming] = args.createSignal(false);

// Pause all channels and playlists
const pauseAllChannels = async () => {
  setIsPausing(true);
  try {
    const result = await args.fns.executeYTOFunction("pauseAllChannels", {});

    if (result?.result?.success) {
      showMessage('success', result.result.message || "All processing paused successfully");
    } else {
      showMessage('error', result?.result?.message || "Failed to pause processing");
    }
  } catch (error) {
    console.error("Error pausing channels:", error);
    showMessage('error', "An error occurred while pausing");
  } finally {
    setIsPausing(false);
  }
};

// Resume all pending channels and playlists
const resumePendingChannels = async () => {
  setIsResuming(true);
  try {
    const result = await args.fns.executeYTOFunction("resumePendingChannels", {});

    if (result?.result?.success) {
      showMessage('success', result.result.message || "All items resumed successfully");
    } else {
      showMessage('error', result?.result?.message || "Failed to resume processing");
    }
  } catch (error) {
    console.error("Error resuming channels:", error);
    showMessage('error', "An error occurred while resuming");
  } finally {
    setIsResuming(false);
  }
};

return {
  enabled: true,
  messageState,
  showMessage,
  hideMessage,
  isFeedbackModalOpen,
  openFeedbackModal,
  closeFeedbackModal,
  submitFeedback,
  youtubeStatus,
  isLoadingStatus,
  isConnecting,
  isDisconnecting,
  connectYouTube,
  disconnectYouTube,
  loadYoutubeStatus,
  apiUsage,
  isLoadingUsage,
  loadAPIUsage,
  initializeYouTubeStatus,
  handleOAuthCallback,
  isPausing,
  isResuming,
  pauseAllChannels,
  resumePendingChannels
};
''',
        props: '''
return {
  isNoPermissionCheck: true,
  onMount: () => {
    // Initialize YouTube connection status
    args.fns.initializeYouTubeStatus();

    // Handle OAuth callback messages
    args.fns.handleOAuthCallback();
  }
};
'''
      }
