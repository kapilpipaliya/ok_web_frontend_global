return {
  as: "p",
  text: dashboardError || "An unexpected error occurred"
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.error_dark_200};
  margin: 0 0 1.5rem 0;
  max-width: 400px;
}`;
'''
      }
    },
    {
      id: "error_retry_button",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "YTOButton",
        props: '''
return {
  text: "Try Again",
  variant: "danger",
