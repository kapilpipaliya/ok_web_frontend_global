{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "YTOHome",
        url: "/yto",
        siginRequired: true,
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
        componentName: "YTOLayout",
        displayOrder: 1
      }
    },
    {
      id: "data_context",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
const [isDashboardLoading, setIsDashboardLoading] = args.createSignal(true);
const [dashboardError, setDashboardError] = args.createSignal(null);
const [channelsCount, setChannelsCount] = args.createSignal(0);
const [playlistsCount, setPlaylistsCount] = args.createSignal(0);

// Function to fetch dashboard data
const fetchDashboardData = async () => {
  try {
    setIsDashboardLoading(true);
    setDashboardError(null);

    // Fetch channels
    const channelsResult = await args.fns.executeYTOFunction('getUserChannels', {});

    // Fetch playlists
    const playlistsResult = await args.fns.executeYTOFunction('getUserPlaylists', {});

    if (channelsResult.error) {
      throw new Error(channelsResult.error);
    }
    if (playlistsResult.error) {
      throw new Error(playlistsResult.error);
    }

    const channels = channelsResult.result;
    const playlists = playlistsResult.result;

    if (channels && channels.success) {
      setChannelsCount(channels.data.totalCount || 0);
    }

    if (playlists && playlists.success) {
      setPlaylistsCount(playlists.data.totalCount || 0);
    }

  } catch (err) {
    console.error('Dashboard data fetch error:', err);
    setDashboardError(err.message || 'Failed to load dashboard data');
  } finally {
    setIsDashboardLoading(false);
  }
};

// Fetch data on mount
const onMount = () => {
  fetchDashboardData();
};

return {
  isDashboardLoading,
  dashboardError,
  channelsCount,
  playlistsCount,
  fetchDashboardData,
  onMount
};
''',
        props: '''
return {
  as: "div",
  onMount: args.fns.onMount
};
''',
        css: '''
return `._id {
  padding: 1.5rem;
  max-width: 1200px;
  margin: 0 auto;
}

@media (max-width: 768px) {
  ._id {
    padding: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "page_content",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  min-height: 200px;
}`;
'''
      }
    },
    {
      id: "loading_state",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: () => !args.fns.isDashboardLoading?.()
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 3rem 2rem;
  text-align: center;
}`;
'''
      }
    },
    {
      id: "loading_spinner",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "YTOLoadingSpinner",
        props: '''
return {
  size: "medium",
  color: "primary",
  text: "Loading dashboard..."
};
'''
      }
    },
    {
      id: "error_state",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: () => !args.fns.dashboardError?.()
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 3rem 2rem;
  text-align: center;
  background: ${args.theme.var.color.error_light_100};
  border: 1px solid ${args.theme.var.color.error_light_200};
  border-radius: 0.75rem;
  margin: 1.5rem 0;
}`;
'''
      }
    },
    {
      id: "error_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "carbon:warning",
  width: 48,
  height: 48
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.error};
  margin-bottom: 1rem;
}`;
'''
      }
    },
    {
      id: "error_title",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "h3",
  text: "Unable to Load Dashboard"
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.error};
  font-size: 1.25rem;
  font-weight: 600;
  margin: 0 0 0.5rem 0;
}`;
'''
      }
    },
    {
      id: "error_message",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
