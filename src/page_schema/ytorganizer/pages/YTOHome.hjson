{
  vertexes: [
    {
      id: "yto_home_page",
      L: "Page",
      P: {
        key: "YTOHome",
        url: "/",
        title: "YouTube Organizer",
        description: "Dashboard overview of your YouTube channels and playlists"
      }
    },
    {
      id: "yto_home_layout",
      L: "PageLayout",
      P: {
        componentName: "YTOLayout",
        displayOrder: 1
      }
    },
    {
      id: "yto_home_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  /* Layout handles min-height and padding-bottom */
}`;
'''
      }
    },
    {
      id: "yto_home_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  padding: 1.5rem;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  position: sticky;
  top: 0;
  z-index: 10;
  
  @media (max-width: 768px) {
    padding: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_home_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: "YouTube Organizer"
};
''',
        css: '''
return `._id {
  font-size: 2rem;
  font-weight: 700;
  margin: 0;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  
  @media (max-width: 768px) {
    font-size: 1.5rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_home_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "icon",
  icon: "ph:youtube-logo-fill",
  width: 32,
  height: 32
};
''',
        css: '''
return `._id {
  display: inline-block;
  vertical-align: middle;
}`;
'''
      }
    },
    {
      id: "yto_home_container",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "main"
};
''',
        css: '''
return `._id {
  padding: 1.5rem;
  max-width: 1400px;
  margin: 0 auto;
  
  @media (max-width: 768px) {
    padding: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_home_welcome",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.surface};
  border-radius: 1rem;
  padding: 2rem;
  margin-bottom: 2rem;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  
  @media (max-width: 768px) {
    padding: 1.5rem;
    border-radius: 0.75rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_home_welcome_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h2",
  text: "Welcome to YouTube Organizer"
};
''',
        css: '''
return `._id {
  font-size: 1.75rem;
  font-weight: 600;
  margin: 0 0 1rem 0;
  color: ${args.theme.var.color.text};
  
  @media (max-width: 768px) {
    font-size: 1.5rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_home_welcome_text",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "p",
