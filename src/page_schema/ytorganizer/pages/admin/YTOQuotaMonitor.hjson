{
  vertexes: [
    {
      id: "page_root"
      L: "Page"
      P: {
        key: "YTOQuotaMonitor"
        url: "/yto/admin/quota-monitor"
        title: "YouTube API Quota Monitor"
        description: "Monitor shared YouTube API quota usage across all users and ownerships"
        signinRequired: true,
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "page_layout"
      L: "PageLayout"
      P: {
        componentName: "YTOLayout"
        displayOrder: 1
        description: "YTO layout with navigation"
      }
    },
    {
      id: "admin_layout"
      L: "PageLayout"
      P: {
        componentName: "YTOAdminLayout"
        displayOrder: 2
        description: "Admin layout wrapper"
      }
    },
    {
      id: "main_container"
      L: "Attr"
      P: {
        displayOrder: 1
        componentName: "Html"
        fns: '''
const [quotaData, setQuotaData] = args.createSignal(null);
const [loading, setLoading] = args.createSignal(true);

// Auto-refresh interval state
let refreshInterval = null;

const fetchQuotaData = async () => {
  setLoading(true);
  try {
    const result = await args.fns.executeYTOFunction("getSharedQuotaStatus", {});

    if (result.error) {
      args.showErrorToast(result.error);
      return;
    }

    const serverResult = result.result;
    if (serverResult?.data) {
      setQuotaData(serverResult.data);
    }
  } catch (error) {
    console.error('Error fetching quota data:', error);
    args.showErrorToast('Failed to load quota data');
  } finally {
    setLoading(false);
  }
};

const startAutoRefresh = () => {
  // Clear existing interval if any
  if (refreshInterval) {
    clearInterval(refreshInterval);
  }
  // Start auto-refresh every 30 seconds
  refreshInterval = setInterval(fetchQuotaData, 30000);
};

const stopAutoRefresh = () => {
  if (refreshInterval) {
    clearInterval(refreshInterval);
    refreshInterval = null;
  }
};

return {
  quotaData,
  loading,
  fetchQuotaData,
  startAutoRefresh,
  stopAutoRefresh
};
'''
        props: '''
const fetchQuotaData = args.fns.fetchQuotaData;
const startAutoRefresh = args.fns.startAutoRefresh;
const stopAutoRefresh = args.fns.stopAutoRefresh;

return {
  as: "div",
  onMount: () => {
    fetchQuotaData();
    startAutoRefresh();
  },
  onCleanup: () => {
    stopAutoRefresh();
  }
};
'''
        css: '''
return `._id {
  max-width: 1400px;
  margin: 0 auto;
  padding: 1.5rem;

  @media (max-width: 768px) {
    padding: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "page_title"
      L: "Attr"
      P: {
        displayOrder: 1
        componentName: "Html"
        props: '''
return {
  as: "h1",
  text: "YouTube API Quota Monitor"
};
'''
        css: '''
return `._id {
  font-size: 2.5rem;
  font-weight: 700;
  color: ${args.theme.var.color.text};
  margin-bottom: 1rem;

  @media (max-width: 768px) {
    font-size: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "page_subtitle"
      L: "Attr"
      P: {
        displayOrder: 2
        componentName: "Html"
        props: '''
return {
  as: "p",
  text: "Shared quota across all users: 10,000 units per day (resets at midnight UTC)"
};
'''
        css: '''
return `._id {
  font-size: 1.125rem;
  color: ${args.theme.var.color.muted};
  margin: 0.5rem 0 3rem 0;
}`;
'''
      }
    },
    {
      id: "quota_cards_grid"
      L: "Attr"
      P: {
        displayOrder: 3
        componentName: "Html"
        props: '''
return {
  as: "div"
};
'''
        css: '''
return `._id {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;

  @media (max-width: 768px) {
    grid-template-columns: 1fr;
  }
}`;
'''
      }
    },
    {
      id: "quota_usage_card"
      L: "Attr"
      P: {
        displayOrder: 1
        componentName: "YTOSimpleCard"
        props: '''
const data = args.fns.quotaData?.();
const status = data?.status;

let variant = 'default';
if (status?.level === 'critical' || status?.level === 'danger') {
  variant = 'error';
} else if (status?.level === 'warning') {
  variant = 'warning';
}

return {
  title: "Quota Usage",
  icon: "carbon:analytics",
  variant: variant
};
'''
      }
    },
    {
      id: "quota_usage_wrapper"
      L: "Attr"
      P: {
        displayOrder: 1
        componentName: "Html"
        props: '''
const loading = args.fns.loading?.();

if (loading) {
  return { as: "div", text: "Loading..." };
}

return { as: "div" };
'''
      }
    },
    {
      id: "quota_usage_numbers"
      L: "Attr"
      P: {
        displayOrder: 1
        componentName: "Html"
        props: '''
const data = args.fns.quotaData?.();
const quota = data?.quota;
const status = data?.status;

if (!data || !quota) {
  return { as: "div", text: "No data available" };
}

const color = status?.level === 'critical' || status?.level === 'danger'
  ? args.theme.var.color.error
  : status?.level === 'warning'
    ? args.theme.var.color.warning
    : args.theme.var.color.success;

return {
  as: "div",
  text: `${quota.used.toLocaleString()} / ${quota.limit.toLocaleString()}`
};
'''
        css: '''
const data = args.fns.quotaData?.();
const status = data?.status;

const color = status?.level === 'critical' || status?.level === 'danger'
  ? args.theme.var.color.error
  : status?.level === 'warning'
    ? args.theme.var.color.warning
    : args.theme.var.color.success;

return `._id {
  font-size: 2.5rem;
  font-weight: 700;
  color: ${color};
  margin-bottom: 0.5rem;
}`;
'''
      }
