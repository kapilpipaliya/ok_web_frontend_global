{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "QueueManagement",
        url: "/yto/admin/queue-management",
        signinRequired: true,
        description: "Manage processing queue operations for channels and playlists",
        fns: '''
// Message state for displaying success/error messages in UI
const [messageState, setMessageState] = args.createStore({
  type: null, // 'success' or 'error'
  text: '',
  visible: false
});

const showMessage = (type, text) => {
  setMessageState({ type, text, visible: true });
  // Auto-hide after 15 seconds
  setTimeout(() => {
    setMessageState('visible', false);
  }, 15000);
};

const hideMessage = () => {
  setMessageState('visible', false);
};

// Queue Management state
const [isPausing, setIsPausing] = args.createSignal(false);
const [isResuming, setIsResuming] = args.createSignal(false);

// Pause all channels and playlists
const pauseAllChannels = async () => {
  setIsPausing(true);
  try {
    const result = await args.fns.executeYTOFunction("pauseAllChannels", {});

    if (result?.result?.success) {
      showMessage('success', result.result.message || "All processing paused successfully");
    } else {
      showMessage('error', result?.result?.message || "Failed to pause processing");
    }
  } catch (error) {
    console.error("Error pausing channels:", error);
    showMessage('error', "An error occurred while pausing");
  } finally {
    setIsPausing(false);
  }
};

// Resume all pending channels and playlists
const resumePendingChannels = async () => {
  setIsResuming(true);
  try {
    const result = await args.fns.executeYTOFunction("resumePendingChannels", {});

    if (result?.result?.success) {
      showMessage('success', result.result.message || "All items resumed successfully");
    } else {
      showMessage('error', result?.result?.message || "Failed to resume processing");
    }
  } catch (error) {
    console.error("Error resuming channels:", error);
    showMessage('error', "An error occurred while resuming");
  } finally {
    setIsResuming(false);
  }
};

return {
  enabled: true,
  messageState,
  showMessage,
  hideMessage,
  isPausing,
  isResuming,
  pauseAllChannels,
  resumePendingChannels
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
