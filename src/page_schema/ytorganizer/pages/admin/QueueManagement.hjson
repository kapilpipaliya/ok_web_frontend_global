    {
      id: "6"
      L: Attr
      P: {
        css:
          '''
const messageState = f.messageState;
const isSuccess = messageState?.type === 'success';
const isError = messageState?.type === 'error';

let bgColor = t.var.color.background_light_100;
let borderColor = t.var.color.border;
let textColor = t.var.color.text;

if (isSuccess) {
  bgColor = t.var.color.success_light_50;
  borderColor = t.var.color.success;
  textColor = t.var.color.success_light_50_text;
} else if (isError) {
  bgColor = t.var.color.error_light_50;
  borderColor = t.var.color.error;
  textColor = t.var.color.error_light_50_text;
}

return `._id {
  background: ${bgColor};
  border: 2px solid ${borderColor};
  border-radius: 0.75rem;
  padding: 1rem 1.25rem;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  animation: slideDown 0.3s ease-out;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}`;
'''
        displayOrder: 2
