const log = c.logItem;
const workerName = log?.P?.workerName || 'Unknown';

const displayName = workerName === 'processChannelQueue' ? 'Channel Queue'
  : workerName === 'processPlaylistQueue' ? 'Playlist Queue'
  : workerName;

return {
  as: "span",
  text: displayName
};
'''
