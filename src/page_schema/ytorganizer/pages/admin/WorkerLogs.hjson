        displayOrder: 3
        componentName: Html
        props:
          '''
const log = c.logItem;
const metadata = log?.P?.metadata;

if (!metadata) {
  return null;
}

let metadataObj = {};
try {
  metadataObj = JSON.parse(metadata);
} catch (e) {
  metadataObj = { raw: metadata };
}

const metadataStr = JSON.stringify(metadataObj, null, 2);

return {
  as: "details"
};
'''
