{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "WorkerLogs",
        url: "/yto/admin/worker-logs",
        signinRequired: true,
        fns: '''
// Filter and refresh state
const [filterWorker, setFilterWorker] = args.createSignal('all');
const [filterLevel, setFilterLevel] = args.createSignal('all');
const [logs, setLogs] = args.createSignal([]);
const [logsLoading, setLogsLoading] = args.createSignal(false);

// Fetch logs function
const fetchLogs = async () => {
  setLogsLoading(true);

  try {
    const result = await args.fns.executeYTOFunction('getWorkerLogs', {
      filterWorker: filterWorker(),
      filterLevel: filterLevel()
    });

    if (result?.result) {
      setLogs(result.result);
    } else {
      setLogs([]);
    }
  } catch (error) {
    console.error('Error fetching logs:', error);
    args.showErrorToast('Failed to load worker logs');
    setLogs([]);
  } finally {
    setLogsLoading(false);
  }
};

// Refresh logs
const refreshLogs = () => {
  fetchLogs();
};

// Clear all logs
const clearAllLogs = async () => {
  const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
  if (!rbConfirm) {
    args.showErrorToast('Confirmation dialog not available');
    return;
  }

  const confirmed = await rbConfirm({
    title: "Clear All Logs",
    message: "Are you sure you want to delete all worker logs? This action cannot be undone.",
    confirmText: "Clear Logs",
    cancelText: "Cancel",
    variant: "danger"
  });

  if (!confirmed) return;

  try {
    const result = await args.fns.executeYTOFunction('clearWorkerLogs', {});

    if (result?.result?.success) {
      args.showSuccessToast(result.result.message || 'All worker logs cleared successfully');
      refreshLogs();
    } else {
      args.showErrorToast(result?.error || result?.result?.error || 'Failed to clear logs');
    }
  } catch (error) {
    console.error('Error clearing logs:', error);
    args.showErrorToast('An error occurred while clearing logs');
  }
};

// Watch for filter changes and reload logs
args.createEffect(args.on(
  () => [args.fns.filterWorker(), args.fns.filterLevel()],
  () => {
    // Fetch logs when filters change
    args.fns.fetchLogs();
  }
));

return {
  enabled: true,
  filterWorker,
  setFilterWorker,
  filterLevel,
  setFilterLevel,
  logs,
  setLogs,
  logsLoading,
  fetchLogs,
  refreshLogs,
  clearAllLogs
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
