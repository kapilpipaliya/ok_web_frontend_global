{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        signinRequired: true
        fns:
          '''
// Filter and refresh state
const [filterWorker, setFilterWorker] = _.createSignal('all');
const [filterLevel, setFilterLevel] = _.createSignal('all');
const [logs, setLogs] = _.createSignal([]);
const [logsLoading, setLogsLoading] = _.createSignal(false);

// Fetch logs function
const fetchLogs = async () => {
  setLogsLoading(true);

  try {
    const result = await f.executeYTOFunction('getWorkerLogs', {
      filterWorker: filterWorker(),
      filterLevel: filterLevel()
    });

    if (result?.error) {
      _.showErrorToast(result.error);
      setLogs([]);
    } else if (result?.result) {
      setLogs(result.result);
    } else {
      setLogs([]);
    }
  } catch (error) {
    console.error('Error fetching logs:', error);
    _.showErrorToast('Failed to load worker logs');
    setLogs([]);
  } finally {
    setLogsLoading(false);
  }
};

// Refresh logs
const refreshLogs = () => {
  fetchLogs();
};

// Clear all logs
const clearAllLogs = async () => {
  const rbConfirm = c?.confirmContext?.rbConfirm;
  if (!rbConfirm) {
    _.showErrorToast('Confirmation dialog not available');
    return;
  }

  const confirmed = await rbConfirm({
    title: "Clear All Logs",
    message: "Are you sure you want to delete all worker logs? This action cannot be undone.",
    confirmText: "Clear Logs",
    cancelText: "Cancel",
    variant: "danger"
  });

  if (!confirmed) return;

  try {
    const result = await f.executeYTOFunction('clearWorkerLogs', {});

    if (result?.result?.success) {
      _.showSuccessToast(result.result.message || 'All worker logs cleared successfully');
      refreshLogs();
    } else {
      _.showErrorToast(result?.error || result?.result?.error || 'Failed to clear logs');
    }
  } catch (error) {
    console.error('Error clearing logs:', error);
    _.showErrorToast('An error occurred while clearing logs');
  }
};

// Watch for filter changes and reload logs
_.createEffect(_.on(
  () => [filterWorker(), filterLevel()],
  () => {
    // Fetch logs when filters change
    fetchLogs();
  }
));

return {
  enabled: true,
  filterWorker,
  setFilterWorker,
  filterLevel,
  setFilterLevel,
  logs,
  setLogs,
  logsLoading,
  fetchLogs,
  refreshLogs,
  clearAllLogs
};
'''
        url: /yto/admin/worker-logs
        key: WorkerLogs
        props:
          '''
return {
  isNoPermissionCheck: true
};
'''
      }
    }
