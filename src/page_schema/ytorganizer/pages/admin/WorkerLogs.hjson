const log = c.logItem;
const createdAt = log?.P?.createdAt;

let timeText = 'Unknown';
if (createdAt) {
  try {
    const date = new Date(createdAt);
    timeText = date.toLocaleString();
  } catch (e) {
    timeText = String(createdAt);
  }
}

return {
  as: "span",
  text: timeText
};
