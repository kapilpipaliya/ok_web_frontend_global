        loop: true
        displayOrder: 2
        fns:
          '''
return {
  getStatsData: () => {
    const users = args.fns.store.users;
    const activeUsers = users.filter(ud => args.fns.getUserStatus(ud.stats) === 'active').length;
    const totalChannels = users.reduce((sum, ud) => sum + (ud.stats?.channelCount || 0), 0);
    const totalPlaylists = users.reduce((sum, ud) => sum + (ud.stats?.playlistCount || 0), 0);
    const totalVideos = users.reduce((sum, ud) => sum + (ud.stats?.videoCount || 0), 0);

    return [
      { label: "Active Users", value: activeUsers, icon: "carbon:user-activity" },
      { label: "Total Channels", value: totalChannels, icon: "carbon:video" },
      { label: "Total Playlists", value: totalPlaylists, icon: "carbon:list" },
      { label: "Total Videos", value: totalVideos, icon: "carbon:play-filled" }
    ];
  }
};
