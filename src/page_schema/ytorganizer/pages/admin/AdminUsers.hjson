        css:
          '''
const userdata = args.contextData.userdata;
const status = args.fns.getUserStatus(userdata.stats);

const colors = {
  active: { bg: args.theme.var.color.success_light_100, text: args.theme.var.color.success_light_100_text },
  new: { bg: args.theme.var.color.info_light_100, text: args.theme.var.color.info_light_100_text },
  dormant: { bg: args.theme.var.color.background_dark_200, text: args.theme.var.color.background_dark_200_text }
};

const color = colors[status] || colors.dormant;

return `._id {
  display: inline-block;
  padding: ${args.theme.var.spacing.xs} ${args.theme.var.spacing.sm};
  background: ${color.bg};
  color: ${color.text};
  border-radius: ${args.theme.var.borderRadius.sm};
  font-size: ${args.theme.var.fontSize.xs};
  font-weight: 600;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const userdata = args.contextData.userdata;
const status = args.fns.getUserStatus(userdata.stats);
const statusText = status === 'active' ? 'Active' : status === 'new' ? 'New' : 'Dormant';

return {
  as: "span",
  text: statusText
};
'''
