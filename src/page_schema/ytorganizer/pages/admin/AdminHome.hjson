const section = c.adminSection;
const actionColor = section.enabled
  ? t.var.color[section.hoverBorder]
  : t.var.color.text_light_500;

return `._id {
  margin-top: auto;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: ${actionColor};
  font-weight: 500;
  font-size: 0.9375rem;

  ${section.enabled ? `
    &::after {
      content: '→';
      font-size: 1rem;
    }
  ` : ''}
}`;
'''
