    {
      id: "6"
      L: Attr
      P: {
        css:
          '''
return `._id {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;

  @media (max-width: 768px) {
    grid-template-columns: 1fr;
  }
}`;
'''
        displayOrder: 2
        description: Grid layout for admin section cards with loop
        componentName: Html
        props:
          '''
return {
  as: "section",
  contextName: "adminSection",
  loop: true,
  data: [
    {
      title: "Quota Monitor",
      description: "Monitor shared YouTube API quota usage across all users. View real-time quota status, usage breakdown by ownership, and quota reset countdown.",
      icon: "carbon:analytics",
      iconBg: "primary_light_100",
      hoverBorder: "primary",
      link: "/yto/admin/quota-monitor",
      linkText: "View Monitor",
      enabled: true
    },
    {
      title: "Queue Management",
      description: "Control processing queue operations for all channels and playlists. Pause all processing when approaching quota limits or resume paused items.",
      icon: "carbon:task-settings",
      iconBg: "warning_light_100",
      hoverBorder: "warning",
      link: "/yto/admin/queue-management",
      linkText: "Manage Queue",
      enabled: true
    },
    {
      title: "Worker Health",
      description: "Monitor background workers, queue status, and job processing health. View real-time metrics for channel and playlist processing.",
      icon: "carbon:dashboard",
      iconBg: "success_light_100",
      hoverBorder: "success",
      link: "/yto/admin/worker-health",
      linkText: "View Dashboard",
      enabled: true
    },
    {
      title: "Worker Logs",
      description: "View background worker processing logs for debugging. Filter logs by worker type and log level, and monitor processing activity.",
      icon: "carbon:document-tasks",
      iconBg: "info_light_100",
      hoverBorder: "info",
      link: "/yto/admin/worker-logs",
      linkText: "View Logs",
      enabled: true
    },
    {
      title: "User Management",
      description: "View and manage all user accounts. Access user details, permissions, and account settings.",
      icon: "carbon:user-multiple",
      iconBg: "info_light_100",
      hoverBorder: "info",
      link: "/yto/admin/users",
      linkText: "Manage Users",
      enabled: true
    },
    {
      title: "API Key Management",
      description: "Manage YouTube API keys, monitor usage, set daily limits, and configure key priorities.",
      icon: "carbon:key",
      iconBg: "warning_light_100",
      hoverBorder: "warning",
      link: "/yto/admin/api-keys",
      linkText: "Manage API Keys",
      enabled: true
    },
    {
      title: "User Feedback",
      description: "View and manage user feedback submissions. Review bug reports, feature requests, and improvement suggestions from users.",
      icon: "carbon:chat",
      iconBg: "success_light_100",
      hoverBorder: "success",
      link: "/yto/admin/feedback",
      linkText: "View Feedback",
      enabled: true
    },
    {
      title: "Contact Submissions",
      description: "View and manage contact form submissions. Review messages from users, update submission status, and respond to inquiries.",
      icon: "carbon:email",
      iconBg: "primary_light_100",
      hoverBorder: "primary",
      link: "/yto/admin/contact-submissions",
      linkText: "View Submissions",
      enabled: true
    },
    {
      title: "Global Settings",
      description: "Configure system-wide settings, themes, and application preferences. Manage global configuration options.",
      icon: "carbon:settings",
      iconBg: "error_light_100",
      hoverBorder: "error",
      link: "/admin/GlobalSettings",
      linkText: "View Settings",
      enabled: true,
      openInNewTab: true
    },
    {
      title: "Workers",
      description: "Manage background workers and scheduled tasks. Monitor worker health, start/stop workers, and configure worker settings.",
      icon: "carbon:task",
      iconBg: "primary_light_100",
      hoverBorder: "primary",
      link: "/admin/GlobalSettings?tab=workers",
      linkText: "Manage Workers",
      enabled: true,
      openInNewTab: true
    }
  ]
};
'''
      }
    }
    {
      id: "7"
      L: Attr
      P: {
        css:
          '''
const section = c.adminSection;

return `._id {
  background: ${t.var.color.background};
  border: 1px solid ${t.var.color.border};
  border-radius: 0.75rem;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  transition: all 0.2s ease;
  cursor: ${section.enabled ? 'pointer' : 'default'};
  text-decoration: none;
  color: inherit;
  height: 100%;
  opacity: ${section.enabled ? '1' : '0.6'};

  ${section.enabled ? `
    &:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
      border-color: ${t.var.color[section.hoverBorder]};
    }
  ` : ''}
}`;
'''
        displayOrder: 1
        description: Admin section card
        componentName: Html
        props:
          '''
const section = c.adminSection;

return {
  as: section.enabled ? "a" : "div",
  href: section.enabled ? section.link : undefined,
  target: section.openInNewTab ? "_blank" : undefined,
  rel: section.openInNewTab ? "noopener noreferrer" : undefined,
  onClick: section.enabled ? ((e) => {
    if (section.openInNewTab) {
      // Let the browser handle the new tab opening
      return;
    }
    e.preventDefault();
    _.navigate(section.link);
  }) : undefined
};
'''
      }
    }
