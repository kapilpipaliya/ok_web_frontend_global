        displayOrder: 1
        componentName: Html
        props:
          '''
const data = f.quotaData?.();
const quota = data?.quota;
const status = data?.status;

if (!data || !quota) {
  return { as: "div", text: "No data available" };
}

const color = status?.level === 'critical' || status?.level === 'danger'
  ? t.var.color.error
  : status?.level === 'warning'
    ? t.var.color.warning
    : t.var.color.success;

return {
  as: "div",
  text: `${quota.used.toLocaleString()} / ${quota.limit.toLocaleString()}`
};
'''
      }
