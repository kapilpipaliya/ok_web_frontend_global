    {
      id: "6"
      L: Attr
      P: {
        displayOrder: 1
        componentName: SimpleCard
        props:
          '''
const data = f.quotaData?.();
const status = data?.status;

let variant = 'default';
if (status?.level === 'critical' || status?.level === 'danger') {
  variant = 'error';
} else if (status?.level === 'warning') {
  variant = 'warning';
}

return {
  title: "Quota Usage",
  icon: "carbon:analytics",
  variant: variant
};
'''
      }
    }
