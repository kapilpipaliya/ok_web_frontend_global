{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        signinRequired: true
        description: Monitor shared YouTube API quota usage across all users and ownerships
        fns:
          '''
return {
  enabled: true
};
'''
        title: YouTube API Quota Monitor
        url: /yto/admin/quota-monitor
        key: QuotaMonitor
        props:
          '''
return {
  isNoPermissionCheck: true
};
'''
      }
    }
    {
      id: "2"
      L: Attr
      P: {
        css:
          '''
return `._id {
  max-width: 1400px;
  margin: 0 auto;
  padding: 1.5rem;

  @media (max-width: 768px) {
    padding: 1rem;
  }
}`;
'''
        displayOrder: 1
        fns:
          '''
const [quotaData, setQuotaData] = _.createSignal(null);
const [loading, setLoading] = _.createSignal(true);

// Auto-refresh interval state
let refreshInterval = null;

const fetchQuotaData = async () => {
  setLoading(true);
  try {
    const result = await f.executeYTOFunction("getSharedQuotaStatus", {});

    if (result.error) {
      _.showErrorToast(result.error);
      return;
    }

    const serverResult = result.result;
    if (serverResult?.data) {
      setQuotaData(serverResult.data);
    }
  } catch (error) {
    console.error('Error fetching quota data:', error);
    _.showErrorToast('Failed to load quota data');
  } finally {
    setLoading(false);
  }
};

const startAutoRefresh = () => {
  // Clear existing interval if any
  if (refreshInterval) {
    clearInterval(refreshInterval);
  }
  // Start auto-refresh every 30 seconds
  refreshInterval = setInterval(fetchQuotaData, 30000);
};

const stopAutoRefresh = () => {
  if (refreshInterval) {
    clearInterval(refreshInterval);
    refreshInterval = null;
  }
};

return {
  quotaData,
  loading,
  fetchQuotaData,
  startAutoRefresh,
  stopAutoRefresh
};
'''
        componentName: Html
        props:
          '''
const fetchQuotaData = f.fetchQuotaData;
const startAutoRefresh = f.startAutoRefresh;
const stopAutoRefresh = f.stopAutoRefresh;

return {
  as: "div",
  onMount: () => {
    fetchQuotaData();
    startAutoRefresh();
  },
  onCleanup: () => {
    stopAutoRefresh();
  }
};
'''
      }
    }
