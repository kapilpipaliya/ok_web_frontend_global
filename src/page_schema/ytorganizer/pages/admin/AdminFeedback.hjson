return {
  getStatsData: () => {
    const feedbacks = f.store.feedbacks;
    const pendingFeedbacks = feedbacks.filter(f => f.feedback?.P?.status === 'pending').length;
    const reviewedFeedbacks = feedbacks.filter(f => f.feedback?.P?.status === 'reviewed').length;
    const resolvedFeedbacks = feedbacks.filter(f => f.feedback?.P?.status === 'resolved').length;
    const bugReports = feedbacks.filter(f => f.feedback?.P?.category === 'bug').length;

    return [
      { label: "Pending", value: pendingFeedbacks, icon: "carbon:pending" },
      { label: "Reviewed", value: reviewedFeedbacks, icon: "carbon:view" },
      { label: "Resolved", value: resolvedFeedbacks, icon: "carbon:checkmark" },
      { label: "Bug Reports", value: bugReports, icon: "carbon:debug" }
    ];
  }
};
