const totalCount = f.store.totalCount;
const currentPage = f.store.currentPage;
const pageSize = f.store.pageSize;
const startIndex = (currentPage - 1) * pageSize + 1;
const endIndex = Math.min(currentPage * pageSize, totalCount);

return {
  as: "p",
  text: totalCount > 0 ? `Showing ${startIndex}-${endIndex} of ${totalCount} feedbacks` : `${totalCount} feedbacks`,
  hide: () => f.store.loading
};
'''
      }
    }
