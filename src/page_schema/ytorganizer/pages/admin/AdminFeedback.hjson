        displayOrder: 1
        fns:
          '''
// State management
const [store, setStore] = _.createStore({
  feedbacks: [],
  loading: true,
  error: null,
  searchQuery: '',
  selectedFeedbacks: [],
  sortBy: 'createdAt',
  sortOrder: 'desc',
  filterStatus: 'all', // all, pending, reviewed, resolved
  filterType: 'all', // all, bug, feature, improvement, other
  currentPage: 1,
  pageSize: 20,
  totalCount: 0,
  totalPages: 0
});

// Load all feedbacks
const loadFeedbacks = async (page = store.currentPage) => {
  setStore('loading', true);
  setStore('error', null);

  const offset = (page - 1) * store.pageSize;

  const result = await f.executeYTOFunction("getAllFeedbacks", {
    searchQuery: store.searchQuery,
    filterStatus: store.filterStatus,
    filterType: store.filterType,
    sortBy: store.sortBy,
    sortOrder: store.sortOrder,
    limit: store.pageSize,
    offset: offset
  });

  if (result.error) {
    setStore('error', result.error);
    setStore('loading', false);
    return;
  }

  const serverResult = result.result;

  if (serverResult?.success) {
    setStore('feedbacks', serverResult.data.feedbacks || []);
    setStore('totalCount', serverResult.data.totalCount || 0);
    setStore('totalPages', Math.ceil((serverResult.data.totalCount || 0) / store.pageSize));
    setStore('currentPage', page);
  } else {
    setStore('error', serverResult?.message || "Failed to load feedbacks");
  }
  setStore('loading', false);
};

// Get filtered feedbacks
const getFilteredFeedbacks = () => {
  return store.feedbacks;
};

// Toggle feedback selection
const toggleFeedbackSelection = (feedbackId) => {
  const selected = store.selectedFeedbacks;
  if (selected.includes(feedbackId)) {
    setStore('selectedFeedbacks', selected.filter(id => id !== feedbackId));
  } else {
    setStore('selectedFeedbacks', [...selected, feedbackId]);
  }
};

// Select all feedbacks
const selectAllFeedbacks = () => {
  const filteredFeedbacks = getFilteredFeedbacks();
  setStore('selectedFeedbacks', filteredFeedbacks.map(f => f.feedback?.id));
};

// Clear selection
const clearSelection = () => {
  setStore('selectedFeedbacks', []);
};

// Search handler with debounce
let searchTimeout;
const handleSearch = (query) => {
  setStore('searchQuery', query);
  clearTimeout(searchTimeout);
  searchTimeout = setTimeout(() => {
    setStore('currentPage', 1);
    loadFeedbacks(1);
  }, 500);
};

// Sort handler
const handleSort = (column) => {
  if (store.sortBy === column) {
    setStore('sortOrder', store.sortOrder === 'asc' ? 'desc' : 'asc');
  } else {
    setStore('sortBy', column);
    setStore('sortOrder', 'desc');
  }
  loadFeedbacks(1);
};

// Filter handler
const handleFilterChange = (filterType, value) => {
  if (filterType === 'status') {
    setStore('filterStatus', value);
  } else if (filterType === 'type') {
    setStore('filterType', value);
  }
  setStore('currentPage', 1);
  loadFeedbacks(1);
};

// Update feedback status
const updateFeedbackStatus = async (feedbackId, status) => {
  try {
    const result = await f.executeYTOFunction("updateFeedbackStatus", {
      feedbackId: feedbackId,
      status: status
    });

    if (result.error) {
      _.showErrorToast(result.error);
      return;
    }

    const serverResult = result.result;

    if (serverResult?.success) {
      _.showSuccessToast(serverResult.message || "Feedback status updated");
      await loadFeedbacks(store.currentPage);
    } else {
      _.showErrorToast(serverResult?.message || "Failed to update feedback status");
    }
  } catch (error) {
    _.showErrorToast("Error updating feedback status: " + error.message);
  }
};

// Delete feedback handler
const handleDeleteFeedback = async (feedbackId, username) => {
  const rbConfirm = c?.confirmContext?.rbConfirm;
  if (!rbConfirm) {
    _.showErrorToast("Confirmation dialog not available");
    return;
  }

  const confirmed = await rbConfirm({
    title: "Delete Feedback",
    message: `Are you sure you want to delete this feedback from "${username}"?`,
    confirmText: "Delete",
    cancelText: "Cancel",
    variant: "danger"
  });

  if (!confirmed) {
    return;
  }

  try {
    const result = await f.executeYTOFunction("deleteFeedback", {
      feedbackId: feedbackId
    });

    if (result.error) {
      _.showErrorToast(result.error);
      return;
    }

    const serverResult = result.result;

    if (serverResult?.success) {
      _.showSuccessToast(serverResult.message || "Feedback deleted successfully");
      await loadFeedbacks(store.currentPage);
    } else {
      _.showErrorToast(serverResult?.message || "Failed to delete feedback");
    }
  } catch (error) {
    _.showErrorToast("Error deleting feedback: " + error.message);
  }
};

// Pagination handlers
const goToPage = (page) => {
  if (page < 1 || page > store.totalPages) return;
  loadFeedbacks(page);
};

const goToNextPage = () => {
  if (store.currentPage < store.totalPages) {
    loadFeedbacks(store.currentPage + 1);
  }
};

const goToPreviousPage = () => {
  if (store.currentPage > 1) {
    loadFeedbacks(store.currentPage - 1);
  }
};

// Get visible page numbers
const getVisiblePages = () => {
  const pages = [];
  const totalPages = store.totalPages;
  const currentPage = store.currentPage;

  if (totalPages <= 7) {
    for (let i = 1; i <= totalPages; i++) {
      pages.push(i);
    }
  } else {
    pages.push(1);

    if (currentPage > 3) {
      pages.push('...');
    }

    const start = Math.max(2, currentPage - 1);
    const end = Math.min(totalPages - 1, currentPage + 1);

    for (let i = start; i <= end; i++) {
      pages.push(i);
    }

    if (currentPage < totalPages - 2) {
      pages.push('...');
    }

    if (totalPages > 1) {
      pages.push(totalPages);
    }
  }

  return pages;
};

// Format date
const formatDate = (dateStr) => {
  if (!dateStr) return 'Never';
  const date = new Date(dateStr);
  const now = new Date();
  const diffDays = Math.floor((now - date) / (1000 * 60 * 60 * 24));

  if (diffDays === 0) return 'Today';
  if (diffDays === 1) return 'Yesterday';
  if (diffDays < 7) return `${diffDays}d ago`;
  if (diffDays < 30) return `${Math.floor(diffDays / 7)}w ago`;
  if (diffDays < 365) return `${Math.floor(diffDays / 30)}mo ago`;
  return `${Math.floor(diffDays / 365)}y ago`;
};

return {
  store,
  loadFeedbacks,
  getFilteredFeedbacks,
  toggleFeedbackSelection,
  selectAllFeedbacks,
  clearSelection,
  handleSearch,
  handleSort,
  handleFilterChange,
  updateFeedbackStatus,
  handleDeleteFeedback,
  goToPage,
  goToNextPage,
  goToPreviousPage,
  getVisiblePages,
  formatDate
};
'''
