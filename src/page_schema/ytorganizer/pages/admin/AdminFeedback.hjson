const allSelected = filteredFeedbacks.length > 0 && filteredFeedbacks.every(f => f.store.selectedFeedbacks.includes(f.feedback?.id));

return {
  as: "input",
  type: "checkbox",
  checked: allSelected,
  onChange: () => {
    if (allSelected) {
