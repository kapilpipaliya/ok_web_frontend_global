        css:
          '''
const pageNum = c.pageNum;
const currentPage = f.store.currentPage;
const isEllipsis = pageNum === '...';
const isActive = pageNum === currentPage;

return `._id {
  min-width: 40px;
  padding: ${t.var.spacing.sm};
  background: ${isActive ? t.var.color.primary : t.var.color.background};
  border: 1px solid ${isActive ? t.var.color.primary : t.var.color.border};
  border-radius: ${t.var.borderRadius.sm};
  color: ${isActive ? t.var.color.primary_text : t.var.color.text};
  font-size: 0.875rem;
  font-weight: ${isActive ? '700' : '400'};
  cursor: ${isEllipsis || isActive ? 'default' : 'pointer'};
  transition: all 0.2s ease;
  text-align: center;

  ${!isEllipsis && !isActive ? `
    &:hover {
      background: ${t.var.color.background_dark_100};
      border-color: ${t.var.color.primary};
    }
  ` : ''}
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const pageNum = c.pageNum;
const currentPage = f.store.currentPage;
const isEllipsis = pageNum === '...';
const isActive = pageNum === currentPage;

return {
  as: isEllipsis ? "span" : "button",
  text: pageNum,
  onClick: isEllipsis ? undefined : () => f.goToPage(pageNum),
  disabled: isActive
};
'''
      }
    }
