return {
  as: "tr",
  "data-selected": isSelected
};
''',
        css: '''
const submission = args.contextData.submission;
const isSelected = args.fns.store.selectedSubmissions.includes(submission.id);

return `._id {
  border-bottom: 1px solid ${args.theme.var.color.border};
  transition: background 0.2s ease;

  &:hover {
    background: ${args.theme.var.color.background_dark_100};
  }

  ${isSelected ? `
    background: ${args.theme.var.color.primary_light_100} !important;
  ` : ''}
}`;
'''
