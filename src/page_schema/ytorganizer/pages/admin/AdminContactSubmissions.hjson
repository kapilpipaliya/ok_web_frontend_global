return {
  getStatsData: () => {
    const submissions = args.fns.store.submissions;
    const newCount = submissions.filter(sub => (sub.P.status || 'new') === 'new').length;
    const readCount = submissions.filter(sub => sub.P.status === 'read').length;
    const respondedCount = submissions.filter(sub => sub.P.status === 'responded').length;
    const closedCount = submissions.filter(sub => sub.P.status === 'closed').length;

    return [
      { label: "New", value: newCount, icon: "carbon:email-new", color: "primary" },
      { label: "Read", value: readCount, icon: "carbon:email", color: "info" },
      { label: "Responded", value: respondedCount, icon: "carbon:checkmark", color: "success" },
      { label: "Closed", value: closedCount, icon: "carbon:close", color: "muted" }
    ];
  }
};
