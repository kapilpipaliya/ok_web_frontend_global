      }
    },
    {
      id: "pagination_prev_button",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const currentPage = args.fns.store.currentPage;
const isDisabled = currentPage <= 1;

return {
  as: "button",
  text: "← Previous",
  onClick: args.fns.goToPreviousPage,
  disabled: isDisabled
};
''',
        css: '''
const currentPage = args.fns.store.currentPage;
const isDisabled = currentPage <= 1;

return `._id {
  padding: ${args.theme.var.spacing.sm} ${args.theme.var.spacing.md};
  background: ${args.theme.var.color.background};
  border: 1px solid ${args.theme.var.color.border};
  border-radius: ${args.theme.var.borderRadius.sm};
  color: ${args.theme.var.color.text};
  font-size: ${args.theme.var.fontSize.sm};
  cursor: ${isDisabled ? 'not-allowed' : 'pointer'};
  opacity: ${isDisabled ? '0.5' : '1'};
  transition: all 0.2s ease;

  &:hover:not(:disabled) {
    background: ${args.theme.var.color.background_dark_100};
    border-color: ${args.theme.var.color.primary};
  }
}`;
'''
      }
    },
    {
      id: "pagination_pages_container",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        contextName: "pageNum",
        loop: true,
        props: '''
return {
  as: "div",
  data: args.fns.getVisiblePages()
};
''',
        css: '''
return `._id {
  display: flex;
  gap: ${args.theme.var.spacing.xs};
}`;
'''
      }
    },
    {
      id: "pagination_page_button",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const pageNum = args.contextData.pageNum;
const currentPage = args.fns.store.currentPage;
const isEllipsis = pageNum === '...';
const isActive = pageNum === currentPage;

return {
  as: isEllipsis ? "span" : "button",
  text: pageNum,
  onClick: isEllipsis ? undefined : () => args.fns.goToPage(pageNum),
  disabled: isActive
};
''',
        css: '''
const pageNum = args.contextData.pageNum;
const currentPage = args.fns.store.currentPage;
const isEllipsis = pageNum === '...';
const isActive = pageNum === currentPage;

return `._id {
  min-width: 40px;
  padding: ${args.theme.var.spacing.sm};
  background: ${isActive ? args.theme.var.color.primary : args.theme.var.color.background};
  border: 1px solid ${isActive ? args.theme.var.color.primary : args.theme.var.color.border};
  border-radius: ${args.theme.var.borderRadius.sm};
  color: ${isActive ? args.theme.var.color.primary_text : args.theme.var.color.text};
  font-size: ${args.theme.var.fontSize.sm};
  font-weight: ${isActive ? '700' : '400'};
  cursor: ${isEllipsis || isActive ? 'default' : 'pointer'};
  transition: all 0.2s ease;
  text-align: center;

  ${!isEllipsis && !isActive ? `
    &:hover {
      background: ${args.theme.var.color.background_dark_100};
      border-color: ${args.theme.var.color.primary};
    }
  ` : ''}
}`;
'''
      }
    },
    {
      id: "pagination_next_button",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const currentPage = args.fns.store.currentPage;
const totalPages = args.fns.store.totalPages;
const isDisabled = currentPage >= totalPages;

return {
  as: "button",
  text: "Next →",
  onClick: args.fns.goToNextPage,
  disabled: isDisabled
};
''',
        css: '''
const currentPage = args.fns.store.currentPage;
const totalPages = args.fns.store.totalPages;
const isDisabled = currentPage >= totalPages;

return `._id {
  padding: ${args.theme.var.spacing.sm} ${args.theme.var.spacing.md};
  background: ${args.theme.var.color.background};
  border: 1px solid ${args.theme.var.color.border};
  border-radius: ${args.theme.var.borderRadius.sm};
  color: ${args.theme.var.color.text};
  font-size: ${args.theme.var.fontSize.sm};
  cursor: ${isDisabled ? 'not-allowed' : 'pointer'};
  opacity: ${isDisabled ? '0.5' : '1'};
  transition: all 0.2s ease;

  &:hover:not(:disabled) {
    background: ${args.theme.var.color.background_dark_100};
    border-color: ${args.theme.var.color.primary};
  }
}`;
'''
      }
    },
