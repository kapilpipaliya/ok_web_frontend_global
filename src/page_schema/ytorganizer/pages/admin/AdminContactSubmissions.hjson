        css:
          '''
const submission = args.contextData.submission;
const status = submission.P.status || 'new';

const colors = {
  new: { bg: args.theme.var.color.primary_light_100, text: args.theme.var.color.primary_light_100_text },
  read: { bg: args.theme.var.color.info_light_100, text: args.theme.var.color.info_light_100_text },
  responded: { bg: args.theme.var.color.success_light_100, text: args.theme.var.color.success_light_100_text },
  closed: { bg: args.theme.var.color.background_dark_200, text: args.theme.var.color.background_dark_200_text }
};

const color = colors[status] || colors.new;

return `._id {
  display: inline-block;
  padding: ${args.theme.var.spacing.xs} ${args.theme.var.spacing.sm};
  background: ${color.bg};
  color: ${color.text};
  border-radius: ${args.theme.var.borderRadius.sm};
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: capitalize;
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const submission = args.contextData.submission;
const status = submission.P.status || 'new';
const statusText = status.charAt(0).toUpperCase() + status.slice(1);

return {
  as: "span",
  text: statusText
};
'''
      }
    }
