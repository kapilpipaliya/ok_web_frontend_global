{
  vertexes: [
    {
      id: "admin_contact_submissions_page",
      L: "Page",
      P: {
        key: "AdminContactSubmissions",
        url: "/yto/admin/contact-submissions",
        signinRequired: true,
        title: "Contact Submissions - Admin - YSaar",
        description: "View and manage contact form submissions",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "favicon_link",
      L: "Attr",
      P: {
        displayOrder: 0.5,
        componentName: "Html",
        props: '''
return {
  as: "link",
  rel: "icon",
  href: "/api/file/downloadCompanyFavicon"
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
        componentName: "Layout",
        displayOrder: 1
      }
    },
    {
      id: "page_layout_content",
      L: "PageLayout",
      P: {
        componentName: "LayoutContent",
        displayOrder: 2
      }
    },
    {
      id: "admin_layout",
      L: "PageLayout",
      P: {
        componentName: "AdminLayout",
        displayOrder: 3
      }
    },
    {
      id: "main_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
// State management
const [store, setStore] = args.createStore({
  submissions: [],
  loading: true,
  tableLoading: false,
  error: null,
  searchQuery: '',
  selectedSubmissions: [],
  filterStatus: 'all', // all, new, read, responded, closed
  currentPage: 1,
  pageSize: 20,
  totalCount: 0,
  totalPages: 0
});

// Load submissions
const loadSubmissions = async (page = store.currentPage, isRefresh = false) => {
  // Use tableLoading for refreshes to avoid hiding the whole page
  if (isRefresh) {
    setStore('tableLoading', true);
  } else {
    setStore('loading', true);
  }
  setStore('error', null);

  try {
    const response = await args.executeNamedServerFunction({
      functionName: 'getContactSubmissions',
      contextData: {}
    });

    const result = response.result;

    if (result.success) {
      let submissions = result.data.submissions || [];

      // Apply search filter
      if (store.searchQuery) {
        const query = store.searchQuery.toLowerCase();
        submissions = submissions.filter(sub =>
          sub.P.name?.toLowerCase().includes(query) ||
          sub.P.email?.toLowerCase().includes(query) ||
          sub.P.message?.toLowerCase().includes(query)
        );
      }

      // Apply status filter
      if (store.filterStatus !== 'all') {
        submissions = submissions.filter(sub =>
          (sub.P.status || 'new') === store.filterStatus
        );
      }

      const totalCount = submissions.length;
      const totalPages = Math.ceil(totalCount / store.pageSize);
      const offset = (page - 1) * store.pageSize;
      const paginatedSubmissions = submissions.slice(offset, offset + store.pageSize);

      setStore('submissions', paginatedSubmissions);
      setStore('totalCount', totalCount);
      setStore('totalPages', totalPages);
      setStore('currentPage', page);
    } else {
      setStore('error', result.error || 'Failed to load submissions');
    }
  } catch (error) {
    console.error('Load submissions error:', error);
    setStore('error', 'An error occurred while loading submissions');
  } finally {
    setStore('loading', false);
    setStore('tableLoading', false);
  }
};

// Update submission status
const updateStatus = async (submissionVertex, newStatus) => {
  setStore('tableLoading', true);

  try {
    const response = await args.executeNamedServerFunction({
      functionName: 'updateContactStatus',
      contextData: {
        contactId: submissionVertex.id,
        status: newStatus
      }
    });

    const result = response.result;

    if (result.success) {
      args.showSuccessToast(`Status updated to ${newStatus}`);
      await loadSubmissions(store.currentPage, true);
    } else {
      console.error('Update status failed:', result.error);
      args.showErrorToast(result.error || 'Failed to update status');
    }
  } catch (error) {
    console.error('Update status error:', error);
    args.showErrorToast('An error occurred while updating status');
  } finally {
    setStore('tableLoading', false);
  }
};

// Format date
const formatDate = (dateStr) => {
  if (!dateStr) return 'N/A';
  const date = new Date(dateStr);
  const now = new Date();
  const diffDays = Math.floor((now - date) / (1000 * 60 * 60 * 24));

  if (diffDays === 0) return 'Today';
  if (diffDays === 1) return 'Yesterday';
  if (diffDays < 7) return `${diffDays}d ago`;
  if (diffDays < 30) return `${Math.floor(diffDays / 7)}w ago`;
  if (diffDays < 365) return `${Math.floor(diffDays / 30)}mo ago`;
  return `${Math.floor(diffDays / 365)}y ago`;
};

// Get status color
const getStatusColor = (status) => {
  switch (status) {
    case 'new': return args.theme.var.color.primary;
    case 'read': return args.theme.var.color.info;
    case 'responded': return args.theme.var.color.success;
    case 'closed': return args.theme.var.color.muted;
    default: return args.theme.var.color.text;
  }
};

// Search handler with debounce
let searchTimeout;
const handleSearch = (query) => {
  setStore('searchQuery', query);
  clearTimeout(searchTimeout);
  searchTimeout = setTimeout(() => {
    setStore('currentPage', 1);
    loadSubmissions(1, true);
  }, 500);
};

// Filter handler
const handleFilterChange = (status) => {
  setStore('filterStatus', status);
  setStore('currentPage', 1);
  loadSubmissions(1, true);
};

// Pagination handlers
const goToPage = (page) => {
  if (page < 1 || page > store.totalPages) return;
  loadSubmissions(page, true);
};

const goToNextPage = () => {
  if (store.currentPage < store.totalPages) {
    loadSubmissions(store.currentPage + 1, true);
  }
};

const goToPreviousPage = () => {
  if (store.currentPage > 1) {
    loadSubmissions(store.currentPage - 1, true);
  }
};

// Get visible page numbers
const getVisiblePages = () => {
  const pages = [];
  const totalPages = store.totalPages;
  const currentPage = store.currentPage;

  if (totalPages <= 7) {
    for (let i = 1; i <= totalPages; i++) {
      pages.push(i);
    }
  } else {
    pages.push(1);

    if (currentPage > 3) {
      pages.push('...');
    }

    const start = Math.max(2, currentPage - 1);
    const end = Math.min(totalPages - 1, currentPage + 1);

    for (let i = start; i <= end; i++) {
      pages.push(i);
    }

    if (currentPage < totalPages - 2) {
      pages.push('...');
    }

    if (totalPages > 1) {
      pages.push(totalPages);
    }
  }

  return pages;
};

// Toggle selection
const toggleSelection = (submissionId) => {
  const selected = store.selectedSubmissions;
  if (selected.includes(submissionId)) {
    setStore('selectedSubmissions', selected.filter(id => id !== submissionId));
  } else {
    setStore('selectedSubmissions', [...selected, submissionId]);
  }
};

// Select all
const selectAll = () => {
  setStore('selectedSubmissions', store.submissions.map(sub => sub.id));
};

// Clear selection
const clearSelection = () => {
  setStore('selectedSubmissions', []);
};

return {
  store,
  loadSubmissions,
  updateStatus,
  formatDate,
  getStatusColor,
  handleSearch,
  handleFilterChange,
  goToPage,
  goToNextPage,
  goToPreviousPage,
  getVisiblePages,
  toggleSelection,
  selectAll,
  clearSelection
};
''',
        props: '''
return {
  as: "div",
  onMount: args.fns.loadSubmissions
};
''',
        css: '''
