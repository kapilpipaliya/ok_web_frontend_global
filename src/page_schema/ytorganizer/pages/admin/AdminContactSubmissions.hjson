  as: "td"
};
''',
        css: '''
return `._id {
  padding: ${args.theme.var.spacing.md};
  text-align: center;
}`;
'''
      }
    },
    {
      id: "td_status_badge",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const submission = args.contextData.submission;
const status = submission.P.status || 'new';
const statusText = status.charAt(0).toUpperCase() + status.slice(1);

return {
  as: "span",
  text: statusText
};
''',
        css: '''
const submission = args.contextData.submission;
const status = submission.P.status || 'new';

const colors = {
  new: { bg: args.theme.var.color.primary_light_100, text: args.theme.var.color.primary_light_100_text },
  read: { bg: args.theme.var.color.info_light_100, text: args.theme.var.color.info_light_100_text },
  responded: { bg: args.theme.var.color.success_light_100, text: args.theme.var.color.success_light_100_text },
  closed: { bg: args.theme.var.color.background_dark_200, text: args.theme.var.color.background_dark_200_text }
};

const color = colors[status] || colors.new;

return `._id {
  display: inline-block;
  padding: ${args.theme.var.spacing.xs} ${args.theme.var.spacing.sm};
  background: ${color.bg};
  color: ${color.text};
  border-radius: ${args.theme.var.borderRadius.sm};
  font-size: ${args.theme.var.fontSize.xs};
  font-weight: 600;
  text-transform: capitalize;
}`;
'''
      }
    },
    {
      id: "td_submitted",
      L: "Attr",
      P: {
        displayOrder: 5,
        componentName: "Html",
        props: '''
const submission = args.contextData.submission;
const submittedText = args.fns.formatDate(submission.P.submittedAt);

return {
  as: "td",
  text: submittedText
};
''',
        css: '''
return `._id {
  padding: ${args.theme.var.spacing.md};
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "td_actions",
      L: "Attr",
      P: {
        displayOrder: 6,
        componentName: "Html",
        props: '''
return {
  as: "td"
};
''',
        css: '''
return `._id {
  padding: ${args.theme.var.spacing.md};
}`;
'''
      }
    },
    {
      id: "td_actions_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "statusOption",
        loop: true,
        props: '''
return {
  as: "div",
  data: ['new', 'read', 'responded', 'closed']
};
''',
        css: '''
return `._id {
  display: flex;
  gap: ${args.theme.var.spacing.xs};
  justify-content: center;
  flex-wrap: wrap;
}`;
'''
      }
    },
    {
      id: "status_action_button",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const submission = args.contextData.submission;
const status = args.contextData.statusOption;
const isCurrentStatus = (submission.P.status || 'new') === status;
const statusText = status.charAt(0).toUpperCase() + status.slice(1);

return {
  as: "button",
  text: statusText,
  disabled: isCurrentStatus,
  onClick: (e) => {
    e.stopPropagation();
    if (!isCurrentStatus) {
      args.fns.updateStatus(submission, status);
    }
  }
};
''',
        css: '''
const submission = args.contextData.submission;
const status = args.contextData.statusOption;
const isCurrentStatus = (submission.P.status || 'new') === status;

return `._id {
  padding: ${args.theme.var.spacing.xs} ${args.theme.var.spacing.sm};
  font-size: ${args.theme.var.fontSize.xs};
  font-weight: 600;
  background: ${isCurrentStatus ? args.fns.getStatusColor(status) : args.theme.var.color.background};
  color: ${isCurrentStatus ? 'white' : args.theme.var.color.text};
  border: 1px solid ${isCurrentStatus ? args.fns.getStatusColor(status) : args.theme.var.color.border};
  border-radius: ${args.theme.var.borderRadius.sm};
  cursor: ${isCurrentStatus ? 'not-allowed' : 'pointer'};
  opacity: ${isCurrentStatus ? '0.7' : '1'};
  text-transform: capitalize;
  transition: all 0.2s ease;

  ${!isCurrentStatus ? `
    &:hover {
      background: ${args.theme.var.color.background_dark_100};
      border-color: ${args.fns.getStatusColor(status)};
    }
  ` : ''}
}`;
'''
      }
    },
    // Pagination
    {
      id: "pagination_container",
      L: "Attr",
      P: {
        displayOrder: 6,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: () => args.fns.store.loading || args.fns.store.error || args.fns.store.totalPages <= 1
};
''',
        css: '''
return `._id {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: ${args.theme.var.spacing.lg};
  border-top: 1px solid ${args.theme.var.color.border};
  background: ${args.theme.var.color.background};
  flex-wrap: wrap;
  gap: ${args.theme.var.spacing.md};
}`;
'''
