const lastUpdated = f.lastUpdated();
const currentTime = f.currentTime();

const timeAgo = lastUpdated
  ? Math.floor((currentTime - lastUpdated.getTime()) / 1000)
  : null;

let timeText = "Never";
if (timeAgo !== null) {
  if (timeAgo < 60) {
    timeText = `${timeAgo}s ago`;
  } else if (timeAgo < 3600) {
    timeText = `${Math.floor(timeAgo / 60)}m ago`;
  } else {
    timeText = lastUpdated.toLocaleTimeString();
  }
}

return {
  as: "div",
  text: `Updated: ${timeText}`
};
'''
