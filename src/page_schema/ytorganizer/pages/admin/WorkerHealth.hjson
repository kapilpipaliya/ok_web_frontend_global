    {
      id: "status_summary",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const queues = args.fns.queuesData();

// Calculate totals across all queues
const totals = queues.reduce((acc, queue) => ({
  active: acc.active + queue.active,
  waiting: acc.waiting + queue.waiting,
  failed: acc.failed + queue.failed,
  completed: acc.completed + queue.completed,
  delayed: acc.delayed + queue.delayed
}), { active: 0, waiting: 0, failed: 0, completed: 0, delayed: 0 });

// Build summary message
let parts = [];

if (totals.active > 0) {
  parts.push(`${totals.active} processing`);
}
if (totals.waiting > 0) {
  parts.push(`${totals.waiting} waiting`);
}
if (totals.failed > 0) {
  parts.push(`${totals.failed} failed`);
}
if (totals.delayed > 0) {
  parts.push(`${totals.delayed} delayed`);
}

let message = parts.length > 0
  ? parts.join(', ')
  : "All queues empty - no active jobs";

return {
  as: "div",
  text: message
};
''',
        css: '''
const healthData = args.fns.healthData();
const isHealthy = healthData?.healthy;

return `._id {
  font-size: 1rem;
  opacity: 0.9;
  color: ${isHealthy ? args.theme.var.color.success_light_100_text : args.theme.var.color.error_light_100_text};
}`;
'''
      }
