'''
      }
    },
    {
      id: "row_cells",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const job = args.contextData.job;
const section = args.contextData.section;

// Helper to create YouTube link
const createYouTubeLink = (job) => {
  const name = job.channelName || job.playlistName || job.customName || args.fns.truncate(job.channelId || job.playlistId, 20);
  let url = '';
  if (job.channelId) {
    // For channels, prefer handle format if available
    if (job.handle || job.customUrl) {
      const handle = job.handle || job.customUrl;
      const formattedHandle = handle.startsWith('@') ? handle : `@${handle}`;
      url = `https://www.youtube.com/${formattedHandle}`;
    } else {
      // Check if channelId is a channel ID (starts with "UC") or a handle
      if (job.channelId.startsWith('UC')) {
        // Channel ID format
        url = `https://www.youtube.com/channel/${job.channelId}`;
      } else {
        // Treat as handle format
        const formattedHandle = job.channelId.startsWith('@') ? job.channelId : `@${job.channelId}`;
        url = `https://www.youtube.com/${formattedHandle}`;
      }
    }
  } else if (job.playlistId) {
    url = `https://www.youtube.com/playlist?list=${job.playlistId}`;
  }
  return { name, url };
};

let cellData = [];
const ytLink = createYouTubeLink(job);

// Common cells
cellData.push(
  { value: args.fns.truncate(job.id, 15), label: 'Job ID', type: 'text' },
  { value: ytLink.name, url: ytLink.url, label: 'Item', type: 'link' },
  { value: job.username || args.fns.truncate(job.userUuid, 20), label: 'User', type: 'text' }
);

// State-specific cells
if (section.key === 'active') {
  cellData.push(
    { value: `${job.progress || 0}%`, label: 'Progress', type: 'text' },
    { value: args.fns.formatDuration(job.duration), label: 'Duration', type: 'text' },
    { value: args.fns.formatJobData(job), label: 'Job Data', type: 'json' }
  );
} else if (section.key === 'waiting') {
  cellData.push(
    { value: args.fns.formatTime(job.timestamp), label: 'Queued', type: 'text' },
    { value: args.fns.formatJobData(job), label: 'Job Data', type: 'json' }
  );
} else if (section.key === 'failed') {
  cellData.push(
    { value: args.fns.truncate(job.failedReason, 30), label: 'Error', type: 'text' },
    { value: `${job.attemptsMade || 0}/3`, label: 'Attempts', type: 'text' },
    { value: args.fns.formatJobData(job), label: 'Job Data', type: 'json' }
  );
} else if (section.key === 'completed') {
  cellData.push(
    { value: args.fns.formatDuration(job.duration), label: 'Duration', type: 'text' },
    { value: args.fns.formatTime(job.finishedOn), label: 'Completed', type: 'text' },
    { value: args.fns.formatJobData(job), label: 'Job Data', type: 'json' }
  );
} else if (section.key === 'delayed') {
  cellData.push(
    { value: args.fns.formatTime(job.timestamp), label: 'Scheduled', type: 'text' },
    { value: args.fns.formatJobData(job), label: 'Job Data', type: 'json' }
  );
}

return {
  contextName: "cell",
  loop: true,
  data: cellData
};
'''
      }
    },
    {
      id: "cell_td",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
