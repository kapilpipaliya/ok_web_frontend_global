  border: 2px solid ${isAutoRefresh ? args.theme.var.color.success : args.theme.var.color.border};
  background: ${isAutoRefresh ? args.theme.var.color.success_light_100 : args.theme.var.color.background};
  color: ${isAutoRefresh ? args.theme.var.color.success_light_100_text : args.theme.var.color.text};
