        css:
          '''
const cell = c.cell;

if (cell.type === 'json') {
  return `._id {
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
    white-space: pre-wrap;
    max-width: 300px;
    line-height: 1.4;
  }`;
}

if (cell.type === 'link') {
  return `._id {
    color: ${t.var.color.primary};
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }`;
}

return `._id {
  color: ${t.var.color.text};
}`;
'''
        displayOrder: 1
        componentName: Html
        props:
          '''
const cell = c.cell;

if (cell.type === 'link' && cell.url) {
  return {
    as: "a",
    href: cell.url,
    target: "_blank",
    rel: "noopener noreferrer",
    text: cell.value
  };
}

return {
  text: cell.value,
  title: cell.value
};
'''
      }
    }
