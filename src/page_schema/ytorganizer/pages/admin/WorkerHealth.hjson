        props: '''
const isAutoRefresh = args.fns.autoRefresh();

return {
  as: "button",
  text: isAutoRefresh ? "Auto-Refresh: ON" : "Auto-Refresh: OFF",
  onClick: () => {
    const newValue = !args.fns.autoRefresh();
    args.fns.setAutoRefresh(newValue);

    if (newValue) {
      args.fns.startAutoRefresh();
      args.showSuccessToast("Auto-refresh enabled");
    } else {
      args.fns.stopAutoRefresh();
      args.showWarningToast("Auto-refresh disabled");
    }
  }
};
''',
