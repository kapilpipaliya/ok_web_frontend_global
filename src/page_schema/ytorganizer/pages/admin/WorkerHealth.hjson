        css: '''
const healthData = args.fns.healthData();
const isHealthy = healthData?.healthy;

return `._id {
  font-size: 1.5rem;
  font-weight: 700;
  color: ${isHealthy ? args.theme.var.color.success_light_100_text : args.theme.var.color.error_light_100_text};
