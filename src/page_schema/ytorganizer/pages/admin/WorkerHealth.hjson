        componentName: Html
        props:
          '''
const section = c.section;
const headerData = c.headerData;

let headers = ["Job ID", "Item", "User"];

if (section.key === 'active') {
  headers.push("Progress", "Duration", "Job Data");
} else if (section.key === 'waiting') {
  headers.push("Queued", "Job Data");
  if (headerData.showActions) headers.push("Actions");
} else if (section.key === 'failed') {
  headers.push("Error", "Attempts", "Job Data");
  if (headerData.showActions) headers.push("Actions");
} else if (section.key === 'completed') {
  headers.push("Duration", "Completed", "Job Data");
} else if (section.key === 'delayed') {
  headers.push("Scheduled", "Job Data");
  if (headerData.showActions) headers.push("Actions");
}

return {
  contextName: "header",
  loop: true,
  data: headers.map(h => ({ text: h }))
};
'''
      }
    }
