        props: '''
const section = args.contextData.section;
const headerData = args.contextData.headerData;
const selectedCount = args.fns.getSelectedCount(section.queueName, section.key);
const totalCount = headerData.jobs.length;
const jobIds = headerData.jobs.map(j => j.id);

return {
  as: "input",
  type: "checkbox",
  checked: selectedCount === totalCount && totalCount > 0,
  onChange: () => args.fns.toggleSelectAll(section.queueName, section.key, jobIds)
};
