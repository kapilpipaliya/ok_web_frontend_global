        displayOrder: 1
        componentName: Html
        props:
          '''
const isAutoRefresh = f.autoRefresh();

return {
  as: "button",
  text: isAutoRefresh ? "Auto-Refresh: ON" : "Auto-Refresh: OFF",
  onClick: () => {
    const newValue = !f.autoRefresh();
    f.setAutoRefresh(newValue);

    if (newValue) {
      f.startAutoRefresh();
      _.showSuccessToast("Auto-refresh enabled");
    } else {
      f.stopAutoRefresh();
      _.showWarningToast("Auto-refresh disabled");
    }
  }
};
'''
