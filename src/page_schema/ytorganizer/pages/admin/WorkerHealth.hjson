      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const section = args.contextData.section;
const job = args.contextData.job;
const isSelected = args.fns.isJobSelected(section.queueName, section.key, job.id);

return {
  as: "input",
