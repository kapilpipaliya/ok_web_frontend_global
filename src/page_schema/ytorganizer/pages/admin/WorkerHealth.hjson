{
  vertexes: [
    {
      id: "root",
      L: "Page",
      P: {
        key: "WorkerHealth",
        url: "/yto/admin/worker-health",
        signinRequired: true,
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
        componentName: "Layout",
        displayOrder: 1,
        description: "YTO layout with navigation"
      }
    },
    {
      id: "page_layout_content",
      L: "PageLayout",
      P: {
        componentName: "LayoutContent",
        displayOrder: 2
      }
    },
    {
      id: "admin_layout",
      L: "PageLayout",
      P: {
        componentName: "AdminLayout",
        displayOrder: 3,
        description: "Admin layout wrapper"
      }
    },
    {
      id: "container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        description: "Main container with data fetching and state management",
        fns: '''
// STATE MANAGEMENT
const [healthData, setHealthData] = args.createSignal(null);
const [queuesData, setQueuesData] = args.createSignal([]);
const [loading, setLoading] = args.createSignal(true);
const [error, setError] = args.createSignal(null);
const [lastUpdated, setLastUpdated] = args.createSignal(null);
const [autoRefresh, setAutoRefresh] = args.createSignal(true);
const [currentTime, setCurrentTime] = args.createSignal(Date.now());

// Expandable sections state
const [expandedSections, setExpandedSections] = args.createSignal({});

// Job data cache
const [jobDataCache, setJobDataCache] = args.createSignal({});
const [loadingSections, setLoadingSections] = args.createSignal({});

// Selection state: { "queueName-sectionKey": Set<jobId> }
const [selectedJobs, setSelectedJobs] = args.createSignal({});

// Update current time every second
const timeUpdateInterval = setInterval(() => {
  setCurrentTime(Date.now());
}, 1000);

// FETCH WORKER HEALTH DATA
const fetchHealth = async () => {
  try {
    setLoading(true);
    setError(null);

    // Fetch worker health
    const healthResponse = await args.executeNamedServerFunction({
      functionName: "getWorkerHealth",
      contextData: {}
    });

    // Fetch available queues
    const queuesResponse = await args.executeNamedServerFunction({
      functionName: "getAvailableQueues",
      contextData: {}
    });

    if (healthResponse.result?.success) {
      setHealthData(healthResponse.result.data);
      setLastUpdated(new Date());
    } else {
      setError(healthResponse.result?.message || "Failed to fetch worker health");
    }

    if (queuesResponse.result?.success) {
      setQueuesData(queuesResponse.result.data.queues || []);
    }

  } catch (err) {
    setError(err.message || "An error occurred");
  } finally {
    setLoading(false);
  }
};

// TOGGLE SECTION
const toggleSection = async (queueName, sectionKey) => {
  const current = expandedSections();
  const queueSections = current[queueName] || {};
  const isExpanded = queueSections[sectionKey];

  setExpandedSections({
    ...current,
    [queueName]: {
      ...queueSections,
      [sectionKey]: !isExpanded
    }
  });

  // Load data if expanding
  if (!isExpanded) {
    await loadSectionData(queueName, sectionKey);
  }
};

// LOAD SECTION DATA
const loadSectionData = async (queueName, sectionKey, force = false) => {
  if (sectionKey === 'metrics') {
    await loadMetrics(queueName);
    return;
  }

  const cacheKey = `${queueName}-${sectionKey}`;
  const cached = jobDataCache()[cacheKey];

  // Check if data is fresh (< 30 seconds old), unless forced
  if (!force && cached && (Date.now() - cached.timestamp < 30000)) {
    return;
  }

  setLoadingSections({ ...loadingSections(), [cacheKey]: true });

  try {
    const response = await args.executeNamedServerFunction({
      functionName: "getQueueJobs",
      contextData: {
        queueName,
        jobState: sectionKey,
        limit: 100
      }
    });

    if (response.result?.success) {
      setJobDataCache({
        ...jobDataCache(),
        [cacheKey]: {
          data: response.result.data,
          timestamp: Date.now()
        }
      });
    }
  } catch (err) {
    console.error('Error loading section data:', err);
  } finally {
    setLoadingSections({ ...loadingSections(), [cacheKey]: false });
  }
};

// LOAD METRICS
const loadMetrics = async (queueName) => {
  const cacheKey = `${queueName}-metrics`;
  const cached = jobDataCache()[cacheKey];

  if (cached && (Date.now() - cached.timestamp < 30000)) {
    return;
  }

  setLoadingSections({ ...loadingSections(), [cacheKey]: true });

  try {
    const response = await args.executeNamedServerFunction({
      functionName: "getQueueMetrics",
      contextData: { queueName }
    });

    if (response.result?.success) {
      setJobDataCache({
        ...jobDataCache(),
        [cacheKey]: {
          data: response.result.data,
          timestamp: Date.now()
        }
      });
    }
  } catch (err) {
    console.error('Error loading metrics:', err);
  } finally {
    setLoadingSections({ ...loadingSections(), [cacheKey]: false });
  }
};

// SELECTION FUNCTIONS
const toggleJobSelection = (queueName, sectionKey, jobId) => {
  const key = `${queueName}-${sectionKey}`;
  const current = selectedJobs();
  const selected = current[key] || new Set();

  if (selected.has(jobId)) {
    selected.delete(jobId);
  } else {
    selected.add(jobId);
  }

  setSelectedJobs({
    ...current,
    [key]: new Set(selected)
  });
};

const toggleSelectAll = (queueName, sectionKey, jobIds) => {
  const key = `${queueName}-${sectionKey}`;
  const current = selectedJobs();
  const selected = current[key] || new Set();

  if (selected.size === jobIds.length) {
    // Deselect all
    setSelectedJobs({
      ...current,
      [key]: new Set()
    });
  } else {
    // Select all
    setSelectedJobs({
      ...current,
      [key]: new Set(jobIds)
    });
  }
};

const getSelectedCount = (queueName, sectionKey) => {
  const key = `${queueName}-${sectionKey}`;
  return (selectedJobs()[key] || new Set()).size;
};

const isJobSelected = (queueName, sectionKey, jobId) => {
  const key = `${queueName}-${sectionKey}`;
  return (selectedJobs()[key] || new Set()).has(jobId);
};

// DELETE FUNCTIONS
const deleteSelectedJobs = async (queueName, sectionKey) => {
  const key = `${queueName}-${sectionKey}`;
  const selected = selectedJobs()[key];

  if (!selected || selected.size === 0) {
    args.showWarningToast('No jobs selected');
    return;
  }

  const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
  const confirmed = await rbConfirm({
    title: 'Delete Selected Jobs',
    message: `Are you sure you want to delete ${selected.size} selected job(s)? This action cannot be undone.`,
    confirmText: 'Delete',
    cancelText: 'Cancel',
    variant: 'danger'
  });

  if (!confirmed) return;

  try {
    const response = await args.executeNamedServerFunction({
      functionName: "bulkDeleteQueueJobs",
      contextData: {
        queueName,
        jobIds: Array.from(selected),
        state: sectionKey
      }
    });

    if (response.result?.success) {
      args.showSuccessToast(response.result.message);

      // Clear selection
      setSelectedJobs({
        ...selectedJobs(),
        [key]: new Set()
      });

      // Reload data - force refresh to bypass cache
      await loadSectionData(queueName, sectionKey, true);
      await fetchHealth();
    } else {
      args.showErrorToast(response.result?.message || 'Failed to delete jobs');
    }
  } catch (err) {
    args.showErrorToast('Error deleting jobs: ' + err.message);
  }
};

const deleteAllJobs = async (queueName, sectionKey) => {
  const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
  const confirmed = await rbConfirm({
    title: 'Delete All Jobs',
    message: `Are you sure you want to delete ALL ${sectionKey} jobs in ${queueName}? This action cannot be undone.`,
    confirmText: 'Delete All',
    cancelText: 'Cancel',
    variant: 'danger'
  });

  if (!confirmed) return;

  try {
    const response = await args.executeNamedServerFunction({
      functionName: "deleteAllQueueJobs",
      contextData: {
        queueName,
        state: sectionKey
      }
    });

    if (response.result?.success) {
      args.showSuccessToast(response.result.message);

      // Clear selection
      const key = `${queueName}-${sectionKey}`;
      setSelectedJobs({
        ...selectedJobs(),
        [key]: new Set()
      });

      // Reload data - force refresh to bypass cache
      await loadSectionData(queueName, sectionKey, true);
      await fetchHealth();
    } else {
      args.showErrorToast(response.result?.message || 'Failed to delete all jobs');
    }
  } catch (err) {
    args.showErrorToast('Error deleting all jobs: ' + err.message);
  }
};

// HELPER FUNCTIONS
const formatDuration = (ms) => {
  if (!ms || ms < 0) return 'N/A';
  const seconds = Math.floor(ms / 1000);
  if (seconds < 60) return `${seconds}s`;
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return `${minutes}m ${seconds % 60}s`;
  const hours = Math.floor(minutes / 60);
  return `${hours}h ${minutes % 60}m`;
};

const formatTime = (timestamp) => {
  if (!timestamp) return 'N/A';
  const date = new Date(timestamp);
  return date.toLocaleString();
};

const truncate = (str, length = 20) => {
  if (!str) return 'N/A';
  return str.length > length ? str.substring(0, length) + '...' : str;
};

const formatJobData = (job) => {
  const jobData = {
    channelId: job.channelId,
    playlistId: job.playlistId,
    userId: job.userId,
    userUuid: job.userUuid,
    customName: job.customName
  };

  const cleanedData = Object.fromEntries(
    Object.entries(jobData).filter(([_, v]) => v != null)
  );

  return JSON.stringify(cleanedData, null, 2);
};

// AUTO-REFRESH
let refreshInterval = null;

const startAutoRefresh = () => {
  if (refreshInterval) return;
  refreshInterval = setInterval(() => {
    if (autoRefresh()) fetchHealth();
  }, 10000);
};

const stopAutoRefresh = () => {
  if (refreshInterval) {
    clearInterval(refreshInterval);
    refreshInterval = null;
  }
};

// Initial fetch
fetchHealth();
startAutoRefresh();

// Cleanup
args.onCleanup(() => {
  clearInterval(timeUpdateInterval);
  stopAutoRefresh();
});

return {
  healthData,
  queuesData,
  loading,
  error,
  lastUpdated,
  currentTime,
  autoRefresh,
  setAutoRefresh,
  fetchHealth,
  startAutoRefresh,
  stopAutoRefresh,
  expandedSections,
  toggleSection,
  jobDataCache,
  loadingSections,
  formatDuration,
  formatTime,
  truncate,
  formatJobData,
  selectedJobs,
  toggleJobSelection,
  toggleSelectAll,
  getSelectedCount,
  isJobSelected,
  deleteSelectedJobs,
  deleteAllJobs
};
''',
        props: '''
return {
  as: "div"
};
''',
        css: '''
