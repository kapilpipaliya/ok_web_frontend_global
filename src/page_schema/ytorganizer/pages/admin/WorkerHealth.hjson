const cacheKey = `${section.queueName}-metrics`;
const cachedData = f.jobDataCache()[cacheKey];
const data = cachedData?.data;

return {
  as: "div",
  hide: section.key !== 'metrics' || !data,
  contextName: "metric",
  loop: true,
  data: data ? [
    { label: "Average Duration", value: data.metrics.avgDurationFormatted },
    { label: "Success Rate", value: data.metrics.successRateFormatted },
    { label: "Throughput", value: data.metrics.throughputFormatted },
    { label: "Total Completed", value: `${data.totalCompleted || 0} jobs` },
    { label: "Total Failed", value: `${data.totalFailed || 0} jobs` },
    { label: "Active Workers", value: `${data.activeWorkers || 0} jobs` },
    { label: "Concurrency", value: `${data.concurrency} workers` }
  ] : []
};
'''
