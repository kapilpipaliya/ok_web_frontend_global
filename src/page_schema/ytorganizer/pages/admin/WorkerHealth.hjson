    {
      id: "queue_stats",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const queue = args.contextData.queue;

return {
  as: "div",
  contextName: "stat",
  loop: true,
  data: [
    { label: "Active", value: queue.active, color: "warning", icon: "⚙️" },
    { label: "Waiting", value: queue.waiting, color: "info", icon: "⏳" },
    { label: "Completed", value: queue.completed, color: "success", icon: "✅" },
    { label: "Failed", value: queue.failed, color: "error", icon: "❌" },
    { label: "Delayed", value: queue.delayed, color: "text", icon: "⏰" },
    { label: "Paused", value: queue.paused, color: "text", icon: "⏸️" }
  ]
};
''',
        css: '''
return `._id {
  display: flex;
