    },
    {
      id: "cell_content",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const cell = args.contextData.cell;

if (cell.type === 'link' && cell.url) {
  return {
    as: "a",
    href: cell.url,
    target: "_blank",
    rel: "noopener noreferrer",
    text: cell.value
  };
}

return {
  text: cell.value,
  title: cell.value
};
''',
        css: '''
const cell = args.contextData.cell;

if (cell.type === 'json') {
  return `._id {
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
    white-space: pre-wrap;
    max-width: 300px;
    line-height: 1.4;
  }`;
}

if (cell.type === 'link') {
  return `._id {
    color: ${args.theme.var.color.primary};
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }`;
}

return `._id {
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "metrics_display",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const section = args.contextData.section;
const cacheKey = `${section.queueName}-metrics`;
const cachedData = args.fns.jobDataCache()[cacheKey];
const data = cachedData?.data;

return {
  as: "div",
  hide: section.key !== 'metrics' || !data,
  contextName: "metric",
  loop: true,
  data: data ? [
    { label: "Average Duration", value: data.metrics.avgDurationFormatted },
    { label: "Success Rate", value: data.metrics.successRateFormatted },
    { label: "Throughput", value: data.metrics.throughputFormatted },
    { label: "Total Completed", value: `${data.totalCompleted || 0} jobs` },
    { label: "Total Failed", value: `${data.totalFailed || 0} jobs` },
    { label: "Active Workers", value: `${data.activeWorkers || 0} jobs` },
    { label: "Concurrency", value: `${data.concurrency} workers` }
  ] : []
};
''',
        css: '''
return `._id {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
}`;
'''
      }
