{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        signinRequired: true
        fns:
          '''
// State management
const [apiKeys, setApiKeys] = args.createSignal([]);
const [loading, setLoading] = args.createSignal(true);
const [isAddModalOpen, setIsAddModalOpen] = args.createSignal(false);
const [importMode, setImportMode] = args.createSignal('single'); // 'single' or 'bulk'
const [bulkImportText, setBulkImportText] = args.createSignal('');
const [formData, setFormData] = args.createStore({
  apiKey: '',
  name: '',
  dailyLimit: 10000,
  priority: 100
});

// Load API keys
const loadAPIKeys = async () => {
  setLoading(true);
  try {
    const result = await args.fns.executeYTOFunction("manageYouTubeAPIKeys", { action: 'list' });

    if (result?.result?.success && result?.result?.data) {
      setApiKeys(result.result.data.apiKeys || []);
    } else {
      args.showErrorToast(result?.result?.message || "Failed to load API keys");
    }
  } catch (error) {
    console.error("Error loading API keys:", error);
    args.showErrorToast("Failed to load API keys");
  } finally {
    setLoading(false);
  }
};

// Add API key
const handleAddAPIKey = async () => {
  if (!formData.apiKey) {
    args.showErrorToast("API key is required");
    return;
  }

  try {
    const result = await args.fns.executeYTOFunction("manageYouTubeAPIKeys", {
      action: 'add',
      apiKey: formData.apiKey,
      name: formData.name || 'Unnamed Key',
      dailyLimit: formData.dailyLimit,
      priority: formData.priority,
      isActive: true
    });

    if (result?.result?.success) {
      args.showSuccessToast(result.result.message);
      setIsAddModalOpen(false);
      setImportMode('single');
      setFormData({ apiKey: '', name: '', dailyLimit: 10000, priority: 100 });
      await loadAPIKeys();
    } else {
      args.showErrorToast(result?.result?.message || "Failed to add API key");
    }
  } catch (error) {
    console.error("Error adding API key:", error);
    args.showErrorToast("Failed to add API key");
  }
};

// Bulk import API keys
const handleBulkImport = async () => {
  const text = bulkImportText().trim();
  if (!text) {
    args.showErrorToast("Please enter API keys to import");
    return;
  }

  try {
    let keysToImport = [];

    // Try to parse as JSON first
    try {
      const parsed = JSON.parse(text);
      if (Array.isArray(parsed)) {
        keysToImport = parsed.map((item, index) => ({
          apiKey: typeof item === 'string' ? item : item.apiKey,
          name: typeof item === 'object' ? (item.name || `Imported Key ${index + 1}`) : `Imported Key ${index + 1}`,
          dailyLimit: typeof item === 'object' ? (item.dailyLimit || 10000) : 10000,
          priority: typeof item === 'object' ? (item.priority || 100 + index) : 100 + index
        }));
      } else {
        throw new Error('JSON must be an array');
      }
    } catch (jsonError) {
      // If JSON parsing fails, treat as line-separated API keys
      const lines = text.split('\n').map(line => line.trim()).filter(line => line.length > 0);
      keysToImport = lines.map((apiKey, index) => ({
        apiKey,
        name: `Imported Key ${index + 1}`,
        dailyLimit: 10000,
        priority: 100 + index
      }));
    }

    if (keysToImport.length === 0) {
      args.showErrorToast("No valid API keys found");
      return;
    }

    // Import each key
    let successCount = 0;
    let failCount = 0;

    for (const keyData of keysToImport) {
      try {
        const result = await args.fns.executeYTOFunction("manageYouTubeAPIKeys", {
          action: 'add',
          apiKey: keyData.apiKey,
          name: keyData.name,
          dailyLimit: keyData.dailyLimit,
          priority: keyData.priority,
          isActive: true
        });

        if (result?.result?.success) {
          successCount++;
        } else {
          failCount++;
          console.error(`Failed to import key: ${result?.result?.message}`);
        }
      } catch (error) {
        failCount++;
        console.error("Error importing key:", error);
      }
    }

    // Show results
    if (successCount > 0 && failCount === 0) {
      args.showSuccessToast(`Successfully imported ${successCount} API key(s)`);
    } else if (successCount > 0 && failCount > 0) {
      args.showWarningToast(`Imported ${successCount} API key(s), ${failCount} failed`);
    } else {
      args.showErrorToast(`Failed to import all ${failCount} API key(s)`);
    }

    // Reset and reload
    if (successCount > 0) {
      setIsAddModalOpen(false);
      setBulkImportText('');
      setImportMode('single');
      await loadAPIKeys();
    }
  } catch (error) {
    console.error("Error bulk importing:", error);
    args.showErrorToast("Failed to process bulk import");
  }
};

// Remove API key
const handleRemoveAPIKey = async (keyId, keyName) => {
  const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
  if (!rbConfirm) {
    args.showErrorToast("Confirmation dialog not available");
    return;
  }

  const confirmed = await rbConfirm({
    title: "Remove API Key",
    message: `Are you sure you want to remove "${keyName}"? This action cannot be undone.`,
    confirmText: "Remove",
    cancelText: "Cancel"
  });

  if (!confirmed) return;

  try {
    const result = await args.fns.executeYTOFunction("manageYouTubeAPIKeys", {
      action: 'remove',
      keyId: keyId
    });

    if (result?.result?.success) {
      args.showSuccessToast(result.result.message);
      await loadAPIKeys();
    } else {
      args.showErrorToast(result?.result?.message || "Failed to remove API key");
    }
  } catch (error) {
    console.error("Error removing API key:", error);
    args.showErrorToast("Failed to remove API key");
  }
};

// Toggle active status
const handleToggleActive = async (keyId, currentStatus) => {
  try {
    const result = await args.fns.executeYTOFunction("manageYouTubeAPIKeys", {
      action: 'update',
      keyId: keyId,
      isActive: !currentStatus
    });

    if (result?.result?.success) {
      args.showSuccessToast(result.result.message);
      await loadAPIKeys();
    } else {
      args.showErrorToast(result?.result?.message || "Failed to update API key");
    }
  } catch (error) {
    console.error("Error updating API key:", error);
    args.showErrorToast("Failed to update API key");
  }
};

// Reset all counts
const handleResetCounts = async () => {
  const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
  if (!rbConfirm) {
    args.showErrorToast("Confirmation dialog not available");
    return;
  }

  const confirmed = await rbConfirm({
    title: "Reset All Counts",
    message: "Are you sure you want to reset usage counts for all API keys?",
    confirmText: "Reset",
    cancelText: "Cancel"
  });

  if (!confirmed) return;

  try {
    const result = await args.fns.executeYTOFunction("manageYouTubeAPIKeys", { action: 'reset' });

    if (result?.result?.success) {
      args.showSuccessToast(result.result.message);
      await loadAPIKeys();
    } else {
      args.showErrorToast(result?.result?.message || "Failed to reset counts");
    }
  } catch (error) {
    console.error("Error resetting counts:", error);
    args.showErrorToast("Failed to reset counts");
  }
};

// Format date
const formatDate = (dateStr) => {
  if (!dateStr) return 'Never';
  return new Date(dateStr).toLocaleString();
};

// Calculate usage percentage
const getUsagePercentage = (current, limit) => {
  return Math.round((current / limit) * 100);
};

// Get status color
const getStatusColor = (percentage, isActive) => {
  if (!isActive) return args.theme.var.color.muted;
  if (percentage >= 95) return args.theme.var.color.error;
  if (percentage >= 80) return args.theme.var.color.warning;
  return args.theme.var.color.success;
};

return {
  enabled: true,
  apiKeys,
  loading,
  isAddModalOpen,
  setIsAddModalOpen,
  importMode,
  setImportMode,
  bulkImportText,
  setBulkImportText,
  formData,
  setFormData,
  loadAPIKeys,
  handleAddAPIKey,
  handleBulkImport,
  handleRemoveAPIKey,
  handleToggleActive,
  handleResetCounts,
  formatDate,
  getUsagePercentage,
  getStatusColor
};
'''
        url: /yto/admin/api-keys
        key: APIKeyManagement
        props:
          '''
return {
  isNoPermissionCheck: true,
  onMount: args.fns.loadAPIKeys
};
'''
      }
