    {
      id: "terms_section_6_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  innerHTML: `
    <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">6.1 Our Intellectual Property</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">YouTube Organizer, including its design, code, features, and content, is owned by us and protected by copyright, trademark, and other intellectual property laws. You may not:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">Copy, modify, or create derivative works</li>
      <li style="margin-bottom: 0.5rem;">Sell, license, or distribute the service</li>
      <li style="margin-bottom: 0.5rem;">Remove copyright or proprietary notices</li>
    </ul>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin: 1.5rem 0 0.75rem 0; color: ${args.theme.var.color.text};">6.2 YouTube Content</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">All YouTube content accessed through our service remains the property of YouTube and the respective content creators. You must:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">Respect YouTube content creators' intellectual property rights</li>
      <li style="margin-bottom: 0.5rem;">Comply with YouTube's Terms of Service when accessing content</li>
      <li style="margin-bottom: 0.5rem;">Not download, redistribute, or commercialize YouTube videos</li>
    </ul>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin: 1.5rem 0 0.75rem 0; color: ${args.theme.var.color.text};">6.3 Trademarks</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">YouTube, Google, and their logos are trademarks of Google LLC. We use these marks in compliance with <a href="https://developers.google.com/youtube/terms/branding-guidelines" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">YouTube Branding Guidelines</a>.</p>
  `
};
'''
