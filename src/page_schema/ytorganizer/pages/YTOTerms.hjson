return {
  as: "div",
  innerHTML: `
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem; font-weight: 600; text-transform: uppercase;">The service is provided "as is" without warranties of any kind.</p>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">7.1 No Warranties</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">We do not guarantee that:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">The service will be uninterrupted, secure, or error-free</li>
      <li style="margin-bottom: 0.5rem;">YouTube data will always be accurate or up-to-date</li>
      <li style="margin-bottom: 0.5rem;">All features will work as expected at all times</li>
      <li style="margin-bottom: 0.5rem;">The service will meet your specific requirements</li>
    </ul>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin: 1.5rem 0 0.75rem 0; color: ${args.theme.var.color.text};">7.2 Limitation of Liability</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">To the maximum extent permitted by law, we are not liable for:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">Any indirect, incidental, special, or consequential damages</li>
      <li style="margin-bottom: 0.5rem;">Loss of profits, data, or business opportunities</li>
      <li style="margin-bottom: 0.5rem;">Service interruptions or data loss</li>
      <li style="margin-bottom: 0.5rem;">Actions of third parties (including YouTube/Google)</li>
      <li style="margin-bottom: 0.5rem;">Unauthorized access to your account or data</li>
    </ul>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin: 1.5rem 0 0.75rem 0; color: ${args.theme.var.color.text};">7.3 Third-Party Services</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">YouTube Organizer relies on YouTube API Services. We are not responsible for:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; padding-left: 1.5rem;">
