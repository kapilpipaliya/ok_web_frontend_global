    },
    {
      id: "terms_section_5_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  innerHTML: `
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">You agree NOT to:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">Violate any laws or regulations</li>
      <li style="margin-bottom: 0.5rem;">Abuse, harass, or harm other users</li>
      <li style="margin-bottom: 0.5rem;">Attempt to access unauthorized areas of the service</li>
      <li style="margin-bottom: 0.5rem;">Reverse engineer, decompile, or attempt to extract source code</li>
      <li style="margin-bottom: 0.5rem;">Use automated tools (bots, scrapers) without permission</li>
      <li style="margin-bottom: 0.5rem;">Circumvent YouTube API quotas or rate limits</li>
      <li style="margin-bottom: 0.5rem;">Download or cache YouTube video files</li>
      <li style="margin-bottom: 0.5rem;">Resell, redistribute, or commercialize YouTube data</li>
      <li style="margin-bottom: 0.5rem;">Violate YouTube Terms of Service or Developer Policies</li>
      <li style="margin-bottom: 0.5rem;">Use the service for any illegal or unauthorized purpose</li>
    </ul>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem; padding: 1rem; background: ${args.theme.var.color.error_light_100}; border-radius: 0.375rem; border-left: 3px solid ${args.theme.var.color.error};"><strong>Warning:</strong> Violation of these terms may result in immediate account suspension or termination without refund.</p>
  `
};
'''
      }
    },
    // Section 6: Intellectual Property
    {
