{
  vertexes: [
    {
      id: "yto_terms_page",
      L: "Page",
      P: {
        key: "YTOTerms",
        url: "/terms",
        title: "Terms of Service - YouTube Organizer",
        description: "Terms of Service for YouTube Organizer - Your agreement when using our YouTube content organization service",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "favicon_link",
      L: "Attr",
      P: {
        displayOrder: 0.5,
        componentName: "Html",
        props: '''
return {
  as: "link",
  rel: "icon",
  href: "/api/file/downloadCompanyFavicon"
};
'''
      }
    },
    {
      id: "terms_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    // Header Section
    {
      id: "terms_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.background_dark_100};
  border-bottom: 1px solid ${args.theme.var.color.border};
  padding: 1rem 2rem;
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(10px);
}

@media (max-width: 768px) {
  ._id {
    padding: 0.75rem 1rem;
  }
}`;
'''
      }
    },
    {
      id: "terms_header_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}`;
'''
      }
    },
    {
      id: "terms_header_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: "YouTube Organizer - Terms of Service"
};
''',
        css: '''
return `._id {
  font-size: 1.5rem;
  font-weight: 700;
  color: ${args.theme.var.color.text};
  margin: 0;
}

@media (max-width: 768px) {
  ._id {
    font-size: 1.125rem;
  }
}`;
'''
      }
    },
    {
      id: "terms_header_back_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "button",
  text: "← Back to App",
  onClick: () => args.navigate("/")
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  border: none;
  border-radius: 0.5rem;
  padding: 0.5rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: inherit;

  &:hover {
    background: ${args.theme.var.color.primary_dark_200};
  }
}`;
'''
      }
    },
    // Main Content
    {
      id: "terms_main",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "main"
};
''',
        css: '''
return `._id {
  flex: 1;
  padding: 3rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

@media (max-width: 768px) {
  ._id {
    padding: 2rem 1rem;
  }
}`;
'''
      }
    },
    {
      id: "terms_last_updated",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const currentDate = new Date().toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

return {
  as: "p",
  text: `Last Updated: ${currentDate}`
};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  color: ${args.theme.var.color.muted};
  margin-bottom: 2rem;
  font-style: italic;
}`;
'''
      }
    },
    {
      id: "terms_introduction",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "Welcome to YouTube Organizer. By accessing or using our service, you agree to be bound by these Terms of Service (\"Terms\"). Please read them carefully. If you do not agree to these Terms, you may not use our service."
};
''',
        css: '''
return `._id {
  line-height: 1.7;
  color: ${args.theme.var.color.text};
  margin-bottom: 2.5rem;
  font-size: 1.05rem;
}`;
'''
      }
    },
    // Section 1: Acceptance of Terms
    {
      id: "terms_section_1",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  margin-bottom: 2.5rem;
}`;
'''
      }
    },
    {
      id: "terms_section_1_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h2",
  text: "1. Acceptance of Terms"
};
''',
        css: '''
return `._id {
  font-size: 1.75rem;
  font-weight: 700;
  color: ${args.theme.var.color.text};
  margin: 0 0 1.5rem 0;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid ${args.theme.var.color.primary};
}`;
'''
      }
    },
    {
      id: "terms_section_1_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  innerHTML: `
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">By creating an account, accessing, or using YouTube Organizer, you acknowledge that you have read, understood, and agree to be bound by:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">These Terms of Service</li>
      <li style="margin-bottom: 0.5rem;">Our <a href="/privacy" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">Privacy Policy</a></li>
      <li style="margin-bottom: 0.5rem;"><a href="https://www.youtube.com/t/terms" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">YouTube Terms of Service</a></li>
      <li style="margin-bottom: 0.5rem;"><a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">Google Privacy Policy</a></li>
      <li style="margin-bottom: 0.5rem;"><a href="https://developers.google.com/youtube/terms/developer-policies" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">YouTube API Services Developer Policies</a></li>
    </ul>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">If you do not agree to all of these terms, you must immediately stop using YouTube Organizer.</p>
  `
};
'''
      }
    },
    // Section 2: Description of Service
    {
      id: "terms_section_2",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  margin-bottom: 2.5rem;
}`;
'''
      }
    },
    {
      id: "terms_section_2_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h2",
  text: "2. Description of Service"
};
''',
        css: '''
return `._id {
  font-size: 1.75rem;
  font-weight: 700;
  color: ${args.theme.var.color.text};
  margin: 0 0 1.5rem 0;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid ${args.theme.var.color.primary};
}`;
'''
      }
    },
    {
      id: "terms_section_2_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  innerHTML: `
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">YouTube Organizer provides a platform to help you organize and manage your YouTube content including:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;"><strong>Channel Management:</strong> Track and organize YouTube channels you follow</li>
      <li style="margin-bottom: 0.5rem;"><strong>Playlist Organization:</strong> Manage and categorize YouTube playlists</li>
      <li style="margin-bottom: 0.5rem;"><strong>Video Tracking:</strong> Keep notes and track watch progress on videos</li>
      <li style="margin-bottom: 0.5rem;"><strong>Custom Tags & Notes:</strong> Add personal organization and annotations</li>
    </ul>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem; padding: 1rem; background: ${args.theme.var.color.info_light_100}; border-radius: 0.375rem; border-left: 3px solid ${args.theme.var.color.info};"><strong>Important:</strong> YouTube Organizer uses <strong>YouTube API Services</strong> to access publicly available YouTube data on your behalf through your personal Google OAuth authorization. We do not download, store, or redistribute YouTube video files.</p>
  `
};
'''
      }
    },
    // Section 3: YouTube API Services
    {
      id: "terms_section_3",
      L: "Attr",
      P: {
        displayOrder: 5,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  margin-bottom: 2.5rem;
}`;
'''
      }
    },
    {
      id: "terms_section_3_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h2",
  text: "3. YouTube API Services"
};
''',
        css: '''
return `._id {
  font-size: 1.75rem;
  font-weight: 700;
  color: ${args.theme.var.color.text};
  margin: 0 0 1.5rem 0;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid ${args.theme.var.color.primary};
}`;
'''
      }
    },
    {
      id: "terms_section_3_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  innerHTML: `
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">Our service uses <strong>YouTube API Services</strong>. By using YouTube Organizer, you are also agreeing to be bound by the <a href="https://www.youtube.com/t/terms" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline; font-weight: 600;">YouTube Terms of Service</a>.</p>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin: 1.5rem 0 0.75rem 0; color: ${args.theme.var.color.text};">3.1 OAuth Authorization</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">To use our service, you must authorize YouTube Organizer to access your YouTube data through Google OAuth 2.0. This authorization:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">Grants read-only access to publicly available YouTube data</li>
      <li style="margin-bottom: 0.5rem;">Uses your personal 10,000 units/day YouTube API quota</li>
      <li style="margin-bottom: 0.5rem;">Can be revoked at any time through <a href="https://security.google.com/settings/security/permissions" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">Google security settings</a></li>
      <li style="margin-bottom: 0.5rem;">Stores encrypted OAuth tokens securely in our database</li>
    </ul>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin: 1.5rem 0 0.75rem 0; color: ${args.theme.var.color.text};">3.2 API Usage Limits</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">You acknowledge that:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">YouTube API usage is subject to quota limits imposed by Google</li>
      <li style="margin-bottom: 0.5rem;">Each user has their own 10,000 units/day quota</li>
      <li style="margin-bottom: 0.5rem;">Service functionality may be limited if quota is exceeded</li>
      <li style="margin-bottom: 0.5rem;">We are not responsible for quota limitations or API changes by Google/YouTube</li>
    </ul>
  `
};
'''
      }
    },
    // Section 4: User Accounts and Responsibilities
    {
      id: "terms_section_4",
      L: "Attr",
      P: {
        displayOrder: 6,
        componentName: "Html",
