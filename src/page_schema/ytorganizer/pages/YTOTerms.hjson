  innerHTML: `
    <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">8.1 By You</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">You may delete your account at any time through your account settings. Upon deletion:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
