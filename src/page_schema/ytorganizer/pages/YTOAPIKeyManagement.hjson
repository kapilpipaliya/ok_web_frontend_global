'''
      }
    },
    {
      id: "modal_form",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "form",
  onSubmit: (e) => {
    e.preventDefault();
    args.fns.handleAddAPIKey();
