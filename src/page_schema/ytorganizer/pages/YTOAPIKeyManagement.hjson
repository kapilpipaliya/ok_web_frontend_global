const apiKey = args.contextData.apiKey;
const current = apiKey.P.currentCount || 0;
const limit = apiKey.P.dailyLimit || 10000;
const percentage = args.fns.getUsagePercentage(current, limit);
const isActive = apiKey.P.isActive;

return {
  as: "div",
  text: `${current.toLocaleString()} / ${limit.toLocaleString()} calls (${percentage}%)`,
  "data-percentage": percentage,
  "data-active": isActive
};
''',
        css: '''
const apiKey = args.contextData.apiKey;
const current = apiKey.P.currentCount || 0;
