          '''return {

}'''
        componentName: Html
        key: unique_1
        props:
          '''return {
  as: "button",
  type: "button",
  text: "Load 25 products",
  onClick: async () => {
    // const selected = await shopify.resourcePicker({ type: 'product' });
    // console.log(selected);

    // Call named server function to fetch first 25 products from Shopify
    const response = await args.executeNamedServerFunction({
      functionName: "fetchFirst25Products",
      contextData: {
        // Prefer shop from searchParams (Shopify installs) or from current user/session
        shop: args.searchParams?.shop || args.user?.P?.shop,
      },
    });

    console.log("fetchFirst25Products result:", response?.result);
  }
}'''
      }
    }
