};
''',
        css: '''
return `._id {
  font-size: 0.875rem;
  opacity: 0.9;
  background: rgba(255,255,255,0.1);
  padding: 0.5rem 1rem;
  border-radius: 2rem;
  
  @media (max-width: 768px) {
    font-size: 0.75rem;
    padding: 0.375rem 0.75rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_playlists_container",
