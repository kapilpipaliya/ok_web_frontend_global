  @media (max-width: 768px) {
    font-size: 1.5rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_playlists_stats",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const playlistCount = args.fns.playlists().length;
return {
