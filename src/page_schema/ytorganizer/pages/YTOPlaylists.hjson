return `._id {
  padding: 1.5rem;
  max-width: 1400px;
  margin: 0 auto;
  min-height: 60vh;
  
  @media (max-width: 768px) {
    padding: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_playlists_empty_state",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
