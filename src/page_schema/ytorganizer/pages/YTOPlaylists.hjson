return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 4rem 2rem;
  background: ${args.theme.var.color.background_dark_50};
  border-radius: 1rem;
  border: 2px dashed ${args.theme.var.color.border};
  margin-bottom: 2rem;
  
  @media (max-width: 768px) {
