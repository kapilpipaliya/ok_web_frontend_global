  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}`;
'''
      }
    },
    {
      id: "yto_playlists_title_section",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
