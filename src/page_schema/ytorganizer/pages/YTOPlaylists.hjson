    { id: "e7", T: "Attr", S: "yto_playlists_empty_state", E: "yto_playlists_empty_title" },
    { id: "e8", T: "Attr", S: "yto_playlists_empty_state", E: "yto_playlists_empty_description" },
    { id: "e9", T: "Attr", S: "yto_playlists_empty_state", E: "yto_playlists_empty_action" },
    { id: "e10", T: "Attr", S: "yto_playlists_empty_action", E: "yto_playlists_empty_action_icon" },
    { id: "e11", T: "Attr", S: "yto_playlists_empty_action", E: "yto_playlists_empty_action_text" },
    { id: "e12", T: "Attr", S: "yto_playlists_container", E: "yto_playlists_loading" },
    { id: "e13", T: "Attr", S: "yto_playlists_loading", E: "yto_playlists_loading_spinner" },
    { id: "e14", T: "Attr", S: "yto_playlists_loading", E: "yto_playlists_loading_text" },
    { id: "e15", T: "Attr", S: "yto_playlists_container", E: "yto_playlists_list_wrapper" },
    { id: "e16", T: "Attr", S: "yto_playlists_list_wrapper", E: "yto_playlists_list" },
    { id: "e17", T: "Attr", S: "yto_playlists_list", E: "yto_playlists_virtual_items" },
    { id: "e18", T: "Attr", S: "yto_playlists_virtual_items", E: "yto_playlists_card_wrapper" },
    { id: "e19", T: "Attr", S: "yto_playlists_card_wrapper", E: "yto_playlists_card" },
    { id: "e20", T: "Attr", S: "yto_playlists_root", E: "yto_playlists_add_button" }
  ]
}