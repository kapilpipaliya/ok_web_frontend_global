{
  vertexes: [
    {
      id: "yto_playlists_page",
      L: "Page",
      P: {
        key: "YTOPlaylists",
        url: "/playlists",
        title: "Playlists - YouTube Organizer",
        description: "Manage your YouTube playlists with custom ordering and organization",
        props: '''
return {
  isNoPermissionCheck: true,
  enabled: true
};
'''
      }
    },
    {
      id: "yto_playlists_layout",
      L: "PageLayout",
      P: {
        componentName: "YTOLayout",
        displayOrder: 1
      }
    },
    {
      id: "yto_playlists_root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  onMount: () => args.fns.loadPlaylists()
};
''',
        fns: '''
// State for playlists data
const [playlists, setPlaylists] = args.createSignal([]);
const [loading, setLoading] = args.createSignal(true);
const [error, setError] = args.createSignal(null);

// Load playlists when component mounts
const loadPlaylists = async () => {
  try {
    setLoading(true);
    setError(null);

    const result = await args.executeNamedServerFunction({
      functionName: "getUserPlaylists",
      contextData: {}
    });

    if (result.error) {
      const errorMessage = result.error;
      setError(errorMessage);
      args.showErrorToast(errorMessage);
    } else if (result.result && result.result.success) {
      // Use raw vertex data directly
      setPlaylists(result.result.data.playlists);
    } else {
      const errorMessage = result.result?.message || result.message || "Failed to load playlists";
      setError(errorMessage);
      args.showErrorToast(errorMessage);
    }
  } catch (err) {
    console.error("Error loading playlists:", err);
    setError("Failed to load playlists");
    args.showErrorToast("Failed to load playlists");
  } finally {
    setLoading(false);
  }
};

// Handle playlist submission
const handlePlaylistSubmit = (data) => {
  // Reload playlists after adding new one
  loadPlaylists();
};

return {
  playlists,
  loading,
  error,
  loadPlaylists,
  handlePlaylistSubmit
};
'''
      }
    },
    {
      id: "yto_playlists_header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.primary};
  color: ${args.theme.var.color.primary_text};
  padding: 1.5rem;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);

  @media (max-width: 768px) {
    padding: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_playlists_header_content",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}`;
'''
      }
    },
    {
      id: "yto_playlists_title_section",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}`;
'''
      }
    },
    {
      id: "yto_playlists_icon",
      L: "Attr",
      P: {
