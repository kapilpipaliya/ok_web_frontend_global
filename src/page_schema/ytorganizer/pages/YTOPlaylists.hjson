        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.success};
  color: ${args.theme.var.color.success_text};
  padding: 1.5rem;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  
  @media (max-width: 768px) {
    padding: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "yto_playlists_header_content",
      L: "Attr",
