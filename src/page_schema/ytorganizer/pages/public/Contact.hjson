''',
        css: '''
return `._id {
  font-size: 1.1rem;
  line-height: 1.6;
  color: ${args.theme.var.color.muted};
  margin-bottom: 1rem;
  text-align: center;
}`;
'''
      }
    },
    {
      id: "contact_owner_info",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "YSaar (KAPIL MULJIBHAI PIPALIYA)"
};
''',
        css: '''
return `._id {
