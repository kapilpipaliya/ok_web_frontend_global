        css:
          '''
const tier = args.contextData.tier;
const isPopular = tier?.popular;

return `._id {
  width: 100%;
  background: ${args.theme.var.color.background};
  border: ${isPopular ? `2px solid ${args.theme.var.color.primary}` : `1px solid ${args.theme.var.color.border}`};
  border-radius: 1rem;
  padding: ${isPopular ? '2.5rem 1.75rem' : '2rem 1.5rem'};
  display: flex;
  flex-direction: column;
  gap: 1rem;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
  position: relative;
  transform: ${isPopular ? 'scale(1.05)' : 'scale(1)'};
  box-shadow: ${isPopular ? `0 12px 32px rgba(0, 0, 0, 0.15), 0 0 0 1px ${args.theme.var.color.primary}` : '0 2px 8px rgba(0, 0, 0, 0.05)'};
  z-index: ${isPopular ? '10' : '1'};
}

._id:hover {
  transform: ${isPopular ? 'scale(1.05) translateY(-8px)' : 'translateY(-8px)'};
  box-shadow: 0 20px 48px rgba(0, 0, 0, 0.2);
  border-color: ${args.theme.var.color.primary};
}

@media (max-width: 1200px) {
  ._id {
    transform: scale(1);
    padding: 2rem 1.5rem;
  }

  ._id:hover {
    transform: translateY(-8px);
  }
}

@media (max-width: 768px) {
  ._id {
    padding: 1.5rem 1rem;
  }
}`;
'''
