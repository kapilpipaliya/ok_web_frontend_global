        displayOrder: 8
        componentName: Html
        props:
          '''
const tier = args.contextData.tier;
const planName = tier?.name?.toLowerCase() || "basic";

return {
  as: "button",
  text: tier?.buttonText || "Get Started",
  onClick: () => {
    // Track conversion
    if (window.gtag) {
      window.gtag('event', 'conversion', {
        'send_to': 'AW-17540558480/GTy6CIjJkMIbEJDd_qtB',
        'value': 1.0,
        'currency': 'INR'
      });
    }

    if (planName === "free") {
      // Free plan - just sign up
      args.navigate('/auth/signup');
    } else if (args.user) {
      // User is logged in - go to checkout
      args.navigate(`/checkout?plan=${planName}&cycle=monthly`);
    } else {
      // User not logged in - go to signup with redirect
      args.navigate(`/auth/signup?redirect=/checkout?plan=${planName}&cycle=monthly`);
    }
  }
};
'''
      }
    }
