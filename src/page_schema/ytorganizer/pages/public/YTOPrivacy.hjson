  text: "5. Your Rights and Data Control"
};
''',
        css: '''
return `._id {
  font-size: 1.75rem;
  font-weight: 600;
  margin-bottom: 1rem;
  color: ${args.theme.var.color.text};
  border-bottom: 2px solid ${args.theme.var.color.border};
  padding-bottom: 0.5rem;
}`;
'''
      }
    },
    {
      id: "privacy_section_5_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  innerHTML: `
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">You have comprehensive rights regarding your personal data:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 1rem;"><strong>Access:</strong> Request a copy of all personal data we hold about you in a portable format (JSON or CSV)</li>
      <li style="margin-bottom: 1rem;"><strong>Correction:</strong> Update or correct any inaccurate information in your account settings at any time</li>
      <li style="margin-bottom: 1rem;"><strong>Deletion:</strong> Request deletion of your account and all associated data. We will permanently delete your data within 7 calendar days (YouTube data) or 30 days (account data)</li>
      <li style="margin-bottom: 1rem;"><strong>YouTube Access Revocation:</strong> Revoke YSaar's access to your YouTube data at any time through <a href="https://security.google.com/settings/security/permissions" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline; font-weight: 600;">Google's security settings page</a>. We will delete all YouTube data within 30 days of revocation.</li>
      <li style="margin-bottom: 1rem;"><strong>Data Portability:</strong> Export your custom notes, tags, and organization preferences to take them to another service</li>
      <li style="margin-bottom: 1rem;"><strong>Objection:</strong> Object to processing of your personal data for specific purposes</li>
      <li style="margin-bottom: 1rem;"><strong>Restriction:</strong> Request that we limit how we use your data while maintaining your account</li>
      <li style="margin-bottom: 1rem;"><strong>Withdraw Consent:</strong> Withdraw consent for data processing at any time (note: this may limit service functionality)</li>
    </ul>

    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem; padding: 1rem; background: ${args.theme.var.color.primary_light_100}; border-radius: 0.375rem; border-left: 3px solid ${args.theme.var.color.primary};"><strong>Important for EU Users:</strong> These rights are guaranteed under the General Data Protection Regulation (GDPR). If you are located in the European Economic Area (EEA), you have additional rights including the right to lodge a complaint with your local data protection authority.</p>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">How to Exercise Your Rights</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">To exercise any of these rights, you can:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">Use the settings and data management tools in your account dashboard</li>
      <li style="margin-bottom: 0.5rem;"><strong>Disconnect YouTube:</strong> Visit <a href="/settings" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">Settings → YouTube Connection</a> to disconnect your YouTube account. This will delete your OAuth tokens and stop all access to your YouTube data.</li>
      <li style="margin-bottom: 0.5rem;">Contact us at <a href="mailto:support@ysaar.com" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">privacy@ysaar.com</a></li>
      <li style="margin-bottom: 0.5rem;">Submit a data request through our support system</li>
    </ul>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-top: 1rem;">We will respond to your request within 30 days and may verify your identity before processing sensitive requests.</p>
  `
};
'''
      }
    },
    // Section 6: International Data Transfers
    {
      id: "privacy_section_6",
      L: "Attr",
      P: {
