return {
  as: "div",
  innerHTML: `
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">If you have any questions, concerns, or requests regarding this Privacy Policy or our data practices, please contact us:</p>
    <div style="padding: 1.5rem; background: ${args.theme.var.color.background_light_100}; border-radius: 0.5rem; margin-top: 1rem;">
      <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 0.75rem;"><strong>Email:</strong> <a href="mailto:support@ysaar.com" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">privacy@ysaar.com</a></p>
      <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 0.75rem;"><strong>Website:</strong> <a href="https://ysaar.com" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">ysaar.com</a></p>
      <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin: 0;"><strong>Support:</strong> Available through your account dashboard</p>
    </div>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-top: 1.5rem;">We are committed to resolving any privacy concerns you may have and will respond to your inquiry within 30 days.</p>
  `
};
