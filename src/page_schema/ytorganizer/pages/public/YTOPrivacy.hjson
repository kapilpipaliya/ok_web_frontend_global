{
  vertexes: [
    {
      id: "yto_privacy_page",
      L: "Page",
      P: {
        key: "YTOPrivacy",
        url: "/privacy",
        title: "Privacy Policy - YSaar",
        description: "Privacy policy for YSaar - Learn how we handle your YouTube data in compliance with Google's API Services requirements",
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "favicon_link",
      L: "Attr",
      P: {
        displayOrder: 0.5,
        componentName: "Html",
        props: '''
return {
  as: "link",
  rel: "icon",
  href: "/api/file/downloadCompanyFavicon"
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
        componentName: "YTOPublicLayout",
        displayOrder: 1
      }
    },
    // Main Content Section
    {
      id: "privacy_main",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "main"
};
''',
        css: '''
return `._id {
  flex: 1;
  max-width: 900px;
  margin: 0 auto;
  padding: 3rem 1.5rem;
  width: 100%;
}

@media (max-width: 768px) {
  ._id {
    padding: 2rem 1rem;
  }
}`;
'''
      }
    },
    // Title
    {
      id: "privacy_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: "Privacy Policy"
};
''',
        css: '''
return `._id {
  font-size: 2.5rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  color: ${args.theme.var.color.text};
}

@media (max-width: 768px) {
  ._id {
    font-size: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "privacy_updated",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const date = new Date().toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
return {
  as: "p",
  text: `Last updated: ${date}`
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.muted};
  margin-bottom: 2rem;
  font-size: 0.875rem;
}`;
'''
      }
    },
    // Introduction
    {
      id: "privacy_intro",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  margin-bottom: 2.5rem;
}`;
'''
      }
    },
    {
      id: "privacy_intro_text",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "YSaar (\"we\", \"our\", or \"us\") is committed to protecting your privacy and ensuring transparency in how we handle your data. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you use our service, which integrates with YouTube API Services."
};
''',
        css: '''
return `._id {
  line-height: 1.7;
  color: ${args.theme.var.color.text};
  margin-bottom: 1rem;
  font-size: 1.05rem;
}`;
'''
      }
    },
    // YouTube API Services Notice (MANDATORY)
    {
      id: "privacy_youtube_notice",
      L: "Attr",
      P: {
        displayOrder: 4,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  margin-bottom: 2.5rem;
  padding: 1.5rem;
  background: ${args.theme.var.color.info_light_100};
  border-left: 4px solid ${args.theme.var.color.info};
  border-radius: 0.5rem;
}`;
'''
      }
    },
    {
      id: "privacy_youtube_notice_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h2",
  text: "Important: YouTube API Services"
};
''',
        css: '''
return `._id {
  font-size: 1.25rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color: ${args.theme.var.color.info_text};
}`;
'''
      }
    },
    {
      id: "privacy_youtube_notice_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  innerHTML: `
    <p style="line-height: 1.7; color: ${args.theme.var.color.primary_text}; margin-bottom: 1rem; font-size: 1.05rem;">YSaar uses <strong>YouTube API Services</strong> to access and organize your YouTube content. By using our service, you agree to be bound by:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.primary_text}; margin-bottom: 1rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;"><strong><a href="https://www.youtube.com/t/terms" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">YouTube Terms of Service</a></strong></li>
      <li style="margin-bottom: 0.5rem;"><strong><a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">Google Privacy Policy</a></strong></li>
      <li style="margin-bottom: 0.5rem;"><strong><a href="https://developers.google.com/youtube/terms/developer-policies" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">YouTube API Services Developer Policies</a></strong></li>
    </ul>
    <p style="line-height: 1.7; color: ${args.theme.var.color.primary_text}; font-size: 1.05rem;"><strong>You can revoke YSaar's access to your data at any time</strong> via the <a href="https://security.google.com/settings/security/permissions" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline; font-weight: 600;">Google security settings page</a>.</p>
  `
};
'''
      }
    },
    // Section 1: Information We Collect
    {
      id: "privacy_section_1",
      L: "Attr",
      P: {
        displayOrder: 5,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  margin-bottom: 2.5rem;
}`;
'''
      }
    },
    {
      id: "privacy_section_1_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h2",
  text: "1. Information We Collect and Access"
};
''',
        css: '''
return `._id {
  font-size: 1.75rem;
  font-weight: 600;
  margin-bottom: 1rem;
  color: ${args.theme.var.color.text};
  border-bottom: 2px solid ${args.theme.var.color.border};
  padding-bottom: 0.5rem;
}`;
'''
      }
    },
    {
      id: "privacy_section_1_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  innerHTML: `
    <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">1.1 YouTube Data We Access</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">When you connect your YouTube account through <strong>per-user Google OAuth 2.0</strong>, we access and temporarily store the following YouTube data via YouTube API Services:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;"><strong>Channel Information:</strong> Channel name, description, thumbnail, subscriber count, video count, upload dates</li>
      <li style="margin-bottom: 0.5rem;"><strong>Playlist Information:</strong> Playlist titles, descriptions, thumbnails, video counts, privacy status</li>
      <li style="margin-bottom: 0.5rem;"><strong>Video Metadata:</strong> Video titles, descriptions, thumbnails, channel information, publication dates</li>
      <li style="margin-bottom: 0.5rem;"><strong>Public Statistics:</strong> View counts, like counts, and other publicly available metrics</li>
      <li style="margin-bottom: 0.5rem;"><strong>OAuth Tokens:</strong> We securely store your encrypted Google OAuth access and refresh tokens to maintain your YouTube connection. Tokens are encrypted using AES-256-GCM encryption and stored securely in our database.</li>
    </ul>
    <p style="line-height: 1.7; color: ${args.theme.var.color.info_light_100_text}; margin-bottom: 1rem; padding: 1rem; background: ${args.theme.var.color.info_light_100}; border-radius: 0.375rem; border-left: 3px solid ${args.theme.var.color.info};"><strong>Per-User OAuth:</strong> Each user connects their own YouTube account with their personal API quota. Your OAuth connection is independent and private to your account only.</p>
    <p style="line-height: 1.7; color: ${args.theme.var.color.warning_light_100_text}; margin-bottom: 1.5rem; padding: 1rem; background: ${args.theme.var.color.warning_light_100}; border-radius: 0.375rem; border-left: 3px solid ${args.theme.var.color.warning};"><strong>Important:</strong> We only access publicly available YouTube data. We do <strong>not</strong> access your private videos, watch history, or any data you have not explicitly made public on YouTube. We never download or cache actual video files.</p>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">1.2 Account Information</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">When you create an account with YSaar, we collect:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">Email address (for authentication and notifications)</li>
      <li style="margin-bottom: 0.5rem;">Username (for your account identification)</li>
      <li style="margin-bottom: 0.5rem;">Password (encrypted using industry-standard bcrypt hashing)</li>
      <li style="margin-bottom: 0.5rem;">Profile preferences and settings</li>
    </ul>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">1.3 User-Generated Organization Data</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">We store your personal organization preferences and notes:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">Custom names and tags for channels and playlists</li>
      <li style="margin-bottom: 0.5rem;">Personal notes and comments on videos</li>
      <li style="margin-bottom: 0.5rem;">Favorite/bookmark selections</li>
      <li style="margin-bottom: 0.5rem;">Custom playlist ordering and organization preferences</li>
      <li style="margin-bottom: 0.5rem;">Watch status and progress tracking</li>
    </ul>
  `
};
'''
      }
    },
    // Section 2: How We Use Your Information
    {
      id: "privacy_section_2",
      L: "Attr",
      P: {
        displayOrder: 6,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  margin-bottom: 2.5rem;
}`;
'''
      }
    },
    {
      id: "privacy_section_2_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h2",
  text: "2. How We Use Your Information"
};
''',
        css: '''
return `._id {
  font-size: 1.75rem;
  font-weight: 600;
  margin-bottom: 1rem;
  color: ${args.theme.var.color.text};
  border-bottom: 2px solid ${args.theme.var.color.border};
  padding-bottom: 0.5rem;
}`;
'''
      }
    },
    {
      id: "privacy_section_2_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  innerHTML: `
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">We use the collected information <strong>solely</strong> for the following legitimate purposes:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.75rem;"><strong>Service Provision:</strong> To provide, operate, and maintain the YSaar service, including displaying and organizing your YouTube channels, playlists, and videos</li>
      <li style="margin-bottom: 0.75rem;"><strong>Data Synchronization:</strong> To periodically refresh your YouTube data (channels, playlists, video metadata) to keep your collection up-to-date</li>
      <li style="margin-bottom: 0.75rem;"><strong>Organization Features:</strong> To enable you to add custom names, tags, notes, and organize your YouTube content according to your preferences</li>
      <li style="margin-bottom: 0.75rem;"><strong>Account Management:</strong> To create and manage your account, authenticate your identity, and provide customer support</li>
      <li style="margin-bottom: 0.75rem;"><strong>Service Improvement:</strong> To understand usage patterns, improve features, optimize performance, and develop new functionality</li>
      <li style="margin-bottom: 0.75rem;"><strong>Communication:</strong> To send you service-related notifications, updates about new features, and respond to your inquiries</li>
      <li style="margin-bottom: 0.75rem;"><strong>Security:</strong> To detect, prevent, and address technical issues, fraud, abuse, and unauthorized access</li>
    </ul>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; padding: 1rem; background: ${args.theme.var.color.success_light_100}; border-radius: 0.375rem; border-left: 3px solid ${args.theme.var.color.success};"><strong>We do NOT:</strong> Use your YouTube data for advertising, sell your data to third parties, train AI models on your content, or use your data for any purpose other than providing you with the YSaar service.</p>
  `
};
'''
      }
    },
    // Section 3: Data Storage and Retention
    {
      id: "privacy_section_3",
      L: "Attr",
      P: {
        displayOrder: 7,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  margin-bottom: 2.5rem;
}`;
'''
      }
    },
    {
      id: "privacy_section_3_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h2",
  text: "3. Data Storage, Retention, and Security"
};
''',
        css: '''
return `._id {
  font-size: 1.75rem;
  font-weight: 600;
  margin-bottom: 1rem;
  color: ${args.theme.var.color.text};
  border-bottom: 2px solid ${args.theme.var.color.border};
  padding-bottom: 0.5rem;
}`;
'''
      }
    },
    {
      id: "privacy_section_3_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  innerHTML: `
    <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">3.1 YouTube API Data Retention</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;"><strong>In compliance with YouTube API Services Terms:</strong></p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;"><strong>Maximum Storage Period:</strong> YouTube data (channel info, playlist metadata, video details) is stored for a maximum of 30 calendar days before being refreshed or deleted</li>
      <li style="margin-bottom: 0.5rem;"><strong>Authorization Verification:</strong> We verify that your YouTube authorization remains valid every 30 days</li>
      <li style="margin-bottom: 0.5rem;"><strong>Automatic Deletion:</strong> If you revoke access through Google security settings, we delete all your YouTube data within 30 calendar days</li>
      <li style="margin-bottom: 0.5rem;"><strong>User-Initiated Deletion:</strong> If you request data deletion through our service, we delete your YouTube data within 7 calendar days</li>
      <li style="margin-bottom: 0.5rem;"><strong>No Permanent Caching:</strong> We do not permanently cache YouTube videos, thumbnails, or other media files beyond the necessary display period</li>
    </ul>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">3.2 Your Personal Data Retention</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">Your account information and personal notes are retained as follows:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;"><strong>Account Data:</strong> Retained as long as your account is active</li>
      <li style="margin-bottom: 0.5rem;"><strong>Custom Notes & Tags:</strong> Retained indefinitely as part of your personal data until you delete them or close your account</li>
      <li style="margin-bottom: 0.5rem;"><strong>Inactive Accounts:</strong> Accounts inactive for more than 2 years may be deleted after email notification</li>
      <li style="margin-bottom: 0.5rem;"><strong>Account Deletion:</strong> When you delete your account, all your personal data is permanently deleted within 30 days</li>
    </ul>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">3.3 Security Measures</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">We implement industry-standard security measures to protect your data:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;"><strong>Encryption in Transit:</strong> All data transmission uses HTTPS/TLS encryption</li>
      <li style="margin-bottom: 0.5rem;"><strong>Encryption at Rest:</strong> Sensitive data is encrypted in our Neo4j database</li>
      <li style="margin-bottom: 0.5rem;"><strong>Password Security:</strong> Passwords are hashed using bcrypt with salt</li>
      <li style="margin-bottom: 0.5rem;"><strong>Per-User OAuth 2.0:</strong> Each user connects their own YouTube account using secure Google OAuth 2.0 authentication. This means:
        <ul style="padding-left: 1.5rem; margin-top: 0.5rem;">
          <li style="margin-bottom: 0.5rem;">Each user has their own personal YouTube API quota (not shared)</li>
          <li style="margin-bottom: 0.5rem;">OAuth access and refresh tokens are encrypted using AES-256-GCM encryption before storage</li>
          <li style="margin-bottom: 0.5rem;">Tokens are automatically refreshed when they expire</li>
          <li style="margin-bottom: 0.5rem;">We detect when users revoke access through Google settings and stop accessing their data immediately</li>
        </ul>
      </li>
      <li style="margin-bottom: 0.5rem;"><strong>Access Control:</strong> Strict role-based access control limits who can access your data</li>
      <li style="margin-bottom: 0.5rem;"><strong>Regular Audits:</strong> We conduct regular security audits and updates</li>
      <li style="margin-bottom: 0.5rem;"><strong>Secure Infrastructure:</strong> Data is stored on secure servers with firewall protection and intrusion detection</li>
    </ul>
  `
};
'''
      }
    },
    // Section 4: Data Sharing and Third Parties
    {
      id: "privacy_section_4",
      L: "Attr",
      P: {
        displayOrder: 8,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  margin-bottom: 2.5rem;
}`;
'''
      }
    },
    {
      id: "privacy_section_4_title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h2",
  text: "4. Data Sharing and Third-Party Services"
};
''',
        css: '''
return `._id {
  font-size: 1.75rem;
  font-weight: 600;
  margin-bottom: 1rem;
  color: ${args.theme.var.color.text};
  border-bottom: 2px solid ${args.theme.var.color.border};
  padding-bottom: 0.5rem;
}`;
'''
      }
    },
    {
      id: "privacy_section_4_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  innerHTML: `
    <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">4.1 YouTube API Services</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem;">YSaar uses <strong>YouTube API Services</strong> provided by Google LLC. When you connect your YouTube account:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">Your authentication is handled directly by Google through OAuth 2.0</li>
      <li style="margin-bottom: 0.5rem;">We access your YouTube data only through official Google APIs</li>
      <li style="margin-bottom: 0.5rem;">By using our service, you agree to <a href="https://www.youtube.com/t/terms" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">YouTube's Terms of Service</a> and <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">Google's Privacy Policy</a></li>
      <li style="margin-bottom: 0.5rem;">You can revoke our access at any time through <a href="https://security.google.com/settings/security/permissions" target="_blank" rel="noopener noreferrer" style="color: ${args.theme.var.color.primary}; text-decoration: underline;">Google's security settings</a></li>
    </ul>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">4.2 No Third-Party Data Sharing</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;"><strong>We do NOT share, sell, rent, or trade your YouTube data or personal information with third parties for their marketing or advertising purposes.</strong></p>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">We may share your data only in the following limited circumstances:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;"><strong>With Your Consent:</strong> When you explicitly authorize us to share specific information</li>
      <li style="margin-bottom: 0.5rem;"><strong>Service Providers:</strong> With trusted hosting and infrastructure providers who help us operate the service (e.g., cloud hosting) under strict data protection agreements. These providers cannot use your data for their own purposes.</li>
      <li style="margin-bottom: 0.5rem;"><strong>Legal Requirements:</strong> When required by law, court order, or government regulation, or to protect our legal rights, prevent fraud, or ensure user safety</li>
      <li style="margin-bottom: 0.5rem;"><strong>Business Transfers:</strong> In the event of a merger, acquisition, or sale of assets, with advance notice to you</li>
    </ul>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">4.3 Analytics and Cookies</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">We use essential cookies for:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;"><strong>Authentication:</strong> Keeping you signed in securely</li>
      <li style="margin-bottom: 0.5rem;"><strong>Preferences:</strong> Remembering your settings and theme choices</li>
      <li style="margin-bottom: 0.5rem;"><strong>Performance:</strong> Understanding how users interact with our service to improve functionality</li>
    </ul>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-top: 1rem;">You can control cookies through your browser settings, but disabling certain cookies may affect service functionality.</p>
  `
};
'''
      }
    },
    // Section 5: Your Rights and Control
    {
      id: "privacy_section_5",
