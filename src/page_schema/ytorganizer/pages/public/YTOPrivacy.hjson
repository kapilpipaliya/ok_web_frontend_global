      }
    },
    {
      id: "privacy_section_6_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  innerHTML: `
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">YSaar may store and process your data in various locations to provide our service globally. If you are located in the European Economic Area (EEA), United Kingdom, or Switzerland, please be aware that:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">Your data may be transferred to and processed in countries outside the EEA</li>
      <li style="margin-bottom: 0.5rem;">We ensure appropriate safeguards are in place for international transfers, including standard contractual clauses</li>
      <li style="margin-bottom: 0.5rem;">Your data is protected by this Privacy Policy regardless of where it is processed</li>
    </ul>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">EU User Consent Policy</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">In compliance with YouTube API Services requirements and GDPR:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">We obtain your explicit consent before accessing your YouTube data</li>
      <li style="margin-bottom: 0.5rem;">You have the right to withdraw consent at any time through Google's security settings</li>
      <li style="margin-bottom: 0.5rem;">We comply with all GDPR requirements for lawful data processing</li>
      <li style="margin-bottom: 0.5rem;">You have the right to lodge complaints with your local data protection authority</li>
    </ul>
  `
};
'''
      }
