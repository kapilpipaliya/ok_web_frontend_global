        displayOrder: 4,
        componentName: "Html",
        contextName: "userStats",
        serverFunction: '''
try {
  // Execute the getUserCount function
  const result = await args.executeNamedServerFunction({
    functionName: "getUserCount",
    contextData: {}
  });

  if (result?.result?.success) {
    return result.result.data;
  }

  return { totalUsers: 0 };
} catch (error) {
  console.error("Error loading user count:", error);
  return { totalUsers: 0 };
}
''',
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  padding: 4rem 2rem;
