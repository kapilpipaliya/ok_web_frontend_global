        css: '''
return `._id {
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.primary};
  border: 3px solid ${args.theme.var.color.background};
  padding: 1rem 2.5rem;
  border-radius: 0.75rem;
  font-size: 1.125rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.2), 0 0 0 2px rgba(255, 255, 255, 0.1);
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

._id:hover {
  background: ${args.theme.var.color.background};
  transform: translateY(-3px) scale(1.02);
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.25), 0 0 0 3px rgba(255, 255, 255, 0.15);
  border-color: ${args.theme.var.color.background};
}

._id:active {
  transform: translateY(-1px) scale(1.01);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
}

@media (max-width: 768px) {
  ._id {
    padding: 0.875rem 2rem;
    font-size: 1rem;
  }
}`;
