  innerHTML: `
    <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; color: ${args.theme.var.color.text};">8.1 Payment Processing</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">When you subscribe to our paid services:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">Payments are processed securely through our third-party payment processor</li>
      <li style="margin-bottom: 0.5rem;">You authorize us to charge your chosen payment method</li>
      <li style="margin-bottom: 0.5rem;">All fees are quoted in the currency displayed at checkout</li>
      <li style="margin-bottom: 0.5rem;">You are responsible for all applicable taxes</li>
    </ul>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin: 1.5rem 0 0.75rem 0; color: ${args.theme.var.color.text};">8.2 No Cancellation or Refund Policy</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.error_light_100_text}; margin-bottom: 1rem; padding: 1rem; background: ${args.theme.var.color.error_light_100}; border-radius: 0.375rem; border-left: 3px solid ${args.theme.var.color.error};"><strong>Important:</strong> All payments are final. Once a payment is processed, we do not provide cancellations or refunds under any circumstances.</p>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">This policy applies to:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
      <li style="margin-bottom: 0.5rem;">Subscription fees</li>
      <li style="margin-bottom: 0.5rem;">One-time purchases</li>
      <li style="margin-bottom: 0.5rem;">Upgrades or additional features</li>
      <li style="margin-bottom: 0.5rem;">Any other payments made to YSaar</li>
    </ul>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">Please ensure you understand the service features before making a payment. We encourage you to use any free trial periods or free tiers to evaluate the service before subscribing.</p>

    <h3 style="font-size: 1.25rem; font-weight: 600; margin: 1.5rem 0 0.75rem 0; color: ${args.theme.var.color.text};">8.3 Subscription Management</h3>
    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">For recurring subscriptions:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; padding-left: 1.5rem;">
