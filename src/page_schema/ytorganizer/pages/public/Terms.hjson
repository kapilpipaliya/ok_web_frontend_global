    <p style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1rem;">You are responsible for:</p>
    <ul style="line-height: 1.7; color: ${args.theme.var.color.text}; margin-bottom: 1.5rem; padding-left: 1.5rem;">
