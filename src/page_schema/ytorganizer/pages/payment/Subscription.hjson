{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        signinRequired: true
        fns:
          '''
const [subscriptionData, setSubscriptionData] = args.createSignal(null);
const [isLoading, setIsLoading] = args.createSignal(true);

// Load subscription data
const loadSubscriptionData = async () => {
  try {
    setIsLoading(true);
    const response = await args.executeNamedServerFunction({
      functionName: "getUserSubscription",
      contextData: {}
    });

    // Check for errors in the response itself
    if (response.error) {
      args.showErrorToast(response.error);
    } else if (response.result?.success) {
      // Access the nested result
      setSubscriptionData(response.result.data);
    } else {
      args.showErrorToast(response.result?.message || "Failed to load subscription");
    }
  } catch (error) {
    args.showErrorToast(error.message);
  } finally {
    setIsLoading(false);
  }
};

// Format date
const formatDate = (dateString) => {
  if (!dateString) return "N/A";
  const date = new Date(dateString);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric"
  });
};

// Get plan color
const getPlanColor = (plan) => {
  const colors = {
    free: args.theme.var.color.text_dark_400,
    basic: args.theme.var.color.info,
    pro: args.theme.var.color.primary,
    unlimited: args.theme.var.color.success
  };
  return colors[plan] || args.theme.var.color.text;
};

return {
  enabled: true,
  subscriptionData,
  isLoading,
  loadSubscriptionData,
  formatDate,
  getPlanColor
};
'''
        key: Subscription
        url: /subscription
        props:
          '''
return {
  isNoPermissionCheck: true,
  onMount: args.fns.loadSubscriptionData
};
'''
      }
    }
