const data = args.fns.subscriptionData();
const percentage = data?.quotaPercentage || 0;
const isHigh = percentage >= 80;
const barColor = isHigh ? args.theme.var.color.warning : args.theme.var.color.primary;
return `._id {
  width: ${percentage}%;
  height: 100%;
  background: ${barColor};
  transition: width 0.3s ease;
}`;
'''
