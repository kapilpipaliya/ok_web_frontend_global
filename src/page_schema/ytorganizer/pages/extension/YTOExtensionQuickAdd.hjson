    const closeWin = args.fns.closeWindow?.();

    if (sendMsg) {
      sendMsg({
        type: 'CLOSE_MODAL'
      });
    } else if (closeWin) {
      // In tab mode, just close the window
      closeWin();
    }
  }
};
