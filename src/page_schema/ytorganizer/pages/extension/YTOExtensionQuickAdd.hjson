{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "YTOExtensionQuickAdd",
        url: "/extension/quick-add",
        signinRequired: true,
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "page_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
// URL parameters parsed from location (set in onMount)
const [contentType, setContentType] = args.createSignal(null);
const [youtubeUrl, setYoutubeUrl] = args.createSignal(null);
const [youtubeId, setYoutubeId] = args.createSignal(null);
const [isInIframe, setIsInIframe] = args.createSignal(false);

// State management
const [isSaving, setIsSaving] = args.createSignal(false);
const [saveSuccess, setSaveSuccess] = args.createSignal(false);
const [saveError, setSaveError] = args.createSignal(null);
const [customName, setCustomName] = args.createSignal("");
const [ownerships, setOwnerships] = args.createSignal([]);
const [selectedOwnershipId, setSelectedOwnershipId] = args.createSignal(null);
const [ownershipsLoading, setOwnershipsLoading] = args.createSignal(true);
const [isDuplicateWarning, setIsDuplicateWarning] = args.createSignal(false);
const [duplicateCheckLoading, setDuplicateCheckLoading] = args.createSignal(false);

// Check if channel/playlist already exists
const checkForDuplicate = async (ownershipId) => {
  const currentYoutubeId = youtubeId();
  const currentContentType = contentType();

  if (!ownershipId || !currentYoutubeId) {
    return;
  }

  try {
    setDuplicateCheckLoading(true);
    setIsDuplicateWarning(false);

    let functionName;
    if (currentContentType === 'channel') {
      functionName = 'checkChannelExists';
    } else if (currentContentType === 'playlist') {
      functionName = 'checkPlaylistExists';
    } else {
      return;
    }

    const result = await args.executeNamedServerFunction({
      functionName,
      contextData: {
        youtubeId: currentYoutubeId,
        ownershipId: ownershipId
      }
    });

    if (result?.result?.exists) {
      setIsDuplicateWarning(true);
    }
  } catch (error) {
    console.error('Error checking for duplicate:', error);
  } finally {
    setDuplicateCheckLoading(false);
  }
};

// Fetch available ownerships
const fetchOwnerships = async () => {
  try {
    setOwnershipsLoading(true);
    const result = await args.executeNamedServerFunction({
      functionName: "getAllYouTubeOwnerships",
      contextData: {}
    });

    if (result?.result?.success && result?.result?.data) {
      const ownershipsData = result.result.data;
      // Filter only connected ownerships
      const connectedOwnerships = ownershipsData
        .filter(item => item.isConnected)
        .map(item => item.ownership);

      setOwnerships(connectedOwnerships);

      // Auto-select primary or first ownership
      if (connectedOwnerships.length > 0) {
        const primaryOwnership = connectedOwnerships.find(o => o.P.isPrimary);
        const defaultOwnership = primaryOwnership || connectedOwnerships[0];
        setSelectedOwnershipId(defaultOwnership.P.key);

        // Check for duplicates with selected ownership
        await checkForDuplicate(defaultOwnership.P.key);
      }
    }
  } catch (error) {
    console.error('Error fetching ownerships:', error);
    setSaveError('Failed to load YouTube accounts');
  } finally {
    setOwnershipsLoading(false);
  }
};

// Helper to send messages to parent window (set in onMount)
let sendMessageToParent = null;
let closeWindow = null;
let openInNewTab = null;

// Handle save
const handleSave = async () => {
  try {
    setIsSaving(true);
    setSaveError(null);
    setSaveSuccess(false);

    const ownershipId = selectedOwnershipId();
    if (!ownershipId) {
      throw new Error('Please select a YouTube account');
    }

    const name = customName();
    const currentContentType = contentType();
    const currentYoutubeUrl = youtubeUrl();

    let functionName, contextData;

    if (currentContentType === 'channel') {
      functionName = 'saveChannel';
      contextData = {
        url: currentYoutubeUrl,
        name: name || null,
        ownershipId: ownershipId,
        refresh: false,
        priority: 'normal'
      };
    } else if (currentContentType === 'playlist') {
      functionName = 'savePlaylist';
      contextData = {
        url: currentYoutubeUrl,
        name: name || null,
        ownershipId: ownershipId,
        refresh: false,
        priority: 'normal'
      };
    } else {
      throw new Error('Unsupported content type');
    }

    const result = await args.executeNamedServerFunction({
      functionName,
      contextData
    });

    if (result?.result?.success) {
      setSaveSuccess(true);
      args.showSuccessToast(result.result.message || 'Saved successfully!');

      // Send success message to parent (modal or extension popup)
      if (sendMessageToParent) {
        sendMessageToParent({
          type: 'SAVE_SUCCESS',
          message: result.result.message || 'Saved successfully!'
        });
      }

      // Auto-close after 2 seconds (for tab mode)
      if (closeWindow) {
        setTimeout(() => {
          closeWindow();
        }, 2000);
      }
    } else {
      throw new Error(result?.result?.message || 'Failed to save');
    }
  } catch (error) {
    console.error('Error saving:', error);
    setSaveError(error.message || 'Failed to save');
    args.showErrorToast(error.message || 'Failed to save');

    // Send error message to parent (modal or extension popup)
    if (sendMessageToParent) {
      sendMessageToParent({
        type: 'SAVE_ERROR',
        message: error.message || 'Failed to save'
      });
    }
  } finally {
    setIsSaving(false);
  }
};

// Initialize on mount
const onMount = () => {
  // Parse URL parameters from window.location
  const urlParams = new URLSearchParams(window.location.search);
  setContentType(urlParams.get('type')); // channel or playlist
  setYoutubeUrl(urlParams.get('url'));
  setYoutubeId(urlParams.get('id'));

  // Check if in iframe
  setIsInIframe(window.self !== window.top);

  // Setup message sender
  if (window.opener || window.parent !== window) {
    sendMessageToParent = (message) => {
      window.parent.postMessage(message, '*');
    };
  }

  // Setup close handler
  if (!window.opener && window.parent === window) {
    closeWindow = () => {
      window.close();
    };
  }

  // Setup open in new tab helper
  openInNewTab = (url) => {
    window.open(url, '_blank');
  };

  fetchOwnerships();
};

return {
  contentType,
  youtubeUrl,
  youtubeId,
  isInIframe,
  isSaving,
  saveSuccess,
  saveError,
  customName,
  setCustomName,
  ownerships,
  selectedOwnershipId,
  setSelectedOwnershipId,
  ownershipsLoading,
  isDuplicateWarning,
  duplicateCheckLoading,
  checkForDuplicate,
  handleSave,
  sendMessageToParent: () => sendMessageToParent,
  closeWindow: () => closeWindow,
  openInNewTab: () => openInNewTab,
  onMount
};
''',
        props: '''
return {
  as: "div",
  onMount: args.fns.onMount
};
''',
        css: '''
