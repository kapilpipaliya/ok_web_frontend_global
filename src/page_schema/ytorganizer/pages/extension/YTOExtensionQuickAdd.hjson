    },
    {
      id: "ownership_label",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "label",
  text: "YouTube Account",
  for: "ownership-select"
};
''',
        css: '''
return `._id {
  display: block;
  font-size: 0.875rem;
  font-weight: 600;
