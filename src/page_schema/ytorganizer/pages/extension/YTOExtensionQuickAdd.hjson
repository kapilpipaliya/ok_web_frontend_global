};
''',
        css: '''
return `._id {
  font-size: 1.5rem;
  font-weight: 600;
  margin: 0;
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "main_content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
