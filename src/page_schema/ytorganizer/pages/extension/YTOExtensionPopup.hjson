{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "YTOExtensionPopup",
        url: "/extension/popup",
        signinRequired: true,
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    },
    {
      id: "page_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
const [isLoading, setIsLoading] = args.createSignal(true);
const [stats, setStats] = args.createSignal(null);
const [error, setError] = args.createSignal(null);

// Fetch dashboard stats
const fetchStats = async () => {
  try {
    setIsLoading(true);
    setError(null);

    const result = await args.executeNamedServerFunction({
      functionName: 'getUserYTODetails',
      contextData: {
        userUuid: args.user?.P?.uuid
      }
    });

    if (result.result?.success) {
      const data = result.result.data;
      setStats({
        channels: data.channels?.length || 0,
        playlists: data.playlists?.length || 0,
        videos: data.totalVideos || 0
      });
    } else {
      throw new Error(result.result?.message || 'Failed to load stats');
    }
  } catch (err) {
    console.error('Error loading stats:', err);
    setError(err.message || 'Failed to load dashboard');
  } finally {
    setIsLoading(false);
  }
};

// Initialize on mount
const onMount = () => {
  fetchStats();
};

return {
  isLoading,
  stats,
  error,
  fetchStats,
  onMount
};
''',
        props: '''
return {
  as: "div",
  onMount: args.fns.onMount
};
''',
        css: '''
return `._id {
  min-height: 600px;
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.text};
  display: flex;
  flex-direction: column;
}`;
'''
      }
    },
    {
      id: "header",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "header"
};
''',
        css: '''
return `._id {
  padding: 1.5rem;
  border-bottom: 1px solid ${args.theme.var.color.border};
  background: ${args.theme.var.color.background_dark_50};
}`;
'''
      }
    },
    {
      id: "header_logo",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "img",
  src: "/api/file/downloadCompanyRectangularLogo",
  alt: "YSaar"
};
''',
        css: '''
return `._id {
  height: 32px;
  width: auto;
}`;
'''
      }
    },
    {
      id: "content",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "main"
};
''',
        css: '''
return `._id {
  flex: 1;
  padding: 1.5rem;
  overflow-y: auto;
}`;
'''
      }
    },
    {
      id: "loading_state",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: () => !args.fns.isLoading?.()
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 3rem 2rem;
}`;
'''
      }
    },
    {
      id: "loading_spinner",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "YTOLoadingSpinner",
        props: '''
return {
  size: "medium",
  color: "primary",
  text: "Loading..."
};
'''
      }
    },
    {
      id: "error_state",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div",
  hide: () => !args.fns.error?.()
};
''',
        css: '''
return `._id {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 2rem;
  text-align: center;
}`;
'''
      }
    },
    {
      id: "error_message",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const error = args.fns.error?.();
return {
  as: "p",
  text: error || "An error occurred"
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.error};
  margin: 0 0 1rem 0;
}`;
'''
      }
    },
    {
      id: "error_retry",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "YTOButton",
        props: '''
return {
  text: "Try Again",
  variant: "primary",
  onClick: args.fns.fetchStats
};
'''
      }
    },
    {
      id: "main_content",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
