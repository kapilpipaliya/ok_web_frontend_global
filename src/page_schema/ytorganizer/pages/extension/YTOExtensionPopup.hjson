return {
  as: "div",
  hide: () => args.fns.isLoading?.() || args.fns.error?.()
};
'''
      }
    },
    {
      id: "greeting",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h2",
  text: `Hello, ${args.user?.P?.username || 'there'}!`
};
''',
        css: '''
return `._id {
  font-size: 1.5rem;
  font-weight: 600;
  margin: 0 0 0.5rem 0;
  color: ${args.theme.var.color.text};
}`;
'''
      }
    },
    {
      id: "subtitle",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: "Quick access to your YouTube content"
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.muted};
  margin: 0 0 1.5rem 0;
}`;
'''
      }
    },
    {
      id: "stats_grid",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}`;
'''
      }
    },
    {
      id: "stats_loop",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "stat",
        loop: true,
        props: '''
const stats = args.fns.stats?.() || { channels: 0, playlists: 0, videos: 0 };

return {
  as: "div",
  data: [
    { label: "Channels", count: stats.channels, icon: "mdi:youtube", href: "/content?type=channels" },
    { label: "Playlists", count: stats.playlists, icon: "mdi:playlist-play", href: "/content?type=playlists" },
    { label: "Videos", count: stats.videos, icon: "mdi:video-outline" }
  ]
};
''',
        css: '''
return `._id {
  display: contents;
}`;
'''
      }
    },
    {
      id: "stat_card",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const stat = args.contextData.stat;
return {
  as: "div",
  onClick: stat.href ? () => {
    // Open in new tab
    window.open(`https://ysaar.com${stat.href}`, '_blank');
  } : undefined
};
''',
        css: '''
const stat = args.contextData.stat;
return `._id {
  background: ${args.theme.var.color.background_dark_50};
  border: 1px solid ${args.theme.var.color.border};
  border-radius: 0.5rem;
  padding: 1rem;
  text-align: center;
  ${stat.href ? 'cursor: pointer;' : ''}
  transition: all 0.2s ease;
}

${stat.href ? `
  ._id:hover {
    background: ${args.theme.var.color.background_light_200};
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  }
` : ''}`;
'''
      }
    },
    {
      id: "stat_icon",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const stat = args.contextData.stat;
return {
  as: "icon",
  icon: stat.icon,
  width: 24,
  height: 24
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.primary};
  margin-bottom: 0.5rem;
}`;
'''
      }
    },
    {
      id: "stat_count",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const stat = args.contextData.stat;
return {
  as: "div",
