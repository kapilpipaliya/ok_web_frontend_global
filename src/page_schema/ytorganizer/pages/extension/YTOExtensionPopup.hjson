  margin-bottom: 0.25rem;
}`;
'''
      }
    },
    {
      id: "stat_label",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const stat = args.contextData.stat;
return {
