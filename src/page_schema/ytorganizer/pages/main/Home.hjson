        componentName: Html
        props:
          '''
const channelsCount = args.fns.channelsCount?.() || 0;
const playlistsCount = args.fns.playlistsCount?.() || 0;
const videosCount = args.fns.videosCount?.() || 0;
const videoLimit = args.fns.videoLimit?.() || 10000;
const limitText = videoLimit === -1 ? "unlimited" : videoLimit.toLocaleString();

return {
  as: "div",
  data: [
    {
      id: "channels",
      label: "Channels",
      icon: "mdi:youtube",
      count: channelsCount,
      href: "/content?type=channels"
    },
    {
      id: "playlists",
      label: "Playlists",
      icon: "mdi:playlist-play",
      count: playlistsCount,
      href: "/content?type=playlists"
    },
    {
      id: "videos",
      label: "Videos",
      icon: "mdi:video-outline",
      count: videosCount,
      countText: `${videosCount.toLocaleString()} / ${limitText}`
    }
  ]
};
'''
      }
    }
