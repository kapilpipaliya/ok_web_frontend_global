        displayOrder: 1
        fns:
          '''
const [isDashboardLoading, setIsDashboardLoading] = args.createSignal(true);
const [dashboardError, setDashboardError] = args.createSignal(null);
const [channelsCount, setChannelsCount] = args.createSignal(0);
const [playlistsCount, setPlaylistsCount] = args.createSignal(0);
const [videosCount, setVideosCount] = args.createSignal(0);
const [userPlan, setUserPlan] = args.createSignal('free');
const [videoLimit, setVideoLimit] = args.createSignal(10000);
const [hasNoAccounts, setHasNoAccounts] = args.createSignal(false);

// Function to fetch dashboard data
const fetchDashboardData = async () => {
  try {
    setIsDashboardLoading(true);
    setDashboardError(null);
    setHasNoAccounts(false);

    // Check for connected YouTube accounts first
    const ownershipsResult = await args.executeNamedServerFunction({
      functionName: "getAllYouTubeOwnerships",
      contextData: {}
    });

    if (ownershipsResult.result?.success) {
      const ownerships = ownershipsResult.result?.data || [];

      if (ownerships.length === 0) {
        setHasNoAccounts(true);
        setIsDashboardLoading(false);
        return; // Don't fetch other data if no accounts
      }
    }

    // Fetch user details to get plan information
    const userDetailsResult = await args.fns.executeYTOFunction('getUserYTODetails', {
      userUuid: args.user?.P?.uuid
    });

    // Fetch playlists
    const playlistsResult = await args.fns.executeYTOFunction('getUserPlaylists', {});

    if (userDetailsResult.error) {
      throw new Error(userDetailsResult.error);
    }
    if (playlistsResult.error) {
      throw new Error(playlistsResult.error);
    }

    const userDetails = userDetailsResult.result;
    const playlists = playlistsResult.result;

    if (userDetails && userDetails.success) {
      const data = userDetails.data;

      // Set counts
      setChannelsCount(data.channels?.length || 0);
      setVideosCount(data.totalVideos || 0);

      // Set user plan (default to free if not specified)
      const plan = data.userPlan || 'free';
      setUserPlan(plan);

      // Set video limit based on plan
      const limits = {
        free: 10000,
        basic: 50000,
        pro: 150000,
        unlimited: -1 // unlimited
      };
      setVideoLimit(limits[plan] || 10000);
    }

    if (playlists && playlists.success) {
      setPlaylistsCount(playlists.data.totalCount || 0);
    }

  } catch (err) {
    console.error('Dashboard data fetch error:', err);
    setDashboardError(err.message || 'Failed to load dashboard data');
  } finally {
    setIsDashboardLoading(false);
  }
};

// Fetch data on mount
const onMount = async () => {
  // Fetch dashboard data (will check accounts internally)
  fetchDashboardData();
};

return {
  isDashboardLoading,
  dashboardError,
  channelsCount,
  playlistsCount,
  videosCount,
  userPlan,
  videoLimit,
  hasNoAccounts,
  fetchDashboardData,
  onMount
};
'''
        componentName: Html
        props:
          '''
return {
  as: "div",
  onMount: args.fns.onMount
};
'''
      }
    }
