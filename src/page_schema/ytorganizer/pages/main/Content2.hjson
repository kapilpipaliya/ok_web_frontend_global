    {
      id: "31"
      L: Attr
      P: {
        css:
          '''
return `._id {
  font-size: 1.25rem;
  font-weight: 600;
  color: ${args.theme.var.color.text};
  margin: 0 0 0.5rem 0;
}`;
'''
        displayOrder: 2
        componentName: Html
        props:
          '''
const hasSearchTerm = args.fns.searchTerm().length > 0;
const query = args.searchParams?.q || "";

let title;
if (hasSearchTerm) {
  title = "No results found";
} else if (args.fns.isChannels()) {
  title = "No channels yet";
} else if (args.fns.isPlaylists()) {
  title = "No playlists yet";
} else if (args.fns.isChannelDetail()) {
  title = "No playlists found";
} else if (args.fns.isPlaylistDetail()) {
  title = "No videos found";
} else if (args.fns.isSearchView()) {
  title = "Enter a search query";
} else if (args.fns.isFavouritesView()) {
  title = "No favourite items yet";
} else if (args.fns.isExtensionView()) {
  title = "No Content Found";
}

return {
  as: "h3",
  text: title
};
'''
      }
    }
    {
      id: "32"
      L: Attr
      P: {
        css:
          '''
return `._id {
  color: ${args.theme.var.color.muted};
  margin: 0;
}`;
'''
        displayOrder: 3
        componentName: Html
        props:
          '''
const hasSearchTerm = args.fns.searchTerm().length > 0;
let text;
if (hasSearchTerm) {
  text = "Try adjusting your search terms";
} else if (args.fns.isChannels()) {
  text = "Start by adding some YouTube channels to track your content";
} else if (args.fns.isPlaylists()) {
  text = "Start by adding some YouTube playlists to organize your content";
} else if (args.fns.isChannelDetail() || args.fns.isPlaylistDetail()) {
  text = ""; // Detail view doesn't show description (only has 2 children)
} else if (args.fns.isSearchView()) {
  text = "to find channels, playlists, and videos";
} else if (args.fns.isFavouritesView()) {
  text = "Start by adding channels, playlists, or videos to your favourites!";
} else if (args.fns.isExtensionView()) {
  text = "Open this page on a YouTube video, channel, or playlist page to see content here.";
}

return {
  as: "p",
  text,
  hide: args.fns.isChannelDetail() || args.fns.isPlaylistDetail()
};
'''
      }
    }
