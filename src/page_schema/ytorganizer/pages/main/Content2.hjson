// Determine title based on view
let title = "";
if (args.fns.isSearchView()) {
  title = "Search";
} else if (args.fns.isFavouritesView()) {
  title = "Favourites";
} else if (args.fns.isExtensionView()) {
  title = "Quick Add Channel, Playlist or Video";
} else if (args.fns.isChannelDetail()) {
  const data = args.fns.items();
  title = data?.channel?.channel?.P?.title || "Channel Details";
} else if (args.fns.isPlaylistDetail()) {
  const data = args.fns.items();
  title = data?.playlist?.playlist?.P?.title || "Playlist Details";
} else if (args.fns.isChannels()) {
  title = "Channels";
} else if (args.fns.isPlaylists()) {
  title = "Playlists";
}

return {
  as: "h1",
  text: title
};
