        props:
          '''
const data = args.fns.items();

if (!(args.fns.isChannelDetail() || args.fns.isPlaylistDetail()) || !data) {
  return { hide: true };
}

const itemId = args.fns.isPlaylistDetail()
  ? data.playlist?.playlist?.P?.youtubeId
  : data.channel?.channel?.P?.youtubeId;

const processingData = args.fns.isPlaylistDetail()
  ? args.fns.getPlaylistProcessingStatus(itemId)
  : args.fns.getChannelProcessingStatus(itemId);

if (!processingData) {
  return { hide: true };
}

// Extract data from vertex format
const item = args.fns.isPlaylistDetail()
  ? processingData.playlist
  : processingData.channel;

if (!item?.P) {
  return { hide: true };
}

let details = '';
if (args.fns.isChannelDetail()) {
  const processedPlaylists = item.P.processedPlaylists || 0;
  const totalPlaylists = item.P.totalPlaylists || 0;
  const processedVideos = item.P.processedVideos || 0;
  const totalVideos = item.P.totalVideos || 0;
  details = `${processedPlaylists}/${totalPlaylists} playlists, ${processedVideos}/${totalVideos} videos`;
} else {
  const processedVideos = item.P.processedVideos || 0;
  const totalVideos = item.P.totalVideos || 0;
  details = `${processedVideos}/${totalVideos} videos`;
}

return {
  queueStatus: item.P.queueStatus,
  progress: item.P.progress || 0,
  type: args.fns.isPlaylistDetail() ? "playlist" : "channel",
  details,
  error: item.P.error || ''
};
'''
