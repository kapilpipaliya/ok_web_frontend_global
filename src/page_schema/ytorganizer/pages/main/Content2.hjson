{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        signinRequired: true
        fns:
          '''
const contentType = args.createMemo(() => args.searchParams?.type || "channels");
const detailId = args.createMemo(() => args.searchParams?.id || null);
const searchQuery = args.createMemo(() => args.searchParams?.q || "");

const isSearchView = args.createMemo(() => args.searchParams?.q !== undefined);
const isFavouritesView = args.createMemo(() => contentType() === "favourites");
const isExtensionView = args.createMemo(() => contentType() === "extension");
const isChannelDetail = args.createMemo(() => contentType() === "channels" && args.searchParams?.id);
const isPlaylistDetail = args.createMemo(() => contentType() === "playlists" && args.searchParams?.id);
const isPlaylists = args.createMemo(() => !args.searchParams?.id && contentType() === "playlists");
const isChannels = args.createMemo(() => !args.searchParams?.id && contentType() === "channels");

const items = args.atom([]);
const loading = args.atom(true);
const searchTerm = args.atom("");
const pageContent = args.atom(null);
const userSetting = args.atom(null);
const settingLoaded = args.atom(false);

const isModalOpen = args.atom(false);
const [modalData, setModalData] = args.createStore({ editMode: false, itemData: null });

// Add videos to playlist modal
const isAddVideosModalOpen = args.atom(false);

// Add single video to playlist modal (for extension)
const isAddVideoToPlaylistModalOpen = args.atom(false);
const [addVideoToPlaylistData, setAddVideoToPlaylistData] = args.createStore({ videoId: null, videoTitle: null });

// Sync current channel or playlist
const isSyncing = args.atom(false);

const isNoteModalOpen = args.atom(false);
const [noteModalData, setNoteModalData] = args.createStore({ item: null, existingNote: "" });

// ----- LOAD DATA -------
const loadData = async () => {
  loading(true);
  try {
    let fnName;
    let fnArgs = {};
    let onSuccess = () => { };
    if (isPlaylists()) {
      fnName = "getUserPlaylists";
      // fnArgs = { sortBy: listSortBy() };
      onSuccess = (data) => {
        items(data.playlists || []);
      };
    } else if (isChannels()) {
      fnName = "getUserChannels";
      // fnArgs = { sortBy: listSortBy() };
      onSuccess = (data) => {
        items(data.channels || []);
      }
    } else if (isPlaylistDetail()) {
      fnName = "getPlaylistVideos";
      fnArgs = {
        ["playlistId"]: detailId(),
        // sortBy: detailSortBy()
      };
      onSuccess = (data) => items(data);
    } else if (isChannelDetail()) {
      fnName = "getChannelContents";
      fnArgs = {
        ["channelId"]: detailId(),
        // sortBy: detailSortBy()
      };
      onSuccess = (data) => items(data);
    } else if (isSearchView()) {
      if (!searchQuery()?.trim()) {
        items({ channels: [], playlists: [], videos: [], totalCount: 0 });
        loading(false);
        return;
      }
      fnName = "searchUserContent";
      fnArgs = {
        query: searchQuery().trim(),
        type: "all",
        // sortBy: searchSortBy()
      };
      onSuccess = (data) => items(data);
    } else if (isFavouritesView()) {
      fnName = "getUserFavourites";
      fnArgs = {
        // sortBy: favouritesSortBy()
      };
      onSuccess = (data) => items(data);
    } else if (isExtensionView()) {
      const content = pageContent();
      if (!content) {
        loading(false);
        return;
      }
      fnName = "checkPageItemsExistence";
      fnArgs = {
        channels: content.channels || [],
        playlists: content.playlists || [],
        videos: content.videos || []
      };
      onSuccess = (data) => items(data);
    }  else {
      console.error("Unknown mode:");
      loading(false);
      return;
    }

    const response = await args.fns.executeYTOFunction(fnName, fnArgs);
    if (response?.error) {
      args.showErrorToast(response.error);
      onSuccess(null);
    } else if (response?.result?.success && response?.result?.data) {
      onSuccess(response.result.data);
    } else {
      const msg = response?.result?.message || "Operation failed";
      args.showErrorToast(msg);
      onSuccess(null);
    }
  } catch (err) {
    console.error("Unexpected load error:", err);
    args.showErrorToast("Failed to load data");
  } finally {
    loading(false);
  }
};


// Consolidated effect to watch URL params and sort changes
// This prevents duplicate data loads by tracking both in a single effect
args.createEffect(
  args.on(
    () => [
      args.searchParams?.type,
      args.searchParams?.id,
      args.searchParams?.q,
      () => "",//listSortBy(),
      () => "",//detailSortBy(),
      () => "",//searchSortBy(),
      () => "",//favouritesSortBy(),
      args.fns.selectedOwnership?.(), // Watch for ownership selection
      args.fns.ownershipsLoading?.(), // Watch for ownerships loading state
      pageContent() // Watch for page content changes (for extension view)
    ],
    (
      [currentType, currentId, currentQuery, currentListSort, currentDetailSort, currentSearchSort, currentFavouritesSort, currentOwnership, currentOwnershipsLoading, currentPageContent],
      [prevType, prevId, prevQuery, prevListSort, prevDetailSort, prevSearchSort, prevFavouritesSort, prevOwnership, prevOwnershipsLoading, prevPageContent] = []
    ) => {
      // If ownerships are still loading, keep loading state
      if (currentOwnershipsLoading) {
        return;
      }

      // If ownerships are loaded but none exist (and no ownership selected), stop loading
      if (!currentOwnership) {
        const ownerships = args.fns.ownerships?.() || [];
        if (ownerships.length === 0) {
          loading(false);
        }
        return;
      }

      // Check what changed
      const urlParamsChanged = currentType !== prevType || currentId !== prevId || currentQuery !== prevQuery;
      const listSortChanged = currentListSort !== prevListSort;
      const detailSortChanged = currentDetailSort !== prevDetailSort;
      const searchSortChanged = currentSearchSort !== prevSearchSort;
      const favouritesSortChanged = currentFavouritesSort !== prevFavouritesSort;
      const ownershipChanged = currentOwnership !== prevOwnership || currentOwnershipsLoading !== prevOwnershipsLoading;
      const pageContentChanged = currentPageContent !== prevPageContent;

      // Reset scroll positions if URL params changed
      if (urlParamsChanged) {
        // resetScrollPositions();
      }

      // Load data based on what changed
      // Priority: Ownership change or URL change loads everything, sort changes only reload if view hasn't changed
      if (urlParamsChanged || ownershipChanged) {
        // URL or ownership changed, load appropriate data for new view
        loadData();
      } else if (pageContentChanged && isExtensionView()) {
        // Page content changed in extension view, reload extension data only
        loadData();
      } else {
        // Only sort changed, reload current view
        if (listSortChanged && (isChannels() || isPlaylists())) {
          loadData();
        } else if (detailSortChanged && (isChannelDetail() || isPlaylistDetail())) {
          loadData();
        } else if (searchSortChanged && isSearchView()) {
          loadData(currentQuery);
        } else if (favouritesSortChanged && isFavouritesView()) {
          loadData();
        }
      }
    }
  )
);

// ----- FILTER DATA -------
// Helper to extract YouTube ID from item data (works for both raw and vertex data)
const getItemYouTubeId = (itemData, type) => {
  const item = itemData[type];
  if (!item) return null;

  // Raw extension data has .id property
  if (itemData.extensionData) {
    return item.id;
  }

  // Database vertex data has .P.youtubeId property
  return item.P?.youtubeId || null;
};
// Helper to convert extension item to Vertex format
const convertToVertex = (item, type) => {
  const label = type === 'channel' ? 'Channel' : type === 'playlist' ? 'Playlist' : 'Video';
  const youtubeId = item.id;

  // Generate thumbnail URLs based on type
  let thumbnailProps = {};
  if (type === 'video') {
    // For videos, use YouTube's thumbnail URLs
    thumbnailProps = {
      thumbnailDefault: `https://i.ytimg.com/vi/${youtubeId}/default.jpg`,
      thumbnailMedium: `https://i.ytimg.com/vi/${youtubeId}/mqdefault.jpg`,
      thumbnailHigh: `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`,
      thumbnailStandard: `https://i.ytimg.com/vi/${youtubeId}/sddefault.jpg`,
      thumbnailMaxres: `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`
    };
  } else if (type === 'channel' || type === 'playlist') {
    // For channels and playlists, use thumbnail from extension if available
    if (item.thumbnail) {
      thumbnailProps = {
        thumbnailHigh: item.thumbnail,
        thumbnailMedium: item.thumbnail,
        thumbnailDefault: item.thumbnail
      };
    }
  }

  return {
    resultType: type,
    [type]: {
      id: `ext:${type}:${youtubeId}`,
      L: [label],
      P: {
        youtubeId: youtubeId,
        title: item.title || youtubeId,
        ...thumbnailProps,
        // Extension-specific metadata (defaults to false if not provided)
        extensionExists: item.exists ?? false,
        extensionIsCurrentPage: item.isCurrentPage ?? false
      },
      IN: {},
      OUT: {}
    },
    [`${type}Setting`]: null
  };
};
// Helper to process extension item (handles both full vertex data and raw extension data)
const processExtensionItem = (itemData, type) => {
  // Check if this is raw extension data that needs conversion
  if (itemData.extensionData) {
    // Convert raw extension data to vertex format
    const rawItem = itemData[type];
    return convertToVertex(rawItem, type);
  } else {
    // Already has full vertex data from database
    // Add resultType and mark as existing
    const item = itemData[type];
    const itemSetting = itemData[`${type}Setting`];

    // Add extension metadata to the item properties
    if (item && item.P) {
      item.P.extensionExists = true;
      item.P.extensionIsCurrentPage = false; // Database items are never current page
    }

    return {
      resultType: type,
      [type]: item,
      [`${type}Setting`]: itemSetting
    };
  }
};

const filteredItems = args.createMemo(() => {
  const term = searchTerm().toLowerCase();
  let items2 = [];

  if (isSearchView()) {
    const results = items();
    if (results) {
      if (results.channels) items2.push(...results.channels.map(x => ({ ...x, resultType: "channel" })));
      if (results.playlists) items2.push(...results.playlists.map(x => ({ ...x, resultType: "playlist" })));
      if (results.videos) items2.push(...results.videos.map(x => ({ ...x, resultType: "video" })));
    }
  }

  else if (isFavouritesView()) {
    const data = items();
    if (data) {
      if (data.channels)
        items2.push(...data.channels.map(x => ({ ...x, resultType: "channel" })));

      if (data.playlists)
        items2.push(...data.playlists.map(x => ({ ...x, resultType: "playlist" })));

      if (data.videos)
        items2.push(...data.videos.map(x => ({ ...x, resultType: "video" })));
    }
  }

  else if (isExtensionView()) {
    const data = items();
    if (data) {
      const combined = [];
      const seen = {
        channel: new Set(),
        playlist: new Set(),
        video: new Set()
      };

      const addItem = (itemData, type) => {
        const id = getItemYouTubeId(itemData, type);
        if (!id || seen[type].has(id)) return;
        seen[type].add(id);
        combined.push(processExtensionItem(itemData, type));
      };

      if (data.channels) data.channels.forEach(x => addItem(x, "channel"));
      if (data.playlists) data.playlists.forEach(x => addItem(x, "playlist"));
      if (data.videos) data.videos.forEach(x => addItem(x, "video"));

      items2 = combined;
    }
  }
  else if (isChannelDetail()) {
    const data = items();
    items2 = data?.playlists || [];
  }
  else if (isPlaylistDetail()) {
    const data = items();
    items2 = data?.videos || [];
  }
  else if (isChannels()) {
    items2 = items();
  } else if (isPlaylists()) {
    items2 = items();
  }

  if (!term) return items2;

  return items2.filter(item => {
    if (item.video) {
      const v = item.video;
      const title = v?.P?.title?.toLowerCase() || "";
      const desc = v?.P?.description?.toLowerCase() || "";
      const channelTitle = v?.P?.channelTitle?.toLowerCase() || "";
      const note = item.videoSetting?.P?.note?.toLowerCase() || "";
      return title.includes(term) || desc.includes(term) || channelTitle.includes(term) || note.includes(term);
    }
    if (item.playlist) {
      const p = item.playlist;
      const title = p?.P?.title?.toLowerCase() || "";
      const desc = p?.P?.description?.toLowerCase() || "";
      const custom = item.playlistSetting?.P?.customName?.toLowerCase() || "";
      return title.includes(term) || desc.includes(term) || custom.includes(term);
    }
    if (item.channel) {
      const c = item.channel;
      const title = c?.P?.title?.toLowerCase() || "";
      const desc = c?.P?.description?.toLowerCase() || "";
      const custom = item.channelSetting?.P?.customName?.toLowerCase() || "";
      return title.includes(term) || desc.includes(term) || custom.includes(term);
    }
    return false;
  });
});

//------EXTRA FUNCTIONS----------
// Unified helper: Infer item type from data structure
const inferItemType = (data) => {
  if (data.video) {
    return { type: 'video', item: data.video, setting: data.videoSetting };
  }
  if (data.playlist) {
    return { type: 'playlist', item: data.playlist, setting: data.playlistSetting };
  }
  if (data.channel) {
    return { type: 'channel', item: data.channel, setting: data.channelSetting };
  }
  return null;
};

return {
  enabled: true,
  contentType,
  detailId,
  searchQuery,
  isSearchView,
  isFavouritesView,
  isExtensionView,
  isChannelDetail,
  isPlaylistDetail,
  isPlaylists,
  isChannels,
  searchTerm,
  pageContent,
  userSetting,
  settingLoaded,
  isAddVideosModalOpen,
  isAddVideoToPlaylistModalOpen,
  addVideoToPlaylistData,
  setAddVideoToPlaylistData,
  isSyncing,
  items,
  items,
  loading,
  loading,
  isModalOpen,
  modalData,
  setModalData,
  isNoteModalOpen,
  noteModalData,
  setNoteModalData,
  filteredItems,
  getPlaylistProcessingStatus: () => undefined,
  getChannelProcessingStatus: () => undefined,
  handleSearchSubmit: () => "",
  formatProcessingStatus: () => "",
  inferItemType
};
