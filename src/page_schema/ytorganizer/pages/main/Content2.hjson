          '''
let icon;
if (args.fns.isPlaylists()) {
  icon = "mdi:playlist-play";
} else if (args.fns.isChannels()) {
  icon = "mdi:youtube";
} else if (args.fns.isChannelDetail()) {
  icon = "mdi:playlist-remove";
} else if (args.fns.isPlaylistDetail()) {
  icon = "mdi:video-off";
} else if (args.fns.isSearchView()) {
  icon = "mdi:magnify";
} else if (args.fns.isFavouritesView()) {
  icon = "carbon:favorite";
} else if (args.fns.isExtensionView()) {
  icon = "carbon:data-1";
}

return {
  as: "icon",
  icon,
  width: 64,
  height: 64
};
'''
      }
