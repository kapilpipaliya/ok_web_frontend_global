  item: args.fns.noteModalData.item,
  existingNote: args.fns.noteModalData.existingNote,
  onSave: args.fns.saveNote
};
'''
      }
    }
    {
      id: "33"
      L: Attr
      P: {
        displayOrder: 4
        componentName: AddVideosModal
        props:
          '''
// Check which modal should be open and return function for isOpen
const isDetailModalOpen = args.fns.isAddVideosModalOpen;
const isExtensionModalOpen = args.fns.isAddVideoToPlaylistModalOpen;

// Determine if any modal is open
const getIsDetailOpen = isDetailModalOpen?.() || false;
const getIsExtensionOpen = isExtensionModalOpen?.() || false;

let playlist = null;
let videoUrl = "";
let onClose = null;
let onSuccess = null;

if (getIsDetailOpen) {
  // Detail view: adding videos to specific playlist
  const data = args.fns.items();
  const playlistData = data?.playlist;
  const playlistVertex = playlistData?.playlist;
  const ownership = playlistData?.ownership;

  // Add ownership key to playlist object for modal to use
  playlist = playlistVertex ? {
    ...playlistVertex,
    ownershipId: ownership?.P?.key
  } : null;

  onClose = () => args.fns.isAddVideosModalOpen(false);
  onSuccess = args.fns.loadData;
} else if (getIsExtensionOpen) {
  // Extension view: user selects playlist, pre-filled video URL
  const videoData = args.fns.addVideoToPlaylistData;
  videoUrl = videoData.videoId ? `https://www.youtube.com/watch?v=${videoData.videoId}` : "";
  playlist = null; // User will select from dropdown
  onClose = () => args.fns.isAddVideoToPlaylistModalOpen(false);
  onSuccess = args.fns.loadData;
}

// Return isOpen as a function that checks both modal states
return {
  isOpen: () => isDetailModalOpen?.() || isExtensionModalOpen?.() || false,
  onClose: onClose,
  playlist: playlist,
  videoUrl: videoUrl,
  onSuccess: onSuccess
};
'''
      }
    }
