        displayOrder: 1
        componentName: VideoCard
        props:
          '''
// VirtualList provides item context with {item, virtualItem, index}
const virtualItem = args.contextData.virtualItem;
if (!virtualItem) return {};
const itemData = args.fns.getItems()[virtualItem.index];
if (!itemData) return {};

let item, itemSetting, itemType, processingStatus, showTypeBadge, itemId;

if (args.fns.isPlaylists()) {
  item = itemData.playlist;
  itemId = item?.P?.youtubeId;
  processingStatus = args.fns.getPlaylistProcessingStatus(itemId);
  itemSetting = itemData.playlistSetting;
  itemType = "playlist";
  showTypeBadge = false;
} else if (args.fns.isChannels()) {
  item = itemData.channel;
  itemId = item?.P?.youtubeId;
  processingStatus = args.fns.getChannelProcessingStatus(itemId);
  itemSetting = itemData.channelSetting;
  itemType = "channel";
  showTypeBadge = false;
} else if (args.fns.isChannelDetail()) {
  item = itemData.playlist;
  itemId = item?.P?.youtubeId;
  processingStatus = args.fns.getPlaylistProcessingStatus(itemId);
  itemSetting = itemData.playlistSetting;
  itemType = "playlist";
  showTypeBadge = false;
} else if (args.fns.isPlaylistDetail()) {
  item = itemData.video;
  itemId = item?.P?.youtubeId;
  processingStatus = null;
  itemSetting = itemData.videoSetting;
  itemType = "video";
  showTypeBadge = false;
} else if (args.fns.isSearchView() || args.fns.isFavouritesView() || args.fns.isExtensionView()) {
  const resultType = itemData.resultType;
  item = resultType === "channel" ? itemData.channel : (resultType === "playlist" ? itemData.playlist : itemData.video);
  itemId = item?.P?.youtubeId;
  processingStatus = resultType === "channel"
    ? args.fns.getChannelProcessingStatus(itemId)
    : resultType === "playlist"
    ? args.fns.getPlaylistProcessingStatus(itemId)
    : null;
  itemSetting = resultType === "channel" ? itemData.channelSetting : (resultType === "playlist" ? itemData.playlistSetting : itemData.videoSetting);
  itemType = resultType;
  showTypeBadge = true;
}

// Format processing queueStatus with detailed information
processingStatus = args.fns.formatProcessingStatus(processingStatus, itemType);

return {
  item,
  itemData,
  itemSetting,
  itemType,
  showTypeBadge,
  processingStatus
};
'''
      }
    }
    {
      id: "31"
      L: Attr
      P: {
        displayOrder: 2
        componentName: AddModal
        props:
          '''

const modalData = args.fns.modalData;
const isOpen = args.fns.isModalOpen();

return {
  isOpen: isOpen,
  contentType: modalData.contentType,
  editMode: modalData.editMode,
  itemData: modalData.itemData,
  channelId: modalData.channelId,
  initialUrl: modalData.initialUrl,
  onClose: args.fns.closeModal,
  onSave: args.fns.handleModalSave
};
'''
      }
    }
    {
      id: "32"
      L: Attr
      P: {
        displayOrder: 3
        componentName: NoteModal
        props:
          '''
