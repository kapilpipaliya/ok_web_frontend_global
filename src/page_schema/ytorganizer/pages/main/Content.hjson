{
  vertexes: [
    {
      id: "1"
      L: Page
      P: {
        fns:
          '''
const contentType = args.createMemo(() => args.searchParams?.type || "channels");
const detailId = args.createMemo(() => args.searchParams?.id || null);
const searchQuery = args.createMemo(() => args.searchParams?.q || "");

const isPublicView = args.createMemo(() => args.searchParams?.page === "public");
const publicUsername = args.createMemo(() => args.searchParams?.username || null);

const isSearchView = args.createMemo(() => contentType() === "search");
const isFavouritesView = args.createMemo(() => contentType() === "favourites");
const isExtensionView = args.createMemo(() => contentType() === "extension");
const isChannelDetail = args.createMemo(() => contentType() === "channels" && args.searchParams?.id);
const isPlaylistDetail = args.createMemo(() => contentType() === "playlists" && args.searchParams?.id);
const isPlaylists = args.createMemo(() => !args.searchParams?.id && contentType() === "playlists");
const isChannels = args.createMemo(() => !args.searchParams?.id && contentType() === "channels");

const items = args.atom([]);
const loading = args.atom(true);
const searchTerm = args.atom("");
const searchInput = args.atom(searchQuery());
const pageContent = args.atom(null);
const userSetting = args.atom(null);
const settingLoaded = args.atom(false);
const isInitialLoad = args.atom(true);
const loadError = args.atom(null);
// Track if URL params changed to prevent duplicate loads when sort updates as a consequence
const urlParamsChangedFlag = args.atom(false);
// Store the combined string of contentType, detailId, and searchQuery when data is loaded
const loadedDataKey = args.atom(null);

const isModalOpen = args.atom(false);
const [modalData, setModalData] = args.createStore({ editMode: false, itemData: null });

// Add videos to playlist modal
const isAddVideosModalOpen = args.atom(false);

// Add single video to playlist modal (for extension)
const isAddVideoToPlaylistModalOpen = args.atom(false);
const [addVideoToPlaylistData, setAddVideoToPlaylistData] = args.createStore({ videoId: null, videoTitle: null });

// Sync current channel or playlist
const isSyncing = args.atom(false);

const isNoteModalOpen = args.atom(false);
const [noteModalData, setNoteModalData] = args.createStore({ item: null, existingNote: "" });

// Common sort state - updates based on current view
const sortField = args.atom("title");
const sortDirection = args.atom("asc");

// Computed sort value for backend calls
const sortBy = args.createMemo(() =>
  sortField() === "relevance" ? "relevance" : `${sortField()}_${sortDirection()}`
);

// Polling state for processing status
const [processingStatuses, setProcessingStatuses] = args.createSignal({
  channels: {},
  playlists: {}
});
const pollingInterval = args.atom(null);
const isPolling = args.atom(false);

// Helper function to generate combined string from contentType, detailId, and searchQuery
const getDataKey = () => {
  const type = contentType() || "";
  const id = detailId() || "";
  const query = searchQuery() || "";
  return `${type}|${id}|${query}`;
};

// Helper to split "field_direction" format into field + direction
const splitSortValue = (sortValue) => {
  if (!sortValue || sortValue === "relevance") {
    return { field: "relevance", direction: "asc" };
  }

  const match = sortValue.match(/^([a-z_]+)_(asc|desc)$/);
  if (!match) {
    return { field: "title", direction: "asc" }; // fallback
  }

  return { field: match[1], direction: match[2] };
};

// Get default sort for current view
const getDefaultSortForView = () => {
  if (isFavouritesView()) {
    return { field: "favourited", direction: "desc" };
  }
  if (isChannelDetail() || isPlaylistDetail()) {
    return { field: "position", direction: "asc" };
  }
  if (isSearchView()) {
    return { field: "relevance", direction: "asc" };
  }
  // List view (channels/playlists)
  return { field: "title", direction: "asc" };
};

// Get sort preference key for current view
const getSortPreferenceKey = () => {
  if (isFavouritesView()) return "favourites";
  if (isChannelDetail() || isPlaylistDetail()) return "videos";
  if (isSearchView()) return "search";
  // List view
  return contentType() === "playlists" ? "playlists" : "channels";
};

// Update sort state based on current view and saved preferences
const updateSortForCurrentView = () => {
  const prefs = userSetting()?.P?.sortPreferences;
  if (!prefs) {
    const defaultSort = getDefaultSortForView();
    sortField(defaultSort.field);
    sortDirection(defaultSort.direction);
    return;
  }

  const prefsObj = typeof prefs === 'string' ? JSON.parse(prefs) : prefs;
  const key = getSortPreferenceKey();
  const savedSort = prefsObj[key];

  if (savedSort) {
    const { field, direction } = splitSortValue(savedSort);
    sortField(field);
    sortDirection(direction);
  } else {
    const defaultSort = getDefaultSortForView();
    sortField(defaultSort.field);
    sortDirection(defaultSort.direction);
  }
};

// Function to load user setting
const loadUserSetting = async (skipSortUpdate = false) => {
  try {
    const result = await args.fns.executeYTOFunction("getYTOUserSetting", {});

    if (result?.error) {
      args.showErrorToast(result.error);
      settingLoaded(true);
    } else if (result?.result?.success && result?.result?.data?.setting) {
      const settingVertex = result.result.data.setting;
      userSetting(settingVertex);

      // Only update sort if not skipped (skipped when URL sort is present)
      if (!skipSortUpdate) {
        updateSortForCurrentView();
      }

      settingLoaded(true);
    } else {
      settingLoaded(true);
    }
  } catch (error) {
    console.error("Error loading user setting:", error);
    settingLoaded(true);  // Mark as loaded even on error to prevent blocking
  }
};

// Initialize sort from URL if present (highest priority)
const initializeSortFromURL = () => {
  const urlSort = args.searchParams?.sort;
  if (!urlSort) return false;

  // Handle "relevance" special case
  if (urlSort === "relevance") {
    sortField("relevance");
    sortDirection("asc");
    return true;
  }

  // Validate sort format (field_direction)
  const sortPattern = /^([a-z_]+)_(asc|desc)$/;
  const match = urlSort.match(sortPattern);

  if (!match) {
    console.warn('Invalid sort parameter in URL:', urlSort);
    return false;
  }

  const [, field, direction] = match;
  sortField(field);
  sortDirection(direction);

  return true;
};

// Update URL when sort changes
const updateURLSort = (sortValue) => {
  if (!sortValue) return;

  const currentPath = window.location.pathname;
  const currentSearch = new URLSearchParams(window.location.search);

  currentSearch.set('sort', sortValue);

  const newURL = `${currentPath}?${currentSearch.toString()}`;
  window.history.replaceState({}, '', newURL);
};

// Clear sort from URL
const clearURLSort = () => {
  const currentPath = window.location.pathname;
  const currentSearch = new URLSearchParams(window.location.search);

  currentSearch.delete('sort');

  const newURL = currentSearch.toString()
    ? `${currentPath}?${currentSearch.toString()}`
    : currentPath;

  window.history.replaceState({}, '', newURL);
};

// Save user setting when sort preferences change (called explicitly by user actions)
const saveUserSortPreference = async () => {
  try {
    const currentSettingVertex = userSetting() || { P: {} };

    // Get existing preferences
    const existingPrefs = currentSettingVertex.P?.sortPreferences;
    const prefsObj = existingPrefs 
      ? (typeof existingPrefs === 'string' ? JSON.parse(existingPrefs) : existingPrefs)
      : {};

    // Update only the current view's sort preference
    const key = getSortPreferenceKey();
    const currentSort = sortBy();
    prefsObj[key] = currentSort;

    // For list view, also update both channels and playlists
    if (isChannels() || isPlaylists()) {
      prefsObj.channels = currentSort;
      prefsObj.playlists = currentSort;
    }

    const updatedSettingProps = {
      ...currentSettingVertex.P,
      sortPreferences: JSON.stringify(prefsObj)
    };

    await args.fns.executeYTOFunction("saveYTOUserSetting", {
      setting: updatedSettingProps
    });

    // Update local vertex with new properties
    userSetting({
      ...currentSettingVertex,
      P: updatedSettingProps
    });
  } catch (error) {
    console.error("Error saving user setting:", error);
  }
};

// Debounced version for user actions
const debouncedSaveSetting = args.debounce(saveUserSortPreference, 1000);

// Note: Sort preferences are saved explicitly when user changes sort
// via handleSortFieldChange or handleSortDirectionToggle, not reactively

// Update sort when view changes
args.createEffect(
  args.on(
    () => [
      contentType(),
      detailId(),
      isSearchView(),
      isFavouritesView(),
      settingLoaded()
    ],
    ([currentType, currentId, isSearch, isFavourites, loaded], prev = []) => {
      // Only run after settings are loaded
      if (!loaded) return;

      // On initial load, just mark as complete
      if (prev.length === 0) {
        isInitialLoad(false);
        return;
      }

      // Check if view actually changed
      const viewChanged = (
        currentType !== prev[0] ||
        currentId !== prev[1] ||
        isSearch !== prev[2] ||
        isFavourites !== prev[3]
      );

      if (viewChanged) {
        // Clear URL sort
        clearURLSort();
        // Update sort for new view from user settings (won't trigger save due to flag)
        updateSortForCurrentView();
      }
    }
  )
);

// Sort options for different content types (field only, direction handled by toggle)
const channelSortOptions = [
  { value: "title", text: "Title" },
  { value: "created", text: "Created Date" },
  { value: "videos", text: "Video Count" }
];

const playlistSortOptions = [
  { value: "title", text: "Title" },
  { value: "created", text: "Created Date" },
  { value: "videos", text: "Video Count" },
  { value: "position", text: "Playlist Order" }
];

const videoSortOptions = [
  { value: "position", text: "Playlist Order" },
  { value: "title", text: "Title" },
  { value: "published", text: "Published Date" },
  { value: "duration", text: "Duration" }
];

const favouritesSortOptions = [
  { value: "favourited", text: "Favourited Date" },
  { value: "title", text: "Title" },
  { value: "created", text: "Created Date" }
];

// Get current sort options based on view and content type
const getCurrentSortOptions = args.createMemo(() => {
  if (isFavouritesView()) {
    return favouritesSortOptions;
  }
  if (isChannelDetail() || isPlaylistDetail()) {
    return contentType() === "channels" ? playlistSortOptions : videoSortOptions;
  }
  if (isSearchView()) {
    return [
      { value: "relevance", text: "Default" },
      { value: "title", text: "Title" },
      { value: "created", text: "Created Date" }
    ];
  }
  return contentType() === "playlists" ? playlistSortOptions : channelSortOptions;
});

// Get current sort value
const getCurrentSortValue = args.createMemo(() => sortBy());

// Set current sort value
const setCurrentSortValue = (value) => {
  const { field, direction } = splitSortValue(value);
  sortField(field);
  sortDirection(direction);
  // Update URL to reflect sort change
  updateURLSort(value);
};

// Get current sort field
const getCurrentSortField = args.createMemo(() => sortField());

// Get current sort direction
const getCurrentSortDirection = args.createMemo(() => sortDirection());

// Handle field change (keeps direction the same)
const handleSortFieldChange = (newField) => {
  const currentDirection = sortDirection();
  const newSortValue = newField === "relevance" ? "relevance" : `${newField}_${currentDirection}`;
  setCurrentSortValue(newSortValue);

  // Save user preference after user-initiated change
  debouncedSaveSetting();
};

// Handle direction toggle (keeps field the same)
const handleSortDirectionToggle = () => {
  const currentField = sortField();

  // Can't toggle direction for relevance
  if (currentField === "relevance") {
    return;
  }

  const currentDirection = sortDirection();
  const newDirection = currentDirection === "asc" ? "desc" : "asc";
  const newSortValue = `${currentField}_${newDirection}`;
  setCurrentSortValue(newSortValue);

  // Save user preference after user-initiated change
  debouncedSaveSetting();
};

// ----- LOAD DATA -------
const loadData = async () => {
  loading(true);
  loadError(null); // Clear any previous errors
  try {
    const publicView = isPublicView();
    const username = publicUsername();

    // Validate public view parameters
    if (publicView && !username) {
      loadError("Username is required for public access");
      loading(false);
      return;
    }

    let fnName;
    let fnArgs = {};

    if (publicView && username) {
      fnArgs.isPublicAccess = true;
      fnArgs.username = username;
    }
    let onSuccess = () => { };
    if (isPlaylists()) {
      fnName = "getUserPlaylists";
      fnArgs = { ...fnArgs, sortBy: sortBy() };
      onSuccess = (data) => {
        items(data.playlists || []);
      };
    } else if (isChannels()) {
      fnName = "getUserChannels";
      fnArgs = { ...fnArgs, sortBy: sortBy() };
      onSuccess = (data) => {
        items(data.channels || []);
      }
    } else if (isPlaylistDetail()) {
      fnName = "getPlaylistVideos";
      fnArgs = {
        ...fnArgs,
        ["playlistId"]: detailId(),
        sortBy: sortBy()
      };
      onSuccess = (data) => items(data);
    } else if (isChannelDetail()) {
      fnName = "getChannelContents";
      fnArgs = {
        ...fnArgs,
        ["channelId"]: detailId(),
        sortBy: sortBy()
      };
      onSuccess = (data) => items(data);
    } else if (isSearchView()) {
      if (!searchQuery()?.trim()) {
        items({ channels: [], playlists: [], videos: [], totalCount: 0 });
        loading(false);
        return;
      }
      fnName = "searchUserContent";
      fnArgs = {
        ...fnArgs,
        query: searchQuery().trim(),
        type: "all",
        sortBy: sortBy()
      };
      onSuccess = (data) => items(data);
    } else if (isFavouritesView()) {
      fnName = "getUserFavourites";
      fnArgs = {
        ...fnArgs,
        sortBy: sortBy()
      };
      onSuccess = (data) => items(data);
    } else if (isExtensionView()) {
      const content = pageContent();
      if (!content) {
        loading(false);
        return;
      }
      fnName = "checkPageItemsExistence";
      fnArgs = {
        ...fnArgs,
        channels: content.channels || [],
        playlists: content.playlists || [],
        videos: content.videos || []
      };
      onSuccess = (data) => items(data);
    }  else {
      console.error("Unknown mode:");
      loading(false);
      return;
    }

    const response = await args.fns.executeYTOFunction(fnName, fnArgs);
    if (response?.error) {
      loadError(response.error);
      onSuccess(null);
    } else if (response?.result?.success && response?.result?.data) {
      loadError(null); // Clear error on success
      onSuccess(response.result.data);
    } else {
      const msg = response?.result?.message || "Operation failed";
      loadError(msg);
      onSuccess(null);
    }
  } catch (err) {
    console.error("Unexpected load error:", err);
    loadError(err.message || "Failed to load data");
  } finally {
    loading(false);
  }
};

// Clear error message
const clearLoadError = () => {
  loadError(null);
};

// Listen for messages from extension (popup or content script)
const handleMessage = (event) => {
  if (event.data.type === "PAGE_CONTENT") {
    const { channels, playlists, videos } = event.data;
    pageContent({ channels: channels || [], playlists: playlists || [], videos: videos || [] });
  }
};

// Request page content from parent window (extension popup/iframe)
const requestPageContent = () => {
  if (window.parent && window.parent !== window) {
    window.parent.postMessage({ type: "REQUEST_PAGE_CONTENT" }, "*");
  }
};

// Watch for extension view and request page content
args.createEffect(
  args.on([isExtensionView], () => {
    if (isExtensionView()) {
      requestPageContent();
    }
  })
);

// Consolidated effect to watch URL params and sort changes
// This prevents duplicate data loads by tracking both in a single effect
args.createEffect(
  args.on(
    () => [
      args.searchParams?.type,
      args.searchParams?.id,
      args.searchParams?.q,
      args.searchParams?.page,
      args.searchParams?.username,
      sortBy(),
      args.fns.selectedOwnership?.(),
      args.fns.ownershipsLoading?.(),
      pageContent(),
      settingLoaded()
    ],
    (
      [currentType, currentId, currentQuery, currentPage, currentUsername, currentSort, currentOwnership, currentOwnershipsLoading, currentPageContent, currUserSettingsLoaded],
      [prevType, prevId, prevQuery, prevPage, prevUsername, prevSort, prevOwnership, prevOwnershipsLoading, prevPageContent, prevUserSettingsLoaded] = []
    ) => {
      // Save the combined string when data is successfully loaded
      loadedDataKey(getDataKey());

      const isPublic = currentPage === "public";

      // Wait for settings to be loaded before fetching data
      if (!currUserSettingsLoaded) {
        return;
      }

      // In public view, skip ownership checks
      if (isPublic) {
        const urlParamsChanged = currentType !== prevType || currentId !== prevId || currentQuery !== prevQuery || currentPage !== prevPage || currentUsername !== prevUsername;
        const sortChanged = currentSort !== prevSort;
        const settingsJustLoaded = currUserSettingsLoaded && !prevUserSettingsLoaded;

        // Handle data loading for public view
        if (settingsJustLoaded || urlParamsChanged) {
          loadData();
        } else if (sortChanged) {
          loadData();
        }
        return;
      }

      // If ownerships are still loading, keep loading state
      if (currentOwnershipsLoading) {
        return;
      }

      // If ownerships are loaded but none exist (and no ownership selected), stop loading
      if (!currentOwnership) {
        const ownerships = args.fns.ownerships?.() || [];
        if (ownerships.length === 0) {
          loading(false);
        }
        return;
      }

      // Determine what changed (for authenticated view)
      const urlParamsChanged = currentType !== prevType || currentId !== prevId || currentQuery !== prevQuery;
      const sortChanged = currentSort !== prevSort;
      const ownershipChanged = currentOwnership !== prevOwnership || currentOwnershipsLoading !== prevOwnershipsLoading;
      const pageContentChanged = currentPageContent !== prevPageContent;
      const settingsJustLoaded = currUserSettingsLoaded && !prevUserSettingsLoaded;

      // Handle data loading - minimize effect runs by batching updates
      if (settingsJustLoaded || urlParamsChanged || ownershipChanged) {
        // Major changes: update sort when view changes, then load data
        if (urlParamsChanged) {
          updateSortForCurrentView();
          urlParamsChangedFlag(true);
        } else {
          urlParamsChangedFlag(false);
        }
        loadData();
      } else if (pageContentChanged && isExtensionView()) {
        // Page content changed in extension view
        urlParamsChangedFlag(false);
        loadData();
      } else if (sortChanged) {
        // Sort changed - only load if URL params didn't change in previous run
        if (!urlParamsChangedFlag()) {
          loadData();
        }
        urlParamsChangedFlag(false);
      } else {
        urlParamsChangedFlag(false);
      }
    }
  )
);

// Helper function to collect visible IDs from channel/playlist arrays (all items)
const collectVisibleIds = (channelsArray, playlistsArray, channelIds, playlistIds) => {
  // Collect all channel IDs
  if (channelsArray) {
    channelsArray.forEach(item => {
      const channelId = item.channel?.P?.youtubeId;
      if (channelId && !channelIds.includes(channelId)) {
        channelIds.push(channelId);
      }
    });
  }

  // Collect all playlist IDs
  if (playlistsArray) {
    playlistsArray.forEach(item => {
      const playlistId = item.playlist?.P?.youtubeId;
      if (playlistId && !playlistIds.includes(playlistId)) {
        playlistIds.push(playlistId);
      }
    });
  }
};

// Helper function to extract all items from arrays
const extractProcessingItems = (channelsArray, playlistsArray, channelsMap, playlistsMap) => {
  // Extract all channels
  if (channelsArray) {
    channelsArray.forEach(item => {
      const channelId = item.channel?.P?.youtubeId;
      if (channelId) {
        channelsMap[channelId] = item;
      }
    });
  }

  // Extract all playlists
  if (playlistsArray) {
    playlistsArray.forEach(item => {
      const playlistId = item.playlist?.P?.youtubeId;
      if (playlistId) {
        playlistsMap[playlistId] = item;
      }
    });
  }
};

// Reactive effect to automatically update all visible items when data changes
args.createEffect(
  args.on(
    [items],
    () => {
      const channelsMap = {};
      const playlistsMap = {};

      const currentItems = items();

      // Watch list view items
      if (isChannels() || isPlaylists()) {
        if (isChannels()) {
          extractProcessingItems(currentItems, null, channelsMap, playlistsMap);
        } else if (isPlaylists()) {
          extractProcessingItems(null, currentItems, channelsMap, playlistsMap);
        }
      }

      // Watch detail view
      if (isChannelDetail() || isPlaylistDetail()) {
        const detail = currentItems;
        if (detail) {
          if (isChannelDetail()) {
            // Include channel itself
            const channelId = detail.channel?.channel?.P?.youtubeId;
            if (channelId) {
              channelsMap[channelId] = detail.channel;
            }

            // Include playlists in channel
            extractProcessingItems(null, detail.playlists, channelsMap, playlistsMap);
          } else if (isPlaylistDetail()) {
            // Include playlist itself
            const playlistId = detail.playlist?.playlist?.P?.youtubeId;
            if (playlistId) {
              playlistsMap[playlistId] = detail.playlist;
            }
          }
        }
      }

      // Watch search results
      if (isSearchView()) {
        const results = currentItems;
        if (results) {
          extractProcessingItems(results.channels, results.playlists, channelsMap, playlistsMap);
        }
      }

      // Watch favourites
      if (isFavouritesView()) {
        const favourites = currentItems;
        if (favourites) {
          extractProcessingItems(favourites.channels, favourites.playlists, channelsMap, playlistsMap);
        }
      }

      // Automatically update all visible items whenever data changes
      setProcessingStatuses({
        channels: channelsMap,
        playlists: playlistsMap
      });
    }
  )
);

// Collect visible IDs from current view for polling
const collectVisibleIdsFromData = () => {
  const channelIds = [];
  const playlistIds = [];

  const currentItems = items();

  // Collect from list view items
  if (isChannels() || isPlaylists()) {
    if (isChannels()) {
      collectVisibleIds(currentItems, null, channelIds, playlistIds);
    } else if (isPlaylists()) {
      collectVisibleIds(null, currentItems, channelIds, playlistIds);
    }
  }

  // Collect from detail view
  if (isChannelDetail() || isPlaylistDetail()) {
    const detail = currentItems;
    if (detail) {
      if (isChannelDetail()) {
        // Collect channel ID itself
        const channelId = detail.channel?.channel?.P?.youtubeId;
        if (channelId && !channelIds.includes(channelId)) {
          channelIds.push(channelId);
        }

        // Collect playlists in channel
        collectVisibleIds(null, detail.playlists, channelIds, playlistIds);
      } else if (isPlaylistDetail()) {
        // Collect playlist ID itself
        const playlistId = detail.playlist?.playlist?.P?.youtubeId;
        if (playlistId && !playlistIds.includes(playlistId)) {
          playlistIds.push(playlistId);
        }
      }
    }
  }

  // Collect from search results
  if (isSearchView()) {
    const results = currentItems;
    if (results) {
      collectVisibleIds(results.channels, results.playlists, channelIds, playlistIds);
    }
  }

  // Collect from favourites
  if (isFavouritesView()) {
    const favourites = currentItems;
    if (favourites) {
      collectVisibleIds(favourites.channels, favourites.playlists, channelIds, playlistIds);
    }
  }

  return { channelIds, playlistIds };
};

// Poll for processing status updates
const pollProcessingStatus = async () => {
  // Skip if already polling
  if (isPolling()) {
    return;
  }

  // Collect visible IDs from current view
  const { channelIds, playlistIds } = collectVisibleIdsFromData();

  // If no IDs to poll, skip
  if (channelIds.length === 0 && playlistIds.length === 0) {
    return;
  }

  isPolling(true);
  try {
    const result = await args.fns.executeYTOFunction("getProcessingStatusByIds", {
      channelIds,
      playlistIds
    });

    if (result?.error) {
      args.showErrorToast(result.error);
    } else if (result?.result?.success && result?.result?.data) {
      const data = result.result.data;

      // Convert arrays to objects keyed by ID for easier lookup
      const channelsMap = {};
      data.channels.forEach(item => {
        const channelId = item.channel?.P?.youtubeId;
        if (channelId) {
          channelsMap[channelId] = item;
        }
      });

      const playlistsMap = {};
      data.playlists.forEach(item => {
        const playlistId = item.playlist?.P?.youtubeId;
        if (playlistId) {
          playlistsMap[playlistId] = item;
        }
      });

      setProcessingStatuses({
        channels: channelsMap,
        playlists: playlistsMap
      });

      // If no active processing, stop polling and reload data
      if (!data.hasActiveProcessing) {
        stopPolling();
        // Reload data to show completed items in all views
        await loadData();
      }
    }
  } catch (error) {
    console.error('Error polling processing status:', error);
  } finally {
    isPolling(false);
  }
};

// Start polling
const startPolling = () => {
  // Don't start if already polling
  if (pollingInterval()) {
    return;
  }

  // Start polling immediately
  pollProcessingStatus();

  // Set up interval (poll every 3 seconds)
  const interval = setInterval(pollProcessingStatus, 3000);
  pollingInterval(interval);
};

// Stop polling
const stopPolling = () => {
  const interval = pollingInterval();
  if (interval) {
    clearInterval(interval);
    pollingInterval(null);
  }
  isPolling(false);
};

// Watch for processing status changes and start/stop polling as needed
args.createEffect(
  args.on([processingStatuses, pollingInterval], () => {
    const statuses = processingStatuses();

    // Check if any items are actually being processed (queued or processing status)
    let hasActiveProcessing = false;

    // Check channels
    for (const channelId in statuses.channels) {
      const item = statuses.channels[channelId];
      const queueStatus = item.channel?.P?.queueStatus;
      if (queueStatus === 'queued' || queueStatus === 'processing') {
        hasActiveProcessing = true;
        break;
      }
    }

    // Check playlists if no active channel processing found
    if (!hasActiveProcessing) {
      for (const playlistId in statuses.playlists) {
        const item = statuses.playlists[playlistId];
        const queueStatus = item.playlist?.P?.queueStatus;
        if (queueStatus === 'queued' || queueStatus === 'processing') {
          hasActiveProcessing = true;
          break;
        }
      }
    }

    // Start polling if there's active processing
    if (hasActiveProcessing && !pollingInterval()) {
      args.untrack(() => startPolling());
    }
    // Stop polling if there's no active processing
    else if (!hasActiveProcessing && pollingInterval()) {
      args.untrack(() => stopPolling());
    }
  })
);

// Cleanup on unmount
args.onCleanup(() => {
  args.untrack(() => stopPolling());
});

// Get processing status for a specific channel
const getChannelProcessingStatus = (channelId) => {
  return processingStatuses().channels[channelId] || null;
};

// Get processing status for a specific playlist
const getPlaylistProcessingStatus = (playlistId) => {
  return processingStatuses().playlists[playlistId] || null;
};

// Format processing status with detailed information
const formatProcessingStatus = (processingStatus, itemType) => {
  if (!processingStatus) {
    return null;
  }

  // Extract main item (queue tracking is on Channel/Playlist vertex)
  let item = null;
  if (itemType === "playlist") {
    item = processingStatus.playlist;
  } else if (itemType === "channel") {
    item = processingStatus.channel;
  }

  // If no item found, return null
  if (!item || !item.P) {
    return null;
  }

  const props = item.P;

  // Check if we have a valid queueStatus
  const queueStatus = props.queueStatus;
  if (!queueStatus) {
    return null;
  }

  // Format for any queueStatus: queued, processing, completed, or failed
  const progress = props.progress || 0;

  // Build details string based on item type
  let details = '';
  if (itemType === "channel") {
    const processedPlaylists = props.processedPlaylists || 0;
    const totalPlaylists = props.totalPlaylists || 0;
    const processedVideos = props.processedVideos || 0;
    const totalVideos = props.totalVideos || 0;
    details = `${processedPlaylists}/${totalPlaylists} playlists, ${processedVideos}/${totalVideos} videos`;
  } else if (itemType === "playlist") {
    const processedVideos = props.processedVideos || 0;
    const totalVideos = props.totalVideos || 0;
    details = `${processedVideos}/${totalVideos} videos`;
  }

  // Return formatted status
  return {
    ...processingStatus,
    queueStatus,
    progress,
    details,
    error: props.error || ''
  };
};

// Sync current channel or playlist
const syncCurrentItem = async () => {
  const data = items();

  if (!data) {
    args.showErrorToast("No item to sync");
    return;
  }

  isSyncing(true);

  try {
    if (isPlaylistDetail()) {
      const playlist = data.playlist?.playlist;
      if (!playlist) {
        args.showErrorToast("Playlist not found");
        isSyncing(false);
        return;
      }

      const url = `https://www.youtube.com/playlist?list=${playlist.P.youtubeId}`;

      const result = await args.fns.executeYTOFunction("savePlaylist", { url });

      if (result?.result?.success) {
        args.showSuccessToast(result.result.message || "Playlist synced successfully");
        await loadData();
      } else {
        args.showErrorToast(result?.result?.message || result?.error || "Failed to sync playlist");
      }
    } else if (isChannelDetail()) {
      const channel = data.channel?.channel;
      if (!channel) {
        args.showErrorToast("Channel not found");
        isSyncing(false);
        return;
      }

      const url = `https://www.youtube.com/channel/${channel.P.youtubeId}`;

      const result = await args.fns.executeYTOFunction("saveChannel", { url });

      if (result?.result?.success) {
        args.showSuccessToast(result.result.message || "Channel synced successfully");
        await loadData();
      } else {
        args.showErrorToast(result?.result?.message || result?.error || "Failed to sync channel");
      }
    }
  } catch (error) {
    console.error("Error syncing:", error);
    args.showErrorToast("An error occurred while syncing");
  } finally {
    isSyncing(false);
  }
};

// ----- FILTER DATA -------
// Helper to extract YouTube ID from item data (works for both raw and vertex data)
const getItemYouTubeId = (itemData, type) => {
  const item = itemData[type];
  if (!item) return null;

  // Raw extension data has .id property
  if (itemData.extensionData) {
    return item.id;
  }

  // Database vertex data has .P.youtubeId property
  return item.P?.youtubeId || null;
};
// Helper to convert extension item to Vertex format
const convertToVertex = (item, type) => {
  const label = type === 'channel' ? 'Channel' : type === 'playlist' ? 'Playlist' : 'Video';
  const youtubeId = item.id;

  // Generate thumbnail URLs based on type
  let thumbnailProps = {};
  if (type === 'video') {
    // For videos, use YouTube's thumbnail URLs
    thumbnailProps = {
      thumbnailDefault: `https://i.ytimg.com/vi/${youtubeId}/default.jpg`,
      thumbnailMedium: `https://i.ytimg.com/vi/${youtubeId}/mqdefault.jpg`,
      thumbnailHigh: `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`,
      thumbnailStandard: `https://i.ytimg.com/vi/${youtubeId}/sddefault.jpg`,
      thumbnailMaxres: `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`
    };
  } else if (type === 'channel' || type === 'playlist') {
    // For channels and playlists, use thumbnail from extension if available
    if (item.thumbnail) {
      thumbnailProps = {
        thumbnailHigh: item.thumbnail,
        thumbnailMedium: item.thumbnail,
        thumbnailDefault: item.thumbnail
      };
    }
  }

  return {
    resultType: type,
    [type]: {
      id: `ext:${type}:${youtubeId}`,
      L: [label],
      P: {
        youtubeId: youtubeId,
        title: item.title || youtubeId,
        ...thumbnailProps,
        // Extension-specific metadata (defaults to false if not provided)
        extensionExists: item.exists ?? false,
        extensionIsCurrentPage: item.isCurrentPage ?? false
      },
      IN: {},
      OUT: {}
    },
    [`${type}Setting`]: null
  };
};
// Helper to process extension item (handles both full vertex data and raw extension data)
const processExtensionItem = (itemData, type) => {
  // Check if this is raw extension data that needs conversion
  if (itemData.extensionData) {
    // Convert raw extension data to vertex format
    const rawItem = itemData[type];
    return convertToVertex(rawItem, type);
  } else {
    // Already has full vertex data from database
    // Add resultType and mark as existing
    const item = itemData[type];
    const itemSetting = itemData[`${type}Setting`];

    // Add extension metadata to the item properties
    if (item && item.P) {
      item.P.extensionExists = true;
      item.P.extensionIsCurrentPage = false; // Database items are never current page
    }

    return {
      resultType: type,
      [type]: item,
      [`${type}Setting`]: itemSetting
    };
  }
};

const filteredItems = args.createMemo(() => {
  const data = items();
  // Check if current combined string matches the saved state
  const currentKey = getDataKey();
  const savedKey = args.untrack(loadedDataKey);
  if (savedKey !== null && currentKey !== savedKey) {
    return [];
  }

  const term = searchTerm().toLowerCase();
  let items2 = [];

  if (isSearchView()) {
    if (data) {
      if (data.channels) items2.push(...data.channels.map(x => ({ ...x, resultType: "channel" })));
      if (data.playlists) items2.push(...data.playlists.map(x => ({ ...x, resultType: "playlist" })));
      if (data.videos) items2.push(...data.videos.map(x => ({ ...x, resultType: "video" })));
    }
  }

  else if (isFavouritesView()) {
    if (data) {
      if (data.channels)
        items2.push(...data.channels.map(x => ({ ...x, resultType: "channel" })));

      if (data.playlists)
        items2.push(...data.playlists.map(x => ({ ...x, resultType: "playlist" })));

      if (data.videos)
        items2.push(...data.videos.map(x => ({ ...x, resultType: "video" })));
    }
  }

  else if (isExtensionView()) {
    if (data) {
      const combined = [];
      const seen = {
        channel: new Set(),
        playlist: new Set(),
        video: new Set()
      };

      const addItem = (itemData, type) => {
        const id = getItemYouTubeId(itemData, type);
        if (!id || seen[type].has(id)) return;
        seen[type].add(id);
        combined.push(processExtensionItem(itemData, type));
      };

      if (data.channels) data.channels.forEach(x => addItem(x, "channel"));
      if (data.playlists) data.playlists.forEach(x => addItem(x, "playlist"));
      if (data.videos) data.videos.forEach(x => addItem(x, "video"));

      items2 = combined;
    }
  }
  else if (isChannelDetail()) {
    items2 = data?.playlists || [];
  }
  else if (isPlaylistDetail()) {
    items2 = data?.videos || [];
  }
  else if (isChannels()) {
    items2 = data;
  } else if (isPlaylists()) {
    items2 = data;
  }

  if (!term) return items2;

  return items2.filter(item => {
    if (item.video) {
      const v = item.video;
      const title = v?.P?.title?.toLowerCase() || "";
      const desc = v?.P?.description?.toLowerCase() || "";
      const channelTitle = v?.P?.channelTitle?.toLowerCase() || "";
      const note = item.videoSetting?.P?.note?.toLowerCase() || "";
      return title.includes(term) || desc.includes(term) || channelTitle.includes(term) || note.includes(term);
    }
    if (item.playlist) {
      const p = item.playlist;
      const title = p?.P?.title?.toLowerCase() || "";
      const desc = p?.P?.description?.toLowerCase() || "";
      const custom = item.playlistSetting?.P?.customName?.toLowerCase() || "";
      return title.includes(term) || desc.includes(term) || custom.includes(term);
    }
    if (item.channel) {
      const c = item.channel;
      const title = c?.P?.title?.toLowerCase() || "";
      const desc = c?.P?.description?.toLowerCase() || "";
      const custom = item.channelSetting?.P?.customName?.toLowerCase() || "";
      return title.includes(term) || desc.includes(term) || custom.includes(term);
    }
    return false;
  });
});

//------EXTRA FUNCTIONS----------
// Unified helper: Infer item type from data structure
const inferItemType = (data) => {
  if (data.video) {
    return { type: 'video', item: data.video, setting: data.videoSetting };
  }
  if (data.playlist) {
    return { type: 'playlist', item: data.playlist, setting: data.playlistSetting };
  }
  if (data.channel) {
    return { type: 'channel', item: data.channel, setting: data.channelSetting };
  }
  return null;
};

// Handle search form submission
const handleSearchSubmit = async (e) => {
  if (e) e.preventDefault();
  const query = searchInput().trim();
  if (query) {
    args.navigate(`/content?type=search&q=${encodeURIComponent(query)}`);
  }
};

const openModal = () => {
  setModalData({ editMode: false, itemData: null, contentType: contentType() });
  isModalOpen(true);
};

const closeModal = () => {
  isModalOpen(false);
  setModalData({ editMode: false, itemData: null });
};
// Generate YouTube URL for items (channels, playlists, videos)
const getYouTubeUrl = (item, itemType) => {
  if (!item) return null;

  const youtubeId = item.P?.youtubeId || "";

  if (itemType === "video") {
    return `https://www.youtube.com/watch?v=${youtubeId}`;
  } else if (itemType === "playlist") {
    // For special playlists, use originalPlaylistId for YouTube URL
    const playlistId = item.P?.originalPlaylistId || youtubeId;
    return `https://www.youtube.com/playlist?list=${playlistId}`;
  } else if (itemType === "channel") {
    // For channels, prefer handle format (@handle) over channel ID
    const handle = item.P?.handle || item.P?.customUrl;
    if (handle) {
      // Ensure handle starts with @
      const formattedHandle = handle.startsWith('@') ? handle : `@${handle}`;
      return `https://www.youtube.com/${formattedHandle}`;
    } else {
      // Check if youtubeId is a channel ID (starts with "UC") or a handle
      // For extension items, youtubeId might be a handle directly
      if (youtubeId.startsWith('UC')) {
        // Channel ID format
        return `https://www.youtube.com/channel/${youtubeId}`;
      } else {
        // Treat as handle format
        const formattedHandle = youtubeId.startsWith('@') ? youtubeId : `@${youtubeId}`;
        return `https://www.youtube.com/${formattedHandle}`;
      }
    }
  }

  return null;
};

return {
  enabled: true,
  contentType,
  detailId,
  searchQuery,
  isSearchView,
  isFavouritesView,
  isExtensionView,
  isChannelDetail,
  isPlaylistDetail,
  isPlaylists,
  isChannels,
  isPublicView,
  searchTerm,
  searchInput,
  pageContent,
  userSetting,
  settingLoaded,
  isAddVideosModalOpen,
  isAddVideoToPlaylistModalOpen,
  addVideoToPlaylistData,
  setAddVideoToPlaylistData,
  isSyncing,
  syncCurrentItem,
  items,
  loading,
  loadError,
  clearLoadError,
  isModalOpen,
  modalData,
  setModalData,
  isNoteModalOpen,
  noteModalData,
  setNoteModalData,
  filteredItems,
  getPlaylistProcessingStatus,
  getChannelProcessingStatus,
  formatProcessingStatus,
  inferItemType,
  handleSearchSubmit,
  loadData,
  loadUserSetting,
  initializeSortFromURL,
  updateURLSort,
  clearURLSort,
  splitSortValue,
  getCurrentSortOptions,
  getCurrentSortValue,
  setCurrentSortValue,
  getCurrentSortField,
  getCurrentSortDirection,
  handleSortFieldChange,
  handleSortDirectionToggle,
  sortBy,
  sortField,
  sortDirection,
  processingStatuses,
  getDefaultSortForView,
  getSortPreferenceKey,
  updateSortForCurrentView,
  openModal,
  closeModal,
  handleMessage,
  requestPageContent,
  getYouTubeUrl
};
'''
