        props:
          '''
return {
  isNoPermissionCheck: true,
  signinRequired: !args.fns.isPublicView(),
  onMount: () => {
    // Initialize sort from URL (highest priority)
    const hasURLSort = args.fns.initializeSortFromURL();

    // Load user setting (skip sort update if URL sort was set)
    args.fns.loadUserSetting(hasURLSort);

    // Add message listener for extension view
    window.addEventListener('message', args.fns.handleMessage);

    // Request page content if already in extension view
    if (args.fns.isExtensionView()) {
      args.fns.requestPageContent();
    }
  },
  onCleanup: () => {
    // Remove message listener for extension view
    window.removeEventListener('message', args.fns.handleMessage);
  }
};
