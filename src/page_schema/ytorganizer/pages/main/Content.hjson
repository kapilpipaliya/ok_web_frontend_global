    {
      id: "28"
      L: Attr
      P: {
        displayOrder: 3
        fns:
          '''
// Unified helper: Update item in array by ID
const updateItemInArrayById = (items, itemId, itemKey, settingKey, newSetting) => {
  return items.map(existingItem => {
    if (existingItem[itemKey]?.P?.youtubeId === itemId) {
      return { ...existingItem, [settingKey]: newSetting };
    }
    return existingItem;
  });
};

// Unified helper: Update all views with new item data
const updateAllViews = (itemInfo) => {
  if (!itemInfo) return;

  const { type, item, setting } = itemInfo;
  const itemId = item.P?.youtubeId;
  if (!itemId) return;

  // Map of type to field names
  const typeMap = {
    channel: { itemKey: 'channel', settingKey: 'channelSetting', arrayKey: 'channels' },
    playlist: { itemKey: 'playlist', settingKey: 'playlistSetting', arrayKey: 'playlists' },
    video: { itemKey: 'video', settingKey: 'videoSetting', arrayKey: 'videos' }
  };

  const { itemKey, settingKey, arrayKey } = typeMap[type];

  // Update list view
  if ((args.fns.isChannels() || args.fns.isPlaylists()) && args.fns.contentType() === arrayKey) {
    args.fns.items(updateItemInArrayById(args.fns.items(), itemId, itemKey, settingKey, setting));
  }

  // Update detail view
  if (args.fns.isChannelDetail() || args.fns.isPlaylistDetail()) {
    const detail = args.fns.items();
    if (!detail) return;

    // Update arrays in detail view
    if (detail[arrayKey]) {
      const updated = updateItemInArrayById(detail[arrayKey], itemId, itemKey, settingKey, setting);
      args.fns.items({ ...detail, [arrayKey]: updated });
    }

    // Update single item in detail view (channel/playlist object)
    if (detail[type]?.[itemKey]?.P?.youtubeId === itemId) {
      args.fns.items({ ...detail, [type]: { ...detail[type], [settingKey]: setting } });
    }
  }

  // Update search results
  if (args.fns.isSearchView()) {
    const results = args.fns.items();
    if (results?.[arrayKey]) {
      const updated = updateItemInArrayById(results[arrayKey], itemId, itemKey, settingKey, setting);
      args.fns.items({ ...results, [arrayKey]: updated });
    }
  }

  // Update favourites
  if (args.fns.isFavouritesView()) {
    const favourites = args.fns.items();
    if (favourites?.[arrayKey]) {
      const updated = updateItemInArrayById(favourites[arrayKey], itemId, itemKey, settingKey, setting);
      args.fns.items({ ...favourites, [arrayKey]: updated });
    }
  }

  // Update extension view
  if (args.fns.isExtensionView()) {
    const extension = args.fns.items();
    if (extension?.[arrayKey]) {
      const updated = updateItemInArrayById(extension[arrayKey], itemId, itemKey, settingKey, setting);
      args.fns.items({ ...extension, [arrayKey]: updated });
    }
  }
};

// Update item data after toggle favourite
const updateItemDataAfterToggleFavourite = (updatedData) => {
  const itemInfo = args.fns.inferItemType(updatedData);
  updateAllViews(itemInfo);
};

// Update item data after note is saved
const updateItemDataAfterNoteSave = (updatedData) => {
  const itemInfo = args.fns.inferItemType(updatedData);
  updateAllViews(itemInfo);
};


const handleModalSave = async (saveData) => {
  args.fns.closeModal();

  if (saveData?.editMode && saveData?.result) {
    // Edit mode - update local data instead of refetching
    updateItemDataAfterNoteSave(saveData.result);
  } else {
    // Add mode, reload all data
    await args.fns.loadData();
  }
};

// Note modal functions
const openNoteModal = (item, existingNote = "") => {
  args.fns.setNoteModalData({ item, existingNote });
  args.fns.isNoteModalOpen(true);
};

const closeNoteModal = () => {
  args.fns.isNoteModalOpen(false);
  args.fns.setNoteModalData({ item: null, existingNote: "" });
};

const saveNote = async (data) => {
  try {
    const result = await args.fns.executeYTOFunction("saveNote", data);

    if (result?.result?.success) {
      args.showSuccessToast(result.result.message);

      // Update item data locally
      updateItemDataAfterNoteSave(result.result.data);

      return result.result;
    } else {
      const errorMessage = result?.result?.message || result?.error || "Failed to save note";
      args.showErrorToast(errorMessage);
      const error = new Error(errorMessage);
      error.toastShown = true;
      throw error;
    }
  } catch (error) {
    // Only show toast for unexpected errors (network, etc.)
    if (!error.toastShown) {
      console.error("Unexpected error saving note:", error);
      args.showErrorToast("Failed to save note");
    }
    throw error;
  }
};

// Toggle favourite function
const toggleFavourite = async (item) => {
  try {
    const result = await args.fns.executeYTOFunction("toggleFavourite", { item });

    if (result?.result?.success) {
      args.showSuccessToast(result.result.message);

      // Update item data locally
      updateItemDataAfterToggleFavourite(result.result.data);

      return result.result;
    } else {
      const errorMessage = result?.result?.message || result?.error || "Failed to toggle favourite";
      args.showErrorToast(errorMessage);
      const error = new Error(errorMessage);
      error.toastShown = true;
      throw error;
    }
  } catch (error) {
    // Only show toast for unexpected errors (network, etc.)
    if (!error.toastShown) {
      console.error("Unexpected error toggling favourite:", error);
      args.showErrorToast("Failed to toggle favourite");
    }
    throw error;
  }
};

const openInYouTube = (item) => {
  const data = args.fns.contentType() === "playlists" ? item.playlist : item.channel;
  const youtubeId = data?.P?.youtubeId || "";
  const url = args.fns.contentType() === "playlists"
    ? `https://www.youtube.com/playlist?list=${youtubeId}`
    : `https://www.youtube.com/channel/${youtubeId}`;
  window.open(url, "_blank");
};

const editCustomName = async (item) => {
  args.fns.setModalData({ editMode: true, itemData: item });
  args.fns.isModalOpen(true);
};

const openCustomNameModal = (itemData) => {
  args.fns.setModalData({ editMode: true, itemData });
  args.fns.isModalOpen(true);
};

// Unified delete function for channels, playlists, and videos
const deleteItem = async (item) => {
  const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
  if (!rbConfirm) {
    args.showErrorToast("Confirmation dialog not available");

    return;
  }

  // Infer item type and extract data
  const itemInfo = args.fns.inferItemType(item);
  if (!itemInfo) {
    args.showErrorToast("Cannot determine item type");

    return;
  }

  const { type: itemType, item: data } = itemInfo;
  const title = data?.P?.title || "this item";

  // Build confirmation message with type-specific details
  const deleteMessages = {
    channel: "\n\nThis will also delete:\n• All playlists in this channel\n• All videos that are only in this channel's playlists",
    playlist: "\n\nThis will also delete:\n• All videos that are only in this playlist",
    video: () => {
      const detail = args.fns.items();
      const contextItem = detail?.playlist?.playlist;
      const contextName = contextItem?.P?.title || "current view";
      return `\n\nRemoving from ${contextName}.\n\nNote: This video will only be deleted if it doesn't exist in other playlists or the channel.`;
    }
  };

  let message = `Are you sure you want to delete "${title}"?`;
  const extraMessage = deleteMessages[itemType];
  message += typeof extraMessage === 'function' ? extraMessage() : extraMessage;
  message += "\n\nThis action cannot be undone!";

  const confirmed = await rbConfirm({
    title: `Delete ${itemType}`,
    message,
    confirmText: `Delete ${itemType}`,
    cancelText: "Cancel",
    variant: "danger"
  });

  if (confirmed) {
    try {
      // Call appropriate delete function with unified pattern
      const deleteConfig = {
        channel: {
          functionName: 'deleteChannel',
          params: { items: [data], itemType, contextItems: [] },
          onSuccess: args.fns.loadData
        },
        playlist: {
          functionName: 'deletePlaylist',
          params: { items: [data], itemType, contextItems: [] },
          onSuccess: args.fns.loadData
        },
        video: {
          functionName: 'deleteVideo',
          params: () => {
            const detail = args.fns.items();
            const contextItem = detail?.playlist?.playlist;
            if (!contextItem) {
              throw new Error("Playlist information not found");
            }
            return { videos: [data], contextType: 'playlist', contextItems: [contextItem] };
          },
          onSuccess: args.fns.loadData
        }
      };

      const config = deleteConfig[itemType];
      const params = typeof config.params === 'function' ? config.params() : config.params;

      const result = await args.fns.executeYTOFunction(config.functionName, params);

      if (result?.result?.success) {
        args.showSuccessToast(result.result.message);
        await config.onSuccess();
      } else {
        args.showErrorToast(result?.result?.message || result?.error || `Failed to delete ${itemType}`);
      }
    } catch (error) {
      console.error(`Error deleting ${itemType}:`, error);
      args.showErrorToast(error.message || `An error occurred while deleting ${itemType}`);
    }
  }
};

return {
  updateItemInArrayById,
  updateAllViews,
  updateItemDataAfterToggleFavourite,
  updateItemDataAfterNoteSave,
  handleModalSave,
  openNoteModal,
  closeNoteModal,
  saveNote,
  toggleFavourite,
  openInYouTube,
  editCustomName,
  openCustomNameModal,
  deleteItem,

}'''
        componentName: Html
        props:
          '''
return {
  as: "div",

};
'''
      }
    }
