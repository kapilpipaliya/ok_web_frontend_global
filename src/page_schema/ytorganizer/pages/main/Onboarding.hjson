    // Steps grid with loop
    {
      id: "26"
      L: "Attr"
      P: {
        displayOrder: 3
        componentName: "Html"
        contextName: "step"
        loop: true
        props: '''
const steps = [
  {
    number: 1,
    icon: "mdi:youtube",
    title: "Connect Your YouTube Account",
    description: "Click 'Go to Accounts' below to connect your YouTube account via OAuth"
  },
  {
    number: 2,
    icon: "carbon:application",
    title: "Add Channels",
    description: "Add your favorite YouTube channels to track their content"
  },
  {
    number: 3,
    icon: "carbon:playlist",
    title: "Organize Playlists",
    description: "Create and manage playlists with your favorite videos"
  },
  {
    number: 4,
    icon: "carbon:analytics",
    title: "Track & Enjoy",
    description: "Keep everything organized in one convenient place"
  }
];

return {
  as: "div",
  data: steps
};
'''
        css: '''
return `._id {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;

  @media (max-width: 768px) {
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
}`;
'''
