{
  vertexes: [
    {
      id: "1"
      L: "Page"
      P: {
        key: "Onboarding"
        url: "/onboarding"
        signinRequired: true,
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    }
    {
      id: "2"
      L: "PageLayout"
      P: {
        componentName: "Layout",
        displayOrder: 1
      }
    }
    {
      id: "2a"
      L: "PageLayout"
      P: {
        componentName: "LayoutContent",
        displayOrder: 2
      }
    }
    // Main container
    {
      id: "3"
      L: "Attr"
      P: {
        displayOrder: 1
        componentName: "Html"
        fns: '''
const [loading, setLoading] = args.createSignal(false);

const navigateToAccounts = () => {
  args.navigate('/accounts');
};

const completeOnboarding = async () => {
  setLoading(true);
  try {
    const response = await args.executeNamedServerFunction({
      functionName: "checkOnboardingStatus",
      contextData: { markComplete: true }
    });

    const result = response.result;

    if (result.success) {
      args.showSuccessToast("Welcome to YSaar!");
      // Navigate to home after a short delay
      setTimeout(() => {
        args.navigate('/home');
      }, 500);
    } else {
      // Show specific error message from validation
      args.showErrorToast(result.error || "Failed to complete onboarding");
    }
  } catch (error) {
    args.showErrorToast("An error occurred");
    console.error(error);
  } finally {
    setLoading(false);
  }
};

return {
  loading,
  completeOnboarding,
  navigateToAccounts
};
'''
        props: '''
return {
  as: "div"
};
'''
        css: '''
return `._id {
  max-width: 800px;
  margin: 0 auto;
  padding: 1rem;
  padding-bottom: 6rem;

  @media (max-width: 768px) {
    padding: 0.75rem;
    padding-bottom: 5rem;
  }
}`;
'''
      }
    }
    // Example content section
    {
      id: "23"
