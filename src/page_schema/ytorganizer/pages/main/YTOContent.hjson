{
  vertexes: [
    {
      id: "page_root",
      L: "Page",
      P: {
        key: "YTOContent",
        url: "/content",
        signinRequired: true,
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true,
};
'''
      }
    },
    {
      id: "page_layout",
      L: "PageLayout",
      P: {
        componentName: "YTOLayout",
        displayOrder: 1
      }
    },
    {
      id: "page_root_container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        fns: '''
const contentType = args.searchParams?.type || "channels";
const detailId = args.searchParams?.id || null;
const searchQuery = args.searchParams?.q || "";

// Reactive view mode detection
const isDetailView = args.createMemo(() => !!args.searchParams?.id);
const isSearchView = args.createMemo(() => args.searchParams?.q !== undefined);
const isFavouritesView = args.createMemo(() => contentType === "favourites");
const isListView = args.createMemo(() => !isDetailView() && !isSearchView() && !isFavouritesView());

// State for data
const [items, setItems] = args.createSignal([]);
const [loading, setLoading] = args.createSignal(true);
const [searchTerm, setSearchTerm] = args.createSignal("");
const [scrollElement, setScrollElement] = args.createSignal(null);

// State for detail view
const [detailData, setDetailData] = args.createSignal(null);
const [detailSearchTerm, setDetailSearchTerm] = args.createSignal("");

// State for search view
const [searchResults, setSearchResults] = args.createSignal(null);
const [searchInput, setSearchInput] = args.createSignal(searchQuery);

// State for favourites view
const [favouritesData, setFavouritesData] = args.createSignal(null);

// State for user setting
const [userSetting, setUserSetting] = args.createSignal(null);
const [settingLoaded, setSettingLoaded] = args.createSignal(false);

// Sort state for different views - split into field + direction for better UX
// List view (channels/playlists)
const [listSortField, setListSortField] = args.createSignal("title");
const [listSortDirection, setListSortDirection] = args.createSignal("asc");

// Detail view (playlists for channels / videos for playlists)
const [detailSortField, setDetailSortField] = args.createSignal("position");
const [detailSortDirection, setDetailSortDirection] = args.createSignal("asc");

// Search view
const [searchSortField, setSearchSortField] = args.createSignal("relevance");
const [searchSortDirection, setSearchSortDirection] = args.createSignal("asc");

// Favourites view
const [favouritesSortField, setFavouritesSortField] = args.createSignal("favourited");
const [favouritesSortDirection, setFavouritesSortDirection] = args.createSignal("desc");

// Computed values for backward compatibility and backend calls
const listSortBy = args.createMemo(() =>
  listSortField() === "relevance" ? "relevance" : `${listSortField()}_${listSortDirection()}`
);
const detailSortBy = args.createMemo(() =>
  detailSortField() === "relevance" ? "relevance" : `${detailSortField()}_${detailSortDirection()}`
);
const searchSortBy = args.createMemo(() =>
  searchSortField() === "relevance" ? "relevance" : `${searchSortField()}_${searchSortDirection()}`
);
const favouritesSortBy = args.createMemo(() =>
  favouritesSortField() === "relevance" ? "relevance" : `${favouritesSortField()}_${favouritesSortDirection()}`
);

// Initialize sort from URL if present (highest priority)
const initializeSortFromURL = () => {
  const urlSort = args.searchParams?.sort;
  if (!urlSort) return false;

  // Handle "relevance" special case
  if (urlSort === "relevance") {
    if (isSearchView()) {
      setSearchSortField("relevance");
      setSearchSortDirection("asc");
    }
    return true;
  }

  // Validate sort format (field_direction)
  const sortPattern = /^([a-z_]+)_(asc|desc)$/;
  const match = urlSort.match(sortPattern);

  if (!match) {
    console.warn('Invalid sort parameter in URL:', urlSort);
    return false;
  }

  const [, field, direction] = match;

  // Apply to current view
  if (isFavouritesView()) {
    setFavouritesSortField(field);
    setFavouritesSortDirection(direction);
  } else if (isSearchView()) {
    setSearchSortField(field);
    setSearchSortDirection(direction);
  } else if (isDetailView()) {
    setDetailSortField(field);
    setDetailSortDirection(direction);
  } else {
    setListSortField(field);
    setListSortDirection(direction);
  }

  return true;
};

// Update URL when sort changes
const updateURLSort = (sortValue) => {
  if (!sortValue) return;

  const currentPath = window.location.pathname;
  const currentSearch = new URLSearchParams(window.location.search);

  currentSearch.set('sort', sortValue);

  const newURL = `${currentPath}?${currentSearch.toString()}`;
  window.history.replaceState({}, '', newURL);
};

// Clear sort from URL
const clearURLSort = () => {
  const currentPath = window.location.pathname;
  const currentSearch = new URLSearchParams(window.location.search);

  currentSearch.delete('sort');

  const newURL = currentSearch.toString()
    ? `${currentPath}?${currentSearch.toString()}`
    : currentPath;

  window.history.replaceState({}, '', newURL);
};

// Helper to split "field_direction" format into field + direction
const splitSortValue = (sortValue) => {
  if (!sortValue || sortValue === "relevance") {
    return { field: "relevance", direction: "asc" };
  }

  const match = sortValue.match(/^([a-z_]+)_(asc|desc)$/);
  if (!match) {
    return { field: "title", direction: "asc" }; // fallback
  }

  return { field: match[1], direction: match[2] };
};

// Function to load user setting
const loadUserSetting = async () => {
  try {
    const result = await args.fns.executeYTOFunction("getYTOUserSetting", {});

    if (result?.result?.success && result?.result?.data?.setting) {
      const settingVertex = result.result.data.setting;
      setUserSetting(settingVertex);

      // Update sort signals from saved setting (access via .P property)
      if (settingVertex.P?.sortPreferences) {
        const prefs = typeof settingVertex.P.sortPreferences === 'string'
          ? JSON.parse(settingVertex.P.sortPreferences)
          : settingVertex.P.sortPreferences;

        // Set initial sort values from preferences (split into field + direction)
        if (prefs.channels) {
          const { field, direction } = splitSortValue(prefs.channels);
          setListSortField(field);
          setListSortDirection(direction);
        }
        if (prefs.videos) {
          const { field, direction } = splitSortValue(prefs.videos);
          setDetailSortField(field);
          setDetailSortDirection(direction);
        }
        if (prefs.favourites) {
          const { field, direction } = splitSortValue(prefs.favourites);
          setFavouritesSortField(field);
          setFavouritesSortDirection(direction);
        }
      }

      setSettingLoaded(true);
    }
  } catch (error) {
    console.error("Error loading user setting:", error);
    setSettingLoaded(true);  // Mark as loaded even on error to prevent blocking
  }
};

// Clear URL sort param when view changes
args.createEffect(() => {
  // Track view state
  const detailView = isDetailView();
  const searchView = isSearchView();
  const favourites = isFavouritesView();

  // Clear URL on view change (not on initial mount)
  if (settingLoaded()) {
    clearURLSort();
  }
});

// Save user setting when sort preferences change
const debouncedSaveSetting = args.debounce(async () => {
  try {
    const currentSettingVertex = userSetting() || { P: {} };

    const sortPreferences = {
      channels: listSortBy(),
      playlists: listSortBy(),  // Playlists use the same sort as channels in list view
      videos: detailSortBy(),
      favourites: favouritesSortBy()
    };

    const updatedSettingProps = {
      ...currentSettingVertex.P,
      sortPreferences: JSON.stringify(sortPreferences)
    };

    await args.fns.executeYTOFunction("saveYTOUserSetting", {
      setting: updatedSettingProps
    });

    // Update local vertex with new properties
    setUserSetting({
      ...currentSettingVertex,
      P: updatedSettingProps
    });
  } catch (error) {
    console.error("Error saving user setting:", error);
  }
}, 1000);  // Debounce for 1 second to avoid excessive saves

// Watch sort changes and save setting
args.createEffect(
  args.on(
    () => [listSortBy(), detailSortBy(), favouritesSortBy(), settingLoaded()],
    () => {
      // Only save if setting have been loaded (avoid saving defaults before load)
      if (settingLoaded()) {
        debouncedSaveSetting();
      }
    }
  )
);

// Sort options for different content types (field only, direction handled by toggle)
const channelSortOptions = [
  { value: "title", text: "Title" },
  { value: "created", text: "Created Date" },
  { value: "videos", text: "Video Count" }
];

const playlistSortOptions = [
  { value: "title", text: "Title" },
  { value: "created", text: "Created Date" },
  { value: "videos", text: "Video Count" },
  { value: "position", text: "Playlist Order" }
];

const videoSortOptions = [
  { value: "position", text: "Playlist Order" },
  { value: "title", text: "Title" },
  { value: "published", text: "Published Date" },
  { value: "duration", text: "Duration" }
];

const favouritesSortOptions = [
  { value: "favourited", text: "Favourited Date" },
  { value: "title", text: "Title" },
  { value: "created", text: "Created Date" }
];

// Get current sort options based on view and content type
const getCurrentSortOptions = args.createMemo(() => {
  if (isFavouritesView()) {
    return favouritesSortOptions;
  }
  if (isDetailView()) {
    return contentType === "channels" ? playlistSortOptions : videoSortOptions;
  }
  if (isSearchView()) {
    return [
      { value: "relevance", text: "Default" },
      { value: "title", text: "Title" },
      { value: "created", text: "Created Date" }
    ];
  }
  return contentType === "playlists" ? playlistSortOptions : channelSortOptions;
});

// Get current sort value based on view
const getCurrentSortValue = args.createMemo(() => {
  if (isFavouritesView()) return favouritesSortBy();
  if (isDetailView()) return detailSortBy();
  if (isSearchView()) return searchSortBy();
  return listSortBy();
});

// Set current sort value based on view
const setCurrentSortValue = (value) => {
  const { field, direction } = splitSortValue(value);

  if (isFavouritesView()) {
    setFavouritesSortField(field);
    setFavouritesSortDirection(direction);
  } else if (isDetailView()) {
    setDetailSortField(field);
    setDetailSortDirection(direction);
  } else if (isSearchView()) {
    setSearchSortField(field);
    setSearchSortDirection(direction);
  } else {
    setListSortField(field);
    setListSortDirection(direction);
  }

  // Update URL with new sort value
  updateURLSort(value);
};

// Get current sort field based on view
const getCurrentSortField = args.createMemo(() => {
  if (isFavouritesView()) return favouritesSortField();
  if (isDetailView()) return detailSortField();
  if (isSearchView()) return searchSortField();
  return listSortField();
});

// Get current sort direction based on view
const getCurrentSortDirection = args.createMemo(() => {
  if (isFavouritesView()) return favouritesSortDirection();
  if (isDetailView()) return detailSortDirection();
  if (isSearchView()) return searchSortDirection();
  return listSortDirection();
});

// Handle field change (keeps direction the same)
const handleSortFieldChange = (newField) => {
  const currentDirection = getCurrentSortDirection();
  const newSortValue = newField === "relevance" ? "relevance" : `${newField}_${currentDirection}`;
  setCurrentSortValue(newSortValue);
};

// Handle direction toggle (keeps field the same)
const handleSortDirectionToggle = () => {
  const currentField = getCurrentSortField();
  const currentDirection = getCurrentSortDirection();
  const newDirection = currentDirection === "asc" ? "desc" : "asc";
  const newSortValue = `${currentField}_${newDirection}`;
  setCurrentSortValue(newSortValue);
};

// Note modal state
const [isNoteModalOpen, setIsNoteModalOpen] = args.createSignal(false);
const [noteModalData, setNoteModalData] = args.createStore({ item: null, existingNote: "" });

// Virtualization constants
const overscan = 5;
const [scrollTop, setScrollTop] = args.createSignal(0);
const [windowWidth, setWindowWidth] = args.createSignal(768); // Default to mobile width, updated in onMount

// Virtualization state for detail view items (playlists for channels, videos for playlists)
const [detailScrollTop, setDetailScrollTop] = args.createSignal(0);
const [detailScrollElement, setDetailScrollElement] = args.createSignal(null);

// Get items from detail data (playlists for channels, videos for playlists)
const detailItems = args.createMemo(() => {
  const data = detailData();
  if (!data) return [];

  // For channels, return playlists
  if (contentType === "channels") {
    return data.playlists || [];
  }

  // For playlists, return videos
  return data.videos || [];
});

// Filtered detail items based on search term
const filteredDetailItems = args.createMemo(() => {
  const term = detailSearchTerm().toLowerCase();
  if (!term) return detailItems();

  return detailItems().filter(item => {
    // For playlists (in channel detail view)
    if (item.playlist) {
      const playlist = item.playlist;
      const playlistSetting = item.playlistSetting;
      const title = playlist?.P?.title?.toLowerCase() || "";
      const description = playlist?.P?.description?.toLowerCase() || "";
      const customName = playlistSetting?.P?.customName?.toLowerCase() || "";
      return title.includes(term) || description.includes(term) || customName.includes(term);
    }

    // For videos (in playlist detail view)
    if (item.video) {
      const video = item.video;
      const videoSetting = item.videoSetting;
      const title = video?.P?.title?.toLowerCase() || "";
      const description = video?.P?.description?.toLowerCase() || "";
      const channelTitle = video?.P?.channelTitle?.toLowerCase() || "";
      const notes = videoSetting?.P?.notes?.toLowerCase() || "";
      return title.includes(term) || description.includes(term) || channelTitle.includes(term) || notes.includes(term);
    }

    return false;
  });
});

// Virtualization state for search results
const [searchScrollTop, setSearchScrollTop] = args.createSignal(0);
const [searchScrollElement, setSearchScrollElement] = args.createSignal(null);

// Get combined search results
const getSearchItems = args.createMemo(() => {
  const results = searchResults();
  if (!results) return [];

  const combined = [];

  // Add channels
  if (results.channels) {
    results.channels.forEach(item => {
      combined.push({ ...item, resultType: 'channel' });
    });
  }

  // Add playlists
  if (results.playlists) {
    results.playlists.forEach(item => {
      combined.push({ ...item, resultType: 'playlist' });
    });
  }

  // Add videos
  if (results.videos) {
    results.videos.forEach(item => {
      combined.push({ ...item, resultType: 'video' });
    });
  }

  return combined;
});

// Get combined favourites items with filtering
const getFavouritesItems = args.createMemo(() => {
  const data = favouritesData();
  if (!data) return [];

  const term = searchTerm().toLowerCase();
  const combined = [];

  // Add favourite channels
  if (data.channels) {
    data.channels.forEach(item => {
      if (!term) {
        combined.push({ ...item, resultType: 'channel' });
      } else {
        const channel = item.channel;
        const channelSetting = item.channelSetting;
        const title = channel?.P?.title?.toLowerCase() || "";
        const description = channel?.P?.description?.toLowerCase() || "";
        const customName = channelSetting?.P?.customName?.toLowerCase() || "";
        if (title.includes(term) || description.includes(term) || customName.includes(term)) {
          combined.push({ ...item, resultType: 'channel' });
        }
      }
    });
  }

  // Add favourite playlists
  if (data.playlists) {
    data.playlists.forEach(item => {
      if (!term) {
        combined.push({ ...item, resultType: 'playlist' });
      } else {
        const playlist = item.playlist;
        const playlistSetting = item.playlistSetting;
        const title = playlist?.P?.title?.toLowerCase() || "";
        const description = playlist?.P?.description?.toLowerCase() || "";
        const customName = playlistSetting?.P?.customName?.toLowerCase() || "";
        if (title.includes(term) || description.includes(term) || customName.includes(term)) {
          combined.push({ ...item, resultType: 'playlist' });
        }
      }
    });
  }

  // Add favourite videos
  if (data.videos) {
    data.videos.forEach(item => {
      if (!term) {
        combined.push({ ...item, resultType: 'video' });
      } else {
        const video = item.video;
        const videoSetting = item.videoSetting;
        const title = video?.P?.title?.toLowerCase() || "";
        const description = video?.P?.description?.toLowerCase() || "";
        const channelTitle = video?.P?.channelTitle?.toLowerCase() || "";
        const notes = videoSetting?.P?.notes?.toLowerCase() || "";
        if (title.includes(term) || description.includes(term) || channelTitle.includes(term) || notes.includes(term)) {
          combined.push({ ...item, resultType: 'video' });
        }
      }
    });
  }

  return combined;
});

// Reactive item height for detail items (playlists or videos)
const getDetailItemHeight = () => {
  return 90;
};

// Calculate visible items for detail view
const getDetailVisibleRange = () => {
  const el = detailScrollElement();
  const videos = filteredDetailItems();
  const scroll = detailScrollTop();
  const itemHeight = getDetailItemHeight();

  // If no element yet, use a default container height to render initial items
  // NOTE: Do NOT return early with {start: 0, end: 0} when el doesn't exist,
  // as that would only render 1 item. Use default height to calculate proper range.
  const containerHeight = el?.clientHeight || 600;

  const startIndex = Math.max(0, Math.floor(scroll / itemHeight) - overscan);
  const endIndex = Math.min(
    videos.length - 1,
    Math.ceil((scroll + containerHeight) / itemHeight) + overscan
  );

  return { start: startIndex, end: endIndex };
};

// Get virtual items to render for detail view
const getDetailVirtualItems = () => {
  const { start, end } = getDetailVisibleRange();
  const items = [];
  const itemHeight = getDetailItemHeight();

  for (let i = start; i <= end; i++) {
    items.push({
      index: i,
      start: i * itemHeight,
      size: itemHeight
    });
  }

  return items;
};

// Total height of all detail videos
const getDetailTotalSize = () => filteredDetailItems().length * getDetailItemHeight();

// Handle scroll for detail view
const handleDetailScroll = (e) => {
  setDetailScrollTop(e.target.scrollTop);
};

// Reactive item height for search results
const getSearchItemHeight = () => {
  return 90;
};

// Calculate visible items for search view
const getSearchVisibleRange = () => {
  const el = searchScrollElement();
  const searchItems = getSearchItems();
  const scroll = searchScrollTop();
  const itemHeight = getSearchItemHeight();

  // If no element yet, use a default container height to render initial items
  // NOTE: Do NOT return early with {start: 0, end: 0} when el doesn't exist,
  // as that would only render 1 item. Use default height to calculate proper range.
  const containerHeight = el?.clientHeight || 600;

  const startIndex = Math.max(0, Math.floor(scroll / itemHeight) - overscan);
  const endIndex = Math.min(
    searchItems.length - 1,
    Math.ceil((scroll + containerHeight) / itemHeight) + overscan
  );

  return { start: startIndex, end: endIndex };
};

// Get virtual items to render for search view
const getSearchVirtualItems = () => {
  const { start, end } = getSearchVisibleRange();
  const virtualItems = [];
  const itemHeight = getSearchItemHeight();

  for (let i = start; i <= end; i++) {
    virtualItems.push({
      index: i,
      start: i * itemHeight,
      size: itemHeight
    });
  }

  return virtualItems;
};

// Total height of all search results
const getSearchTotalSize = () => getSearchItems().length * getSearchItemHeight();

// Handle scroll for search view
const handleSearchScroll = (e) => {
  setSearchScrollTop(e.target.scrollTop);
};

// Virtualization state for favourites
const [favouritesScrollTop, setFavouritesScrollTop] = args.createSignal(0);
const [favouritesScrollElement, setFavouritesScrollElement] = args.createSignal(null);

// Reactive item height for favourites
const getFavouritesItemHeight = () => {
  return 90;
};

// Calculate visible items for favourites view
const getFavouritesVisibleRange = () => {
  const el = favouritesScrollElement();
  const favouritesItems = getFavouritesItems();
  const scroll = favouritesScrollTop();
  const itemHeight = getFavouritesItemHeight();

  const containerHeight = el?.clientHeight || 600;

  const startIndex = Math.max(0, Math.floor(scroll / itemHeight) - overscan);
  const endIndex = Math.min(
    favouritesItems.length - 1,
    Math.ceil((scroll + containerHeight) / itemHeight) + overscan
  );

  return { start: startIndex, end: endIndex };
};

// Get virtual items to render for favourites view
const getFavouritesVirtualItems = () => {
  const { start, end } = getFavouritesVisibleRange();
  const virtualItems = [];
  const itemHeight = getFavouritesItemHeight();

  for (let i = start; i <= end; i++) {
    virtualItems.push({
      index: i,
      start: i * itemHeight,
      size: itemHeight
    });
  }

  return virtualItems;
};

// Total height of all favourites
const getFavouritesTotalSize = () => getFavouritesItems().length * getFavouritesItemHeight();

// Handle scroll for favourites view
const handleFavouritesScroll = (e) => {
  setFavouritesScrollTop(e.target.scrollTop);
};

// Menu state
const [activeMenu, setActiveMenu] = args.createSignal(null);
const [menuPosition, setMenuPosition] = args.createSignal({ x: 0, y: 0 });

// Modal state
const [isModalOpen, setIsModalOpen] = args.createSignal(false);
const [modalData, setModalData] = args.createStore({ editMode: false, itemData: null });

// Reactive item height based on screen size
const getItemHeight = () => {
  return 90;
};

// Handle window resize
const handleResize = () => {
  setWindowWidth(window.innerWidth);
};

// Calculate visible items
const getVisibleRange = () => {
  const el = scrollElement();
  const filtered = filteredItems();
  const scroll = scrollTop();
  const itemHeight = getItemHeight();

  // If no element yet, use a default container height to render initial items
  // NOTE: Do NOT return early with {start: 0, end: 0} when el doesn't exist,
  // as that would only render 1 item. Use default height to calculate proper range.
  const containerHeight = el?.clientHeight || 600;

  const startIndex = Math.max(0, Math.floor(scroll / itemHeight) - overscan);
  const endIndex = Math.min(
    filtered.length - 1,
    Math.ceil((scroll + containerHeight) / itemHeight) + overscan
  );

  return { start: startIndex, end: endIndex };
};

// Get virtual items to render
const getVirtualItems = () => {
  const { start, end } = getVisibleRange();
  const items = [];
  const itemHeight = getItemHeight();

  for (let i = start; i <= end; i++) {
    items.push({
      index: i,
      start: i * itemHeight,
      size: itemHeight
    });
  }

  return items;
};

// Total height of all items
const getTotalSize = () => filteredItems().length * getItemHeight();

// Handle scroll
const handleScroll = (e) => {
  setScrollTop(e.target.scrollTop);
};

// Load list data
const loadListData = async () => {
  setLoading(true);
  try {
    const functionName = contentType === "playlists" ? "getUserPlaylists" : "getUserChannels";
    const result = await args.fns.executeYTOFunction(functionName, {
      sortBy: listSortBy()
    });

    if (result?.error) {
      console.error("Error loading data:", result.error);
      args.showErrorToast(result.error);
      setItems([]);
    } else if (result?.result?.success && result?.result?.data) {
      const itemsData = contentType === "playlists"
        ? result.result.data.playlists || []
        : result.result.data.channels || [];
      setItems(itemsData);
    } else {
      // Handle error case
      const errorMessage = result?.result?.message || "Failed to load data";
      const errorDetails = result?.result?.error?.details;

      console.error("Error loading data:", errorDetails || errorMessage);
      args.showErrorToast(errorMessage);

      setItems([]);
    }
  } catch (error) {
    console.error("Unexpected error loading data:", error);
    args.showErrorToast("Failed to load data");
    setItems([]);
  } finally {
    setLoading(false);
  }
};

// Load detail data
const loadDetailData = async () => {
  setLoading(true);
  try {
    const functionName = contentType === "playlists" ? "getPlaylistVideos" : "getChannelContents";
    const result = await args.fns.executeYTOFunction(functionName, {
      [contentType === "playlists" ? "playlistId" : "channelId"]: detailId,
      sortBy: detailSortBy()
    });

    if (result?.error) {
      console.error("Error loading details:", result.error);
      args.showErrorToast(result.error);
      setDetailData(null);
    } else if (result?.result?.success && result?.result?.data) {
      setDetailData(result.result.data);
    } else {
      // Handle error case
      const errorMessage = result?.result?.message || "Failed to load details";
      const errorDetails = result?.result?.error?.details;

      console.error("Error loading details:", errorDetails || errorMessage);
      args.showErrorToast(errorMessage);

      setDetailData(null);
    }
  } catch (error) {
    console.error("Error loading detail data:", error);
    args.showErrorToast("Failed to load details");
    setDetailData(null);
  } finally {
    setLoading(false);
  }
};

// Load search data
const loadSearchData = async (query) => {
  if (!query || query.trim().length === 0) {
    setSearchResults({ channels: [], playlists: [], videos: [], totalCount: 0 });
    setLoading(false);
    return;
  }

  setLoading(true);
  try {
    const result = await args.fns.executeYTOFunction("searchUserContent", {
      query: query.trim(),
      type: "all",
      sortBy: searchSortBy()
    });

    if (result?.error) {
      console.error("Error searching:", result.error);
      args.showErrorToast(result.error);
      setSearchResults({ channels: [], playlists: [], videos: [], totalCount: 0 });
    } else if (result?.result?.success && result?.result?.data) {
      setSearchResults(result.result.data);
    } else {
      // Handle error case
      const errorMessage = result?.result?.message || "Failed to search content";
      const errorDetails = result?.result?.error?.details;

      console.error("Error searching:", errorDetails || errorMessage);
      args.showErrorToast(errorMessage);

      setSearchResults({ channels: [], playlists: [], videos: [], totalCount: 0 });
    }
  } catch (error) {
    console.error("Unexpected error searching:", error);
    args.showErrorToast("Failed to search");
    setSearchResults({ channels: [], playlists: [], videos: [], totalCount: 0 });
  } finally {
    setLoading(false);
  }
};

// Load favourites data
const loadFavouritesData = async () => {
  setLoading(true);
  try {
    const result = await args.fns.executeYTOFunction("getUserFavourites", {
      sortBy: favouritesSortBy()
    });

    if (result?.error) {
      console.error("Error loading favourites:", result.error);
      args.showErrorToast(result.error);
      setFavouritesData({ channels: [], playlists: [], videos: [] });
    } else if (result?.result?.success && result?.result?.data) {
      setFavouritesData(result.result.data);
    } else {
      // Handle error case - show the error message from server
      const errorMessage = result?.result?.message || "Failed to load favourites";
      const errorDetails = result?.result?.error?.details;

      console.error("Error loading favourites:", errorDetails || errorMessage);
      args.showErrorToast(errorMessage);

      setFavouritesData({ channels: [], playlists: [], videos: [] });
    }
  } catch (error) {
    console.error("Unexpected error loading favourites:", error);
    args.showErrorToast("Failed to load favourites");
    setFavouritesData({ channels: [], playlists: [], videos: [] });
  } finally {
    setLoading(false);
  }
};

// Load data based on view
const loadData = async () => {
  const currentSearchQuery = args.searchParams?.q;
  const currentDetailId = args.searchParams?.id;

  if (currentSearchQuery !== undefined) {
    await loadSearchData(currentSearchQuery);
  } else if (currentDetailId) {
    await loadDetailData();
  } else if (isFavouritesView()) {
    await loadFavouritesData();
  } else {
    await loadListData();
  }
};

// Reset all scroll positions
const resetScrollPositions = () => {
  // Reset signals immediately
  setScrollTop(0);
  setDetailScrollTop(0);
  setSearchScrollTop(0);
  setFavouritesScrollTop(0);

  // Reset DOM elements after a small delay to ensure they're rendered
  setTimeout(() => {
    const listEl = scrollElement();
    const detailEl = detailScrollElement();
    const searchEl = searchScrollElement();
    const favouritesEl = favouritesScrollElement();
    if (listEl) listEl.scrollTop = 0;
    if (detailEl) detailEl.scrollTop = 0;
    if (searchEl) searchEl.scrollTop = 0;
    if (favouritesEl) favouritesEl.scrollTop = 0;
  }, 0);
};

// Consolidated effect to watch URL params and sort changes
// This prevents duplicate data loads by tracking both in a single effect
args.createEffect(
  args.on(
    () => [
      args.searchParams?.type,
      args.searchParams?.id,
      args.searchParams?.q,
      listSortBy(),
      detailSortBy(),
      searchSortBy(),
      favouritesSortBy()
    ],
    (
      [currentType, currentId, currentQuery, currentListSort, currentDetailSort, currentSearchSort, currentFavouritesSort],
      [prevType, prevId, prevQuery, prevListSort, prevDetailSort, prevSearchSort, prevFavouritesSort] = []
    ) => {
      // Check what changed
      const urlParamsChanged = currentType !== prevType || currentId !== prevId || currentQuery !== prevQuery;
      const listSortChanged = currentListSort !== prevListSort;
      const detailSortChanged = currentDetailSort !== prevDetailSort;
      const searchSortChanged = currentSearchSort !== prevSearchSort;
      const favouritesSortChanged = currentFavouritesSort !== prevFavouritesSort;

      // Reset scroll positions if URL params changed
      if (urlParamsChanged) {
        resetScrollPositions();
      }

      // Load data based on what changed
      // Priority: URL change loads everything, sort changes only reload if view hasn't changed
      if (urlParamsChanged) {
        // URL changed, load appropriate data for new view
        loadData();
      } else {
        // Only sort changed, reload current view
        if (listSortChanged && isListView()) {
          loadListData();
        } else if (detailSortChanged && isDetailView()) {
          loadDetailData();
        } else if (searchSortChanged && isSearchView()) {
          loadSearchData(currentQuery);
        } else if (favouritesSortChanged && isFavouritesView()) {
          loadFavouritesData();
        }
      }
    }
  )
);

// Handle search form submission
const handleSearch = async (e) => {
  if (e) e.preventDefault();
  const query = searchInput().trim();
  if (query) {
    args.navigate(`/content?q=${encodeURIComponent(query)}`);
  }
};

// Filtered items
const filteredItems = args.createMemo(() => {
  const term = searchTerm().toLowerCase();
  if (!term) return items();

  return items().filter(item => {
    const data = contentType === "playlists" ? item.playlist : item.channel;
    const title = data?.P?.title?.toLowerCase() || "";
    const description = data?.P?.description?.toLowerCase() || "";
    return title.includes(term) || description.includes(term);
  });
});

// Navigation actions
const navigateToDetail = (item) => {
  const data = contentType === "playlists" ? item.playlist : item.channel;
  const id = data?.P?.youtubeId || "";
  args.navigate(`/content?type=${contentType}&id=${id}`);
};

const navigateBack = () => {
  args.navigate(`/content?type=${contentType}`);
};

// Menu actions
const openInYouTube = (item) => {
  const data = contentType === "playlists" ? item.playlist : item.channel;
  const youtubeId = data?.P?.youtubeId || "";
  const url = contentType === "playlists"
    ? `https://www.youtube.com/playlist?list=${youtubeId}`
    : `https://www.youtube.com/channel/${youtubeId}`;
  window.open(url, "_blank");
  setActiveMenu(null);
};

const editCustomName = async (item) => {
  setModalData({ editMode: true, itemData: item });
  setIsModalOpen(true);
  setActiveMenu(null);
};

// Alias for YTOCard component - converts item structure to match editCustomName expectations
const openCustomNameModal = (itemData) => {
  // If called with old signature (item, itemType, itemSetting), convert to new format
  if (arguments.length > 1) {
    const [item, itemType, itemSetting] = arguments;
    const typeMap = {
      video: { itemKey: 'video', settingKey: 'videoSetting' },
      playlist: { itemKey: 'playlist', settingKey: 'playlistSetting' },
      channel: { itemKey: 'channel', settingKey: 'channelSetting' }
    };
    const config = typeMap[itemType] || typeMap.channel;
    itemData = { [config.itemKey]: item, [config.settingKey]: itemSetting };
  }

  setModalData({ editMode: true, itemData });
  setIsModalOpen(true);
};

// Unified delete function for channels, playlists, and videos
const deleteItem = async (item) => {
  const rbConfirm = args.contextData?.confirmContext?.rbConfirm;
  if (!rbConfirm) {
    args.showErrorToast("Confirmation dialog not available");
    setActiveMenu(null);
    return;
  }

  // Infer item type and extract data
  const itemInfo = inferItemType(item);
  if (!itemInfo) {
    args.showErrorToast("Cannot determine item type");
    setActiveMenu(null);
    return;
  }

  const { type: itemType, item: data } = itemInfo;
  const title = data?.P?.title || "this item";

  // Build confirmation message with type-specific details
  const deleteMessages = {
    channel: "\n\nThis will also delete:\n• All playlists in this channel\n• All videos that are only in this channel's playlists",
    playlist: "\n\nThis will also delete:\n• All videos that are only in this playlist",
    video: () => {
      const detail = detailData();
      const contextItem = detail?.playlist?.playlist;
      const contextName = contextItem?.P?.title || "current view";
      return `\n\nRemoving from ${contextName}.\n\nNote: This video will only be deleted if it doesn't exist in other playlists or the channel.`;
    }
  };

  let message = `Are you sure you want to delete "${title}"?`;
  const extraMessage = deleteMessages[itemType];
  message += typeof extraMessage === 'function' ? extraMessage() : extraMessage;
  message += "\n\nThis action cannot be undone!";

  const confirmed = await rbConfirm({
    title: `Delete ${itemType}`,
    message,
    confirmText: `Delete ${itemType}`,
    cancelText: "Cancel",
    variant: "danger"
  });

  if (confirmed) {
    try {
      // Call appropriate delete function with unified pattern
      const deleteConfig = {
        channel: {
          functionName: 'deleteChannel',
          params: { items: [data], itemType, contextItems: [] },
          onSuccess: loadData
        },
        playlist: {
          functionName: 'deletePlaylist',
          params: { items: [data], itemType, contextItems: [] },
          onSuccess: loadData
        },
        video: {
          functionName: 'deleteVideo',
          params: () => {
            const detail = detailData();
            const contextItem = detail?.playlist?.playlist;
            if (!contextItem) {
              throw new Error("Playlist information not found");
            }
            return { videos: [data], contextType: 'playlist', contextItems: [contextItem] };
          },
          onSuccess: loadDetailData
        }
      };

      const config = deleteConfig[itemType];
      const params = typeof config.params === 'function' ? config.params() : config.params;

      const result = await args.fns.executeYTOFunction(config.functionName, params);

      if (result?.result?.success) {
        args.showSuccessToast(result.result.message);
        await config.onSuccess();
      } else {
        args.showErrorToast(result?.result?.message || `Failed to delete ${itemType}`);
      }
    } catch (error) {
      console.error(`Error deleting ${itemType}:`, error);
      args.showErrorToast(error.message || `An error occurred while deleting ${itemType}`);
    }
  }
  setActiveMenu(null);
};

// Alias for backward compatibility
const deleteVideo = deleteItem;

// Modal actions
const openModal = () => {
  setModalData({ editMode: false, itemData: null });
  setIsModalOpen(true);
};

const closeModal = () => {
  setIsModalOpen(false);
  setModalData({ editMode: false, itemData: null });
};

const handleModalSave = async (saveData) => {
  closeModal();

  if (saveData?.editMode && saveData?.result) {
    // Edit mode - update local data instead of refetching
    args.fns.updateLocalItemSetting(saveData.result);
  } else {
    // Add mode, reload all data
    await loadData();
  }
};

// Note modal functions
const openNoteModal = (item, existingNote = "") => {
  setNoteModalData({ item, existingNote });
  setIsNoteModalOpen(true);
};

const closeNoteModal = () => {
  setIsNoteModalOpen(false);
  setNoteModalData({ item: null, existingNote: "" });
};

const saveNote = async (data) => {
  try {
    const result = await args.fns.executeYTOFunction("saveNote", data);

    if (result?.result?.success) {
      args.showSuccessToast(result.result.message);

      // Update item data locally
      updateItemDataAfterNoteSave(result.result.data);

      return result.result;
    } else {
      const errorMessage = result?.result?.message || "Failed to save note";
      args.showErrorToast(errorMessage);
      const error = new Error(errorMessage);
      error.toastShown = true;
      throw error;
    }
  } catch (error) {
    // Only show toast for unexpected errors (network, etc.)
    if (!error.toastShown) {
      console.error("Unexpected error saving note:", error);
      args.showErrorToast("Failed to save note");
    }
    throw error;
  }
};

// Toggle favourite function
const toggleFavourite = async (item) => {
  try {
    const result = await args.fns.executeYTOFunction("toggleFavourite", { item });

    if (result?.result?.success) {
      args.showSuccessToast(result.result.message);

      // Update item data locally
      updateItemDataAfterToggleFavourite(result.result.data);

      return result.result;
    } else {
      const errorMessage = result?.result?.message || "Failed to toggle favourite";
      args.showErrorToast(errorMessage);
      const error = new Error(errorMessage);
      error.toastShown = true;
      throw error;
    }
  } catch (error) {
    // Only show toast for unexpected errors (network, etc.)
    if (!error.toastShown) {
      console.error("Unexpected error toggling favourite:", error);
      args.showErrorToast("Failed to toggle favourite");
    }
    throw error;
  }
};

// Unified helper: Infer item type from data structure
const inferItemType = (data) => {
  if (data.channel && data.channelSetting) {
    return { type: 'channel', item: data.channel, setting: data.channelSetting };
  }
  if (data.playlist && data.playlistSetting) {
    return { type: 'playlist', item: data.playlist, setting: data.playlistSetting };
  }
  if (data.video && data.videoSetting) {
    return { type: 'video', item: data.video, setting: data.videoSetting };
  }
  return null;
};

// Unified helper: Update item in array by ID
const updateItemInArrayById = (items, itemId, itemKey, settingKey, newSetting) => {
  return items.map(existingItem => {
    if (existingItem[itemKey]?.P?.youtubeId === itemId) {
      return { ...existingItem, [settingKey]: newSetting };
    }
    return existingItem;
  });
};

// Unified helper: Update all views with new item data
const updateAllViews = (itemInfo) => {
  if (!itemInfo) return;

  const { type, item, setting } = itemInfo;
  const itemId = item.P?.youtubeId;
  if (!itemId) return;

  // Map of type to field names
  const typeMap = {
    channel: { itemKey: 'channel', settingKey: 'channelSetting', arrayKey: 'channels' },
    playlist: { itemKey: 'playlist', settingKey: 'playlistSetting', arrayKey: 'playlists' },
    video: { itemKey: 'video', settingKey: 'videoSetting', arrayKey: 'videos' }
  };

  const { itemKey, settingKey, arrayKey } = typeMap[type];

  // Update list view
  if (isListView() && contentType === arrayKey) {
    setItems(updateItemInArrayById(items(), itemId, itemKey, settingKey, setting));
  }

  // Update detail view
  if (isDetailView()) {
    const detail = detailData();
    if (!detail) return;

    // Update arrays in detail view
    if (detail[arrayKey]) {
      const updated = updateItemInArrayById(detail[arrayKey], itemId, itemKey, settingKey, setting);
      setDetailData({ ...detail, [arrayKey]: updated });
    }

    // Update single item in detail view (channel/playlist object)
    if (detail[type]?.[itemKey]?.P?.youtubeId === itemId) {
      setDetailData({ ...detail, [type]: { ...detail[type], [settingKey]: setting } });
    }
  }

  // Update search results
  if (isSearchView()) {
    const results = searchResults();
    if (results?.[arrayKey]) {
      const updated = updateItemInArrayById(results[arrayKey], itemId, itemKey, settingKey, setting);
      setSearchResults({ ...results, [arrayKey]: updated });
    }
  }

  // Update favourites
  if (isFavouritesView()) {
    const favourites = favouritesData();
    if (favourites?.[arrayKey]) {
      const updated = updateItemInArrayById(favourites[arrayKey], itemId, itemKey, settingKey, setting);
      setFavouritesData({ ...favourites, [arrayKey]: updated });
    }
  }
};

// Update item data after toggle favourite
const updateItemDataAfterToggleFavourite = (updatedData) => {
  const itemInfo = inferItemType(updatedData);
  updateAllViews(itemInfo);
};

// Update item data after note is saved
const updateItemDataAfterNoteSave = (updatedData) => {
  const itemInfo = inferItemType(updatedData);
  updateAllViews(itemInfo);
};

// Sync current channel or playlist
const [isSyncing, setIsSyncing] = args.createSignal(false);

const syncCurrentItem = async () => {
  const contentType = args.searchParams?.type || "channels";
  const data = detailData();

  if (!data) {
    args.showErrorToast("No item to sync");
    return;
  }

  setIsSyncing(true);

  try {
    if (contentType === "playlists") {
      const playlist = data.playlist?.playlist;
      if (!playlist) {
        args.showErrorToast("Playlist not found");
        setIsSyncing(false);
        return;
      }

      const url = `https://www.youtube.com/playlist?list=${playlist.P.youtubeId}`;

      const result = await args.fns.executeYTOFunction("savePlaylist", { url });

      if (result?.result?.success) {
        args.showSuccessToast(result.result.message || "Playlist synced successfully");
        await loadDetailData();
      } else {
        args.showErrorToast(result?.result?.message || "Failed to sync playlist");
      }
    } else {
      const channel = data.channel?.channel;
      if (!channel) {
        args.showErrorToast("Channel not found");
        setIsSyncing(false);
        return;
      }

      const url = `https://www.youtube.com/channel/${channel.P.youtubeId}`;

      const result = await args.fns.executeYTOFunction("saveChannel", { url });

      if (result?.result?.success) {
        args.showSuccessToast(result.result.message || "Channel synced successfully");
        await loadDetailData();
      } else {
        args.showErrorToast(result?.result?.message || "Failed to sync channel");
      }
    }
  } catch (error) {
    console.error("Error syncing:", error);
    args.showErrorToast("An error occurred while syncing");
  } finally {
    setIsSyncing(false);
  }
};

// Add videos to playlist modal
const [isAddVideosModalOpen, setIsAddVideosModalOpen] = args.createSignal(false);

// Update local item setting across all views
const updateLocalItemSetting = (updatedData) => {
  const itemInfo = inferItemType(updatedData);
  updateAllViews(itemInfo);
};

// Polling state for all items (to track processing status and other metadata)
const [processingStatuses, setProcessingStatuses] = args.createSignal({
  channels: {},
  playlists: {}
});
const [pollingInterval, setPollingInterval] = args.createSignal(null);
const [isPolling, setIsPolling] = args.createSignal(false);

// Helper function to collect visible IDs from channel/playlist arrays (all items)
const collectVisibleIds = (channelsArray, playlistsArray, channelIds, playlistIds) => {
  // Collect all channel IDs
  if (channelsArray) {
    channelsArray.forEach(item => {
      const channelId = item.channel?.P?.youtubeId;
      if (channelId && !channelIds.includes(channelId)) {
        channelIds.push(channelId);
      }
    });
  }

  // Collect all playlist IDs
  if (playlistsArray) {
    playlistsArray.forEach(item => {
      const playlistId = item.playlist?.P?.youtubeId;
      if (playlistId && !playlistIds.includes(playlistId)) {
        playlistIds.push(playlistId);
      }
    });
  }
};

// Helper function to extract all items from arrays
const extractProcessingItems = (channelsArray, playlistsArray, channelsMap, playlistsMap) => {
  // Extract all channels
  if (channelsArray) {
    channelsArray.forEach(item => {
      const channelId = item.channel?.P?.youtubeId;
      if (channelId) {
        channelsMap[channelId] = item;
      }
    });
  }

  // Extract all playlists
  if (playlistsArray) {
    playlistsArray.forEach(item => {
      const playlistId = item.playlist?.P?.youtubeId;
      if (playlistId) {
        playlistsMap[playlistId] = item;
      }
    });
  }
};

// Reactive effect to automatically update all visible items when data changes
args.createEffect(
  args.on(
    [items, detailData, searchResults, favouritesData, isListView, isDetailView, isSearchView, isFavouritesView],
    () => {
      const channelsMap = {};
      const playlistsMap = {};

      // Watch list view items
      if (isListView() && !isSearchView() && !isFavouritesView()) {
        const currentItems = items();

        if (contentType === "channels") {
          extractProcessingItems(currentItems, null, channelsMap, playlistsMap);
        } else if (contentType === "playlists") {
          extractProcessingItems(null, currentItems, channelsMap, playlistsMap);
        }
      }

      // Watch detail view
      if (isDetailView()) {
        const detail = detailData();
        if (detail) {
          if (contentType === "channels") {
            // Include channel itself
            const channelId = detail.channel?.channel?.P?.youtubeId;
            if (channelId) {
              channelsMap[channelId] = detail.channel;
            }

            // Include playlists in channel
            extractProcessingItems(null, detail.playlists, channelsMap, playlistsMap);
          } else if (contentType === "playlists") {
            // Include playlist itself
            const playlistId = detail.playlist?.playlist?.P?.youtubeId;
            if (playlistId) {
              playlistsMap[playlistId] = detail.playlist;
            }
          }
        }
      }

      // Watch search results
      if (isSearchView()) {
        const results = searchResults();
        if (results) {
          extractProcessingItems(results.channels, results.playlists, channelsMap, playlistsMap);
        }
      }

      // Watch favourites
      if (isFavouritesView()) {
        const favourites = favouritesData();
        if (favourites) {
          extractProcessingItems(favourites.channels, favourites.playlists, channelsMap, playlistsMap);
        }
      }

      // Automatically update all visible items whenever data changes
      setProcessingStatuses({
        channels: channelsMap,
        playlists: playlistsMap
      });
    }
  )
);

// Collect visible IDs from current view for polling
const collectVisibleIdsFromData = () => {
  const channelIds = [];
  const playlistIds = [];

  // Collect from list view items
  if (isListView() && !isSearchView() && !isFavouritesView()) {
    const currentItems = items();

    if (contentType === "channels") {
      collectVisibleIds(currentItems, null, channelIds, playlistIds);
    } else if (contentType === "playlists") {
      collectVisibleIds(null, currentItems, channelIds, playlistIds);
    }
  }

  // Collect from detail view
  if (isDetailView()) {
    const detail = detailData();
    if (detail) {
      if (contentType === "channels") {
        // Collect channel ID itself
        const channelId = detail.channel?.channel?.P?.youtubeId;
        if (channelId && !channelIds.includes(channelId)) {
          channelIds.push(channelId);
        }

        // Collect playlists in channel
        collectVisibleIds(null, detail.playlists, channelIds, playlistIds);
      } else if (contentType === "playlists") {
        // Collect playlist ID itself
        const playlistId = detail.playlist?.playlist?.P?.youtubeId;
        if (playlistId && !playlistIds.includes(playlistId)) {
          playlistIds.push(playlistId);
        }
      }
    }
  }

  // Collect from search results
  if (isSearchView()) {
    const results = searchResults();
    if (results) {
      collectVisibleIds(results.channels, results.playlists, channelIds, playlistIds);
    }
  }

  // Collect from favourites
  if (isFavouritesView()) {
    const favourites = favouritesData();
    if (favourites) {
      collectVisibleIds(favourites.channels, favourites.playlists, channelIds, playlistIds);
    }
  }

  return { channelIds, playlistIds };
};

// Poll for processing status updates
const pollProcessingStatus = async () => {
  // Skip if already polling
  if (isPolling()) {
    return;
  }

  // Collect visible IDs from current view
  const { channelIds, playlistIds } = collectVisibleIdsFromData();

  // If no IDs to poll, skip
  if (channelIds.length === 0 && playlistIds.length === 0) {
    return;
  }

  setIsPolling(true);
  try {
    const result = await args.fns.executeYTOFunction("getProcessingStatusByIds", {
      channelIds,
      playlistIds
    });

    if (result?.result?.success && result?.result?.data) {
      const data = result.result.data;

      // Convert arrays to objects keyed by ID for easier lookup
      const channelsMap = {};
      data.channels.forEach(item => {
        const channelId = item.channel?.P?.youtubeId;
        if (channelId) {
          channelsMap[channelId] = item;
        }
      });

      const playlistsMap = {};
      data.playlists.forEach(item => {
        const playlistId = item.playlist?.P?.youtubeId;
        if (playlistId) {
          playlistsMap[playlistId] = item;
        }
      });

      setProcessingStatuses({
        channels: channelsMap,
        playlists: playlistsMap
      });

      // If no active processing, stop polling and reload data
      if (!data.hasActiveProcessing) {
        stopPolling();
        // Reload data to show completed items in all views
        await loadData();
      }
    }
  } catch (error) {
    console.error('Error polling processing status:', error);
  } finally {
    setIsPolling(false);
  }
};

// Start polling
const startPolling = () => {
  // Don't start if already polling
  if (pollingInterval()) {
    return;
  }

  // Start polling immediately
  pollProcessingStatus();

  // Set up interval (poll every 3 seconds)
  const interval = setInterval(pollProcessingStatus, 3000);
  setPollingInterval(interval);
};

// Stop polling
const stopPolling = () => {
  const interval = pollingInterval();
  if (interval) {
    clearInterval(interval);
    setPollingInterval(null);
  }
  setIsPolling(false);
};

// Watch for processing status changes and start/stop polling as needed
args.createEffect(
  args.on([processingStatuses, pollingInterval], () => {
    const statuses = processingStatuses();

    // Check if any items are actually being processed (queued or processing status)
    let hasActiveProcessing = false;

    // Check channels
    for (const channelId in statuses.channels) {
      const item = statuses.channels[channelId];
      const status = item.channelSetting?.P?.status;
      if (status === 'queued' || status === 'processing') {
        hasActiveProcessing = true;
        break;
      }
    }

    // Check playlists if no active channel processing found
    if (!hasActiveProcessing) {
      for (const playlistId in statuses.playlists) {
        const item = statuses.playlists[playlistId];
        const status = item.playlistSetting?.P?.status;
        if (status === 'queued' || status === 'processing') {
          hasActiveProcessing = true;
          break;
        }
      }
    }

    // Start polling if there's active processing
    if (hasActiveProcessing && !pollingInterval()) {
      args.untrack(() => startPolling());
    }
    // Stop polling if there's no active processing
    else if (!hasActiveProcessing && pollingInterval()) {
      args.untrack(() => stopPolling());
    }
  })
);

// Cleanup on unmount
args.onCleanup(() => {
    args.untrack(() => stopPolling());
});

// Get processing status for a specific channel
const getChannelProcessingStatus = (channelId) => {
  return processingStatuses().channels[channelId] || null;
};

// Get processing status for a specific playlist
const getPlaylistProcessingStatus = (playlistId) => {
  return processingStatuses().playlists[playlistId] || null;
};

// Format processing status with detailed information
const formatProcessingStatus = (processingStatus, itemType) => {
  if (!processingStatus) {
    return null;
  }

  // Try to extract setting from different possible structures
  let setting = null;
  if (itemType === "playlist") {
    setting = processingStatus.playlistSetting;
  } else if (itemType === "channel") {
    setting = processingStatus.channelSetting;
  }

  // If no setting found, return null
  if (!setting) {
    return null;
  }

  const props = setting.P;

  // Check if we have a valid status
  const status = props.status;
  if (!status) {
    return null;
  }

  // Only format if status is queued or processing
  if (status !== 'queued' && status !== 'processing') {
    return null;
  }

  // Extract progress
  const progress = props.progress || 0;

  // Build details string based on item type
  let details = '';
  if (itemType === "channel") {
    const processedPlaylists = props.processedPlaylists || 0;
    const totalPlaylists = props.totalPlaylists || 0;
    const processedVideos = props.processedVideos || 0;
    const totalVideos = props.totalVideos || 0;
    details = `${processedPlaylists}/${totalPlaylists} playlists, ${processedVideos}/${totalVideos} videos`;
  } else if (itemType === "playlist") {
    const processedVideos = props.processedVideos || 0;
    const totalVideos = props.totalVideos || 0;
    details = `${processedVideos}/${totalVideos} videos`;
  }

  // Return formatted status
  return {
    ...processingStatus,
    status,
    progress,
    details
  };
};

return {
  items,
  filteredItems,
  loading,
  updateItemDataAfterNoteSave,
  isNoteModalOpen,
  noteModalData,
  openNoteModal,
  closeNoteModal,
  saveNote,
  toggleFavourite,
  searchTerm,
  setSearchTerm,
  setScrollElement,
  handleScroll,
  getVirtualItems,
  getTotalSize,
  activeMenu,
  setActiveMenu,
  menuPosition,
  setMenuPosition,
  navigateToDetail,
  navigateBack,
  openInYouTube,
  editCustomName,
  openCustomNameModal,
  deleteItem,
  deleteVideo,
  isModalOpen,
  modalData,
  setModalData,
  setIsModalOpen,
  openModal,
  closeModal,
  handleModalSave,
  updateLocalItemSetting,
  isDetailView,
  isSearchView,
  isFavouritesView,
  isListView,
  detailData,
  filteredDetailItems,
  detailSearchTerm,
  setDetailSearchTerm,
  getDetailVirtualItems,
  getDetailTotalSize,
  setDetailScrollElement,
  handleDetailScroll,
  searchResults,
  searchInput,
  setSearchInput,
  getSearchItems,
  getSearchVirtualItems,
  getSearchTotalSize,
  setSearchScrollElement,
  handleSearchScroll,
  favouritesData,
  getFavouritesItems,
  getFavouritesVirtualItems,
  getFavouritesTotalSize,
  setFavouritesScrollElement,
  handleFavouritesScroll,
  handleSearch,
  loadData,
  loadListData,
  loadDetailData,
  loadSearchData,
  loadFavouritesData,
  handleResize,
  syncCurrentItem,
  isSyncing,
  isAddVideosModalOpen,
  setIsAddVideosModalOpen,
  processingStatuses,
  getChannelProcessingStatus,
  getPlaylistProcessingStatus,
  formatProcessingStatus,
  getCurrentSortOptions,
  getCurrentSortValue,
  setCurrentSortValue,
  getCurrentSortField,
  getCurrentSortDirection,
  handleSortFieldChange,
  handleSortDirectionToggle,
  listSortBy,
  detailSortBy,
  searchSortBy,
  favouritesSortBy,
  listSortField,
  listSortDirection,
  setListSortField,
  setListSortDirection,
  detailSortField,
  detailSortDirection,
  setDetailSortField,
  setDetailSortDirection,
  searchSortField,
  searchSortDirection,
  setSearchSortField,
  setSearchSortDirection,
  favouritesSortField,
  favouritesSortDirection,
  setFavouritesSortField,
  setFavouritesSortDirection,
  loadUserSetting,
  initializeSortFromURL,
  updateURLSort,
  clearURLSort,
  splitSortValue
};
''',
        props: '''
return {
  as: "div",
  onMount: () => {
    // Initialize sort from URL (highest priority)
    const hasURLSort = args.fns.initializeSortFromURL();

    // Load user setting (will be overridden by URL if present)
    args.fns.loadUserSetting();

    // Initialize window width and add resize listener
    args.fns.handleResize();
    window.addEventListener('resize', args.fns.handleResize);
  },
  onCleanup: () => {
    window.removeEventListener('resize', args.fns.handleResize);
  }
};
''',
