    {
      id: "processing_status",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "YTOProcessingStatus",
        props: '''
const contentType = args.searchParams?.type || "channels";
const data = args.fns.detailData();

if (!args.fns.isDetailView() || !data) {
  return { hide: true };
}

const itemId = contentType === "playlists"
  ? data.playlist?.playlist?.P?.youtubeId
  : data.channel?.channel?.P?.youtubeId;

const processingData = contentType === "playlists"
  ? args.fns.getPlaylistProcessingStatus(itemId)
  : args.fns.getChannelProcessingStatus(itemId);

if (!processingData) {
  return { hide: true };
}

// Extract data from vertex format
const setting = contentType === "playlists"
  ? processingData.playlistSetting
  : processingData.channelSetting;

if (!setting || !setting.P) {
  return { hide: true };
}

let details = '';
if (contentType === "channels") {
  const processedPlaylists = setting.P.processedPlaylists || 0;
  const totalPlaylists = setting.P.totalPlaylists || 0;
  const processedVideos = setting.P.processedVideos || 0;
  const totalVideos = setting.P.totalVideos || 0;
  details = `${processedPlaylists}/${totalPlaylists} playlists, ${processedVideos}/${totalVideos} videos`;
} else {
  const processedVideos = setting.P.processedVideos || 0;
  const totalVideos = setting.P.totalVideos || 0;
  details = `${processedVideos}/${totalVideos} videos`;
}

return {
  status: setting.P.status,
  progress: setting.P.progress || 0,
  type: contentType === "playlists" ? "playlist" : "channel",
  details,
  error: setting.P.error || ''
};
'''
