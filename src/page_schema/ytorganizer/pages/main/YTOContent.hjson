        componentName: "Html",
        props: '''
const isListView = args.fns.isListView();
const isDetailView = args.fns.isDetailView();
const isSearchView = args.fns.isSearchView();
const isFavouritesView = args.fns.isFavouritesView();
const contentType = args.searchParams?.type || "channels";
const hasSearchTerm = args.fns.searchTerm().length > 0;
const query = args.searchParams?.q || "";

let text;
if (isListView) {
  text = hasSearchTerm
    ? "Try adjusting your search terms"
    : (contentType === "playlists"
        ? "Start by adding some YouTube playlists to organize your content"
        : "Start by adding some YouTube channels to track your favorites");
} else if (isDetailView) {
  text = ""; // Detail view doesn't show description (only has 2 children)
} else if (isSearchView) {
  text = query ? "Try adjusting your search terms" : "to find channels, playlists, and videos";
} else if (isFavouritesView) {
  text = "Start by adding channels, playlists, or videos to your favourites!";
}

return {
  as: "p",
  text,
  hide: isDetailView // Hide in detail view
};
''',
        css: '''
return `._id {
  color: ${args.theme.var.color.muted};
  margin: 0;
}`;
'''
      }
    },
    {
      id: "content_wrapper",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
const isListView = args.fns.isListView();
const isDetailView = args.fns.isDetailView();
const isSearchView = args.fns.isSearchView();
const isFavouritesView = args.fns.isFavouritesView();

let hasItems = false;
if (isListView) {
  hasItems = args.fns.filteredItems().length > 0;
} else if (isDetailView) {
  hasItems = args.fns.filteredDetailItems().length > 0;
} else if (isSearchView) {
  hasItems = args.fns.getSearchItems().length > 0;
} else if (isFavouritesView) {
  hasItems = args.fns.getFavouritesItems().length > 0;
}

return {
  as: "div",
  hide: args.fns.loading() || !hasItems
};
''',
        css: '''
return `._id {
  position: relative;
}`;
'''
      }
    },
    {
      id: "virtual_list",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const isListView = args.fns.isListView();
const isDetailView = args.fns.isDetailView();
const isSearchView = args.fns.isSearchView();
const isFavouritesView = args.fns.isFavouritesView();

let totalSize;
if (isListView) {
  totalSize = args.fns.getTotalSize();
} else if (isDetailView) {
  totalSize = args.fns.getDetailTotalSize();
} else if (isSearchView) {
  totalSize = args.fns.getSearchTotalSize();
} else if (isFavouritesView) {
  totalSize = args.fns.getFavouritesTotalSize();
}

return {
  as: "div",
  style: {
    height: `${totalSize}px`,
    width: "100%",
    position: "relative"
  }
};
'''
      }
    },
    {
      id: "virtual_items",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const isListView = args.fns.isListView();
const isDetailView = args.fns.isDetailView();
const isSearchView = args.fns.isSearchView();
const isFavouritesView = args.fns.isFavouritesView();

let virtualItems;
let contextName;

if (isListView) {
  virtualItems = args.fns.getVirtualItems();
  contextName = "virtualItem";
} else if (isDetailView) {
  virtualItems = args.fns.getDetailVirtualItems();
  contextName = "videoItem";
} else if (isSearchView) {
  virtualItems = args.fns.getSearchVirtualItems();
  contextName = "searchItem";
} else if (isFavouritesView) {
  virtualItems = args.fns.getFavouritesVirtualItems();
  contextName = "favouriteItem";
}

return {
  data: virtualItems,
  loop: true,
  contextName
};
''',
        css: '''
return `._id {
  display: contents;
}`;
'''
      }
    },
    {
      id: "card_wrapper",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const isListView = args.fns.isListView();
const isDetailView = args.fns.isDetailView();
const isSearchView = args.fns.isSearchView();
const isFavouritesView = args.fns.isFavouritesView();

// Get the appropriate item based on view
let item;
if (isListView) {
  item = args.contextData.virtualItem;
} else if (isDetailView) {
  item = args.contextData.videoItem;
} else if (isSearchView) {
  item = args.contextData.searchItem;
} else if (isFavouritesView) {
  item = args.contextData.favouriteItem;
}

return {
  as: "div",
  style: {
    position: "absolute",
    top: 0,
    left: 0,
    width: "100%",
    height: `${item.size}px`,
    transform: `translateY(${item.start}px)`
  }
};
'''
      }
    },
    {
      id: "card",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "YTOCard",
        props: '''
const isListView = args.fns.isListView();
const isDetailView = args.fns.isDetailView();
const isSearchView = args.fns.isSearchView();
const isFavouritesView = args.fns.isFavouritesView();
const contentType = args.searchParams?.type || "channels";

let item, itemData, itemSetting, itemType, processingStatus, showTypeBadge, itemId;

if (isListView) {
  const virtualItem = args.contextData.virtualItem;
  itemData = args.fns.filteredItems()[virtualItem.index];
  item = contentType === "playlists" ? itemData.playlist : itemData.channel;
  itemId = item?.P?.youtubeId;
  processingStatus = contentType === "playlists"
    ? args.fns.getPlaylistProcessingStatus(itemId)
    : args.fns.getChannelProcessingStatus(itemId);
  itemSetting = contentType === "playlists" ? itemData.playlistSetting : itemData.channelSetting;
  itemType = contentType === "playlists" ? "playlist" : "channel";
  showTypeBadge = false;
} else if (isDetailView) {
  const videoItem = args.contextData.videoItem;
  itemData = args.fns.filteredDetailItems()[videoItem.index];
  const isPlaylistItem = contentType === "channels";
  item = isPlaylistItem ? itemData.playlist : itemData.video;
  itemId = item?.P?.youtubeId;
  processingStatus = isPlaylistItem ? args.fns.getPlaylistProcessingStatus(itemId) : null;
  itemSetting = isPlaylistItem ? itemData.playlistSetting : itemData.videoSetting;
  itemType = isPlaylistItem ? "playlist" : "video";
  showTypeBadge = false;
} else if (isSearchView) {
  const searchItem = args.contextData.searchItem;
  itemData = args.fns.getSearchItems()[searchItem.index];
  const resultType = itemData.resultType;
  item = resultType === "channel" ? itemData.channel : (resultType === "playlist" ? itemData.playlist : itemData.video);
  itemId = item?.P?.youtubeId;
  processingStatus = resultType === "channel"
    ? args.fns.getChannelProcessingStatus(itemId)
    : resultType === "playlist"
    ? args.fns.getPlaylistProcessingStatus(itemId)
    : null;
  itemSetting = resultType === "channel" ? itemData.channelSetting : (resultType === "playlist" ? itemData.playlistSetting : itemData.videoSetting);
  itemType = resultType;
  showTypeBadge = true;
} else if (isFavouritesView) {
  const favouriteItem = args.contextData.favouriteItem;
  itemData = args.fns.getFavouritesItems()[favouriteItem.index];
  const resultType = itemData.resultType;
  item = resultType === "channel" ? itemData.channel : (resultType === "playlist" ? itemData.playlist : itemData.video);
  itemId = item?.P?.youtubeId;
  processingStatus = resultType === "channel"
    ? args.fns.getChannelProcessingStatus(itemId)
    : resultType === "playlist"
    ? args.fns.getPlaylistProcessingStatus(itemId)
    : null;
  itemSetting = resultType === "channel" ? itemData.channelSetting : (resultType === "playlist" ? itemData.playlistSetting : itemData.videoSetting);
  itemType = resultType;
  showTypeBadge = true;
}

// Format processing status with detailed information
processingStatus = args.fns.formatProcessingStatus(processingStatus, itemType);

return {
  item,
  itemData,
  itemSetting,
  itemType,
  showTypeBadge,
  processingStatus
};
'''
      }
    },
    {
      id: "add_modal",
      L: "Attr",
      P: {
        displayOrder: 9,
        componentName: "YTOAddModal",
        props: '''
const contentType = args.searchParams?.type || "channels";
const modalData = args.fns.modalData;
const isOpen = args.fns.isModalOpen();

return {
  isOpen: isOpen,
  contentType: modalData.contentType || contentType,
  editMode: modalData.editMode,
  itemData: modalData.itemData,
  channelId: modalData.channelId,
  onClose: args.fns.closeModal,
  onSave: args.fns.handleModalSave
};
'''
      }
    },
    {
      id: "note_modal",
      L: "Attr",
      P: {
        displayOrder: 10,
        componentName: "YTONoteModal",
        props: '''
return {
  isOpen: args.fns.isNoteModalOpen,
  onClose: args.fns.closeNoteModal,
  item: args.fns.noteModalData.item,
  existingNote: args.fns.noteModalData.existingNote,
  onSave: args.fns.saveNote
};
'''
      }
    },
    {
      id: "add_videos_modal",
      L: "Attr",
      P: {
        displayOrder: 11,
        componentName: "YTOAddVideosModal",
        props: '''
const data = args.fns.detailData();
const playlist = data?.playlist?.playlist;

return {
  isOpen: args.fns.isAddVideosModalOpen,
  onClose: () => args.fns.setIsAddVideosModalOpen(false),
  playlist: playlist,
  onSuccess: args.fns.loadDetailData
};
'''
      }
    },
    {
      id: "sort_split_button",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "YTOSplitButton",
        props: '''
// Get sort field, direction, and options from fns
const currentField = args.fns.getCurrentSortField();
const currentDirection = args.fns.getCurrentSortDirection();
const options = args.fns.getCurrentSortOptions();

return {
  field: currentField,
  direction: currentDirection,
  options: options,
  onFieldChange: (newField) => {
    args.fns.handleSortFieldChange(newField);
  },
  onDirectionToggle: () => {
    args.fns.handleSortDirectionToggle();
  }
};
''',
        css: '''
return `._id {
  width: auto;
  min-width: 250px;
}

@media (max-width: 768px) {
  ._id {
    width: 100%;
  }
}`;
'''
      }
    }
