{
  vertexes: [
    {
      id: "1"
      L: "Page"
      P: {
        key: "YTOOnboarding"
        url: "/yto/onboarding"
        signinRequired: true,
        fns: '''
return {
  enabled: true
};
''',
        props: '''
return {
  isNoPermissionCheck: true
};
'''
      }
    }
    {
      id: "2"
      L: "PageLayout"
      P: {
        componentName: "YTOLayout",
        displayOrder: 1
      }
    }
    // Main container
    {
      id: "3"
      L: "Attr"
      P: {
        displayOrder: 1
        componentName: "Html"
        fns: '''
const [loading, setLoading] = args.createSignal(false);

const completeOnboarding = async () => {
  setLoading(true);
  try {
    const response = await args.executeNamedServerFunction({
      functionName: "checkOnboardingStatus",
      contextData: { markComplete: true }
    });

    const result = response.result;

    if (result.success) {
      args.showSuccessToast("Welcome to YouTube Organizer!");
      // Navigate to home after a short delay
      setTimeout(() => {
        args.navigate('/yto');
      }, 500);
    } else {
      args.showErrorToast("Failed to complete onboarding");
    }
  } catch (error) {
    args.showErrorToast("An error occurred");
    console.error(error);
  } finally {
    setLoading(false);
  }
};

return {
  loading,
  completeOnboarding
};
'''
        props: '''
return {
  as: "div"
};
'''
        css: '''
return `._id {
  max-width: 800px;
  margin: 0 auto;
  padding: 1rem;
  padding-bottom: 6rem;

  @media (max-width: 768px) {
    padding: 0.75rem;
    padding-bottom: 5rem;
  }
}`;
'''
      }
    }
