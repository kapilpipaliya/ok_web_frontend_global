        props: '''
const features = [
  {
    id: "channels",
    icon: "carbon:application",
    iconColor: "primary",
    title: "Manage Channels",
    description: "Add your favorite YouTube channels and keep track of all their content in one organized place.",
    href: "/yto/content?type=channels"
  },
  {
    id: "playlists",
    icon: "carbon:playlist",
    iconColor: "success",
    title: "Organize Playlists",
    description: "Create custom playlists and organize videos exactly how you want them.",
    href: "/yto/content?type=playlists"
  },
  {
    id: "mobile",
    icon: "carbon:mobile",
    iconColor: "info",
    title: "Mobile-First Design",
    description: "Optimized for mobile devices with touch-friendly interfaces and screen reader support.",
    href: null
  }
];

return {
  as: "div",
  data: features
};
'''
        css: '''
return `._id {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1rem;

  @media (max-width: 768px) {
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
}`;
'''
