{
  vertexes: [
    {
      id: "delete_account_function",
      L: "Function",
      P: {
        key: "deleteAccount",
        description: "Deletes user account by first clearing all user data and then deleting the user",
        body: '''
try {
  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Step 1: Clear all user data first
  const clearDataResult = await args.executeNamedServerFunction({
    functionName: "clearAllUserData",
    contextData: {}
  });

  if (!clearDataResult?.result?.success) {
    throw new Error(clearDataResult?.result?.message || "Failed to clear user data");
  }

  // Step 2: Delete the user account
  const deleteUserQuery = `
    MATCH (u:User {uuid: $userUuid})
    DETACH DELETE u
  `;

  await args.session.run(deleteUserQuery, {
    userUuid: user.P.uuid
  });

  return {
    success: true,
    message: "Your account has been permanently deleted.",
    data: {
      userId: user.id,
      userUuid: user.P.uuid
    }
  };

} catch (error) {
  console.error("Error deleting account:", error);

  // Handle specific error types
  let userMessage = "Failed to delete account. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to delete your account.";
  } else if (error.message.includes("Failed to clear user data")) {
    userMessage = "Failed to clear your data. Please contact support.";
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    }
  };
}
'''
      }
    }
  ],
  edges: []
}
