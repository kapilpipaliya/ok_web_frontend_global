// Helper function to process a single setting
async function processSetting(setting) {
  const { key, contentType, icon, name, config } = setting;

  console.log(`\n${icon} Processing ${name} settings...`);

  // Check if setting exists
  const checkResult = await args.session.run(
    `MATCH (s:Setting {key: $key}) RETURN s`,
    { key }
  );

  const exists = checkResult.records.length > 0;

  if (!dryRun) {
    if (exists) {
      // Update existing
      await args.session.run(
        `MATCH (s:Setting {key: $key})
         SET s.config = $config,
             s.type = 'table_config',
             s.contentType = $contentType,
             s.updatedAt = datetime()
         RETURN s`,
        { key, config, contentType }
      );
      console.log(`✅ Updated existing ${name} settings`);
      return { created: 0, updated: 1 };
    } else {
      // Create new
      await args.session.run(
        `CREATE (s:Setting {
          key: $key,
          type: 'table_config',
          contentType: $contentType,
          config: $config,
          createdAt: datetime(),
          updatedAt: datetime()
        })
        RETURN s`,
        { key, config, contentType }
      );
      console.log(`✅ Created new ${name} settings`);
      return { created: 1, updated: 0 };
    }
  } else {
    // Dry run - just report
    if (exists) {
      console.log(`📋 Would update existing ${name} settings`);
      return { created: 0, updated: 1 };
    } else {
      console.log(`📋 Would create new ${name} settings`);
      return { created: 1, updated: 0 };
    }
  }
}

// Process all settings
const stats = {
  bookSettingsCreated: 0,
  bookSettingsUpdated: 0,
  audioVideoSettingsCreated: 0,
  audioVideoSettingsUpdated: 0
};

for (let i = 0; i < settingsConfigs.length; i++) {
  const setting = settingsConfigs[i];
  const result = await processSetting(setting);

  // Update stats based on setting type
  if (setting.contentType === 'book') {
    stats.bookSettingsCreated += result.created;
    stats.bookSettingsUpdated += result.updated;
  } else if (setting.contentType === 'audioVideo') {
    stats.audioVideoSettingsCreated += result.created;
    stats.audioVideoSettingsUpdated += result.updated;
  }
}

// ==========================================
// Summary
// ==========================================
console.log('\n📊 Migration Summary:');
console.log('==========================================');
console.log(`Book settings - Created: ${stats.bookSettingsCreated}, Updated: ${stats.bookSettingsUpdated}`);
console.log(`AudioVideo settings - Created: ${stats.audioVideoSettingsCreated}, Updated: ${stats.audioVideoSettingsUpdated}`);
console.log('==========================================');

return {
  success: true,
  message: dryRun
    ? "Dry run completed - no changes made"
    : "Content table settings migration completed successfully",
  data: {
    ...stats,
    dryRun
  }
};
'''
