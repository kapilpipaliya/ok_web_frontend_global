{
  vertexes: [
    {
      id: "update_playlist_settings_function",
      L: "Function",
      P: {
        key: "updatePlaylistSettings",
        description: "Updates playlist settings like custom name",
        body: '''
try {
  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  const { youtubeId, customName } = args.contextData;

  if (!youtubeId) {
    throw new Error("Playlist ID is required");
  }

  // Update PlaylistSetting and get video count
  const updateQuery = `
    MATCH (u:User {uuid: $userUuid})
    MATCH (u)-[:UserPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $youtubeId})
    SET ps.customName = $customName,
        ps.updatedAt = datetime()

    WITH u, p, ps

    // Count videos in this playlist that the user has access to
    OPTIONAL MATCH (p)-[:PlaylistVideo]->(v:Video)
    OPTIONAL MATCH (u)-[:UserVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v)

    WITH p, ps, COUNT(DISTINCT CASE WHEN v IS NOT NULL THEN v END) as videoCount

    RETURN p, ps, videoCount
  `;

  const result = await args.session.run(updateQuery, {
    userUuid: user.P.uuid,
    youtubeId,
    customName: customName || null
  });

  if (result.records.length === 0) {
    throw new Error("Playlist not found");
  }

  const playlist = args.convertNodeToJson(result.records[0].get('p'));
  const playlistSettings = args.convertNodeToJson(result.records[0].get('ps'));
  const videoCount = result.records[0].get('videoCount');

  // Add user-specific video count to playlist settings
  if (playlistSettings && playlistSettings.P) {
    playlistSettings.P.userVideoCount = videoCount ? (typeof videoCount.toNumber === 'function' ? videoCount.toNumber() : Number(videoCount)) : 0;
  }

  return {
    success: true,
    message: "Playlist settings updated successfully",
    data: {
      playlist: playlist,
      playlistSettings: playlistSettings
    }
  };

} catch (error) {
  console.error("Error updating playlist settings:", error);

  let userMessage = "Failed to update playlist settings. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to update playlist settings.";
  } else if (error.message.includes("Playlist not found")) {
    userMessage = "Playlist not found.";
  } else if (error.message.includes("Playlist ID is required")) {
    userMessage = "Playlist ID is required.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "UpdateError",
      details: error.message
    }
  };
}
'''
      }
    }
  ],
  edges: []
}
