{
  vertexes: [
    {
      id: "get_all_processing_status_function",
      L: "Function",
      P: {
        key: "getAllProcessingStatus",
        description: "Get processing status for all channels and playlists for current user",
        body: '''
try {
  // Get current authenticated user
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found");
  }

  // Fetch all channel statuses that are not completed
  const channelResult = await args.session.run(`
    MATCH (u:User {uuid: $userUuid})-[:UserChannelSetting]->(cs:ChannelSetting)
          -[:ChannelSettingChannel]->(c:Channel)
    WHERE cs.status IN ['queued', 'processing']
    RETURN c, cs
  `, { userUuid: user.P.uuid });

  // Fetch all playlist statuses that are not completed
  const playlistResult = await args.session.run(`
    MATCH (u:User {uuid: $userUuid})-[:UserPlaylistSetting]->(ps:PlaylistSetting)
          -[:PlaylistSettingPlaylist]->(p:Playlist)
    WHERE ps.status IN ['queued', 'processing']
    RETURN p, ps
  `, { userUuid: user.P.uuid });

  const channels = channelResult.records.map(record => ({
    channel: args.convertNodeToJson(record.get('c')),
    channelSetting: args.convertNodeToJson(record.get('cs'))
  }));

  const playlists = playlistResult.records.map(record => ({
    playlist: args.convertNodeToJson(record.get('p')),
    playlistSetting: args.convertNodeToJson(record.get('ps'))
  }));

  return {
    success: true,
    data: {
      channels,
      playlists,
      hasActiveProcessing: channels.length > 0 || playlists.length > 0
    }
  };

} catch (error) {
  console.error("Error fetching processing statuses:", error);
  return {
    success: false,
    message: "Failed to fetch processing statuses",
    error: { details: error.message }
  };
}
'''
      }
    }
  ],
  edges: []
}
