{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Updates video setting like custom name. Supports multi-ownership model - requires ownershipId.
        body:
          '''
// Get current authenticated user from session
const actualUser = await _.getUserFromSession();
if (!actualUser) {
  return {
    success: false,
    message: "User session not found. Please log in and try again."
  };
}

// Get effective user (handles admin impersonation)
const user = await _.getEffectiveUser(_.session, actualUser, c);

const { youtubeId, customName, ownershipId } = c;

if (!youtubeId) {
  return {
    success: false,
    message: "Video ID is required"
  };
}

if (!ownershipId) {
  return {
    success: false,
    message: "YouTube Ownership ID is required. Please select a YouTube account."
  };
}

// Verify ownership belongs to user
const ownershipCheck = await _.session.run(`
  MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
  RETURN o
`, { userUuid: user.P.uuid, ownershipId });

if (ownershipCheck.records.length === 0) {
  return {
    success: false,
    message: "Invalid YouTube ownership. This account doesn't belong to you or no longer exists."
  };
}

// NEW SCHEMA v4.0: Create or update VideoSetting
// VideoSettings store custom data (notes, favorites, custom names)
const videoSettingKey = `video_setting_${youtubeId}_${ownershipId}`;

const updateQuery = `
  MATCH (o:YouTubeOwnership {key: $ownershipId})
  MATCH (o)-[:YouTubeOwnershipVideo]->(v:Video {youtubeId: $youtubeId})
  MERGE (v)-[:VideoVideoSetting]->(vs:VideoSetting {key: $settingKey})
  ON CREATE SET vs.createdAt = datetime()
  MERGE (o)-[:YouTubeOwnershipVideoSetting]->(vs)
  SET vs.customName = $customName, vs.updatedAt = datetime()
  RETURN v.youtubeId as youtubeId
`;

const updateResult = await _.session.run(updateQuery, {
  ownershipId,
  youtubeId,
  customName: customName || null,
  settingKey: videoSettingKey
});

if (updateResult.records.length === 0) {
  return {
    success: false,
    message: "Video not found."
  };
}

// Fetch updated video data with details using helper function
const fetchResult = await s({
  functionName: "getVideosWithDetails",
  contextData: {
    userUuid: user.P.uuid,
    ownershipId,  // Filter by specific ownership
    videoIds: [youtubeId]
  }
});

if (!fetchResult.result || !fetchResult.result.success || fetchResult.result.data.length === 0) {
  return {
    success: false,
    message: "Failed to fetch updated video data"
  };
}

const videoData = fetchResult.result.data[0];

return {
  success: true,
  message: "Video setting updated successfully",
  data: videoData
};
'''
        key: updateVideoSetting
      }
    }
  ]
  edges: []
}