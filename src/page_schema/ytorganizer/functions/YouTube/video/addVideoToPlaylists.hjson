{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Adds a video to multiple playlists at once
        body:
          '''
// Get current authenticated user from session
const actualUser = await _.getUserFromSession();
if (!actualUser) {
  return {
    success: false,
    message: "Please log in to add videos to playlists.",
    data: {
      successfulPlaylists: [],
      failedPlaylists: [],
      successCount: 0,
      errorCount: 0,
      totalCount: 0
    }
  };
}

// Get effective user (handles admin impersonation)
const user = await _.getEffectiveUser(_.session, actualUser, c);

// Extract parameters
const { video, playlistIds, ownershipId } = c;

if (!video) {
  return {
    success: false,
    message: "Video is required",
    data: {
      successfulPlaylists: [],
      failedPlaylists: [],
      successCount: 0,
      errorCount: 0,
      totalCount: 0
    }
  };
}

if (!ownershipId) {
  return {
    success: false,
    message: "YouTube Ownership ID is required. Please select a YouTube account.",
    data: {
      successfulPlaylists: [],
      failedPlaylists: [],
      successCount: 0,
      errorCount: 0,
      totalCount: 0
    }
  };
}

if (!playlistIds || !Array.isArray(playlistIds) || playlistIds.length === 0) {
  return {
    success: false,
    message: "At least one playlist ID is required",
    data: {
      successfulPlaylists: [],
      failedPlaylists: [],
      successCount: 0,
      errorCount: 0,
      totalCount: 0
    }
  };
}

// Get the video ID
const videoId = video.P?.youtubeId || video.P?.id;
if (!videoId) {
  return {
    success: false,
    message: "Video ID not found",
    data: {
      successfulPlaylists: [],
      failedPlaylists: [],
      successCount: 0,
      errorCount: 0,
      totalCount: 0
    }
  };
}

// Add video to each playlist
const results = [];
const errors = [];

for (const playlistId of playlistIds) {
  try {
    // Call the existing addVideoToPlaylist function for each playlist
    const result = await s({
      functionName: "addVideoToPlaylist",
      contextData: {
        playlistId: playlistId,
        videoYoutubeId: videoId,
        ownershipId: ownershipId
      }
    });

    if (result?.result?.success) {
      results.push({
        playlistId,
        success: true,
        message: result.result.message
      });
    } else {
      errors.push({
        playlistId,
        success: false,
        message: result?.result?.message || "Unknown error"
      });
    }
  } catch (error) {
    errors.push({
      playlistId,
      success: false,
      message: error.message
    });
  }
}

const successCount = results.length;
const errorCount = errors.length;

// Return combined results
return {
  success: successCount > 0,
  data: {
    video: video,
    successfulPlaylists: results,
    failedPlaylists: errors,
    successCount,
    errorCount,
    totalCount: playlistIds.length
  },
  message: errorCount === 0
    ? `Video added to ${successCount} playlist${successCount !== 1 ? 's' : ''}`
    : `Video added to ${successCount} playlist${successCount !== 1 ? 's' : ''}, ${errorCount} failed`
};
'''
        key: addVideoToPlaylists
      }
    }
  ]
  edges: []
}