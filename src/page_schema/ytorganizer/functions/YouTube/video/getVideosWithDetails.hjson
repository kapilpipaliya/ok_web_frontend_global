{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Helper function to fetch videos with details for a user. Supports filtering by videoIds, statusFilter, and custom ordering (orderBy, orderDirection)
        body:
          '''
/**
 * Get Videos with Details
 *
 * Parameters (via args.contextData):
 * - userUuid: string (required) - User UUID
 * - ownershipId: string (required) - YouTube ownership ID to filter videos by
 * - videoIds: string[] (optional) - Filter by specific video IDs
 * - playlistId: string (optional) - Filter videos by specific playlist ID
 * - statusFilter: string[] (optional) - Filter by status values (e.g., ['watched', 'unwatched'])
 * - isFavouriteOnly: boolean (optional) - Filter to only favourite videos (default: false)
 * - customFilter: string (optional) - Custom WHERE clause condition (e.g., 'v.title =~ $pattern OR vs.note =~ $pattern')
 * - customFilterParams: object (optional) - Parameters for the custom filter (e.g., {pattern: '(?i).*search.*'})
 * - includePlaylist: boolean (optional) - Include first playlist information (default: false)
 * - orderBy: string (optional) - Field to order by (default: 'vs.updatedAt')
 *   Allowed values: 'vs.createdAt', 'vs.updatedAt', 'vs.favouritedAt', 'vs.playlistIndex',
 *                   'v.title', 'v.publishedAt', 'v.duration', 'v.viewCount'
 * - orderDirection: string (optional) - Order direction 'ASC' or 'DESC' (default: 'DESC')
 * - secondaryOrderBy: string (optional) - Secondary field to order by
 * - limit: number (optional) - Maximum number of results to return
 * - skip: number (optional) - Number of results to skip (for pagination)
 *
 * Returns:
 * - Array of {video: Vertex, videoSetting: Vertex, parentPlaylist: {playlist: Vertex, playlistSetting: Vertex}|null}
 */
try {
  const {
    userUuid,
    ownershipId,
    videoIds = [],
    playlistId = null,
    statusFilter = [],
    isFavouriteOnly = false,
    customFilter = '',
    customFilterParams = {},
    includePlaylist = false,
    orderBy = 'vs.updatedAt',
    orderDirection = 'DESC',
    secondaryOrderBy = null,
    limit = null,
    skip = 0
  } = args.contextData;

  if (!userUuid) {
    throw new Error("User UUID is required");
  }

  if (!ownershipId) {
    throw new Error("YouTube Ownership ID is required. Please select a YouTube account.");
  }

  // Build WHERE clause for video IDs if provided
  const videoIdFilter = videoIds.length > 0
    ? 'AND v.youtubeId IN $videoIds'
    : '';

  // Build WHERE clause for status filter if provided
  const statusFilterClause = statusFilter.length > 0
    ? 'AND vs.status IN $statusFilter'
    : '';

  // Build WHERE clause for favourite filter if provided
  const favouriteFilterClause = isFavouriteOnly
    ? 'AND vs.isFavourite = true'
    : '';

  // Build custom filter clause if provided
  const customFilterClause = customFilter ? `AND (${customFilter})` : '';

  // Validate and build ORDER BY clause
  // Allowed fields for ordering
  const allowedOrderFields = [
    'vs.createdAt', 'vs.updatedAt', 'vs.favouritedAt', 'vs.playlistIndex',
    'v.title', 'v.publishedAt', 'v.duration', 'v.viewCount'
  ];

  let orderByClause = 'vs.updatedAt DESC'; // Default

  if (orderBy && allowedOrderFields.includes(orderBy)) {
    const direction = (orderDirection || 'DESC').toUpperCase();
    if (direction === 'ASC' || direction === 'DESC') {
      // Handle COALESCE for playlistIndex
      const orderField = orderBy === 'vs.playlistIndex' ? 'COALESCE(vs.playlistIndex, 0)' : orderBy;
      orderByClause = `${orderField} ${direction}`;

      // Add secondary ordering if provided
      if (secondaryOrderBy && allowedOrderFields.includes(secondaryOrderBy)) {
        orderByClause += `, ${secondaryOrderBy} ASC`;
      }
    }
  }

  // Build ownership matching clause
  // NEW SCHEMA v4.0: Always verify ownership
  const ownershipMatchClause = 'MATCH (u)-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})';

  // Build video matching clause based on whether playlistId is provided
  // NEW SCHEMA v4.0: Global playlist membership + optional video settings
  let videoMatchClause;
  let playlistInfoClause = '';
  let playlistReturn = '';

  if (playlistId) {
    // Match videos through global Playlist->Video relationship for specific playlist
    videoMatchClause = `
      MATCH (o)-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
      MATCH (p)-[:PlaylistVideo]->(v:Video)
      // Optional VideoSetting (only exists if user has notes/favorites/etc.)
      OPTIONAL MATCH (v)-[:VideoVideoSetting]->(vs:VideoSetting)<-[:YouTubeOwnershipVideoSetting]-(o)
      // Optional PlaylistSetting (only exists if user has customized playlist)
      OPTIONAL MATCH (p)-[:PlaylistPlaylistSetting]->(ps:PlaylistSetting)<-[:YouTubeOwnershipPlaylistSetting]-(o)
    `;
    playlistInfoClause = includePlaylist ? `
      WITH v, vs, p, ps
      WHERE 1=1 ${videoIdFilter} ${statusFilterClause} ${favouriteFilterClause} ${customFilterClause}
    ` : `
      WHERE 1=1 ${videoIdFilter} ${statusFilterClause} ${favouriteFilterClause} ${customFilterClause}
    `;
    playlistReturn = includePlaylist ? ', p as parentPlaylist, ps as parentPlaylistSetting' : '';
  } else {
    // Match videos through ownership's playlists (all videos in ownership's playlists)
    // This ensures all videos are searchable, not just those with VideoSetting nodes
    videoMatchClause = `
      MATCH (o)-[:YouTubeOwnershipPlaylist]->(p:Playlist)
      MATCH (p)-[:PlaylistVideo]->(v:Video)
      // Optional VideoSetting (only exists if user has notes/favorites/etc.)
      OPTIONAL MATCH (v)-[:VideoVideoSetting]->(vs:VideoSetting)<-[:YouTubeOwnershipVideoSetting]-(o)
    `;
    // For includePlaylist when no specific playlistId, collect first playlist per video and deduplicate
    if (includePlaylist) {
      playlistInfoClause = `
        WITH DISTINCT v, vs, collect(DISTINCT p)[0] as p
        OPTIONAL MATCH (p)-[:PlaylistPlaylistSetting]->(ps:PlaylistSetting)<-[:YouTubeOwnershipPlaylistSetting]-(o)
        WITH v, vs, p, ps
        WHERE 1=1 ${videoIdFilter} ${statusFilterClause} ${favouriteFilterClause} ${customFilterClause}
      `;
      playlistReturn = ', p as parentPlaylist, ps as parentPlaylistSetting';
    } else {
      playlistInfoClause = `
        WITH DISTINCT v, vs
        WHERE 1=1 ${videoIdFilter} ${statusFilterClause} ${favouriteFilterClause} ${customFilterClause}
      `;
    }
  }

  // Build SKIP and LIMIT clauses
  const skipClause = skip > 0 ? `SKIP ${skip}` : '';
  const limitClause = limit ? `LIMIT ${limit}` : '';

  // Cypher query to fetch videos with details
  const query = `
    MATCH (u:User {uuid: $userUuid})
    ${ownershipMatchClause}
    ${videoMatchClause}
    ${playlistInfoClause}
    RETURN v, vs${playlistReturn}
    ORDER BY ${orderByClause}
    ${skipClause}
    ${limitClause}
  `;

  // Execute the query
  const result = await args.session.run(query, {
    userUuid,
    ownershipId,
    videoIds,
    playlistId,
    statusFilter,
    ...customFilterParams
  });

  // Convert results to JSON format
  const videos = result.records.map(record => {
    // Handle optional VideoSetting (might be null if user hasn't customized)
    const videoSettingNode = record.get('vs');
    const videoSetting = videoSettingNode ? args.convertNodeToJson(videoSettingNode) : null;

    const videoData = {
      video: args.convertNodeToJson(record.get('v')),
      videoSetting
    };

    // Add playlist information if requested AND playlistId was provided
    if (includePlaylist && playlistId) {
      const parentPlaylist = record.get('parentPlaylist');
      const parentPlaylistSetting = record.get('parentPlaylistSetting');
      if (parentPlaylist && parentPlaylistSetting) {
        videoData.parentPlaylist = {
          playlist: args.convertNodeToJson(parentPlaylist),
          playlistSetting: args.convertNodeToJson(parentPlaylistSetting)
        };
      } else {
        videoData.parentPlaylist = null;
      }
    }

    return videoData;
  });

  return {
    success: true,
    data: videos
  };

} catch (error) {
  console.error('Error fetching videos with details:', error);
  return {
    success: false,
    message: "Failed to fetch videos",
    error: {
      type: "DatabaseError",
      details: error.message
    },
    data: []
  };
}
'''
        key: getVideosWithDetails
      }
    }
  ]
  edges: []
}