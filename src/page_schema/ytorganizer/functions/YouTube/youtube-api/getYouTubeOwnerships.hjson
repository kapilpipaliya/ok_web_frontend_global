{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Get all YouTube ownerships for a user
        body:
          '''
// Get user from session
const user = await _.getUserFromSession(_.request);
if (!user) {
  throw new Error('User not authenticated');
}

// Get all ownerships for the user with active tokens
const result = await _.session.run(`
  MATCH (u:User {uuid: $userId})-[:UserYouTubeOwnership]->(o:YouTubeOwnership)
        -[:YouTubeOwnershipToken]->(token:YouTubeToken)
  WHERE token.isRevoked = false
  RETURN o
  ORDER BY o.isPrimary DESC, o.lastSelected DESC
`, {
  userId: user.P.uuid
});

// Convert Neo4j nodes to vertex format
const ownerships = result.records.map((record) => {
  const ownershipNode = record.get('o');
  return _.convertNodeToJson(ownershipNode);
});

return {
  success: true,
  data: ownerships
};
'''
        key: getYouTubeOwnerships
      }
    }
  ]
  edges: []
}