{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Update the lastSelected timestamp for a YouTube ownership
        body:
          '''
const { ownershipId } = c;

if (!ownershipId) {
  return {
    success: false,
    message: "Ownership ID is required."
  };
}

// Get current authenticated user from session
const user = await _.getUserFromSession();
if (!user) {
  return {
    success: false,
    message: "Please log in to update ownership."
  };
}

// Verify ownership belongs to user and update lastSelected
const result = await _.session.run(`
  MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
  SET o.lastSelected = datetime()
  RETURN o
`, {
  userUuid: user.P.uuid,
  ownershipId
});

if (result.records.length === 0) {
  return {
    success: false,
    message: "YouTube ownership not found or access denied"
  };
}

return {
  success: true,
  message: "Ownership updated successfully"
};
'''
        key: updateOwnershipLastSelected
      }
    }
  ]
  edges: []
}