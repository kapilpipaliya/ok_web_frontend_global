{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Get all YouTube ownerships for a user (including disconnected/revoked)
        body:
          '''
// Get current authenticated user from session
const actualUser = await _.getUserFromSession(_.request);
if (!actualUser) {
  throw new Error('User not authenticated');
}

// Get effective user (handles admin impersonation)
const user = await _.getEffectiveUser(_.session, actualUser, c);

// Get all ownerships for the user (including revoked)
const result = await _.session.run(`
  MATCH (u:User {uuid: $userId})-[:UserYouTubeOwnership]->(o:YouTubeOwnership)
  OPTIONAL MATCH (o)-[:YouTubeOwnershipToken]->(token:YouTubeToken)
  WITH o, token
  ORDER BY o.isPrimary DESC, o.lastSelected DESC
  RETURN o, token
`, {
  userId: user.P.uuid
});

// Convert Neo4j nodes to vertex format with connection status
const ownerships = result.records.map((record) => {
  const ownershipNode = record.get('o');
  const tokenNode = record.get('token');

  const ownership = _.convertNodeToJson(ownershipNode);
  const token = tokenNode ? _.convertNodeToJson(tokenNode) : null;

  // Remove sensitive token fields before sending to client
  if (token && token.P) {
    delete token.P.accessToken;
    delete token.P.refreshToken;
  }

  return {
    ownership: ownership,
    token: token,
    isConnected: token ? !token.P.isRevoked : false
  };
});

return {
  success: true,
  data: ownerships
};
'''
        key: getAllYouTubeOwnerships
      }
    }
  ]
  edges: []
}