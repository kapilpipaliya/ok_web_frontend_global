{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Scheduled function to retry all pending_quota jobs (run at midnight UTC)
        body:
          '''
const helpers = await args.executeNamedServerFunction({ functionName: 'queueHelpers', contextData: {} });

// Get all ownerships with pending_quota channels, sorted by ownership priority (higher = more important)
// This ensures higher-priority ownerships get their quota allocation first after midnight reset
// NEW ARCHITECTURE: Queue status on Channel vertex
const channelsResult = await args.session.run(`
  MATCH (u:User)-[:UserYouTubeOwnership]->(o:YouTubeOwnership)
  MATCH (o)-[:YouTubeOwnershipChannel]->(c:Channel)
  WHERE c.queueStatus = 'pending_quota'
  RETURN u.uuid as userUuid, u.id as userId, o.key as ownershipId, c.youtubeId as channelId,
         c.priority as priority, COALESCE(o.priority, 0) as ownershipPriority
  ORDER BY ownershipPriority DESC, c.priority DESC
`);

// Get all ownerships with pending_quota playlists, sorted by ownership priority (higher = more important)
// This ensures higher-priority ownerships get their quota allocation first after midnight reset
// NEW ARCHITECTURE: Queue status on Playlist vertex
const playlistsResult = await args.session.run(`
  MATCH (u:User)-[:UserYouTubeOwnership]->(o:YouTubeOwnership)
  MATCH (o)-[:YouTubeOwnershipPlaylist]->(p:Playlist)
  WHERE p.queueStatus = 'pending_quota'
  RETURN u.uuid as userUuid, u.id as userId, o.key as ownershipId, p.youtubeId as playlistId,
         p.priority as priority, COALESCE(o.priority, 0) as ownershipPriority
  ORDER BY ownershipPriority DESC, p.priority DESC
`);

let channelsRetried = 0;
let playlistsRetried = 0;

// Retry channels
if (channelsResult.records.length > 0) {
  const channelQueue = helpers.result.data.createChannelQueue(args);

  try {
    for (const record of channelsResult.records) {
      const userUuid = record.get('userUuid');
      const userId = record.get('userId');
      const ownershipId = record.get('ownershipId');
      const channelId = record.get('channelId');
      const priority = record.get('priority') || 'normal';
      const jobPriority = priority === 'high' ? 1 : priority === 'low' ? 3 : 2;

      // Generate unique job ID with ownership context
      const jobId = helpers.result.data.createJobId('channel', ownershipId, channelId);

      // Remove existing job with this ID if it exists (but not if it's active)
      const { removed, state } = await helpers.result.data.removeExistingJob(channelQueue, jobId, ['active']);

      if (state === 'active') {
        console.log(`[Quota Retry] Job ${jobId} is currently active, skipping re-queue`);
        continue;  // Skip to next channel - don't re-queue active jobs
      }

      // Re-queue the channel
      await helpers.result.data.addChannelJob(channelQueue, {
        channelId,
        userId,
        userUuid,
        ownershipId,  // Required for multi-ownership support
        priority
      }, {
        priority: jobPriority  // Override default priority
      });

      // Update status back to queued
      // NEW ARCHITECTURE: Update queue status on Channel vertex
      await args.session.run(`
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannel]->(c:Channel {youtubeId: $channelId})
        SET c.queueStatus = 'queued',
            c.error = null,
            c.queuedAt = datetime(),
            c.updatedAt = datetime()
      `, { ownershipId, channelId });

      channelsRetried++;
    }
  } finally {
    await channelQueue.close();
  }
}

// Retry playlists
if (playlistsResult.records.length > 0) {
  const playlistQueue = helpers.result.data.createPlaylistQueue(args);

  try {
    for (const record of playlistsResult.records) {
      const userUuid = record.get('userUuid');
      const userId = record.get('userId');
      const ownershipId = record.get('ownershipId');
      const playlistId = record.get('playlistId');
      const priority = record.get('priority') || 'normal';
      const jobPriority = priority === 'high' ? 1 : priority === 'low' ? 3 : 2;

      // Generate unique job ID with ownership context
      const jobId = helpers.result.data.createJobId('playlist', ownershipId, playlistId);

      // Remove existing job with this ID if it exists (but not if it's active)
      const { removed, state } = await helpers.result.data.removeExistingJob(playlistQueue, jobId, ['active']);

      if (state === 'active') {
        console.log(`[Quota Retry] Job ${jobId} is currently active, skipping re-queue`);
        continue;  // Skip to next playlist - don't re-queue active jobs
      }

      // Re-queue the playlist
      await helpers.result.data.addPlaylistJob(playlistQueue, {
        playlistId,
        userId,
        userUuid,
        ownershipId,  // Required for multi-ownership support
        priority
      }, {
        priority: jobPriority  // Override default priority
      });

      // Update status back to queued
      // NEW ARCHITECTURE: Update queue status on Playlist vertex
      await args.session.run(`
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
        SET p.queueStatus = 'queued',
            p.error = null,
            p.queuedAt = datetime(),
            p.updatedAt = datetime()
      `, { ownershipId, playlistId });

      playlistsRetried++;
    }
  } finally {
    await playlistQueue.close();
  }
}

console.log(`[Midnight Quota Reset] Retried ${channelsRetried} channels and ${playlistsRetried} playlists`);

return {
  success: true,
  message: `Retried ${channelsRetried} channels and ${playlistsRetried} playlists`,
  data: {
    channelsRetried,
    playlistsRetried,
    retriedAt: new Date().toISOString()
  }
};
'''
        key: retryPendingQuotaJobs
      }
    }
  ]
  edges: []
}