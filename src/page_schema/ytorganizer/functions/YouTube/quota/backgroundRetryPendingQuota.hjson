      id: "1"
      L: Function
      P: {
        description: Background worker that automatically retries pending_quota jobs at midnight Pacific Time every day
        body:
          '''
// This is a background worker function that runs on a schedule
if (args.contextData.action === 'start') {
  // Helper function to log messages to database
  const logMessage = async (level, message, metadata = {}) => {
    try {
      await args.executeNamedServerFunction({
        functionName: 'logWorkerMessage',
        contextData: {
          workerName: 'backgroundRetryPendingQuota',
          level,
          message,
          metadata
        }
      }, { functionLookupSubDomain: args.subDomain });
    } catch (error) {
      // Silent failure - don't break worker if logging fails
    }
  };

  await logMessage('info', 'Starting background retry pending quota worker (scheduled for midnight Pacific Time)');

  // Initialize queue helpers and Redis connection
  const helpers = await args.executeNamedServerFunction({ functionName: 'queueHelpers', contextData: {} }, { functionLookupSubDomain: args.subDomain });

  if (!helpers.result?.success) {
    await logMessage('error', 'Failed to initialize queue helpers', { error: helpers.result?.error });
    throw new Error('Queue helpers initialization failed');
  }

  const { Worker, Queue } = args.bullmq;
  const connection = helpers.result.data.getRedisConnection();

  // Validate Redis connection config
  if (!connection || !connection.host) {
    await logMessage('error', 'Invalid Redis connection configuration', { connection });
    throw new Error('Invalid Redis connection configuration');
  }

  // Create a queue for the scheduled retry jobs
  const retryQueue = new Queue('backgroundRetryPendingQuota', { connection });

  // Add a repeatable job that runs at midnight Pacific Time every day
  // Cron pattern: "0 0 * * *" = At 00:00 (midnight) every day
  // YouTube API quotas reset at midnight Pacific Time (PT)
  await retryQueue.add(
    'midnight-quota-retry',
    {
      scheduledRun: true,
      description: 'Automated midnight retry of pending_quota jobs'
    },
    {
      repeat: {
        pattern: '0 0 * * *', // Midnight PT every day
        tz: 'America/Los_Angeles'
      },
      jobId: 'midnight-quota-retry-repeatable' // Prevent duplicates
    }
  );

  await logMessage('info', 'Scheduled repeatable job for midnight Pacific Time', {
    cronPattern: '0 0 * * *',
    timezone: 'America/Los_Angeles'
  });

  // Small delay to ensure queue is fully initialized
  await new Promise(resolve => setTimeout(resolve, 100));

  // Create worker to process the scheduled retry jobs with error handling
  let worker;
  try {
    await logMessage('info', 'Creating BullMQ Worker for quota retry');

    worker = new Worker('backgroundRetryPendingQuota', async (job) => {
    await logMessage('info', 'Starting scheduled retry of pending_quota jobs', {
      jobId: job.id,
      scheduledTime: new Date().toISOString()
    });

    try {
      // Call the retry function
      const result = await args.executeNamedServerFunction({
        functionName: 'retryPendingQuotaJobs',
        contextData: {}
      }, { functionLookupSubDomain: args.subDomain });

      if (result.result?.success) {
        await logMessage('info', 'Successfully completed scheduled quota retry', {
          channelsRetried: result.result.data?.channelsRetried,
          playlistsRetried: result.result.data?.playlistsRetried,
          retriedAt: result.result.data?.retriedAt
        });
      } else {
        await logMessage('error', 'Scheduled quota retry failed', {
          error: result.result?.error || result.error
        });
      }

      return result.result;
    } catch (error) {
      await logMessage('error', 'Error during scheduled quota retry', {
        error: error.message,
        stack: error.stack
      });
      throw error;
    }
  }, {
    connection,
    concurrency: 1 // Only run one retry job at a time
  });

    // Event handlers for job lifecycle
    worker.on('completed', async (job, result) => {
      await logMessage('info', 'Scheduled retry job completed', {
        jobId: job.id,
        channelsRetried: result?.data?.channelsRetried,
        playlistsRetried: result?.data?.playlistsRetried
      });
    });

    worker.on('failed', async (job, err) => {
      await logMessage('error', 'Scheduled retry job failed', {
        jobId: job?.id,
        error: err.message,
        stack: err.stack
      });
    });

    // Event handler for worker errors (including connection errors)
    worker.on('error', async (err) => {
      await logMessage('error', 'Worker error occurred', {
        error: err.message,
        stack: err.stack,
        code: err.code
      });
    });

    await logMessage('info', 'Quota retry worker created successfully', {
      concurrency: 1
    });

    // Return stop function for graceful shutdown
    return {
      stop: async (force = false) => {
        await logMessage('info', `Stopping background retry pending quota worker${force ? ' (force)' : ''}`);

        // Remove the repeatable job
        try {
          await retryQueue.removeRepeatableByKey('backgroundRetryPendingQuota:midnight-quota-retry-repeatable::0 0 * * *:America/Los_Angeles');
          await logMessage('info', 'Removed repeatable job');
        } catch (error) {
          console.error('Error removing repeatable job:', error);
        }

        // Close the worker and queue
        if (worker) {
          await worker.close(force);
        }
        await retryQueue.close(force);
        await logMessage('info', 'Stopped background retry pending quota worker');
      }
    };

  } catch (error) {
    await logMessage('error', 'Failed to create quota retry worker', {
      error: error.message,
      stack: error.stack,
      code: error.code
    });

    // If worker was partially created, try to close it
    if (worker) {
      try {
        await worker.close();
      } catch (closeError) {
        console.error('Error closing worker:', closeError);
      }
    }

    // Close the queue
    try {
      await retryQueue.close();
    } catch (closeError) {
      console.error('Error closing queue:', closeError);
    }

    throw error;
  }
}
'''
        key: backgroundRetryPendingQuota
      }
    }
  ]
  edges: []
