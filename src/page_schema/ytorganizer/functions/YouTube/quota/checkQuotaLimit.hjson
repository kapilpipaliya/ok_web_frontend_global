{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Check if user can add more videos based on their subscription plan quota
        body:
          '''
// Get authenticated user
const user = await _.getUserFromSession();
if (!user) {
  return {
    success: false,
    message: "User session not found. Please log in.",
    data: {
      allowed: true,
      isWithinLimit: true,
      wouldExceedLimit: false
    }
  };
}

const { videosToAdd = 1 } = c;

// Fetch user's quota information
const userResult = await _.session.run(
  `MATCH (u:User {uuid: $userId})
   RETURN u`,
  { userId: user.P.uuid }
);

if (userResult.records.length === 0) {
  return {
    success: false,
    message: "User not found",
    data: {
      allowed: true,
      isWithinLimit: true,
      wouldExceedLimit: false
    }
  };
}

const userNode = userResult.records[0].get("u");
const userVertex = _.convertNodeToJson(userNode);

const currentPlan = userVertex.P.currentPlan || "free";
const videoQuotaLimit = userVertex.P.videoQuotaLimit || 10000;
const videoQuotaUsed = userVertex.P.videoQuotaUsed || 0;

const videoQuotaRemaining = videoQuotaLimit - videoQuotaUsed;
const newTotalUsed = videoQuotaUsed + videosToAdd;

// For soft limit: always allow, but notify if over limit
const isWithinLimit = newTotalUsed <= videoQuotaLimit;
const wouldExceedLimit = newTotalUsed > videoQuotaLimit;

// Calculate how many videos they can add before hitting limit
const videosUntilLimit = Math.max(0, videoQuotaLimit - videoQuotaUsed);

// Determine what plan they should upgrade to
let suggestedPlan = null;

if (wouldExceedLimit) {
  if (currentPlan === 'free' || currentPlan === 'basic') {
    suggestedPlan = 'pro';
  } else if (currentPlan === 'pro') {
    suggestedPlan = 'unlimited';
  }
}

// Calculate quota percentage
const quotaPercentage = videoQuotaLimit > 0
  ? Math.round((newTotalUsed / videoQuotaLimit) * 100)
  : 0;

return {
  success: true,
  data: {
    allowed: true, // Soft limit: always allowed, just show warning
    isWithinLimit: isWithinLimit,
    wouldExceedLimit: wouldExceedLimit,
    currentPlan: currentPlan,
    videoQuotaLimit: videoQuotaLimit,
    videoQuotaUsed: videoQuotaUsed,
    videoQuotaRemaining: videoQuotaRemaining,
    videosToAdd: videosToAdd,
    newTotalUsed: newTotalUsed,
    videosUntilLimit: videosUntilLimit,
    quotaPercentage: quotaPercentage,
    suggestedPlan: suggestedPlan,
    shouldShowUpgradePrompt: wouldExceedLimit,
    upgradeMessage: wouldExceedLimit
      ? `You've reached your ${currentPlan} plan limit of ${videoQuotaLimit.toLocaleString()} videos. Upgrade to ${suggestedPlan || 'a higher'} plan to add more videos.`
      : null
  }
};
'''
        key: checkQuotaLimit
      }
    }
  ]
  edges: []
}