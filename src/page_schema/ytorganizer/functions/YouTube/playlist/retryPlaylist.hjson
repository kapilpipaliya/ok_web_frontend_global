{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Retry a failed or stuck playlist processing job
        body:
          '''
/**
 * Retry Playlist Processing
 *
 * This function allows manual retry of failed or stuck playlists
 * Useful for:
 * - Recovering from temporary API failures
 * - Retrying after quota limits are lifted
 * - Fixing stuck jobs that are processing for too long
 * - Re-processing playlists after bug fixes
 *
 * IMPORTANT: This resets the playlist to 'queued' state and re-adds it to the queue
 * Any partially completed videos will be re-processed
 */

  const { playlistId, ownershipId } = c;

  if (!playlistId) {
    return {
      success: false,
      message: "Playlist ID is required",
      error: {
        type: "ValidationError",
        details: "Missing playlistId parameter"
      }
    };
  }

  if (!ownershipId) {
    return {
      success: false,
      message: "YouTube account is required. Please ensure you have a connected YouTube account.",
      error: {
        type: "ValidationError",
        details: "Missing ownershipId parameter. The playlist must be associated with a YouTube ownership."
      }
    };
  }

  // Get current authenticated user from session
  const actualUser = await _.getUserFromSession();
  if (!actualUser) {
    return {
      success: false,
      message: "User session not found. Please log in and try again.",
      error: {
        type: "AuthenticationError",
        details: "No active user session"
      }
    };
  }

  // Get effective user (handles admin impersonation)
  const user = await _.getEffectiveUser(_.session, actualUser, c);

  // Verify ownership belongs to user
  const ownershipCheck = await _.session.run(`
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
    RETURN o
  `, { userUuid: user.P.uuid, ownershipId });

  if (ownershipCheck.records.length === 0) {
    return {
      success: false,
      message: "Invalid YouTube account. This account doesn't belong to you or no longer exists.",
      error: {
        type: "AuthorizationError",
        details: "YouTube ownership not found or doesn't belong to current user"
      }
    };
  }

  // Check if playlist exists and get its current status
  // NEW SCHEMA v4.0: Direct ownership + optional settings
  const checkResult = await _.session.run(`
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
    MATCH (o)-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
    OPTIONAL MATCH (p)-[:PlaylistPlaylistSetting]->(ps:PlaylistSetting)<-[:YouTubeOwnershipPlaylistSetting]-(o)
    RETURN p, ps
  `, { userUuid: user.P.uuid, ownershipId, playlistId });

  if (checkResult.records.length === 0) {
    return {
      success: false,
      message: "Playlist not found in your collection"
    };
  }

  const playlistSettingNode = checkResult.records[0].get('ps');
  const playlistNode = checkResult.records[0].get('p');
  const playlistSetting = playlistSettingNode ? _.convertNodeToJson(playlistSettingNode) : null;
  const playlist = _.convertNodeToJson(playlistNode);

  const currentStatus = playlist.P.queueStatus;

  // Prevent retry of playlists that are already queued or processing
  if (currentStatus === 'queued' || currentStatus === 'processing') {
    return {
      success: false,
      message: `Playlist is already ${currentStatus}. Please wait for it to complete.`,
      data: {
        playlistId,
        currentStatus
      }
    };
  }

  // Get channel ID if this playlist is part of a channel
  // NEW SCHEMA v4.0: Verify both channel and playlist ownership
  const channelResult = await _.session.run(`
    MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
    OPTIONAL MATCH (o)-[:YouTubeOwnershipChannel]->(c:Channel)-[:ChannelPlaylist]->(p)
    RETURN c.youtubeId as channelId
    LIMIT 1
  `, { ownershipId, playlistId });

  const channelId = channelResult.records.length > 0
    ? channelResult.records[0].get('channelId')
    : null;

  // Reset playlist queue status
  // This clears error state and resets progress counters
  // NEW ARCHITECTURE: Queue tracking on Playlist vertex directly
  await _.session.run(`
    MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})

    SET p.queueStatus = 'queued',
        p.progress = 0,
        p.processedVideos = 0,
        p.error = null,
        p.queuedAt = datetime(),
        p.updatedAt = datetime()
  `, { ownershipId, playlistId });

  // Re-add playlist to processing queue
  const helpers = await s({ functionName: 'queueHelpers', contextData: {} });
  const playlistQueue = helpers.result.data.createPlaylistQueue(_);

  try {
    // Get priority and convert to job priority number
    const priority = playlist.P.priority || 'normal';
    const jobPriority = priority === 'high' ? 1 : priority === 'low' ? 3 : 2;

    // Generate unique job ID with ownership context
    const jobId = helpers.result.data.createJobId('playlist', ownershipId, playlistId);

    // Remove existing job with this ID if it exists (but not if it's active)
    const { removed, state } = await helpers.result.data.removeExistingJob(playlistQueue, jobId, ['active']);

    if (state === 'active') {
      return {
        success: false,
        message: `Playlist "${playlist.P.title}" is already being processed. Please wait for it to complete.`,
        error: {
          type: "AlreadyActive",
          details: "Cannot retry a playlist that is currently being processed"
        }
      };
    }

    // Add job to queue
    await helpers.result.data.addPlaylistJob(playlistQueue, {
      playlistId,
      userId: user.id,
      userUuid: user.P.uuid,
      ownershipId,  // Required for multi-ownership support
      channelId: channelId,
      priority
    }, {
      priority: jobPriority  // Override default priority
    });
  } finally {
    await playlistQueue.close();
  }

  return {
    success: true,
    message: `Playlist "${playlist.P.title}" has been queued for retry. Processing will begin shortly.`,
    data: {
      playlistId,
      title: playlist.P.title,
      previousStatus: currentStatus,
      newStatus: 'queued',
      channelId: channelId
    }
  };
'''
        key: retryPlaylist
      }
    }
  ]
  edges: []
}