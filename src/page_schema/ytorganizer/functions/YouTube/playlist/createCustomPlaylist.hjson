{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Creates a custom user playlist that can contain any videos
        body:
          '''
// Extract input parameters from the request
const { name, description, ownershipId } = c;

if (!name || name.trim().length === 0) {
  return {
    success: false,
    message: "Playlist name is required."
  };
}

if (!ownershipId) {
  return {
    success: false,
    message: "YouTube Ownership ID is required. Please select a YouTube account."
  };
}

// Get current authenticated user from session
const actualUser = await _.getUserFromSession();
if (!actualUser) {
  return {
    success: false,
    message: "Please log in to create a custom playlist."
  };
}

// Get effective user (handles admin impersonation)
const user = await _.getEffectiveUser(_.session, actualUser, c);

// Verify ownership belongs to user
const ownershipCheck = await _.session.run(`
  MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
  RETURN o
`, { userUuid: user.P.uuid, ownershipId });

if (ownershipCheck.records.length === 0) {
  return {
    success: false,
    message: "Invalid YouTube ownership. This account doesn't belong to you or no longer exists."
  };
}

const ownership = _.convertNodeToJson(ownershipCheck.records[0].get('o'));

// Generate unique playlist ID for custom playlists
// Use timestamp + random string to ensure uniqueness
const timestamp = Date.now();
const randomString = Math.random().toString(36).substring(2, 8);
const customPlaylistId = `custom_${timestamp}_${randomString}`;

// Step 1 & 2: Create playlist with ownership relationship in one atomic query
// NEW ARCHITECTURE: Playlist only contains metadata, user customization goes on PlaylistSetting (created on-demand)
const playlistKey = `playlist_${customPlaylistId}_${ownershipId}`;

const createPlaylistWithOwnershipQuery = `
  MATCH (o:YouTubeOwnership {key: $ownershipId})

  // Create playlist with metadata only (no user customization defaults)
  CREATE (p:Playlist {
    key: $key,
    youtubeId: $playlistId,
    title: $title,
    description: $description,
    thumbnail: $thumbnail,
    itemCount: 0,
    isCustom: true,
    createdByUserId: $userId,
    publishedAt: datetime(),
    createdAt: datetime(),
    updatedAt: datetime()
  })

  // Create ownership relationship
  CREATE (o)-[:YouTubeOwnershipPlaylist]->(p)

  RETURN p
`;

const result = await _.session.run(createPlaylistWithOwnershipQuery, {
  ownershipId,
  key: playlistKey,
  playlistId: customPlaylistId,
  title: name.trim(),
  description: description?.trim() || "",
  thumbnail: "", // Custom playlists start with no thumbnail
  userId: user.id
});

const playlist = _.convertNodeToJson(result.records[0].get('p'));

return {
  success: true,
  message: `Custom playlist "${name}" created successfully!`,
  data: {
    playlist,
    ownership,
    playlistId: customPlaylistId,
    userId: user.id,
    isCustom: true
  }
};
'''
        key: createCustomPlaylist
      }
    }
  ]
  edges: []
}