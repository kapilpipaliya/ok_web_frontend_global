{
  vertexes: [
    {
      id: "create_custom_playlist_function",
      L: "Function",
      P: {
        key: "createCustomPlaylist",
        description: "Creates a custom user playlist that can contain any videos",
        body: '''
try {
  // Extract input parameters from the request
  const { name, description, ownershipId } = args.contextData;

  if (!name || name.trim().length === 0) {
    throw new Error("Playlist name is required");
  }

  if (!ownershipId) {
    throw new Error("YouTube Ownership ID is required. Please select a YouTube account.");
  }

  // Get current authenticated user from session
  const actualUser = await args.getUserFromSession();
  if (!actualUser) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Get effective user (handles admin impersonation)
  const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

  // Verify ownership belongs to user
  const ownershipCheck = await args.session.run(`
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
    RETURN o
  `, { userUuid: user.P.uuid, ownershipId });

  if (ownershipCheck.records.length === 0) {
    throw new Error("Invalid YouTube ownership. This account doesn't belong to you or no longer exists.");
  }

  const ownership = args.convertNodeToJson(ownershipCheck.records[0].get('o'));

  // Generate unique playlist ID for custom playlists
  // Use timestamp + random string to ensure uniqueness
  const timestamp = Date.now();
  const randomString = Math.random().toString(36).substring(2, 8);
  const customPlaylistId = `custom_${timestamp}_${randomString}`;

  // Step 1 & 2: Create playlist with ownership relationship in one atomic query
  // NEW ARCHITECTURE: Playlist only contains metadata, user customization goes on PlaylistSetting (created on-demand)
  const playlistKey = `playlist_${customPlaylistId}_${ownershipId}`;

  const createPlaylistWithOwnershipQuery = `
    MATCH (o:YouTubeOwnership {key: $ownershipId})

    // Create playlist with metadata only (no user customization defaults)
    CREATE (p:Playlist {
      key: $key,
      youtubeId: $playlistId,
      title: $title,
      description: $description,
      thumbnail: $thumbnail,
      itemCount: 0,
      isCustom: true,
      createdByUserId: $userId,
      publishedAt: datetime(),
      createdAt: datetime(),
      updatedAt: datetime()
    })

    // Create ownership relationship
    CREATE (o)-[:YouTubeOwnershipPlaylist]->(p)

    RETURN p
  `;

  const result = await args.session.run(createPlaylistWithOwnershipQuery, {
    ownershipId,
    key: playlistKey,
    playlistId: customPlaylistId,
    title: name.trim(),
    description: description?.trim() || "",
    thumbnail: "", // Custom playlists start with no thumbnail
    userId: user.id
  });

  const playlist = args.convertNodeToJson(result.records[0].get('p'));

  return {
    success: true,
    message: `Custom playlist "${name}" created successfully!`,
    data: {
      playlist,
      ownership,
      playlistId: customPlaylistId,
      userId: user.id,
      isCustom: true
    }
  };

} catch (error) {
  console.error("Error creating custom playlist:", error);

  // Handle specific error types
  let userMessage = "Failed to create custom playlist. Please try again.";

  if (error.message.includes("Playlist name is required")) {
    userMessage = "Playlist name is required.";
  } else if (error.message.includes("User session not found")) {
    userMessage = "Please log in to create a custom playlist.";
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    }
  };
}
'''
      }
    }
  ],
  edges: []
}