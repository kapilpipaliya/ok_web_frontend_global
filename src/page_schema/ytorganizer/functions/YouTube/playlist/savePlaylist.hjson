{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Fetches basic playlist metadata using per-ownership OAuth and queues background processing for videos. Supports multi-ownership model where each YouTube account has separate quota.
        body:
          '''
/**
 * Extract playlist ID from various YouTube URL formats
 * Playlist ID is always in the 'list' query parameter
 */
const extractPlaylistId = (url) => {
  if (!url) return null;

  try {
    // Parse URL using built-in URL class
    const urlObj = new URL(url);

    // Check if it's a YouTube domain
    if (!urlObj.hostname.includes('youtube.com')) {
      return null;
    }

    // Get the 'list' query parameter
    const playlistId = urlObj.searchParams.get('list');
    return playlistId;
  } catch (error) {
    // Invalid URL format
    return null;
  }
};

/**
 * Fetch ONLY basic playlist metadata using per-ownership OAuth (no videos)
 * Full processing will be done in background worker
 * Each ownership uses its own YouTube account with its own API quota (10k units/day)
 */
const fetchPlaylistMetadata = async (playlistId, youtube, ownershipId, session) => {
  // Fetch ONLY playlist details (metadata only, no videos)
  const playlistResponse = await youtube.playlists.list({
    part: ['snippet', 'contentDetails', 'status'],
    id: [playlistId]
  });

  // Log API usage: playlists.list operation (1 unit) - shared quota
  await args.logSharedAPIUsage(ownershipId, 'playlists.list', args.YOUTUBE_API_COSTS['playlists.list'], session);

  if (!playlistResponse.data.items || playlistResponse.data.items.length === 0) {
    return null;
  }

  const playlist = playlistResponse.data.items[0];

  return {
    id: playlistId,
    snippet: playlist.snippet,
    status: playlist.status,
    contentDetails: playlist.contentDetails
  };
};

  // Extract input parameters from the request
  const { url, name, channelId, refresh = false, priority = 'normal', ownershipId } = args.contextData;

  if (!url) {
    return {
      success: false,
      message: "Please provide a playlist URL."
    };
  }

  if (!ownershipId) {
    return {
      success: false,
      message: "Please select a YouTube account first. Go to Account Management to connect your YouTube account."
    };
  }

  // Validate priority value
  const validPriorities = ['high', 'normal', 'low'];
  const playlistPriority = validPriorities.includes(priority) ? priority : 'normal';

  // Get current authenticated user from session
  const actualUser = await args.getUserFromSession();
  if (!actualUser) {
    return {
      success: false,
      message: "Your session has expired. Please log in again."
    };
  }

  // Get effective user (handles admin impersonation)
  const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

  // Verify ownership belongs to user and get channel ID
  const ownershipCheck = await args.session.run(`
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
    RETURN o
  `, { userUuid: user.P.uuid, ownershipId });

  if (ownershipCheck.records.length === 0) {
    return {
      success: false,
      message: "The selected YouTube account is invalid or no longer exists. Please select a different account."
    };
  }

  const ownershipNode = ownershipCheck.records[0].get('o');
  const ownership = args.convertNodeToJson(ownershipNode);
  const ownershipChannelId = ownership.P.channelId;

  if (!ownershipChannelId) {
    return {
      success: false,
      message: "YouTube ownership does not have a channel ID. Please reconnect your YouTube account."
    };
  }

  // Extract playlist ID from the provided URL
  let playlistId = extractPlaylistId(url);
  if (!playlistId) {
    return {
      success: false,
      message: "Invalid playlist URL. Please provide a valid YouTube playlist URL."
    };
  }

  // SPECIAL PLAYLIST HANDLING:
  // Some playlists (LL=Liked, WL=Watch Later, UU=Uploads, FL=Favorites, HL=History)
  // have 2-character IDs that are user-specific or channel-specific.
  // We need to make them unique per channel by appending the channelId from YouTubeOwnership
  const isSpecialPlaylist = playlistId.length === 2 && /^(LL|WL|UU|FL|HL)$/.test(playlistId);
  let originalPlaylistId = playlistId; // Store the original ID for API calls

  if (isSpecialPlaylist) {
    // Append channel ID from ownership to make it unique
    playlistId = `${playlistId}_${ownershipChannelId}`;
  }

  // DUPLICATE JOB PREVENTION: Check if this playlist is already queued or processing for this ownership
  // NEW ARCHITECTURE: Status stored directly on Playlist vertex
  // Prevents multiple concurrent jobs for the same playlist which would waste API quota
  // and potentially cause data inconsistencies
  // REFRESH MODE: If refresh=true, skip this check to allow re-processing completed playlists
  if (!refresh) {
    const existingPlaylistResult = await args.session.run(`
      MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
      WHERE p.queueStatus IN ['queued', 'processing']
      RETURN p.youtubeId as playlistId, p.queueStatus as status, p.title as title
    `, { ownershipId, playlistId });

    if (existingPlaylistResult.records.length > 0) {
      const record = existingPlaylistResult.records[0];
      const status = record.get('status');
      const title = record.get('title');

      return {
        success: false,
        message: `Playlist "${title}" is already ${status} for this YouTube account. Please wait for it to complete before adding again. Use refresh=true to force re-processing.`,
        data: {
          playlistId: record.get('playlistId'),
          status: status,
          alreadyExists: true
        }
      };
    }
  }

  // Get authenticated YouTube client for this ownership
  let youtube;
  try {
    youtube = await args.getYouTubeClient(ownershipId, args.session, args.request);
  } catch (error) {
    // Check if this is an OAuth authorization error
    if (error.message.includes('No YouTube authorization') ||
        error.message.includes('revoked') ||
        error.message.includes('reconnect')) {
      return {
        success: false,
        message: "YouTube account not connected. Please connect your YouTube account in settings to add playlists."
      };
    }
    // throw error;
  }
   if (!youtube) {
     return {
       success: false,
       message: "YouTube account not connected. Please connect your YouTube account in settings to add playlists."
     };
   }

  // Fetch ONLY basic playlist metadata using ownership's OAuth (fast operation)
  // Use originalPlaylistId for API calls (special playlists use 2-char IDs in API)
  const playlistData = await fetchPlaylistMetadata(
    isSpecialPlaylist ? originalPlaylistId : playlistId,
    youtube,
    ownershipId,
    args.session
  );

  if (!playlistData) {
    return {
      success: false,
      message: "Playlist not found. Please check the URL and make sure the playlist is public."
    };
  }

  // VALIDATE: If channelId is provided, ensure playlist belongs to that channel
  if (channelId) {
    const playlistChannelId = playlistData.snippet.channelId;
    if (playlistChannelId !== channelId) {
      return {
        success: false,
        message: `This playlist belongs to a different channel. The playlist "${playlistData.snippet.title}" is from channel "${playlistData.snippet.channelTitle}", not from the channel you selected.`
      };
    }
  }

  // Use write transaction for atomicity - prevents race conditions
  const { playlist, channelWasCreated, apiChannelId } = await args.session.executeWrite(async (tx) => {
    // CHECK AGAIN WITHIN TRANSACTION: Prevent duplicate from another tab
    // NEW ARCHITECTURE: Status stored directly on Playlist vertex
    if (!refresh) {
      const existingPlaylistInTx = await tx.run(`
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
        WHERE p.queueStatus IN ['queued', 'processing']
        RETURN p.youtubeId as playlistId, p.queueStatus as status, p.title as title
      `, { ownershipId, playlistId });

      if (existingPlaylistInTx.records.length > 0) {
        const record = existingPlaylistInTx.records[0];
        const status = record.get('status');
        const title = record.get('title');

        return {
          success: false,
          message: `Playlist "${title}" is already ${status} for this YouTube account.`
        };
      }
    }

    // STEP 1-3: Create ownership-specific playlist instance with metadata and queue tracking in single query
    // NEW SCHEMA v4.0: Each ownership has its own playlist instances (duplicate resources per ownership)
    // This ensures complete data isolation between different YouTube accounts
    const playlistKey = `playlist_${playlistId}_${ownershipId}`;

    const mergePlaylistQuery = `
      MATCH (o:YouTubeOwnership {key: $ownershipId})
      MERGE (o)-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
      ON CREATE SET
        p.key = $key,
        p.youtubeId = $playlistId,
        p.createdAt = datetime()
      SET
        p.title = $title,
        p.description = $description,
        p.thumbnail = $thumbnail,
        p.channelTitle = $channelTitle,
        p.channelId = $channelId,
        p.privacyStatus = $privacyStatus,
        p.itemCount = $itemCount,
        p.originalPlaylistId = $originalPlaylistId,
        p.publishedAt = datetime($publishedAt),
        p.updatedAt = datetime(),
        p.priority = $priority,
        p.queueStatus = 'queued',
        p.progress = 0,
        p.totalVideos = 0,
        p.processedVideos = 0,
        p.error = null,
        p.queuedAt = datetime(),
        p.lastUpdated = datetime()
      RETURN p
    `;

    const playlistResult = await tx.run(mergePlaylistQuery, {
      ownershipId,
      key: playlistKey,
      playlistId,
      title: playlistData.snippet.title,
      description: playlistData.snippet.description || "",
      thumbnail: playlistData.snippet.thumbnails?.high?.url ||
                 playlistData.snippet.thumbnails?.medium?.url ||
                 playlistData.snippet.thumbnails?.default?.url || "",
      channelTitle: playlistData.snippet.channelTitle,
      channelId: playlistData.snippet.channelId,
      privacyStatus: playlistData.status?.privacyStatus || "unknown",
      // videoCount cannot come from playlists because playlists can contain videos from anywhere, deleted videos, private videos etc.. reasons
      itemCount: playlistData.contentDetails?.itemCount || 0,
      originalPlaylistId: isSpecialPlaylist ? originalPlaylistId : null,
      publishedAt: playlistData.snippet.publishedAt,
      priority: playlistPriority
    });

    // Extract the Playlist vertex from the result
    const playlistNode = playlistResult.records[0].get('p');
    const playlistVertex = args.convertNodeToJson(playlistNode);

    // Create Channel->Playlist relationship using channel ID from YouTube API
    // This represents YouTube's data model (which channel owns the playlist)
    const apiChannelId = playlistVertex.P.channelId;
    let channelWasCreated = false;
    if (apiChannelId) {
      // Check if channel already exists before MERGE to detect if it's newly created
      const existingChannelCheck = await tx.run(`
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannel]->(c:Channel {youtubeId: $apiChannelId})
        RETURN c
      `, { ownershipId, apiChannelId });

      const channelExists = existingChannelCheck.records.length > 0;

      const channelPlaylistQuery = `
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
        MERGE (o)-[:YouTubeOwnershipChannel]->(c:Channel {youtubeId: $apiChannelId})
        ON CREATE SET
          c.key = 'channel_' + $apiChannelId + '_' + $ownershipId,
          c.youtubeId = $apiChannelId,
          c.createdAt = datetime()
        MERGE (c)-[:ChannelPlaylist]->(p)
      `;
      await tx.run(channelPlaylistQuery, { ownershipId, playlistId, apiChannelId });

      // If channel didn't exist before, it was just created
      if (!channelExists) {
        channelWasCreated = true;
      }
    }

    return { playlist: playlistVertex, channelWasCreated, apiChannelId };
  });

  // If a new Channel was created, call saveChannel to fetch its metadata (but skip playlists)
  if (channelWasCreated && apiChannelId) {
      // Construct channel URL from channelId
      const channelUrl = `https://www.youtube.com/channel/${apiChannelId}`;

      // Call saveChannel with skipPlaylists parameter to avoid processing playlists
      // This ensures channel metadata is saved without triggering playlist processing
      const saveChannelResult = await args.executeNamedServerFunction({
        functionName: 'saveChannel',
        contextData: {
          url: channelUrl,
          ownershipId: ownershipId,
          priority: playlistPriority,
          skipPlaylists: true  // Skip playlist processing when channel is created from playlist
        }
      });
      // Continue with playlist processing even if channel save fails
      if (!saveChannelResult.result || !saveChannelResult.result.success) {
        console.error('Error calling saveChannel for newly created channel:', saveChannelResult.result?.message);
      }
  }

  // STEP 4: Add to background processing queue using BullMQ
  const helpers = await args.executeNamedServerFunction({ functionName: 'queueHelpers', contextData: {} });
  const playlistQueue = helpers.result.data.createPlaylistQueue(args);

  try {
    // Map priority string to BullMQ priority number (lower = higher priority)
    const jobPriority = playlistPriority === 'high' ? 1 : playlistPriority === 'low' ? 3 : 2;

    // DEAD LETTER QUEUE CONFIGURATION:
    // Failed jobs are kept (removeOnFail: false) so admins can inspect errors
    // After 3 retry attempts, the job stays in the failed set for manual review
    // This helps debug YouTube API issues, quota problems, and other failures
    await helpers.result.data.addPlaylistJob(playlistQueue, {
      playlistId,
      userId: user.id,
      userUuid: user.P.uuid,
      ownershipId: ownershipId,  // Required for multi-ownership support
      channelId: channelId || null,
      priority: playlistPriority
    }, {
      priority: jobPriority  // Override default priority
    });
  } finally {
    // Close queue connection
    await playlistQueue.close();
  }

  return {
    success: true,
    message: refresh
      ? `Playlist "${playlistData.snippet.title}" has been queued for refresh. All videos will be re-fetched from YouTube.`
      : `Playlist "${playlistData.snippet.title}" has been queued for processing. This may take a few minutes.`,
    data: {
      playlist: playlist  // Playlist vertex with settings
    }
  };
'''
        key: savePlaylist
      }
    }
  ]
  edges: []
}