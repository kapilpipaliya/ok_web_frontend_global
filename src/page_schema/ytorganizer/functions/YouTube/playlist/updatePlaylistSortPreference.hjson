{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Updates the sort preference and custom order for a user's playlist setting. Supports multi-ownership model - requires ownershipId.
        body:
          '''
// Get the parameters from the context
const { playlistId, sortBy, customOrder, ownershipId } = c;

if (!playlistId || !sortBy) {
  return {
    success: false,
    message: "Playlist ID and sort preference are required"
  };
}

if (!ownershipId) {
  return {
    success: false,
    message: "YouTube Ownership ID is required. Please select a YouTube account."
  };
}

// Get current authenticated user from session
const actualUser = await _.getUserFromSession();
if (!actualUser) {
  return {
    success: false,
    message: "User session not found. Please log in and try again."
  };
}

// Get effective user (handles admin impersonation)
const user = await _.getEffectiveUser(_.session, actualUser, c);

// Verify ownership belongs to user
const ownershipCheck = await _.session.run(`
  MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
  RETURN o
`, { userUuid: user.P.uuid, ownershipId });

if (ownershipCheck.records.length === 0) {
  return {
    success: false,
    message: "Invalid YouTube ownership. This account doesn't belong to you or no longer exists."
  };
}

// Update the playlist setting with new sort preference for specific ownership
// NEW SCHEMA v4.0: Create setting on-demand
const playlistSettingKey = `playlist_setting_${playlistId}_${ownershipId}`;

const updateQuery = `
  MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})

  MERGE (p)-[:PlaylistPlaylistSetting]->(ps:PlaylistSetting {key: $settingKey})
  ON CREATE SET ps.createdAt = datetime()
  MERGE (o)-[:YouTubeOwnershipPlaylistSetting]->(ps)

  SET ps.sortBy = $sortBy,
      ps.customOrder = $customOrder,
      ps.lastUpdated = datetime(),
      ps.updatedAt = datetime()
  RETURN ps
`;

const updateResult = await _.session.run(updateQuery, {
  playlistId: playlistId,
  ownershipId: ownershipId,
  settingKey: playlistSettingKey,
  sortBy: sortBy,
  customOrder: customOrder
});

if (updateResult.records.length === 0) {
  return {
    success: false,
    message: "Playlist setting not found for this ownership"
  };
}

// Fetch updated playlist data with video count using helper function
const fetchResult = await s({
  functionName: "getPlaylistsWithVideoCount",
  contextData: {
    userUuid: user.P.uuid,
    ownershipId,  // Filter by specific ownership
    playlistIds: [playlistId]
  }
});

if (!fetchResult.result || !fetchResult.result.success || fetchResult.result.data.length === 0) {
  return {
    success: false,
    message: "Failed to fetch updated playlist data"
  };
}

const playlistData = fetchResult.result.data[0];

return {
  success: true,
  message: "Sort preference updated successfully",
  data: {
    ...playlistData,
    sortBy: sortBy,
    customOrder: customOrder,
    hasCustomOrder: Array.isArray(customOrder) && customOrder.length > 0
  }
};
'''
        key: updatePlaylistSortPreference
      }
    }
  ]
  edges: []
}