{
  vertexes: [
    {
      id: "update_playlist_setting_function",
      L: "Function",
      P: {
        key: "updatePlaylistSetting",
        description: "Updates playlist setting like custom name. Supports multi-ownership model - requires ownershipId.",
        body: '''
try {
  // Get current authenticated user from session
  const actualUser = await args.getUserFromSession();
  if (!actualUser) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Get effective user (handles admin impersonation)
  const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

  const { youtubeId, customName, ownershipId } = args.contextData;

  if (!youtubeId) {
    throw new Error("Playlist ID is required");
  }

  if (!ownershipId) {
    throw new Error("YouTube Ownership ID is required. Please select a YouTube account.");
  }

  // Verify ownership belongs to user
  const ownershipCheck = await args.session.run(`
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
    RETURN o
  `, { userUuid: user.P.uuid, ownershipId });

  if (ownershipCheck.records.length === 0) {
    throw new Error("Invalid YouTube ownership. This account doesn't belong to you or no longer exists.");
  }

  // Step 1: Update PlaylistSetting for specific ownership
  // NEW SCHEMA v4.0: Create setting on-demand if custom name is provided
  const playlistSettingKey = `playlist_setting_${youtubeId}_${ownershipId}`;

  const updateQuery = `
    MATCH (o:YouTubeOwnership {key: $ownershipId})
    MATCH (o)-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $youtubeId})

    // Create or update PlaylistSetting only if custom name is provided
    CALL apoc.do.when(
      $customName IS NOT NULL,
      '
        MERGE (p)-[:PlaylistPlaylistSetting]->(ps:PlaylistSetting {key: $settingKey})
        ON CREATE SET ps.createdAt = datetime()
        MERGE (o)-[:YouTubeOwnershipPlaylistSetting]->(ps)
        SET ps.customName = $customName, ps.updatedAt = datetime()
        RETURN p.youtubeId as youtubeId
      ',
      '
        OPTIONAL MATCH (p)-[:PlaylistPlaylistSetting]->(ps:PlaylistSetting)<-[:YouTubeOwnershipPlaylistSetting]-(o)
        WITH p, ps
        WHERE ps IS NOT NULL
        DELETE ps
        RETURN p.youtubeId as youtubeId
      ',
      {p: p, o: o, customName: $customName, settingKey: $settingKey}
    ) YIELD value
    RETURN value.youtubeId as youtubeId
  `;

  const updateResult = await args.session.run(updateQuery, {
    ownershipId,
    youtubeId,
    customName: customName || null,
    settingKey: playlistSettingKey
  });

  if (updateResult.records.length === 0) {
    throw new Error("Playlist not found");
  }

  // Step 2: Fetch updated playlist with video count using helper function
  const fetchResult = await args.executeNamedServerFunction({
    functionName: "getPlaylistsWithVideoCount",
    contextData: {
      userUuid: user.P.uuid,
      ownershipId,  // Filter by specific ownership
      playlistIds: [youtubeId]
    }
  });

  if (!fetchResult.result || !fetchResult.result.success || fetchResult.result.data.length === 0) {
    throw new Error("Failed to fetch updated playlist data");
  }

  const playlistData = fetchResult.result.data[0];

  return {
    success: true,
    message: "Playlist setting updated successfully",
    data: playlistData
  };

} catch (error) {
  console.error("Error updating playlist setting:", error);

  let userMessage = "Failed to update playlist setting. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to update playlist setting.";
  } else if (error.message.includes("Playlist not found")) {
    userMessage = "Playlist not found.";
  } else if (error.message.includes("Playlist ID is required")) {
    userMessage = "Playlist ID is required.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "UpdateError",
      details: error.message
    }
  };
}
'''
      }
    }
  ],
  edges: []
}
