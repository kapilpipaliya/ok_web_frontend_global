{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Updates playlist setting like custom name, isPublic, and allowUnauthenticatedAccess. Supports multi-ownership model - requires ownershipId.
        body:
          '''
// Get current authenticated user from session
const actualUser = await args.getUserFromSession();
if (!actualUser) {
  return {
    success: false,
    message: "Please log in to update playlist setting."
  };
}

// Get effective user (handles admin impersonation)
const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

const { youtubeId, customName, ownershipId, isPublic, allowUnauthenticatedAccess } = args.contextData;

if (!youtubeId) {
  return {
    success: false,
    message: "Playlist ID is required."
  };
}

if (!ownershipId) {
  return {
    success: false,
    message: "YouTube Ownership ID is required. Please select a YouTube account."
  };
}

// Verify ownership belongs to user
const ownershipCheck = await args.session.run(`
  MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
  RETURN o
`, { userUuid: user.P.uuid, ownershipId });

if (ownershipCheck.records.length === 0) {
  return {
    success: false,
    message: "Invalid YouTube ownership. This account doesn't belong to you or no longer exists."
  };
}

// Step 1: Update Playlist public settings if provided
const playlistSettingKey = `playlist_setting_${youtubeId}_${ownershipId}`;

// Update Playlist public settings only if isPublic or allowUnauthenticatedAccess is provided
if (isPublic !== undefined || allowUnauthenticatedAccess !== undefined) {
  const updatePublicSettingsQuery = `
    MATCH (o:YouTubeOwnership {key: $ownershipId})
    MATCH (o)-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $youtubeId})
    SET p.isPublic = COALESCE($isPublic, p.isPublic),
        p.allowUnauthenticatedAccess = CASE 
          WHEN $isPublic = false THEN false
          WHEN $isPublic = true THEN COALESCE($allowUnauthenticatedAccess, p.allowUnauthenticatedAccess, false)
          ELSE COALESCE($allowUnauthenticatedAccess, p.allowUnauthenticatedAccess, false)
        END
    RETURN p.youtubeId as youtubeId
  `;

  const updatePublicResult = await args.session.run(updatePublicSettingsQuery, {
    ownershipId,
    youtubeId,
    isPublic: isPublic !== undefined ? isPublic : null,
    allowUnauthenticatedAccess: allowUnauthenticatedAccess !== undefined ? allowUnauthenticatedAccess : null
  });

  if (updatePublicResult.records.length === 0) {
    return {
      success: false,
      message: "Playlist not found."
    };
  }
} else {
  // Verify playlist exists if we're not updating public settings
  const playlistCheck = await args.session.run(`
    MATCH (o:YouTubeOwnership {key: $ownershipId})
    MATCH (o)-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $youtubeId})
    RETURN p.youtubeId as youtubeId
  `, { ownershipId, youtubeId });

  if (playlistCheck.records.length === 0) {
    return {
      success: false,
      message: "Playlist not found."
    };
  }
}

// Step 2: Handle PlaylistSetting (custom name) - create/update or delete
if (customName !== null && customName !== undefined) {
  // Create or update PlaylistSetting
  const createOrUpdateSettingQuery = `
    MATCH (o:YouTubeOwnership {key: $ownershipId})
    MATCH (o)-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $youtubeId})
    MERGE (p)-[:PlaylistPlaylistSetting]->(ps:PlaylistSetting {key: $settingKey})
    ON CREATE SET ps.createdAt = datetime()
    MERGE (o)-[:YouTubeOwnershipPlaylistSetting]->(ps)
    SET ps.customName = $customName, ps.updatedAt = datetime()
    RETURN p.youtubeId as youtubeId
  `;

  await args.session.run(createOrUpdateSettingQuery, {
    ownershipId,
    youtubeId,
    customName,
    settingKey: playlistSettingKey
  });
} else {
  // Delete PlaylistSetting if it exists
  const deleteSettingQuery = `
    MATCH (o:YouTubeOwnership {key: $ownershipId})
    MATCH (o)-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $youtubeId})
    OPTIONAL MATCH (p)-[:PlaylistPlaylistSetting]->(ps:PlaylistSetting)<-[:YouTubeOwnershipPlaylistSetting]-(o)
    WHERE ps IS NOT NULL
    DELETE ps
    RETURN p.youtubeId as youtubeId
  `;

  await args.session.run(deleteSettingQuery, {
    ownershipId,
    youtubeId
  });
}

// Step 3: Fetch updated playlist with video count using helper function
const fetchResult = await args.executeNamedServerFunction({
  functionName: "getPlaylistsWithVideoCount",
  contextData: {
    userUuid: user.P.uuid,
    ownershipId,  // Filter by specific ownership
    playlistIds: [youtubeId]
  }
});

if (!fetchResult.result || !fetchResult.result.success || fetchResult.result.data.length === 0) {
  return {
    success: false,
    message: "Failed to fetch updated playlist data"
  };
}

const playlistData = fetchResult.result.data[0];

return {
  success: true,
  message: "Playlist setting updated successfully",
  data: playlistData
};
'''
        key: updatePlaylistSetting
      }
    }
  ]
  edges: []
}