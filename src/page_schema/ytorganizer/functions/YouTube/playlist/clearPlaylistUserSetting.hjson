{
  vertexes: [
    {
      id: "clear_playlist_user_setting_function",
      L: "Function",
      P: {
        key: "clearPlaylistUserSetting",
        description: "Clears all user-specific setting for a playlist including custom name, sort preferences, and display preferences",
        body: '''
// Get the playlist ID and ownershipId from the context
const { playlistId, ownershipId } = args.contextData;

if (!playlistId) {
  throw new Error("Playlist ID is required");
}

if (!ownershipId) {
  throw new Error("YouTube Ownership ID is required. Please select a YouTube account.");
}

try {
  // Get current authenticated user from session
  const actualUser = await args.getUserFromSession();
  if (!actualUser) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Get effective user (handles admin impersonation)
  const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

  // Verify ownership belongs to user
  const ownershipCheck = await args.session.run(`
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
    RETURN o
  `, { userUuid: user.P.uuid, ownershipId });

  if (ownershipCheck.records.length === 0) {
    throw new Error("Invalid YouTube ownership. This account doesn't belong to you or no longer exists.");
  }

  const ownership = args.convertNodeToJson(ownershipCheck.records[0].get('o'));

  // Check if the playlist exists and ownership has access to it
  // NEW SCHEMA v4.0: Direct ownership + optional settings (verify ownership first)
  const playlistQuery = `
    MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
    OPTIONAL MATCH (p)-[:PlaylistPlaylistSetting]->(ps:PlaylistSetting)<-[:YouTubeOwnershipPlaylistSetting]-(o)
    RETURN p, ps
  `;

  const playlistResult = await args.session.run(playlistQuery, {
    playlistId: playlistId,
    ownershipId
  });

  if (playlistResult.records.length === 0) {
    throw new Error("Playlist not found or you don't have access to it");
  }

  const record = playlistResult.records[0];
  const playlist = record.get('p');
  const playlistSetting = record.get('ps');

  if (!playlistSetting) {
    return {
      success: true,
      message: "No user setting found for this playlist",
      data: {
        playlistId: playlistId,
        settingCleared: false
      }
    };
  }

  // Delete the PlaylistSetting instead of resetting
  // NEW SCHEMA v4.0: Settings are optional and should be deleted if no longer needed
  const deleteQuery = `
    MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
    OPTIONAL MATCH (p)-[:PlaylistPlaylistSetting]->(ps:PlaylistSetting)<-[:YouTubeOwnershipPlaylistSetting]-(o)
    WITH ps
    WHERE ps IS NOT NULL
    DETACH DELETE ps
    RETURN count(ps) as deletedCount
  `;

  const deleteResult = await args.session.run(deleteQuery, {
    playlistId: playlistId,
    ownershipId
  });

  const deletedCountRaw = deleteResult.records[0]?.get('deletedCount');
  const deletedCount = deletedCountRaw ? (typeof deletedCountRaw.toNumber === 'function' ? deletedCountRaw.toNumber() : Number(deletedCountRaw)) : 0;

  return {
    success: true,
    message: deletedCount > 0 ? "Playlist setting have been cleared" : "No user setting found for this playlist",
    data: {
      playlistId: playlistId,
      settingCleared: deletedCount > 0,
      deletedCount: deletedCount
    }
  };

} catch (error) {
  console.error('Error clearing playlist user setting:', error);
  throw new Error(`Failed to clear playlist setting: ${error.message}`);
}
'''
      }
    }
  ],
  edges: []
}