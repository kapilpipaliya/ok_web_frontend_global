{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Helper function to fetch playlists with video counts for a user. Supports multi-ownership model with optional ownership filtering. Supports public access mode to return only public playlists.
        body:
          '''
/**
 * Get Playlists with Video Counts - Multi-Ownership Support
 *
 * Parameters (via args.contextData):
 * - userUuid: string (required) - User UUID
 * - ownershipId: string (optional) - Filter by specific YouTube ownership. If omitted, returns playlists across all ownerships.
 * - playlistIds: string[] (optional) - Filter by specific playlist IDs
 * - statusFilter: string[] (optional) - Filter by status values (e.g., ['queued', 'processing'])
 * - isFavouriteOnly: boolean (optional) - Filter to only favourite playlists (default: false)
 * - customFilter: string (optional) - Custom WHERE clause condition (e.g., 'p.title =~ $pattern OR ps.customName =~ $pattern')
 * - customFilterParams: object (optional) - Parameters for the custom filter (e.g., {pattern: '(?i).*search.*'})
 * - orderBy: string (optional) - Field to order by (default: 'ps.createdAt')
 *   Allowed values: 'ps.createdAt', 'ps.updatedAt', 'ps.lastUpdated', 'ps.favouritedAt',
 *                   'p.title', 'p.publishedAt', 'p.itemCount', 'videoCount'
 * - orderDirection: string (optional) - Order direction 'ASC' or 'DESC' (default: 'DESC')
 * - secondaryOrderBy: string (optional) - Secondary sort field (e.g., 'p.title ASC')
 * - limit: number (optional) - Maximum number of results to return
 * - skip: number (optional) - Number of results to skip (for pagination)
 *
 * Returns:
 * - Array of {playlist: Vertex, playlistSetting: Vertex, channel: Vertex|null, ownership: Vertex} with videoCount in playlistSetting.P
 */
  const {
    userUuid,
    ownershipId = null,  // Optional: filter by specific ownership
    playlistIds = [],
    statusFilter = [],
    isFavouriteOnly = false,
    customFilter = '',
    customFilterParams = {},
    orderBy = 'ps.createdAt',
    orderDirection = 'DESC',
    secondaryOrderBy = null,  // Optional: secondary sort
    limit = null,
    skip = 0,
    isPublicAccess = false  // Public access mode - only return playlists from public channels
  } = args.contextData;

  if (!userUuid) {
    return {
      success: false,
      message: "User UUID is required",
      data: []
    };
  }

  // Build WHERE clause for playlist IDs if provided
  const playlistIdFilter = playlistIds.length > 0
    ? 'AND p.youtubeId IN $playlistIds'
    : '';

  // Build WHERE clause for queue status filter if provided
  // NEW ARCHITECTURE: Queue status on Playlist vertex
  const statusFilterClause = statusFilter.length > 0
    ? 'AND p.queueStatus IN $statusFilter'
    : '';

  // Build WHERE clause for favourite filter if provided
  // Note: ps is from OPTIONAL MATCH, so we need to check it's not null
  const favouriteFilterClause = isFavouriteOnly
    ? 'AND ps IS NOT NULL AND ps.isFavourite = true'
    : '';

  // Build custom filter clause if provided
  const customFilterClause = customFilter ? `AND (${customFilter})` : '';

  // Build public access filter - only return public playlists
  const publicAccessFilter = isPublicAccess
    ? 'AND p.isPublic = true'
    : '';

  // Validate and build ORDER BY clause with secondary sort support
  // Allowed fields for ordering
  const allowedOrderFields = [
    'ps.createdAt', 'ps.updatedAt', 'ps.lastUpdated', 'ps.favouritedAt',
    'p.title', 'p.publishedAt', 'p.itemCount',
    'videoCount'
  ];

  let orderByClause = 'ps.createdAt DESC'; // Default

  if (orderBy && allowedOrderFields.includes(orderBy)) {
    const direction = (orderDirection || 'DESC').toUpperCase();
    if (direction === 'ASC' || direction === 'DESC') {
      orderByClause = `${orderBy} ${direction}`;

      // Add secondary sort if provided
      if (secondaryOrderBy) {
        orderByClause += `, ${secondaryOrderBy}`;
      }
    }
  }

  // Build SKIP and LIMIT clauses
  const skipClause = skip > 0 ? `SKIP ${skip}` : '';
  const limitClause = limit ? `LIMIT ${limit}` : '';

  // Build ownership filter - optional but changes query structure
  const ownershipMatchClause = ownershipId
    ? 'MATCH (u)-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})'
    : 'MATCH (u)-[:UserYouTubeOwnership]->(o:YouTubeOwnership)';

  // Cypher query to fetch playlists with video counts through ownership
  // NEW SCHEMA v4.0: Direct ownership + optional settings + global playlist membership
  const query = `
    MATCH (u:User {uuid: $userUuid})
    ${ownershipMatchClause}
    MATCH (o)-[:YouTubeOwnershipPlaylist]->(p:Playlist)
    WHERE 1=1 ${playlistIdFilter} ${statusFilterClause}

    // Optional PlaylistSetting (only exists if user has custom preferences)
    OPTIONAL MATCH (p)-[:PlaylistPlaylistSetting]->(ps:PlaylistSetting)<-[:YouTubeOwnershipPlaylistSetting]-(o)

    // NEW SCHEMA v4.0: Verify channel ownership for defensive safety
    OPTIONAL MATCH (o)-[:YouTubeOwnershipChannel]->(c:Channel)-[:ChannelPlaylist]->(p)

    // Count videos through global Playlist->Video relationship
    OPTIONAL MATCH (p)-[:PlaylistVideo]->(v:Video)

    WITH p, ps, c, o, COUNT(DISTINCT CASE WHEN v IS NOT NULL THEN v END) as videoCount
    WHERE 1=1 ${favouriteFilterClause} ${customFilterClause} ${publicAccessFilter}

    RETURN p, ps, c, o, videoCount
    ORDER BY ${orderByClause}
    ${skipClause}
    ${limitClause}
  `;

  // Execute the query
  const result = await args.session.run(query, {
    userUuid,
    ownershipId,
    playlistIds,
    statusFilter,
    ...customFilterParams
  });

  // Convert results to JSON format
  const playlists = result.records.map((record) => {
    // Handle optional PlaylistSetting (might be null if user hasn't customized)
    const playlistSettingNode = record.get('ps');
    const playlistSetting = playlistSettingNode ? args.convertNodeToJson(playlistSettingNode) : null;
    const videoCount = record.get('videoCount');
    const ownership = args.convertNodeToJson(record.get('o'));
    const playlist = args.convertNodeToJson(record.get('p'));
    playlist.P.itemCount = videoCount ? (typeof videoCount.toNumber === 'function' ? videoCount.toNumber() : Number(videoCount)) : 0;

    return {
      playlist,
      playlistSetting,
      channel: record.get('c') ? args.convertNodeToJson(record.get('c')) : null,
      ownership
    };
  });

  return {
    success: true,
    data: playlists
  };
'''
        key: getPlaylistsWithVideoCount
      }
    }
  ]
  edges: []
}