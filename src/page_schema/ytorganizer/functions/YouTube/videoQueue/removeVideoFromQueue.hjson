{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Remove a video from the queue at a specific position and reorder remaining videos
        body:
          '''
// Get current authenticated user from session
const actualUser = await _.getUserFromSession(_.request);
if (!actualUser) {
  return {
    success: false,
    message: "User session not found. Please log in and try again.",
  };
}

// Get effective user (handles admin impersonation)
const user = await _.getEffectiveUser(_.session, actualUser, c);

// Get ownershipId and position from contextData
const { ownershipId, position } = c;

if (!ownershipId) {
  return {
    success: false,
    message: "YouTube Ownership ID is required. Please select a YouTube account.",
  };
}

if (position === undefined || position === null || position < 0) {
  return {
    success: false,
    message: "Valid position is required",
  };
}

// Verify ownership belongs to user
const ownershipCheck = await _.session.run(`
  MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
  RETURN o
`, {
  userUuid: user.P.uuid,
  ownershipId
});

if (ownershipCheck.records.length === 0) {
  return {
    success: false,
    message: "YouTube ownership not found or access denied",
  };
}

// Delete the video at the specified position
await _.session.run(`
  MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipVideoQueue]->(vq:VideoQueue)
  WHERE vq.position = $position
  DETACH DELETE vq
`, {
  ownershipId,
  position
});

// Reorder remaining videos (decrement positions greater than deleted position)
await _.session.run(`
  MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipVideoQueue]->(vq:VideoQueue)
  WHERE vq.position > $position
  SET vq.position = vq.position - 1, vq.updatedAt = datetime()
`, {
  ownershipId,
  position
});

// Return updated queue
const queueResult = await _.session.run(`
  MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipVideoQueue]->(vq:VideoQueue)-[:VideoQueueVideo]->(v:Video)
  RETURN v
  ORDER BY vq.position ASC
`, {
  ownershipId
});

const queue = queueResult.records.map(record => {
  return _.convertNodeToJson(record.get('v'));
});

return {
  success: true,
  message: "Removed from queue",
  data: queue
};
'''
        key: removeVideoFromQueue
      }
    }
  ]
  edges: []
}