{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Load video queue from database for the current ownership
        body:
          '''
// Get current authenticated user from session
const actualUser = await _.getUserFromSession(_.request);
if (!actualUser) {
  return {
    success: false,
    message: "User session not found. Please log in and try again.",
  };
}

// Get effective user (handles admin impersonation)
const user = await _.getEffectiveUser(_.session, actualUser, c);

// Get ownershipId from contextData
const { ownershipId } = c;

if (!ownershipId) {
  return {
    success: false,
    message: "YouTube Ownership ID is required. Please select a YouTube account.",
  };
}

// Verify ownership belongs to user
const ownershipCheck = await _.session.run(`
  MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
  RETURN o
`, {
  userUuid: user.P.uuid,
  ownershipId
});

if (ownershipCheck.records.length === 0) {
  return {
    success: false,
    message: "YouTube ownership not found or access denied",
  };
}

// Load queue from database ordered by position
const queueResult = await _.session.run(`
  MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipVideoQueue]->(vq:VideoQueue)-[:VideoQueueVideo]->(v:Video)
  RETURN vq, v
  ORDER BY vq.position ASC
`, {
  ownershipId
});

// Convert to vertex format
const queue = queueResult.records.map(record => {
  return _.convertNodeToJson(record.get('v'));
});

return {
  success: true,
  message: `Loaded ${queue.length} videos from queue`,
  data: queue
};
'''
        key: loadVideoQueue
      }
    }
  ]
  edges: []
}