{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Fetches basic channel metadata using per-ownership OAuth and queues background processing for playlists and videos. Supports multi-ownership model where each YouTube account has separate quota.
        body:
          '''
/**
 * Extract channel ID or identifier from various YouTube URL formats
 * Supports: /channel/ID, /@handle, /c/custom, /user/username
 * Returns: { type: 'handle' | 'channelId' | 'username' | 'custom', value: string }
 */
const extractChannelId = (url) => {
  if (!url) return null;

  try {
    // Parse URL using built-in URL class for better reliability
    const urlObj = new URL(url);

    // Check if it's a YouTube domain
    if (!urlObj.hostname.includes('youtube.com')) {
      return null;
    }

    const pathname = urlObj.pathname;
    const parts = pathname.split('/').filter(Boolean); // Remove empty strings

    if (parts.length === 0) return null;

    // Handle format: /@channelname
    if (parts[0].startsWith('@')) {
      return { type: 'handle', value: parts[0].substring(1) };
    }

    // Need at least 2 parts for other formats: /type/value
    if (parts.length < 2) return null;

    // Channel ID format: /channel/UCxxx
    if (parts[0] === 'channel') {
      const channelId = parts[1];
      // Validate that it's a proper channel ID (starts with UC and is ~24 chars)
      // If not, it might be a malformed URL - treat as custom URL instead
      if (channelId.startsWith('UC') && channelId.length >= 20) {
        return { type: 'channelId', value: channelId };
      } else {
        // Malformed /channel/XXX URL where XXX is not a valid ID
        // Treat it as a custom URL (e.g., /channel/ASKUMARALA -> /c/ASKUMARALA)
        return { type: 'custom', value: channelId };
      }
    }

    // Legacy user format: /user/username
    if (parts[0] === 'user') {
      return { type: 'username', value: parts[1] };
    }

    // Custom URL format: /c/customname
    if (parts[0] === 'c') {
      return { type: 'custom', value: parts[1] };
    }

    return null;
  } catch (error) {
    // Invalid URL format
    return null;
  }
};

/**
 * Fetch ONLY basic channel metadata using per-ownership OAuth
 * Each ownership uses its own YouTube account with its own API quota (10k units/day)
 */
const fetchChannelMetadata = async (channelInfo, youtube, ownershipId, session) => {
  let channelResponse;

  // Resolve channel identifier to actual channel ID using efficient API calls
  if (channelInfo.type === 'handle') {
    // Use forHandle parameter (1 unit) for modern YouTube handles (@channelname)
    channelResponse = await youtube.channels.list({
      part: ['snippet', 'contentDetails', 'statistics', 'brandingSettings'],
      forHandle: channelInfo.value
    });

    // Log API usage: channels.list with forHandle (1 unit) - shared quota
    await args.logSharedAPIUsage(ownershipId, 'channels.list', args.YOUTUBE_API_COSTS['channels.list'], session);
  } else if (channelInfo.type === 'channelId') {
    // Direct channel ID lookup (/channel/UCxxx)
    channelResponse = await youtube.channels.list({
      part: ['snippet', 'contentDetails', 'statistics', 'brandingSettings'],
      id: [channelInfo.value]
    });

    // Log API usage: channels.list operation (1 unit) - shared quota
    await args.logSharedAPIUsage(ownershipId, 'channels.list', args.YOUTUBE_API_COSTS['channels.list'], session);
  } else if (channelInfo.type === 'username') {
    // Legacy username format (/user/username)
    channelResponse = await youtube.channels.list({
      part: ['snippet', 'contentDetails', 'statistics', 'brandingSettings'],
      forUsername: channelInfo.value
    });

    // Log API usage: channels.list with forUsername (1 unit) - shared quota
    await args.logSharedAPIUsage(ownershipId, 'channels.list', args.YOUTUBE_API_COSTS['channels.list'], session);
  } else if (channelInfo.type === 'custom') {
    // Custom URL format (/c/customname) or malformed /channel/ URL
    // YouTube API doesn't support custom URLs directly
    const suggestion = channelInfo.value ? `youtube.com/@${channelInfo.value}` : 'youtube.com/@channelname';
    throw new Error(`Custom URL format is not supported. Please use the @handle URL format instead: ${suggestion}\n\nTo find the correct URL, visit the channel page and copy the URL from the address bar.`);
  }

  if (!channelResponse.data.items || channelResponse.data.items.length === 0) {
    throw new Error('Channel not found or is private/deleted');
  }

  const channel = channelResponse.data.items[0];

  return {
    id: channel.id,
    snippet: channel.snippet,
    statistics: channel.statistics,
    contentDetails: channel.contentDetails,
    brandingSettings: channel.brandingSettings
  };
};

try {
  // Extract input parameters from the request
  const { url, name, refresh = false, priority = 'normal', ownershipId } = args.contextData;

  if (!url) {
    throw new Error("Channel URL is required");
  }

  if (!ownershipId) {
    throw new Error("YouTube Ownership ID is required. Please select a YouTube account.");
  }

  // Validate priority value
  const validPriorities = ['high', 'normal', 'low'];
  const channelPriority = validPriorities.includes(priority) ? priority : 'normal';

  // Get current authenticated user from session
  const actualUser = await args.getUserFromSession();
  if (!actualUser) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Get effective user (handles admin impersonation)
  const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

  // Verify ownership belongs to user
  const ownershipCheck = await args.session.run(`
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
    RETURN o
  `, { userUuid: user.P.uuid, ownershipId });

  if (ownershipCheck.records.length === 0) {
    throw new Error("Invalid YouTube ownership. This account doesn't belong to you or no longer exists.");
  }

  // Extract channel identifier from the provided URL
  const channelInfo = extractChannelId(url);
  if (!channelInfo) {
    throw new Error("Invalid YouTube channel URL. Please provide a valid channel URL.");
  }

  // DUPLICATE JOB PREVENTION: Check if this channel is already queued or processing for this ownership
  // NEW ARCHITECTURE: Status stored directly on Channel vertex
  // For handles and usernames, we can't check by ID yet, so we'll check after fetching
  if (!refresh && channelInfo.type === 'channelId') {
    const existingChannelResult = await args.session.run(`
      MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannel]->(c:Channel {youtubeId: $channelId})
      WHERE c.queueStatus IN ['queued', 'processing']
      RETURN c.youtubeId as channelId, c.queueStatus as status, c.title as title
    `, { ownershipId, channelId: channelInfo.value });

    if (existingChannelResult.records.length > 0) {
      const record = existingChannelResult.records[0];
      const status = record.get('status');
      const title = record.get('title');

      return {
        success: false,
        message: `Channel "${title}" is already ${status} for this YouTube account. Please wait for it to complete before adding again. Use refresh=true to force re-processing.`,
        data: {
          channelId: record.get('channelId'),
          status: status,
          alreadyExists: true
        }
      };
    }
  }

  // Get authenticated YouTube client for this ownership
  let youtube;
  try {
    youtube = await args.getYouTubeClient(ownershipId, args.session, args.request);
  } catch (error) {
    // Check if this is an OAuth authorization error
    if (error.message.includes('No YouTube authorization') ||
        error.message.includes('revoked') ||
        error.message.includes('reconnect')) {
      return {
        success: false,
        message: "YouTube account not connected. Please connect your YouTube account in settings to add channels.",
        error: {
          type: "AuthorizationRequired",
          details: error.message,
          action: "connect_youtube"
        }
      };
    }
    throw error;
  }

  // Fetch ONLY basic channel metadata using ownership's OAuth
  const channelData = await fetchChannelMetadata(channelInfo, youtube, ownershipId, args.session);

  // Use write transaction for atomicity - prevents race conditions
  await args.session.executeWrite(async (tx) => {
    // CHECK AGAIN WITHIN TRANSACTION: Prevent duplicate from another tab
    // NEW SCHEMA v4.0: This check happens after we know the actual channelId
    if (!refresh) {
      const existingChannelInTx = await tx.run(`
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannel]->(c:Channel {youtubeId: $channelId})
        WHERE c.queueStatus IN ['queued', 'processing']
        RETURN c.youtubeId as channelId, c.queueStatus as status, c.title as title
      `, { ownershipId, channelId: channelData.id });

      if (existingChannelInTx.records.length > 0) {
        const record = existingChannelInTx.records[0];
        const status = record.get('status');
        const title = record.get('title');

        throw new Error(`Channel "${title}" is already ${status} for this YouTube account.`);
      }
    }

    // STEP 1-3: Create ownership-specific channel instance with metadata and queue tracking in single query
    // NEW SCHEMA v4.0: Each ownership has its own channel instances (duplicate resources per ownership)
    // This ensures complete data isolation between different YouTube accounts
    const channelKey = `channel_${channelData.id}_${ownershipId}`;

    const mergeChannelQuery = `
      MATCH (o:YouTubeOwnership {key: $ownershipId})
      MERGE (o)-[:YouTubeOwnershipChannel]->(c:Channel {youtubeId: $channelId})
      ON CREATE SET
        c.key = $key,
        c.youtubeId = $channelId,
        c.createdAt = datetime()
      SET
        c.title = $title,
        c.description = $description,
        c.thumbnail = $thumbnail,
        c.customUrl = $customUrl,
        c.country = $country,
        c.videoCount = $videoCount,
        c.viewCount = $viewCount,
        c.subscriberCount = $subscriberCount,
        c.uploadsPlaylistId = $uploadsPlaylistId,
        c.publishedAt = datetime($publishedAt),
        c.updatedAt = datetime(),
        c.priority = $priority,
        c.queueStatus = 'queued',
        c.progress = 0,
        c.totalPlaylists = 0,
        c.processedPlaylists = 0,
        c.totalVideos = 0,
        c.processedVideos = 0,
        c.error = null,
        c.queuedAt = datetime()
      RETURN c
    `;

    const channelResult = await tx.run(mergeChannelQuery, {
      ownershipId,
      key: channelKey,
      channelId: channelData.id,
      title: channelData.snippet.title,
      description: channelData.snippet.description || "",
      thumbnail: channelData.snippet.thumbnails?.high?.url ||
                 channelData.snippet.thumbnails?.medium?.url ||
                 channelData.snippet.thumbnails?.default?.url || "",
      customUrl: channelData.snippet.customUrl || "",
      country: channelData.snippet.country || "",
      videoCount: parseInt(channelData.statistics?.videoCount || "0"),
      viewCount: parseInt(channelData.statistics?.viewCount || "0"),
      subscriberCount: parseInt(channelData.statistics?.subscriberCount || "0"),
      uploadsPlaylistId: channelData.contentDetails?.relatedPlaylists?.uploads || "",
      publishedAt: channelData.snippet.publishedAt,
      priority: channelPriority
    });
  });

  // STEP 4: Add to background processing queue using BullMQ
  const helpers = await args.executeNamedServerFunction({ functionName: 'queueHelpers', contextData: {} });
  const channelQueue = helpers.result.data.createChannelQueue(args);

  try {
    // Map priority string to BullMQ priority number (lower = higher priority)
    const jobPriority = channelPriority === 'high' ? 1 : channelPriority === 'low' ? 3 : 2;

    // Queue channel for processing with ownership's OAuth token
    await helpers.result.data.addChannelJob(channelQueue, {
      channelId: channelData.id,
      userId: user.id,
      userUuid: user.P.uuid,
      ownershipId: ownershipId,  // Required for multi-ownership support
      priority: channelPriority
    }, {
      priority: jobPriority  // Override default priority
    });
  } finally {
    // Close queue connection
    await channelQueue.close();
  }

  return {
    success: true,
    message: refresh
      ? `Channel "${channelData.snippet.title}" has been queued for refresh. All data will be re-fetched from YouTube.`
      : `Channel "${channelData.snippet.title}" has been queued for processing. This may take a few minutes.`,
    data: {
      channelId: channelData.id,
      title: channelData.snippet.title,
      queueStatus: 'queued',
      progress: 0,
      subscriberCount: channelData.statistics?.subscriberCount,
      videoCount: channelData.statistics?.videoCount,
      userId: user.id,
      ownershipId: ownershipId,  // Ownership context for multi-account support
      userSpecific: true,
      isRefresh: refresh,
      usesOAuth: true
    }
  };

} catch (error) {
  console.error("Error saving channel:", error);

  // Handle specific YouTube API and OAuth errors
  let userMessage = "Failed to save channel. Please try again.";

  if (error.message.includes("YouTube Ownership ID is required")) {
    userMessage = "Please select a YouTube account first. Go to Account Management to connect your YouTube account.";
  } else if (error.message.includes("Invalid YouTube ownership")) {
    userMessage = "The selected YouTube account is invalid or no longer exists. Please select a different account.";
  } else if (error.message.includes("User session not found")) {
    userMessage = "Your session has expired. Please log in again.";
  } else if (error.message.includes("Channel URL is required")) {
    userMessage = "Please provide a channel URL.";
  } else if (error.message.includes("Channel not found")) {
    userMessage = "Channel not found. Please check the URL and make sure the channel exists.";
  } else if (error.message.includes("Invalid YouTube channel URL")) {
    userMessage = "Invalid channel URL. Please provide a valid YouTube channel URL.";
  } else if (error.message.includes("Custom URL format")) {
    userMessage = error.message; // Use the detailed message about /c/ format
  } else if (error.message.includes("quota")) {
    userMessage = "YouTube API quota exceeded. This resets daily. Please try again tomorrow.";
  } else if (error.message.includes("revoked") || error.message.includes("reconnect")) {
    userMessage = "Your YouTube authorization has expired. Please reconnect your YouTube account in settings.";
  } else if (error.message.includes("No YouTube authorization")) {
    userMessage = "YouTube account not connected. Please connect your YouTube account in settings.";
  } else if (error.message.includes("private")) {
    userMessage = "This channel is private and cannot be accessed.";
  } else if (error.code === 404) {
    userMessage = "Channel not found or has been deleted.";
  } else if (error.code === 403) {
    userMessage = "Access denied. The channel may be private or you may not have permission to access it.";
  } else if (error.code === 401) {
    userMessage = "Authentication failed. Please reconnect your YouTube account in settings.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "YouTubeAPIError",
      details: error.message,
      code: error.code || null
    }
  };
}
'''
        key: saveChannel
      }
    }
  ]
  edges: []
}