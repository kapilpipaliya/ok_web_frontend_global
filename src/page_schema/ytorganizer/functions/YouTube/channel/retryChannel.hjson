{
  vertexes: [
    {
      id: "retry_channel_function",
      L: "Function",
      P: {
        key: "retryChannel",
        description: "Retry a failed or stuck channel processing job",
        body: '''
/**
 * Retry Channel Processing
 *
 * This function allows manual retry of failed or stuck channels
 * Useful for:
 * - Recovering from temporary API failures
 * - Retrying after quota limits are lifted
 * - Fixing stuck jobs that are processing for too long
 * - Re-processing channels after bug fixes
 *
 * IMPORTANT: This resets the channel to 'queued' state and re-adds it to the queue
 * Any partially completed playlists will be re-processed
 */

try {
  const { channelId, ownershipId } = args.contextData;

  if (!channelId) {
    return {
      success: false,
      message: "Channel ID is required",
      error: {
        type: "ValidationError",
        details: "Missing channelId parameter"
      }
    };
  }

  if (!ownershipId) {
    return {
      success: false,
      message: "YouTube account is required. Please ensure you have a connected YouTube account.",
      error: {
        type: "ValidationError",
        details: "Missing ownershipId parameter. The channel must be associated with a YouTube ownership."
      }
    };
  }

  // Get current authenticated user from session
  const actualUser = await args.getUserFromSession();
  if (!actualUser) {
    return {
      success: false,
      message: "User session not found. Please log in and try again.",
      error: {
        type: "AuthenticationError",
        details: "No active user session"
      }
    };
  }

  // Get effective user (handles admin impersonation)
  const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

  // Verify ownership belongs to user
  const ownershipCheck = await args.session.run(`
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
    RETURN o
  `, { userUuid: user.P.uuid, ownershipId });

  if (ownershipCheck.records.length === 0) {
    return {
      success: false,
      message: "Invalid YouTube account. This account doesn't belong to you or no longer exists.",
      error: {
        type: "AuthorizationError",
        details: "YouTube ownership not found or doesn't belong to current user"
      }
    };
  }

  // Check if channel exists and get its current status
  const checkResult = await args.session.run(`
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
    MATCH (o)-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
          -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
    RETURN c, cs
  `, { userUuid: user.P.uuid, ownershipId, channelId });

  if (checkResult.records.length === 0) {
    return {
      success: false,
      message: "Channel not found in your collection"
    };
  }

  const channelSettingNode = checkResult.records[0].get('cs');
  const channelNode = checkResult.records[0].get('c');
  const channelSetting = args.convertNodeToJson(channelSettingNode);
  const channel = args.convertNodeToJson(channelNode);

  const currentStatus = channelSetting.P.status;

  // Prevent retry of channels that are already queued or processing
  if (currentStatus === 'queued' || currentStatus === 'processing') {
    return {
      success: false,
      message: `Channel is already ${currentStatus}. Please wait for it to complete.`,
      data: {
        channelId,
        currentStatus
      }
    };
  }

  // Reset channel status to queued
  // This clears error state and resets progress counters
  await args.session.run(`
    MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
          -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
    SET cs.status = 'queued',
        cs.progress = 0,
        cs.processedPlaylists = 0,
        cs.error = null,
        cs.queuedAt = datetime(),
        cs.updatedAt = datetime()
  `, { ownershipId, channelId });

  // Also reset all playlist setting for this channel to queued
  // This ensures playlists are re-processed even if some were completed before
  await args.session.run(`
    MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
          -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
    MATCH (c)-[:ChannelPlaylist]->(p:Playlist)
    MATCH (o)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p)
    SET ps.status = 'queued',
        ps.progress = 0,
        ps.processedVideos = 0,
        ps.error = null,
        ps.queuedAt = datetime(),
        ps.updatedAt = datetime()
  `, { ownershipId, channelId });

  // Re-add channel to processing queue
  const helpers = await args.executeNamedServerFunction({ functionName: 'queueHelpers', contextData: {} });
  const channelQueue = helpers.result.data.createChannelQueue(args);

  try {
    // Get priority and convert to job priority number
    const priority = channelSetting.P.priority || 'normal';
    const jobPriority = priority === 'high' ? 1 : priority === 'low' ? 3 : 2;

    // Generate unique job ID with ownership context
    const jobId = helpers.result.data.createJobId('channel', ownershipId, channelId);

    // Remove existing job with this ID if it exists (but not if it's active)
    const { removed, state } = await helpers.result.data.removeExistingJob(channelQueue, jobId, ['active']);

    if (state === 'active') {
      return {
        success: false,
        message: `Channel "${channel.P.title}" is already being processed. Please wait for it to complete.`,
        error: {
          type: "AlreadyActive",
          details: "Cannot retry a channel that is currently being processed"
        }
      };
    }

    // Add job to queue
    await helpers.result.data.addChannelJob(channelQueue, {
      channelId,
      userId: user.id,
      userUuid: user.P.uuid,
      ownershipId,  // Required for multi-ownership support
      customName: channelSetting.P.customName || null,
      priority
    }, {
      priority: jobPriority  // Override default priority
    });
  } finally {
    await channelQueue.close();
  }

  return {
    success: true,
    message: `Channel "${channel.P.title}" has been queued for retry. Processing will begin shortly.`,
    data: {
      channelId,
      title: channel.P.title,
      previousStatus: currentStatus,
      newStatus: 'queued'
    }
  };

} catch (error) {
  console.error("Error retrying channel:", error);

  // Provide user-friendly error messages based on error type
  let userMessage = "Failed to retry channel processing. Please try again.";

  if (error.message.includes("quota")) {
    userMessage = "Cannot retry: API quota has been exhausted. Please try again tomorrow.";
  } else if (error.message.includes("authorization") || error.message.includes("OAuth")) {
    userMessage = "Cannot retry: YouTube authorization expired. Please reconnect your YouTube account.";
  } else if (error.message.includes("network") || error.message.includes("ECONNREFUSED")) {
    userMessage = "Network error. Please check your connection and try again.";
  } else if (error.message.includes("Redis") || error.message.includes("queue")) {
    userMessage = "Queue service unavailable. Please try again in a moment.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "RetryChannelError",
      details: error.message,
      stack: process.env.NODE_ENV === 'development' ? error.stack : undefined
    }
  };
}
'''
      }
    }
  ],
  edges: []
}
