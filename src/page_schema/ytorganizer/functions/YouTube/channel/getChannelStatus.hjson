{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Get processing status for a specific channel
        body:
          '''
const { channelId, ownershipId } = args.contextData;

if (!channelId) {
  return {
    success: false,
    message: "Channel ID is required"
  };
}

// Get current authenticated user from session
const actualUser = await args.getUserFromSession();
if (!actualUser) {
  return {
    success: false,
    message: "User session not found"
  };
}

// Get effective user (handles admin impersonation)
const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

// Use helper function to fetch channel with video count
const result = await args.executeNamedServerFunction({
  functionName: "getChannelsWithVideoCount",
  contextData: {
    userUuid: user.P.uuid,
    ownershipId,  // Filter by ownership if provided
    channelIds: [channelId]
  }
});

if (!result.result || !result.result.success || result.result.data.length === 0) {
  return {
    success: false,
    message: "Channel not found"
  };
}

const channelData = result.result.data[0];

return {
  success: true,
  data: {
    channel: channelData.channel,
    channelSetting: channelData.channelSetting,
    ownership: channelData.ownership
  }
};
'''
        key: getChannelStatus
      }
    }
  ]
  edges: []
}