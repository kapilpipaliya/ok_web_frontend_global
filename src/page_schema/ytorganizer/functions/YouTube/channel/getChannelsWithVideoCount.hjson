{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Helper function to fetch channels with video counts for a user. Supports multi-ownership model with optional ownership filtering. Supports public access mode to return only public channels.
        body:
          '''
/**
 * Get Channels with Video Counts - Multi-Ownership Support
 *
 * Parameters (via c):
 * - userUuid: string (required) - User UUID
 * - ownershipId: string (optional) - Filter by specific YouTube ownership. If omitted, returns channels across all ownerships.
 * - channelIds: string[] (optional) - Filter by specific channel IDs
 * - statusFilter: string[] (optional) - Filter by status values (e.g., ['queued', 'processing'])
 * - isFavouriteOnly: boolean (optional) - Filter to only favourite channels (default: false)
 * - customFilter: string (optional) - Custom WHERE clause condition (e.g., 'c.title =~ $pattern OR cs.customName =~ $pattern')
 * - customFilterParams: object (optional) - Parameters for the custom filter (e.g., {pattern: '(?i).*search.*'})
 * - orderBy: string (optional) - Field to order by (default: 'cs.createdAt')
 *   Allowed values: 'cs.createdAt', 'cs.updatedAt', 'cs.favouritedAt', 'c.title',
 *                   'c.publishedAt', 'c.videoCount', 'c.subscriberCount', 'c.viewCount', 'videoCount'
 * - orderDirection: string (optional) - Order direction 'ASC' or 'DESC' (default: 'DESC')
 * - secondaryOrderBy: string (optional) - Secondary sort field (e.g., 'c.title ASC')
 * - limit: number (optional) - Maximum number of results to return
 * - skip: number (optional) - Number of results to skip (for pagination)
 *
 * Returns:
 * - Array of {channel: Vertex, channelSetting: Vertex} with videoCount in channelSetting.P
 */
  const {
    userUuid,
    ownershipId = null,  // Optional: filter by specific ownership
    channelIds = [],
    statusFilter = [],
    isFavouriteOnly = false,
    customFilter = '',
    customFilterParams = {},
    orderBy = 'cs.createdAt',
    orderDirection = 'DESC',
    secondaryOrderBy = null,  // Optional: secondary sort
    limit = null,
    skip = 0,
    isPublicAccess = false  // Public access mode - only return public channels
  } = c;

  if (!userUuid) {
    return {
      success: false,
      message: "User UUID is required",
      data: []
    };
  }

  // Build WHERE clause for channel IDs if provided
  const channelIdFilter = channelIds.length > 0
    ? 'AND c.youtubeId IN $channelIds'
    : '';

  // Build WHERE clause for queue status filter if provided
  // NEW ARCHITECTURE: Queue status on Channel vertex
  const statusFilterClause = statusFilter.length > 0
    ? 'AND c.queueStatus IN $statusFilter'
    : '';

  // Build WHERE clause for favourite filter if provided
  const favouriteFilterClause = isFavouriteOnly
    ? 'AND cs.isFavourite = true'
    : '';

  // Build custom filter clause if provided
  const customFilterClause = customFilter ? `AND (${customFilter})` : '';

  // Build public access filter - only return public channels
  const publicAccessFilter = isPublicAccess
    ? 'AND c.isPublic = true'
    : '';

  // Validate and build ORDER BY clause with secondary sort support
  // Allowed fields for ordering
  const allowedOrderFields = [
    'cs.createdAt', 'cs.updatedAt', 'cs.favouritedAt',
    'c.title', 'c.publishedAt', 'c.videoCount', 'c.subscriberCount', 'c.viewCount',
    'videoCount'
  ];

  let orderByClause = 'cs.createdAt DESC'; // Default

  if (orderBy && allowedOrderFields.includes(orderBy)) {
    const direction = (orderDirection || 'DESC').toUpperCase();
    if (direction === 'ASC' || direction === 'DESC') {
      orderByClause = `${orderBy} ${direction}`;

      // Add secondary sort if provided
      if (secondaryOrderBy) {
        orderByClause += `, ${secondaryOrderBy}`;
      }
    }
  }

  // Build SKIP and LIMIT clauses
  const skipClause = skip > 0 ? `SKIP ${skip}` : '';
  const limitClause = limit ? `LIMIT ${limit}` : '';

  // Build ownership filter - optional but changes query structure
  const ownershipMatchClause = ownershipId
    ? 'MATCH (u)-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})'
    : 'MATCH (u)-[:UserYouTubeOwnership]->(o:YouTubeOwnership)';

  // Cypher query to fetch channels with video counts through ownership
  // NEW SCHEMA v4.0: Direct ownership + optional settings
  const query = `
    MATCH (u:User {uuid: $userUuid})
    ${ownershipMatchClause}
    MATCH (o)-[:YouTubeOwnershipChannel]->(c:Channel)
    WHERE 1=1 ${channelIdFilter} ${statusFilterClause} ${publicAccessFilter}

    // Optional ChannelSetting (only exists if user has custom preferences)
    OPTIONAL MATCH (c)-[:ChannelChannelSetting]->(cs:ChannelSetting)<-[:YouTubeOwnershipChannelSetting]-(o)

    // Count videos through uploads playlist (global playlist membership)
    OPTIONAL MATCH (uploadsPlaylist:Playlist {youtubeId: c.uploadsPlaylistId})
    OPTIONAL MATCH (uploadsPlaylist)-[:PlaylistVideo]->(v:Video)

    WITH c, cs, COUNT(DISTINCT CASE WHEN v IS NOT NULL THEN v END) as videoCount
    WHERE 1=1 ${favouriteFilterClause} ${customFilterClause}

    RETURN c, cs, videoCount
    ORDER BY ${orderByClause}
    ${skipClause}
    ${limitClause}
  `;

  // Execute the query
  const result = await _.session.run(query, {
    userUuid,
    ownershipId,
    channelIds,
    statusFilter,
    ...customFilterParams
  });

  // Convert results to JSON format
  const channels = result.records.map(record => {
    // Handle optional ChannelSetting (might be null if user hasn't customized)
    const channelSettingNode = record.get('cs');
    const channelSetting = channelSettingNode ? _.convertNodeToJson(channelSettingNode) : null;
    const videoCount = record.get('videoCount');
    const channel = _.convertNodeToJson(record.get('c'));

    // Add ownership-specific video count to channel setting if it exists
    channel.P.videoCount = videoCount ? (typeof videoCount.toNumber === 'function' ? videoCount.toNumber() : Number(videoCount)) : 0;

    return {
      channel,
      channelSetting: channelSetting
    };
  });

  return {
    success: true,
    data: channels
  };
'''
        key: getChannelsWithVideoCount
      }
    }
  ]
  edges: []
}