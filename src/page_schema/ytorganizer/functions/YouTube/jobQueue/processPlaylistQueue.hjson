{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Background worker that processes playlists by fetching all videos
        body:
          '''
// This is a background worker function that processes playlists
if (args.contextData.action === 'start') {
  // Helper function to log messages to database
  const logMessage = async (level, message, metadata = {}) => {
    try {
      await args.executeNamedServerFunction({
        functionName: 'logWorkerMessage',
        contextData: {
          workerName: 'processPlaylistQueue',
          level,
          message,
          metadata
        }
      });
    } catch (error) {
      // Silent failure - don't break worker if logging fails
    }
  };

  await logMessage('info', 'Starting playlist processing worker');

  // Initialize queue helpers and Redis connection
  const helpers = await args.executeNamedServerFunction({ functionName: 'queueHelpers', contextData: {} });

  if (!helpers.result?.success) {
    await logMessage('error', 'Failed to initialize queue helpers', { error: helpers.result?.error });
    throw new Error('Queue helpers initialization failed');
  }

  const { Worker } = args.bullmq;
  const connection = helpers.result.data.getRedisConnection();

  // Validate Redis connection config
  if (!connection || !connection.host) {
    await logMessage('error', 'Invalid Redis connection configuration', { connection });
    throw new Error('Invalid Redis connection configuration');
  }

  // Queue all playlists that are marked as 'queued' but not in BullMQ queue
  await logMessage('info', 'Checking for queued playlists to add to queue');

  try {
    const playlistQueue = helpers.result.data.createPlaylistQueue(args);

    // Get all playlists with status 'queued' through ownership
    // This query finds playlists that are queued but may not be in the BullMQ queue
    // (e.g., if worker crashed or application restarted)
    // NEW ARCHITECTURE: Queue status stored directly on Playlist vertex
    const queuedPlaylists = await args.session.run(`
      MATCH (u:User)-[:UserYouTubeOwnership]->(o:YouTubeOwnership)
      MATCH (o)-[:YouTubeOwnershipPlaylist]->(p:Playlist)
      WHERE p.queueStatus = 'queued'
      RETURN u.uuid as userUuid, u.id as userId, o.key as ownershipId, p.youtubeId as playlistId,
             p.priority as priority, p.channelId as channelId,
             p.queuedAt as queuedAt
      ORDER BY p.priority DESC, p.queuedAt ASC
    `);

    let addedCount = 0;
    let skippedCount = 0;

    await logMessage('info', `Found ${queuedPlaylists.records.length} playlists with status='queued' in database`);

    for (const record of queuedPlaylists.records) {
      const userUuid = record.get('userUuid');
      const userId = record.get('userId');
      const ownershipId = record.get('ownershipId');
      const playlistId = record.get('playlistId');
      const priority = record.get('priority') || 'normal';
      const channelId = record.get('channelId');

      // Generate unique job ID with ownership context
      const jobId = helpers.result.data.createJobId('playlist', ownershipId, playlistId);

      // Check if job already exists in waiting state
      const existingJob = await playlistQueue.getJob(jobId);
      const jobState = existingJob ? await existingJob.getState() : null;

      if (!existingJob || jobState !== 'waiting') {
        // Job doesn't exist or is not waiting, add it
        const jobPriority = priority === 'high' ? 1 : priority === 'low' ? 3 : 2;

        await helpers.result.data.addPlaylistJob(playlistQueue, {
          playlistId,
          userId,
          userUuid,
          ownershipId,  // Required for multi-ownership support
          channelId,
          priority
        }, {
          priority: jobPriority
        });

        addedCount++;
        await logMessage('info', `Added playlist to queue`, {
          playlistId,
          ownershipId,
          priority,
          jobId
        });
      } else {
        skippedCount++;
        await logMessage('info', `Skipped playlist - already in queue`, {
          playlistId,
          ownershipId,
          jobState,
          jobId
        });
      }
    }

    await playlistQueue.close();
    await logMessage('info', `Queue initialization complete`, {
      totalFound: queuedPlaylists.records.length,
      addedCount,
      skippedCount
    });
  } catch (error) {
    await logMessage('error', 'Error queuing playlists on startup', {
      error: error.message,
      stack: error.stack
    });
  }

  // Small delay to ensure queue connection is fully closed before creating worker
  await new Promise(resolve => setTimeout(resolve, 100));

  // Create worker for playlist processing queue with error handling
  let worker;
  try {
    await logMessage('info', 'Creating BullMQ Worker for playlist processing');

    worker = new Worker('processPlaylistQueue', async (job) => {
    const { playlistId, userId, userUuid, ownershipId, customName, channelId } = job.data;

    await logMessage('info', 'Processing playlist', { playlistId, userId, ownershipId });

    // Get a new database session for this job
    const session = await args.getSession();

    // Check if this is a special playlist (LL, WL, UU, FL, HL)
    // Special playlists have their channel ID appended to make them unique
    // We need to extract the original 2-char ID for YouTube API calls
    // NEW SCHEMA v4.0: Verify ownership before accessing playlist
    const playlistResult = await session.run(`
      MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
      RETURN p.originalPlaylistId as originalId
    `, { ownershipId, playlistId });

    const originalPlaylistId = playlistResult.records[0]?.get('originalId');

    // Use originalPlaylistId for API calls if this is a special playlist
    const apiPlaylistId = originalPlaylistId || playlistId;

    // Get ownership priority for quota allocation
    const ownershipResult = await session.run(`
      MATCH (o:YouTubeOwnership {key: $ownershipId})
      RETURN COALESCE(o.priority, 0) as priority
    `, { ownershipId });
    const ownershipPriority = ownershipResult.records[0]?.get('priority') || 0;

    // Reserve quota for processing (estimate: ~50 units for large playlist with pagination)
    // Actual usage will be logged as operations complete
    let reservationId = null;
    try {
      reservationId = await args.reserveQuota(
        ownershipId,
        50,  // Estimated quota needed
        ownershipPriority,
        `process_playlist_${playlistId}`,
        session
      );

      await logMessage('info', 'Reserved quota for playlist processing', {
        playlistId,
        ownershipId,
        reservationId,
        estimatedCost: 50
      });
    } catch (error) {
      // QuotaExhaustedError - mark playlist as pending_quota
      if (error.name === 'QuotaExhaustedError') {
        await logMessage('warn', 'Shared quota exhausted, queueing playlist for tomorrow', {
          playlistId,
          ownershipId,
          remainingQuota: error.remainingQuota
        });

        // Mark playlist as pending_quota
        await session.run(`
          MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
          SET p.queueStatus = 'pending_quota',
              p.error = 'Daily API quota exhausted. Will resume tomorrow.',
              p.updatedAt = datetime()
        `, { ownershipId, playlistId });

        await session.close();
        return; // Exit without throwing - job completes but playlist waits for quota reset
      }

      // Other errors
      throw error;
    }

    try {

      // Update status to processing
      await session.run(`
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
        SET p.queueStatus = 'processing',
            p.progress = 0,
            p.updatedAt = datetime()
        RETURN p
      `, { ownershipId, playlistId });

      // Get authenticated YouTube client for this ownership's OAuth
      let youtube;
      try {
        youtube = await args.getYouTubeClient(ownershipId, session, args.request);
      } catch (error) {
        // Handle OAuth errors - mark playlist as failed
        await session.run(`
          MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
          SET p.queueStatus = 'failed',
              p.error = $error,
              p.priority = null,
              p.updatedAt = datetime()
        `, {
          ownershipId,
          playlistId,
          error: error.message.includes('No YouTube authorization') || error.message.includes('revoked')
            ? 'YouTube authorization expired or revoked. Please reconnect your YouTube account in settings.'
            : error.message
        });
        throw error;
      }

      // Fetch ALL playlist videos with pagination
      let allVideos = [];
      let nextPageToken = null;

      do {
        const itemsResponse = await youtube.playlistItems.list({
          part: ['snippet', 'contentDetails'],
          playlistId: apiPlaylistId,  // Use original ID for API calls
          maxResults: 50,
          pageToken: nextPageToken
        });

        // Log API usage: playlistItems.list operation (1 unit per page) - shared quota
        await args.logSharedAPIUsage(ownershipId, 'playlistItems.list', args.YOUTUBE_API_COSTS['playlistItems.list'], session);

        if (itemsResponse.data.items) {
          allVideos = allVideos.concat(itemsResponse.data.items);
        }

        nextPageToken = itemsResponse.data.nextPageToken;
      } while (nextPageToken);

      // Fetch complete video details in batches (50 videos per batch)
      // This provides publishedAt, duration, viewCount, likeCount, commentCount
      const videoIds = allVideos.map(v => v.contentDetails?.videoId).filter(Boolean);
      const videoDetailsMap = new Map();

      console.log(`[Playlist ${playlistId}] Fetching details for ${videoIds.length} videos in batches of 50...`);

      for (let i = 0; i < videoIds.length; i += 50) {
        const batch = videoIds.slice(i, i + 50);

        try {
          const videosResponse = await youtube.videos.list({
            part: ['snippet', 'contentDetails', 'statistics'],
            id: batch
          });

          // Log API usage: videos.list operation (1 unit per batch) - shared quota
          await args.logSharedAPIUsage(ownershipId, 'videos.list', args.YOUTUBE_API_COSTS['videos.list'], session);

          console.log(`[Playlist ${playlistId}] Fetched batch ${Math.floor(i/50) + 1}: ${videosResponse.data.items?.length || 0} videos`);

          // Map video details by ID for quick lookup
          for (const videoDetail of videosResponse.data.items || []) {
            videoDetailsMap.set(videoDetail.id, videoDetail);
          }
        } catch (error) {
          console.error(`[Playlist ${playlistId}] Error fetching video details batch ${Math.floor(i/50) + 1}:`, error.message);
          // Continue processing even if one batch fails
        }
      }

      const totalVideos = allVideos.length;

      // Update total count
      await session.run(`
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
        SET p.totalVideos = $totalVideos,
            p.processedVideos = 0,
            p.updatedAt = datetime()
        RETURN p
      `, { ownershipId, playlistId, totalVideos });

      let processedVideos = 0;

      // Process each video
      for (const video of allVideos) {
        if (!video.contentDetails?.videoId) continue;

        const videoId = video.contentDetails.videoId;

        // Get complete video details from the fetched map
        const videoDetails = videoDetailsMap.get(videoId);

        // Extract ALL fields from video details API response
        // SNIPPET fields
        const publishedAt = videoDetails?.snippet?.publishedAt || null;
        const categoryId = videoDetails?.snippet?.categoryId || null;
        const defaultLanguage = videoDetails?.snippet?.defaultLanguage || null;
        const defaultAudioLanguage = videoDetails?.snippet?.defaultAudioLanguage || null;
        const liveBroadcastContent = videoDetails?.snippet?.liveBroadcastContent || null;
        const tags = videoDetails?.snippet?.tags ? JSON.stringify(videoDetails.snippet.tags) : null;
        const localizedTitle = videoDetails?.snippet?.localized?.title || null;
        const localizedDescription = videoDetails?.snippet?.localized?.description || null;

        // THUMBNAILS - store all available sizes
        const thumbnailDefault = videoDetails?.snippet?.thumbnails?.default?.url || null;
        const thumbnailMedium = videoDetails?.snippet?.thumbnails?.medium?.url || null;
        const thumbnailHigh = videoDetails?.snippet?.thumbnails?.high?.url || null;
        const thumbnailStandard = videoDetails?.snippet?.thumbnails?.standard?.url || null;
        const thumbnailMaxres = videoDetails?.snippet?.thumbnails?.maxres?.url || null;

        // CONTENT DETAILS fields
        const duration = videoDetails?.contentDetails?.duration || null;
        const dimension = videoDetails?.contentDetails?.dimension || null;
        const definition = videoDetails?.contentDetails?.definition || null;
        const caption = videoDetails?.contentDetails?.caption === 'true' || videoDetails?.contentDetails?.caption === true;
        const licensedContent = videoDetails?.contentDetails?.licensedContent || false;
        const projection = videoDetails?.contentDetails?.projection || null;
        const hasCustomThumbnail = videoDetails?.contentDetails?.hasCustomThumbnail || false;

        // STATISTICS fields
        const viewCount = videoDetails?.statistics?.viewCount ? parseInt(videoDetails.statistics.viewCount) : 0;
        const likeCount = videoDetails?.statistics?.likeCount ? parseInt(videoDetails.statistics.likeCount) : 0;
        const favoriteCount = videoDetails?.statistics?.favoriteCount ? parseInt(videoDetails.statistics.favoriteCount) : 0;
        const commentCount = videoDetails?.statistics?.commentCount ? parseInt(videoDetails.statistics.commentCount) : 0;

        // Save ownership-specific video with ALL available details from YouTube API
        // NEW SCHEMA v4.0: Each ownership has its own video instances (duplicate resources per ownership)
        await session.run(`
          MATCH (o:YouTubeOwnership {key: $ownershipId})
          MERGE (o)-[:YouTubeOwnershipVideo]->(v:Video {youtubeId: $videoId})
          ON CREATE SET
            v.key = $key,
            v.createdAt = datetime()
          SET
            v.title = $title,
            v.description = $description,
            v.channelId = $channelId,
            v.channelTitle = $channelTitle,
            v.publishedAt = CASE WHEN $publishedAt IS NOT NULL THEN datetime($publishedAt) ELSE null END,
            v.categoryId = $categoryId,
            v.defaultLanguage = $defaultLanguage,
            v.defaultAudioLanguage = $defaultAudioLanguage,
            v.liveBroadcastContent = $liveBroadcastContent,
            v.tags = $tags,
            v.localizedTitle = $localizedTitle,
            v.localizedDescription = $localizedDescription,
            v.thumbnailDefault = $thumbnailDefault,
            v.thumbnailMedium = $thumbnailMedium,
            v.thumbnailHigh = $thumbnailHigh,
            v.thumbnailStandard = $thumbnailStandard,
            v.thumbnailMaxres = $thumbnailMaxres,
            v.duration = CASE WHEN $duration IS NOT NULL THEN duration($duration) ELSE null END,
            v.dimension = $dimension,
            v.definition = $definition,
            v.caption = $caption,
            v.licensedContent = $licensedContent,
            v.projection = $projection,
            v.hasCustomThumbnail = $hasCustomThumbnail,
            v.viewCount = $viewCount,
            v.likeCount = $likeCount,
            v.favoriteCount = $favoriteCount,
            v.commentCount = $commentCount,
            v.updatedAt = datetime()
        `, {
          ownershipId,
          videoId,
          key: `video_${videoId}_${ownershipId}`,
          title: video.snippet?.title || '',
          description: video.snippet?.description || '',
          channelId: video.snippet?.channelId || channelId || '',
          channelTitle: video.snippet?.channelTitle || '',
          publishedAt,
          categoryId,
          defaultLanguage,
          defaultAudioLanguage,
          liveBroadcastContent,
          tags,
          localizedTitle,
          localizedDescription,
          thumbnailDefault,
          thumbnailMedium,
          thumbnailHigh,
          thumbnailStandard,
          thumbnailMaxres,
          duration,
          dimension,
          definition,
          caption,
          licensedContent,
          projection,
          hasCustomThumbnail,
          viewCount,
          likeCount,
          favoriteCount,
          commentCount
        });

        // CORRECTED SCHEMA:
        // 1. Create ownership-level VideoSetting (global setting: watched, notes, favourites)
        // 2. Create PlaylistSetting->Video relationship (per-ownership playlist membership)

        // NEW ARCHITECTURE: Video properties stored directly on Video vertex (no VideoSetting)
        // Don't set default values (watched=false, note=null, isFavourite=false)
        // These will be set only when user explicitly changes them

        // Create Playlist->Video relationship (playlist membership, verify video ownership)
        // This is the PlaylistVideo relationship that tracks which videos are in which playlists
        await session.run(`
          MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
          MATCH (o)-[:YouTubeOwnershipVideo]->(v:Video {youtubeId: $videoId})
          MERGE (p)-[r:PlaylistVideo]->(v)
          ON CREATE SET
            r.createdAt = datetime(),
            r.position = $position,
            r.playlistIndex = $position
          SET
            r.updatedAt = datetime()
        `, {
          ownershipId,
          playlistId,
          videoId,
          position: video.snippet?.position || 0
        });

        processedVideos++;

        // Update progress every 10 videos or on last video
        if (processedVideos % 10 === 0 || processedVideos === totalVideos) {
          const progress = Math.round((processedVideos / totalVideos) * 100);

          await session.run(`
            MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
            SET p.processedVideos = $processedVideos,
                p.progress = $progress,
                p.updatedAt = datetime()
          `, { ownershipId, playlistId, processedVideos, progress });
        }
      }

      // Update customOrder with all video IDs (use videoIds already declared above)
      // Mark as completed and remove priority (no longer needed)
      await session.run(`
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
        SET p.queueStatus = 'completed',
            p.progress = 100,
            p.customOrder = $customOrder,
            p.priority = null,
            p.completedAt = datetime(),
            p.updatedAt = datetime()
      `, { ownershipId, playlistId, customOrder: videoIds });

      await logMessage('info', 'Playlist processing completed', {
        playlistId,
        processedVideos
      });

      // If this playlist is part of a channel, update channel progress
      if (channelId) {
        // ATOMIC UPDATE: Increment processedPlaylists counter for the channel
        // This is safe for concurrent updates - Neo4j handles the increment atomically
        // Multiple workers can complete playlists simultaneously without losing counts
        const channelUpdateResult = await session.run(`
          MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannel]->(c:Channel {youtubeId: $channelId})
          SET c.processedPlaylists = coalesce(c.processedPlaylists, 0) + 1,
              c.updatedAt = datetime()
          RETURN c
        `, { ownershipId, channelId });

        if (channelUpdateResult.records.length > 0) {
          const record = channelUpdateResult.records[0];
          const channelNode = record.get('c');
          const channel = args.convertNodeToJson(channelNode);

          const processedPlaylists = channel.P.processedPlaylists || 0;
          const totalPlaylists = channel.P.totalPlaylists || 0;

          // Calculate channel progress based on completed playlists
          const channelProgress = totalPlaylists > 0
            ? Math.round((processedPlaylists / totalPlaylists) * 100)
            : 0;

          // Update channel progress
          await session.run(`
            MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannel]->(c:Channel {youtubeId: $channelId})
            SET c.progress = $progress,
                c.updatedAt = datetime()
          `, { ownershipId, channelId, progress: channelProgress });

          await logMessage('info', 'Channel progress updated', {
            channelId,
            processedPlaylists,
            totalPlaylists,
            channelProgress
          });

          // Check if all playlists for this channel are completed
          if (processedPlaylists >= totalPlaylists && totalPlaylists > 0) {
            // Verify all playlists are indeed completed
            const verifyResult = await session.run(`
              MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannel]->(c:Channel {youtubeId: $channelId})
              MATCH (c)-[:ChannelPlaylist]->(p:Playlist)
              MATCH (o)-[:YouTubeOwnershipPlaylist]->(p)
              WITH count(p) as totalCount,
                   sum(CASE WHEN p.queueStatus = 'completed' THEN 1 ELSE 0 END) as completedCount
              RETURN totalCount, completedCount
            `, { ownershipId, channelId });

            if (verifyResult.records.length > 0) {
              const verifyRecord = verifyResult.records[0];
              const totalCount = verifyRecord.get('totalCount');
              const completedCount = verifyRecord.get('completedCount');

              // If all playlists are completed, mark channel as completed
              if (completedCount >= totalCount && totalCount > 0) {
                await session.run(`
                  MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannel]->(c:Channel {youtubeId: $channelId})
                  SET c.queueStatus = 'completed',
                      c.progress = 100,
                      c.priority = null,
                      c.completedAt = datetime(),
                      c.updatedAt = datetime()
                `, { ownershipId, channelId });

                await logMessage('info', 'Channel marked as completed', {
                  channelId,
                  totalCount
                });
              }
            }
          }
        }
      }

    } catch (error) {
      await logMessage('error', 'Error processing playlist', {
        playlistId,
        error: error.message,
        stack: error.stack
      });

      // Mark as failed
      await session.run(`
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylist]->(p:Playlist {youtubeId: $playlistId})
        SET p.queueStatus = 'failed',
            p.error = $error,
            p.priority = null,
            p.updatedAt = datetime()
      `, { ownershipId, playlistId, error: error.message });

      // If this playlist is part of a channel, update channel with error
      if (channelId) {
        // ATOMIC UPDATE: Increment processedPlaylists counter even on failure
        // This ensures channel completion tracking is accurate even when some playlists fail
        // The counter increment is atomic and safe for concurrent updates
        const channelUpdateResult = await session.run(`
          MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannel]->(c:Channel {youtubeId: $channelId})
          SET c.processedPlaylists = coalesce(c.processedPlaylists, 0) + 1,
              c.updatedAt = datetime()
          RETURN c
        `, { ownershipId, channelId });

        if (channelUpdateResult.records.length > 0) {
          const record = channelUpdateResult.records[0];
          const channelNode = record.get('c');
          const channel = args.convertNodeToJson(channelNode);

          const processedPlaylists = channel.P.processedPlaylists || 0;
          const totalPlaylists = channel.P.totalPlaylists || 0;

          // Calculate channel progress
          const channelProgress = totalPlaylists > 0
            ? Math.round((processedPlaylists / totalPlaylists) * 100)
            : 0;

          // Update channel progress
          await session.run(`
            MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannel]->(c:Channel {youtubeId: $channelId})
            SET c.progress = $progress,
                c.updatedAt = datetime()
          `, { ownershipId, channelId, progress: channelProgress });

          await logMessage('info', 'Channel progress updated after playlist failure', {
            channelId,
            processedPlaylists,
            totalPlaylists,
            channelProgress
          });

          // Check if all playlists have been processed (completed or failed)
          if (processedPlaylists >= totalPlaylists && totalPlaylists > 0) {
            // Check if any playlists failed
            const statusCheckResult = await session.run(`
              MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannel]->(c:Channel {youtubeId: $channelId})
              MATCH (c)-[:ChannelPlaylist]->(p:Playlist)
              MATCH (o)-[:YouTubeOwnershipPlaylist]->(p)
              WITH count(p) as totalCount,
                   sum(CASE WHEN p.queueStatus = 'completed' THEN 1 ELSE 0 END) as completedCount,
                   sum(CASE WHEN p.queueStatus = 'failed' THEN 1 ELSE 0 END) as failedCount
              RETURN totalCount, completedCount, failedCount
            `, { ownershipId, channelId });

            if (statusCheckResult.records.length > 0) {
              const statusRecord = statusCheckResult.records[0];
              const totalCount = statusRecord.get('totalCount');
              const completedCount = statusRecord.get('completedCount');
              const failedCount = statusRecord.get('failedCount');

              // If all playlists are processed (completed or failed)
              if ((completedCount + failedCount) >= totalCount && totalCount > 0) {
                const finalStatus = failedCount > 0 ? 'completed_with_errors' : 'completed';
                const errorMessage = failedCount > 0
                  ? `${failedCount} out of ${totalCount} playlists failed to process`
                  : null;

                await session.run(`
                  MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannel]->(c:Channel {youtubeId: $channelId})
                  SET c.queueStatus = $status,
                      c.progress = 100,
                      c.priority = null,
                      c.error = $error,
                      c.completedAt = datetime(),
                      c.updatedAt = datetime()
                `, { ownershipId, channelId, status: finalStatus, error: errorMessage });

                await logMessage('info', 'Channel final status updated', {
                  channelId,
                  finalStatus,
                  completedCount,
                  failedCount
                });
              }
            }
          }
        }
      }

      throw error;
    } finally {
      // Release quota reservation
      if (reservationId) {
        try {
          await args.releaseQuota(reservationId, session);
          await logMessage('info', 'Released quota reservation', { reservationId, playlistId });
        } catch (error) {
          // Log but don't throw - session cleanup is more important
          console.error('Error releasing quota reservation:', error);
        }
      }

      // Always close the session
      await session.close();
    }
  }, {
    connection,
    // CONCURRENCY CONFIGURATION:
    // Process 5 playlists simultaneously for faster throughput
    // Playlists are independent and can be processed in parallel
    // This significantly speeds up channel processing
    // Monitor YouTube API quota usage and adjust if hitting limits
    // Reduce to 2-3 if experiencing API rate limit errors
    concurrency: 2
  });

    // Event handlers for job lifecycle
    worker.on('completed', async (job) => {
      await logMessage('info', 'Playlist processing job completed', { jobId: job.id });
    });

    worker.on('failed', async (job, err) => {
      await logMessage('error', 'Playlist processing job failed', {
        jobId: job?.id,
        error: err.message,
        stack: err.stack
      });
    });

    // Event handler for worker errors (including connection errors)
    worker.on('error', async (err) => {
      await logMessage('error', 'Worker error occurred', {
        error: err.message,
        stack: err.stack,
        code: err.code
      });
    });

    await logMessage('info', 'Playlist processing worker created successfully', {
      concurrency: 5
    });

    // Return stop function for graceful shutdown
    return {
      stop: async (force = false) => {
        await logMessage('info', `Stopping playlist processing worker${force ? ' (force)' : ''}`);
        if (worker) {
          await worker.close(force);
        }
      }
    };

  } catch (error) {
    await logMessage('error', 'Failed to create playlist processing worker', {
      error: error.message,
      stack: error.stack,
      code: error.code
    });

    // If worker was partially created, try to close it
    if (worker) {
      try {
        await worker.close();
      } catch (closeError) {
        console.error('Error closing worker:', closeError);
      }
    }

    throw error;
  }
}
