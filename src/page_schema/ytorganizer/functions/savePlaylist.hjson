{
  vertexes: [
    {
      id: "save_playlist_function",
      L: "Function",
      P: {
        key: "savePlaylist",
        description: "Fetches basic playlist metadata using per-user OAuth and queues background processing for videos",
        body: '''
/**
 * Extract playlist ID from various YouTube URL formats
 * Playlist ID is always in the 'list' query parameter
 */
const extractPlaylistId = (url) => {
  if (!url) return null;

  try {
    // Parse URL using built-in URL class
    const urlObj = new URL(url);

    // Check if it's a YouTube domain
    if (!urlObj.hostname.includes('youtube.com')) {
      return null;
    }

    // Get the 'list' query parameter
    const playlistId = urlObj.searchParams.get('list');
    return playlistId;
  } catch (error) {
    // Invalid URL format
    return null;
  }
};

/**
 * Fetch ONLY basic playlist metadata using per-user OAuth (no videos)
 * Full processing will be done in background worker
 */
const fetchPlaylistMetadata = async (playlistId, youtube, userUuid, session) => {
  // Fetch ONLY playlist details (metadata only, no videos)
  const playlistResponse = await youtube.playlists.list({
    part: ['snippet', 'contentDetails', 'status'],
    id: [playlistId]
  });

  // Log API usage: playlists.list operation (1 unit)
  await args.logAPIUsage(userUuid, 'playlists.list', args.YOUTUBE_API_COSTS['playlists.list'], session);

  if (!playlistResponse.data.items || playlistResponse.data.items.length === 0) {
    throw new Error('Playlist not found or is private/deleted');
  }

  const playlist = playlistResponse.data.items[0];

  return {
    id: playlistId,
    snippet: playlist.snippet,
    status: playlist.status,
    contentDetails: playlist.contentDetails
  };
};

try {
  // Extract input parameters from the request
  const { url, name, channelId, refresh = false, priority = 'normal' } = args.contextData;

  if (!url) {
    throw new Error("Playlist URL is required");
  }

  // Validate priority value
  const validPriorities = ['high', 'normal', 'low'];
  const playlistPriority = validPriorities.includes(priority) ? priority : 'normal';

  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Extract playlist ID from the provided URL
  const playlistId = extractPlaylistId(url);
  if (!playlistId) {
    throw new Error("Invalid YouTube playlist URL. Please provide a valid playlist URL.");
  }

  // DUPLICATE JOB PREVENTION: Check if this playlist is already queued or processing
  // Prevents multiple concurrent jobs for the same playlist which would waste API quota
  // and potentially cause data inconsistencies
  // REFRESH MODE: If refresh=true, skip this check to allow re-processing completed playlists
  if (!refresh) {
    const existingPlaylistResult = await args.session.run(`
      MATCH (u:User {uuid: $userUuid})-[:UserPlaylistSetting]->(ps:PlaylistSetting)
            -[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
      WHERE ps.status IN ['queued', 'processing']
      RETURN p.youtubeId as playlistId, ps.status as status, p.title as title
    `, { userUuid: user.P.uuid, playlistId });

    if (existingPlaylistResult.records.length > 0) {
      const record = existingPlaylistResult.records[0];
      const status = record.get('status');
      const title = record.get('title');

      return {
        success: false,
        message: `Playlist "${title}" is already ${status}. Please wait for it to complete before adding again. Use refresh=true to force re-processing.`,
        data: {
          playlistId: record.get('playlistId'),
          status: status,
          alreadyExists: true
        }
      };
    }
  }

  // Get authenticated YouTube client for this user
  let youtube;
  try {
    youtube = await args.getYouTubeClient(user.P.uuid, args.session, args.request);
  } catch (error) {
    // Check if this is an OAuth authorization error
    if (error.message.includes('No YouTube authorization') ||
        error.message.includes('revoked') ||
        error.message.includes('reconnect')) {
      return {
        success: false,
        message: "YouTube account not connected. Please connect your YouTube account in settings to add playlists.",
        error: {
          type: "AuthorizationRequired",
          details: error.message,
          action: "connect_youtube"
        }
      };
    }
    throw error;
  }

  // Fetch ONLY basic playlist metadata using user's OAuth (fast operation)
  const playlistData = await fetchPlaylistMetadata(playlistId, youtube, user.P.uuid, args.session);

  // STEP 1: Create or update the main Playlist vertex with basic metadata
  const playlistKey = `playlist_${playlistId}`;

  const mergePlaylistQuery = `
    MERGE (p:Playlist {youtubeId: $playlistId})
    ON CREATE SET
      p.key = $key,
      p.youtubeId = $playlistId,
      p.createdAt = datetime()
    SET
      p.title = $title,
      p.description = $description,
      p.thumbnail = $thumbnail,
      p.channelTitle = $channelTitle,
      p.channelId = $channelId,
      p.privacyStatus = $privacyStatus,
      p.itemCount = $itemCount,
      p.publishedAt = datetime($publishedAt),
      p.updatedAt = datetime()
    RETURN p
  `;

  await args.session.run(mergePlaylistQuery, {
    key: playlistKey,
    playlistId,
    title: playlistData.snippet.title,
    description: playlistData.snippet.description || "",
    thumbnail: playlistData.snippet.thumbnails?.high?.url ||
               playlistData.snippet.thumbnails?.medium?.url ||
               playlistData.snippet.thumbnails?.default?.url || "",
    channelTitle: playlistData.snippet.channelTitle,
    channelId: playlistData.snippet.channelId,
    privacyStatus: playlistData.status?.privacyStatus || "unknown",
    itemCount: playlistData.contentDetails?.itemCount || 0,
    publishedAt: playlistData.snippet.publishedAt
  });

  // STEP 2: Create user-specific PlaylistSetting with status tracking
  const playlistSettingKey = `playlist_setting_${user.id}_${playlistId}`;

  const mergePlaylistSettingQuery = `
    MATCH (u:User {uuid: $userUuid})
    MATCH (p:Playlist {youtubeId: $playlistId})
    MERGE (u)-[:UserPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p)
    ON CREATE SET
      ps.key = $playlistSettingKey,
      ps.createdAt = datetime()
    SET
      ps.customName = $customName,
      ps.sortBy = 'index',
      ps.showThumbnails = true,
      ps.viewMode = 'list',
      ps.priority = $priority,
      ps.status = 'queued',
      ps.progress = 0,
      ps.totalVideos = 0,
      ps.processedVideos = 0,
      ps.error = null,
      ps.queuedAt = datetime(),
      ps.lastUpdated = datetime(),
      ps.updatedAt = datetime()
    RETURN ps
  `;

  await args.session.run(mergePlaylistSettingQuery, {
    userUuid: user.P.uuid,
    playlistId,
    playlistSettingKey,
    customName: name || null,
    priority: playlistPriority
  });

  // If playlist is part of a channel, create relationship
  if (channelId) {
    const channelPlaylistQuery = `
      MATCH (c:Channel {youtubeId: $channelId})
      MATCH (p:Playlist {youtubeId: $playlistId})
      MERGE (c)-[:ChannelPlaylist]->(p)
    `;
    await args.session.run(channelPlaylistQuery, { channelId, playlistId });
  }

  // STEP 3: Add to background processing queue using BullMQ
  const helpers = await args.executeNamedServerFunction({ functionName: 'queueHelpers', contextData: {} });
  const playlistQueue = helpers.result.data.createPlaylistQueue(args);

  try {
    // Map priority string to BullMQ priority number (lower = higher priority)
    const jobPriority = playlistPriority === 'high' ? 1 : playlistPriority === 'low' ? 3 : 2;

    // DEAD LETTER QUEUE CONFIGURATION:
    // Failed jobs are kept (removeOnFail: false) so admins can inspect errors
    // After 3 retry attempts, the job stays in the failed set for manual review
    // This helps debug YouTube API issues, quota problems, and other failures
    await helpers.result.data.addPlaylistJob(playlistQueue, {
      playlistId,
      userId: user.id,
      userUuid: user.P.uuid,
      customName: name || null,
      channelId: channelId || null,
      priority: playlistPriority
    }, {
      priority: jobPriority  // Override default priority
    });
  } finally {
    // Close queue connection
    await playlistQueue.close();
  }

  return {
    success: true,
    message: refresh
      ? `Playlist "${playlistData.snippet.title}" has been queued for refresh. All videos will be re-fetched from YouTube.`
      : `Playlist "${playlistData.snippet.title}" has been queued for processing. This may take a few minutes.`,
    data: {
      playlistId,
      title: playlistData.snippet.title,
      customName: name,
      status: 'queued',
      progress: 0,
      totalVideos: playlistData.contentDetails?.itemCount || 0,
      channelTitle: playlistData.snippet.channelTitle,
      userId: user.id,
      userSpecific: true,
      isRefresh: refresh,
      usesOAuth: true
    }
  };

} catch (error) {
  console.error("Error saving playlist:", error);

  // Handle specific YouTube API and OAuth errors
  let userMessage = "Failed to save playlist. Please try again.";

  if (error.message.includes("Playlist not found")) {
    userMessage = "Playlist not found. Please check the URL and make sure the playlist is public.";
  } else if (error.message.includes("Invalid YouTube playlist URL")) {
    userMessage = "Invalid playlist URL. Please provide a valid YouTube playlist URL.";
  } else if (error.message.includes("quota")) {
    userMessage = "YouTube API quota exceeded. This resets daily. Please try again tomorrow.";
  } else if (error.message.includes("revoked") || error.message.includes("reconnect")) {
    userMessage = "Your YouTube authorization has expired. Please reconnect your YouTube account in settings.";
  } else if (error.message.includes("No YouTube authorization")) {
    userMessage = "YouTube account not connected. Please connect your YouTube account in settings.";
  } else if (error.message.includes("private")) {
    userMessage = "This playlist is private and cannot be accessed.";
  } else if (error.code === 404) {
    userMessage = "Playlist not found or has been deleted.";
  } else if (error.code === 403) {
    userMessage = "Access denied. The playlist may be private or you may not have permission to access it.";
  } else if (error.code === 401) {
    userMessage = "Authentication failed. Please reconnect your YouTube account in settings.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "YouTubeAPIError",
      details: error.message,
      code: error.code || null
    }
  };
}
'''
      }
    }
  ],
  edges: []
}