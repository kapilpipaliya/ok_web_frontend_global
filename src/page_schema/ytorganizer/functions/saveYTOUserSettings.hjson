{
  vertexes: [
    {
      id: "save_yto_user_settings_function",
      L: "Function",
      P: {
        key: "saveYTOUserSettings",
        description: "Saves YouTube Organizer user settings (sort preferences, view modes, etc.)",
        body: '''
try {
  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Get settings from request
  const { settings } = args.contextData;

  if (!settings) {
    throw new Error("Settings object is required");
  }

  // Default values for settings
  const defaultSortPreferences = {
    channels: "title_asc",
    playlists: "title_asc",
    videos: "position_asc",
    favourites: "favourited_desc"
  };

  const defaultCardFieldSettings = {
    video: ["description", "channel", "publishedAt", "duration", "viewCount"],
    playlist: ["description", "videoCount", "updatedAt", "channelTitle"],
    channel: ["description", "videoCount", "subscriberCount", "publishedAt"]
  };

  // Parse sortPreferences if it's a string, otherwise use as-is
  const sortPrefs = typeof settings.sortPreferences === 'string'
    ? settings.sortPreferences
    : JSON.stringify(settings.sortPreferences || defaultSortPreferences);

  // Parse and validate cardFieldSettings
  let cardFieldSettings = defaultCardFieldSettings;
  if (settings.cardFieldSettings) {
    const parsed = typeof settings.cardFieldSettings === 'string'
      ? JSON.parse(settings.cardFieldSettings)
      : settings.cardFieldSettings;

    // Validate structure and limits
    if (parsed && typeof parsed === 'object') {
      const validatedCardSettings = {};

      // Validate video fields (max 5)
      if (Array.isArray(parsed.video)) {
        validatedCardSettings.video = parsed.video.slice(0, 5);
      } else {
        validatedCardSettings.video = defaultCardFieldSettings.video;
      }

      // Validate playlist fields (max 5)
      if (Array.isArray(parsed.playlist)) {
        validatedCardSettings.playlist = parsed.playlist.slice(0, 5);
      } else {
        validatedCardSettings.playlist = defaultCardFieldSettings.playlist;
      }

      // Validate channel fields (max 5)
      if (Array.isArray(parsed.channel)) {
        validatedCardSettings.channel = parsed.channel.slice(0, 5);
      } else {
        validatedCardSettings.channel = defaultCardFieldSettings.channel;
      }

      cardFieldSettings = validatedCardSettings;
    }
  }

  const cardFieldSettingsString = JSON.stringify(cardFieldSettings);

  // Validate and prepare settings for storage
  const validatedSettings = {
    sortPreferences: sortPrefs,
    viewMode: settings.viewMode || "grid",
    itemsPerPage: settings.itemsPerPage || 50,
    autoRefreshEnabled: settings.autoRefreshEnabled || false,
    defaultOwnershipId: settings.defaultOwnershipId || null,
    cardFieldSettings: cardFieldSettingsString
  };

  // Save or update settings
  const query = `
    MATCH (u:User {uuid: $userUuid})
    MERGE (u)-[:YTOUserSetting]->(s:YTOUserSetting)
    ON CREATE SET
      s.key = $key,
      s.createdAt = datetime()
    SET
      s.sortPreferences = $sortPreferences,
      s.viewMode = $viewMode,
      s.itemsPerPage = $itemsPerPage,
      s.autoRefreshEnabled = $autoRefreshEnabled,
      s.defaultOwnershipId = $defaultOwnershipId,
      s.cardFieldSettings = $cardFieldSettings,
      s.updatedAt = datetime()
    RETURN s
  `;

  const result = await args.session.run(query, {
    userUuid: user.P.uuid,
    key: `yto_settings_${user.P.uuid}`,
    sortPreferences: validatedSettings.sortPreferences,
    viewMode: validatedSettings.viewMode,
    itemsPerPage: validatedSettings.itemsPerPage,
    autoRefreshEnabled: validatedSettings.autoRefreshEnabled,
    defaultOwnershipId: validatedSettings.defaultOwnershipId,
    cardFieldSettings: validatedSettings.cardFieldSettings
  });

  if (result.records.length === 0) {
    throw new Error("Failed to save settings");
  }

  // Convert saved node to vertex format
  const savedNode = result.records[0].get('s');
  const savedVertex = args.convertNodeToJson(savedNode);

  return {
    success: true,
    data: {
      settings: savedVertex
    },
    message: "Settings saved successfully"
  };

} catch (error) {
  console.error("Error saving YTO user settings:", error);

  // Handle specific error types
  let userMessage = "Failed to save settings. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to save your settings.";
  } else if (error.message.includes("Settings object is required")) {
    userMessage = "Invalid settings data provided.";
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    }
  };
}
'''
      }
    }
  ],
  edges: []
}
