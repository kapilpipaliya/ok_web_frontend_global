{
  vertexes: [
    {
      id: "get_channel_contents_function",
      L: "Function",
      P: {
        key: "getChannelContents",
        description: "Fetches a single channel's playlists for the current user. Supports multi-ownership model with optional ownership filtering.",
        body: '''
try {
  // Extract channel ID, optional ownership filter, and sort from request parameters
  const { channelId, ownershipId = null, sortBy = "position_asc" } = args.contextData;

  if (!channelId) {
    throw new Error("Channel ID is required");
  }

  // Get current authenticated user from session
  const actualUser = await args.getUserFromSession();
  if (!actualUser) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Get effective user (handles admin impersonation)
  const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

  // Parse sortBy parameter using shared utility
  const parseSortResult = await args.executeNamedServerFunction({
    functionName: "parseSortByUtil",
    contextData: { sortBy, contentType: "playlists" }
  });

  if (!parseSortResult.result) {
    throw new Error("Failed to parse sort parameters");
  }

  const { orderBy, orderDirection, secondaryOrderBy } = parseSortResult.result;

  // Use helper function to fetch channel with video count
  const channelResult = await args.executeNamedServerFunction({
    functionName: "getChannelsWithVideoCount",
    contextData: {
      userUuid: user.P.uuid,
      ownershipId,  // Optional: filter by specific ownership
      channelIds: [channelId]
    }
  });

  if (!channelResult.result || !channelResult.result.success || channelResult.result.data.length === 0) {
    throw new Error("Channel not found or access denied");
  }

  const channelData = channelResult.result.data[0];
  const channel = channelData.channel;
  const channelSetting = channelData.channelSetting;

  // Get playlist IDs from this channel
  const getPlaylistIdsQuery = `
    MATCH (c:Channel {youtubeId: $channelId})-[:ChannelPlaylist]->(p:Playlist)
    RETURN p.youtubeId as playlistId
  `;

  const playlistIdsResult = await args.session.run(getPlaylistIdsQuery, {
    channelId
  });

  const channelPlaylistIds = playlistIdsResult.records.map(record => record.get('playlistId'));

  let playlists = [];

  // Use helper function to get only user-saved playlists from this channel
  if (channelPlaylistIds.length > 0) {
    const playlistsResult = await args.executeNamedServerFunction({
      functionName: "getPlaylistsWithVideoCount",
      contextData: {
        userUuid: user.P.uuid,
        ownershipId,  // Optional: filter by specific ownership
        playlistIds: channelPlaylistIds,
        orderBy,
        orderDirection,
        secondaryOrderBy  // Pass secondary sort for multi-field sorting
      }
    });

    playlists = playlistsResult.result?.success
      ? playlistsResult.result.data
      : [];
  }

  // Return raw converted nodes for frontend processing
  return {
    success: true,
    data: {
      channel: channelData,
      playlists,
      statistics: {
        totalPlaylists: playlists.length,
        userSavedPlaylists: playlists.length  // All returned playlists are user-saved
      },
      userId: user.id,
      ownershipId  // Include ownership context if filtered
    },
    message: `Found ${playlists.length} saved playlist${playlists.length !== 1 ? 's' : ''} in channel`
  };

} catch (error) {
  console.error("Error fetching channel contents:", error);

  // Handle specific error types
  let userMessage = "Failed to fetch channel contents. Please try again.";

  if (error.message.includes("Channel ID is required")) {
    userMessage = "Channel ID is required.";
  } else if (error.message.includes("User session not found")) {
    userMessage = "Please log in to view channel contents.";
  } else if (error.message.includes("Channel not found or access denied")) {
    userMessage = "Channel not found or you don't have access to it.";
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    },
    data: {
      channel: null,
      playlists: [],
      statistics: {
        totalPlaylists: 0,
        userSavedPlaylists: 0
      }
    }
  };
}
'''
      }
    }
  ],
  edges: []
}