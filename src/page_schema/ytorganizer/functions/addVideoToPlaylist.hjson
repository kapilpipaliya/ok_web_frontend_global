{
  vertexes: [
    {
      id: "add_video_to_playlist_function",
      L: "Function",
      P: {
        key: "addVideoToPlaylist",
        description: "Adds video(s) to a custom playlist. Accepts playlistId and either videoYoutubeId (for existing videos) or videoUrl (single URL or comma/newline-separated URLs to fetch new videos)",
        body: '''
try {
  // Extract input parameters from the request
  const { playlistId, videoYoutubeId, videoUrl, ownershipId } = args.contextData;

  if (!playlistId) {
    throw new Error("Playlist ID is required");
  }

  if (!videoYoutubeId && !videoUrl) {
    throw new Error("Either Video ID or Video URL is required");
  }

  if (!ownershipId) {
    throw new Error("YouTube Ownership ID is required. Please select a YouTube account.");
  }

  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Verify user has access to this playlist through ownership
  const playlistAccessQuery = `
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
    MATCH (o)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
    RETURN p, ps, o
  `;

  const playlistAccessResult = await args.session.run(playlistAccessQuery, {
    userUuid: user.P.uuid,
    ownershipId,
    playlistId: playlistId
  });

  if (playlistAccessResult.records.length === 0) {
    throw new Error("Playlist not found or access denied");
  }

  const playlist = args.convertNodeToJson(playlistAccessResult.records[0].get('p'));
  const playlistSetting = args.convertNodeToJson(playlistAccessResult.records[0].get('ps'));

  // Normalize input to array of items (either URLs or video IDs)
  let items = [];

  if (videoUrl) {
    // Split by comma or newline and clean up URLs
    items = videoUrl
      .split(/[,\n]+/)
      .map(url => url.trim())
      .filter(url => url.length > 0)
      .map(url => ({ type: 'url', value: url }));
  } else if (videoYoutubeId) {
    items = [{ type: 'id', value: videoYoutubeId }];
  }

  if (items.length === 0) {
    throw new Error("No valid video URLs or IDs found");
  }

  // Process all items with unified logic
  const results = [];
  const errors = [];

  for (const item of items) {
    try {
      let video;
      let isNewVideo = false;

      // Get video data based on type
      if (item.type === 'id') {
        // Check if video exists in database
        const videoCheckQuery = `
          MATCH (v:Video {youtubeId: $videoId})
          RETURN v
        `;

        const videoCheckResult = await args.session.run(videoCheckQuery, { videoId: item.value });

        if (videoCheckResult.records.length === 0) {
          errors.push({ value: item.value, message: "Video not found in database" });
          continue;
        }

        video = args.convertNodeToJson(videoCheckResult.records[0].get('v'));
      } else {
        // Fetch video details from URL
        const videoResult = await args.executeNamedServerFunction({
          functionName: "fetchVideoDetails",
          contextData: { videoUrl: item.value }
        });

        if (videoResult.error) {
          errors.push({ value: item.value, message: videoResult.error });
          continue;
        }

        if (!videoResult.result || !videoResult.result.success) {
          errors.push({ value: item.value, message: videoResult.result?.message || "Failed to fetch video details" });
          continue;
        }

        video = videoResult.result.data.video;
        isNewVideo = videoResult.result.data.isNewVideo || false;
      }

      const videoId = video.P.youtubeId;

      // Check if video is already in this ownership's playlist
      const existingVideoQuery = `
        MATCH (o:YouTubeOwnership {key: $ownershipId})
        MATCH (o)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
        MATCH (p)-[:PlaylistVideo]->(v:Video {youtubeId: $videoId})
        RETURN v
      `;

      const existingVideoResult = await args.session.run(existingVideoQuery, {
        ownershipId,
        playlistId: playlistId,
        videoId: videoId
      });

      if (existingVideoResult.records.length > 0) {
        errors.push({ value: item.value, message: `Video "${video.P.title}" is already in this playlist` });
        continue;
      }

      // Get current video count for position
      const countQuery = `
        MATCH (o:YouTubeOwnership {key: $ownershipId})
        MATCH (o)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
        MATCH (p)-[:PlaylistVideo]->(v:Video)
        RETURN COUNT(v) as videoCount
      `;

      const countResult = await args.session.run(countQuery, {
        ownershipId,
        playlistId: playlistId
      });
      const videoCountValue = countResult.records[0].get('videoCount');
      const currentCount = videoCountValue.low || videoCountValue || 0;
      const newPosition = currentCount + results.length;

      // Add video to playlist - clean edge with no properties (validate ownership owns playlist)
      const addVideoQuery = `
        MATCH (o:YouTubeOwnership {key: $ownershipId})
        MATCH (o)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
        MATCH (v:Video {youtubeId: $videoId})
        MERGE (p)-[:PlaylistVideo]->(v)
      `;

      await args.session.run(addVideoQuery, {
        ownershipId,
        playlistId: playlistId,
        videoId: videoId
      });

      // Create/update YouTubeOwnershipVideoSetting (no position - it's in PlaylistSetting.customOrder)
      const videoSettingQuery = `
        MATCH (o:YouTubeOwnership {key: $ownershipId})
        MATCH (v:Video {youtubeId: $videoId})
        MERGE (o)-[:YouTubeOwnershipVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v)
        ON CREATE SET
          vs.key = $videoSettingKey,
          vs.createdAt = datetime(),
          vs.watched = false,
          vs.note = null,
          vs.isFavourite = false
        SET
          vs.updatedAt = datetime()
        RETURN vs
      `;

      await args.session.run(videoSettingQuery, {
        ownershipId,
        videoId: videoId,
        videoSettingKey: `video_setting_${ownershipId}_${videoId}`
      });

      results.push({
        video: video,
        position: newPosition,
        isNewVideo: isNewVideo
      });
    } catch (error) {
      errors.push({ value: item.value, message: error.message });
    }
  }

  // Update playlist metadata if any videos were added
  if (results.length > 0) {
    // Get current customOrder array
    const currentOrder = playlistSetting.P.customOrder || [];

    // Add new video IDs to customOrder
    const addedVideoIds = results.map(r => r.video.P.youtubeId);
    const newOrder = [...currentOrder, ...addedVideoIds];

    // Check if playlist was empty before adding
    const wasEmpty = currentOrder.length === 0;

    // Update PlaylistSetting with itemCount, thumbnail, and customOrder
    const updatePlaylistSettingQuery = `
      MATCH (o:YouTubeOwnership {key: $ownershipId})
      MATCH (o)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
      SET
        ps.customOrder = $customOrder,
        ps.itemCount = $itemCount,
        ${wasEmpty ? 'ps.thumbnail = $thumbnail,' : ''}
        ps.updatedAt = datetime()
      RETURN ps
    `;

    const updateParams = {
      ownershipId,
      playlistId: playlistId,
      customOrder: newOrder,
      itemCount: newOrder.length
    };

    // Set thumbnail to first video's thumbnail if playlist was empty
    if (wasEmpty && results[0]) {
      updateParams.thumbnail = results[0].video.P.thumbnail || results[0].video.P.thumbnailUrl || "";
    }

    await args.session.run(updatePlaylistSettingQuery, updateParams);
  }

  const successCount = results.length;
  const errorCount = errors.length;

  return {
    success: successCount > 0,
    message: errorCount === 0
      ? `Added ${successCount} video${successCount !== 1 ? 's' : ''} to playlist successfully!`
      : `Added ${successCount} video${successCount !== 1 ? 's' : ''} to playlist, ${errorCount} failed`,
    data: {
      playlist: playlist,
      playlistSetting,
      addedVideos: results,
      failedVideos: errors,
      successCount,
      errorCount,
      totalCount: items.length,
      userId: user.id
    }
  };

} catch (error) {
  console.error("Error adding video to playlist:", error);

  // Handle specific error types
  let userMessage = "Failed to add video to playlist. Please try again.";

  if (error.message.includes("Playlist ID is required")) {
    userMessage = "Playlist ID is required.";
  } else if (error.message.includes("Either Video ID or Video URL is required")) {
    userMessage = "Either Video ID or Video URL is required.";
  } else if (error.message.includes("Video not found in database")) {
    userMessage = "Video not found in database.";
  } else if (error.message.includes("Failed to fetch video details")) {
    userMessage = "Could not fetch video details. Please check the video URL.";
  } else if (error.message.includes("User session not found")) {
    userMessage = "Please log in to add videos to playlists.";
  } else if (error.message.includes("Playlist not found or access denied")) {
    userMessage = "Playlist not found or you don't have access to it.";
  } else if (error.message.includes("already in this playlist")) {
    userMessage = error.message;
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    }
  };
}
'''
      }
    }
  ],
  edges: []
}