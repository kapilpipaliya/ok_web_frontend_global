{
  vertexes: [
    {
      id: "function_root",
      L: "Function",
      P: {
        key: "getUserYTODetails",
        description: "Get detailed YTO data for a specific user (channels, playlists, videos)",
        body: '''
const actualUser = await args.getUserFromSession();
if (!actualUser) {
  throw new Error("User session not found");
}

// Priority: impersonatedUserUuid (from admin impersonation) > userUuid (explicit parameter)
const targetUserUuid = args.contextData.impersonatedUserUuid || args.contextData.userUuid;

if (!targetUserUuid) {
  throw new Error("userUuid is required");
}

// Check if user is viewing their own data or if they're an admin
const isViewingSelf = actualUser.P.uuid === targetUserUuid;

if (!isViewingSelf) {
  // Verify admin role when viewing other users' data
  const adminCheck = await args.session.run(
    `MATCH (u:User)-[:UserRole]->(r:Role {key: "Admin"})
     WHERE u.uuid = $userId RETURN u`,
    { userId: actualUser.P.uuid }
  );

  if (adminCheck.records.length === 0) {
    throw new Error("Unauthorized: Admin role required to view other users' data");
  }
}

// Get user's channels
const channelsQuery = `
  MATCH (u:User {uuid: $userUuid})
  MATCH (u)-[:UserChannelSetting]->(cs:ChannelSetting)-[:ChannelSettingChannel]->(c:Channel)
  RETURN c, cs
  ORDER BY cs.createdAt DESC
  LIMIT 20
`;

const channelsResult = await args.session.run(channelsQuery, { userUuid: targetUserUuid });
const channels = channelsResult.records.map(r => ({
  channel: args.convertNodeToJson(r.get('c')),
  channelSetting: args.convertNodeToJson(r.get('cs'))
}));

// Get user's playlists
const playlistsQuery = `
  MATCH (u:User {uuid: $userUuid})
  MATCH (u)-[:UserPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist)
  RETURN p, ps
  ORDER BY ps.createdAt DESC
  LIMIT 20
`;

const playlistsResult = await args.session.run(playlistsQuery, { userUuid: targetUserUuid });
const playlists = playlistsResult.records.map(r => ({
  playlist: args.convertNodeToJson(r.get('p')),
  playlistSetting: args.convertNodeToJson(r.get('ps'))
}));

// Get user's favorite videos (limit to 20 most recent)
const videosQuery = `
  MATCH (u:User {uuid: $userUuid})
  MATCH (u)-[:UserVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v:Video)
  WHERE vs.isFavourite = true
  RETURN v, vs
  ORDER BY vs.updatedAt DESC
  LIMIT 20
`;

const videosResult = await args.session.run(videosQuery, { userUuid: targetUserUuid });
const favoriteVideos = videosResult.records.map(r => ({
  video: args.convertNodeToJson(r.get('v')),
  videoSetting: args.convertNodeToJson(r.get('vs'))
}));

// Get total videos count
const totalVideosQuery = `
  MATCH (u:User {uuid: $userUuid})
  MATCH (u)-[:UserVideoSetting]->(:VideoSetting)-[:VideoSettingVideo]->(:Video)
  RETURN count(*) as totalVideos
`;

const totalVideosResult = await args.session.run(totalVideosQuery, { userUuid: targetUserUuid });
const totalVideos = totalVideosResult.records.length > 0
  ? Number(totalVideosResult.records[0].get('totalVideos'))
  : 0;

// Get user plan (default to 'free' if not set)
const userPlanQuery = `
  MATCH (u:User {uuid: $userUuid})
  RETURN u.plan as plan
`;

const userPlanResult = await args.session.run(userPlanQuery, { userUuid: targetUserUuid });
const userPlan = userPlanResult.records.length > 0 && userPlanResult.records[0].get('plan')
  ? userPlanResult.records[0].get('plan')
  : 'free';

return {
  success: true,
  data: {
    channels,
    playlists,
    favoriteVideos,
    totalVideos,
    userPlan
  },
  message: `Found ${channels.length} channels, ${playlists.length} playlists, ${favoriteVideos.length} favorite videos, ${totalVideos} total videos`
};
'''
      }
    }
  ],
  edges: []
}
