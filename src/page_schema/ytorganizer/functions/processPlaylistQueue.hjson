{
  vertexes: [
    {
      id: "process_playlist_queue_worker",
      L: "Function",
      P: {
        key: "processPlaylistQueue",
        description: "Background worker that processes playlists by fetching all videos",
        body: '''
// This is a background worker function that processes playlists
if (args.contextData.action === 'start') {
  // Helper function to log messages to database
  const logMessage = async (level, message, metadata = {}) => {
    try {
      await args.executeNamedServerFunction({
        functionName: 'logWorkerMessage',
        contextData: {
          workerName: 'processPlaylistQueue',
          level,
          message,
          metadata
        }
      });
    } catch (error) {
      // Silent failure - don't break worker if logging fails
    }
  };

  await logMessage('info', 'Starting playlist processing worker');

  const helpers = await args.executeNamedServerFunction({ functionName: 'queueHelpers', contextData: {} });
  const { Worker } = args.bullmq;
  const connection = helpers.result.data.getRedisConnection();

  // Queue all playlists that are marked as 'queued' but not in BullMQ queue
  await logMessage('info', 'Checking for queued playlists to add to queue');

  try {
    const playlistQueue = helpers.result.data.createPlaylistQueue(args);

    // Get all playlists with status 'queued' through ownership
    const queuedPlaylists = await args.session.run(`
      MATCH (u:User)-[:UserYouTubeOwnership]->(o:YouTubeOwnership)
      MATCH (o)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)
            -[:PlaylistSettingPlaylist]->(p:Playlist)
      WHERE ps.status = 'queued'
      RETURN u.uuid as userUuid, u.id as userId, o.key as ownershipId, p.youtubeId as playlistId,
             ps.priority as priority, p.channelId as channelId
    `);

    let addedCount = 0;

    for (const record of queuedPlaylists.records) {
      const userUuid = record.get('userUuid');
      const userId = record.get('userId');
      const ownershipId = record.get('ownershipId');
      const playlistId = record.get('playlistId');
      const priority = record.get('priority') || 'normal';
      const channelId = record.get('channelId');

      // Generate unique job ID with ownership context
      const jobId = helpers.result.data.createJobId('playlist', ownershipId, playlistId);

      // Check if job already exists in waiting state
      const existingJob = await playlistQueue.getJob(jobId);
      const jobState = existingJob ? await existingJob.getState() : null;

      if (!existingJob || jobState !== 'waiting') {
        // Job doesn't exist or is not waiting, add it
        const jobPriority = priority === 'high' ? 1 : priority === 'low' ? 3 : 2;

        await helpers.result.data.addPlaylistJob(playlistQueue, {
          playlistId,
          userId,
          userUuid,
          ownershipId,  // Required for multi-ownership support
          channelId,
          priority
        }, {
          priority: jobPriority
        });

        addedCount++;
      }
    }

    await playlistQueue.close();
    await logMessage('info', `Added ${addedCount} queued playlists to queue`, { addedCount });
  } catch (error) {
    await logMessage('error', 'Error queuing playlists on startup', {
      error: error.message,
      stack: error.stack
    });
  }

  // Create worker for playlist processing queue
  const worker = new Worker('processPlaylistQueue', async (job) => {
    const { playlistId, userId, userUuid, ownershipId, customName, channelId } = job.data;

    await logMessage('info', 'Processing playlist', { playlistId, userId, ownershipId });

    // Get a new database session for this job
    const { dbSession: session } = await args.getSession();

    // Get ownership priority for quota allocation
    const ownershipResult = await session.run(`
      MATCH (o:YouTubeOwnership {key: $ownershipId})
      RETURN COALESCE(o.priority, 0) as priority
    `, { ownershipId });
    const ownershipPriority = ownershipResult.records[0]?.get('priority') || 0;

    // Reserve quota for processing (estimate: ~50 units for large playlist with pagination)
    // Actual usage will be logged as operations complete
    let reservationId = null;
    try {
      reservationId = await args.reserveQuota(
        ownershipId,
        50,  // Estimated quota needed
        ownershipPriority,
        `process_playlist_${playlistId}`,
        session
      );

      await logMessage('info', 'Reserved quota for playlist processing', {
        playlistId,
        ownershipId,
        reservationId,
        estimatedCost: 50
      });
    } catch (error) {
      // QuotaExhaustedError - mark playlist as pending_quota
      if (error.name === 'QuotaExhaustedError') {
        await logMessage('warn', 'Shared quota exhausted, queueing playlist for tomorrow', {
          playlistId,
          ownershipId,
          remainingQuota: error.remainingQuota
        });

        // Mark playlist as pending_quota
        await session.run(`
          MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)
                -[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
          SET ps.status = 'pending_quota',
              ps.error = 'Daily API quota exhausted. Will resume tomorrow.',
              ps.updatedAt = datetime()
        `, { ownershipId, playlistId });

        await session.close();
        return; // Exit without throwing - job completes but playlist waits for quota reset
      }

      // Other errors
      throw error;
    }

    try {

      // Update status to processing
      await session.run(`
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)
              -[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
        SET ps.status = 'processing',
            ps.progress = 0,
            ps.updatedAt = datetime()
        RETURN ps
      `, { ownershipId, playlistId });

      // Get authenticated YouTube client for this ownership's OAuth
      let youtube;
      try {
        youtube = await args.getYouTubeClient(ownershipId, session, args.request);
      } catch (error) {
        // Handle OAuth errors - mark playlist as failed
        await session.run(`
          MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)
                -[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
          SET ps.status = 'failed',
              ps.error = $error,
              ps.priority = null,
              ps.updatedAt = datetime()
        `, {
          ownershipId,
          playlistId,
          error: error.message.includes('No YouTube authorization') || error.message.includes('revoked')
            ? 'YouTube authorization expired or revoked. Please reconnect your YouTube account in settings.'
            : error.message
        });
        throw error;
      }

      // Fetch ALL playlist videos with pagination
      let allVideos = [];
      let nextPageToken = null;

      do {
        const itemsResponse = await youtube.playlistItems.list({
          part: ['snippet', 'contentDetails'],
          playlistId: playlistId,
          maxResults: 50,
          pageToken: nextPageToken
        });

        // Log API usage: playlistItems.list operation (1 unit per page) - shared quota
        await args.logSharedAPIUsage(ownershipId, 'playlistItems.list', args.YOUTUBE_API_COSTS['playlistItems.list'], session);

        if (itemsResponse.data.items) {
          allVideos = allVideos.concat(itemsResponse.data.items);
        }

        nextPageToken = itemsResponse.data.nextPageToken;
      } while (nextPageToken);

      const totalVideos = allVideos.length;

      // Update total count
      await session.run(`
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)
              -[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
        SET ps.totalVideos = $totalVideos,
            ps.processedVideos = 0,
            ps.updatedAt = datetime()
        RETURN ps
      `, { ownershipId, playlistId, totalVideos });

      let processedVideos = 0;

      // Process each video
      for (const video of allVideos) {
        if (!video.contentDetails?.videoId) continue;

        const videoId = video.contentDetails.videoId;

        // Save video
        await session.run(`
          MERGE (v:Video {youtubeId: $videoId})
          ON CREATE SET
            v.key = $key,
            v.createdAt = datetime()
          SET
            v.title = $title,
            v.description = $description,
            v.thumbnail = $thumbnail,
            v.channelId = $channelId,
            v.channelTitle = $channelTitle,
            v.updatedAt = datetime()
        `, {
          videoId,
          key: `video_${videoId}`,
          title: video.snippet?.title || '',
          description: video.snippet?.description || '',
          thumbnail: video.snippet?.thumbnails?.high?.url ||
                     video.snippet?.thumbnails?.medium?.url || '',
          channelId: video.snippet?.channelId || channelId || '',
          channelTitle: video.snippet?.channelTitle || ''
        });

        // Create playlist-video relationship
        await session.run(`
          MATCH (p:Playlist {youtubeId: $playlistId})
          MATCH (v:Video {youtubeId: $videoId})
          MERGE (p)-[:PlaylistVideo]->(v)
        `, { playlistId, videoId });

        // Create ownership video setting
        const videoSettingKey = `video_setting_${ownershipId}_${videoId}`;
        await session.run(`
          MATCH (o:YouTubeOwnership {key: $ownershipId})
          MATCH (v:Video {youtubeId: $videoId})
          MERGE (o)-[:YouTubeOwnershipVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v)
          ON CREATE SET
            vs.key = $videoSettingKey,
            vs.createdAt = datetime()
          SET
            vs.watched = false,
            vs.notes = null,
            vs.customPosition = $position,
            vs.playlistIndex = $position,
            vs.updatedAt = datetime()
        `, {
          ownershipId,
          videoId,
          videoSettingKey,
          position: video.snippet?.position || 0
        });

        processedVideos++;

        // Update progress every 10 videos or on last video
        if (processedVideos % 10 === 0 || processedVideos === totalVideos) {
          const progress = Math.round((processedVideos / totalVideos) * 100);

          await session.run(`
            MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)
                  -[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
            SET ps.processedVideos = $processedVideos,
                ps.progress = $progress,
                ps.updatedAt = datetime()
          `, { ownershipId, playlistId, processedVideos, progress });
        }
      }

      // Update customOrder with all video IDs
      const videoIds = allVideos.map(v => v.contentDetails?.videoId).filter(Boolean);

      // Mark as completed and remove priority (no longer needed)
      await session.run(`
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)
              -[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
        SET ps.status = 'completed',
            ps.progress = 100,
            ps.customOrder = $customOrder,
            ps.priority = null,
            ps.completedAt = datetime(),
            ps.updatedAt = datetime()
      `, { ownershipId, playlistId, customOrder: videoIds });

      await logMessage('info', 'Playlist processing completed', {
        playlistId,
        processedVideos
      });

      // If this playlist is part of a channel, update channel progress
      if (channelId) {
        // ATOMIC UPDATE: Increment processedPlaylists counter for the channel
        // This is safe for concurrent updates - Neo4j handles the increment atomically
        // Multiple workers can complete playlists simultaneously without losing counts
        const channelUpdateResult = await session.run(`
          MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
                -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
          SET cs.processedPlaylists = coalesce(cs.processedPlaylists, 0) + 1,
              cs.updatedAt = datetime()
          RETURN cs
        `, { ownershipId, channelId });

        if (channelUpdateResult.records.length > 0) {
          const record = channelUpdateResult.records[0];
          const channelSettingNode = record.get('cs');
          const channelSetting = args.convertNodeToJson(channelSettingNode);

          const processedPlaylists = channelSetting.P.processedPlaylists || 0;
          const totalPlaylists = channelSetting.P.totalPlaylists || 0;

          // Calculate channel progress based on completed playlists
          const channelProgress = totalPlaylists > 0
            ? Math.round((processedPlaylists / totalPlaylists) * 100)
            : 0;

          // Update channel progress
          await session.run(`
            MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
                  -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
            SET cs.progress = $progress,
                cs.updatedAt = datetime()
          `, { ownershipId, channelId, progress: channelProgress });

          await logMessage('info', 'Channel progress updated', {
            channelId,
            processedPlaylists,
            totalPlaylists,
            channelProgress
          });

          // Check if all playlists for this channel are completed
          if (processedPlaylists >= totalPlaylists && totalPlaylists > 0) {
            // Verify all playlists are indeed completed
            const verifyResult = await session.run(`
              MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
                    -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
              MATCH (c)-[:ChannelPlaylist]->(p:Playlist)
              MATCH (o)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p)
              WITH count(ps) as totalCount,
                   sum(CASE WHEN ps.status = 'completed' THEN 1 ELSE 0 END) as completedCount
              RETURN totalCount, completedCount
            `, { ownershipId, channelId });

            if (verifyResult.records.length > 0) {
              const verifyRecord = verifyResult.records[0];
              const totalCount = verifyRecord.get('totalCount');
              const completedCount = verifyRecord.get('completedCount');

              // If all playlists are completed, mark channel as completed
              if (completedCount >= totalCount && totalCount > 0) {
                await session.run(`
                  MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
                        -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
                  SET cs.status = 'completed',
                      cs.progress = 100,
                      cs.priority = null,
                      cs.completedAt = datetime(),
                      cs.updatedAt = datetime()
                `, { ownershipId, channelId });

                await logMessage('info', 'Channel marked as completed', {
                  channelId,
                  totalCount
                });
              }
            }
          }
        }
      }

    } catch (error) {
      await logMessage('error', 'Error processing playlist', {
        playlistId,
        error: error.message,
        stack: error.stack
      });

      // Mark as failed
      await session.run(`
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)
              -[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
        SET ps.status = 'failed',
            ps.error = $error,
            ps.priority = null,
            ps.updatedAt = datetime()
      `, { ownershipId, playlistId, error: error.message });

      // If this playlist is part of a channel, update channel with error
      if (channelId) {
        // ATOMIC UPDATE: Increment processedPlaylists counter even on failure
        // This ensures channel completion tracking is accurate even when some playlists fail
        // The counter increment is atomic and safe for concurrent updates
        const channelUpdateResult = await session.run(`
          MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
                -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
          SET cs.processedPlaylists = coalesce(cs.processedPlaylists, 0) + 1,
              cs.updatedAt = datetime()
          RETURN cs
        `, { ownershipId, channelId });

        if (channelUpdateResult.records.length > 0) {
          const record = channelUpdateResult.records[0];
          const channelSettingNode = record.get('cs');
          const channelSetting = args.convertNodeToJson(channelSettingNode);

          const processedPlaylists = channelSetting.P.processedPlaylists || 0;
          const totalPlaylists = channelSetting.P.totalPlaylists || 0;

          // Calculate channel progress
          const channelProgress = totalPlaylists > 0
            ? Math.round((processedPlaylists / totalPlaylists) * 100)
            : 0;

          // Update channel progress
          await session.run(`
            MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
                  -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
            SET cs.progress = $progress,
                cs.updatedAt = datetime()
          `, { ownershipId, channelId, progress: channelProgress });

          await logMessage('info', 'Channel progress updated after playlist failure', {
            channelId,
            processedPlaylists,
            totalPlaylists,
            channelProgress
          });

          // Check if all playlists have been processed (completed or failed)
          if (processedPlaylists >= totalPlaylists && totalPlaylists > 0) {
            // Check if any playlists failed
            const statusCheckResult = await session.run(`
              MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
                    -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
              MATCH (c)-[:ChannelPlaylist]->(p:Playlist)
              MATCH (o)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p)
              WITH count(ps) as totalCount,
                   sum(CASE WHEN ps.status = 'completed' THEN 1 ELSE 0 END) as completedCount,
                   sum(CASE WHEN ps.status = 'failed' THEN 1 ELSE 0 END) as failedCount
              RETURN totalCount, completedCount, failedCount
            `, { ownershipId, channelId });

            if (statusCheckResult.records.length > 0) {
              const statusRecord = statusCheckResult.records[0];
              const totalCount = statusRecord.get('totalCount');
              const completedCount = statusRecord.get('completedCount');
              const failedCount = statusRecord.get('failedCount');

              // If all playlists are processed (completed or failed)
              if ((completedCount + failedCount) >= totalCount && totalCount > 0) {
                const finalStatus = failedCount > 0 ? 'completed_with_errors' : 'completed';
                const errorMessage = failedCount > 0
                  ? `${failedCount} out of ${totalCount} playlists failed to process`
                  : null;

                await session.run(`
                  MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
                        -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
                  SET cs.status = $status,
                      cs.progress = 100,
                      cs.priority = null,
                      cs.error = $error,
                      cs.completedAt = datetime(),
                      cs.updatedAt = datetime()
                `, { ownershipId, channelId, status: finalStatus, error: errorMessage });

                await logMessage('info', 'Channel final status updated', {
                  channelId,
                  finalStatus,
                  completedCount,
                  failedCount
                });
              }
            }
          }
        }
      }

      throw error;
    } finally {
      // Release quota reservation
      if (reservationId) {
        try {
          await args.releaseQuota(reservationId, session);
          await logMessage('info', 'Released quota reservation', { reservationId, playlistId });
        } catch (error) {
          // Log but don't throw - session cleanup is more important
          console.error('Error releasing quota reservation:', error);
        }
      }

      // Always close the session
      await session.close();
    }
  }, {
    connection,
    // CONCURRENCY CONFIGURATION:
    // Process 5 playlists simultaneously for faster throughput
    // Playlists are independent and can be processed in parallel
    // This significantly speeds up channel processing
    // Monitor YouTube API quota usage and adjust if hitting limits
    // Reduce to 2-3 if experiencing API rate limit errors
    concurrency: 5
  });

  worker.on('completed', async (job) => {
    await logMessage('info', 'Playlist processing job completed', { jobId: job.id });
  });

  worker.on('failed', async (job, err) => {
    await logMessage('error', 'Playlist processing job failed', {
      jobId: job?.id,
      error: err.message,
      stack: err.stack
    });
  });

  // Return stop function for graceful shutdown
  return {
    stop: async () => {
      await logMessage('info', 'Stopping playlist processing worker');
      await worker.close();
    }
  };
}
'''
      }
    }
  ],
  edges: []
}
