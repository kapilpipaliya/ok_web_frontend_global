{
  vertexes: [
    {
      id: "process_playlist_queue_worker",
      L: "Function",
      P: {
        key: "processPlaylistQueue",
        description: "Background worker that processes playlists by fetching all videos",
        body: '''
// This is a background worker function that processes playlists
if (args.contextData.action === 'start') {
  console.log('Starting playlist processing worker');

  const { Worker } = args.bullmq;

  // Get Redis connection from bullmq config
  const connection = args.bullmq.redisConnection || {
    host: process.env.REDIS_HOST || 'localhost',
    port: parseInt(process.env.REDIS_PORT || '6379'),
    maxRetriesPerRequest: null
  };

  // Create worker for playlist processing queue
  const worker = new Worker('processPlaylistQueue', async (job) => {
    const { playlistId, userId, userUuid, customName, channelId } = job.data;

    console.log(`Processing playlist ${playlistId} for user ${userId}`);

    // Get a new database session for this job
    const { dbSession: session } = await args.getSession();

    try {
      // Update status to processing
      await session.run(`
        MATCH (u:User {uuid: $userUuid})-[:UserPlaylistSetting]->(ps:PlaylistSetting)
              -[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
        SET ps.status = 'processing',
            ps.progress = 0,
            ps.updatedAt = datetime()
        RETURN ps
      `, { userUuid, playlistId });

      // Get active API key from database
      const apiKeyResult = await args.executeNamedServerFunction({
        functionName: "getActiveYouTubeAPIKey",
        contextData: {}
      });

      if (!apiKeyResult?.result?.success || !apiKeyResult?.result?.data) {
        throw new Error(apiKeyResult?.result?.message || "Failed to get YouTube API key");
      }

      const apiKeyData = apiKeyResult.result.data;

      // Fetch playlist videos from YouTube API
      const { google } = await import('googleapis');
      const youtube = google.youtube({ version: 'v3', auth: apiKeyData.apiKey });

      // Fetch ALL playlist videos with pagination
      let allVideos = [];
      let nextPageToken = null;

      do {
        const itemsResponse = await youtube.playlistItems.list({
          part: ['snippet', 'contentDetails'],
          playlistId: playlistId,
          maxResults: 50,
          pageToken: nextPageToken
        });

        // Track API usage for playlistItems.list call
        await args.executeNamedServerFunction({
          functionName: "trackYouTubeAPIUsage",
          contextData: { keyId: apiKeyData.keyId, cost: 3 }
        });

        if (itemsResponse.data.items) {
          allVideos = allVideos.concat(itemsResponse.data.items);
        }

        nextPageToken = itemsResponse.data.nextPageToken;

        // TESTING: Wait 5 seconds before fetching next page
        if (nextPageToken) {
          console.log(`[Playlist ${playlistId}] Waiting 5 seconds before fetching next page...`);
          await new Promise(resolve => setTimeout(resolve, 5000));
        }
      } while (nextPageToken);

      const totalVideos = allVideos.length;

      // Update total count
      await session.run(`
        MATCH (u:User {uuid: $userUuid})-[:UserPlaylistSetting]->(ps:PlaylistSetting)
              -[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
        SET ps.totalVideos = $totalVideos,
            ps.processedVideos = 0,
            ps.updatedAt = datetime()
        RETURN ps
      `, { userUuid, playlistId, totalVideos });

      let processedVideos = 0;

      // Process each video
      for (const video of allVideos) {
        if (!video.contentDetails?.videoId) continue;

        const videoId = video.contentDetails.videoId;

        // Save video
        await session.run(`
          MERGE (v:Video {youtubeId: $videoId})
          ON CREATE SET
            v.key = $key,
            v.createdAt = datetime()
          SET
            v.title = $title,
            v.description = $description,
            v.thumbnail = $thumbnail,
            v.channelId = $channelId,
            v.channelTitle = $channelTitle,
            v.updatedAt = datetime()
        `, {
          videoId,
          key: `video_${videoId}`,
          title: video.snippet?.title || '',
          description: video.snippet?.description || '',
          thumbnail: video.snippet?.thumbnails?.high?.url ||
                     video.snippet?.thumbnails?.medium?.url || '',
          channelId: video.snippet?.channelId || channelId || '',
          channelTitle: video.snippet?.channelTitle || ''
        });

        // Create playlist-video relationship
        await session.run(`
          MATCH (p:Playlist {youtubeId: $playlistId})
          MATCH (v:Video {youtubeId: $videoId})
          MERGE (p)-[:PlaylistVideo]->(v)
        `, { playlistId, videoId });

        // Create user video setting
        const videoSettingKey = `video_setting_${userId}_${videoId}`;
        await session.run(`
          MATCH (u:User {uuid: $userUuid})
          MATCH (v:Video {youtubeId: $videoId})
          MERGE (u)-[:UserVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v)
          ON CREATE SET
            vs.key = $videoSettingKey,
            vs.createdAt = datetime()
          SET
            vs.watched = false,
            vs.notes = null,
            vs.customPosition = $position,
            vs.playlistIndex = $position,
            vs.updatedAt = datetime()
        `, {
          userUuid,
          videoId,
          videoSettingKey,
          position: video.snippet?.position || 0
        });

        processedVideos++;

        // Update progress every 10 videos or on last video
        if (processedVideos % 10 === 0 || processedVideos === totalVideos) {
          const progress = Math.round((processedVideos / totalVideos) * 100);

          await session.run(`
            MATCH (u:User {uuid: $userUuid})-[:UserPlaylistSetting]->(ps:PlaylistSetting)
                  -[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
            SET ps.processedVideos = $processedVideos,
                ps.progress = $progress,
                ps.updatedAt = datetime()
          `, { userUuid, playlistId, processedVideos, progress });
        }
      }

      // Update customOrder with all video IDs
      const videoIds = allVideos.map(v => v.contentDetails?.videoId).filter(Boolean);

      // Mark as completed
      await session.run(`
        MATCH (u:User {uuid: $userUuid})-[:UserPlaylistSetting]->(ps:PlaylistSetting)
              -[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
        SET ps.status = 'completed',
            ps.progress = 100,
            ps.customOrder = $customOrder,
            ps.completedAt = datetime(),
            ps.updatedAt = datetime()
      `, { userUuid, playlistId, customOrder: videoIds });

      console.log(`Playlist ${playlistId} processing completed: ${processedVideos} videos`);

      // If this playlist is part of a channel, update channel progress
      if (channelId) {
        // ATOMIC UPDATE: Increment processedPlaylists counter for the channel
        // This is safe for concurrent updates - Neo4j handles the increment atomically
        // Multiple workers can complete playlists simultaneously without losing counts
        const channelUpdateResult = await session.run(`
          MATCH (u:User {uuid: $userUuid})-[:UserChannelSetting]->(cs:ChannelSetting)
                -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
          SET cs.processedPlaylists = coalesce(cs.processedPlaylists, 0) + 1,
              cs.updatedAt = datetime()
          RETURN cs
        `, { userUuid, channelId });

        if (channelUpdateResult.records.length > 0) {
          const record = channelUpdateResult.records[0];
          const channelSettingNode = record.get('cs');
          const channelSetting = args.convertNodeToJson(channelSettingNode);

          const processedPlaylists = channelSetting.P.processedPlaylists || 0;
          const totalPlaylists = channelSetting.P.totalPlaylists || 0;

          // Calculate channel progress based on completed playlists
          const channelProgress = totalPlaylists > 0
            ? Math.round((processedPlaylists / totalPlaylists) * 100)
            : 0;

          // Update channel progress
          await session.run(`
            MATCH (u:User {uuid: $userUuid})-[:UserChannelSetting]->(cs:ChannelSetting)
                  -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
            SET cs.progress = $progress,
                cs.updatedAt = datetime()
          `, { userUuid, channelId, progress: channelProgress });

          console.log(`Channel ${channelId} progress: ${processedPlaylists}/${totalPlaylists} playlists (${channelProgress}%)`);

          // Check if all playlists for this channel are completed
          if (processedPlaylists >= totalPlaylists && totalPlaylists > 0) {
            // Verify all playlists are indeed completed
            const verifyResult = await session.run(`
              MATCH (u:User {uuid: $userUuid})-[:UserChannelSetting]->(cs:ChannelSetting)
                    -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
              MATCH (c)-[:ChannelPlaylist]->(p:Playlist)
              MATCH (u)-[:UserPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p)
              WITH count(ps) as totalCount,
                   sum(CASE WHEN ps.status = 'completed' THEN 1 ELSE 0 END) as completedCount
              RETURN totalCount, completedCount
            `, { userUuid, channelId });

            if (verifyResult.records.length > 0) {
              const verifyRecord = verifyResult.records[0];
              const totalCount = verifyRecord.get('totalCount');
              const completedCount = verifyRecord.get('completedCount');

              // If all playlists are completed, mark channel as completed
              if (completedCount >= totalCount && totalCount > 0) {
                await session.run(`
                  MATCH (u:User {uuid: $userUuid})-[:UserChannelSetting]->(cs:ChannelSetting)
                        -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
                  SET cs.status = 'completed',
                      cs.progress = 100,
                      cs.completedAt = datetime(),
                      cs.updatedAt = datetime()
                `, { userUuid, channelId });

                console.log(`Channel ${channelId} marked as completed: all ${totalCount} playlists processed`);
              }
            }
          }
        }
      }

    } catch (error) {
      console.error(`Error processing playlist ${playlistId}:`, error);

      // Mark as failed
      await session.run(`
        MATCH (u:User {uuid: $userUuid})-[:UserPlaylistSetting]->(ps:PlaylistSetting)
              -[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
        SET ps.status = 'failed',
            ps.error = $error,
            ps.updatedAt = datetime()
      `, { userUuid, playlistId, error: error.message });

      // If this playlist is part of a channel, update channel with error
      if (channelId) {
        // ATOMIC UPDATE: Increment processedPlaylists counter even on failure
        // This ensures channel completion tracking is accurate even when some playlists fail
        // The counter increment is atomic and safe for concurrent updates
        const channelUpdateResult = await session.run(`
          MATCH (u:User {uuid: $userUuid})-[:UserChannelSetting]->(cs:ChannelSetting)
                -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
          SET cs.processedPlaylists = coalesce(cs.processedPlaylists, 0) + 1,
              cs.updatedAt = datetime()
          RETURN cs
        `, { userUuid, channelId });

        if (channelUpdateResult.records.length > 0) {
          const record = channelUpdateResult.records[0];
          const channelSettingNode = record.get('cs');
          const channelSetting = args.convertNodeToJson(channelSettingNode);

          const processedPlaylists = channelSetting.P.processedPlaylists || 0;
          const totalPlaylists = channelSetting.P.totalPlaylists || 0;

          // Calculate channel progress
          const channelProgress = totalPlaylists > 0
            ? Math.round((processedPlaylists / totalPlaylists) * 100)
            : 0;

          // Update channel progress
          await session.run(`
            MATCH (u:User {uuid: $userUuid})-[:UserChannelSetting]->(cs:ChannelSetting)
                  -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
            SET cs.progress = $progress,
                cs.updatedAt = datetime()
          `, { userUuid, channelId, progress: channelProgress });

          console.log(`Channel ${channelId} progress after playlist failure: ${processedPlaylists}/${totalPlaylists} playlists (${channelProgress}%)`);

          // Check if all playlists have been processed (completed or failed)
          if (processedPlaylists >= totalPlaylists && totalPlaylists > 0) {
            // Check if any playlists failed
            const statusCheckResult = await session.run(`
              MATCH (u:User {uuid: $userUuid})-[:UserChannelSetting]->(cs:ChannelSetting)
                    -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
              MATCH (c)-[:ChannelPlaylist]->(p:Playlist)
              MATCH (u)-[:UserPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p)
              WITH count(ps) as totalCount,
                   sum(CASE WHEN ps.status = 'completed' THEN 1 ELSE 0 END) as completedCount,
                   sum(CASE WHEN ps.status = 'failed' THEN 1 ELSE 0 END) as failedCount
              RETURN totalCount, completedCount, failedCount
            `, { userUuid, channelId });

            if (statusCheckResult.records.length > 0) {
              const statusRecord = statusCheckResult.records[0];
              const totalCount = statusRecord.get('totalCount');
              const completedCount = statusRecord.get('completedCount');
              const failedCount = statusRecord.get('failedCount');

              // If all playlists are processed (completed or failed)
              if ((completedCount + failedCount) >= totalCount && totalCount > 0) {
                const finalStatus = failedCount > 0 ? 'completed_with_errors' : 'completed';
                const errorMessage = failedCount > 0
                  ? `${failedCount} out of ${totalCount} playlists failed to process`
                  : null;

                await session.run(`
                  MATCH (u:User {uuid: $userUuid})-[:UserChannelSetting]->(cs:ChannelSetting)
                        -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
                  SET cs.status = $status,
                      cs.progress = 100,
                      cs.error = $error,
                      cs.completedAt = datetime(),
                      cs.updatedAt = datetime()
                `, { userUuid, channelId, status: finalStatus, error: errorMessage });

                console.log(`Channel ${channelId} marked as ${finalStatus}: ${completedCount} completed, ${failedCount} failed`);
              }
            }
          }
        }
      }

      throw error;
    } finally {
      // Always close the session
      await session.close();
    }
  }, {
    connection,
    // CONCURRENCY CONFIGURATION:
    // Process 5 playlists simultaneously for faster throughput
    // Playlists are independent and can be processed in parallel
    // This significantly speeds up channel processing
    // Monitor YouTube API quota usage and adjust if hitting limits
    // Reduce to 2-3 if experiencing API rate limit errors
    concurrency: 5
  });

  worker.on('completed', (job) => {
    console.log(`Playlist processing job ${job.id} completed`);
  });

  worker.on('failed', (job, err) => {
    console.error(`Playlist processing job ${job?.id} failed:`, err);
  });

  // Return stop function for graceful shutdown
  return {
    stop: async () => {
      console.log('Stopping playlist processing worker');
      await worker.close();
    }
  };
}
'''
      }
    }
  ],
  edges: []
}
