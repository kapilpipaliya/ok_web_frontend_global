{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Retrieves the user's sidebar collapsed/expanded preference
        body:
          '''
const userId = _.user?.id;

if (!userId) {
  return {
    success: false,
    error: "User not authenticated"
  };
}

// Fetch user preference for sidebar state
const result = await _.session.run(
  `MATCH (u:User {id: $userId})-[:UserUserPreference]->(p:UserPreference {key: 'sidebarCollapsed'})
   RETURN p.value as isCollapsed`,
  {
    userId
  }
);

if (result.records.length === 0) {
  // No preference saved, return default (expanded)
  return {
    success: true,
    data: {
      isCollapsed: false
    }
  };
}

const isCollapsed = result.records[0].get('isCollapsed');

return {
  success: true,
  data: {
    isCollapsed: typeof isCollapsed === 'boolean' ? isCollapsed : false
  }
};
'''
        key: getSidebarPreference
      }
    }
  ]
  edges: []
}