{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Migrates YouTube Organizer schema from v3.x to v4.0. Transforms old setting-based relationships to new direct ownership relationships with optional settings.
        body:
          '''
/**
 * Schema Migration: v3.x → v4.0
 *
 * This script migrates the YouTube Organizer schema from version 3.x to 4.0.
 *
 * MAJOR CHANGES:
 * 1. Direct Ownership: YouTubeOwnership now directly owns Channels and Playlists
 * 2. Optional Settings: Settings are now end nodes, created only when needed
 * 3. Global Playlist Membership: Videos belong to playlists globally (not per-ownership)
 *
 * OLD SCHEMA (v3.x):
 * - (YouTubeOwnership)-[:YouTubeOwnershipChannelSetting]->(ChannelSetting)-[:ChannelSettingChannel]->(Channel)
 * - (YouTubeOwnership)-[:YouTubeOwnershipPlaylistSetting]->(PlaylistSetting)-[:PlaylistSettingPlaylist]->(Playlist)
 * - (YouTubeOwnership)-[:YouTubeOwnershipVideoSetting]->(VideoSetting)-[:VideoSettingVideo]->(Video)
 * - (PlaylistSetting)-[:PlaylistSettingVideo]->(Video)  # Per-ownership playlist membership
 *
 * NEW SCHEMA (v4.0):
 * - (YouTubeOwnership)-[:YouTubeOwnershipChannel]->(Channel)
 * - (YouTubeOwnership)-[:YouTubeOwnershipPlaylist]->(Playlist)
 * - (Channel)-[:ChannelChannelSetting]->(ChannelSetting)  # Optional
 * - (Playlist)-[:PlaylistPlaylistSetting]->(PlaylistSetting)  # Optional
 * - (Video)-[:VideoVideoSetting]->(VideoSetting)  # Optional
 * - (YouTubeOwnership)-[:YouTubeOwnershipChannelSetting]->(ChannelSetting)  # Optional per-owner override
 * - (YouTubeOwnership)-[:YouTubeOwnershipPlaylistSetting]->(PlaylistSetting)  # Optional per-owner override
 * - (YouTubeOwnership)-[:YouTubeOwnershipVideoSetting]->(VideoSetting)  # Optional per-owner override
 * - (Playlist)-[:PlaylistVideo]->(Video)  # Global playlist membership
 *
 * MIGRATION STEPS:
 * 1. Migrate Channel relationships
 * 2. Migrate Playlist relationships
 * 3. Migrate Video relationships
 * 4. Migrate playlist-video membership to global
 * 5. Clean up old relationships
 *
 * Parameters (via args.contextData):
 * - dryRun: boolean (optional) - If true, only report what would be migrated without making changes
 *
 * Returns:
 * - Statistics about the migration
 */

try {
  const { dryRun = false } = args.contextData;

  console.log(`🚀 Starting schema migration from v3.x to v4.0 (dryRun: ${dryRun})`);

  const stats = {
    channelsProcessed: 0,
    channelSettingsMigrated: 0,
    playlistsProcessed: 0,
    playlistSettingsMigrated: 0,
    videosProcessed: 0,
    videoSettingsMigrated: 0,
    playlistVideoRelationships: 0,
    oldRelationshipsDeleted: 0
  };

  // ==========================================
  // STEP 1: Migrate Channel Relationships
  // ==========================================
  console.log('\n📁 Step 1: Migrating Channel relationships...');

  const channelQuery = `
    // Find all old channel relationships
    MATCH (o:YouTubeOwnership)-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)-[:ChannelSettingChannel]->(c:Channel)
    RETURN o, cs, c
  `;

  const channelResult = await args.session.run(channelQuery);
  console.log(`Found ${channelResult.records.length} channel relationships to migrate`);

  if (!dryRun) {
    for (const record of channelResult.records) {
      const ownership = record.get('o');
      const channelSetting = record.get('cs');
      const channel = record.get('c');

      // Create new direct ownership relationship
      await args.session.run(`
        MATCH (o:YouTubeOwnership) WHERE elementId(o) = $ownershipId
        MATCH (c:Channel) WHERE elementId(c) = $channelId
        MERGE (o)-[:YouTubeOwnershipChannel]->(c)
      `, {
        ownershipId: ownership.elementId,
        channelId: channel.elementId
      });

      // Create setting attachments if setting has meaningful data
      const hasData = channelSetting.properties.customName ||
                     channelSetting.properties.isFavourite ||
                     channelSetting.properties.status;

      if (hasData) {
        await args.session.run(`
          MATCH (o:YouTubeOwnership) WHERE elementId(o) = $ownershipId
          MATCH (c:Channel) WHERE elementId(c) = $channelId
          MATCH (cs:ChannelSetting) WHERE elementId(cs) = $channelSettingId

          // Attach setting to channel
          MERGE (c)-[:ChannelChannelSetting]->(cs)

          // Link ownership to setting for per-owner override
          MERGE (o)-[:YouTubeOwnershipChannelSetting]->(cs)
        `, {
          ownershipId: ownership.elementId,
          channelId: channel.elementId,
          channelSettingId: channelSetting.elementId
        });
        stats.channelSettingsMigrated++;
      }

      stats.channelsProcessed++;
    }
  } else {
    stats.channelsProcessed = channelResult.records.length;
    // Count how many have meaningful settings
    for (const record of channelResult.records) {
      const channelSetting = record.get('cs');
      const hasData = channelSetting.properties.customName ||
                     channelSetting.properties.isFavourite ||
                     channelSetting.properties.status;
      if (hasData) stats.channelSettingsMigrated++;
    }
  }

  console.log(`✅ Processed ${stats.channelsProcessed} channels, migrated ${stats.channelSettingsMigrated} settings`);

  // ==========================================
  // STEP 2: Migrate Playlist Relationships
  // ==========================================
  console.log('\n📝 Step 2: Migrating Playlist relationships...');

  const playlistQuery = `
    // Find all old playlist relationships
    MATCH (o:YouTubeOwnership)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist)
    RETURN o, ps, p
  `;

  const playlistResult = await args.session.run(playlistQuery);
  console.log(`Found ${playlistResult.records.length} playlist relationships to migrate`);

  if (!dryRun) {
    for (const record of playlistResult.records) {
      const ownership = record.get('o');
      const playlistSetting = record.get('ps');
      const playlist = record.get('p');

      // Create new direct ownership relationship
      await args.session.run(`
        MATCH (o:YouTubeOwnership) WHERE elementId(o) = $ownershipId
        MATCH (p:Playlist) WHERE elementId(p) = $playlistId
        MERGE (o)-[:YouTubeOwnershipPlaylist]->(p)
      `, {
        ownershipId: ownership.elementId,
        playlistId: playlist.elementId
      });

      // Create setting attachments if setting has meaningful data
      const hasData = playlistSetting.properties.customName ||
                     playlistSetting.properties.isFavourite ||
                     playlistSetting.properties.status ||
                     playlistSetting.properties.customOrder;

      if (hasData) {
        await args.session.run(`
          MATCH (o:YouTubeOwnership) WHERE elementId(o) = $ownershipId
          MATCH (p:Playlist) WHERE elementId(p) = $playlistId
          MATCH (ps:PlaylistSetting) WHERE elementId(ps) = $playlistSettingId

          // Attach setting to playlist
          MERGE (p)-[:PlaylistPlaylistSetting]->(ps)

          // Link ownership to setting for per-owner override
          MERGE (o)-[:YouTubeOwnershipPlaylistSetting]->(ps)
        `, {
          ownershipId: ownership.elementId,
          playlistId: playlist.elementId,
          playlistSettingId: playlistSetting.elementId
        });
        stats.playlistSettingsMigrated++;
      }

      stats.playlistsProcessed++;
    }
  } else {
    stats.playlistsProcessed = playlistResult.records.length;
    // Count how many have meaningful settings
    for (const record of playlistResult.records) {
      const playlistSetting = record.get('ps');
      const hasData = playlistSetting.properties.customName ||
                     playlistSetting.properties.isFavourite ||
                     playlistSetting.properties.status ||
                     playlistSetting.properties.customOrder;
      if (hasData) stats.playlistSettingsMigrated++;
    }
  }

  console.log(`✅ Processed ${stats.playlistsProcessed} playlists, migrated ${stats.playlistSettingsMigrated} settings`);

  // ==========================================
  // STEP 3: Migrate Video Settings
  // ==========================================
  console.log('\n🎬 Step 3: Migrating Video settings...');

  const videoSettingQuery = `
    // Find all old video setting relationships
    MATCH (o:YouTubeOwnership)-[:YouTubeOwnershipVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v:Video)
    RETURN o, vs, v
  `;

  const videoSettingResult = await args.session.run(videoSettingQuery);
  console.log(`Found ${videoSettingResult.records.length} video settings to migrate`);

  if (!dryRun) {
    for (const record of videoSettingResult.records) {
      const ownership = record.get('o');
      const videoSetting = record.get('vs');
      const video = record.get('v');

      // Create new relationships if setting has meaningful data
      const hasData = videoSetting.properties.note ||
                     videoSetting.properties.isFavourite ||
                     videoSetting.properties.watched ||
                     videoSetting.properties.customName;

      if (hasData) {
        await args.session.run(`
          MATCH (o:YouTubeOwnership) WHERE elementId(o) = $ownershipId
          MATCH (v:Video) WHERE elementId(v) = $videoId
          MATCH (vs:VideoSetting) WHERE elementId(vs) = $videoSettingId

          // Attach setting to video
          MERGE (v)-[:VideoVideoSetting]->(vs)

          // Link ownership to setting for per-owner override
          MERGE (o)-[:YouTubeOwnershipVideoSetting]->(vs)
        `, {
          ownershipId: ownership.elementId,
          videoId: video.elementId,
          videoSettingId: videoSetting.elementId
        });
        stats.videoSettingsMigrated++;
      }

      stats.videosProcessed++;
    }
  } else {
    stats.videosProcessed = videoSettingResult.records.length;
    // Count how many have meaningful settings
    for (const record of videoSettingResult.records) {
      const videoSetting = record.get('vs');
      const hasData = videoSetting.properties.note ||
                     videoSetting.properties.isFavourite ||
                     videoSetting.properties.watched ||
                     videoSetting.properties.customName;
      if (hasData) stats.videoSettingsMigrated++;
    }
  }

  console.log(`✅ Processed ${stats.videosProcessed} video settings, migrated ${stats.videoSettingsMigrated} settings`);

  // ==========================================
  // STEP 4: Migrate Playlist-Video Membership to Global
  // ==========================================
  console.log('\n🔗 Step 4: Migrating playlist-video membership to global...');

  const playlistVideoQuery = `
    // Find all old playlist-video relationships
    MATCH (ps:PlaylistSetting)-[r:PlaylistSettingVideo]->(v:Video)
    MATCH (ps)-[:PlaylistSettingPlaylist]->(p:Playlist)
    RETURN p, v, r.position as position, r.playlistIndex as playlistIndex
  `;

  const playlistVideoResult = await args.session.run(playlistVideoQuery);
  console.log(`Found ${playlistVideoResult.records.length} playlist-video relationships to migrate`);

  if (!dryRun) {
    for (const record of playlistVideoResult.records) {
      const playlist = record.get('p');
      const video = record.get('v');
      const position = record.get('position');
      const playlistIndex = record.get('playlistIndex');

      // Create new global Playlist -> Video relationship
      await args.session.run(`
        MATCH (p:Playlist) WHERE elementId(p) = $playlistId
        MATCH (v:Video) WHERE elementId(v) = $videoId
        MERGE (p)-[r:PlaylistVideo]->(v)
        ON CREATE SET r.createdAt = datetime(), r.position = $position, r.playlistIndex = $playlistIndex
        ON MATCH SET r.position = COALESCE(r.position, $position),
                    r.playlistIndex = COALESCE(r.playlistIndex, $playlistIndex)
      `, {
        playlistId: playlist.elementId,
        videoId: video.elementId,
        position,
        playlistIndex
      });

      stats.playlistVideoRelationships++;
    }
  } else {
    stats.playlistVideoRelationships = playlistVideoResult.records.length;
  }

  console.log(`✅ Migrated ${stats.playlistVideoRelationships} playlist-video relationships`);

  // ==========================================
  // STEP 5: Clean Up Old Relationships
  // ==========================================
  if (!dryRun) {
    console.log('\n🧹 Step 5: Cleaning up old relationships...');

    // Delete old ChannelSettingChannel relationships
    const deleteChannelSettingChannel = await args.session.run(`
      MATCH ()-[r:ChannelSettingChannel]->()
      DELETE r
      RETURN count(r) as count
    `);
    const channelSettingChannelDeleted = deleteChannelSettingChannel.records[0]?.get('count')?.toNumber() || 0;
    console.log(`Deleted ${channelSettingChannelDeleted} ChannelSettingChannel relationships`);
    stats.oldRelationshipsDeleted += channelSettingChannelDeleted;

    // Delete old PlaylistSettingPlaylist relationships
    const deletePlaylistSettingPlaylist = await args.session.run(`
      MATCH ()-[r:PlaylistSettingPlaylist]->()
      DELETE r
      RETURN count(r) as count
    `);
    const playlistSettingPlaylistDeleted = deletePlaylistSettingPlaylist.records[0]?.get('count')?.toNumber() || 0;
    console.log(`Deleted ${playlistSettingPlaylistDeleted} PlaylistSettingPlaylist relationships`);
    stats.oldRelationshipsDeleted += playlistSettingPlaylistDeleted;

    // Delete old VideoSettingVideo relationships
    const deleteVideoSettingVideo = await args.session.run(`
      MATCH ()-[r:VideoSettingVideo]->()
      DELETE r
      RETURN count(r) as count
    `);
    const videoSettingVideoDeleted = deleteVideoSettingVideo.records[0]?.get('count')?.toNumber() || 0;
    console.log(`Deleted ${videoSettingVideoDeleted} VideoSettingVideo relationships`);
    stats.oldRelationshipsDeleted += videoSettingVideoDeleted;

    // Delete old PlaylistSettingVideo relationships
    const deletePlaylistSettingVideo = await args.session.run(`
      MATCH ()-[r:PlaylistSettingVideo]->()
      DELETE r
      RETURN count(r) as count
    `);
    const playlistSettingVideoDeleted = deletePlaylistSettingVideo.records[0]?.get('count')?.toNumber() || 0;
    console.log(`Deleted ${playlistSettingVideoDeleted} PlaylistSettingVideo relationships`);
    stats.oldRelationshipsDeleted += playlistSettingVideoDeleted;

    console.log(`✅ Deleted ${stats.oldRelationshipsDeleted} old relationships`);
  } else {
    console.log('\n🧹 Step 5: Cleanup (skipped in dry run)');
  }

  // ==========================================
  // Summary
  // ==========================================
  console.log('\n📊 Migration Summary:');
  console.log('==========================================');
  console.log(`Channels processed: ${stats.channelsProcessed}`);
  console.log(`Channel settings migrated: ${stats.channelSettingsMigrated}`);
  console.log(`Playlists processed: ${stats.playlistsProcessed}`);
  console.log(`Playlist settings migrated: ${stats.playlistSettingsMigrated}`);
  console.log(`Video settings processed: ${stats.videosProcessed}`);
  console.log(`Video settings migrated: ${stats.videoSettingsMigrated}`);
  console.log(`Playlist-video relationships: ${stats.playlistVideoRelationships}`);
  if (!dryRun) {
    console.log(`Old relationships deleted: ${stats.oldRelationshipsDeleted}`);
  }
  console.log('==========================================');

  return {
    success: true,
    message: dryRun
      ? "Dry run completed - no changes made"
      : "Schema migration completed successfully",
    data: {
      ...stats,
      dryRun
    }
  };

} catch (error) {
  console.error('❌ Error during schema migration:', error);
  return {
    success: false,
    message: "Schema migration failed",
    error: {
      type: "MigrationError",
      details: error.message,
      stack: error.stack
    }
  };
}
'''
        key: migrateSchemaV3toV4
      }
    }
  ]
  edges: []
}