{
  vertexes: [
    {
      id: "process_channel_queue_worker",
      L: "Function",
      P: {
        key: "processChannelQueue",
        description: "Background worker that processes channels by fetching all playlists and videos",
        body: '''
// This is a background worker function that processes channels
if (args.contextData.action === 'start') {
  console.log('Starting channel processing worker');

  const { Worker } = args.bullmq;

  // Get Redis connection from bullmq config
  const connection = args.bullmq.redisConnection || {
    host: process.env.REDIS_HOST || 'localhost',
    port: parseInt(process.env.REDIS_PORT || '6379'),
    maxRetriesPerRequest: null
  };

  // Create worker for channel processing queue
  const worker = new Worker('processChannelQueue', async (job) => {
    const { channelId, userId, userUuid, customName } = job.data;

    console.log(`Processing channel ${channelId} for user ${userId}`);

    // Get a new database session for this job
    const { dbSession: session } = await args.getSession();

    try {
      // Update status to processing
      await session.run(`
        MATCH (u:User {uuid: $userUuid})-[:UserChannelSetting]->(cs:ChannelSetting)
              -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
        SET cs.status = 'processing',
            cs.progress = 0,
            cs.updatedAt = datetime()
        RETURN cs
      `, { userUuid, channelId });

      // Get active API key from database
      const apiKeyResult = await args.executeNamedServerFunction({
        functionName: "getActiveYouTubeAPIKey",
        contextData: {}
      });

      if (!apiKeyResult?.result?.success || !apiKeyResult?.result?.data) {
        throw new Error(apiKeyResult?.result?.message || "Failed to get YouTube API key");
      }

      const apiKeyData = apiKeyResult.result.data;

      // Fetch channel playlists from YouTube API
      const { google } = await import('googleapis');
      const youtube = google.youtube({ version: 'v3', auth: apiKeyData.apiKey });

      // Get channel uploads playlist and all playlists
      const channelResponse = await youtube.channels.list({
        part: ['contentDetails'],
        id: [channelId]
      });

      // Track API usage for channels.list call
      await args.executeNamedServerFunction({
        functionName: "trackYouTubeAPIUsage",
        contextData: { keyId: apiKeyData.keyId, cost: 3 }
      });

      if (!channelResponse.data.items || channelResponse.data.items.length === 0) {
        throw new Error('Channel not found');
      }

      const uploadsPlaylistId = channelResponse.data.items[0].contentDetails?.relatedPlaylists?.uploads;

      // Fetch all channel playlists
      let allPlaylists = [];
      let nextPageToken = null;

      do {
        const playlistsResponse = await youtube.playlists.list({
          part: ['snippet', 'contentDetails', 'status'],
          channelId: channelId,
          maxResults: 50,
          pageToken: nextPageToken
        });

        // Track API usage for playlists.list call
        await args.executeNamedServerFunction({
          functionName: "trackYouTubeAPIUsage",
          contextData: { keyId: apiKeyData.keyId, cost: 3 }
        });

        if (playlistsResponse.data.items) {
          allPlaylists = allPlaylists.concat(playlistsResponse.data.items);
        }

        nextPageToken = playlistsResponse.data.nextPageToken;
      } while (nextPageToken);

      // Add uploads playlist if exists
      if (uploadsPlaylistId) {
        const uploadsPlaylist = {
          id: uploadsPlaylistId,
          snippet: {
            title: 'All Uploads',
            description: 'All videos uploaded by this channel'
          }
        };
        allPlaylists.unshift(uploadsPlaylist);
      }

      const totalPlaylists = allPlaylists.length;

      // Update total counts
      await session.run(`
        MATCH (u:User {uuid: $userUuid})-[:UserChannelSetting]->(cs:ChannelSetting)
              -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
        SET cs.totalPlaylists = $totalPlaylists,
            cs.processedPlaylists = 0,
            cs.updatedAt = datetime()
        RETURN cs
      `, { userUuid, channelId, totalPlaylists });

      // Create a queue for playlist processing
      const { Queue } = args.bullmq;
      const playlistQueue = new Queue('processPlaylistQueue', { connection });

      // Process each playlist by adding to queue
      for (const playlist of allPlaylists) {
        if (!playlist.id) continue;

        // Save playlist metadata first
        await session.run(`
          MERGE (p:Playlist {youtubeId: $playlistId})
          ON CREATE SET
            p.key = $key,
            p.createdAt = datetime()
          SET
            p.title = $title,
            p.description = $description,
            p.thumbnail = $thumbnail,
            p.channelId = $channelId,
            p.itemCount = $itemCount,
            p.updatedAt = datetime()
        `, {
          playlistId: playlist.id,
          key: `playlist_${playlist.id}`,
          title: playlist.snippet?.title || '',
          description: playlist.snippet?.description || '',
          thumbnail: playlist.snippet?.thumbnails?.high?.url ||
                     playlist.snippet?.thumbnails?.medium?.url || '',
          channelId,
          itemCount: playlist.contentDetails?.itemCount || 0
        });

        // Create channel-playlist relationship
        await session.run(`
          MATCH (c:Channel {youtubeId: $channelId})
          MATCH (p:Playlist {youtubeId: $playlistId})
          MERGE (c)-[:ChannelPlaylist]->(p)
        `, { channelId, playlistId: playlist.id });

        // Create user playlist setting and mark as queued
        const playlistSettingKey = `playlist_setting_${userId}_${playlist.id}`;
        await session.run(`
          MATCH (u:User {uuid: $userUuid})
          MATCH (p:Playlist {youtubeId: $playlistId})
          MERGE (u)-[:UserPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p)
          ON CREATE SET
            ps.key = $playlistSettingKey,
            ps.createdAt = datetime()
          SET
            ps.status = 'queued',
            ps.progress = 0,
            ps.totalVideos = 0,
            ps.processedVideos = 0,
            ps.sortBy = 'index',
            ps.showThumbnails = true,
            ps.viewMode = 'list',
            ps.queuedAt = datetime(),
            ps.updatedAt = datetime()
        `, {
          userUuid,
          playlistId: playlist.id,
          playlistSettingKey
        });

        // Add playlist to processing queue
        await playlistQueue.add('processPlaylist', {
          playlistId: playlist.id,
          userId: userId,
          userUuid: userUuid,
          customName: null,
          channelId: channelId
        }, {
          attempts: 3,
          backoff: {
            type: 'exponential',
            delay: 5000
          },
          removeOnComplete: 100,
          removeOnFail: 50
        });

        console.log(`Queued playlist ${playlist.id} (${playlist.snippet?.title}) for processing`);
      }

      // Close playlist queue connection
      await playlistQueue.close();

      console.log(`Channel ${channelId} processing completed: queued ${totalPlaylists} playlists for processing`);

    } catch (error) {
      console.error(`Error processing channel ${channelId}:`, error);

      // CRITICAL: Mark channel as failed to prevent it from being stuck in 'processing' state forever
      // This handles cases where:
      // - YouTube API is unavailable
      // - Channel is deleted or private
      // - Network errors occur
      // - Database connection issues
      // Without this, the channel would stay in 'processing' state indefinitely
      await session.run(`
        MATCH (u:User {uuid: $userUuid})-[:UserChannelSetting]->(cs:ChannelSetting)
              -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
        SET cs.status = 'failed',
            cs.error = $error,
            cs.progress = 0,
            cs.updatedAt = datetime()
      `, { userUuid, channelId, error: error.message });

      throw error;
    } finally {
      // Always close the session
      await session.close();
    }
  }, {
    connection,
    // CONCURRENCY CONFIGURATION:
    // Process 2 channels simultaneously to improve throughput
    // Keep it low to respect YouTube API rate limits
    // Each channel can spawn many playlist jobs, so 2 is reasonable
    // Increase to 5 if you have high API quota limits
    concurrency: 2
  });

  worker.on('completed', (job) => {
    console.log(`Channel processing job ${job.id} completed`);
  });

  worker.on('failed', (job, err) => {
    console.error(`Channel processing job ${job?.id} failed:`, err);
  });

  // Return stop function for graceful shutdown
  return {
    stop: async () => {
      console.log('Stopping channel processing worker');
      await worker.close();
    }
  };
}
'''
      }
    }
  ],
  edges: []
}
