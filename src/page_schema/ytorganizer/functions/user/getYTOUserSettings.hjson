{
  vertexes: [
    {
      id: "get_yto_user_settings_function",
      L: "Function",
      P: {
        key: "getYTOUserSettings",
        description: "Fetches YouTube Organizer user settings (sort preferences, view modes, etc.)",
        body: '''
try {
  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Query for user's YTO settings
  const query = `
    MATCH (u:User {uuid: $userUuid})-[:YTOUserSetting]->(s:YTOUserSetting)
    RETURN s
  `;

  const result = await args.session.run(query, {
    userUuid: user.P.uuid
  });

  // Default settings properties
  const defaultSettingsProps = {
    sortPreferences: JSON.stringify({
      channels: "title_asc",
      playlists: "title_asc",
      videos: "position_asc",
      favourites: "favourited_desc"
    }),
    viewMode: "grid",  // or "list"
    itemsPerPage: 50,
    autoRefreshEnabled: false,
    defaultOwnershipId: null,  // null means "all ownerships"
    cardFieldSettings: JSON.stringify({
      video: ["description", "channel", "publishedAt", "duration", "viewCount"],
      playlist: ["description", "videoCount", "updatedAt", "channelTitle"],
      channel: ["description", "videoCount", "subscriberCount", "publishedAt"]
    })
  };

  if (result.records.length === 0) {
    // No settings found, return defaults in vertex format
    const defaultVertex = {
      id: "yto_settings_default",
      L: ["YTOUserSetting"],
      P: defaultSettingsProps,
      IN: {},
      OUT: {}
    };

    return {
      success: true,
      data: {
        settings: defaultVertex,
        isDefault: true
      },
      message: "Using default settings (not yet customized)"
    };
  }

  // Settings exist - convert to vertex format
  const settingsNode = result.records[0].get('s');
  const settingsVertex = args.convertNodeToJson(settingsNode);

  // Ensure all default fields are present in properties
  const mergedProps = {
    ...defaultSettingsProps,
    ...settingsVertex.P
  };

  // Return vertex with merged properties
  const completeVertex = {
    ...settingsVertex,
    P: mergedProps
  };

  return {
    success: true,
    data: {
      settings: completeVertex,
      isDefault: false
    },
    message: "Settings loaded successfully"
  };

} catch (error) {
  console.error("Error fetching YTO user settings:", error);

  // Handle specific error types
  let userMessage = "Failed to fetch settings. Using defaults.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to view your settings.";
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Using default settings.";
  }

  // Return defaults on error in vertex format
  const defaultSettingsProps = {
    sortPreferences: JSON.stringify({
      channels: "title_asc",
      playlists: "title_asc",
      videos: "position_asc",
      favourites: "favourited_desc"
    }),
    viewMode: "grid",
    itemsPerPage: 50,
    autoRefreshEnabled: false,
    defaultOwnershipId: null,
    cardFieldSettings: JSON.stringify({
      video: ["description", "channel", "publishedAt", "duration", "viewCount"],
      playlist: ["description", "videoCount", "updatedAt", "channelTitle"],
      channel: ["description", "videoCount", "subscriberCount", "publishedAt"]
    })
  };

  const defaultVertex = {
    id: "yto_settings_default",
    L: ["YTOUserSetting"],
    P: defaultSettingsProps,
    IN: {},
    OUT: {}
  };

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    },
    data: {
      settings: defaultVertex,
      isDefault: true
    }
  };
}
'''
      }
    }
  ],
  edges: []
}
