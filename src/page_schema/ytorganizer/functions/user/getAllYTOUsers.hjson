{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Get all users with their YTO statistics (channels, playlists, videos counts)
        body:
          '''
const actualUser = await _.getUserFromSession();
if (!actualUser) {
  throw new Error("User session not found");
}

// Verify admin role
const adminCheck = await _.session.run(
  `MATCH (u:User {uuid: $userId})-[:UserRole]->(r:Role {key: "Admin"})
   RETURN u`,
  { userId: actualUser.P.uuid }
);

if (adminCheck.records.length === 0) {
  throw new Error("Unauthorized: Admin role required");
}

// NEW SCHEMA v4.0: Query all users with YTO statistics (direct ownership + optional settings)
const dataQuery = `
  MATCH (u:User)
  WHERE $searchQuery IS NULL OR u.username CONTAINS $searchQuery OR u.email CONTAINS $searchQuery
  OPTIONAL MATCH (u)-[:UserYouTubeOwnership]->(o:YouTubeOwnership)
  OPTIONAL MATCH (o)-[:YouTubeOwnershipChannel]->(c:Channel)
  OPTIONAL MATCH (c)-[:ChannelChannelSetting]->(cs:ChannelSetting)<-[:YouTubeOwnershipChannelSetting]-(o)
  OPTIONAL MATCH (o)-[:YouTubeOwnershipPlaylist]->(p:Playlist)
  OPTIONAL MATCH (p)-[:PlaylistPlaylistSetting]->(ps:PlaylistSetting)<-[:YouTubeOwnershipPlaylistSetting]-(o)
  OPTIONAL MATCH (o)-[:YouTubeOwnershipVideo]->(v:Video)
  OPTIONAL MATCH (v)-[:VideoVideoSetting]->(vs:VideoSetting)<-[:YouTubeOwnershipVideoSetting]-(o)
  WITH u,
       count(DISTINCT c) as channelCount,
       count(DISTINCT p) as playlistCount,
       count(DISTINCT v) as videoCount,
       count(DISTINCT CASE WHEN cs.isFavourite = true THEN cs END) as favoriteChannelCount,
       count(DISTINCT CASE WHEN ps.isFavourite = true THEN ps END) as favoritePlaylistCount,
       count(DISTINCT CASE WHEN vs.isFavourite = true THEN vs END) as favoriteVideoCount,
       max(c.createdAt) as lastChannelAdded,
       max(p.createdAt) as lastPlaylistAdded,
       max(v.updatedAt) as lastVideoActivity
  RETURN u,
         channelCount,
         playlistCount,
         videoCount,
         favoriteChannelCount,
         favoritePlaylistCount,
         favoriteVideoCount,
         lastChannelAdded,
         lastPlaylistAdded,
         lastVideoActivity
`;

const dataResult = await _.session.run(dataQuery, {
  searchQuery: c.searchQuery || null
});

// Helper to convert Neo4j integers to JS numbers
const toNumber = (value) => {
  if (value === null || value === undefined) return 0;
  if (typeof value === 'number') return value;
  if (_.neo4jDriver.isInt(value)) return value.toNumber();
  return Number(value);
};

// Convert all results to vertex format
let allUsers = dataResult.records.map(record => {
  const user = _.convertNodeToJson(record.get('u'));

  // Remove sensitive fields from user data
  if (user && user.P) {
    delete user.P.password;
    delete user.P.salt;
  }

  return {
    user,
    stats: {
      channelCount: toNumber(record.get('channelCount')),
      playlistCount: toNumber(record.get('playlistCount')),
      videoCount: toNumber(record.get('videoCount')),
      favoriteChannelCount: toNumber(record.get('favoriteChannelCount')),
      favoritePlaylistCount: toNumber(record.get('favoritePlaylistCount')),
      favoriteVideoCount: toNumber(record.get('favoriteVideoCount')),
      lastChannelAdded: record.get('lastChannelAdded')?.toStandardDate().toISOString(),
      lastPlaylistAdded: record.get('lastPlaylistAdded')?.toStandardDate().toISOString(),
      lastVideoActivity: record.get('lastVideoActivity')?.toStandardDate().toISOString()
    }
  };
});

// Apply status filter if provided (server-side filtering)
const filterStatus = c.filterStatus;
if (filterStatus && filterStatus !== 'all') {
  allUsers = allUsers.filter(userdata => {
    const now = Date.now();
    const lastActivity = [
      userdata.stats.lastChannelAdded ? new Date(userdata.stats.lastChannelAdded).getTime() : null,
      userdata.stats.lastPlaylistAdded ? new Date(userdata.stats.lastPlaylistAdded).getTime() : null,
      userdata.stats.lastVideoActivity ? new Date(userdata.stats.lastVideoActivity).getTime() : null
    ].filter(d => d !== null).sort((a, b) => b - a)[0];

    if (!lastActivity) return filterStatus === 'dormant';

    const daysSinceActivity = (now - lastActivity) / (1000 * 60 * 60 * 24);

    if (filterStatus === 'active') return daysSinceActivity < 7;
    if (filterStatus === 'new') return daysSinceActivity >= 7 && daysSinceActivity < 30;
    if (filterStatus === 'dormant') return daysSinceActivity >= 30;

    return true;
  });
}

// Get total count after filtering
const totalCount = allUsers.length;

// Sort by createdAt DESC
allUsers.sort((a, b) => {
  const dateA = new Date(a.user?.P?.createdAt || 0).getTime();
  const dateB = new Date(b.user?.P?.createdAt || 0).getTime();
  return dateB - dateA;
});

// Apply pagination
const offset = c.offset || 0;
const limit = c.limit || 50;
const users = allUsers.slice(offset, offset + limit);

return {
  success: true,
  data: { users, totalCount },
  message: `Found ${users.length} of ${totalCount} users`
};
'''
        key: getAllYTOUsers
      }
    }
  ]
  edges: []
}