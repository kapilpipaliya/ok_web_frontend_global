{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Stop impersonating a user (admin only)
        body:
          '''
const actualUser = await _.getUserFromSession();
if (!actualUser) {
  throw new Error("User session not found");
}

const impersonatedUserUuid = c.impersonatedUserUuid;

if (!impersonatedUserUuid) {
  throw new Error("impersonatedUserUuid is required");
}

// Call platform function (from _)
const result = await _.clearImpersonation(
  _.session,
  actualUser,
  impersonatedUserUuid
);

return {
  success: true,
  data: result,
  message: "Stopped viewing as user"
};
'''
        key: clearImpersonation
      }
    }
  ]
  edges: []
}