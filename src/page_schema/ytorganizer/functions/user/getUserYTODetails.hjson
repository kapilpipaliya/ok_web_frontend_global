{
  vertexes: [
    {
      id: "function_root",
      L: "Function",
      P: {
        key: "getUserYTODetails",
        description: "Get detailed YTO data for a specific user (channels, playlists, videos)",
        body: '''
const actualUser = await args.getUserFromSession();
if (!actualUser) {
  throw new Error("User session not found");
}

// Priority: impersonatedUserUuid (from admin impersonation) > userUuid (explicit parameter)
const targetUserUuid = args.contextData.impersonatedUserUuid || args.contextData.userUuid;
const { ownershipId } = args.contextData; // Optional: filter by specific ownership

if (!targetUserUuid) {
  throw new Error("userUuid is required");
}

// Check if user is viewing their own data or if they're an admin
const isViewingSelf = actualUser.P.uuid === targetUserUuid;

if (!isViewingSelf) {
  // Verify admin role when viewing other users' data
  const adminCheck = await args.session.run(
    `MATCH (u:User {uuid: $userId})-[:UserRole]->(r:Role {key: "Admin"})
     RETURN u`,
    { userId: actualUser.P.uuid }
  );

  if (adminCheck.records.length === 0) {
    throw new Error("Unauthorized: Admin role required to view other users' data");
  }
}

// Get user's channels with video counts using helper function
// If ownershipId is provided, filter by that ownership; otherwise aggregate across all
const channelsResult = await args.executeNamedServerFunction({
  functionName: "getChannelsWithVideoCount",
  contextData: {
    userUuid: targetUserUuid,
    ownershipId  // Optional: filters by ownership if provided
  }
});

const channels = channelsResult.result?.success
  ? channelsResult.result.data
  : [];

// Get user's playlists with video counts using helper function
const playlistsResult = await args.executeNamedServerFunction({
  functionName: "getPlaylistsWithVideoCount",
  contextData: {
    userUuid: targetUserUuid,
    ownershipId  // Optional: filters by ownership if provided
  }
});

const playlists = playlistsResult.result?.success
  ? playlistsResult.result.data
  : [];

// Get user's favorite videos using helper function (limit to 20 most recent)
const videosResult = await args.executeNamedServerFunction({
  functionName: "getVideosWithDetails",
  contextData: {
    userUuid: targetUserUuid,
    ownershipId,  // Optional: filters by ownership if provided
    isFavouriteOnly: true,
    orderBy: 'vs.updatedAt',
    orderDirection: 'DESC',
    limit: 20
  }
});

const favoriteVideos = videosResult.result?.success
  ? videosResult.result.data
  : [];

// NEW SCHEMA v4.0: Get total videos count (direct ownership, not through settings)
const totalVideosQuery = ownershipId
  ? `
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
    MATCH (o)-[:YouTubeOwnershipVideo]->(v:Video)
    RETURN count(DISTINCT v) as totalVideos
  `
  : `
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership)
    MATCH (o)-[:YouTubeOwnershipVideo]->(v:Video)
    RETURN count(DISTINCT v) as totalVideos
  `;

const totalVideosResult = await args.session.run(totalVideosQuery, {
  userUuid: targetUserUuid,
  ...(ownershipId && { ownershipId })
});
const totalVideos = totalVideosResult.records.length > 0
  ? Number(totalVideosResult.records[0].get('totalVideos'))
  : 0;

// Get user plan (default to 'free' if not set)
const userPlanQuery = `
  MATCH (u:User {uuid: $userUuid})
  RETURN u.plan as plan
`;

const userPlanResult = await args.session.run(userPlanQuery, { userUuid: targetUserUuid });
const userPlan = userPlanResult.records.length > 0 && userPlanResult.records[0].get('plan')
  ? userPlanResult.records[0].get('plan')
  : 'free';

return {
  success: true,
  data: {
    channels,
    playlists,
    favoriteVideos,
    totalVideos,
    userPlan
  },
  message: `Found ${channels.length} channels, ${playlists.length} playlists, ${favoriteVideos.length} favorite videos, ${totalVideos} total videos`
};
'''
      }
    }
  ],
  edges: []
}
