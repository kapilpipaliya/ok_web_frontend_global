{
  vertexes: [
    {
      id: "clear_all_user_data_function",
      L: "Function",
      P: {
        key: "clearAllUserData",
        description: "Clears all user-specific data (channel setting, playlist setting, video setting) without deleting the actual channels, playlists, or videos",
        body: '''
try {
  // Get current authenticated user from session
  const currentUser = await args.getUserFromSession();
  if (!currentUser) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Check if this is an admin clearing another user's data
  const targetUserId = args.contextData.userId;
  let userToClear;
  let isAdminClear = false;

  if (targetUserId) {
    // Admin deletion - verify admin role
    const adminCheck = await args.session.run(
      `MATCH (u:User {uuid: $userId})-[:UserRole]->(r:Role {key: "Admin"})
       RETURN u`,
      { userId: currentUser.P.uuid }
    );

    if (adminCheck.records.length === 0) {
      throw new Error("Unauthorized: Admin role required");
    }

    // Get the target user
    const targetUserQuery = `
      MATCH (u:User)
      WHERE elementId(u) = $userId
      RETURN u
    `;

    const targetUserResult = await args.session.run(targetUserQuery, {
      userId: targetUserId
    });

    if (targetUserResult.records.length === 0) {
      throw new Error("Target user not found");
    }

    userToClear = args.convertNodeToJson(targetUserResult.records[0].get('u'));
    isAdminClear = true;
  } else {
    // Self-clearing
    userToClear = currentUser;
  }

  // Step 1: Delete all ownership channel setting and relationships
  const deleteChannelSettingQuery = `
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership)
    MATCH (o)-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
    DETACH DELETE cs
  `;

  const channelSettingResult = await args.session.run(deleteChannelSettingQuery, {
    userUuid: userToClear.P.uuid
  });

  // Step 2: Delete all ownership playlist setting and relationships
  const deletePlaylistSettingQuery = `
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership)
    MATCH (o)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)
    DETACH DELETE ps
  `;

  const playlistSettingResult = await args.session.run(deletePlaylistSettingQuery, {
    userUuid: userToClear.P.uuid
  });

  // Step 3: Delete all ownership video setting and relationships
  const deleteVideoSettingQuery = `
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership)
    MATCH (o)-[:YouTubeOwnershipVideoSetting]->(vs:VideoSetting)
    DETACH DELETE vs
  `;

  const videoSettingResult = await args.session.run(deleteVideoSettingQuery, {
    userUuid: userToClear.P.uuid
  });

  // Get statistics for the response
  const channelSettingDeleted = channelSettingResult.summary.counters.updates().nodesDeleted || 0;
  const playlistSettingDeleted = playlistSettingResult.summary.counters.updates().nodesDeleted || 0;
  const videoSettingDeleted = videoSettingResult.summary.counters.updates().nodesDeleted || 0;

  const username = userToClear.P.username || 'User';
  const message = isAdminClear
    ? `All data for user "${username}" has been cleared successfully.`
    : "All your personal data has been cleared successfully.";

  return {
    success: true,
    message: message,
    data: {
      channelSettingDeleted,
      playlistSettingDeleted,
      videoSettingDeleted,
      totalItemDeleted: channelSettingDeleted + playlistSettingDeleted + videoSettingDeleted,
      userId: userToClear.id,
      username: username,
      clearedAt: new Date().toISOString()
    }
  };

} catch (error) {
  console.error("Error clearing user data:", error);

  // Handle specific error types
  let userMessage = "Failed to clear data. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to clear your data.";
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    },
    data: {
      channelSettingDeleted: 0,
      playlistSettingDeleted: 0,
      videoSettingDeleted: 0,
      totalItemDeleted: 0
    }
  };
}
'''
      }
    }
  ],
  edges: []
}