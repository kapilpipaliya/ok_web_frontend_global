{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Start impersonating a user (admin only)
        body:
          '''
const actualUser = await args.getUserFromSession();
if (!actualUser) {
  throw new Error("User session not found");
}

// Verification of admin role is done by setImpersonation

const targetUserUuid = args.contextData.targetUserUuid;

if (!targetUserUuid) {
  throw new Error("targetUserUuid is required");
}

// Call platform function (from args)
const result = await args.setImpersonation(
  args.session,
  actualUser,
  targetUserUuid
);

return {
  success: true,
  data: result,
  message: `Now viewing as ${result.impersonatedUser.P.username}`
};
'''
        key: impersonateUser
      }
    }
  ]
  edges: []
}