{
  vertexes: [
    {
      id: "delete_channel_function",
      L: "Function",
      P: {
        key: "deleteChannel",
        description: "Deletes a channel from a specific ownership, along with its playlists and videos that are only in this channel for this ownership. Supports multi-ownership model.",
        body: '''
try {
  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Extract parameters
  const { item, itemType, ownershipId } = args.contextData;

  if (!item || itemType !== "channel") {
    throw new Error("Invalid channel data");
  }

  if (!ownershipId) {
    throw new Error("YouTube Ownership ID is required. Please select a YouTube account.");
  }

  const channelId = item.P?.youtubeId;
  if (!channelId) {
    throw new Error("Channel ID not found");
  }

  // Verify ownership belongs to user
  const ownershipCheck = await args.session.run(`
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
    RETURN o
  `, { userUuid: user.P.uuid, ownershipId });

  if (ownershipCheck.records.length === 0) {
    throw new Error("Invalid YouTube ownership. This account doesn't belong to you or no longer exists.");
  }

  // Step 1: Get all playlists in this channel for this ownership
  const getPlaylistsQuery = `
    MATCH (o:YouTubeOwnership {key: $ownershipId})
    MATCH (o)-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)-[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
    MATCH (c)-[:ChannelPlaylist]->(p:Playlist)
    RETURN p.youtubeId as playlistId
  `;

  const playlistsResult = await args.session.run(getPlaylistsQuery, {
    ownershipId,
    channelId: channelId
  });

  const playlistIds = playlistsResult.records.map(record => record.get('playlistId'));

  // Step 2: Delete videos that are only in this channel's playlists for this ownership
  // Only delete videos that don't exist in other playlists or other ownerships
  if (playlistIds.length > 0) {
    const deleteVideosQuery = `
      MATCH (o:YouTubeOwnership {key: $ownershipId})
      MATCH (o)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist)
      WHERE p.youtubeId IN $playlistIds
      MATCH (p)-[:PlaylistVideo]->(v:Video)
      OPTIONAL MATCH (o)-[:YouTubeOwnershipVideoSettings]->(vs:VideoSettings)-[:VideoSettingsVideo]->(v)

      // Check if video exists in other playlists not in deletion list
      OPTIONAL MATCH (otherP:Playlist)-[:PlaylistVideo]->(v)
      WHERE NOT otherP.youtubeId IN $playlistIds

      // Check if other ownerships have this video
      OPTIONAL MATCH (otherO:YouTubeOwnership)-[:YouTubeOwnershipVideoSettings]->(otherVS:VideoSettings)-[:VideoSettingsVideo]->(v)
      WHERE otherO.key <> $ownershipId

      WITH v, vs, otherP, otherO
      WHERE otherP IS NULL AND otherO IS NULL

      // Delete video settings and video node only if no other ownerships
      DETACH DELETE vs, v
      RETURN count(v) as deletedVideos
    `;

    await args.session.run(deleteVideosQuery, {
      ownershipId,
      playlistIds: playlistIds
    });
  }

  // Step 3: Delete all playlists in this channel for this ownership
  if (playlistIds.length > 0) {
    const deletePlaylistsQuery = `
      MATCH (o:YouTubeOwnership {key: $ownershipId})
      MATCH (o)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist)
      WHERE p.youtubeId IN $playlistIds

      // Check if other ownerships have this playlist before deletion
      OPTIONAL MATCH (otherO:YouTubeOwnership)-[:YouTubeOwnershipPlaylistSetting]->(otherPS:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p)
      WHERE otherO.key <> $ownershipId

      WITH ps, p, otherO

      // Delete this ownership's playlist settings
      DETACH DELETE ps

      WITH p, otherO
      WHERE otherO IS NULL

      // Delete playlist node only if no other ownerships
      DETACH DELETE p

      RETURN count(p) as deletedPlaylists
    `;

    await args.session.run(deletePlaylistsQuery, {
      ownershipId,
      playlistIds: playlistIds
    });
  }

  // Step 4: Delete the channel settings and check if channel should be deleted
  const deleteChannelQuery = `
    MATCH (o:YouTubeOwnership {key: $ownershipId})
    MATCH (o)-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)-[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})

    // Get channel title before any deletion and check if other ownerships have this channel
    WITH c, cs, c.title as channelTitle

    // Check if other ownerships have this channel before deletion
    OPTIONAL MATCH (otherO:YouTubeOwnership)-[:YouTubeOwnershipChannelSetting]->(otherCS:ChannelSetting)-[:ChannelSettingChannel]->(c)
    WHERE otherO.key <> $ownershipId

    WITH cs, c, channelTitle, otherO

    // Delete this ownership's channel settings
    DETACH DELETE cs

    WITH c, channelTitle, otherO
    WHERE otherO IS NULL

    // Delete channel node only if no other ownerships
    DETACH DELETE c

    RETURN channelTitle
  `;

  const channelResult = await args.session.run(deleteChannelQuery, {
    ownershipId,
    channelId: channelId
  });

  if (channelResult.records.length === 0) {
    throw new Error("Channel not found or already deleted");
  }

  const channelTitle = item.P?.title || "Channel";

  return {
    success: true,
    data: {
      channelId: channelId,
      deletedPlaylists: playlistIds.length
    },
    message: `Successfully deleted channel "${channelTitle}" and ${playlistIds.length} playlist(s)`
  };

} catch (error) {
  console.error("Error deleting channel:", error);

  let userMessage = "Failed to delete channel. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to delete channels.";
  } else if (error.message.includes("not found")) {
    userMessage = error.message;
  } else if (error.message.includes("Invalid channel data")) {
    userMessage = error.message;
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    }
  };
}
'''
      }
    }
  ],
  edges: []
}
