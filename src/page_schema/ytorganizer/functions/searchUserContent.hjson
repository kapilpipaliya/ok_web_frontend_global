{
  vertexes: [
    {
      id: "search_user_content_function",
      L: "Function",
      P: {
        key: "searchUserContent",
        description: "Search across user's channels, playlists, and videos with optional filters",
        body: '''
try {
  // Extract search parameters from request
  const { query, type, limit = 50, page = 1, isRegex = false } = args.contextData;

  // Ensure limit is a valid integer (Neo4j requires integers, not floats)
  let validLimit = 50; // default
  if (limit !== undefined && limit !== null) {
    const parsed = parseInt(String(limit), 10);
    if (!isNaN(parsed) && parsed > 0) {
      validLimit = Math.min(100, parsed); // Cap at 100 per page for better performance
    }
  }

  // Ensure page is a valid integer
  let validPage = 1; // default
  if (page !== undefined && page !== null) {
    const parsed = parseInt(String(page), 10);
    if (!isNaN(parsed) && parsed > 0) {
      validPage = parsed;
    }
  }

  // Calculate offset for pagination
  const offset = (validPage - 1) * validLimit;

  if (!query || query.trim().length === 0) {
    return {
      success: true,
      data: {
        channels: [],
        playlists: [],
        videos: [],
        totalResults: 0
      },
      message: "Please enter a search query"
    };
  }

  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Prepare search pattern for case-insensitive matching
  const trimmedQuery = query.trim();
  let searchPattern;

  if (isRegex) {
    // Use query as-is for regex search
    searchPattern = `(?i)${trimmedQuery}`;
  } else {
    // Escape special regex characters for literal string matching
    const escapedQuery = trimmedQuery.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    searchPattern = `(?i).*${escapedQuery}.*`;
  }

  const results = {
    channels: [],
    playlists: [],
    videos: []
  };

  const counts = {
    channels: 0,
    playlists: 0,
    videos: 0
  };

  // SEARCH CHANNELS
  if (!type || type === 'all' || type === 'channels') {
    // Get total count for pagination
    const channelsCountQuery = `
      MATCH (u:User {uuid: $userUuid})
      MATCH (u)-[:UserChannelSetting]->(cs:ChannelSetting)-[:ChannelSettingChannel]->(c:Channel)
      WHERE c.title =~ $pattern OR
            c.description =~ $pattern OR
            cs.customName =~ $pattern
      RETURN COUNT(*) as total
    `;

    const channelsCountResult = await args.session.run(channelsCountQuery, {
      userUuid: user.P.uuid,
      pattern: searchPattern
    });

    const channelsTotal = channelsCountResult.records[0]?.get('total');
    counts.channels = channelsTotal ? (typeof channelsTotal.toNumber === 'function' ? channelsTotal.toNumber() : Number(channelsTotal)) : 0;

    // Get paginated results
    const channelsQuery = `
      MATCH (u:User {uuid: $userUuid})
      MATCH (u)-[:UserChannelSetting]->(cs:ChannelSetting)-[:ChannelSettingChannel]->(c:Channel)
      WHERE c.title =~ $pattern OR
            c.description =~ $pattern OR
            cs.customName =~ $pattern
      RETURN c, cs
      ORDER BY cs.createdAt DESC
      SKIP ${offset}
      LIMIT ${validLimit}
    `;

    const channelsResult = await args.session.run(channelsQuery, {
      userUuid: user.P.uuid,
      pattern: searchPattern
    });

    results.channels = channelsResult.records.map(record => ({
      channel: args.convertNodeToJson(record.get('c')),
      channelSettings: args.convertNodeToJson(record.get('cs')),
      matchType: 'channel'
    }));
  }

  // SEARCH PLAYLISTS
  if (!type || type === 'all' || type === 'playlists') {
    // Get total count for pagination
    const playlistsCountQuery = `
      MATCH (u:User {uuid: $userUuid})
      MATCH (u)-[:UserPlaylist]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist)
      WHERE p.title =~ $pattern OR
            p.description =~ $pattern OR
            ps.customName =~ $pattern
      RETURN COUNT(*) as total
    `;

    const playlistsCountResult = await args.session.run(playlistsCountQuery, {
      userUuid: user.P.uuid,
      pattern: searchPattern
    });

    const playlistsTotal = playlistsCountResult.records[0]?.get('total');
    counts.playlists = playlistsTotal ? (typeof playlistsTotal.toNumber === 'function' ? playlistsTotal.toNumber() : Number(playlistsTotal)) : 0;

    // Get paginated results
    const playlistsQuery = `
      MATCH (u:User {uuid: $userUuid})
      MATCH (u)-[:UserPlaylist]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist)
      WHERE p.title =~ $pattern OR
            p.description =~ $pattern OR
            ps.customName =~ $pattern
      OPTIONAL MATCH (c:Channel)-[:ChannelPlaylist]->(p)
      RETURN p, ps, c
      ORDER BY ps.createdAt DESC
      SKIP ${offset}
      LIMIT ${validLimit}
    `;

    const playlistsResult = await args.session.run(playlistsQuery, {
      userUuid: user.P.uuid,
      pattern: searchPattern
    });

    results.playlists = playlistsResult.records.map(record => ({
      playlist: args.convertNodeToJson(record.get('p')),
      playlistSettings: args.convertNodeToJson(record.get('ps')),
      channel: record.get('c') ? args.convertNodeToJson(record.get('c')) : null,
      matchType: 'playlist'
    }));
  }

  // SEARCH VIDEOS
  if (!type || type === 'all' || type === 'videos') {
    // Get total count for pagination
    const videosCountQuery = `
      MATCH (u:User {uuid: $userUuid})
      MATCH (u)-[:UserVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v:Video)
      WHERE v.title =~ $pattern OR
            v.description =~ $pattern OR
            v.channelTitle =~ $pattern OR
            vs.notes =~ $pattern
      RETURN COUNT(*) as total
    `;

    const videosCountResult = await args.session.run(videosCountQuery, {
      userUuid: user.P.uuid,
      pattern: searchPattern
    });

    const videosTotal = videosCountResult.records[0]?.get('total');
    counts.videos = videosTotal ? (typeof videosTotal.toNumber === 'function' ? videosTotal.toNumber() : Number(videosTotal)) : 0;

    // Get paginated results
    const videosQuery = `
      MATCH (u:User {uuid: $userUuid})
      MATCH (u)-[:UserVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v:Video)
      WHERE v.title =~ $pattern OR
            v.description =~ $pattern OR
            v.channelTitle =~ $pattern OR
            vs.notes =~ $pattern
      OPTIONAL MATCH (p:Playlist)-[:PlaylistVideo]->(v)
      OPTIONAL MATCH (u)-[:UserPlaylist]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p)
      WITH v, vs, COLLECT(DISTINCT {playlist: p, playlistSettings: ps}) as playlists
      RETURN v, vs, playlists[0] as firstPlaylist
      ORDER BY vs.updatedAt DESC
      SKIP ${offset}
      LIMIT ${validLimit}
    `;

    const videosResult = await args.session.run(videosQuery, {
      userUuid: user.P.uuid,
      pattern: searchPattern
    });

    results.videos = videosResult.records.map(record => {
      const firstPlaylist = record.get('firstPlaylist');
      return {
        video: args.convertNodeToJson(record.get('v')),
        videoSettings: args.convertNodeToJson(record.get('vs')),
        parentPlaylist: firstPlaylist && firstPlaylist.playlist ? {
          playlist: args.convertNodeToJson(firstPlaylist.playlist),
          playlistSettings: firstPlaylist.playlistSettings ?
            args.convertNodeToJson(firstPlaylist.playlistSettings) : null
        } : null,
        matchType: 'video'
      };
    });
  }

  // Calculate pagination metadata
  const totalResults = results.channels.length + results.playlists.length + results.videos.length;
  const totalCount = counts.channels + counts.playlists + counts.videos;
  const totalPages = Math.ceil(totalCount / validLimit);
  const hasNextPage = validPage < totalPages;
  const hasPrevPage = validPage > 1;

  // Calculate type-specific pagination
  const typePagination = {
    channels: {
      total: counts.channels,
      pages: Math.ceil(counts.channels / validLimit),
      hasNext: type === 'channels' && validPage < Math.ceil(counts.channels / validLimit),
      hasPrev: type === 'channels' && validPage > 1
    },
    playlists: {
      total: counts.playlists,
      pages: Math.ceil(counts.playlists / validLimit),
      hasNext: type === 'playlists' && validPage < Math.ceil(counts.playlists / validLimit),
      hasPrev: type === 'playlists' && validPage > 1
    },
    videos: {
      total: counts.videos,
      pages: Math.ceil(counts.videos / validLimit),
      hasNext: type === 'videos' && validPage < Math.ceil(counts.videos / validLimit),
      hasPrev: type === 'videos' && validPage > 1
    }
  };

  // Prepare summary message
  let message = `Found ${totalCount} total result${totalCount !== 1 ? 's' : ''}`;
  const parts = [];
  if (counts.channels > 0) parts.push(`${counts.channels} channel${counts.channels !== 1 ? 's' : ''}`);
  if (counts.playlists > 0) parts.push(`${counts.playlists} playlist${counts.playlists !== 1 ? 's' : ''}`);
  if (counts.videos > 0) parts.push(`${counts.videos} video${counts.videos !== 1 ? 's' : ''}`);

  if (parts.length > 0) {
    message += `: ${parts.join(', ')}`;
  }

  if (totalPages > 1) {
    message += ` (Page ${validPage} of ${totalPages})`;
  }

  return {
    success: true,
    data: {
      channels: results.channels,
      playlists: results.playlists,
      videos: results.videos,
      totalResults,
      totalCount,
      query,
      type: type || 'all',
      pagination: {
        page: validPage,
        limit: validLimit,
        totalPages,
        totalCount,
        hasNextPage,
        hasPrevPage,
        startIndex: offset + 1,
        endIndex: Math.min(offset + totalResults, totalCount),
        byType: typePagination
      }
    },
    message
  };

} catch (error) {
  console.error("Error searching content:", error);

  // Handle specific error types
  let userMessage = "Failed to search content. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to search your content.";
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "SearchError",
      details: error.message
    },
    data: {
      channels: [],
      playlists: [],
      videos: [],
      totalResults: 0
    }
  };
}
'''
      }
    }
  ],
  edges: []
}