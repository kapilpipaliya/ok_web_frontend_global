{
  vertexes: [
    {
      id: "search_user_content_function",
      L: "Function",
      P: {
        key: "searchUserContent",
        description: "Search across user's channels, playlists, and videos with optional filters",
        body: '''
try {
  // Extract search parameters from request
  const { query, type, isRegex = false } = args.contextData;

  if (!query || query.trim().length === 0) {
    return {
      success: true,
      data: {
        channels: [],
        playlists: [],
        videos: [],
        totalCount: 0
      },
      message: "Please enter a search query"
    };
  }

  // Get current authenticated user from session
  const actualUser = await args.getUserFromSession();
  if (!actualUser) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Get effective user (handles admin impersonation)
  const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

  // Prepare search pattern for case-insensitive matching
  const trimmedQuery = query.trim();
  let searchPattern;

  if (isRegex) {
    // Use query as-is for regex search
    searchPattern = `(?i)${trimmedQuery}`;
  } else {
    // Escape special regex characters for literal string matching
    const escapedQuery = trimmedQuery.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    searchPattern = `(?i).*${escapedQuery}.*`;
  }

  const results = {
    channels: [],
    playlists: [],
    videos: []
  };

  // SEARCH CHANNELS
  if (!type || type === 'all' || type === 'channels') {
    // Get results with user-specific video count
    const channelsQuery = `
      MATCH (u:User {uuid: $userUuid})
      MATCH (u)-[:UserChannelSetting]->(cs:ChannelSetting)-[:ChannelSettingChannel]->(c:Channel)
      WHERE c.title =~ $pattern OR
            c.description =~ $pattern OR
            cs.customName =~ $pattern

      // Find the uploads playlist for this channel and count user's videos in it
      OPTIONAL MATCH (uploadsPlaylist:Playlist {youtubeId: c.uploadsPlaylistId})
      OPTIONAL MATCH (uploadsPlaylist)-[:PlaylistVideo]->(v:Video)
      OPTIONAL MATCH (u)-[:UserVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v)

      WITH c, cs, COUNT(DISTINCT CASE WHEN v IS NOT NULL THEN v END) as videoCount

      RETURN c, cs, videoCount
      ORDER BY cs.createdAt DESC
    `;

    const channelsResult = await args.session.run(channelsQuery, {
      userUuid: user.P.uuid,
      pattern: searchPattern
    });

    results.channels = channelsResult.records.map(record => {
      const channelSetting = args.convertNodeToJson(record.get('cs'));
      const videoCount = record.get('videoCount');

      // Add user-specific video count to channel settings
      if (channelSetting && channelSetting.P) {
        channelSetting.P.userVideoCount = videoCount ? (typeof videoCount.toNumber === 'function' ? videoCount.toNumber() : Number(videoCount)) : 0;
      }

      return {
        channel: args.convertNodeToJson(record.get('c')),
        channelSetting: channelSetting,
        matchType: 'channel'
      };
    });
  }

  // SEARCH PLAYLISTS
  if (!type || type === 'all' || type === 'playlists') {
    // Get results with user-specific video count
    const playlistsQuery = `
      MATCH (u:User {uuid: $userUuid})
      MATCH (u)-[:UserPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist)
      WHERE p.title =~ $pattern OR
            p.description =~ $pattern OR
            ps.customName =~ $pattern
      OPTIONAL MATCH (c:Channel)-[:ChannelPlaylist]->(p)

      // Count videos in this playlist that the user has access to
      OPTIONAL MATCH (p)-[:PlaylistVideo]->(v:Video)
      OPTIONAL MATCH (u)-[:UserVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v)

      WITH p, ps, c, COUNT(DISTINCT CASE WHEN v IS NOT NULL THEN v END) as videoCount

      RETURN p, ps, c, videoCount
      ORDER BY ps.createdAt DESC
    `;

    const playlistsResult = await args.session.run(playlistsQuery, {
      userUuid: user.P.uuid,
      pattern: searchPattern
    });

    results.playlists = playlistsResult.records.map(record => {
      const playlistSetting = args.convertNodeToJson(record.get('ps'));
      const videoCount = record.get('videoCount');

      // Add user-specific video count to playlist settings
      if (playlistSetting && playlistSetting.P) {
        playlistSetting.P.userVideoCount = videoCount ? (typeof videoCount.toNumber === 'function' ? videoCount.toNumber() : Number(videoCount)) : 0;
      }

      return {
        playlist: args.convertNodeToJson(record.get('p')),
        playlistSetting,
        channel: record.get('c') ? args.convertNodeToJson(record.get('c')) : null,
        matchType: 'playlist'
      };
    });
  }

  // SEARCH VIDEOS
  if (!type || type === 'all' || type === 'videos') {
    // Get results
    const videosQuery = `
      MATCH (u:User {uuid: $userUuid})
      MATCH (u)-[:UserVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v:Video)
      WHERE v.title =~ $pattern OR
            v.description =~ $pattern OR
            v.channelTitle =~ $pattern OR
            vs.notes =~ $pattern
      OPTIONAL MATCH (p:Playlist)-[:PlaylistVideo]->(v)
      OPTIONAL MATCH (u)-[:UserPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p)
      WITH v, vs, COLLECT(DISTINCT {playlist: p, playlistSetting: ps}) as playlists
      RETURN v, vs, playlists[0] as firstPlaylist
      ORDER BY vs.updatedAt DESC
    `;

    const videosResult = await args.session.run(videosQuery, {
      userUuid: user.P.uuid,
      pattern: searchPattern
    });

    results.videos = videosResult.records.map(record => {
      const firstPlaylist = record.get('firstPlaylist');
      return {
        video: args.convertNodeToJson(record.get('v')),
        videoSettings: args.convertNodeToJson(record.get('vs')),
        parentPlaylist: firstPlaylist && firstPlaylist.playlist ? {
          playlist: args.convertNodeToJson(firstPlaylist.playlist),
          playlistSetting: firstPlaylist.playlistSetting ?
            args.convertNodeToJson(firstPlaylist.playlistSetting) : null
        } : null,
        matchType: 'video'
      };
    });
  }

  // Calculate total results
  const channelsCount = results.channels.length;
  const playlistsCount = results.playlists.length;
  const videosCount = results.videos.length;
  const totalCount = channelsCount + playlistsCount + videosCount;

  // Prepare summary message
  let message = `Found ${totalCount} total result${totalCount !== 1 ? 's' : ''}`;
  const parts = [];
  if (channelsCount > 0) parts.push(`${channelsCount} channel${channelsCount !== 1 ? 's' : ''}`);
  if (playlistsCount > 0) parts.push(`${playlistsCount} playlist${playlistsCount !== 1 ? 's' : ''}`);
  if (videosCount > 0) parts.push(`${videosCount} video${videosCount !== 1 ? 's' : ''}`);

  if (parts.length > 0) {
    message += `: ${parts.join(', ')}`;
  }

  return {
    success: true,
    data: {
      channels: results.channels,
      playlists: results.playlists,
      videos: results.videos,
      totalCount,
      query,
      type: type || 'all'
    },
    message
  };

} catch (error) {
  console.error("Error searching content:", error);

  // Handle specific error types
  let userMessage = "Failed to search content. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to search your content.";
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "SearchError",
      details: error.message
    },
    data: {
      channels: [],
      playlists: [],
      videos: [],
      totalCount: 0
    }
  };
}
'''
      }
    }
  ],
  edges: []
}