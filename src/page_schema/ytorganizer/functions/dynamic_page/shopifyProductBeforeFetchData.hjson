{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Syncs Shopify products with database when fetching uncategorized products. Fetches all products from Shopify and creates/updates/deletes ShopifyProduct vertices accordingly.
        body:
          '''
// Sync when tableVertexLabel is 'ShopifyProduct'
// For uncategorized: sync all products
// For specific category: fetch existing data first, then sync products in that category
const { tableVertexLabel, showUnassigned, categoryId, parentVertexLabel, toParentEdgeType, enableUserScoping } = args.contextData;

if (tableVertexLabel !== 'ShopifyProduct') {
  // Not Shopify products, skip sync
  return;
}

const isUncategorized = showUnassigned || categoryId === 'uncategorized';

// For specific category, fetch existing products first to get their Shopify IDs
let existingCategoryProducts = [];
let categoryProductIds = new Set();
if (!isUncategorized && categoryId && parentVertexLabel && toParentEdgeType) {
  console.log(`📋 Fetching existing products for category ${categoryId}...`);
  try {
    const fetchResult = await args.executeNamedServerFunction({
      functionName: "getUserContent",
      contextData: {
        tableVertexLabel: 'ShopifyProduct',
        categoryId: categoryId,
        parentVertexLabel: parentVertexLabel,
        toParentEdgeType: toParentEdgeType,
        enableUserScoping: enableUserScoping,
        // Don't pass hooks to avoid recursion
        hooks: null
      }
    });
    
    if (fetchResult?.result?.success && fetchResult.result.data) {
      existingCategoryProducts = fetchResult.result.data;
      // Extract Shopify product IDs from existing products
      for (const product of existingCategoryProducts) {
        const shopifyId = product.P?.id || product.id;
        if (shopifyId) {
          categoryProductIds.add(shopifyId);
        }
      }
      console.log(`📋 Found ${existingCategoryProducts.length} existing products in category (${categoryProductIds.size} unique Shopify IDs)`);
    }
  } catch (error) {
    console.error("Error fetching existing category products:", error);
  }
}

console.log('🔄 Syncing Shopify products with database...');

// Get current authenticated user from session to get shop info
let sessionUser;
try {
  sessionUser = await args.getSessionUser();
} catch (e) {
  console.warn("shopifyProductBeforeFetchData: getSessionUser failed", e);
  return; // Can't sync without shop info
}

const shop = sessionUser?.P?.shop;

if (!shop) {
  console.warn("shopifyProductBeforeFetchData: Shop domain is missing, skipping sync");
  return;
}

// Get Shopify params from session
const shopifyParams = sessionUser?.P?.shopifyParams || {};

// Get Shopify API object
const shopify = args.getShopifyClient();

// Authenticate the request using Shopify's admin authentication
let admin;
try {
  const origin = args.request ? new URL(args.request.url).origin : "https://ysaar.com";
  const url = new URL(`${origin}/shopify`);
  for (const [key, value] of Object.entries(shopifyParams)) {
    if (typeof value !== "undefined" && value !== null) {
      url.searchParams.append(key, String(value));
    }
  }

  const request = {
    query: shopifyParams,
    url: url.toString(),
    headers: {
      get(name) {
        if (shopifyParams.headers && typeof shopifyParams.headers[name] !== "undefined") {
          return shopifyParams.headers[name];
        }
        return undefined;
      },
      has(name) {
        return shopifyParams.headers && typeof shopifyParams.headers[name] !== "undefined";
      }
    },
  };

  const authResult = await shopify.unauthenticated.admin(shop);
  admin = authResult.admin;
} catch (authError) {
  console.error("shopifyProductBeforeFetchData: Shopify authentication failed", authError);
  return; // Can't sync without authentication
}

// Fetch all products from Shopify using pagination
const commonProductFields = `
  id
  title
  descriptionHtml
  vendor
  productType
  createdAt
  updatedAt
  publishedAt
  status
  tags
  handle
  variants(first: 20) {
    edges {
      node {
        title
        price
        compareAtPrice
        sku
        inventoryQuantity
        taxable
        barcode
        inventoryPolicy
        id
        taxCode
        updatedAt
      }
    }
  }
  media(first: 20) {
    edges {
      node {
        alt
        id
        mediaContentType
        mediaErrors {
          code
          details
          message
        }
        mediaWarnings {
          code
          message
        }
        preview {
          status
          image {
            altText
            height
            id
            metafields (first:10) {
              nodes {
                key
                value
              }
            }
            url
            width
          }
        }
        status
      }
    }
  }
  options {
    name
    position
    values
  }
  metafields(first: 20) {
    edges {
      node {
        key
        value
        type
        namespace
      }
    }
  }
  category {
    id
    level
    name
    parentId
    isRoot
    isArchived
    isLeaf
    fullName
  }
  collections (first:20) {
    nodes {
      title
      id
    }
  }
  mediaCount {
    count
    precision
  }
  onlineStoreUrl
  totalInventory
  tracksInventory
`;

let allShopifyProducts = [];

if (isUncategorized) {
  // For uncategorized, fetch all products with pagination
  let hasNextPage = true;
  let cursor = null;

  console.log('📦 Fetching all products from Shopify...');

  while (hasNextPage) {
    // Construct pagination parameters
    const paginationParams = cursor ? `first: 250, after: "${cursor}"` : `first: 250`;
    
    const productsQuery = `
      query {
        products(${paginationParams}) {
          edges {
            node {
              ${commonProductFields}
            }
            cursor
          }
          pageInfo {
            hasNextPage
          }
        }
      }
    `;

    try {
      const response = await admin.graphql(productsQuery);
      
      // Handle Response object - extract JSON if it's a Response
      let apiResponse;
      if (response instanceof Response) {
        apiResponse = await response.json();
      } else {
        apiResponse = response;
      }

      if (apiResponse.errors && apiResponse.errors.length > 0) {
        console.error("Shopify Admin GraphQL errors:", apiResponse.errors);
        break; // Stop pagination on error
      }

      const pageProducts = apiResponse.data.products.edges.map((edge) => {
        const node = edge.node;
        return {
          ...node,
          variants: node.variants?.edges?.map((v) => v.node) || [],
          media: node.media?.edges?.map((m) => m.node) || [],
          metafields: node.metafields?.edges?.map((m) => m.node) || [],
          collections: node.collections?.nodes || []
        };
      });

      allShopifyProducts = [...allShopifyProducts, ...pageProducts];
      
      // Update pagination variables
      hasNextPage = apiResponse.data.products.pageInfo.hasNextPage;
      if (hasNextPage && apiResponse.data.products.edges.length > 0) {
        cursor = apiResponse.data.products.edges[apiResponse.data.products.edges.length - 1].cursor;
      }
      
      console.log(`📦 Retrieved ${allShopifyProducts.length} products so far...`);
      
      // Small delay to avoid rate limiting
      await new Promise(resolve => setTimeout(resolve, 500));
    } catch (error) {
      console.error("Error fetching products from Shopify:", error);
      break; // Stop pagination on error
    }
  }
} else if (categoryProductIds.size > 0) {
  // For specific category, only fetch products that exist in the category
  console.log(`📦 Fetching ${categoryProductIds.size} specific products from Shopify...`);
  
  // Convert Set to Array for GraphQL query
  const productIdsArray = Array.from(categoryProductIds);
  
  // Shopify GraphQL supports fetching multiple products by ID
  // We'll batch them in chunks of 50 to avoid query size limits
  const batchSize = 50;
  for (let i = 0; i < productIdsArray.length; i += batchSize) {
    const batch = productIdsArray.slice(i, i + batchSize);
    const productIdsString = batch.map(id => `"${id}"`).join(', ');
    
    const productsQuery = `
      query {
        nodes(ids: [${productIdsString}]) {
          ... on Product {
            ${commonProductFields}
          }
        }
      }
    `;
    
    try {
      const response = await admin.graphql(productsQuery);
      
      // Handle Response object - extract JSON if it's a Response
      let apiResponse;
      if (response instanceof Response) {
        apiResponse = await response.json();
      } else {
        apiResponse = response;
      }

      if (apiResponse.errors && apiResponse.errors.length > 0) {
        console.error("Shopify Admin GraphQL errors:", apiResponse.errors);
        continue; // Skip this batch on error
      }

      const batchProducts = (apiResponse.data.nodes || []).map((node) => {
        if (!node) return null;
        return {
          ...node,
          variants: node.variants?.edges?.map((v) => v.node) || [],
          media: node.media?.edges?.map((m) => m.node) || [],
          metafields: node.metafields?.edges?.map((m) => m.node) || [],
          collections: node.collections?.nodes || []
        };
      }).filter(Boolean);

      allShopifyProducts = [...allShopifyProducts, ...batchProducts];
      
      console.log(`📦 Retrieved ${allShopifyProducts.length} products so far...`);
      
      // Small delay to avoid rate limiting
      await new Promise(resolve => setTimeout(resolve, 500));
    } catch (error) {
      console.error(`Error fetching batch ${i / batchSize + 1} from Shopify:`, error);
      continue; // Skip this batch on error
    }
  }
} else {
  console.log('📦 No products to fetch from Shopify for this category');
}

console.log(`✅ Found ${allShopifyProducts.length} products in Shopify`);

// Get existing ShopifyProduct vertices from database
// For specific category, use the products we already fetched
// For uncategorized, fetch all products from database
const existingProducts = new Map();

if (isUncategorized) {
  // For uncategorized, fetch all products from database
  const existingProductsResult = await args.session.run(
    `MATCH (p:ShopifyProduct)
     RETURN elementId(p) as elementId, p.id as id`,
    {}
  );

  for (const record of existingProductsResult.records) {
    const elementId = record.get('elementId');
    const id = record.get('id');
    if (id) {
      existingProducts.set(id, elementId);
    }
  }
  console.log(`📊 Found ${existingProducts.size} existing products in database`);
} else if (existingCategoryProducts.length > 0) {
  // For specific category, use the products we already fetched
  for (const product of existingCategoryProducts) {
    const shopifyId = product.P?.id;
    const elementId = product.id; // This is the database elementId
    if (shopifyId && elementId) {
      existingProducts.set(shopifyId, elementId);
    }
  }
  console.log(`📊 Found ${existingProducts.size} existing products in category`);
}

// For specific category, we already have only category products in existingProducts
// For uncategorized, we have all products in existingProducts
const productsToConsiderForDeletion = existingProducts;

// Extract Shopify product IDs from fetched products
const shopifyProductIds = new Set(allShopifyProducts.map(p => p.id));

// Find products to delete (exist in DB but not in Shopify)
// Only delete products that are in the category (if not uncategorized)
const productsToDelete = [];
for (const [id, dbId] of productsToConsiderForDeletion) {
  if (!shopifyProductIds.has(id)) {
    productsToDelete.push(dbId);
  }
}

// Delete products that no longer exist in Shopify
if (productsToDelete.length > 0) {
  console.log(`🗑️  Deleting ${productsToDelete.length} products that no longer exist in Shopify...`);
  await args.session.run(
    `MATCH (p:ShopifyProduct)
     WHERE elementId(p) IN $ids
     DETACH DELETE p`,
    { ids: productsToDelete }
  );
  console.log(`✅ Deleted ${productsToDelete.length} products`);
}

// Create or update products
// For specific category, we already fetched only products in that category
// For uncategorized, we fetched all products
let createdCount = 0;
let updatedCount = 0;

for (const shopifyProduct of allShopifyProducts) {
  const id = shopifyProduct.id;
  const existingDbId = existingProducts.get(id);

  // Prepare product properties
  const productProperties = {
    id: id,
    title: shopifyProduct.title || '',
    handle: shopifyProduct.handle || '',
    descriptionHtml: shopifyProduct.descriptionHtml || '',
    vendor: shopifyProduct.vendor || '',
    productType: shopifyProduct.productType || '',
    status: shopifyProduct.status || '',
    tags: shopifyProduct.tags || [],
    createdAt: shopifyProduct.createdAt || new Date().toISOString(),
    updatedAt: shopifyProduct.updatedAt || new Date().toISOString(),
    publishedAt: shopifyProduct.publishedAt || null,
    onlineStoreUrl: shopifyProduct.onlineStoreUrl || null,
    totalInventory: shopifyProduct.totalInventory || 0,
    tracksInventory: shopifyProduct.tracksInventory || false,
    variantsCount: shopifyProduct.variants?.length || 0,
    // Store complex objects as JSON strings
    variants: JSON.stringify(shopifyProduct.variants || []),
    media: JSON.stringify(shopifyProduct.media || []),
    metafields: JSON.stringify(shopifyProduct.metafields || []),
    collections: JSON.stringify(shopifyProduct.collections || []),
    options: JSON.stringify(shopifyProduct.options || []),
    category: shopifyProduct.category ? JSON.stringify(shopifyProduct.category) : null
  };

  if (existingDbId) {
    // Update existing product
    const propertyKeys = Object.keys(productProperties);
    const propertyAssignments = propertyKeys.map((key, index) => `p.${key} = $prop${index}`).join(', ');

    await args.session.run(
      `MATCH (p:ShopifyProduct)
       WHERE elementId(p) = $id
       SET ${propertyAssignments},
           p.updatedAt = datetime()`,
      {
        id: existingDbId,
        ...Object.fromEntries(Object.entries(productProperties).map(([key, value], index) => [`prop${index}`, value]))
      }
    );
    updatedCount++;
  } else {
    // Create new product
    const propertyKeys = Object.keys(productProperties);
    const propertyAssignments = propertyKeys.map((key, index) => `p.${key} = $prop${index}`).join(', ');

    await args.session.run(
      `CREATE (p:ShopifyProduct)
       SET ${propertyAssignments},
           p.createdAt = datetime(),
           p.updatedAt = datetime()`,
      Object.fromEntries(Object.entries(productProperties).map(([key, value], index) => [`prop${index}`, value]))
    );
    createdCount++;
  }
}

console.log(`✅ Sync complete: Created ${createdCount}, Updated ${updatedCount}, Deleted ${productsToDelete.length}`);
'''
        key: shopifyProductBeforeFetchData
      }
    }
  ]
  edges: []
}

