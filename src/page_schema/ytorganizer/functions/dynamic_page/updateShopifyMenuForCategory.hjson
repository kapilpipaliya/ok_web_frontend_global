{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Updates a Shopify menu for a parent category with all nested children.
        body:
          '''
// Extract parameters
const { categoryElementId, categoryName, menuId, shop, shopifyParams } = args.contextData;

if (!categoryElementId || !categoryName || !menuId || !shop) {
  return {
    success: false,
    error: "categoryElementId, categoryName, menuId, and shop are required"
  };
}

// Get Shopify API object
const shopify = args.getShopifyClient();

// Authenticate the request using Shopify's admin authentication
let admin;
try {
  const authResult = await shopify.unauthenticated.admin(shop);
  admin = authResult.admin;
} catch (authError) {
  console.error("updateShopifyMenuForCategory: Shopify authentication failed", authError);
  return {
    success: false,
    error: "Shopify authentication failed"
  };
}

if (!admin) {
  return {
    success: false,
    error: "Shopify admin client not available"
  };
}

try {
  const menuTitle = categoryName;

  // Build nested menu structure with all levels of children
  const nestedResult = await args.executeNamedServerFunction({
    functionName: "buildNestedMenuItems",
    contextData: {
      parentElementId: categoryElementId
    }
  });
  
  const menuItems = nestedResult.result?.success ? (nestedResult.result.menuItems || []) : [];

  // Update menu
  const updateMenuMutation = `
    mutation menuUpdate($id: ID!, $title: String, $items: [MenuItemCreateInput!]) {
      menuUpdate(id: $id, title: $title, items: $items) {
        menu {
          id
          handle
          title
          items {
            id
            title
            type
            resourceId
          }
        }
        userErrors {
          field
          message
        }
      }
    }
  `;

  const updateResponse = await admin.graphql(updateMenuMutation, {
    variables: { 
      id: menuId,
      title: menuTitle,
      items: menuItems
    }
  });
  
  let updateApiResponse;
  if (updateResponse instanceof Response) {
    updateApiResponse = await updateResponse.json();
  } else {
    updateApiResponse = updateResponse;
  }

  if (updateApiResponse.errors && updateApiResponse.errors.length > 0) {
    console.error("Shopify GraphQL errors:", updateApiResponse.errors);
    return {
      success: false,
      error: "Shopify GraphQL errors",
      details: updateApiResponse.errors
    };
  }

  const userErrors = updateApiResponse.data?.menuUpdate?.userErrors || [];
  if (userErrors.length > 0) {
    console.error("User errors updating menu:", userErrors);
    return {
      success: false,
      error: "User errors updating menu",
      details: userErrors
    };
  }

  const updatedMenu = updateApiResponse.data?.menuUpdate?.menu;
  if (!updatedMenu) {
    return {
      success: false,
      error: "Menu update succeeded but no menu returned"
    };
  }

  // Update parent category with menu info
  await args.session.run(
    `MATCH (c:ShopifyProductCategory)
     WHERE elementId(c) = $elementId
     SET c.menuId = $menuId,
         c.menuHandle = $menuHandle,
         c.updatedAt = datetime()`,
    {
      elementId: categoryElementId,
      menuId: updatedMenu.id,
      menuHandle: updatedMenu.handle
    }
  );

  return {
    success: true,
    menu: updatedMenu,
    menuId: updatedMenu.id,
    menuHandle: updatedMenu.handle
  };
} catch (error) {
  console.error("updateShopifyMenuForCategory: Error updating menu:", error);
  return {
    success: false,
    error: error.message || "Error updating menu"
  };
}
'''
        key: updateShopifyMenuForCategory
      }
    }
  ]
  edges: []
}

