{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Fetches user content with filtering, sorting, and search support. Works with any tableVertexLabel.
        body:
          '''
// Get current authenticated user from session
const actualUser = await args.getUserFromSession();
if (!actualUser) {
  return {
    success: false,
    message: "User session not found. Please log in and try again.",
    data: []
  };
}

// Get effective user (handles admin impersonation)
const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

// Extract parameters
const { 
  tableVertexLabel, 
  search, 
  filters = {}, 
  sort = {},
  categoryId,
  showUnassigned,
  parentVertexLabel,
  toParentEdgeType
} = args.contextData;

if (!tableVertexLabel || typeof tableVertexLabel !== "string") {
  return {
    success: false,
    message: "tableVertexLabel is required and must be a string",
    data: []
  };
}

// Determine vertex label and relationship type based on tableVertexLabel
const vertexLabel = tableVertexLabel;
// Relationship type is "User" + vertexLabel (e.g., "UserBook", "UserAudioVideo", "UserCategory")
const relationshipType = `User${vertexLabel}`;

// Build WHERE clause for filters
const whereConditions = [];
const queryParams = { userUuid: user.P.uuid };

// Add search filter
if (search && search.trim()) {
  const searchTerm = search.trim().toLowerCase();
  whereConditions.push(`(
    toLower(COALESCE(c.name, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.description, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.title, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.subTitle, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.event, '')) CONTAINS $searchTerm OR
    toLower(COALESCE(c.language, '')) CONTAINS $searchTerm
  )`);
  queryParams.searchTerm = searchTerm;
}

// Add column filters
if (filters && typeof filters === "object") {
  for (const [key, value] of Object.entries(filters)) {
    if (value !== undefined && value !== null && value !== "") {
      const paramKey = `filter_${key}`;
      whereConditions.push(`c.${key} = $${paramKey}`);
      queryParams[paramKey] = value;
    }
  }
}

const whereClause = whereConditions.length > 0 
  ? "WHERE " + whereConditions.join(" AND ")
  : "";

// Build ORDER BY clause
let orderByClause = "";
if (sort && sort.column) {
  const direction = sort.direction === "desc" ? "DESC" : "ASC";
  orderByClause = `ORDER BY c.${sort.column} ${direction}`;
} else {
  // Default sorting - try name first, then title, then createdAt
  orderByClause = "ORDER BY COALESCE(c.name, c.title, '') ASC, c.createdAt DESC";
}

// Build category filter if provided
let categoryFilter = "";
if (categoryId && parentVertexLabel && toParentEdgeType) {
  // Filter by category relationship - content points to category: content-[toParentEdgeType]->category
  categoryFilter = `
  MATCH (cat:${parentVertexLabel})
  WHERE elementId(cat) = $categoryId
  MATCH (c)-[:${toParentEdgeType}]->(cat)`;
  queryParams.categoryId = categoryId;
} else if (showUnassigned && parentVertexLabel && toParentEdgeType) {
  // Show items without any category relationship
  const unassignedCondition = `NOT EXISTS {
    MATCH (c)-[:${toParentEdgeType}]->(cat:${parentVertexLabel})
  }`;
  if (whereClause) {
    whereClause = whereClause + " AND " + unassignedCondition;
  } else {
    whereClause = "WHERE " + unassignedCondition;
  }
}

// Optimized query with indexed user lookup first and related vertices
let query = "";
if (categoryId && parentVertexLabel && toParentEdgeType) {
  // Query with category filter - content points to category: content-[toParentEdgeType]->category
  query = `
  MATCH (u:User {uuid: $userUuid})
  MATCH (cat:${parentVertexLabel})
  WHERE elementId(cat) = $categoryId
  MATCH (c:${vertexLabel})-[catRel:${toParentEdgeType}]->(cat)
  MATCH (u)-[:${relationshipType}]->(c)
  ${whereClause}
  OPTIONAL MATCH (c)-[r]->(related)
  ${orderByClause}
  RETURN c, collect(DISTINCT {rel: type(r), target: related}) as relationships
  `;
} else {
  // Standard query without category filter
  query = `
  MATCH (u:User {uuid: $userUuid})
  MATCH (u)-[:${relationshipType}]->(c:${vertexLabel})
  ${whereClause}
  OPTIONAL MATCH (c)-[r]->(related)
  ${orderByClause}
  RETURN c, collect(DISTINCT {rel: type(r), target: related}) as relationships
  `;
}

const result = await args.session.run(query, queryParams);

// Convert to vertex format with relationships
const itemsMap = new Map();
result.records.forEach(record => {
  const node = record.get('c');
  const vertex = args.convertNodeToJson(node);
  const elementId = node.elementId;

  if (!itemsMap.has(elementId)) {
    // Initialize vertex with OUT relationships structure
    vertex.OUT = {};
    itemsMap.set(elementId, vertex);
  }

  // Add relationships
  const relationships = record.get('relationships') || [];
  relationships.forEach(relData => {
    if (relData.rel && relData.target) {
      const targetVertex = args.convertNodeToJson(relData.target);
      if (!itemsMap.get(elementId).OUT[relData.rel]) {
        itemsMap.get(elementId).OUT[relData.rel] = [];
      }
      itemsMap.get(elementId).OUT[relData.rel].push(relData.target.elementId);

      // Also store the related vertex for easy access
      if (!itemsMap.has(relData.target.elementId)) {
        itemsMap.set(relData.target.elementId, targetVertex);
      }
    }
  });
});

const items = Array.from(itemsMap.values()).filter(v => v.L.includes(vertexLabel));

return {
  success: true,
  data: items,
  relatedVertices: Array.from(itemsMap.values()).filter(v => !v.L.includes(vertexLabel)),
  message: `Found ${items.length} ${tableVertexLabel} item${items.length !== 1 ? 's' : ''}`
};
'''
        key: getUserContent
      }
    }
  ]
  edges: []
}