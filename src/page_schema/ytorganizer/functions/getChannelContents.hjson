{
  vertexes: [
    {
      id: "get_channel_contents_function",
      L: "Function",
      P: {
        key: "getChannelContents",
        description: "Fetches a single channel's playlists for the current user",
        body: '''
try {
  // Extract channel ID from request parameters
  const { channelId } = args.contextData;

  if (!channelId) {
    throw new Error("Channel ID is required");
  }

  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Verify user has access to this channel and get user-specific video count
  const channelAccessQuery = `
    MATCH (u:User {uuid: $userUuid})
    MATCH (u)-[:UserChannelSetting]->(cs:ChannelSetting)-[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})

    // Find the uploads playlist for this channel and count user's videos in it
    OPTIONAL MATCH (uploadsPlaylist:Playlist {youtubeId: c.uploadsPlaylistId})
    OPTIONAL MATCH (uploadsPlaylist)-[:PlaylistVideo]->(v:Video)
    OPTIONAL MATCH (u)-[:UserVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v)

    WITH c, cs, COUNT(DISTINCT CASE WHEN v IS NOT NULL THEN v END) as videoCount

    RETURN c, cs, videoCount
  `;

  const channelAccessResult = await args.session.run(channelAccessQuery, {
    userUuid: user.P.uuid,
    channelId
  });

  if (channelAccessResult.records.length === 0) {
    throw new Error("Channel not found or access denied");
  }

  const channelRecord = channelAccessResult.records[0];
  const channel = args.convertNodeToJson(channelRecord.get('c'));
  const channelSetting = args.convertNodeToJson(channelRecord.get('cs'));
  const channelVideoCount = channelRecord.get('videoCount');

  // Add user-specific video count to channel settings
  if (channelSetting && channelSetting.P) {
    channelSetting.P.userVideoCount = channelVideoCount ? (typeof channelVideoCount.toNumber === 'function' ? channelVideoCount.toNumber() : Number(channelVideoCount)) : 0;
  }

  // Fetch all playlists in this channel with user settings and user-specific video count
  const playlistsQuery = `
    MATCH (c:Channel {youtubeId: $channelId})-[:ChannelPlaylist]->(p:Playlist)
    MATCH (u:User {uuid: $userUuid})
    OPTIONAL MATCH (u)-[:UserPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p)

    // Count videos in this playlist that the user has access to
    OPTIONAL MATCH (p)-[:PlaylistVideo]->(v:Video)
    OPTIONAL MATCH (u)-[:UserVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v)

    WITH p, ps, COUNT(DISTINCT CASE WHEN v IS NOT NULL THEN v END) as videoCount

    RETURN p, ps, videoCount
    ORDER BY p.publishedAt DESC
  `;

  const playlistsResult = await args.session.run(playlistsQuery, {
    channelId,
    userUuid: user.P.uuid
  });

  // Return raw converted nodes for frontend processing with user-specific video count
  const playlists = playlistsResult.records.map(record => {
    const playlistSettings = record.get('ps') ? args.convertNodeToJson(record.get('ps')) : null;
    const videoCount = record.get('videoCount');

    // Add user-specific video count to playlist settings
    if (playlistSettings && playlistSettings.P) {
      playlistSettings.P.userVideoCount = videoCount ? (typeof videoCount.toNumber === 'function' ? videoCount.toNumber() : Number(videoCount)) : 0;
    }

    return {
      playlist: args.convertNodeToJson(record.get('p')),
      playlistSettings: playlistSettings
    };
  });

  // Return raw converted nodes for frontend processing
  const channelData = {
    channel: channel,
    channelSetting: channelSetting
  };

  return {
    success: true,
    data: {
      channel: channelData,
      playlists,
      statistics: {
        totalPlaylists: playlists.length,
        userSavedPlaylists: playlists.filter(p => p.isUserSaved).length
      },
      userId: user.id
    },
    message: `Found ${playlists.length} playlists in channel`
  };

} catch (error) {
  console.error("Error fetching channel contents:", error);

  // Handle specific error types
  let userMessage = "Failed to fetch channel contents. Please try again.";

  if (error.message.includes("Channel ID is required")) {
    userMessage = "Channel ID is required.";
  } else if (error.message.includes("User session not found")) {
    userMessage = "Please log in to view channel contents.";
  } else if (error.message.includes("Channel not found or access denied")) {
    userMessage = "Channel not found or you don't have access to it.";
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    },
    data: {
      channel: null,
      playlists: [],
      statistics: {
        totalPlaylists: 0,
        userSavedPlaylists: 0
      }
    }
  };
}
'''
      }
    }
  ],
  edges: []
}