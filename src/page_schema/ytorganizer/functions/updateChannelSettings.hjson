{
  vertexes: [
    {
      id: "update_channel_settings_function",
      L: "Function",
      P: {
        key: "updateChannelSettings",
        description: "Updates channel settings like custom name",
        body: '''
try {
  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  const { youtubeId, customName } = args.contextData;

  if (!youtubeId) {
    throw new Error("Channel ID is required");
  }

  // Update ChannelSetting and get video count
  const updateQuery = `
    MATCH (u:User {uuid: $userUuid})
    MATCH (u)-[:UserChannelSetting]->(cs:ChannelSetting)-[:ChannelSettingChannel]->(c:Channel {youtubeId: $youtubeId})
    SET cs.customName = $customName,
        cs.updatedAt = datetime()

    WITH u, c, cs

    // Find the uploads playlist for this channel and count user's videos in it
    OPTIONAL MATCH (uploadsPlaylist:Playlist {youtubeId: c.uploadsPlaylistId})
    OPTIONAL MATCH (uploadsPlaylist)-[:PlaylistVideo]->(v:Video)
    OPTIONAL MATCH (u)-[:UserVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v)

    WITH c, cs, COUNT(DISTINCT CASE WHEN v IS NOT NULL THEN v END) as videoCount

    RETURN c, cs, videoCount
  `;

  const result = await args.session.run(updateQuery, {
    userUuid: user.P.uuid,
    youtubeId,
    customName: customName || null
  });

  if (result.records.length === 0) {
    throw new Error("Channel not found");
  }

  const channel = args.convertNodeToJson(result.records[0].get('c'));
  const channelSetting = args.convertNodeToJson(result.records[0].get('cs'));
  const channelVideoCount = result.records[0].get('videoCount');

  // Add user-specific video count to channel settings
  if (channelSetting && channelSetting.P) {
    channelSetting.P.userVideoCount = channelVideoCount ? (typeof channelVideoCount.toNumber === 'function' ? channelVideoCount.toNumber() : Number(channelVideoCount)) : 0;
  }

  return {
    success: true,
    message: "Channel settings updated successfully",
    data: {
      channel: channel,
      channelSetting: channelSetting
    }
  };

} catch (error) {
  console.error("Error updating channel settings:", error);

  let userMessage = "Failed to update channel settings. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to update channel settings.";
  } else if (error.message.includes("Channel not found")) {
    userMessage = "Channel not found.";
  } else if (error.message.includes("Channel ID is required")) {
    userMessage = "Channel ID is required.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "UpdateError",
      details: error.message
    }
  };
}
'''
      }
    }
  ],
  edges: []
}
