{
  vertexes: [
    {
      id: "update_channel_settings_function",
      L: "Function",
      P: {
        key: "updateChannelSettings",
        description: "Updates channel settings like custom name. Supports multi-ownership model - requires ownershipId.",
        body: '''
try {
  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  const { youtubeId, customName, ownershipId } = args.contextData;

  if (!youtubeId) {
    throw new Error("Channel ID is required");
  }

  if (!ownershipId) {
    throw new Error("YouTube Ownership ID is required. Please select a YouTube account.");
  }

  // Verify ownership belongs to user
  const ownershipCheck = await args.session.run(`
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
    RETURN o
  `, { userUuid: user.P.uuid, ownershipId });

  if (ownershipCheck.records.length === 0) {
    throw new Error("Invalid YouTube ownership. This account doesn't belong to you or no longer exists.");
  }

  // Step 1: Update ChannelSetting for specific ownership
  const updateQuery = `
    MATCH (o:YouTubeOwnership {key: $ownershipId})
    MATCH (o)-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)-[:ChannelSettingChannel]->(c:Channel {youtubeId: $youtubeId})
    SET cs.customName = $customName,
        cs.updatedAt = datetime()
    RETURN c.youtubeId as youtubeId
  `;

  const updateResult = await args.session.run(updateQuery, {
    ownershipId,
    youtubeId,
    customName: customName || null
  });

  if (updateResult.records.length === 0) {
    throw new Error("Channel not found");
  }

  // Step 2: Fetch updated channel with video count using helper function
  const fetchResult = await args.executeNamedServerFunction({
    functionName: "getChannelsWithVideoCount",
    contextData: {
      userUuid: user.P.uuid,
      ownershipId,  // Filter by specific ownership
      channelIds: [youtubeId]
    }
  });

  if (!fetchResult.result || !fetchResult.result.success || fetchResult.result.data.length === 0) {
    throw new Error("Failed to fetch updated channel data");
  }

  const channelData = fetchResult.result.data[0];

  return {
    success: true,
    message: "Channel settings updated successfully",
    data: channelData
  };

} catch (error) {
  console.error("Error updating channel settings:", error);

  let userMessage = "Failed to update channel settings. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to update channel settings.";
  } else if (error.message.includes("Channel not found")) {
    userMessage = "Channel not found.";
  } else if (error.message.includes("Channel ID is required")) {
    userMessage = "Channel ID is required.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "UpdateError",
      details: error.message
    }
  };
}
'''
      }
    }
  ],
  edges: []
}
