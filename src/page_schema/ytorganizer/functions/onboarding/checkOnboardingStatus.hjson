{
  vertexes: [
    {
      id: "1"
      L: "Function"
      P: {
        key: "checkOnboardingStatus"
        description: "Checks if user has completed onboarding and optionally marks it as complete"
        body: '''
try {
  // Get current user
  const user = await args.getUserFromSession();
  if (!user) {
    return {
      success: false,
      message: "User not authenticated",
      data: { isOnboarded: false }
    };
  }

  const { markComplete } = args.contextData || {};

  // Check if user has onboarding status in setting
  const settingResult = await args.session.run(`
    MATCH (u:User {uuid: $userUuid})
    RETURN u.ytoOnboardingComplete as onboardingComplete
  `, { userUuid: user.P.uuid });

  let isOnboarded = false;
  if (settingResult.records.length > 0) {
    isOnboarded = settingResult.records[0].get('onboardingComplete') || false;
  }

  // If marking as complete
  if (markComplete && !isOnboarded) {
    // Validate that user has at least one connected YouTube account
    const ownershipsResult = await args.session.run(`
      MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership)
      RETURN COUNT(o) as ownershipCount
    `, { userUuid: user.P.uuid });

    const ownershipCountValue = ownershipsResult.records[0]?.get('ownershipCount');
    const ownershipCount = ownershipCountValue?.toNumber ? ownershipCountValue.toNumber() : Number(ownershipCountValue) || 0;

    if (ownershipCount === 0) {
      return {
        success: false,
        error: "Please connect at least one YouTube account before completing onboarding. Click 'Go to Accounts' above to connect your account.",
        data: {
          isOnboarded: false,
          userId: user.id,
          ownershipCount: 0
        }
      };
    }

    await args.session.run(`
      MATCH (u:User {uuid: $userUuid})
      SET u.ytoOnboardingComplete = true,
          u.ytoOnboardingCompletedAt = datetime()
    `, { userUuid: user.P.uuid });

    isOnboarded = true;
  }

  return {
    success: true,
    message: isOnboarded ? "Onboarding complete" : "Onboarding not complete",
    data: {
      isOnboarded,
      userId: user.id
    }
  };

} catch (error) {
  console.error('Error checking onboarding status:', error);
  return {
    success: false,
    message: "Failed to check onboarding status",
    error: {
      type: "OnboardingCheckError",
      details: error.message
    }
  };
}
'''
      }
    }
  ]
  edges: []
}
