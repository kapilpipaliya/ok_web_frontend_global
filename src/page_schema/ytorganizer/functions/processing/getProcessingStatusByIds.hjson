{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Fetches processing status for specific channel and playlist IDs
        body:
          '''
const { channelIds = [], playlistIds = [], ownershipId } = args.contextData;

// Get current authenticated user from session
const actualUser = await args.getUserFromSession();
if (!actualUser) {
  return {
    success: false,
    message: "User session not found"
  };
}

// Get effective user (handles admin impersonation)
const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

let channels = [];
let playlists = [];

// Fetch channel processing status for specific IDs with video counts
if (channelIds.length > 0) {
  const channelResult = await args.executeNamedServerFunction({
    functionName: "getChannelsWithVideoCount",
    contextData: {
      userUuid: user.P.uuid,
      ownershipId,  // Filter by ownership if provided
      channelIds: channelIds,
      // statusFilter: ['queued', 'processing']
    }
  });

  if (channelResult.result && channelResult.result.success) {
    channels = channelResult.result.data;
  }
}

// Fetch playlist processing status for specific IDs with video counts
if (playlistIds.length > 0) {
  const playlistResult = await args.executeNamedServerFunction({
    functionName: "getPlaylistsWithVideoCount",
    contextData: {
      userUuid: user.P.uuid,
      ownershipId,  // Filter by ownership if provided
      playlistIds: playlistIds,
      // statusFilter: ['queued', 'processing']
    }
  });

  if (playlistResult.result && playlistResult.result.success) {
    playlists = playlistResult.result.data;
  }
}

// Check if there's any active processing
const hasActiveProcessing = channels.length > 0 || playlists.length > 0;

return {
  success: true,
  data: {
    channels,
    playlists,
    hasActiveProcessing
  }
};
'''
        key: getProcessingStatusByIds
      }
    }
  ]
  edges: []
}