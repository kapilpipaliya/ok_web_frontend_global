{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Get processing status for all channels and playlists for current user
        body:
          '''
// Get current authenticated user
const user = await _.getUserFromSession();
if (!user) {
  return {
    success: false,
    message: "User session not found"
  };
}

const { ownershipId } = c;

// Use helper functions to fetch channels and playlists with video counts
// ownershipId is optional - if omitted, aggregates across all ownerships
const channelResult = await s({
  functionName: "getChannelsWithVideoCount",
  contextData: {
    userUuid: user.P.uuid,
    ownershipId,  // Filter by ownership if provided
    statusFilter: ['queued', 'processing']
  }
});

const playlistResult = await s({
  functionName: "getPlaylistsWithVideoCount",
  contextData: {
    userUuid: user.P.uuid,
    ownershipId,  // Filter by ownership if provided
    statusFilter: ['queued', 'processing']
  }
});

const channels = channelResult.result?.success ? channelResult.result.data : [];
const playlists = playlistResult.result?.success ? playlistResult.result.data : [];

return {
  success: true,
  data: {
    channels,
    playlists,
    hasActiveProcessing: channels.length > 0 || playlists.length > 0
  }
};
'''
        key: getAllProcessingStatus
      }
    }
  ]
  edges: []
}