{
  vertexes: [
    {
      id: "process_channel_queue_worker",
      L: "Function",
      P: {
        key: "processChannelQueue",
        description: "Background worker that processes channels by fetching all playlists and videos",
        body: '''
// This is a background worker function that processes channels
if (args.contextData.action === 'start') {
  // Helper function to log messages to database
  const logMessage = async (level, message, metadata = {}) => {
    try {
      await args.executeNamedServerFunction({
        functionName: 'logWorkerMessage',
        contextData: {
          workerName: 'processChannelQueue',
          level,
          message,
          metadata
        }
      });
    } catch (error) {
      // Silent failure - don't break worker if logging fails
    }
  };

  await logMessage('info', 'Starting channel processing worker');

  // Initialize queue helpers and Redis connection
  const helpers = await args.executeNamedServerFunction({ functionName: 'queueHelpers', contextData: {} });

  if (!helpers.result?.success) {
    await logMessage('error', 'Failed to initialize queue helpers', { error: helpers.result?.error });
    throw new Error('Queue helpers initialization failed');
  }

  const { Worker } = args.bullmq;
  const connection = helpers.result.data.getRedisConnection();

  // Validate Redis connection config
  if (!connection || !connection.host) {
    await logMessage('error', 'Invalid Redis connection configuration', { connection });
    throw new Error('Invalid Redis connection configuration');
  }

  // Queue all channels that are marked as 'queued' but not in BullMQ queue
  await logMessage('info', 'Checking for queued channels to add to queue');

  try {
    const channelQueue = helpers.result.data.createChannelQueue(args);

    // Get all channels with status 'queued' through ownership
    const queuedChannels = await args.session.run(`
      MATCH (u:User)-[:UserYouTubeOwnership]->(o:YouTubeOwnership)
      MATCH (o)-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
            -[:ChannelSettingChannel]->(c:Channel)
      WHERE cs.status = 'queued'
      RETURN u.uuid as userUuid, u.id as userId, o.key as ownershipId, c.youtubeId as channelId, cs.priority as priority, cs.queuedAt as queuedAt
      ORDER BY cs.priority DESC, cs.queuedAt ASC
    `);

    let addedCount = 0;
    let skippedCount = 0;

    await logMessage('info', `Found ${queuedChannels.records.length} channels with status='queued' in database`);

    for (const record of queuedChannels.records) {
      const userUuid = record.get('userUuid');
      const userId = record.get('userId');
      const ownershipId = record.get('ownershipId');
      const channelId = record.get('channelId');
      const priority = record.get('priority') || 'normal';

      // Generate unique job ID with ownership context
      const jobId = helpers.result.data.createJobId('channel', ownershipId, channelId);

      // Check if job already exists in waiting state
      const existingJob = await channelQueue.getJob(jobId);
      const jobState = existingJob ? await existingJob.getState() : null;

      if (!existingJob || jobState !== 'waiting') {
        // Job doesn't exist or is not waiting, add it
        const jobPriority = priority === 'high' ? 1 : priority === 'low' ? 3 : 2;

        await helpers.result.data.addChannelJob(channelQueue, {
          channelId,
          userId,
          userUuid,
          ownershipId,  // Required for multi-ownership support
          priority
        }, {
          priority: jobPriority
        });

        addedCount++;
        await logMessage('info', `Added channel to queue`, {
          channelId,
          ownershipId,
          priority,
          jobId
        });
      } else {
        skippedCount++;
        await logMessage('info', `Skipped channel - already in queue`, {
          channelId,
          ownershipId,
          jobState,
          jobId
        });
      }
    }

    await channelQueue.close();
    await logMessage('info', `Queue initialization complete`, {
      totalFound: queuedChannels.records.length,
      addedCount,
      skippedCount
    });
  } catch (error) {
    await logMessage('error', 'Error queuing channels on startup', {
      error: error.message,
      stack: error.stack
    });
  }

  // Small delay to ensure queue connection is fully closed before creating worker
  await new Promise(resolve => setTimeout(resolve, 100));

  // Create worker for channel processing queue with error handling
  let worker;
  try {
    await logMessage('info', 'Creating BullMQ Worker for channel processing');

    worker = new Worker('processChannelQueue', async (job) => {
    const { channelId, userId, userUuid, ownershipId, customName, priority = 'normal' } = job.data;

    await logMessage('info', 'Processing channel', { channelId, userId, ownershipId, priority });

    // Get a new database session for this job
    const session = await args.getSession();

    // Get ownership priority for quota allocation
    const ownershipResult = await session.run(`
      MATCH (o:YouTubeOwnership {key: $ownershipId})
      RETURN COALESCE(o.priority, 0) as priority
    `, { ownershipId });
    const ownershipPriority = ownershipResult.records[0]?.get('priority') || 0;

    // Reserve quota for processing (estimate: ~10 units for channel + playlists)
    // Actual usage will be logged as operations complete
    let reservationId = null;
    try {
      reservationId = await args.reserveQuota(
        ownershipId,
        10,  // Estimated quota needed
        ownershipPriority,
        `process_channel_${channelId}`,
        session
      );

      await logMessage('info', 'Reserved quota for channel processing', {
        channelId,
        ownershipId,
        reservationId,
        estimatedCost: 10
      });
    } catch (error) {
      // QuotaExhaustedError - mark channel as pending_quota
      if (error.name === 'QuotaExhaustedError') {
        await logMessage('warn', 'Shared quota exhausted, queueing channel for tomorrow', {
          channelId,
          ownershipId,
          remainingQuota: error.remainingQuota
        });

        // Mark channel as pending_quota
        await session.run(`
          MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
                -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
          SET cs.status = 'pending_quota',
              cs.error = 'Daily API quota exhausted. Will resume tomorrow.',
              cs.updatedAt = datetime()
        `, { ownershipId, channelId });

        await session.close();
        return; // Exit without throwing - job completes but channel waits for quota reset
      }

      // Other errors
      throw error;
    }

    try {

      // Update status to processing
      await session.run(`
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
              -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
        SET cs.status = 'processing',
            cs.progress = 0,
            cs.updatedAt = datetime()
        RETURN cs
      `, { ownershipId, channelId });

      // Get authenticated YouTube client for this ownership's OAuth
      let youtube;
      try {
        youtube = await args.getYouTubeClient(ownershipId, session, args.request);
      } catch (error) {
        // Handle OAuth errors - mark channel as failed
        await session.run(`
          MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
                -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
          SET cs.status = 'failed',
              cs.error = $error,
              cs.priority = null,
              cs.updatedAt = datetime()
        `, {
          ownershipId,
          channelId,
          error: error.message.includes('No YouTube authorization') || error.message.includes('revoked')
            ? 'YouTube authorization expired or revoked. Please reconnect your YouTube account in settings.'
            : error.message
        });
        throw error;
      }

      // Get channel uploads playlist and all playlists
      const channelResponse = await youtube.channels.list({
        part: ['contentDetails', 'snippet'],
        id: [channelId]
      });

      // Log API usage: channels.list operation (1 unit) - shared quota
      await args.logSharedAPIUsage(ownershipId, 'channels.list', args.YOUTUBE_API_COSTS['channels.list'], session);

      if (!channelResponse.data.items || channelResponse.data.items.length === 0) {
        throw new Error('Channel not found');
      }

      const uploadsPlaylistId = channelResponse.data.items[0].contentDetails?.relatedPlaylists?.uploads;

      // Fetch all channel playlists
      let allPlaylists = [];
      let nextPageToken = null;

      do {
        const playlistsResponse = await youtube.playlists.list({
          part: ['snippet', 'contentDetails', 'status'],
          channelId: channelId,
          maxResults: 50,
          pageToken: nextPageToken
        });

        // Log API usage: playlists.list operation (1 unit per page) - shared quota
        await args.logSharedAPIUsage(ownershipId, 'playlists.list', args.YOUTUBE_API_COSTS['playlists.list'], session);

        if (playlistsResponse.data.items) {
          allPlaylists = allPlaylists.concat(playlistsResponse.data.items);
        }

        nextPageToken = playlistsResponse.data.nextPageToken;
      } while (nextPageToken);

      // Add uploads playlist if exists
      if (uploadsPlaylistId) {
        const channelData = channelResponse.data.items[0];
        const uploadsPlaylist = {
          id: uploadsPlaylistId,
          snippet: {
            title: 'All Uploads',
            description: 'All videos uploaded by this channel',
            thumbnails: channelData.snippet?.thumbnails || {}
          }
        };
        allPlaylists.unshift(uploadsPlaylist);
      }

      const totalPlaylists = allPlaylists.length;

      // Update total counts
      await session.run(`
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
              -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
        SET cs.totalPlaylists = $totalPlaylists,
            cs.processedPlaylists = 0,
            cs.updatedAt = datetime()
        RETURN cs
      `, { ownershipId, channelId, totalPlaylists });

      // Create a queue for playlist processing
      const playlistQueue = helpers.result.data.createPlaylistQueue(args);

      try {
        // Process each playlist by adding to queue
        for (const playlist of allPlaylists) {
        if (!playlist.id) continue;

        // Save playlist metadata first
        await session.run(`
          MERGE (p:Playlist {youtubeId: $playlistId})
          ON CREATE SET
            p.key = $key,
            p.createdAt = datetime()
          SET
            p.title = $title,
            p.description = $description,
            p.thumbnailDefault = $thumbnailDefault,
            p.thumbnailMedium = $thumbnailMedium,
            p.thumbnailHigh = $thumbnailHigh,
            p.thumbnailStandard = $thumbnailStandard,
            p.thumbnailMaxres = $thumbnailMaxres,
            p.channelId = $channelId,
            p.itemCount = $itemCount,
            p.updatedAt = datetime()
        `, {
          playlistId: playlist.id,
          key: `playlist_${playlist.id}`,
          title: playlist.snippet?.title || '',
          description: playlist.snippet?.description || '',
          thumbnailDefault: playlist.snippet?.thumbnails?.default?.url || null,
          thumbnailMedium: playlist.snippet?.thumbnails?.medium?.url || null,
          thumbnailHigh: playlist.snippet?.thumbnails?.high?.url || null,
          thumbnailStandard: playlist.snippet?.thumbnails?.standard?.url || null,
          thumbnailMaxres: playlist.snippet?.thumbnails?.maxres?.url || null,
          channelId,
          itemCount: playlist.contentDetails?.itemCount || 0
        });

        // Create channel-playlist relationship
        await session.run(`
          MATCH (c:Channel {youtubeId: $channelId})
          MATCH (p:Playlist {youtubeId: $playlistId})
          MERGE (c)-[:ChannelPlaylist]->(p)
        `, { channelId, playlistId: playlist.id });

        // Create ownership playlist setting and mark as queued
        // Inherit priority from parent channel
        const playlistSettingKey = `playlist_setting_${ownershipId}_${playlist.id}`;
        await session.run(`
          MATCH (o:YouTubeOwnership {key: $ownershipId})
          MATCH (p:Playlist {youtubeId: $playlistId})
          MERGE (o)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p)
          ON CREATE SET
            ps.key = $playlistSettingKey,
            ps.createdAt = datetime()
          SET
            ps.status = 'queued',
            ps.progress = 0,
            ps.totalVideos = 0,
            ps.processedVideos = 0,
            ps.sortBy = 'index',
            ps.showThumbnails = true,
            ps.viewMode = 'list',
            ps.priority = $priority,
            ps.queuedAt = datetime(),
            ps.updatedAt = datetime()
        `, {
          ownershipId,
          playlistId: playlist.id,
          playlistSettingKey,
          priority
        });

          // Add playlist to processing queue with inherited priority
          const jobPriority = priority === 'high' ? 1 : priority === 'low' ? 3 : 2;

          await helpers.result.data.addPlaylistJob(playlistQueue, {
            playlistId: playlist.id,
            userId: userId,
            userUuid: userUuid,
            ownershipId: ownershipId,  // Required for multi-ownership support
            customName: null,
            channelId: channelId,
            priority: priority
          }, {
            priority: jobPriority  // Override default priority
          });

          await logMessage('info', 'Queued playlist for processing', {
            playlistId: playlist.id,
            playlistTitle: playlist.snippet?.title,
            priority: priority
          });
        }
      } finally {
        // Close playlist queue connection
        await playlistQueue.close();
      }

      await logMessage('info', 'Channel processing completed', {
        channelId,
        totalPlaylists
      });

    } catch (error) {
      await logMessage('error', 'Error processing channel', {
        channelId,
        error: error.message,
        stack: error.stack
      });

      // CRITICAL: Mark channel as failed to prevent it from being stuck in 'processing' state forever
      // This handles cases where:
      // - YouTube API is unavailable
      // - Channel is deleted or private
      // - Network errors occur
      // - Database connection issues
      // Without this, the channel would stay in 'processing' state indefinitely
      await session.run(`
        MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipChannelSetting]->(cs:ChannelSetting)
              -[:ChannelSettingChannel]->(c:Channel {youtubeId: $channelId})
        SET cs.status = 'failed',
            cs.error = $error,
            cs.priority = null,
            cs.progress = 0,
            cs.updatedAt = datetime()
      `, { ownershipId, channelId, error: error.message });

      throw error;
    } finally {
      // Release quota reservation
      if (reservationId) {
        try {
          await args.releaseQuota(reservationId, session);
          await logMessage('info', 'Released quota reservation', { reservationId, channelId });
        } catch (error) {
          // Log but don't throw - session cleanup is more important
          console.error('Error releasing quota reservation:', error);
        }
      }

      // Always close the session
      await session.close();
    }
  }, {
    connection,
    // CONCURRENCY CONFIGURATION:
    // Process 2 channels simultaneously to improve throughput
    // Keep it low to respect YouTube API rate limits
    // Each channel can spawn many playlist jobs, so 2 is reasonable
    // Increase to 5 if you have high API quota limits
    concurrency: 2
  });

  worker.on('completed', async (job) => {
    await logMessage('info', 'Channel processing job completed', { jobId: job.id });
  });

  worker.on('failed', async (job, err) => {
    await logMessage('error', 'Channel processing job failed', {
      jobId: job?.id,
      error: err.message,
      stack: err.stack
    });
  });

  // Event handler for worker errors (including connection errors)
  worker.on('error', async (err) => {
    await logMessage('error', 'Worker error occurred', {
      error: err.message,
      stack: err.stack,
      code: err.code
    });
  });

  await logMessage('info', 'Channel processing worker created successfully', {
    concurrency: 1
  });

  // Return stop function for graceful shutdown
  return {
    stop: async () => {
      await logMessage('info', 'Stopping channel processing worker');
      await worker.close();
    }
  };

} catch (error) {
  await logMessage('error', 'Failed to create channel processing worker', {
    error: error.message,
    stack: error.stack,
    code: error.code
  });

  // If worker was partially created, try to close it
  if (worker) {
    try {
      await worker.close();
    } catch (closeError) {
      console.error('Error closing worker:', closeError);
    }
  }

  throw error;
}
}
'''
      }
    }
  ],
  edges: []
}
