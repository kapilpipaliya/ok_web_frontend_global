{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Get current user's active subscription details and quota usage
        body:
          '''
// Get authenticated user
const user = await args.getUserFromSession();
if (!user) {
  return {
    success: false,
    message: "User session not found. Please log in."
  };
}

// Fetch user's current active subscription
const subscriptionResult = await args.session.run(
  `MATCH (u:User {uuid: $userId})-[:UserSubscription]->(s:UserSubscription)
   WHERE s.status = 'active'
   RETURN s
   ORDER BY s.createdAt DESC
   LIMIT 1`,
  { userId: user.P.uuid }
);

// Fetch user's current plan and quota info
const userResult = await args.session.run(
  `MATCH (u:User {uuid: $userId})
   RETURN u`,
  { userId: user.P.uuid }
);

// Convert user node to vertex interface format
const userNode = userResult.records[0]?.get("u");
const userVertex = userNode ? args.convertNodeToJson(userNode) : null;

const currentPlan = userVertex?.P?.currentPlan || "free";
const videoQuotaLimit = userVertex?.P?.videoQuotaLimit || 10000;
const videoQuotaUsed = userVertex?.P?.videoQuotaUsed || 0;
const subscriptionStatus = userVertex?.P?.subscriptionStatus || "none";
const subscriptionExpiryDate = userVertex?.P?.subscriptionExpiryDate;

let subscription = null;

if (subscriptionResult.records.length > 0) {
  const subNode = subscriptionResult.records[0].get("s");
  // Convert Neo4j node to vertex interface format
  subscription = args.convertNodeToJson(subNode);
}

// Calculate quota percentage
const quotaPercentage = videoQuotaLimit > 0
  ? Math.round((videoQuotaUsed / videoQuotaLimit) * 100)
  : 0;

// Check if approaching limit (80% or more)
const isApproachingLimit = quotaPercentage >= 80;
const isOverLimit = videoQuotaUsed >= videoQuotaLimit;

return {
  success: true,
  data: {
    subscription: subscription,
    currentPlan: currentPlan,
    videoQuotaLimit: videoQuotaLimit,
    videoQuotaUsed: videoQuotaUsed,
    videoQuotaRemaining: Math.max(0, videoQuotaLimit - videoQuotaUsed),
    quotaPercentage: quotaPercentage,
    isApproachingLimit: isApproachingLimit,
    isOverLimit: isOverLimit,
    subscriptionStatus: subscriptionStatus,
    subscriptionExpiryDate: subscriptionExpiryDate,
    hasActiveSubscription: subscription !== null
  }
};
'''
        key: getUserSubscription
      }
    }
  ]
  edges: []
}