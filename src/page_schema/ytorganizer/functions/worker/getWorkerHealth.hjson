{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Get health status and job counts for YSaar workers
        body:
          '''
/**
 * Worker Health Check
 *
 * This function checks the health and status of BullMQ workers
 * Returns job counts for both processChannelQueue and processPlaylistQueue queues
 *
 * Use this to:
 * - Verify workers are running properly
 * - Monitor queue backlogs
 * - Detect processing issues
 * - Display worker status in admin UI
 */

  const helpers = await args.executeNamedServerFunction({ functionName: 'queueHelpers', contextData: {} });

  // Connect to both worker queues
  const channelQueue = helpers.result.data.createChannelQueue(args);
  const playlistQueue = helpers.result.data.createPlaylistQueue(args);

  // Get job counts for both queues
  // This includes: waiting, active, completed, failed, delayed, and paused jobs
  const [channelCounts, playlistCounts] = await Promise.all([
    channelQueue.getJobCounts(),
    playlistQueue.getJobCounts()
  ]);

  // Close queue connections
  await channelQueue.close();
  await playlistQueue.close();

  // Calculate total active processing
  const totalActive = (channelCounts.active || 0) + (playlistCounts.active || 0);
  const totalWaiting = (channelCounts.waiting || 0) + (playlistCounts.waiting || 0);
  const totalFailed = (channelCounts.failed || 0) + (playlistCounts.failed || 0);

  // Determine health status
  // Workers are healthy if we can connect and get counts
  const healthy = true;

  return {
    success: true,
    data: {
      healthy,
      timestamp: new Date().toISOString(),
      queues: {
        processChannelQueue: {
          waiting: channelCounts.waiting || 0,      // Jobs waiting to be processed
          active: channelCounts.active || 0,        // Jobs currently being processed
          completed: channelCounts.completed || 0,  // Jobs completed successfully
          failed: channelCounts.failed || 0,        // Jobs that failed after all retries
          delayed: channelCounts.delayed || 0,      // Jobs scheduled for future processing
          paused: channelCounts.paused || 0         // Jobs in paused state
        },
        processPlaylistQueue: {
          waiting: playlistCounts.waiting || 0,
          active: playlistCounts.active || 0,
          completed: playlistCounts.completed || 0,
          failed: playlistCounts.failed || 0,
          delayed: playlistCounts.delayed || 0,
          paused: playlistCounts.paused || 0
        }
      },
      summary: {
        totalActive,
        totalWaiting,
        totalFailed,
        isProcessing: totalActive > 0 || totalWaiting > 0
      }
    }
  };
'''
        key: getWorkerHealth
      }
    }
  ]
  edges: []
}