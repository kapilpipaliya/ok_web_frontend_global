{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Fetches worker logs from database with optional filters
        body:
          '''
// Fetch worker logs from database
const filterWorker = c?.filterWorker || 'all';
const filterLevel = c?.filterLevel || 'all';

const session = _.session;

// Build query based on filters
let query = 'MATCH (log:WorkerLog) ';
let params = {};

const conditions = [];
if (filterWorker !== 'all') {
  conditions.push('log.workerName = $workerName');
  params.workerName = filterWorker;
}
if (filterLevel !== 'all') {
  conditions.push('log.level = $level');
  params.level = filterLevel;
}

if (conditions.length > 0) {
  query += 'WHERE ' + conditions.join(' AND ') + ' ';
}

query += 'RETURN log ORDER BY log.createdAt DESC LIMIT 100';

const result = await session.run(query, params);

const logs = result.records.map(record => {
  const logNode = record.get('log');
  return _.convertNodeToJson(logNode);
});

return logs;
'''
        key: getWorkerLogs
      }
    }
  ]
  edges: []
}