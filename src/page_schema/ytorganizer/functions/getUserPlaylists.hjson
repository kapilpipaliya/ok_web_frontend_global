{
  vertexes: [
    {
      id: "get_user_playlists_function",
      L: "Function",
      P: {
        key: "getUserPlaylists",
        description: "Fetches all playlists saved by the current user with their custom settings",
        body: '''
try {
  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Cypher query to fetch all user's playlists with their settings, channel info, and user-specific video count
  const query = `
    MATCH (u:User {uuid: $userUuid})
    MATCH (u)-[:UserPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist)
    OPTIONAL MATCH (c:Channel)-[:ChannelPlaylist]->(p)

    // Count videos in this playlist that the user has access to
    OPTIONAL MATCH (p)-[:PlaylistVideo]->(v:Video)
    OPTIONAL MATCH (u)-[:UserVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v)

    WITH p, ps, c, COUNT(DISTINCT CASE WHEN v IS NOT NULL THEN v END) as videoCount

    RETURN p, ps, c, videoCount
    ORDER BY ps.createdAt DESC
  `;

  // Execute the query
  const result = await args.session.run(query, {
    userUuid: user.P.uuid
  });

  // Return raw converted nodes for frontend processing with user-specific video count
  const playlists = result.records.map(record => {
    const playlistSettings = args.convertNodeToJson(record.get('ps'));
    const videoCount = record.get('videoCount');

    // Add user-specific video count to playlist settings
    if (playlistSettings && playlistSettings.P) {
      playlistSettings.P.userVideoCount = videoCount ? (typeof videoCount.toNumber === 'function' ? videoCount.toNumber() : Number(videoCount)) : 0;
    }

    return {
      playlist: args.convertNodeToJson(record.get('p')),
      playlistSettings: playlistSettings,
      channel: record.get('c') ? args.convertNodeToJson(record.get('c')) : null
    };
  });

  return {
    success: true,
    data: {
      playlists,
      totalCount: playlists.length,
      userId: user.id
    },
    message: `Found ${playlists.length} playlists`
  };

} catch (error) {
  console.error("Error fetching user playlists:", error);

  // Handle specific error types
  let userMessage = "Failed to fetch playlists. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to view your playlists.";
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    },
    data: {
      playlists: [],
      totalCount: 0
    }
  };
}
'''
      }
    }
  ],
  edges: []
}