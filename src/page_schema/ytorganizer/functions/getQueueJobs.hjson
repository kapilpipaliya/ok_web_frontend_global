{
  vertexes: [
    {
      id: "get_queue_jobs",
      L: "Function",
      P: {
        key: "getQueueJobs",
        description: "Fetches detailed job information for a specific queue and state",
        body: '''
/**
 * Get detailed job information from BullMQ queues
 *
 * Parameters:
 * - queueName: 'processChannelQueue' | 'processPlaylistQueue'
 * - jobState: 'active' | 'waiting' | 'failed' | 'completed' | 'delayed'
 * - limit: number (default 20)
 */

const { queueName, jobState, limit = 20 } = args.contextData;

// Validate parameters
if (!queueName || !jobState) {
  return {
    success: false,
    message: "queueName and jobState are required"
  };
}

// Get the queue
const { Queue } = args.bullmq;
const connection = args.bullmq.redisConnection || {
  host: process.env.REDIS_HOST || 'localhost',
  port: parseInt(process.env.REDIS_PORT || '6379'),
  maxRetriesPerRequest: null
};

const queue = new Queue(queueName, { connection });

try {
  let jobs = [];

  // Fetch jobs based on state
  if (jobState === 'active') {
    jobs = await queue.getActive(0, limit - 1);
  } else if (jobState === 'waiting') {
    jobs = await queue.getWaiting(0, limit - 1);
  } else if (jobState === 'failed') {
    jobs = await queue.getFailed(0, limit - 1);
  } else if (jobState === 'completed') {
    jobs = await queue.getCompleted(0, limit - 1);
  } else if (jobState === 'delayed') {
    jobs = await queue.getDelayed(0, limit - 1);
  } else {
    return {
      success: false,
      message: `Invalid jobState: ${jobState}`
    };
  }

  // Collect all unique IDs for batch fetching
  const channelIds = [];
  const playlistIds = [];
  const userUuids = [];

  for (const job of jobs) {
    if (job.data) {
      if (job.data.channelId && !channelIds.includes(job.data.channelId)) {
        channelIds.push(job.data.channelId);
      }
      if (job.data.playlistId && !playlistIds.includes(job.data.playlistId)) {
        playlistIds.push(job.data.playlistId);
      }
      if (job.data.userUuid && !userUuids.includes(job.data.userUuid)) {
        userUuids.push(job.data.userUuid);
      }
    }
  }

  // Batch fetch channel names
  const channelNameMap = {};
  if (channelIds.length > 0) {
    try {
      const channelResult = await args.session.run(
        'MATCH (c:Channel) WHERE c.youtubeId IN $channelIds RETURN c',
        { channelIds }
      );
      for (const record of channelResult.records) {
        const channel = args.convertNodeToJson(record.get('c'));
        channelNameMap[channel.P.youtubeId] = channel.P.title;
      }
    } catch (err) {
      console.error('Error batch fetching channel names:', err);
    }
  }

  // Batch fetch playlist names
  const playlistNameMap = {};
  if (playlistIds.length > 0) {
    try {
      const playlistResult = await args.session.run(
        'MATCH (p:Playlist) WHERE p.youtubeId IN $playlistIds RETURN p',
        { playlistIds }
      );
      for (const record of playlistResult.records) {
        const playlist = args.convertNodeToJson(record.get('p'));
        playlistNameMap[playlist.P.youtubeId] = playlist.P.title;
      }
    } catch (err) {
      console.error('Error batch fetching playlist names:', err);
    }
  }

  // Batch fetch usernames
  const usernameMap = {};
  if (userUuids.length > 0) {
    try {
      const userResult = await args.session.run(
        'UNWIND $userUuids AS userUuid MATCH (u:User {uuid: userUuid}) RETURN u',
        { userUuids }
      );
      for (const record of userResult.records) {
        const user = args.convertNodeToJson(record.get('u'));
        usernameMap[user.P.uuid] = user.P.username;
      }
    } catch (err) {
      console.error('Error batch fetching usernames:', err);
    }
  }

  // Process jobs to extract relevant information
  const processedJobs = await Promise.all(jobs.map(async (job) => {
    const jobData = {
      id: job.id,
      name: job.name,
      timestamp: job.timestamp,
      processedOn: job.processedOn,
      finishedOn: job.finishedOn,
      attemptsMade: job.attemptsMade,
      failedReason: job.failedReason || null,
      stacktrace: job.stacktrace ? job.stacktrace.join('\n') : null,
      returnvalue: job.returnvalue || null,
      progress: 0,
      duration: null,
      state: jobState
    };

    // Get progress for active jobs
    if (jobState === 'active') {
      try {
        const progress = await job.progress();
        jobData.progress = typeof progress === 'number' ? progress : 0;
      } catch (err) {
        jobData.progress = 0;
      }
    }

    // Calculate duration
    if (job.processedOn) {
      const endTime = job.finishedOn || Date.now();
      jobData.duration = endTime - job.processedOn;
    }

    // Add job-specific data from batch-fetched maps
    if (job.data) {
      if (job.data.channelId) {
        jobData.channelId = job.data.channelId;
        jobData.itemType = 'channel';
        jobData.channelName = channelNameMap[job.data.channelId] || null;
      }
      if (job.data.playlistId) {
        jobData.playlistId = job.data.playlistId;
        jobData.itemType = 'playlist';
        jobData.playlistName = playlistNameMap[job.data.playlistId] || null;
      }
      jobData.userId = job.data.userId || null;
      jobData.userUuid = job.data.userUuid || null;
      jobData.customName = job.data.customName || null;

      // Get username from batch-fetched map
      if (job.data.userUuid) {
        jobData.username = usernameMap[job.data.userUuid] || null;
      }
    }

    return jobData;
  }));

  // Close the queue connection
  await queue.close();

  return {
    success: true,
    data: {
      queueName,
      jobState,
      jobs: processedJobs,
      total: processedJobs.length
    }
  };

} catch (error) {
  console.error('Error fetching queue jobs:', error);

  // Always try to close the queue
  try {
    await queue.close();
  } catch (closeError) {
    console.error('Error closing queue:', closeError);
  }

  return {
    success: false,
    message: `Error fetching queue jobs: ${error.message}`
  };
}
'''
      }
    }
  ],
  edges: []
}
