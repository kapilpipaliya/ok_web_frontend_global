{
  vertexes: [
    {
      id: "get_user_channels_function",
      L: "Function",
      P: {
        key: "getUserChannels",
        description: "Fetches all channels saved by the current user with their custom settings. Supports multi-ownership model with optional ownership filtering.",
        body: '''
try {
  // Get current authenticated user from session
  const actualUser = await args.getUserFromSession();
  if (!actualUser) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Get effective user (handles admin impersonation)
  const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

  // Optional ownership filter from context
  const { ownershipId = null, sortBy = "title_asc" } = args.contextData;

  // Parse sortBy parameter using shared utility
  const parseSortResult = await args.executeNamedServerFunction({
    functionName: "parseSortByUtil",
    contextData: { sortBy, contentType: "channels" }
  });

  if (!parseSortResult.result) {
    throw new Error("Failed to parse sort parameters");
  }

  const { orderBy, orderDirection, secondaryOrderBy } = parseSortResult.result;

  // Use helper function to fetch channels with video counts
  const result = await args.executeNamedServerFunction({
    functionName: "getChannelsWithVideoCount",
    contextData: {
      userUuid: user.P.uuid,
      ownershipId,  // Optional: filter by specific ownership
      orderBy,
      orderDirection,
      secondaryOrderBy  // Pass secondary sort for multi-field sorting
    }
  });

  if (!result.result || !result.result.success) {
    throw new Error(result.result?.message || "Failed to fetch channels");
  }

  const channels = result.result.data;

  return {
    success: true,
    data: {
      channels,
      totalCount: channels.length,
      userId: user.id,
      ownershipId  // Include ownership context if filtered
    },
    message: `Found ${channels.length} channels`
  };

} catch (error) {
  console.error("Error fetching user channels:", error);

  // Handle specific error types
  let userMessage = "Failed to fetch channels. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to view your channels.";
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    },
    data: {
      channels: [],
      totalCount: 0
    }
  };
}
'''
      }
    }
  ],
  edges: []
}