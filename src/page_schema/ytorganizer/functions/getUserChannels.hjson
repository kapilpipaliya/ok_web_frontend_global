{
  vertexes: [
    {
      id: "get_user_channels_function",
      L: "Function",
      P: {
        key: "getUserChannels",
        description: "Fetches all channels saved by the current user with their custom settings",
        body: '''
try {
  // Get current authenticated user from session
  const actualUser = await args.getUserFromSession();
  if (!actualUser) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Get effective user (handles admin impersonation)
  const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

  // Cypher query to fetch all user's channels with their settings and user-specific video count
  const query = `
    MATCH (u:User {uuid: $userUuid})
    MATCH (u)-[:UserChannelSetting]->(cs:ChannelSetting)-[:ChannelSettingChannel]->(c:Channel)

    // Find the uploads playlist for this channel and count user's videos in it
    OPTIONAL MATCH (uploadsPlaylist:Playlist {youtubeId: c.uploadsPlaylistId})
    OPTIONAL MATCH (uploadsPlaylist)-[:PlaylistVideo]->(v:Video)
    OPTIONAL MATCH (u)-[:UserVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v)

    WITH c, cs, COUNT(DISTINCT CASE WHEN v IS NOT NULL THEN v END) as videoCount

    RETURN c, cs, videoCount
    ORDER BY cs.createdAt DESC
  `;

  // Execute the query
  const result = await args.session.run(query, {
    userUuid: user.P.uuid
  });

  // Return raw converted nodes for frontend processing with user-specific video count
  const channels = result.records.map(record => {
    const channelSetting = args.convertNodeToJson(record.get('cs'));
    const videoCount = record.get('videoCount');

    // Add user-specific video count to channel settings
    if (channelSetting && channelSetting.P) {
      channelSetting.P.userVideoCount = videoCount ? (typeof videoCount.toNumber === 'function' ? videoCount.toNumber() : Number(videoCount)) : 0;
    }

    return {
      channel: args.convertNodeToJson(record.get('c')),
      channelSetting: channelSetting
    };
  });

  return {
    success: true,
    data: {
      channels,
      totalCount: channels.length,
      userId: user.id
    },
    message: `Found ${channels.length} channels`
  };

} catch (error) {
  console.error("Error fetching user channels:", error);

  // Handle specific error types
  let userMessage = "Failed to fetch channels. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to view your channels.";
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    },
    data: {
      channels: [],
      totalCount: 0
    }
  };
}
'''
      }
    }
  ],
  edges: []
}