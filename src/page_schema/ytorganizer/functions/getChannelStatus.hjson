{
  vertexes: [
    {
      id: "get_channel_status_function",
      L: "Function",
      P: {
        key: "getChannelStatus",
        description: "Get processing status for a specific channel",
        body: '''
try {
  const { channelId } = args.contextData;

  if (!channelId) {
    throw new Error("Channel ID is required");
  }

  // Get current authenticated user
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found");
  }

  // Use helper function to fetch channel with video count
  const result = await args.executeNamedServerFunction({
    functionName: "getChannelsWithVideoCount",
    contextData: {
      userUuid: user.P.uuid,
      channelIds: [channelId]
    }
  });

  if (!result.result || !result.result.success || result.result.data.length === 0) {
    return {
      success: false,
      message: "Channel not found"
    };
  }

  const channelData = result.result.data[0];

  return {
    success: true,
    data: {
      channel: channelData.channel,
      channelSetting: channelData.channelSetting
    }
  };

} catch (error) {
  console.error("Error fetching channel status:", error);
  return {
    success: false,
    message: "Failed to fetch channel status",
    error: { details: error.message }
  };
}
'''
      }
    }
  ],
  edges: []
}
