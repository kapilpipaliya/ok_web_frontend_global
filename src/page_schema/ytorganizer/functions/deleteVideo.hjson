{
  vertexes: [
    {
      id: "delete_video_function",
      L: "Function",
      P: {
        key: "deleteVideo",
        description: "Deletes a video from a playlist, and removes the video node if not referenced elsewhere",
        body: '''
try {
  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Extract parameters
  const { video, contextType, contextItem, ownershipId } = args.contextData;

  if (!video) {
    throw new Error("Video data is required");
  }

  if (!ownershipId) {
    throw new Error("YouTube Ownership ID is required. Please select a YouTube account.");
  }

  if (!contextType || contextType !== "playlist") {
    throw new Error("Invalid context type. Must be 'playlist'");
  }

  if (!contextItem) {
    throw new Error("Playlist is required");
  }

  const videoId = video.P?.youtubeId;
  if (!videoId) {
    throw new Error("Video ID not found");
  }

  const contextId = contextItem.P?.youtubeId;
  if (!contextId) {
    throw new Error("Context ID not found");
  }

  // Verify ownership belongs to user
  const ownershipCheck = await args.session.run(`
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
    RETURN o
  `, { userUuid: user.P.uuid, ownershipId });

  if (ownershipCheck.records.length === 0) {
    throw new Error("Invalid YouTube ownership. This account doesn't belong to you or no longer exists.");
  }

  let deletedVideo = false;
  let removedFromContext = false;

  if (contextType === "playlist") {
    // Remove video from playlist
    const removeFromPlaylistQuery = `
      MATCH (p:Playlist {youtubeId: $playlistId})-[r:PlaylistVideo]->(v:Video {youtubeId: $videoId})
      DELETE r
      RETURN count(r) as removedRelations
    `;

    const removeResult = await args.session.run(removeFromPlaylistQuery, {
      playlistId: contextId,
      videoId: videoId
    });

    const removedRelationsRaw = removeResult.records[0]?.get('removedRelations');
    const removedCount = removedRelationsRaw ? (typeof removedRelationsRaw.toNumber === 'function' ? removedRelationsRaw.toNumber() : Number(removedRelationsRaw)) : 0;
    removedFromContext = removedCount > 0;

    // Check if video should be deleted (not in other playlists)
    const checkVideoQuery = `
      MATCH (v:Video {youtubeId: $videoId})

      // Check if in other playlists
      OPTIONAL MATCH (otherP:Playlist)-[:PlaylistVideo]->(v)
      WHERE otherP.youtubeId <> $playlistId

      // Check if other ownerships have this video
      OPTIONAL MATCH (otherO:YouTubeOwnership)-[:YouTubeOwnershipVideoSetting]->(otherVS:VideoSetting)-[:VideoSettingVideo]->(v)
      WHERE otherO.key <> $ownershipId

      WITH v, otherP, otherO
      // Delete video if not in other playlists and no other ownerships
      WHERE otherP IS NULL AND otherO IS NULL

      OPTIONAL MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipVideoSetting]->(vs:VideoSetting)-[:VideoSettingVideo]->(v)
      DETACH DELETE vs, v
      RETURN count(v) as deletedVideos
    `;

    const deleteResult = await args.session.run(checkVideoQuery, {
      ownershipId,
      videoId: videoId,
      playlistId: contextId
    });

    const deletedVideosRaw = deleteResult.records[0]?.get('deletedVideos');
    const deletedCount = deletedVideosRaw ? (typeof deletedVideosRaw.toNumber === 'function' ? deletedVideosRaw.toNumber() : Number(deletedVideosRaw)) : 0;
    deletedVideo = deletedCount > 0;
  }

  if (!removedFromContext && !deletedVideo) {
    throw new Error("Video not found in the specified context");
  }

  const videoTitle = video.P?.title || "Video";
  const contextName = contextItem.P?.title || contextType;

  let message = `Successfully removed "${videoTitle}" from ${contextName}`;
  if (deletedVideo) {
    message = `Successfully deleted "${videoTitle}"`;
  }

  return {
    success: true,
    data: {
      videoId: videoId,
      contextType: contextType,
      contextId: contextId,
      removedFromContext: removedFromContext,
      deletedVideo: deletedVideo
    },
    message: message
  };

} catch (error) {
  console.error("Error deleting video:", error);

  let userMessage = "Failed to delete video. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to delete videos.";
  } else if (error.message.includes("not found")) {
    userMessage = error.message;
  } else if (error.message.includes("Invalid context type")) {
    userMessage = error.message;
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    }
  };
}
'''
      }
    }
  ],
  edges: []
}
