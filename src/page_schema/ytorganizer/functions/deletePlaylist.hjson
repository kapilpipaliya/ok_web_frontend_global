{
  vertexes: [
    {
      id: "delete_playlist_function",
      L: "Function",
      P: {
        key: "deletePlaylist",
        description: "Deletes playlists (array, 'all', or 'allInContext') from a specific ownership by calling deleteVideo for all videos, then cleaning up orphan playlist nodes. 'allInContext' deletes all playlists in the context channels. Supports multi-ownership model, batch processing, and special keywords.",
        body: '''
try {
  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Extract parameters - accepts array of items, 'all', or 'allInContext'
  const { items, itemType, contextItems, ownershipId, skipOwnershipCheck } = args.contextData;

  if (itemType !== "playlist") {
    throw new Error("Invalid playlist data");
  }

  if (!ownershipId) {
    throw new Error("YouTube Ownership ID is required. Please select a YouTube account.");
  }

  // Verify ownership belongs to user (skip if called internally)
  if (!skipOwnershipCheck) {
    const ownershipCheck = await args.session.run(`
      MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
      RETURN o
    `, { userUuid: user.P.uuid, ownershipId });

    if (ownershipCheck.records.length === 0) {
      throw new Error("Invalid YouTube ownership. This account doesn't belong to you or no longer exists.");
    }
  }

  // Handle contextItems array
  const contextItemArray = contextItems || [];

  // Prepare parameters for queries
  let playlistIds = null;
  let channelIds = null;

  if (items === 'all') {
    // Will use subquery for all playlists in ownership
    playlistIds = null;
  } else if (items === 'allInContext') {
    // Validate context items
    if (contextItemArray.length === 0) {
      throw new Error("Context channels are required when using 'allInContext'");
    }
    channelIds = contextItemArray.map(item => item.P?.youtubeId).filter(id => id);
    if (channelIds.length === 0) {
      throw new Error("No valid context channel IDs found");
    }
  } else {
    // Extract playlist IDs from array
    if (!items || items.length === 0) {
      throw new Error("No playlists provided to delete");
    }
    playlistIds = items.map(p => p.P?.youtubeId).filter(id => id);
    if (playlistIds.length === 0) {
      throw new Error("No valid playlist IDs found");
    }
  }

  // Step 1: Delete all videos in these playlists using deleteVideo function with 'allInContext'
  let deletedVideos = 0;

  // Create minimal playlist objects for contextItems (only need youtubeId)
  let playlistContextItems;
  if (items === 'all' || items === 'allInContext') {
    // For 'all' modes, pass empty array - deleteVideo will fetch videos directly via query
    playlistContextItems = items === 'all' ? [] : contextItemArray;
  } else {
    // For array mode, create minimal objects from IDs
    playlistContextItems = playlistIds.map(id => ({ P: { youtubeId: id } }));
  }

  try {
    const deleteResult = await args.executeNamedServerFunction({
      functionName: 'deleteVideo',
      contextData: {
        videos: 'allInContext',  // Use allInContext to delete all videos in these playlists
        contextType: 'playlist',
        contextItems: playlistContextItems,  // Pass minimal playlist objects for context
        ownershipId: ownershipId,
        skipOwnershipCheck: true  // Already checked in parent
      }
    });

    if (deleteResult?.result?.success) {
      deletedVideos = deleteResult.result.data?.deletedVideos || 0;
    }
  } catch (videoError) {
    console.error(`Failed to delete videos from playlists:`, videoError);
    // Continue with playlist deletion even if video deletion fails
  }

  // Step 2: Delete this ownership's PlaylistSettings
  let queryParams = { ownershipId };
  let playlistFilter = '';

  if (items === 'allInContext') {
    queryParams.channelIds = channelIds;
    playlistFilter = 'WHERE p IN [(c:Channel)-[:ChannelPlaylist]->(p:Playlist) WHERE c.youtubeId IN $channelIds | p]';
  } else if (items !== 'all') {
    queryParams.playlistIds = playlistIds;
    playlistFilter = 'WHERE p.youtubeId IN $playlistIds';
  }

  const deletePlaylistSettingsQuery = `
    MATCH (o:YouTubeOwnership {key: $ownershipId})
    MATCH (o)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist)
    ${playlistFilter}
    DETACH DELETE ps
    RETURN count(ps) as deletedPlaylistSettings
  `;

  const playlistSettingResult = await args.session.run(deletePlaylistSettingsQuery, queryParams);

  const deletedPSRaw = playlistSettingResult.records[0]?.get('deletedPlaylistSettings');
  const deletedPlaylistSettings = deletedPSRaw ? (typeof deletedPSRaw.toNumber === 'function' ? deletedPSRaw.toNumber() : Number(deletedPSRaw)) : 0;

  if (deletedPlaylistSettings === 0) {
    throw new Error("Playlists not found or already deleted");
  }

  // Step 3: Delete orphan Playlist nodes (no ownership references them)
  let playlistMatchPattern = '';

  if (items === 'all') {
    playlistMatchPattern = 'MATCH (o:YouTubeOwnership {key: $ownershipId})-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist)\n    WITH DISTINCT p';
  } else if (items === 'allInContext') {
    playlistMatchPattern = 'MATCH (c:Channel)-[:ChannelPlaylist]->(p:Playlist)\n    WHERE c.youtubeId IN $channelIds\n    WITH DISTINCT p';
  } else {
    playlistMatchPattern = 'MATCH (p:Playlist)\n    WHERE p.youtubeId IN $playlistIds';
  }

  const deleteOrphanPlaylistsQuery = `
    ${playlistMatchPattern}

    // Check if any ownership has a PlaylistSetting for this playlist
    OPTIONAL MATCH (anyO:YouTubeOwnership)-[:YouTubeOwnershipPlaylistSetting]->(anyPS:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p)

    WITH p, count(anyO) as ownershipCount
    WHERE ownershipCount = 0

    // No ownership references this playlist, safe to delete
    // First remove all Channel-[:ChannelPlaylist]->Playlist relationships
    OPTIONAL MATCH (c:Channel)-[r:ChannelPlaylist]->(p)
    DELETE r

    // Then delete the playlist node
    WITH p
    DETACH DELETE p
    RETURN count(p) as deletedPlaylists
  `;

  const playlistResult = await args.session.run(deleteOrphanPlaylistsQuery, queryParams);

  const deletedPlaylistsRaw = playlistResult.records[0]?.get('deletedPlaylists');
  const deletedPlaylists = deletedPlaylistsRaw ? (typeof deletedPlaylistsRaw.toNumber === 'function' ? deletedPlaylistsRaw.toNumber() : Number(deletedPlaylistsRaw)) : 0;

  // Generate context name for message
  let contextName = "account";
  if (contextItemArray.length === 1) {
    contextName = contextItemArray[0].P?.title || "channel";
  } else if (contextItemArray.length > 1) {
    contextName = `${contextItemArray.length} channels`;
  }

  let message;
  const isAll = items === 'all';
  const isAllInContext = items === 'allInContext';
  const totalProcessed = deletedPlaylistSettings + deletedPlaylists;

  if (isAll) {
    message = `Successfully processed all playlists${totalProcessed > 0 ? ` (${totalProcessed} playlist(s))` : ''}${deletedPlaylists > 0 ? `, deleted ${deletedPlaylists} orphan playlist(s)` : ''}${deletedVideos > 0 ? `, deleted ${deletedVideos} orphan video(s)` : ''}`;
  } else if (isAllInContext) {
    message = `Successfully processed all playlists in ${contextName}${totalProcessed > 0 ? ` (${totalProcessed} playlist(s))` : ''}${deletedPlaylists > 0 ? `, deleted ${deletedPlaylists} orphan playlist(s)` : ''}${deletedVideos > 0 ? `, deleted ${deletedVideos} orphan video(s)` : ''}`;
  } else if (items.length === 1) {
    const playlistTitle = items[0].P?.title || "Playlist";
    message = `Successfully deleted playlist "${playlistTitle}"${deletedVideos > 0 ? ` and ${deletedVideos} video(s)` : ''}`;
  } else {
    message = `Successfully processed ${items.length} playlist(s)${deletedPlaylists > 0 ? `, deleted ${deletedPlaylists} orphan playlist(s)` : ''}${deletedVideos > 0 ? `, deleted ${deletedVideos} orphan video(s)` : ''}`;
  }

  // Calculate total playlists processed
  const totalPlaylists = isAll || isAllInContext ? totalProcessed : (items ? items.length : 0);

  return {
    success: true,
    data: {
      playlistIds: playlistIds,
      deletedVideos: deletedVideos,
      deletedPlaylists: deletedPlaylists,
      totalPlaylists: totalPlaylists,
      totalVideosInPlaylists: deletedVideos
    },
    message: message
  };

} catch (error) {
  console.error("Error deleting playlist:", error);

  let userMessage = "Failed to delete playlist. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to delete playlists.";
  } else if (error.message.includes("not found")) {
    userMessage = error.message;
  } else if (error.message.includes("Invalid playlist data")) {
    userMessage = error.message;
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    }
  };
}
'''
      }
    }
  ],
  edges: []
}
