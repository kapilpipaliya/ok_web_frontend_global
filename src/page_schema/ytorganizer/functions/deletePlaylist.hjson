{
  vertexes: [
    {
      id: "delete_playlist_function",
      L: "Function",
      P: {
        key: "deletePlaylist",
        description: "Deletes a playlist from a specific ownership and videos that are only in this playlist for this ownership. Supports multi-ownership model.",
        body: '''
try {
  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Extract parameters
  const { item, itemType, ownershipId } = args.contextData;

  if (!item || itemType !== "playlist") {
    throw new Error("Invalid playlist data");
  }

  if (!ownershipId) {
    throw new Error("YouTube Ownership ID is required. Please select a YouTube account.");
  }

  const playlistId = item.P?.youtubeId;
  if (!playlistId) {
    throw new Error("Playlist ID not found");
  }

  // Verify ownership belongs to user
  const ownershipCheck = await args.session.run(`
    MATCH (u:User {uuid: $userUuid})-[:UserYouTubeOwnership]->(o:YouTubeOwnership {key: $ownershipId})
    RETURN o
  `, { userUuid: user.P.uuid, ownershipId });

  if (ownershipCheck.records.length === 0) {
    throw new Error("Invalid YouTube ownership. This account doesn't belong to you or no longer exists.");
  }

  // Step 1: Delete videos that are only in this playlist for this ownership
  // Only delete videos that don't exist in other playlists or other ownerships
  const deleteVideosQuery = `
    MATCH (o:YouTubeOwnership {key: $ownershipId})
    MATCH (o)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})
    MATCH (p)-[:PlaylistVideo]->(v:Video)
    OPTIONAL MATCH (o)-[:YouTubeOwnershipVideoSettings]->(vs:VideoSettings)-[:VideoSettingsVideo]->(v)

    // Check if video exists in other playlists
    OPTIONAL MATCH (otherP:Playlist)-[:PlaylistVideo]->(v)
    WHERE otherP.youtubeId <> $playlistId

    // Check if other ownerships have this video
    OPTIONAL MATCH (otherO:YouTubeOwnership)-[:YouTubeOwnershipVideoSettings]->(otherVS:VideoSettings)-[:VideoSettingsVideo]->(v)
    WHERE otherO.key <> $ownershipId

    WITH v, vs, otherP, otherO
    // Only delete if not in other playlists and no other ownerships
    WHERE otherP IS NULL AND otherO IS NULL

    // Delete video settings and video node only if no other ownerships
    DETACH DELETE vs, v
    RETURN count(v) as deletedVideos
  `;

  const videosResult = await args.session.run(deleteVideosQuery, {
    ownershipId,
    playlistId: playlistId
  });

  const deletedVideosRaw = videosResult.records[0]?.get('deletedVideos');
  const deletedVideos = deletedVideosRaw ? (typeof deletedVideosRaw.toNumber === 'function' ? deletedVideosRaw.toNumber() : Number(deletedVideosRaw)) : 0;

  // Step 2: Delete the playlist settings and check if playlist should be deleted
  const deletePlaylistQuery = `
    MATCH (o:YouTubeOwnership {key: $ownershipId})
    MATCH (o)-[:YouTubeOwnershipPlaylistSetting]->(ps:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p:Playlist {youtubeId: $playlistId})

    // Get playlist title before any deletion and check if other ownerships have this playlist
    WITH p, ps, p.title as playlistTitle

    // Check if other ownerships have this playlist before deletion
    OPTIONAL MATCH (otherO:YouTubeOwnership)-[:YouTubeOwnershipPlaylistSetting]->(otherPS:PlaylistSetting)-[:PlaylistSettingPlaylist]->(p)
    WHERE otherO.key <> $ownershipId

    WITH ps, p, playlistTitle, otherO

    // Delete this ownership's playlist settings
    DETACH DELETE ps

    WITH p, playlistTitle, otherO
    WHERE otherO IS NULL

    // Delete playlist node only if no other ownerships
    DETACH DELETE p

    RETURN playlistTitle
  `;

  const playlistResult = await args.session.run(deletePlaylistQuery, {
    ownershipId,
    playlistId: playlistId
  });

  if (playlistResult.records.length === 0) {
    throw new Error("Playlist not found or already deleted");
  }

  const playlistTitle = item.P?.title || "Playlist";

  return {
    success: true,
    data: {
      playlistId: playlistId,
      deletedVideos: deletedVideos
    },
    message: `Successfully deleted playlist "${playlistTitle}"${deletedVideos > 0 ? ` and ${deletedVideos} video(s)` : ''}`
  };

} catch (error) {
  console.error("Error deleting playlist:", error);

  let userMessage = "Failed to delete playlist. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to delete playlists.";
  } else if (error.message.includes("not found")) {
    userMessage = error.message;
  } else if (error.message.includes("Invalid playlist data")) {
    userMessage = error.message;
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    }
  };
}
'''
      }
    }
  ],
  edges: []
}
