{
  vertexes: [
    {
      id: "update_contact_status_function",
      L: "Function",
      P: {
        key: "updateContactStatus",
        description: "Updates the status of a contact form submission",
        body: '''
// This function runs on the server
// It has access to args object with:
// - args.contextData: Request parameters (contactId, status)
// - args.session: Current neo4j Database session
// - args.getUserFromSession: Function to get current authenticated user

const { contactId, status } = args.contextData;

// Get current user
const actualUser = await args.getUserFromSession();
if (!actualUser) {
  return {
    success: false,
    error: "User session not found"
  };
}

// Verify admin role
const adminCheck = await args.session.run(
  `MATCH (u:User {uuid: $userId})-[:UserRole]->(r:Role {key: "Admin"})
   RETURN u`,
  { userId: actualUser.P.uuid }
);

if (adminCheck.records.length === 0) {
  return {
    success: false,
    error: "Unauthorized: Admin access required"
  };
}

// Validate input
if (!contactId || !status) {
  return {
    success: false,
    error: "Contact ID and status are required"
  };
}

// Validate status value
const validStatuses = ['new', 'read', 'responded', 'closed'];
if (!validStatuses.includes(status)) {
  return {
    success: false,
    error: "Invalid status. Must be one of: " + validStatuses.join(', ')
  };
}

try {
  // Update the contact submission status
  const query = `
    MATCH (c:ContactSubmission)
    WHERE elementId(c) = $contactId
    SET c.status = $status,
        c.updatedAt = $updatedAt,
        c.updatedBy = $updatedBy
    RETURN c
  `;

  const result = await args.session.run(query, {
    contactId,
    status,
    updatedAt: new Date().toISOString(),
    updatedBy: actualUser.P.email || actualUser.P.username
  });

  if (result.records.length === 0) {
    return {
      success: false,
      error: "Contact submission not found"
    };
  }

  const node = result.records[0].get('c');
  const updatedVertex = args.convertNodeToJson(node);

  return {
    success: true,
    data: updatedVertex
  };
} catch (error) {
  console.error("Error updating contact status:", error);
  return {
    success: false,
    error: "Failed to update status"
  };
}
'''
      }
    }
  ],
  edges: []
}
