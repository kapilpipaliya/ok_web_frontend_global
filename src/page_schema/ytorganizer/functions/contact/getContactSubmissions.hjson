{
  vertexes: [
    {
      id: "1"
      L: Function
      P: {
        description: Retrieves all contact form submissions from database
        body:
          '''
// This function runs on the server
// It has access to _ object with:
// - c: Request parameters
// - _.session: Current neo4j Database session
// - _.getUserFromSession: Function to get current authenticated user

// Get current user
const actualUser = await _.getUserFromSession();
if (!actualUser) {
  return {
    success: false,
    error: "User session not found"
  };
}

// Verify admin role
const adminCheck = await _.session.run(
  `MATCH (u:User {uuid: $userId})-[:UserRole]->(r:Role {key: "Admin"})
   RETURN u`,
  { userId: actualUser.P.uuid }
);

if (adminCheck.records.length === 0) {
  return {
    success: false,
    error: "Unauthorized: Admin access required"
  };
}

  // Get all contact submissions, ordered by submission date (newest first)
  const query = `
    MATCH (c:ContactSubmission)
    RETURN c
    ORDER BY c.submittedAt DESC
  `;

  const result = await _.session.run(query);

  const submissions = result.records.map(record => {
    const node = record.get('c');
    return _.convertNodeToJson(node);
  });

  return {
    success: true,
    data: {
      submissions: submissions,
      count: submissions.length
    }
  };
'''
        key: getContactSubmissions
      }
    }
  ]
  edges: []
}