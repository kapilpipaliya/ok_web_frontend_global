      dataType: "date", renderer: "date",
      width: "160px",
      valueAccessor: (row) => row.P?.createdAt || row.createdAt
    }
  ],
  rowHeight: 60,
  showRowNumber: true,
  showSelection: false,
  actions: [],
  rowClickable: true,
  resizableColumns: true,
  columnWidths: { __rowNumber: "40px" },
  formConfig: null,
  uniqueKeys: [],
  usePolarisUI: false,
  enableUserScopingForSidebar: false,
  enableUserScopingForContent: false,
  enableLocalFilters: true,
  enableLocalSort: true,
  hooks: {},
  sidebar: {
    enabled: false
  },
  onRowClick: (row, _) => {
    if (!row?.id) return;
    const ticketId = row.id;
    const basePath = "/ShopifySupportConversation";
    const searchParams = _.searchParams || {};
    const nextParams = { ...searchParams, supportId: ticketId };
    const query = Object.entries(nextParams)
      .filter(([, value]) => value != null && value !== "")
      .map(([key, value]) => \`\${encodeURIComponent(key)}=\${encodeURIComponent(String(value))}\`)
      .join("&");
    const href = query ? \`\${basePath}?\${query}\` : basePath;

    if (_.navigate) {
      _.navigate(href);
    } else if (typeof window !== "undefined") {
      window.location.href = href;
    }
  }
};`
  }
];

async function processSetting(setting) {
  const { key, tableVertexLabel, icon, name, config } = setting;
  console.log(`Processing ${name} (${icon})...`);

  const checkResult = await _.session.run(`MATCH (s:Setting {key: $key}) RETURN s`, { key });
  const exists = checkResult.records.length > 0;

  if (!dryRun) {
    if (exists) {
      await _.session.run(
        `MATCH (s:Setting {key: $key})
         SET s.config = $config,
             s.type = 'table_config',
             s.tableVertexLabel = $tableVertexLabel,
             s.updatedAt = datetime()
         RETURN s`,
        { key, config, tableVertexLabel }
      );
      console.log(`Updated ${name}`);
      return { created: 0, updated: 1 };
    }

    await _.session.run(
      `CREATE (s:Setting {
        key: $key,
        type: 'table_config',
        tableVertexLabel: $tableVertexLabel,
        config: $config,
        createdAt: datetime(),
        updatedAt: datetime()
      }) RETURN s`,
      { key, config, tableVertexLabel }
    );
    console.log(`Created ${name}`);
    return { created: 1, updated: 0 };
  }

  return exists ? { created: 0, updated: 1 } : { created: 1, updated: 0 };
}

const stats = { created: 0, updated: 0, total: settingsConfigs.length };

for (let i = 0; i < settingsConfigs.length; i++) {
  const r = await processSetting(settingsConfigs[i]);
  stats.created += r.created;
  stats.updated += r.updated;
}

return {
  success: true,
  message: dryRun ? "YT Organizer migration dry run" : "YT Organizer settings migration completed",
  data: { ...stats, dryRun }
};
'''
      }
    }
  ]
  edges: []
}
