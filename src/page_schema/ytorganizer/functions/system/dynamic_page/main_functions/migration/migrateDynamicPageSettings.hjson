        body:
          '''
/**
 * YT Organizer — migrate default table settings for DynamicPage / Table (getUserContent / mutateUserContent).
 * contextData: { dryRun?: boolean }
 */

const { dryRun = false } = c || {};

console.log(`YT Organizer settings migration (dryRun: ${dryRun})`);

const settingsConfigs = [
