{
  vertexes: [
    {
      id: "save_channel_function",
      L: "Function",
      P: {
        key: "saveChannel",
        description: "Fetches basic channel metadata and queues background processing for playlists and videos",
        body: '''
/**
 * Extract channel ID or identifier from various YouTube URL formats
 * Supports: /channel/ID, /@handle, /c/custom, /user/username
 */
const extractChannelId = (url) => {
  if (!url) return null;

  // Handle different YouTube channel URL formats
  const patterns = [
    /youtube\.com\/channel\/([a-zA-Z0-9_-]+)/,  // Channel ID format: /channel/UCxxx
    /youtube\.com\/@([a-zA-Z0-9_-]+)/,          // Handle format: /@channelname
    /youtube\.com\/c\/([a-zA-Z0-9_-]+)/,        // Custom URL format: /c/customname
    /youtube\.com\/user\/([a-zA-Z0-9_-]+)/      // Legacy user format: /user/username
  ];

  for (const pattern of patterns) {
    const match = url.match(pattern);
    if (match) return match[1];
  }

  return null;
};

/**
 * Fetch ONLY basic channel metadata (no playlists or videos)
 * Full processing will be done in background worker
 */
const fetchChannelMetadata = async (channelIdentifier, apiKeyData) => {
  // Dynamic import of googleapis library
  const { google } = await import('googleapis');

  // Initialize YouTube API client with authentication from database
  const youtube = google.youtube({
    version: 'v3',
    auth: apiKeyData.apiKey
  });

  let channelId;

  // Resolve channel identifier to actual channel ID
  if (channelIdentifier.startsWith('@') || !channelIdentifier.startsWith('UC')) {
    // Search for channel by handle or custom URL
    const searchResponse = await youtube.search.list({
      part: ['snippet'],
      q: channelIdentifier.startsWith('@') ? channelIdentifier : `${channelIdentifier}`,
      type: ['channel'],
      maxResults: 1
    });

    if (!searchResponse.data.items || searchResponse.data.items.length === 0) {
      throw new Error('Channel not found');
    }

    channelId = searchResponse.data.items[0].snippet.channelId;
  } else {
    channelId = channelIdentifier;
  }

  // Fetch ONLY channel details (metadata only, no playlists/videos)
  const channelResponse = await youtube.channels.list({
    part: ['snippet', 'contentDetails', 'statistics', 'brandingSettings'],
    id: [channelId]
  });

  if (!channelResponse.data.items || channelResponse.data.items.length === 0) {
    throw new Error('Channel not found or is private/deleted');
  }

  const channel = channelResponse.data.items[0];

  return {
    id: channelId,
    snippet: channel.snippet,
    statistics: channel.statistics,
    contentDetails: channel.contentDetails,
    brandingSettings: channel.brandingSettings
  };
};

try {
  // Extract input parameters from the request
  const { url, name, refresh = false } = args.contextData;

  if (!url) {
    throw new Error("Channel URL is required");
  }

  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Extract channel identifier from the provided URL
  const channelIdentifier = extractChannelId(url);
  if (!channelIdentifier) {
    throw new Error("Invalid YouTube channel URL. Please provide a valid channel URL.");
  }

  // DUPLICATE JOB PREVENTION: Check if this channel is already queued or processing
  // Prevents multiple concurrent jobs for the same channel which would waste API quota
  // and potentially cause data inconsistencies
  // REFRESH MODE: If refresh=true, skip this check to allow re-processing completed channels
  if (!refresh) {
    const existingChannelResult = await args.session.run(`
      MATCH (c:Channel)
      WHERE c.youtubeId = $channelIdentifier OR c.customUrl = $channelIdentifier
      WITH c
      MATCH (u:User {uuid: $userUuid})-[:UserChannelSetting]->(cs:ChannelSetting)
            -[:ChannelSettingChannel]->(c)
      WHERE cs.status IN ['queued', 'processing']
      RETURN c.youtubeId as channelId, cs.status as status, c.title as title
    `, { userUuid: user.P.uuid, channelIdentifier });

    if (existingChannelResult.records.length > 0) {
      const record = existingChannelResult.records[0];
      const status = record.get('status');
      const title = record.get('title');

      return {
        success: false,
        message: `Channel "${title}" is already ${status}. Please wait for it to complete before adding again. Use refresh=true to force re-processing.`,
        data: {
          channelId: record.get('channelId'),
          status: status,
          alreadyExists: true
        }
      };
    }
  }

  // Get active API key from database
  const apiKeyResult = await args.executeNamedServerFunction({
    functionName: "getActiveYouTubeAPIKey",
    contextData: {}
  });

  if (!apiKeyResult?.result?.success || !apiKeyResult?.result?.data) {
    throw new Error(apiKeyResult?.result?.message || "Failed to get YouTube API key");
  }

  const apiKeyData = apiKeyResult.result.data;

  // Fetch ONLY basic channel metadata (fast operation)
  const channelData = await fetchChannelMetadata(channelIdentifier, apiKeyData);

  // Track API usage (channel search + channel details = 2 calls, each costs ~1-3 quota units)
  await args.executeNamedServerFunction({
    functionName: "trackYouTubeAPIUsage",
    contextData: { keyId: apiKeyData.keyId, cost: 5 }
  });

  // STEP 1: Create or update the main Channel vertex with basic metadata
  const channelKey = `channel_${channelData.id}`;

  const mergeChannelQuery = `
    MERGE (c:Channel {youtubeId: $channelId})
    ON CREATE SET
      c.key = $key,
      c.youtubeId = $channelId,
      c.createdAt = datetime()
    SET
      c.title = $title,
      c.description = $description,
      c.thumbnail = $thumbnail,
      c.customUrl = $customUrl,
      c.country = $country,
      c.videoCount = $videoCount,
      c.viewCount = $viewCount,
      c.subscriberCount = $subscriberCount,
      c.uploadsPlaylistId = $uploadsPlaylistId,
      c.publishedAt = datetime($publishedAt),
      c.updatedAt = datetime()
    RETURN c
  `;

  await args.session.run(mergeChannelQuery, {
    key: channelKey,
    channelId: channelData.id,
    title: channelData.snippet.title,
    description: channelData.snippet.description || "",
    thumbnail: channelData.snippet.thumbnails?.high?.url ||
               channelData.snippet.thumbnails?.medium?.url ||
               channelData.snippet.thumbnails?.default?.url || "",
    customUrl: channelData.snippet.customUrl || "",
    country: channelData.snippet.country || "",
    videoCount: parseInt(channelData.statistics?.videoCount || "0"),
    viewCount: parseInt(channelData.statistics?.viewCount || "0"),
    subscriberCount: parseInt(channelData.statistics?.subscriberCount || "0"),
    uploadsPlaylistId: channelData.contentDetails?.relatedPlaylists?.uploads || "",
    publishedAt: channelData.snippet.publishedAt
  });

  // STEP 2: Create user-specific ChannelSetting with status tracking
  const channelSettingKey = `channel_setting_${user.id}_${channelData.id}`;

  const mergeChannelSettingQuery = `
    MATCH (u:User {uuid: $userUuid})
    MATCH (c:Channel {youtubeId: $channelId})
    MERGE (u)-[:UserChannelSetting]->(cs:ChannelSetting)-[:ChannelSettingChannel]->(c)
    ON CREATE SET
      cs.key = $channelSettingKey,
      cs.createdAt = datetime()
    SET
      cs.customName = $customName,
      cs.notifications = true,
      cs.autoDownload = false,
      cs.priority = 'normal',
      cs.status = 'queued',
      cs.progress = 0,
      cs.totalPlaylists = 0,
      cs.processedPlaylists = 0,
      cs.totalVideos = 0,
      cs.processedVideos = 0,
      cs.error = null,
      cs.queuedAt = datetime(),
      cs.updatedAt = datetime()
    RETURN cs
  `;

  await args.session.run(mergeChannelSettingQuery, {
    userUuid: user.P.uuid,
    channelId: channelData.id,
    channelSettingKey,
    customName: name || null
  });

  // STEP 3: Add to background processing queue using BullMQ
  const { Queue } = args.bullmq;

  // Get Redis connection
  const connection = args.bullmq.redisConnection || {
    host: process.env.REDIS_HOST || 'localhost',
    port: parseInt(process.env.REDIS_PORT || '6379'),
    maxRetriesPerRequest: null
  };

  const channelQueue = new Queue('processChannelQueue', { connection });

  // DEAD LETTER QUEUE CONFIGURATION:
  // Failed jobs are kept (removeOnFail: false) so admins can inspect errors
  // After 3 retry attempts, the job stays in the failed set for manual review
  // This helps debug YouTube API issues, quota problems, and other failures
  await channelQueue.add('processChannel', {
    channelId: channelData.id,
    userId: user.id,
    userUuid: user.P.uuid,
    customName: name || null
  }, {
    attempts: 3,                           // Retry 3 times before giving up
    backoff: {
      type: 'exponential',                 // Exponential backoff: 5s, 10s, 20s
      delay: 5000
    },
    removeOnComplete: 100,                 // Keep last 100 completed jobs for audit
    removeOnFail: false                    // KEEP failed jobs for inspection (Dead Letter Queue)
  });

  // Close queue connection
  await channelQueue.close();

  return {
    success: true,
    message: refresh
      ? `Channel "${channelData.snippet.title}" has been queued for refresh. All data will be re-fetched from YouTube.`
      : `Channel "${channelData.snippet.title}" has been queued for processing. This may take a few minutes.`,
    data: {
      channelId: channelData.id,
      title: channelData.snippet.title,
      customName: name,
      status: 'queued',
      progress: 0,
      subscriberCount: channelData.statistics?.subscriberCount,
      videoCount: channelData.statistics?.videoCount,
      userId: user.id,
      userSpecific: true,
      isRefresh: refresh
    }
  };

} catch (error) {
  console.error("Error saving channel:", error);

  // Handle specific YouTube API errors
  let userMessage = "Failed to save channel. Please try again.";

  if (error.message.includes("Channel not found")) {
    userMessage = "Channel not found. Please check the URL and make sure the channel exists.";
  } else if (error.message.includes("Invalid YouTube channel URL")) {
    userMessage = "Invalid channel URL. Please provide a valid YouTube channel URL.";
  } else if (error.message.includes("quota")) {
    userMessage = "YouTube API quota exceeded. Please try again later.";
  } else if (error.message.includes("API key")) {
    userMessage = "YouTube API configuration error. Please contact support.";
  } else if (error.message.includes("private")) {
    userMessage = "This channel is private and cannot be accessed.";
  } else if (error.code === 404) {
    userMessage = "Channel not found or has been deleted.";
  } else if (error.code === 403) {
    userMessage = "Access denied. The channel may be private or restricted.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "YouTubeAPIError",
      details: error.message,
      code: error.code || null
    }
  };
}
'''
      }
    }
  ],
  edges: []
}