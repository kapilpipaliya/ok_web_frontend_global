{
  vertexes: [
    {
      id: "get_playlist_videos_function",
      L: "Function",
      P: {
        key: "getPlaylistVideos",
        description: "Fetches a single playlist's videos for the current user",
        body: '''
try {
  // Extract playlist ID, ownership, and sort from request parameters
  const { playlistId, ownershipId, sortBy = "position_asc" } = args.contextData;

  if (!playlistId) {
    throw new Error("Playlist ID is required");
  }

  // Get current authenticated user from session
  const actualUser = await args.getUserFromSession();
  if (!actualUser) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Get effective user (handles admin impersonation)
  const user = await args.getEffectiveUser(args.session, actualUser, args.contextData);

  // Parse sortBy parameter using shared utility
  const parseSortResult = await args.executeNamedServerFunction({
    functionName: "parseSortByUtil",
    contextData: { sortBy, contentType: "videos" }
  });

  if (!parseSortResult.result) {
    throw new Error("Failed to parse sort parameters");
  }

  const { orderBy, orderDirection, secondaryOrderBy } = parseSortResult.result;

  // Verify user has access to this playlist and get video count using helper function
  const playlistResult = await args.executeNamedServerFunction({
    functionName: "getPlaylistsWithVideoCount",
    contextData: {
      userUuid: user.P.uuid,
      ownershipId,  // Filter by ownership
      playlistIds: [playlistId]
    }
  });

  if (!playlistResult.result || !playlistResult.result.success || playlistResult.result.data.length === 0) {
    throw new Error("Playlist not found or access denied");
  }

  const playlistData = playlistResult.result.data[0];
  const playlist = playlistData.playlist;
  const playlistSetting = playlistData.playlistSetting;
  const ownership = playlistData.ownership;
  const parentChannel = playlistData.channel; // Channel info is already included from getPlaylistsWithVideoCount

  // Fetch all videos in this playlist using helper function
  const videosResult = await args.executeNamedServerFunction({
    functionName: "getVideosWithDetails",
    contextData: {
      userUuid: user.P.uuid,
      ownershipId,  // Filter by ownership
      playlistId: playlistId,
      orderBy,
      orderDirection,
      secondaryOrderBy
    }
  });

  const videos = videosResult.result?.success ? videosResult.result.data : [];

  return {
    success: true,
    data: {
      playlist: {
        playlist,
        playlistSetting,
        ownership,
        channel: parentChannel // Channel vertex from getPlaylistsWithVideoCount
      },
      videos,
      userId: user.id,
      ownershipId: ownershipId
    },
    message: `Found ${videos.length} videos in playlist`
  };

} catch (error) {
  console.error("Error fetching playlist videos:", error);

  // Handle specific error types
  let userMessage = "Failed to fetch playlist videos. Please try again.";

  if (error.message.includes("Playlist ID is required")) {
    userMessage = "Playlist ID is required.";
  } else if (error.message.includes("User session not found")) {
    userMessage = "Please log in to view playlist videos.";
  } else if (error.message.includes("Playlist not found or access denied")) {
    userMessage = "Playlist not found or you don't have access to it.";
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    },
    data: {
      playlist: null,
      videos: [],
      statistics: {
        totalVideos: 0,
        watchedVideos: 0,
        unwatchedVideos: 0,
        videosWithNotes: 0
      }
    }
  };
}
'''
      }
    }
  ],
  edges: []
}