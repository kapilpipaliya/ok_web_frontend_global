{
  vertexes: [
    {
      id: "clear_all_user_data_function",
      L: "Function",
      P: {
        key: "clearAllUserData",
        description: "Clears all user-specific data (channel settings, playlist settings, video settings) without deleting the actual channels, playlists, or videos",
        body: '''
try {
  // Get current authenticated user from session
  const user = await args.getUserFromSession();
  if (!user) {
    throw new Error("User session not found. Please log in and try again.");
  }

  // Step 1: Delete all user channel settings and relationships
  const deleteChannelSettingQuery = `
    MATCH (u:User {uuid: $userUuid})-[:UserChannelSetting]->(cs:ChannelSetting)
    DETACH DELETE cs
  `;

  const channelSettingResult = await args.session.run(deleteChannelSettingQuery, {
    userUuid: user.P.uuid
  });

  // Step 2: Delete all user playlist settings and relationships
  const deletePlaylistSettingsQuery = `
    MATCH (u:User {uuid: $userUuid})-[:UserPlaylistSetting]->(ps:PlaylistSetting)
    DETACH DELETE ps
  `;

  const playlistSettingsResult = await args.session.run(deletePlaylistSettingsQuery, {
    userUuid: user.P.uuid
  });

  // Step 3: Delete all user video settings and relationships
  const deleteVideoSettingsQuery = `
    MATCH (u:User {uuid: $userUuid})-[:UserVideoSetting]->(vs:VideoSetting)
    DETACH DELETE vs
  `;

  const videoSettingsResult = await args.session.run(deleteVideoSettingsQuery, {
    userUuid: user.P.uuid
  });

  // Get statistics for the response
  const channelSettingDeleted = channelSettingResult.summary.counters.updates().nodesDeleted || 0;
  const playlistSettingDeleted = playlistSettingsResult.summary.counters.updates().nodesDeleted || 0;
  const videoSettingDeleted = videoSettingsResult.summary.counters.updates().nodesDeleted || 0;

  return {
    success: true,
    message: "All your personal data has been cleared successfully.",
    data: {
      channelSettingDeleted,
      playlistSettingDeleted,
      videoSettingDeleted,
      totalItemDeleted: channelSettingDeleted + playlistSettingDeleted + videoSettingDeleted,
      userId: user.id,
      clearedAt: new Date().toISOString()
    }
  };

} catch (error) {
  console.error("Error clearing user data:", error);

  // Handle specific error types
  let userMessage = "Failed to clear data. Please try again.";

  if (error.message.includes("User session not found")) {
    userMessage = "Please log in to clear your data.";
  } else if (error.message.includes("database")) {
    userMessage = "Database connection error. Please try again later.";
  }

  return {
    success: false,
    message: userMessage,
    error: {
      type: error.name || "DatabaseError",
      details: error.message
    },
    data: {
      channelSettingDeleted: 0,
      playlistSettingDeleted: 0,
      videoSettingDeleted: 0,
      totalItemDeleted: 0
    }
  };
}
'''
      }
    }
  ],
  edges: []
}