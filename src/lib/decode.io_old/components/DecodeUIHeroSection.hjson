{
  vertexes: [
    {
      id: "hero-root",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "section"
};
''',
        css: '''
return `._id {
  background: linear-gradient(135deg, ${args.theme.var.color.primary} 0%, ${args.theme.var.color.primary_dark_200} 100%);
  color: ${args.theme.var.color.primary_text};
  padding: 5rem 1rem;
  min-height: 80vh;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  
  &::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
    border-radius: 50%;
  }
  
  @media (max-width: 768px) {
    padding: 3rem 1rem;
    min-height: 60vh;
  }
}`;
'''
      }
    },
    {
      id: "hero-container",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
  position: relative;
  z-index: 1;
}`;
'''
      }
    },
    {
      id: "hero-content",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
  
  @media (max-width: 968px) {
    grid-template-columns: 1fr;
    gap: 3rem;
    text-align: center;
  }
}`;
'''
      }
    },
    {
      id: "hero-text",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  @media (max-width: 968px) {
    order: 2;
  }
}`;
'''
      }
    },
    {
      id: "hero-title",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "h1",
  text: args.contextData.props?.title || "Build Stunning Websites with Drag & Drop"
};
''',
        css: '''
return `._id {
  font-size: 3.5rem;
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 1.5rem;
  
  @media (max-width: 768px) {
    font-size: 2.5rem;
  }
  
  @media (max-width: 480px) {
    font-size: 2rem;
  }
}`;
'''
      }
    },
    {
      id: "hero-subtitle",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "p",
  text: args.contextData.props?.subtitle || "Create professional websites without writing a single line of code. Our intuitive page builder makes web design accessible to everyone."
};
''',
        css: '''
return `._id {
  font-size: 1.25rem;
  line-height: 1.6;
  margin-bottom: 2rem;
  opacity: 0.9;
  
  @media (max-width: 768px) {
    font-size: 1.125rem;
  }
}`;
'''
      }
    },
    {
      id: "hero-buttons",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  
  @media (max-width: 968px) {
    justify-content: center;
  }
}`;
'''
      }
    },
    {
      id: "hero-cta-primary",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "button",
  text: args.contextData.props?.primaryButtonText || "Start Building Free"
};
''',
        css: '''
return `._id {
  background: ${args.theme.var.color.background};
  color: ${args.theme.var.color.primary};
  padding: 1rem 2rem;
  font-size: 1.125rem;
  font-weight: 600;
  border: none;
  border-radius: 0.5rem;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 14px 0 rgba(0,0,0,0.1);
  
  &:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px 0 rgba(0,0,0,0.15);
  }
  
  @media (max-width: 480px) {
    padding: 0.875rem 1.5rem;
    font-size: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "hero-cta-secondary",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "button",
  text: args.contextData.props?.secondaryButtonText || "Watch Demo"
};
''',
        css: '''
return `._id {
  background: transparent;
  color: ${args.theme.var.color.primary_text};
  padding: 1rem 2rem;
  font-size: 1.125rem;
  font-weight: 600;
  border: 2px solid rgba(255,255,255,0.3);
  border-radius: 0.5rem;
  cursor: pointer;
  transition: all 0.3s ease;
  
  &:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.5);
  }
  
  @media (max-width: 480px) {
    padding: 0.875rem 1.5rem;
    font-size: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "hero-visual",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  position: relative;
  
  @media (max-width: 968px) {
    order: 1;
    max-width: 500px;
    margin: 0 auto;
  }
}`;
'''
      }
    },
    {
      id: "hero-icons",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
return {
  as: "div"
};
''',
        css: '''
return `._id {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  
  @media (max-width: 480px) {
    gap: 1rem;
  }
}`;
'''
      }
    },
    {
      id: "hero-icon-data",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "heroIcons",
        loop: true,
        props: '''
return {
  data: args.contextData.props?.features || [
    { icon: "🎨", title: "Design", description: "Beautiful templates" },
    { icon: "⚡", title: "Fast", description: "Lightning performance" },
    { icon: "📱", title: "Responsive", description: "Mobile-first design" }
  ]
};
'''
      }
    },
    {
      id: "hero-icon-item",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const icon = args.contextData.heroIcons;
return {
  as: "div"
};
''',
        css: '''
return `._id {
  text-align: center;
  background: rgba(255,255,255,0.1);
  padding: 2rem 1rem;
  border-radius: 1rem;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.2);
  transition: all 0.3s ease;
  
  &:hover {
    transform: translateY(-5px);
    background: rgba(255,255,255,0.15);
  }
  
  @media (max-width: 480px) {
    padding: 1.5rem 0.75rem;
  }
}`;
'''
      }
    },
    {
      id: "hero-icon-emoji",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        props: '''
const icon = args.contextData.heroIcons;
return {
  as: "div",
  text: icon.icon
};
''',
        css: '''
return `._id {
  font-size: 3rem;
  margin-bottom: 1rem;
  
  @media (max-width: 480px) {
    font-size: 2.5rem;
  }
}`;
'''
      }
    },
    {
      id: "hero-icon-title",
      L: "Attr",
      P: {
        displayOrder: 2,
        componentName: "Html",
        props: '''
const icon = args.contextData.heroIcons;
return {
  as: "h3",
  text: icon.title
};
''',
        css: '''
return `._id {
  font-size: 1.25rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  
  @media (max-width: 480px) {
    font-size: 1.125rem;
  }
}`;
'''
      }
    },
    {
      id: "hero-icon-desc",
      L: "Attr",
      P: {
        displayOrder: 3,
        componentName: "Html",
        props: '''
