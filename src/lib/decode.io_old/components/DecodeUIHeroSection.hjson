''',
        css: '''
return `._id {
  font-size: 0.875rem;
  opacity: 0.8;
  
  @media (max-width: 480px) {
    font-size: 0.75rem;
  }
}`;
'''
      }
    }
  ],
  edges: [
    { id: "e1", T: "Attr", S: "hero-root", E: "hero-container" },
    { id: "e2", T: "Attr", S: "hero-container", E: "hero-content" },
