      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "faqItems",
        loop: true,
        props: '''
const questions = args.contextData.props?.questions || [
  {
    question: "How does accessWidget's AI work?",
    answer: "accessWidget uses machine learning processes to correctly identify and label complex structures on each webpage. It also creates accurate and concise image descriptions for alt text."
  },
  {
    question: "Does accessWidget ensure compliance with legal requirements?",
    answer: "Yes, accessWidget helps ensure compliance with various accessibility standards and legal requirements."
  },
  {
    question: "Can accessWidget mitigate my legal risk?",
    answer: "accessWidget helps reduce legal risk by ensuring your website meets accessibility standards."
  }
];

return {
  data: questions
};
'''
      }
    },
    {
      id: "7",
      L: "Attr",
      P: {
        displayOrder: 1,
        componentName: "Html",
        contextName: "faqItem",
        props: '''
const item = args.contextData.faqItems;
const [isOpen, setIsOpen] = args.createSignal(false);

return {
  data: {
    ...item,
    isOpen,
    setIsOpen,
    toggleOpen: () => setIsOpen(!isOpen())
  }
};
'''
      }
    },
