{
  "name": "vite-template-solid",
  "version": "0.0.0",
  "description": "",
  "scripts": {
    "dev": "vite",
    "build": "vite build --minify false --sourcemap -w --outDir=../../solid_assets --emptyOutDir",
    "serve": "vite preview",
    "lint:check": "eslint . --ext .ts --ext .tsx",
    "lint:fix": "eslint . --ext .ts --ext .tsx --fix",
    "prettier:check": "prettier --check 'src/**/*'",
    "prettier:fix": "prettier --config .prettierrc 'src/**/*' --write",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.33.0",
    "@typescript-eslint/parser": "^5.33.0",
    "cypress": "^10.3.0",
    "eslint": "^8.21.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "typescript": "^4.7.4",
    "vite": "^3.0.4",
    "vite-plugin-solid": "^2.3.0",
    "vitest": "^0.21.1"
  },
  "dependencies": {
    "@hope-ui/solid": "^0.6.7",
    "@stitches/core": "^1.2.8",
    "@thisbeyond/solid-dnd": "^0.6.1",
    "@thisbeyond/solid-select": "^0.12.0",
    "clsx": "^1.2.1",
    "solid-app-router": "^0.4.2",
    "solid-forms": "^0.4.5",
    "solid-headless": "^0.12.4",
    "solid-heroicons": "^2.0.3",
    "solid-js": "^1.4.8",
    "solid-styled-components": "^0.28.4",
    "solid-transition-group": "0.0.10"
  }
}
