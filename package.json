{
  "name": "decodeui-page-builder",
  "type": "module",
  "scripts": {
    "check-errors": "npx tsc --noEmit && npx eslint . --ext .ts,.tsx && npm run build",
    "pretty": "prettier --write \"./**/*.{js,jsx,css,ts,tsx,json}\"",
    "dev": "vite dev --host --port 3001",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:build": "echo '🔨 Building application...' && vite build && echo '✅ Build complete in .output'",
    "deploy:activate": "if [ -f .output/server/index.mjs ]; then echo '🔄 Activating new build...' && rm -rf production-old && mv production production-old 2>/dev/null || true && cp -r .output production && echo '✅ New build activated' && echo '📦 Old build saved in production-old for rollback'; else echo '❌ Build invalid (.output/server/index.mjs missing)'; exit 1; fi",
    "rollback": "if [ -d production-old ] && [ -f production-old/server/index.mjs ]; then echo '⏪ Rolling back...' && rm -rf production && mv production-old production && echo '✅ Rollback successful'; else echo '❌ No backup found for rollback'; exit 1; fi",
    "deploy:cleanup": "echo '🧹 Cleaning up...' && rm -rf production-old && echo '✅ Cleanup complete'",
    "kill:3001": "echo '🔪 Killing process on port 3001...' && (fuser -k 3001/tcp 2>/dev/null || true) && echo '✅ Port 3001 freed'",
    "startDev": "dotenv -e .env -- sh -c 'PORT=${PORT:-${DOMAIN_PORT:-3001}} node .output/server/index.mjs'",
    "start": "dotenv -e .env -- sh -c 'PORT=${PORT:-${DOMAIN_PORT:-3001}} node .output/server/index.mjs'",
    "postinstall": "npx playwright install-deps && npx playwright install",
    "s": "git pull && npm i --force && npm run build && npm run start",
    "send-test-email": "dotenv -e .env -- tsx scripts/email/sendTestEmail.ts admin admin@decodeui.io kapilpipaliya@gmail.com",
    "clean-redis": "redis-cli -h ${REDIS_HOST:-localhost} -p ${REDIS_PORT:-6379} FLUSHALL",
    "clean-redis-db": "redis-cli -h ${REDIS_HOST:-localhost} -p ${REDIS_PORT:-6379} FLUSHDB",
    "pm2:start": "git pull && npm i --force && npm run build && pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:reload": "echo '🔄 Reloading PM2...' && pm2 reload ecosystem.config.cjs && echo '✅ PM2 reload complete'",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs ok-web-frontend",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "setup": "git pull && npm i --force && npm run build && npm run pm2:start",
    "deploy": "echo '🚀 Starting deployment...' && git pull && npm i --force && npm run deploy:build && npm run deploy:activate && npm run pm2:reload && echo '✅ Deployment complete! Run \"npm run deploy:cleanup\" to remove old build.'",
    "deploy:rollback": "echo '⏪ Starting rollback...' && npm run rollback && npm run pm2:reload && echo '✅ Rollback complete!'"
  },
