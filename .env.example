# Application Environment
NODE_ENV=development  # 'development' or 'production'

# Logging Configuration
LOG_LEVEL=debug  # 'trace', 'debug', 'info', 'warn', 'error', 'fatal'
LOG_ROTATION_ENABLED=true  # Enable daily log rotation with 100MB size limit

# OpenAI Settings
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Domain Settings (comma-separated for multiple app hostnames, e.g. app.com,www.app.com)
DOMAIN=localhost.com
DOMAIN_PORT=3001
ADMIN_USER_PASSWORD=YourSecurePassword123!

# SMTP Settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=YourSMTPPassword123!
SMTP_FROM=noreply@example.com

# Neo4j Settings
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YourNeo4jPassword123!

# Redis Settings (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Razorpay Payment Settings
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 * * * *  # Every hour at minute 0 UTC (cron format)
BACKUP_STORAGE_TYPE=s3  # 's3' or 'gcs'

# AWS S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_S3_BUCKET=your-backup-bucket-name
AWS_S3_REGION=us-east-1

# Google Cloud Storage Configuration (if using GCS)
# Uncomment if using GCS instead of S3
# GCS_PROJECT_ID=your-project-id
# GCS_BUCKET=your-backup-bucket-name
# GCS_KEYFILE_PATH=/path/to/service-account-key.json

# Backup Retention Policy
BACKUP_RETENTION_HOURLY=24  # Keep 24 hourly backups
BACKUP_RETENTION_DAILY=7    # Keep 7 daily backups
BACKUP_RETENTION_WEEKLY=4   # Keep 4 weekly backups
BACKUP_RETENTION_MONTHLY=12 # Keep 12 monthly backups

# Backup Notifications
BACKUP_ALERT_EMAIL=admin@yourdomain.com
BACKUP_ALERT_ON_SUCCESS=false  # Set to true to receive success emails
BACKUP_ALERT_ON_FAILURE=true   # Set to false to disable failure alerts
