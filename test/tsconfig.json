{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "../src", // Set this to the project root
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js"
